{
  "name": "tachbit",
  "displayName": "Tachbit",
  "description": "Tachbit language: colors, Tachbit Dark/Light themes, run with one button (F5, ▶, Touch Bar) and errors right in the code",
  "version": "0.9.6",
  "publisher": "tachbit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/superbro456/Tachbit"
  },
  "homepage": "https://superbro456.github.io/Tachbit/",
  "bugs": {
    "url": "https://github.com/superbro456/Tachbit/issues"
  },
  "keywords": [
    "tachbit",
    "language",
    "compiler",
    "games",
    "systems"
  ],
  "galleryBanner": {
    "color": "#14161a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tachbit",
    "onDebugResolve:tachbit",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tachbit",
        "aliases": [
          "Tachbit",
          "tachbit"
        ],
        "extensions": [
          ".tb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tachbit",
        "scopeName": "source.tachbit",
        "path": "./syntaxes/tachbit.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tachbit",
        "path": "./snippets/tachbit.json"
      }
    ],
    "commands": [
      {
        "command": "tachbit.run",
        "title": "Tachbit: запустить файл",
        "icon": "$(play)"
      },
      {
        "command": "tachbit.check",
        "title": "Tachbit: проверить файл"
      },
      {
        "command": "tachbit.showC",
        "title": "Tachbit: показать C-код"
      }
    ],
    "keybindings": [
      {
        "command": "tachbit.run",
        "key": "f5",
        "when": "editorLangId == tachbit || resourceLangId == tachbit"
      },
      {
        "command": "tachbit.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == tachbit"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tachbit.run",
          "when": "editorLangId == tachbit",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tachbit",
      "properties": {
        "tachbit.path": {
          "type": "string",
          "default": "",
          "description": "Где лежит команда tb. Пусто — ~/.tachbit/bin/tb (её ставит tools/install.sh)."
        },
        "tachbit.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Проверять файл при сохранении и подчёркивать ошибки."
        }
      }
    },
    "themes": [
      {
        "label": "Tachbit Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/tachbit-dark.json"
      },
      {
        "label": "Tachbit Light",
        "uiTheme": "vs",
        "path": "./themes/tachbit-light.json"
      }
    ],
    "debuggers": [
      {
        "type": "tachbit",
        "label": "Tachbit",
        "languages": [
          "tachbit"
        ]
      }
    ]
  },
  "icon": "icon.png"
}
