set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(FUT_SYSROOT @SYSROOT@)
set(CMAKE_SYSROOT ${FUT_SYSROOT})
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-elf)
set(CMAKE_ASM_COMPILER_TARGET x86_64-unknown-elf)
set(FUT_FLAGS "-Wno-error=return-type -D_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE -D__unix__=1 -D__futura__=1 -fno-pic -fno-stack-protector -include @HERE@/fut_pre.h")
set(CMAKE_C_FLAGS_INIT "${FUT_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${FUT_FLAGS} -nostdinc++ -isystem ${FUT_SYSROOT}/usr/include/c++/v1")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -nostdlib -Wl,-no-pie ${FUT_SYSROOT}/usr/lib/crt0.o ${FUT_SYSROOT}/usr/lib/crti.o -Wl,--image-base=0x400000,-z,noseparate-code,--no-rosegment,-z,norelro,-dynamic-linker,/lib/ld.so,--hash-style=sysv,-rpath,/lib -L${FUT_SYSROOT}/usr/lib")
set(CMAKE_C_STANDARD_LIBRARIES "-lclang_rt.builtins -lm -lc ${FUT_SYSROOT}/usr/lib/crtn.o")
set(CMAKE_CXX_STANDARD_LIBRARIES "-Wl,--wrap=mmap,--wrap=mprotect ${FUT_SYSROOT}/usr/lib/fut_compat.o -lc++ -lc++abi -lunwind -lclang_rt.builtins -lm -lc ${FUT_SYSROOT}/usr/lib/crtn.o")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
