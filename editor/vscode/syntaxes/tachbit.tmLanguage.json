{
  "name": "Tachbit",
  "scopeName": "source.tachbit",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#func-def" },
    { "include": "#obj-def" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": { "match": "//.*$", "name": "comment.line.double-slash.tachbit" },
    "string": {
      "begin": "\"", "end": "\"", "name": "string.quoted.double.tachbit",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.tachbit" }]
    },
    "func-def": {
      "match": "\\b(modpub\\s+|modpri\\s+)?(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.tachbit" },
        "2": { "name": "keyword.declaration.function.tachbit" },
        "3": { "name": "entity.name.function.tachbit" }
      }
    },
    "obj-def": {
      "match": "\\b(obj)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s+by\\s+columns)?",
      "captures": {
        "1": { "name": "keyword.declaration.type.tachbit" },
        "2": { "name": "entity.name.type.tachbit" },
        "3": { "name": "keyword.other.speed.tachbit" }
      }
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(if|else|each|in|count|from|to|repeat|times|while|skip|stop|return|gives|fail|try)\\b", "name": "keyword.control.tachbit" },
        { "match": "\\b(on\\s+all\\s+cores|by\\s+vec|by|shared|temp|together|background|danger|lock|on\\s+(keyboard|timer|interrupt))\\b", "name": "keyword.other.speed.tachbit" },
        { "match": "\\.(wait)\\b", "captures": { "1": { "name": "keyword.other.speed.tachbit" } } },
        { "match": "\\b(and|or|not)\\b", "name": "keyword.operator.word.tachbit" },
        { "match": "\\b(int|dec|text|bool|list|dict)\\b", "name": "storage.type.tachbit" },
        { "match": "\\b(const|link|use|modpub|modpri)\\b", "name": "storage.modifier.tachbit" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.tachbit" },
        { "match": "\\b(print|len|round|code|char|cut|to_int|to_dec|read_file|write_file|input|args|split|join|find|replace|upper|lower|trim|starts_with|ends_with|sort|abs|min|max|sqrt|run|exit|file_exists|show|bit_and|bit_or|bit_xor|bit_not|shift_left|shift_right|read8|read16|read32|read64|write8|write16|write32|write64|asm|address_of|port_in8|port_in16|port_in32|port_out8|port_out16|port_out32|page_new|page_free|interrupts_on|interrupts_off|uptime_ms|wait_ms|read_key|yield)\\b(?=\\s*\\()", "name": "support.function.builtin.tachbit" }
      ]
    },
    "numbers": { "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+(\\.[0-9]+)?)\\b", "name": "constant.numeric.tachbit" },
    "calls": { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()", "captures": { "1": { "name": "entity.name.function.call.tachbit" } } },
    "operators": { "match": "\\+=|-=|\\*=|/=|==|!=|<=|>=|[-+*/%<>=]", "name": "keyword.operator.tachbit" }
  }
}
