// Слой 3. ПРОВЕРКА: ищет ошибки до запуска и узнаёт тип каждого значения.
// Таблица типов, таблица функций и obj, таблица переменных (со слоями-областями).
// Номер типа: 0 none, 1 int, 2 dec, 3 bool, 4 text, дальше — составные.
// -1 — тип ещё не известен.
use errors
use parser

// ---------- типы ----------
// Каждый тип хранится один раз: два "list int" — это один и тот же номер.

modpub func make_type_key(c: Comp, kind: text, key: int, elem: int, onode: Node, has_obj: bool, fnode: Node, has_func: bool) gives r: int
    obj_name = ""
    if has_obj
        obj_name = onode.name
    func_key = ""
    if has_func
        func_key = fnode.mod + "." + fnode.name
    each t in c.types
        if t.kind == kind and t.key == key and t.elem == elem and t.obj_name == obj_name and t.func_key == func_key
            return t.id
    if len(c.types) == 1000
        error_at(c, 0, "слишком много разных типов", "")
    t = Type(kind: kind, key: key, elem: elem, obj_name: obj_name, func_key: func_key, id: len(c.types))
    if has_obj
        t.obj_node = onode
    if has_func
        t.func_node = fnode
    c.types.add(t)
    return t.id

func simple_type(c: Comp, kind: text)
    nothing = Node(kind: "missing")
    return make_type_key(c, kind, -1, -1, nothing, false, nothing, false)

modpub func list_of(c: Comp, elem: int)
    nothing = Node(kind: "missing")
    return make_type_key(c, "list", -1, elem, nothing, false, nothing, false)

// номерок background: elem — что отдаст функция (0 — ничего)
func task_of(c: Comp, elem: int)
    nothing = Node(kind: "missing")
    return make_type_key(c, "task", -1, elem, nothing, false, nothing, false)

func chan_of(c: Comp, elem: int)
    nothing = Node(kind: "missing")
    return make_type_key(c, "channel", -1, elem, nothing, false, nothing, false)

func dict_of(c: Comp, key: int, value: int)
    nothing = Node(kind: "missing")
    return make_type_key(c, "dict", key, value, nothing, false, nothing, false)

func obj_type(c: Comp, o: Node)
    nothing = Node(kind: "missing")
    return make_type_key(c, "obj", -1, -1, o, true, nothing, false)

func enum_type(c: Comp, e: Node)
    nothing = Node(kind: "missing")
    return make_type_key(c, "enum", -1, -1, e, true, nothing, false)

func find_enum(c: Comp, name: text)
    count i from 0 to len(c.enums) - 1
        if c.enums[i].name == name
            return i
    return -1

// номер варианта в enum (или -1)
func enum_index(e: Node, name: text)
    count i from 0 to len(e.kids) - 1
        if e.kids[i].name == name
            return i
    return -1

func multi_type(c: Comp, fnode: Node)
    nothing = Node(kind: "missing")
    return make_type_key(c, "multi", -1, -1, nothing, false, fnode, true)

modpub func kind_of(c: Comp, t: int)
    if t < 0
        return "unknown"
    return c.types[t].kind

modpub func type_name(c: Comp, t: int) gives r: text
    if t < 0
        return "?"
    ty = c.types[t]
    if ty.kind == "list"
        return "list " + type_name(c, ty.elem)
    if ty.kind == "dict"
        return "dict " + type_name(c, ty.key) + " " + type_name(c, ty.elem)
    if ty.kind == "obj"
        return ty.obj_node.name
    if ty.kind == "multi"
        return "несколько выходов"
    if ty.kind == "none"
        return "ничего"
    if ty.kind == "task"
        return "номерок background"
    if ty.kind == "channel"
        return "channel " + type_name(c, ty.elem)
    if ty.kind == "enum"
        return ty.obj_node.name
    return ty.kind

func is_number(t: int)
    return t == 1 or t == 2

modpub func is_list(c: Comp, t: int)
    return kind_of(c, t) == "list"

func is_dict(c: Comp, t: int)
    return kind_of(c, t) == "dict"

// obj ... by columns
modpub func is_cols_obj(c: Comp, t: int)
    return kind_of(c, t) == "obj" and c.types[t].obj_node.by_cols

// list Point, где Point by columns: хранится колонками
modpub func is_cols_list(c: Comp, t: int)
    return kind_of(c, t) == "list" and is_cols_obj(c, c.types[t].elem)

func is_scalar(c: Comp, t: int)
    return t == 1 or t == 2 or t == 3 or t == 4 or is_enum(c, t)

// можно ли положить значение типа from туда, где ждут to
func fits(want: int, got: int)
    if want == got
        return true
    if want == 2 and got == 1
        return true
    return false

// ---------- функции и obj ----------

func is_builtin(name: text)
    each b in ["print", "show", "len", "round", "code", "char", "cut", "to_int", "to_dec", "read_file", "write_file", "input", "args", "split", "join", "find", "replace", "upper", "lower", "trim", "starts_with", "ends_with", "sort", "abs", "min", "max", "sqrt", "run", "exit", "file_exists", "list_dir", "is_folder", "make_folder", "move", "remove", "env", "file_size", "window_open", "window_alive", "clear_window", "draw_pixel", "draw_rect", "draw_circle", "draw_triangle", "mesh_new", "mesh_add", "draw_mesh", "camera", "draw_line", "draw_text", "key_down", "mouse_x", "mouse_y", "mouse_down", "frame_ms", "fps", "set_fps", "window_w", "window_h", "load_image", "draw_image", "image_w", "image_h", "rgb", "random", "time_ms", "http_get", "json_get", "json_text", "date_now", "unix_time"]
        if b == name
            return true
    each b in kernel_builtins()
        if b == name
            return true
    return false

// для железа и ядер: биты (везде), адреса и порты (только в danger), время и клавиши (в ядре)
func kernel_builtins() gives names: list text
    names = ["bit_and", "bit_or", "bit_xor", "bit_not", "shift_left", "shift_right", "read8", "read16", "read32", "read64", "write8", "write16", "write32", "write64", "asm", "address_of", "port_in8", "port_in16", "port_in32", "port_out8", "port_out16", "port_out32", "page_new", "page_free", "interrupts_on", "interrupts_off", "uptime_ms", "wait_ms", "read_key", "yield"]
    return names

// только внутри danger
func danger_only(name: text)
    each w in ["read8", "read16", "read32", "read64", "write8", "write16", "write32", "write64", "asm", "address_of"]
        if name == w
            return true
    each w in ["port_", "page_", "interrupts_"]
        if starts_with(name, w)
            return true
    return false

// только в ядре (tachbit bare): там есть порты, таймер и клавиатура
func bare_only(name: text)
    each w in ["port_", "page_", "interrupts_", "uptime_ms", "read_key", "yield"]
        if starts_with(name, w)
            return true
    return false

// только в обычной программе (в ядре нет файлов и папок)
func os_only(name: text)
    each w in ["list_dir", "is_folder", "make_folder", "move", "remove", "env", "file_size", "window_open", "window_alive", "clear_window", "draw_pixel", "draw_rect", "draw_circle", "draw_triangle", "mesh_new", "mesh_add", "draw_mesh", "camera", "draw_line", "draw_text", "key_down", "mouse_x", "mouse_y", "mouse_down", "frame_ms", "fps", "set_fps", "window_w", "window_h", "load_image", "draw_image", "image_w", "image_h", "rgb", "random", "time_ms", "http_get", "json_get", "json_text", "date_now", "unix_time"]
        if name == w
            return true
    return false

// окно и рисование
func gfx_builtin(name: text)
    each w in ["window_open", "window_alive", "clear_window", "draw_pixel", "draw_rect", "draw_circle", "draw_triangle", "mesh_new", "mesh_add", "draw_mesh", "camera", "draw_line", "draw_text", "key_down", "mouse_x", "mouse_y", "mouse_down", "frame_ms", "fps", "set_fps", "window_w", "window_h", "load_image", "draw_image", "image_w", "image_h"]
        if name == w
            return true
    return false

// встроенные функции, которые могут закончиться ошибкой
func builtin_can_fail(name: text)
    if name == "list_dir" or name == "make_folder" or name == "move" or name == "remove" or name == "window_open" or name == "load_image"
        return true
    return name == "to_int" or name == "to_dec" or name == "read_file" or name == "write_file" or name == "input" or name == "http_get" or name == "json_get"

// ---------- модули ----------
// use money: модуль main видит modpub-функции модуля money

func is_module(c: Comp, name: text)
    each m in c.all_mods
        if m == name
            return true
    return false

func module_uses(c: Comp, mod: text, other: text)
    if mod == other
        return true
    each u in c.uses
        if u.mod == mod and u.used == other
            return true
    return false

// номер функции в c.funcs или -1
func find_func_in(c: Comp, name: text, mod: text)
    count i from 0 to len(c.funcs) - 1
        f = c.funcs[i]
        if f.name == name and f.mod == mod
            return i
    return -1

// функция, которую видно из текущего модуля: своя или modpub из модуля после use
func find_func(c: Comp, name: text)
    own = find_func_in(c, name, c.cur_mod)
    if own >= 0
        return own
    found = -1
    count i from 0 to len(c.funcs) - 1
        f = c.funcs[i]
        if f.name == name and f.node.is_pub and module_uses(c, c.cur_mod, f.mod)
            if found >= 0
                error_at(c, f.node.line, "функция с таким именем есть в двух модулях, напиши модуль: money.total(...)", name)
            found = i
    return found

// почему функцию не видно: подсказка для ошибки
func explain_missing_func(c: Comp, n: Node)
    each f in c.funcs
        if f.name == n.name
            if not f.node.is_pub
                error_at(c, n.line, "эта функция спрятана в своём модуле: поставь перед ней modpub", f.mod)
            error_at(c, n.line, "функция лежит в другом модуле: добавь в начало файла  use", f.mod)
    error_at(c, n.line, "нет такой функции", n.name)

// номер obj в c.objs или -1
func find_obj(c: Comp, name: text)
    count i from 0 to len(c.objs) - 1
        if c.objs[i].name == name
            return i
    return -1

func find_field(o: Node, name: text)
    count i from 0 to len(o.kids) - 1
        if o.kids[i].name == name
            return i
    return -1

func resolve_type(c: Comp, t: Node) gives r: int
    if t.name == "int"
        return 1
    if t.name == "dec"
        return 2
    if t.name == "text"
        return 4
    if t.name == "bool"
        return 3
    if t.name == "list"
        return list_of(c, resolve_type(c, t.kids[0]))
    if t.name == "channel"
        elem = resolve_type(c, t.kids[0])
        if not is_scalar(c, elem)
            error_at(c, t.line, "по каналу пока идут только int, dec, bool и text", "")
        return chan_of(c, elem)
    if t.name == "dict"
        key = resolve_type(c, t.kids[0])
        value = resolve_type(c, t.kids[1])
        return dict_of(c, key, value)
    o = find_obj(c, t.name)
    if o < 0
        en = find_enum(c, t.name)
        if en >= 0
            return enum_type(c, c.enums[en])
        error_at(c, t.line, "нет такого типа, obj и enum", t.name)
    return obj_type(c, c.objs[o])

// ---------- переменные ----------

// номер переменной в c.vars или -1
func find_var(c: Comp, name: text)
    i = len(c.vars) - 1
    repeat while i >= c.var_base and i >= c.n_globals
        if c.vars[i].name == name
            return i
        i -= 1
    // shared снаружи функций: видны везде
    count g from 0 to c.n_globals - 1
        if c.vars[g].name == name
            return g
    return -1

func name_is_free(c: Comp, name: text, line: int)
    if find_var(c, name) >= 0
        error_at(c, line, "такое имя уже есть, возьми другое", name)
    // имя встроенной функции (code, len ...) для переменной можно: вызов code(...) всё равно работает
    if find_func(c, name) >= 0
        error_at(c, line, "так уже называется функция", name)
    if find_obj(c, name) >= 0
        error_at(c, line, "так уже называется obj", name)

func add_var(c: Comp, name: text, type: int, is_const: bool, is_link: bool, line: int)
    name_is_free(c, name, line)
    if len(c.vars) == 2000
        error_at(c, line, "слишком много переменных", "")
    c.vars.add(Var(name: name, type: type, is_const: is_const, is_link: is_link, depth: c.depth, loop_d: c.loop_depth))

func cut_vars(c: Comp, count_left: int)
    repeat while len(c.vars) > count_left
        gone = c.vars.pop()

func open_scope(c: Comp)
    c.depth += 1

func close_scope(c: Comp)
    repeat while len(c.vars) > 0 and c.vars[len(c.vars) - 1].depth == c.depth
        gone = c.vars.pop()
    c.depth -= 1

// ---------- on all cores ----------

func loop_word(c: Comp)
    if c.par_vec
        return "by vec"
    return "on all cores"

// внутри on all cores, и переменная номер v — снаружи цикла (но в этой же функции)
func outside_par(c: Comp, v: int)
    return c.par_base >= 0 and v >= c.n_globals and v < c.par_base

// переменная, от которой начинается место: u.tags[2] → u
func root_var(c: Comp, n: Node) gives r: int
    if n.kind == "index" or n.kind == "field" or n.kind == "method"
        return root_var(c, n.kids[0])
    if n.kind == "name"
        return find_var(c, n.name)
    return -1

// цикл on all cores видит эту переменную снаружи: запомнить, чтобы передать ядрам
func capture(c: Comp, v: int)
    var = c.vars[v]
    each old in c.par_node.caps
        if old.name == var.name and (not c.par_vec or not old.is_shared)
            return
    c.par_node.caps.add(Var(name: var.name, type: var.type, is_link: var.is_link, is_shared: var.is_shared and not c.par_vec))

// ---------- temp ----------
// Внутри temp видны только такие переменные снаружи, через которые нельзя
// вынести временную память: числа, bool, текст (его нельзя менять) и списки/dict чисел.
func outside_temp(c: Comp, v: int)
    return c.temp_base >= 0 and v >= c.n_globals and v < c.temp_base

func is_plain(c: Comp, t: int)
    return t == 1 or t == 2 or t == 3 or is_enum(c, t)

// enum: значение — просто номер варианта
modpub func is_enum(c: Comp, t: int)
    return t > 4 and c.types[t].kind == "enum"

func temp_can_see(c: Comp, t: int)
    if is_plain(c, t) or t == 4
        return true
    if is_list(c, t)
        return is_plain(c, c.types[t].elem)
    if is_dict(c, t)
        return c.types[t].key == 1 and is_plain(c, c.types[t].elem)
    return false

func temp_keep_out(c: Comp, line: int, name: text)
    error_at(c, line, "из temp наружу можно сохранить только int, dec или bool: текст, списки и obj удалятся в конце блока", name)

func no_outside_change(c: Comp, n: Node)
    note_change(c, n)

// значение кладут куда-то на хранение: список, на который оно ведёт, теперь не только у своей переменной
func note_escape(c: Comp, value: Node)
    if not is_ref(c, value.ty)
        return
    s = src_of(c, value)
    if s >= 0
        c.vars[s].escaped = true
        if c.vars[s].pno > 0 and c.current >= 0
            key = "f" + c.current + "#" + (c.vars[s].pno - 1)
            if not text_in(c.keep_keys, key)
                c.keep_keys.add(key)

// background f(move xs): xs уходит в фон целиком, у main его больше нет
func check_move(c: Comp, value: Node, p: Node)
    if value.kind != "name"
        error_at(c, value.line, "через move отдают переменную целиком: move xs", "")
    v = find_var(c, value.name)
    var = c.vars[v]
    t = var.type
    ok = (is_list(c, t) and is_scalar(c, c.types[t].elem)) or (is_dict(c, t) and is_scalar(c, c.types[t].elem))
    if not ok
        error_at(c, value.line, "через move пока отдают список или dict из int, dec, bool или text: obj внутри могли бы быть видны ещё откуда-то", value.name)
    if var.is_link or var.pno > 0 or v < c.n_globals
        error_at(c, value.line, "через move отдают только свою переменную, созданную в этой функции (не параметр и не ярлык)", value.name)
    if var.src1 > 0 or var.escaped
        error_at(c, value.line, "этот список виден ещё откуда-то (второе имя или лежит в другом списке/obj): move отдал бы его сразу двоим", value.name)
    count w from c.var_base to len(c.vars) - 1
        if w != v and (c.vars[w].src1 == v + 1 or c.vars[w].link_root1 == v + 1)
            error_at(c, value.line, "у этого списка есть второе имя: " + c.vars[w].name + " — move отдал бы его сразу двоим", value.name)
    if var.loop_d < c.loop_depth
        error_at(c, value.line, "в цикле через move отдают только список, созданный в этом же шаге цикла: иначе на следующем шаге его уже нет", value.name)
    c.vars[v].moved = true

// ---------- «своё» и «чужое» (защита потоков) ----------
// Как цеховой инструмент и личный: всё, что создано снаружи on all cores, — цеховое,
// его можно только читать. «Цвет» идёт за данными: ys = xs, u = users[i], each u in users
// — тоже цеховое. И функции: если функция меняет полученный список или obj (сама или
// через другие функции), отдавать ей цеховое внутри on all cores нельзя.

// список, dict или obj: их можно менять (текст менять нельзя)
func is_ref(c: Comp, t: int)
    return t > 4 and not is_enum(c, t)

// откуда данные у переменной: ys = xs → xs (иначе она сама)
func origin(c: Comp, v: int) gives r: int
    if v >= 0 and c.vars[v].src1 > 0
        return c.vars[v].src1 - 1
    return v

// переменная, через которую значение n может вести к тем же спискам/obj (или -1)
func src_of(c: Comp, n: Node) gives r: int
    if not is_ref(c, n.ty) and n.kind != "arg"
        return -1
    if n.kind == "name"
        v = find_var(c, n.name)
        if v >= 0
            return origin(c, v)
        return -1
    if n.kind == "index" or n.kind == "field"
        return src_of(c, n.kids[0])
    each kid in n.kids
        s = src_of(c, kid)
        if s >= 0
            return s
    return -1

// параметр функции o меняют: запомнить «функция#параметр»
func mark_param(c: Comp, o: int)
    if o < 0 or c.vars[o].pno == 0 or c.current < 0
        return
    key = "f" + c.current + "#" + (c.vars[o].pno - 1)
    each k in c.mut_keys
        if k == key
            return
    c.mut_keys.add(key)

func outside_change_error(c: Comp, line: int)
    error_at(c, line, "внутри " + loop_word(c) + " нельзя менять списки и obj снаружи цикла и то, что из них взято (свои, созданные внутри, — можно)", "")

// данные меняют через место n: a.add(...), a[i] = ..., a.n += 1, link на a[i]
func note_change(c: Comp, n: Node)
    r = root_var(c, n)
    if r < 0
        return
    c.vars[r].changed = true
    o = origin(c, r)
    if outside_par(c, r) or outside_par(c, o)
        outside_change_error(c, n.line)
    mark_param(c, o)

// переменная v (список/obj) теперь ведёт к данным переменной s
func set_src(c: Comp, v: int, s: int, line: int)
    if s < 0 or s >= v
        // s заведена позже v (во внутреннем блоке): это свои новые данные, «цвета» нет
        c.vars[v].src1 = 0
        return
    if c.vars[v].changed
        // через v уже меняли (например, в прошлом шаге цикла) — значит, будут менять и s
        if outside_par(c, s)
            outside_change_error(c, line)
        mark_param(c, s)
    c.vars[v].src1 = s + 1

// после всей проверки: функции, которые меняют параметр (и через другие функции),
// и вызовы из on all cores, которые отдают им данные снаружи
func check_par_calls(c: Comp)
    more = true
    repeat while more
        more = false
        count j from 0 to len(c.e_from) - 1
            if text_in(c.mut_keys, c.e_to[j]) and not text_in(c.mut_keys, c.e_from[j])
                c.mut_keys.add(c.e_from[j])
                more = true
    count j from 0 to len(c.pc_keys) - 1
        if text_in(c.mut_keys, c.pc_keys[j])
            c.file_name = c.pc_files[j]
            error_at(c, c.pc_lines[j], "внутри on all cores эта функция меняет полученный список или obj, а он снаружи цикла: собери свой список или obj внутри цикла и передай его", c.pc_names[j])

// запись в общую shared-переменную номер r: запомнить, где и под замком ли
func note_global_write(c: Comp, r: int, line: int)
    if r < 0 or r >= c.n_globals or c.current < 0
        return
    c.gw_func.add(c.current)
    c.gw_lock.add(c.lock_depth > 0)
    c.gw_line.add(line)
    c.gw_name.add(c.vars[r].name)
    c.gw_file.add(c.file_name)

// shared, которую меняет функция, идущая параллельно (background, on all cores, together,
// и всё, что они зовут), везде меняется только под lock: иначе два += теряют друг друга
func check_global_writes(c: Comp)
    conc = list bool
    count i from 1 to len(c.funcs)
        conc.add(false)
    each f in c.bg_funcs
        conc[f] = true
    count j from 0 to len(c.call_to) - 1
        if c.call_par[j]
            conc[c.call_to[j]] = true
    more = true
    repeat while more
        more = false
        count j from 0 to len(c.call_to) - 1
            if c.call_from[j] >= 0 and conc[c.call_from[j]] and not conc[c.call_to[j]]
                conc[c.call_to[j]] = true
                more = true
    count j from 0 to len(c.gw_func) - 1
        if c.gw_lock[j]
            skip
        busy = false
        count k from 0 to len(c.gw_func) - 1
            if c.gw_name[k] == c.gw_name[j] and conc[c.gw_func[k]]
                busy = true
        if busy
            c.file_name = c.gw_file[j]
            error_at(c, c.gw_line[j], "эту shared меняет функция, которая идёт параллельно (background или on all cores): меняй её под замком  lock имя", c.gw_name[j])

// живой ярлык на элемент списка/dict переменной o (номер ярлыка или -1)
func link_alive(c: Comp, o: int) gives r: int
    if o < 0
        return -1
    count v from c.var_base to len(c.vars) - 1
        if c.vars[v].link_root1 == o + 1
            return v
    return -1

// список/dict base меняет длину: нельзя, пока на его элемент смотрит ярлык
// (память списка переедет, ярлык поведёт в пустоту), и нельзя убирать из dict, пока по нему идёт each
func no_resize(c: Comp, base: Node, line: int, shrink: bool)
    o = origin(c, root_var(c, base))
    la = link_alive(c, o)
    if la >= 0
        error_at(c, line, "пока жив ярлык на элемент этого списка или dict, его нельзя растить и уменьшать: память переедет, и ярлык поведёт в пустоту", c.vars[la].name)
    if shrink and o >= 0
        each b in c.each_busy
            if b == o
                error_at(c, line, "из dict нельзя убирать ключи, пока по нему идёт each: часть ключей пропустится. Собери ключи в список и убери после цикла", "")

// после всей проверки: замок, который функция берёт (сама или через другие функции),
// нельзя брать снова из-под того же замка — она ждала бы сама себя вечно
func check_lock_calls(c: Comp)
    has = list text
    count i from 1 to len(c.funcs)
        has.add(",")
    count j from 0 to len(c.lk_func) - 1
        if not find(has[c.lk_func[j]], "," + c.lk_name[j] + ",") >= 0
            has[c.lk_func[j]] = has[c.lk_func[j]] + c.lk_name[j] + ","
    more = true
    repeat while more
        more = false
        count j from 0 to len(c.call_to) - 1
            a = c.call_from[j]
            b = c.call_to[j]
            if a < 0
                skip
            each name in split(has[b], ",")
                if name != "" and not find(has[a], "," + name + ",") >= 0
                    has[a] = has[a] + name + ","
                    more = true
    count j from 0 to len(c.lc_func) - 1
        each name in split(has[c.lc_func[j]], ",")
            if name != "" and find(c.lc_held[j], "," + name + ",") >= 0
                c.file_name = c.lc_file[j]
                error_at(c, c.lc_line[j], "функцию зовут из-под lock " + name + ", а она сама берёт этот замок: ждала бы сама себя вечно", c.lc_name[j])
    // порядок замков: под замком h функция берёт замок l → ребро h>l
    count j from 0 to len(c.lc_func) - 1
        each name in split(has[c.lc_func[j]], ",")
            if name == ""
                skip
            each h in split(c.lc_held[j], ",")
                if h != "" and h != name
                    c.lo_edge.add(h + ">" + name)
                    c.lo_line.add(c.lc_line[j])
                    c.lo_file.add(c.lc_file[j])
    check_lock_order(c)
    count j from 0 to len(c.lr_keys) - 1
        if text_in(c.mut_keys, c.lr_keys[j])
            c.file_name = c.lr_files[j]
            error_at(c, c.lr_lines[j], "эта функция меняет список, а на его элемент смотрит живой ярлык: если список вырастет, ярлык поведёт в пустоту", c.lr_names[j])

// замки берут в одном порядке: если где-то a, а внутри b, то нигде нельзя b, а внутри a
// (и по кругу через третий замок): две работы взяли бы по одному и ждали друг друга вечно
func check_lock_order(c: Comp)
    reach = list text
    each e in c.lo_edge
        if not text_in(reach, e)
            reach.add(e)
    more = true
    repeat while more
        more = false
        count i from 0 to len(reach) - 1
            ab = split(reach[i], ">")
            count j from 0 to len(c.lo_edge) - 1
                bc = split(c.lo_edge[j], ">")
                if ab[1] == bc[0]
                    e = ab[0] + ">" + bc[1]
                    if not text_in(reach, e)
                        reach.add(e)
                        more = true
    count j from 0 to len(c.lo_edge) - 1
        ab = split(c.lo_edge[j], ">")
        if text_in(reach, ab[1] + ">" + ab[0])
            c.file_name = c.lo_file[j]
            error_at(c, c.lo_line[j], "замки " + ab[0] + " и " + ab[1] + " берут в разном порядке: где-то " + ab[0] + " потом " + ab[1] + ", а где-то наоборот — две работы могут ждать друг друга вечно. Бери их везде в одном порядке", "")

func text_in(xs: list text, x: text)
    each s in xs
        if s == x
            return true
    return false

// ---------- выражения ----------

func need_value(c: Comp, n: Node, t: int)
    if t == 0
        error_at(c, n.line, "это ничего не возвращает, значение нельзя использовать", n.name)
    if kind_of(c, t) == "multi"
        error_at(c, n.line, "у функции несколько выходов: пиши  a, b = ...", n.name)

func check_value(c: Comp, n: Node) gives r: int
    t = check_expr(c, n)
    need_value(c, n, t)
    return t

func check_binop(c: Comp, n: Node) gives r: int
    op = n.value
    if op == "or" and can_fail_call(c, n.kids[0])
        // f() or запасное: если f сломалась, берём запасное
        a = check_handled(c, n.kids[0], "or")
        b = check_value(c, n.kids[1])
        if not fits(a, b)
            error_at(c, n.line, "запасное значение после or другого типа", type_name(c, a))
        if a == 0
            error_at(c, n.line, "у функции нет значения, тут подходит  try  или  else err", "")
        if len(c.temp_types) == 2001
            error_at(c, n.line, "слишком много or", "")
        c.temp_types.add(a)
        n.temp_no = len(c.temp_types) - 1
        n.value = "orelse"
        return a
    a = check_value(c, n.kids[0])
    b = check_value(c, n.kids[1])
    if op == "and" or op == "or"
        if a != 3 or b != 3
            error_at(c, n.line, "and / or работают только с true и false", "")
        return 3
    if op == "==" or op == "!="
        if not (is_number(a) and is_number(b)) and a != b
            error_at(c, n.line, "нельзя сравнить разные типы", "")
        if not is_scalar(c, a)
            error_at(c, n.line, "списки и объекты пока нельзя сравнивать", "")
        return 3
    if op == "<" or op == ">" or op == "<=" or op == ">="
        if a == 4 and b == 4
            return 3
        if not is_number(a) or not is_number(b)
            error_at(c, n.line, "больше / меньше работают с числами или с двумя текстами", op)
        return 3
    if op == "+" and (a == 4 or b == 4)
        if is_enum(c, a) or is_enum(c, b)
            error_at(c, n.line, "enum к тексту пока не приписывается: print(s) печатает имя варианта", "")
        if not is_scalar(c, a) or not is_scalar(c, b)
            error_at(c, n.line, "список или объект нельзя сложить с текстом", "")
        return 4
    if not is_number(a) or not is_number(b)
        error_at(c, n.line, "эта операция работает только с числами", op)
    if op == "%" and (a == 2 or b == 2)
        error_at(c, n.line, "остаток % считается только для int", "")
    if a == 2 or b == 2
        return 2
    return 1

func check_list(c: Comp, n: Node) gives r: int
    if len(n.kids) == 0
        error_at(c, n.line, "пустой список пишется с типом: x = list int", "")
    elem = check_value(c, n.kids[0])
    note_escape(c, n.kids[0])
    count i from 1 to len(n.kids) - 1
        t = check_value(c, n.kids[i])
        note_escape(c, n.kids[i])
        if fits(elem, t)
            skip
        if elem == 1 and t == 2
            elem = 2
            skip
        error_at(c, n.kids[i].line, "в одном списке все значения одного типа", type_name(c, elem))
    return list_of(c, elem)

// значения builtins: только по порядку, без имён
func builtin_arg(c: Comp, n: Node, i: int) gives r: int
    if n.kids[i].name != ""
        error_at(c, n.line, "у встроенных функций аргументы пишутся без имён", n.kids[i].name)
    t = check_value(c, n.kids[i].kids[0])
    n.kids[i].ty = t
    return t

// проверка аргументов встроенной функции по строке-шаблону:
// "t" text, "i" int, "n" число, "L" список text, "s" список для sort, "x" список/текст/dict
func builtin_args(c: Comp, n: Node, pattern: text, usage: text)
    if len(n.kids) != len(pattern)
        error_at(c, n.line, "не то количество значений, правильно так", usage)
    count i from 0 to len(pattern) - 1
        t = builtin_arg(c, n, i)
        p = pattern[i]
        ok = true
        if p == "t"
            ok = t == 4
        else if p == "i"
            ok = t == 1
        else if p == "n"
            ok = is_number(t)
        else if p == "L"
            ok = is_list(c, t) and c.types[t].elem == 4
        else if p == "s"
            ok = is_list(c, t) and (c.types[t].elem == 1 or c.types[t].elem == 2 or c.types[t].elem == 4)
        else if p == "x"
            ok = is_list(c, t) or is_dict(c, t) or t == 4
        if not ok
            error_at(c, n.line, "не тот тип значения, правильно так", usage)

func check_builtin(c: Comp, n: Node) gives r: int
    name = n.name
    if danger_only(name) and c.danger_depth == 0
        error_at(c, n.line, name + " трогает железо напрямую: пиши его внутри блока danger", "")
    if os_only(name) and c.bare
        error_at(c, n.line, name + " нет в ядре без ОС: там нет файлов, окон и часов", "")
    if gfx_builtin(name)
        c.gfx = true
    if bare_only(name) and not c.bare
        error_at(c, n.line, name + " работает только в ядре без ОС: собери файл командой tachbit bare", "")
    if starts_with(name, "bit_") or starts_with(name, "shift_")
        if name == "bit_not"
            builtin_args(c, n, "i", "bit_not(число)")
        else
            builtin_args(c, n, "ii", name + "(a, b)")
        return 1
    if starts_with(name, "read") and danger_only(name)
        builtin_args(c, n, "i", name + "(адрес)")
        return 1
    if starts_with(name, "write") and danger_only(name)
        builtin_args(c, n, "ii", name + "(адрес, число)")
        return 0
    if starts_with(name, "port_in")
        builtin_args(c, n, "i", name + "(порт)")
        return 1
    if starts_with(name, "port_out")
        builtin_args(c, n, "ii", name + "(порт, число)")
        return 0
    if name == "asm"
        if len(n.kids) != 1 or n.kids[0].kids[0].kind != "string"
            error_at(c, n.line, "в asm пишется текст в кавычках сразу: asm(\"cli\")", "")
        builtin_args(c, n, "t", "asm(\"команда\")")
        return 0
    if name == "address_of"
        builtin_args(c, n, "x", "address_of(список)")
        if not is_list(c, n.kids[0].ty)
            error_at(c, n.line, "address_of даёт адрес данных списка: address_of(buf)", "")
        return 1
    if name == "page_new" or name == "uptime_ms"
        builtin_args(c, n, "", name + "()")
        return 1
    if name == "page_free" or name == "wait_ms"
        builtin_args(c, n, "i", name + "(число)")
        return 0
    if name == "interrupts_on" or name == "interrupts_off" or name == "yield"
        builtin_args(c, n, "", name + "()")
        return 0
    if name == "read_key"
        builtin_args(c, n, "", "read_key()  →  нажатая буква или \"\"")
        return 4
    if name == "print" or name == "show"
        count i from 0 to len(n.kids) - 1
            t = builtin_arg(c, n, i)
        return 0
    if name == "len"
        builtin_args(c, n, "x", "len(список, текст или dict)")
        return 1
    if name == "round"
        builtin_args(c, n, "n", "round(число)")
        return 1
    if name == "code"
        builtin_args(c, n, "t", "code(\"A\")  →  65")
        return 1
    if name == "char"
        builtin_args(c, n, "i", "char(66)  →  \"B\"")
        return 4
    if name == "cut"
        builtin_args(c, n, "tii", "cut(текст, с какого номера, по какой номер)")
        return 4
    if name == "to_int"
        builtin_args(c, n, "t", "to_int(\"42\")")
        return 1
    if name == "to_dec"
        builtin_args(c, n, "t", "to_dec(\"9.5\")")
        return 2
    if name == "read_file"
        builtin_args(c, n, "t", "read_file(\"путь\")")
        return 4
    if name == "write_file"
        builtin_args(c, n, "tt", "write_file(\"путь\", текст)")
        return 0
    if name == "input"
        builtin_args(c, n, "", "input()")
        return 4
    if name == "args"
        builtin_args(c, n, "", "args()")
        return list_of(c, 4)
    if name == "split"
        builtin_args(c, n, "tt", "split(текст, разделитель)")
        return list_of(c, 4)
    if name == "join"
        builtin_args(c, n, "Lt", "join(список text, разделитель)")
        return 4
    if name == "find"
        builtin_args(c, n, "tt", "find(текст, что ищем)  →  номер или -1")
        return 1
    if name == "replace"
        builtin_args(c, n, "ttt", "replace(текст, что, на что)")
        return 4
    if name == "upper" or name == "lower" or name == "trim"
        builtin_args(c, n, "t", "upper(текст)")
        return 4
    if name == "starts_with" or name == "ends_with"
        builtin_args(c, n, "tt", "starts_with(текст, начало)")
        return 3
    if name == "sort"
        builtin_args(c, n, "s", "sort(список int, dec или text)")
        note_change(c, n.kids[0].kids[0])
        return 0
    if name == "run"
        builtin_args(c, n, "t", "run(\"команда терминала\")  →  код выхода int")
        return 1
    if name == "exit"
        builtin_args(c, n, "i", "exit(код)")
        return 0
    if name == "file_exists"
        builtin_args(c, n, "t", "file_exists(\"путь\")")
        return 3
    if name == "list_dir"
        builtin_args(c, n, "t", "list_dir(\"папка\")  →  имена, у папок / в конце")
        return list_of(c, 4)
    if name == "is_folder"
        builtin_args(c, n, "t", "is_folder(\"путь\")")
        return 3
    if name == "make_folder"
        builtin_args(c, n, "t", "make_folder(\"путь\")")
        return 0
    if name == "move"
        builtin_args(c, n, "tt", "move(\"откуда\", \"куда\")")
        return 0
    if name == "remove"
        builtin_args(c, n, "t", "remove(\"файл или пустая папка\")")
        return 0
    if name == "env"
        builtin_args(c, n, "t", "env(\"HOME\")")
        return 4
    if name == "http_get"
        builtin_args(c, n, "t", "http_get(\"https://...\")  →  текст страницы")
        return 4
    if name == "json_get"
        builtin_args(c, n, "tt", "json_get(текст_json, \"users.0.name\")  →  текст")
        return 4
    if name == "json_text"
        builtin_args(c, n, "t", "json_text(текст)  →  строка JSON в кавычках")
        return 4
    if name == "date_now"
        builtin_args(c, n, "", "date_now()  →  \"2026-11-17 12:30:00\"")
        return 4
    if name == "unix_time"
        builtin_args(c, n, "", "unix_time()  →  секунды с 1970 года")
        return 1
    if name == "file_size"
        builtin_args(c, n, "t", "file_size(\"путь\")  →  байты или -1")
        return 1
    if name == "window_open"
        builtin_args(c, n, "iit", "window_open(ширина, высота, \"заголовок\")")
        return 0
    if name == "window_alive" or name == "mouse_down"
        builtin_args(c, n, "", name + "()")
        return 3
    if name == "mouse_x" or name == "mouse_y" or name == "time_ms" or name == "fps" or name == "window_w" or name == "window_h"
        builtin_args(c, n, "", name + "()")
        return 1
    if name == "frame_ms"
        builtin_args(c, n, "", "frame_ms()  →  сколько мс шёл прошлый кадр (дробное)")
        return 2
    if name == "set_fps"
        builtin_args(c, n, "i", "set_fps(кадров_в_секунду)  — 0: сколько успеет, без ожидания экрана")
        return 0
    if name == "load_image"
        builtin_args(c, n, "t", "load_image(\"картинка.png\")  →  номер картинки")
        return 1
    if name == "draw_image"
        builtin_args(c, n, "iii", "draw_image(картинка, x, y)")
        return 0
    if name == "image_w" or name == "image_h"
        builtin_args(c, n, "i", name + "(картинка)  →  точки")
        return 1
    if name == "clear_window"
        builtin_args(c, n, "i", "clear_window(цвет)")
        return 0
    if name == "draw_pixel"
        builtin_args(c, n, "iii", "draw_pixel(x, y, цвет)")
        return 0
    if name == "draw_rect"
        builtin_args(c, n, "iiiii", "draw_rect(x, y, ширина, высота, цвет)")
        return 0
    if name == "draw_circle"
        builtin_args(c, n, "iiii", "draw_circle(x, y, радиус, цвет)")
        return 0
    if name == "mesh_new"
        builtin_args(c, n, "", "mesh_new()  →  номер сетки")
        return 1
    if name == "mesh_add"
        builtin_args(c, n, "innnnnnnnni", "mesh_add(сетка, x1, y1, z1, x2, y2, z2, x3, y3, z3, цвет)")
        return 0
    if name == "draw_mesh"
        builtin_args(c, n, "innnn", "draw_mesh(сетка, x, y, z, поворот в градусах)")
        return 0
    if name == "camera"
        builtin_args(c, n, "nnnnnn", "camera(x, y, z, куда x, куда y, куда z)")
        return 0
    if name == "draw_triangle"
        builtin_args(c, n, "iiiiiii", "draw_triangle(x1, y1, x2, y2, x3, y3, цвет)")
        return 0
    if name == "draw_line"
        builtin_args(c, n, "iiiii", "draw_line(x1, y1, x2, y2, цвет)")
        return 0
    if name == "draw_text"
        builtin_args(c, n, "iitii", "draw_text(x, y, \"текст\", размер, цвет)")
        return 0
    if name == "key_down"
        builtin_args(c, n, "t", "key_down(\"left\")  — стрелки left right up down, space, enter, escape, буквы \"a\"")
        return 3
    if name == "rgb"
        builtin_args(c, n, "iii", "rgb(красный, зелёный, синий)  — каждый от 0 до 255")
        return 1
    if name == "random"
        builtin_args(c, n, "ii", "random(от, до)")
        return 1
    if name == "abs"
        builtin_args(c, n, "n", "abs(число)")
        return n.kids[0].ty
    if name == "sqrt"
        builtin_args(c, n, "n", "sqrt(число)")
        return 2
    // min и max
    builtin_args(c, n, "nn", "min(a, b)")
    if n.kids[0].ty == 1 and n.kids[1].ty == 1
        return 1
    return 2

// приводит аргументы к порядку параметров:  add(b: 3, a: 2)  →  add(2, 3)
// allow_missing: для создания obj можно пропустить качества (тогда там узел "missing")
func order_args(c: Comp, call: Node, params: Node, allow_missing: bool)
    np = len(params.kids)
    if len(call.kids) > np or (not allow_missing and len(call.kids) != np)
        error_at(c, call.line, "не то количество значений в вызове", call.name)
    ordered = list Node
    taken = list bool
    count j from 1 to np
        ordered.add(Node(kind: "missing"))
        taken.add(false)
    named = false
    count i from 0 to len(call.kids) - 1
        arg = call.kids[i]
        slot = i
        if arg.name != ""
            named = true
            slot = -1
            count j from 0 to np - 1
                if params.kids[j].name == arg.name
                    slot = j
            if slot < 0
                error_at(c, arg.line, "нет параметра с таким именем", arg.name)
        else if named
            error_at(c, arg.line, "после именованных аргументов обычные писать нельзя", "")
        if taken[slot]
            error_at(c, arg.line, "параметр указан два раза", params.kids[slot].name)
        ordered[slot] = arg
        taken[slot] = true
    // теперь kids[i] — значение для параметра i, или "missing", если пропущено
    call.kids = ordered

// то, на что можно повесить ярлык или что можно менять: x, u.age, nums[2], d[k]
func need_place_for(c: Comp, n: Node, why: text, for_link: bool)
    if n.kind == "index" and is_dict(c, n.kids[0].ty)
        if for_link
            error_at(c, n.line, "ярлык на значение в dict нельзя: dict может переложить значения", "")
        return
    if n.kind == "name"
        v = find_var(c, n.name)
        if v >= 0 and c.vars[v].is_const
            error_at(c, n.line, "это const или переменная цикла, её нельзя менять", n.name)
        return
    if n.kind == "field"
        return
    if n.kind == "index" and is_list(c, n.kids[0].ty) and c.types[n.kids[0].ty].elem == 3 and for_link
        error_at(c, n.line, "ярлык на элемент list bool нельзя: там каждый элемент — один бит, у бита нет своего адреса", "")
    if n.kind == "index" and is_cols_list(c, n.kids[0].ty) and for_link
        error_at(c, n.line, "ярлык на элемент списка колонок нельзя: возьми ярлык на качество, например pts[i].x", "")
    if n.kind == "index" and is_list(c, n.kids[0].ty)
        return
    if n.kind == "index"
        error_at(c, n.line, "буквы в тексте менять нельзя, собери новый текст", "")
    error_at(c, n.line, why, "")

func need_place(c: Comp, n: Node, why: text)
    need_place_for(c, n, why, false)

func check_new_obj(c: Comp, n: Node, o: Node) gives r: int
    order_args(c, n, o, true)
    count i from 0 to len(n.kids) - 1
        if n.kids[i].kind == "missing"
            skip
        value = n.kids[i].kids[0]
        t = check_value(c, value)
        note_escape(c, value)
        if not fits(o.kids[i].ty, t)
            error_at(c, value.line, "качество другого типа", o.kids[i].name)
        n.kids[i].ty = o.kids[i].ty
    n.ref = o
    n.has_ref = true
    return obj_type(c, o)

func check_call(c: Comp, n: Node) gives r: int
    if is_builtin(n.name)
        if builtin_can_fail(n.name) and not n.creates
            error_at(c, n.line, "это может закончиться ошибкой: напиши  try ...,  ... or запасное  или  ... else err", n.name)
        return check_builtin(c, n)
    if find_var(c, n.name) >= 0
        error_at(c, n.line, "это переменная, а не функция", n.name)
    o = find_obj(c, n.name)
    if o >= 0
        return check_new_obj(c, n, c.objs[o])
    f = find_func(c, n.name)
    if f < 0
        explain_missing_func(c, n)
    return check_user_call(c, n, f)

// вызов функции программиста (f уже найдена: по имени или как money.total)
func check_user_call(c: Comp, n: Node, fi: int) gives r: int
    f = c.funcs[fi]
    if n.name == "main"
        error_at(c, n.line, "main запускается сама, её нельзя вызывать", "")
    if f.node.can_fail and not n.creates
        error_at(c, n.line, "функция может закончиться ошибкой: напиши  try f(),  f() or запасное  или  f() else err", n.name)
    n.ref = f.node
    n.has_ref = true
    params = f.node.kids[0]
    order_args(c, n, params, false)
    count i from 0 to len(n.kids) - 1
        p = params.kids[i]
        value = n.kids[i].kids[0]
        t = check_value(c, value)
        if p.is_link
            need_place_for(c, value, "в ярлык link можно передать только переменную, u.age или nums[i]", true)
            if value.kind == "index"
                lr = origin(c, root_var(c, value))
                count j from 0 to len(n.kids) - 1
                    if j != i and lr >= 0 and src_of(c, n.kids[j].kids[0]) == lr
                        error_at(c, value.line, "в функцию отдают ярлык на элемент списка и сам список: если функция вырастит список, ярлык поведёт в пустоту", n.name)
            no_outside_change(c, value)
            if outside_temp(c, root_var(c, value)) and not is_plain(c, t)
                temp_keep_out(c, value.line, p.name)
            if p.ty < 0
                // тип ярлыка узнаём по первому вызову
                p.ty = t
            else if p.ty != t
                error_at(c, value.line, "этот ярлык уже был другого типа", type_name(c, p.ty))
        else if not fits(p.ty, t)
            error_at(c, value.line, "параметр ждёт другой тип", p.name)
        else if is_ref(c, t)
            s = src_of(c, value)
            if s >= 0
                key = "f" + fi + "#" + i
                if c.vars[s].pno > 0 and c.current >= 0
                    c.e_from.add("f" + c.current + "#" + (c.vars[s].pno - 1))
                    c.e_to.add(key)
                la = link_alive(c, s)
                if la >= 0
                    c.lr_keys.add(key)
                    c.lr_lines.add(value.line)
                    c.lr_names.add(c.vars[la].name)
                    c.lr_files.add(c.file_name)
                if outside_par(c, s)
                    c.pc_keys.add(key)
                    c.pc_lines.add(value.line)
                    c.pc_names.add(n.name)
                    c.pc_files.add(c.file_name)
        n.kids[i].ty = p.ty
    c.call_from.add(c.current)
    c.call_to.add(fi)
    c.call_par.add(c.par_base >= 0 or c.par_vec)
    if len(c.held) > 0
        c.lc_func.add(fi)
        c.lc_held.add("," + join(c.held, ",") + ",")
        c.lc_line.add(n.line)
        c.lc_file.add(c.file_name)
        c.lc_name.add(n.name)
    c.call_loop.add(c.loop_depth > 0)
    if f.state == 0
        // проверяем вызванную функцию сейчас, чтобы узнать, что она возвращает
        saved_current = c.current
        saved_loops = c.loop_depth
        saved_vars = len(c.vars)
        saved_depth = c.depth
        saved_base = c.var_base
        saved_mod = c.cur_mod
        saved_file = c.file_name
        saved_par = c.par_base
        saved_temp = c.temp_base
        saved_temp_loops = c.temp_loops
        saved_pieces = c.piece_depth
        saved_danger = c.danger_depth
        saved_lock = c.lock_depth
        saved_lock_loops = c.lock_loops
        saved_loop_stack = c.loops
        fresh_loops = list Node
        c.loops = fresh_loops
        saved_held = c.held
        fresh_held = list text
        c.held = fresh_held
        saved_lkd = c.lk_depths
        fresh_lkd = list int
        c.lk_depths = fresh_lkd
        saved_lkf = c.lk_freed
        fresh_lkf = list bool
        c.lk_freed = fresh_lkf
        saved_busy = c.each_busy
        fresh_busy = list int
        c.each_busy = fresh_busy
        c.par_base = -1
        c.temp_base = -1
        c.piece_depth = 0
        c.danger_depth = 0
        c.lock_depth = 0
        c.var_base = len(c.vars)
        check_func(c, fi)
        c.danger_depth = saved_danger
        c.lock_depth = saved_lock
        c.lock_loops = saved_lock_loops
        c.piece_depth = saved_pieces
        c.loops = saved_loop_stack
        c.held = saved_held
        c.lk_depths = saved_lkd
        c.lk_freed = saved_lkf
        c.each_busy = saved_busy
        c.par_base = saved_par
        c.temp_base = saved_temp
        c.temp_loops = saved_temp_loops
        c.var_base = saved_base
        c.cur_mod = saved_mod
        c.file_name = saved_file
        c.current = saved_current
        c.loop_depth = saved_loops
        cut_vars(c, saved_vars)
        c.depth = saved_depth
    if f.node.ty < 0
        error_at(c, n.line, "функция вызывает сама себя раньше первого return со значением: поставь простой return выше", n.name)
    // функция хранит полученный список: он теперь виден не только у своей переменной
    count i from 0 to len(n.kids) - 1
        value = n.kids[i].kids[0]
        if is_ref(c, value.ty) and text_in(c.keep_keys, "f" + fi + "#" + i)
            note_escape(c, value)
    c.last_call = fi
    return f.node.ty

// money.total(...)  —  вызов функции из модуля по имени модуля
func check_module_call(c: Comp, n: Node) gives r: int
    mod = n.kids[0].name
    if not module_uses(c, c.cur_mod, mod)
        error_at(c, n.line, "этот модуль не подключён: добавь в начало файла  use", mod)
    f = find_func_in(c, n.name, mod)
    if f < 0
        error_at(c, n.line, "в этом модуле нет такой функции", n.name)
    if not c.funcs[f].node.is_pub and mod != c.cur_mod
        error_at(c, n.line, "эта функция спрятана в своём модуле: поставь перед ней modpub", n.name)
    // превращаем в обычный вызов: аргументы — kids после модуля
    n.kind = "call"
    rest = list Node
    count i from 1 to len(n.kids) - 1
        rest.add(n.kids[i])
    n.kids = rest
    return check_user_call(c, n, f)

// канал: ch.send(x), ch.receive(), ch.close()
func check_chan_method(c: Comp, n: Node, t: int) gives r: int
    args = len(n.kids) - 1
    elem = c.types[t].elem
    if n.name == "send"
        if args != 1
            error_at(c, n.line, ".send кладёт ровно одно значение", "")
        v = check_value(c, n.kids[1].kids[0])
        if not fits(elem, v)
            error_at(c, n.line, "по этому каналу идёт другой тип", type_name(c, elem))
        n.kids[1].ty = elem
        return 0
    if n.name == "receive" or n.name == "close"
        if args != 0
            error_at(c, n.line, "пишется без значений", n.name)
        if n.name == "receive"
            if c.lock_depth > 0
                error_at(c, n.line, "внутри lock receive() нельзя: пока ждёшь, замок держат все остальные", "")
            return elem
        return 0
    error_at(c, n.line, "у канала есть .send(x), .receive() и .close()", n.name)
    return -1

func check_dict_method(c: Comp, n: Node, t: int) gives r: int
    args = len(n.kids) - 1
    d = c.types[t]
    if n.name == "has" or n.name == "remove"
        if args != 1
            error_at(c, n.line, "нужен ровно один ключ", n.name)
        k = check_value(c, n.kids[1].kids[0])
        if k != d.key
            error_at(c, n.line, "ключ у этого dict другого типа", type_name(c, d.key))
        n.kids[1].ty = d.key
        if n.name == "has"
            return 3
        return 0
    if n.name == "keys" or n.name == "values"
        if args != 0
            error_at(c, n.line, "пишется без значений", n.name)
        if n.name == "keys"
            return list_of(c, d.key)
        return list_of(c, d.elem)
    error_at(c, n.line, "у dict нет такого метода (есть .has .remove .keys .values .clear)", n.name)
    return -1

func check_method(c: Comp, n: Node) gives r: int
    base = n.kids[0]
    if base.kind == "name" and find_var(c, base.name) < 0 and is_module(c, base.name)
        return check_module_call(c, n)
    t = check_value(c, base)
    args = len(n.kids) - 1
    count i from 1 to len(n.kids) - 1
        if n.kids[i].name != ""
            error_at(c, n.line, "у методов аргументы пишутся без имён", "")
    if n.name == "add" or n.name == "pop" or n.name == "remove" or n.name == "clear"
        no_outside_change(c, base)
        no_resize(c, base, n.line, n.name == "remove" or n.name == "clear")
    if n.name == "clear"
        // .clear(): список или dict снова пустой, их собственная память отдаётся
        if not is_list(c, t) and not is_dict(c, t)
            error_at(c, n.line, ".clear() есть у списков и dict", "")
        if is_list(c, t) and is_cols_obj(c, c.types[t].elem)
            error_at(c, n.line, "у списка колонок (by columns) .clear() пока нет", "")
        if args != 0
            error_at(c, n.line, ".clear() пишется без значений", "")
        return 0
    if is_dict(c, t)
        return check_dict_method(c, n, t)
    if kind_of(c, t) == "channel"
        return check_chan_method(c, n, t)
    if not is_list(c, t)
        error_at(c, n.line, "у этого значения нет методов: они есть у списков (.add .pop) и dict (.has .remove .keys .values)", n.name)
    elem = c.types[t].elem
    if n.name == "add"
        if args != 1
            error_at(c, n.line, ".add кладёт ровно одно значение", "")
        v = check_value(c, n.kids[1].kids[0])
        note_escape(c, n.kids[1].kids[0])
        if not fits(elem, v)
            error_at(c, n.line, "в этот список кладут другой тип", type_name(c, elem))
        n.kids[1].ty = elem
        return 0
    if n.name == "pop"
        if is_cols_obj(c, elem)
            error_at(c, n.line, "у списка колонок (by columns) .pop() пока нет", "")
        if args != 0
            error_at(c, n.line, ".pop() пишется без значений", "")
        return elem
    error_at(c, n.line, "у списка нет такого метода (есть .add и .pop)", n.name)
    return -1

func check_dict(c: Comp, n: Node) gives r: int
    if len(n.kids) == 0
        error_at(c, n.line, "пустой dict пишется с типом: d = dict text int", "")
    key = check_value(c, n.kids[0])
    value = check_value(c, n.kids[1])
    if key != 4 and key != 1
        error_at(c, n.line, "ключ у dict бывает text или int", "")
    i = 2
    repeat while i + 1 < len(n.kids)
        if check_value(c, n.kids[i]) != key
            error_at(c, n.kids[i].line, "все ключи одного типа", type_name(c, key))
        v = check_value(c, n.kids[i + 1])
        note_escape(c, n.kids[i + 1])
        if not fits(value, v)
            if value == 1 and v == 2
                value = 2
            else
                error_at(c, n.kids[i + 1].line, "все значения одного типа", type_name(c, value))
        i += 2
    return dict_of(c, key, value)

// вызов, который может закончиться ошибкой (для  f() or 0,  try f(),  f() else err)
func can_fail_call(c: Comp, n: Node)
    if n.kind == "call"
        if is_builtin(n.name)
            return builtin_can_fail(n.name)
        if find_var(c, n.name) >= 0 or find_obj(c, n.name) >= 0
            return false
        f = find_func(c, n.name)
        return f >= 0 and c.funcs[f].node.can_fail
    if n.kind == "method" and n.kids[0].kind == "name" and find_var(c, n.kids[0].name) < 0 and is_module(c, n.kids[0].name)
        f = find_func_in(c, n.name, n.kids[0].name)
        return f >= 0 and c.funcs[f].node.can_fail
    return false

// вызов, ошибку которого кто-то ловит (or / try / else err)
func check_handled(c: Comp, n: Node, how: text) gives r: int
    if not can_fail_call(c, n)
        error_at(c, n.line, "этот вызов не может закончиться ошибкой, здесь не нужно", how)
    n.creates = true
    return check_expr(c, n)

func check_expr(c: Comp, n: Node) gives r: int
    t = -1
    k = n.kind
    if k == "number"
        t = 1
    else if k == "decimal"
        t = 2
    else if k == "string"
        t = 4
    else if k == "bool"
        t = 3
    else if k == "name"
        v = find_var(c, n.name)
        if v < 0
            if find_func(c, n.name) >= 0
                error_at(c, n.line, "у функции нужны скобки", n.name)
            if find_obj(c, n.name) >= 0
                error_at(c, n.line, "чтобы создать obj, нужны скобки", n.name + "(...)")
            error_at(c, n.line, "нет такой переменной", n.name)
        if c.vars[v].moved
            error_at(c, n.line, "этот список уже отдан в background через move: им больше пользоваться нельзя (можно дать ему новое значение: xs = [1, 2])", n.name)
        if outside_temp(c, v) and not temp_can_see(c, c.vars[v].type)
            error_at(c, n.line, "внутри temp не видно списков, dict и obj снаружи (кроме списков чисел): создай данные внутри temp или передай числа", n.name)
        if outside_par(c, v)
            if c.vars[v].is_shared and not c.shared_ok
                error_at(c, n.line, "shared внутри on all cores можно только менять через += или -=, а читать — после цикла", n.name)
            if not (c.par_vec and c.shared_ok)
                capture(c, v)
        n.is_link = c.vars[v].is_link
        t = c.vars[v].type
    else if k == "list"
        t = check_list(c, n)
    else if k == "dict"
        t = check_dict(c, n)
    else if k == "try"
        if c.lock_depth > 0
            error_at(c, n.line, "внутри lock try нельзя: пиши  or  или  else err", "")
        if c.par_base >= 0
            error_at(c, n.line, "внутри " + loop_word(c) + " try нельзя: ядро не может остановить всю функцию, пиши  or  или  else err", "")
        if c.temp_base >= 0
            error_at(c, n.line, "внутри temp try нельзя: пиши  or  или  else err", "")
        if c.piece_depth > 0
            error_at(c, n.line, "внутри each ... by N try нельзя: пиши  or  или  else err", "")
        t = check_handled(c, n.kids[0], "try")
    else if k == "else_err"
        t = check_handled(c, n.kids[0], "else")
        open_scope(c)
        add_var(c, n.name, 4, true, false, n.line)
        check_block(c, n.kids[1])
        close_scope(c)
    else if k == "call"
        t = check_call(c, n)
    else if k == "method"
        t = check_method(c, n)
    else if k == "binop"
        t = check_binop(c, n)
    else if k == "unary"
        inner = check_value(c, n.kids[0])
        if n.value == "not"
            if inner != 3
                error_at(c, n.line, "not работает только с true и false", "")
            t = 3
        else
            if not is_number(inner)
                error_at(c, n.line, "минус ставится только перед числом", "")
            t = inner
    else if k == "index" and is_dict(c, check_value(c, n.kids[0]))
        base = c.types[n.kids[0].ty]
        if check_value(c, n.kids[1]) != base.key
            error_at(c, n.line, "ключ у этого dict другого типа", type_name(c, base.key))
        t = base.elem
    else if k == "index"
        base = check_value(c, n.kids[0])
        index = check_value(c, n.kids[1])
        if index != 1
            error_at(c, n.line, "номер в списке должен быть int", "")
        if base == 4
            t = 4
        else if is_list(c, base)
            t = c.types[base].elem
        else
            error_at(c, n.line, "[номер] берут у списка или текста", "")
    else if k == "field" and n.name == "wait" and kind_of(c, check_value(c, n.kids[0])) == "task"
        if c.par_base >= 0
            error_at(c, n.line, "внутри " + loop_word(c) + " .wait нельзя: забери готовое до цикла или после", "")
        t = c.types[n.kids[0].ty].elem
    else if k == "background"
        t = check_background(c, n)
    else if k == "field" and n.kids[0].kind == "name" and find_var(c, n.kids[0].name) < 0 and find_enum(c, n.kids[0].name) >= 0
        // Status.paid  —  вариант enum
        e = c.enums[find_enum(c, n.kids[0].name)]
        at = enum_index(e, n.name)
        if at < 0
            error_at(c, n.line, "в этом enum нет такого варианта", n.name)
        n.kind = "enumval"
        n.value = "" + at
        t = enum_type(c, e)
    else if k == "enumval"
        t = n.ty
    else if k == "field"
        base = check_value(c, n.kids[0])
        if kind_of(c, base) != "obj"
            error_at(c, n.line, "точка с качеством бывает только у obj", n.name)
        o = c.types[base].obj_node
        field = find_field(o, n.name)
        if field < 0
            error_at(c, n.line, "у этого obj нет такого качества", n.name)
        t = o.kids[field].ty
        c.acc_field.add(o.kids[field])
        c.acc_func.add(c.current)
        c.acc_loop.add(c.loop_depth > 0)
    n.ty = t
    if k == "index"
        note_prefetch(c, n)
    return t

// Заказ наперёд (как склад, который собирает детали по плану завода заранее):
// в  each x in idx  с  data[x]  или в  count i  с  data[idx[i]]  следующий адрес
// известен из плана idx, и цикл заранее просит память принести data[idx[i + 16]].
func note_prefetch(c: Comp, n: Node)
    if len(c.loops) == 0
        return
    loop = c.loops[len(c.loops) - 1]
    if loop.is_par or loop.by_vec or loop.by_piece
        return
    a = n.kids[0]
    if a.kind != "name" or not declared_before(c, a.name, loop.name)
        return
    if not ((is_list(c, a.ty) and not is_cols_list(c, a.ty)) or is_dict(c, a.ty))
        return
    i = n.kids[1]
    plan = Node(kind: "missing")
    if loop.kind == "each"
        if not is_name_of(i, loop.name) or not is_list(c, loop.kids[0].ty) and not is_dict(c, loop.kids[0].ty)
            return
    else
        if i.kind != "index" or not is_name_of(i.kids[1], loop.name)
            return
        plan = i.kids[0]
        if plan.kind != "name" or not declared_before(c, plan.name, loop.name) or not is_list(c, plan.ty) or is_cols_list(c, plan.ty)
            return
    count j from 0 to len(loop.pre_bases) - 1
        if loop.pre_bases[j].name == a.name and loop.pre_idx[j].name == plan.name
            return
    loop.pre_bases.add(a)
    loop.pre_idx.add(plan)

// переменная name заведена раньше переменной цикла loop_var (то есть видна в начале цикла)
func declared_before(c: Comp, name: text, loop_var: text)
    a = find_var(c, name)
    b = find_var(c, loop_var)
    return a >= 0 and b >= 0 and a < b

func need_bool(c: Comp, n: Node)
    if check_value(c, n) != 3
        error_at(c, n.line, "условие должно быть true или false (например a > 3)", "")

func need_int(c: Comp, n: Node, what: text)
    if check_value(c, n) != 1
        error_at(c, n.line, "здесь нужно целое число int", what)

// ---------- команды ----------

func check_assign(c: Comp, n: Node)
    declared = -1
    if n.has_tsyn
        declared = resolve_type(c, n.tsyn)
    t = -1
    if len(n.kids) == 1
        t = check_value(c, n.kids[0])
    v = find_var(c, n.name)
    if n.is_shared
        if v >= 0
            error_at(c, n.line, "shared пишется только у новой переменной", n.name)
        if declared != 1 and declared != 2 and declared != 4 and t != 1 and t != 2 and t != 4
            error_at(c, n.line, "shared бывает int, dec или text: shared y = int 0, shared out = \"\"", n.name)
    if v < 0
        type = t
        if declared >= 0
            if t >= 0 and not fits(declared, t)
                error_at(c, n.line, "значение не того типа, что написан", type_name(c, declared))
            type = declared
        n.creates = true
        n.ty = type
        add_var(c, n.name, type, n.is_const, false, n.line)
        c.vars[len(c.vars) - 1].is_shared = n.is_shared
        if t >= 0 and is_ref(c, type)
            set_src(c, len(c.vars) - 1, src_of(c, n.kids[0]), n.line)
        return
    if outside_temp(c, v) and not is_plain(c, c.vars[v].type)
        temp_keep_out(c, n.line, n.name)
    if outside_par(c, v)
        if c.par_vec
            error_at(c, n.line, "внутри by vec нельзя менять переменную снаружи: копи её через += или -=", n.name)
        if c.vars[v].is_shared
            error_at(c, n.line, "shared внутри on all cores меняется только через += или -=", n.name)
        error_at(c, n.line, "внутри " + loop_word(c) + " нельзя менять переменную снаружи: сделай её shared и меняй через += или -=", n.name)
    if n.is_const or declared >= 0
        error_at(c, n.line, "переменная уже есть: тип и const пишутся только в первый раз", n.name)
    note_global_write(c, v, n.line)
    if c.vars[v].is_const
        error_at(c, n.line, "это const или переменная цикла, её нельзя менять", n.name)
    if not fits(c.vars[v].type, t)
        error_at(c, n.line, "переменная другого типа", type_name(c, c.vars[v].type))
    n.is_link = c.vars[v].is_link
    c.vars[v].moved = false
    c.vars[v].escaped = false
    if is_ref(c, t)
        set_src(c, v, src_of(c, n.kids[0]), n.line)
    n.ty = c.vars[v].type

func check_set(c: Comp, n: Node)
    target = n.kids[0]
    op = n.value
    c.shared_ok = target.kind == "name" and (op == "+=" or op == "-=")
    to_ty = check_value(c, target)
    c.shared_ok = false
    need_place(c, target, "менять можно только переменную, u.age или nums[i]")
    r = root_var(c, target)
    if outside_temp(c, r) and target.kind == "name" and not is_plain(c, c.vars[r].type)
        temp_keep_out(c, n.line, target.name)
    if outside_par(c, r) and c.par_vec
        if target.kind != "name"
            error_at(c, n.line, "внутри by vec нельзя менять списки и obj снаружи цикла", "")
        var = c.vars[r]
        if (op != "+=" and op != "-=") or not is_number(var.type)
            error_at(c, n.line, "внутри by vec число снаружи можно только копить через += или -=", target.name)
        found = false
        each old in c.par_node.caps
            if old.name == var.name and old.is_shared
                found = true
                if old.op != op
                    error_at(c, n.line, "в by vec одну переменную копят одним знаком: или +=, или -=", target.name)
        if not found
            c.par_node.caps.add(Var(name: var.name, type: var.type, is_link: var.is_link, is_shared: true, op: op))
    else if outside_par(c, r)
        if target.kind != "name"
            error_at(c, n.line, "внутри " + loop_word(c) + " нельзя менять списки и obj снаружи цикла (свои, созданные внутри, — можно)", "")
        if not c.vars[r].is_shared
            error_at(c, n.line, "внутри " + loop_word(c) + " нельзя менять переменную снаружи: сделай её shared и меняй через += или -=", target.name)
        if op != "+=" and op != "-="
            error_at(c, n.line, "shared внутри on all cores меняется только через += или -=", target.name)
    if target.kind != "name"
        note_change(c, target)
    if target.kind == "index" and is_dict(c, target.kids[0].ty)
        no_resize(c, target.kids[0], n.line, false)
    note_global_write(c, r, n.line)
    if r >= 0 and r < c.n_globals and (c.par_base >= 0 or c.par_vec) and c.lock_depth == 0
        error_at(c, n.line, "общую shared-переменную внутри " + loop_word(c) + " меняют под замком: lock имя", target.name)
    t = check_value(c, n.kids[1])
    if target.kind != "name"
        note_escape(c, n.kids[1])
    n.ty = to_ty
    if op == "="
        if not fits(to_ty, t)
            error_at(c, n.line, "здесь лежит другой тип", type_name(c, to_ty))
        return
    if to_ty == 4 and op == "+="
        if not is_scalar(c, t)
            error_at(c, n.line, "к тексту можно приписать только текст, число или bool", "")
        return
    if not is_number(to_ty) or not is_number(t)
        error_at(c, n.line, "эта операция работает только с числами", op)
    if to_ty == 1 and t == 2
        error_at(c, n.line, "в int нельзя добавить дробь: сделай его dec", "")

func check_linkdecl(c: Comp, n: Node)
    target = n.kids[0]
    t = check_value(c, target)
    need_place_for(c, target, "ярлык link ведёт к переменной, u.age или nums[i]", true)
    no_outside_change(c, target)
    if outside_temp(c, root_var(c, target)) and not is_plain(c, t)
        temp_keep_out(c, n.line, n.name)
    n.ty = t
    add_var(c, n.name, t, false, true, n.line)
    if target.kind == "index"
        lr = origin(c, root_var(c, target))
        if lr >= 0
            c.vars[len(c.vars) - 1].link_root1 = lr + 1

func check_multi(c: Comp, n: Node)
    value = n.kids[len(n.kids) - 1]
    call = value
    if value.kind == "try" or value.kind == "else_err"
        call = value.kids[0]
    if call.kind != "call" and call.kind != "method"
        error_at(c, n.line, "справа должен быть вызов функции с gives", "")
    t = check_expr(c, value)
    names = len(n.kids) - 1
    if kind_of(c, t) != "multi"
        error_at(c, n.line, "у этой функции один выход, пиши  x = ...", call.name)
    outputs = c.types[t].func_node.kids[2]
    if len(outputs.kids) != names
        error_at(c, n.line, "у функции другое число выходов", call.name)
    count i from 0 to names - 1
        name = n.kids[i]
        out = outputs.kids[i].ty
        v = find_var(c, name.name)
        if v < 0
            name.creates = true
            add_var(c, name.name, out, false, false, name.line)
            if is_ref(c, out)
                set_src(c, len(c.vars) - 1, src_of(c, value), name.line)
        else
            if outside_par(c, v)
                error_at(c, name.line, "внутри " + loop_word(c) + " нельзя менять переменную снаружи: сделай её shared и меняй через += или -=", name.name)
            if outside_temp(c, v) and not is_plain(c, c.vars[v].type)
                temp_keep_out(c, name.line, name.name)
            note_global_write(c, v, name.line)
            if c.vars[v].is_const
                error_at(c, name.line, "это const или переменная цикла, её нельзя менять", name.name)
            if not fits(c.vars[v].type, out)
                error_at(c, name.line, "переменная другого типа", type_name(c, c.vars[v].type))
            name.is_link = c.vars[v].is_link
            if is_ref(c, out)
                set_src(c, v, src_of(c, value), name.line)
        name.ty = out

func check_return(c: Comp, n: Node)
    f = c.funcs[c.current].node
    if len(f.kids[2].kids) > 0
        if len(n.kids) != 0
            // один выход:  func f() gives r: int  ...  return 5  — можно сразу отдать значение
            if len(f.kids[2].kids) > 1
                error_at(c, n.line, "у функции с несколькими gives return пишется без значения: он отдаёт выходы", "")
            t = check_value(c, n.kids[0])
            if not fits(f.ty, t)
                error_at(c, n.line, "return отдаёт другой тип, чем написано в gives", type_name(c, f.ty))
        return
    t = 0
    if len(n.kids) == 1
        t = check_value(c, n.kids[0])
    if f.name == "main" and t != 0
        error_at(c, n.line, "main ничего не возвращает: пиши просто return", "")
    if f.ty < 0
        f.ty = t
    else if f.ty == 1 and t == 2
        error_at(c, n.line, "раньше функция вернула int, а тут dec: сделай оба числа одного типа", "")
    else if not fits(f.ty, t)
        error_at(c, n.line, "раньше эта функция вернула другой тип", type_name(c, f.ty))

// match: варианты enum (все, или есть else), числа или текст
func check_match(c: Comp, n: Node)
    t = check_value(c, n.kids[0])
    en = is_enum(c, t)
    if not en and t != 1 and t != 4
        error_at(c, n.line, "match разбирает enum, int или text", type_name(c, t))
    seen = list text
    has_else = false
    count i from 1 to len(n.kids) - 1
        cs = n.kids[i]
        if has_else
            error_at(c, cs.line, "else пишется последним вариантом match", "")
        if cs.name == "else"
            has_else = true
        each v in cs.kids[0].kids
            key = ""
            if en
                e = c.types[t].obj_node
                if v.kind == "name"
                    at = enum_index(e, v.name)
                    if at < 0
                        error_at(c, v.line, "в " + e.name + " нет такого варианта", v.name)
                    v.kind = "enumval"
                    v.value = "" + at
                    v.ty = t
                else if check_value(c, v) != t
                    error_at(c, v.line, "здесь нужен вариант " + e.name, "")
                key = v.value
            else
                if v.kind != "number" and v.kind != "string" and not (v.kind == "unary" and v.kids[0].kind == "number")
                    error_at(c, v.line, "в match варианты пишутся числом или текстом в кавычках", "")
                if check_value(c, v) != t
                    error_at(c, v.line, "вариант другого типа", type_name(c, t))
                key = v.value
                if v.kind == "unary"
                    key = "-" + v.kids[0].value
            if text_in(seen, key)
                error_at(c, v.line, "этот вариант уже разобран выше", "")
            seen.add(key)
        check_block(c, cs.kids[1])
    if en and not has_else
        e = c.types[t].obj_node
        missing = list text
        count j from 0 to len(e.kids) - 1
            if not text_in(seen, "" + j)
                missing.add(e.kids[j].name)
        if len(missing) > 0
            error_at(c, n.line, "match разбирает не все варианты " + e.name + " (или добавь else), нет", join(missing, ", "))

func check_statement(c: Comp, n: Node)
    k = n.kind
    if k == "match"
        check_match(c, n)
    else if k == "assign"
        check_assign(c, n)
    else if k == "set"
        check_set(c, n)
    else if k == "linkdecl"
        check_linkdecl(c, n)
    else if k == "multi"
        check_multi(c, n)
    else if k == "if"
        i = 0
        repeat while i + 1 < len(n.kids)
            need_bool(c, n.kids[i])
            check_block(c, n.kids[i + 1])
            i += 2
        if len(n.kids) % 2 == 1
            check_block(c, n.kids[len(n.kids) - 1])
    else if k == "each"
        t = check_value(c, n.kids[0])
        elem = 4
        if is_list(c, t)
            elem = c.types[t].elem
        else if is_dict(c, t)
            elem = c.types[t].key
        else if kind_of(c, t) == "channel"
            elem = c.types[t].elem
            if n.is_par or n.by_vec or n.by_piece
                error_at(c, n.line, "по каналу each идёт просто: each x in ch (без on all cores, by vec и by N)", "")
            if c.lock_depth > 0
                error_at(c, n.line, "внутри lock each по каналу нельзя: пока ждёшь, замок держат все остальные", "")
        else if t != 4
            error_at(c, n.line, "each ходит по списку, по ключам dict, по каналу или по буквам текста", "")
        if n.is_par and not is_list(c, t)
            error_at(c, n.line, "on all cores ходит по списку (или count from ... to ...)", "")
        if n.by_vec and not (is_list(c, t) and is_number(c.types[t].elem))
            error_at(c, n.line, "by vec ходит по списку чисел: list int или list dec", "")
        if n.by_piece
            check_pieces(c, n, t)
        else
            open_scope(c)
            add_var(c, n.name, elem, true, false, n.line)
            if is_ref(c, elem) and not n.is_par
                set_src(c, len(c.vars) - 1, src_of(c, n.kids[0]), n.line)
            busy = is_dict(c, t)
            if busy
                c.each_busy.add(origin(c, root_var(c, n.kids[0])))
            c.loops.add(n)
            check_loop_body(c, n, n.kids[1])
            if busy
                gone_busy = c.each_busy.pop()
            gone = c.loops.pop()
            close_scope(c)
    else if k == "count"
        need_int(c, n.kids[0], "from")
        need_int(c, n.kids[1], "to")
        open_scope(c)
        add_var(c, n.name, 1, true, false, n.line)
        c.loops.add(n)
        check_loop_body(c, n, n.kids[2])
        gone = c.loops.pop()
        close_scope(c)
    else if k == "repeat_times" or k == "repeat_while"
        if k == "repeat_times"
            need_int(c, n.kids[0], "times")
        else
            need_bool(c, n.kids[0])
        c.loop_depth += 1
        check_block(c, n.kids[1])
        c.loop_depth -= 1
    else if k == "together"
        check_together(c, n)
    else if k == "temp"
        saved_base = c.temp_base
        saved_loops = c.temp_loops
        c.temp_base = len(c.vars)
        c.temp_loops = c.loop_depth
        check_block(c, n.kids[0])
        c.temp_base = saved_base
        c.temp_loops = saved_loops
    else if k == "danger"
        c.danger_depth += 1
        check_block(c, n.kids[0])
        c.danger_depth -= 1
    else if k == "lock"
        if text_in(c.held, n.name)
            error_at(c, n.line, "этот замок уже взят выше: второй lock с тем же именем ждал бы сам себя вечно", n.name)
        if c.current >= 0
            c.lk_func.add(c.current)
            c.lk_name.add(n.name)
        each h in c.held
            if h != ""
                c.lo_edge.add(h + ">" + n.name)
                c.lo_line.add(n.line)
                c.lo_file.add(c.file_name)
        c.held.add(n.name)
        c.lk_depths.add(c.depth + 1)
        c.lk_freed.add(false)
        saved_lock_loops = c.lock_loops
        c.lock_loops = c.loop_depth
        c.lock_depth += 1
        check_block(c, n.kids[0])
        freed = c.lk_freed.pop()
        if not freed
            c.lock_depth -= 1
        gone_depth = c.lk_depths.pop()
        gone_lock = c.held.pop()
        c.lock_loops = saved_lock_loops
    else if k == "unlock"
        last = len(c.held) - 1
        if last < 0 or text_in(c.held, n.name) == false
            error_at(c, n.line, "unlock пишется внутри своего блока  lock имя", n.name)
        if c.held[last] != n.name
            error_at(c, n.line, "сначала отпускают внутренний замок: unlock " + c.held[last], n.name)
        if c.lk_freed[last]
            error_at(c, n.line, "этот замок уже отпущен выше", n.name)
        if c.depth != c.lk_depths[last]
            error_at(c, n.line, "unlock пишется прямо в блоке lock, не внутри if и циклов: так всегда ясно, взят замок или нет", n.name)
        c.lk_freed[last] = true
        c.held[last] = ""
        c.lock_depth -= 1
    else if k == "skip" or k == "stop"
        if c.lock_depth > 0 and c.loop_depth == c.lock_loops
            error_at(c, n.line, "skip и stop внутри lock работают только для циклов внутри lock: иначе замок останется закрытым", "")
        if c.loop_depth == 0
            error_at(c, n.line, "skip и stop пишутся только внутри цикла", "")
        if k == "stop" and c.par_base >= 0 and c.loop_depth == c.par_node.temp_no
            error_at(c, n.line, "stop внутри on all cores нельзя: остальные ядра всё равно работают", "")
        if c.temp_base >= 0 and c.loop_depth == c.temp_loops
            error_at(c, n.line, "skip и stop внутри temp работают только для циклов внутри temp", "")
    else if k == "return"
        if c.lock_depth > 0
            error_at(c, n.line, "внутри lock return нельзя: замок останется закрытым; сохрани число снаружи и выйди из блока", "")
        if c.par_base >= 0
            error_at(c, n.line, "внутри " + loop_word(c) + " return нельзя", "")
        if c.temp_base >= 0
            error_at(c, n.line, "внутри temp return нельзя: сохрани число в переменную снаружи и выйди из блока", "")
        if c.piece_depth > 0
            error_at(c, n.line, "внутри each ... by N return нельзя: сохрани число в переменную снаружи и выйди через stop", "")
        check_return(c, n)
    else if k == "fail"
        if c.lock_depth > 0
            error_at(c, n.line, "внутри lock fail нельзя: замок останется закрытым", "")
        if c.par_base >= 0
            error_at(c, n.line, "внутри " + loop_word(c) + " fail нельзя: пиши  or  или  else err", "")
        if c.temp_base >= 0
            error_at(c, n.line, "внутри temp fail нельзя: пиши  or  или  else err", "")
        if c.piece_depth > 0
            error_at(c, n.line, "внутри each ... by N fail нельзя: пиши  or  или  else err", "")
        if check_value(c, n.kids[0]) != 4
            error_at(c, n.line, "после fail пишется текст ошибки: fail \"нет файла\"", "")
    else if k == "expr_stmt"
        e = n.kids[0]
        inner = e
        if e.kind == "try" or e.kind == "else_err"
            inner = e.kids[0]
        if inner.kind != "call" and inner.kind != "method" and not (inner.kind == "field" and inner.name == "wait")
            error_at(c, n.line, "строка ничего не делает", "")
        t = check_expr(c, e)
        if t != 0
            error_at(c, n.line, "результат вызова пропадает: сохрани его, например x = ...", e.name)

// a = background f(x): f работает в своём потоке.
// Чтобы потоки не мешали друг другу, f получает только числа, bool и текст (их никто не меняет)
// и отдаёт одно значение или ничего.
func check_background(c: Comp, n: Node) gives r: int
    if c.par_base >= 0
        error_at(c, n.line, "внутри " + loop_word(c) + " background нельзя: цикл и так идёт на всех ядрах", "")
    if c.temp_base >= 0
        error_at(c, n.line, "внутри temp background нельзя: память блока удалится, пока функция ещё работает", "")
    call = n.kids[0]
    if call.kind == "call" and is_builtin(call.name)
        error_at(c, n.line, "background запускает свою функцию: a = background load(name)", call.name)
    call.creates = true
    c.last_call = -1
    t = check_expr(c, call)
    if c.last_call >= 0
        c.bg_funcs.add(c.last_call)
    if call.kind != "call" or not call.has_ref or call.ref.kind != "func"
        error_at(c, n.line, "background запускает свою функцию: a = background load(name)", "")
    f = call.ref
    if f.can_fail
        error_at(c, n.line, "функция с fail в background пока нельзя: пусть она отдаёт текст ошибки обычным выходом", f.name)
    if len(f.kids[2].kids) > 1
        error_at(c, n.line, "в background функция с несколькими выходами пока нельзя", f.name)
    count pi from 0 to len(f.kids[0].kids) - 1
        p = f.kids[0].kids[pi]
        arg = call.kids[pi]
        if arg.moved
            check_move(c, arg.kids[0], p)
        else if p.is_link or not (is_plain(c, p.ty) or p.ty == 4 or kind_of(c, p.ty) == "channel")
            error_at(c, n.line, "в background функция получает только int, dec, bool, text и channel (а список — через move: f(move xs)): списки и obj могли бы меняться сразу из двух мест", p.name)
    if t < 0
        t = 0
    return task_of(c, t)

// together: только новые переменные, и ни одна строка не читает то, что дала строка выше.
// Переменные видны и после блока.
func check_together(c: Comp, n: Node)
    block = n.kids[0]
    names = list text
    each s in block.kids
        if s.kind != "assign" or len(s.kids) != 1
            error_at(c, s.line, "в together пишутся только новые переменные со значением: a = d[key]", "")
        if find_var(c, s.name) >= 0
            error_at(c, s.line, "в together заводятся только новые переменные, а эта уже есть", s.name)
        each w in names
            if w == s.name
                error_at(c, s.line, "в together эта переменная уже заведена строкой выше", s.name)
            if uses_name(s.kids[0], w)
                error_at(c, s.line, "строки в together не должны зависеть друг от друга, а здесь нужна", w)
        names.add(s.name)
        check_statement(c, s)

// встречается ли имя name где-то в выражении n
func uses_name(n: Node, name: text)
    if n.kind == "name" and n.name == name
        return true
    each k in n.kids
        if uses_name(k, name)
            return true
    return false

// each piece in data by 64: piece — кусок списка data (не копия, а окно в него).
// Пока цикл идёт, data нельзя растить: так кусок всегда смотрит в живую память.
func check_pieces(c: Comp, n: Node, t: int)
    if not is_list(c, t)
        error_at(c, n.line, "by N режет на куски список: each piece in nums by 64", "")
    if is_cols_obj(c, c.types[t].elem)
        error_at(c, n.line, "список колонок (by columns) на куски пока не режется", "")
    if c.types[t].elem == 3
        error_at(c, n.line, "list bool хранится битами и на куски пока не режется", "")
    if c.par_base >= 0
        error_at(c, n.line, "each ... by N внутри " + loop_word(c) + " пока нельзя", "")
    need_int(c, n.piece_size, "by")
    n.file = c.file_name
    c.pieces.add(n)
    open_scope(c)
    add_var(c, n.name, t, true, false, n.line)
    c.piece_depth += 1
    c.loops.add(n)
    check_loop_body(c, n, n.kids[1])
    gone = c.loops.pop()
    c.piece_depth -= 1
    close_scope(c)

// v — это просто имя name?
func is_name_of(v: Node, name: text)
    return v.kind == "name" and v.name == name

// где кусок name вылезает наружу; 0 — нигде, иначе номер строки.
// Можно: name[i] (читать и менять), each x in name, встроенные функции (print, len, sort ...)
// и функции программиста, которые сами его не сохраняют.
func piece_leak(c: Comp, n: Node, name: text) gives r: int
    k = n.kind
    if k == "name" and n.name == name
        return n.line
    if (k == "assign" or k == "linkdecl") and n.name == name
        return n.line
    if k == "call" and n.has_ref and n.ref.kind == "func"
        count i from 0 to len(n.kids) - 1
            v = n.kids[i].kids[0]
            if is_name_of(v, name)
                if not param_keeps_piece(c, n.ref, i)
                    skip
                return v.line
            bad = piece_leak(c, v, name)
            if bad != 0
                return bad
        return 0
    if k == "call" and is_builtin(n.name)
        each a in n.kids
            v = a
            if a.kind == "arg"
                v = a.kids[0]
            if not is_name_of(v, name)
                bad = piece_leak(c, v, name)
                if bad != 0
                    return bad
        return 0
    start = 0
    if (k == "index" or k == "each") and len(n.kids) > 0 and is_name_of(n.kids[0], name)
        start = 1
    if k == "each" and n.by_piece
        bad = piece_leak(c, n.piece_size, name)
        if bad != 0
            return bad
    count i from start to len(n.kids) - 1
        bad = piece_leak(c, n.kids[i], name)
        if bad != 0
            return bad
    return 0

// сохраняет ли функция f свой параметр номер i (true — сохраняет, кусок туда нельзя)
func param_keeps_piece(c: Comp, f: Node, i: int)
    key = f.name + "@" + f.mod + "#" + i
    count j from 0 to len(c.safe_keys) - 1
        if c.safe_keys[j] == key
            return c.safe_vals[j] == 2
    // пока функция смотрится, считаем, что можно (для рекурсии)
    c.safe_keys.add(key)
    c.safe_vals.add(1)
    slot = len(c.safe_keys) - 1
    c.safe_busy += 1
    bad = piece_leak(c, f.kids[1], f.kids[0].kids[i].name)
    c.safe_busy -= 1
    if bad != 0
        c.safe_vals[slot] = 2
        return true
    if c.safe_busy > 0
        // ответ зависел от догадки про другую функцию — не запоминаем его
        c.safe_vals[slot] = 3
        c.safe_keys[slot] = ""
    return false

// Горячие и холодные качества (как склад: ходовое — у входа, редкое — в архиве).
// Горячее — то, что читают в цикле или в функции, которую зовут из цикла (и дальше по цепочке).
// Если у obj есть и горячие, и холодные качества (холодных хотя бы на 16 байт),
// холодные кладутся в отдельный кусок памяти, а сам obj становится маленьким:
// в кэш помещается больше объектов, и цикл по горячим качествам идёт быстрее.
func mark_hot_fields(c: Comp)
    hot_func = list bool
    count i from 1 to len(c.funcs)
        hot_func.add(false)
    count j from 0 to len(c.call_to) - 1
        if c.call_loop[j]
            hot_func[c.call_to[j]] = true
    changed = true
    repeat while changed
        changed = false
        count j from 0 to len(c.call_to) - 1
            if c.call_from[j] >= 0 and hot_func[c.call_from[j]] and not hot_func[c.call_to[j]]
                hot_func[c.call_to[j]] = true
                changed = true
    count j from 0 to len(c.acc_field) - 1
        if c.acc_loop[j] or (c.acc_func[j] >= 0 and hot_func[c.acc_func[j]])
            c.acc_field[j].hot = true
    each o in c.objs
        if o.by_cols
            skip
        hot = 0
        cold_bytes = 0
        each f in o.kids
            if f.hot
                hot += 1
            else if f.ty == 3
                cold_bytes += 1
            else
                cold_bytes += 8
        if hot > 0 and cold_bytes >= 16
            each f in o.kids
                f.is_cold = not f.hot

// после всей проверки: кусок не должен пережить свой цикл
func check_piece_leaks(c: Comp)
    each n in c.pieces
        bad = piece_leak(c, n.kids[1], n.name)
        if bad != 0
            c.file_name = n.file
            error_at(c, bad, "кусок живёт только внутри своего цикла: его можно читать и менять по номеру, ходить по нему each и передавать в функцию, но нельзя сохранять, растить .add и уменьшать .pop", n.name)

// тело each / count; у on all cores своя граница переменных:
// всё, что объявлено раньше, — снаружи и только для чтения (кроме shared)
func check_loop_body(c: Comp, n: Node, body: Node)
    c.loop_depth += 1
    if n.is_par or n.by_vec
        if c.par_base >= 0
            error_at(c, n.line, "on all cores и by vec внутри другого on all cores или by vec нельзя", "")
        c.par_base = len(c.vars) - 1
        c.par_node = n
        c.par_vec = n.by_vec
        // на какой глубине циклов стоит сам цикл: stop в нём нельзя, во вложенных — можно
        n.temp_no = c.loop_depth
        check_block(c, body)
        c.par_base = -1
        c.par_vec = false
        if n.by_vec
            // то, что копится, нельзя читать внутри: порядок сложения в by vec другой
            each a in n.caps
                each b in n.caps
                    if a.name == b.name and a.is_shared and not b.is_shared
                        error_at(c, n.line, "в by vec переменную, которую копишь через += или -=, нельзя читать внутри цикла", a.name)
    else
        check_block(c, body)
    c.loop_depth -= 1

func check_block(c: Comp, block: Node)
    open_scope(c)
    each s in block.kids
        check_statement(c, s)
    close_scope(c)

func check_func(c: Comp, fi: int)
    f = c.funcs[fi]
    c.current = fi
    c.cur_mod = f.mod
    c.file_name = f.node.file
    f.state = 1
    c.loop_depth = 0
    open_scope(c)
    params = f.node.kids[0]
    outputs = f.node.kids[2]
    count pi from 0 to len(params.kids) - 1
        p = params.kids[pi]
        add_var(c, p.name, p.ty, false, p.is_link, p.line)
        c.vars[len(c.vars) - 1].pno = pi + 1
    each o in outputs.kids
        same_param = find_var(c, o.name)
        if same_param >= 0
            // выход с именем параметра: это та же переменная
            if c.vars[same_param].type != o.ty
                error_at(c, o.line, "выход и параметр с одним именем должны быть одного типа", o.name)
            // для вывода C: отдельно не объявлять
            o.is_const = true
        else
            add_var(c, o.name, o.ty, false, false, o.line)
    check_block(c, f.node.kids[1])
    close_scope(c)
    if f.node.ty < 0
        f.node.ty = 0
    f.state = 2

func register_enum(c: Comp, e: Node)
    if find_obj(c, e.name) >= 0 or find_enum(c, e.name) >= 0 or is_builtin(e.name)
        error_at(c, e.line, "это имя уже занято", e.name)
    if len(e.kids) == 0
        error_at(c, e.line, "у enum должен быть хотя бы один вариант", e.name)
    count i from 0 to len(e.kids) - 1
        count j from 0 to i - 1
            if e.kids[j].name == e.kids[i].name
                error_at(c, e.kids[i].line, "такой вариант уже есть", e.kids[i].name)
    c.enums.add(e)

func register_obj(c: Comp, o: Node)
    if find_obj(c, o.name) >= 0 or is_builtin(o.name)
        error_at(c, o.line, "это имя уже занято", o.name)
    if len(c.objs) == 500
        error_at(c, o.line, "слишком много obj", "")
    c.objs.add(o)

func register_func(c: Comp, fn: Node)
    if find_func_in(c, fn.name, fn.mod) >= 0 or find_obj(c, fn.name) >= 0 or is_builtin(fn.name)
        error_at(c, fn.line, "это имя уже занято", fn.name)
    if len(c.funcs) == 1000
        error_at(c, fn.line, "слишком много функций", "")
    c.funcs.add(Func(name: fn.name, mod: fn.mod, node: fn, state: 0))

// есть ли внутри fail или try: тогда функция может закончиться ошибкой
func has_fail(n: Node) gives r: bool
    if n.kind == "fail" or n.kind == "try"
        return true
    each k in n.kids
        if has_fail(k)
            return true
    return false

// есть ли внутри return со значением; если нет — функция ничего не возвращает
func has_value_return(n: Node) gives r: bool
    if n.kind == "return" and len(n.kids) > 0
        return true
    each k in n.kids
        if has_value_return(k)
            return true
    return false

func links_known(fn: Node)
    each p in fn.kids[0].kids
        if p.ty < 0
            return false
    return true

func resolve_params(c: Comp, params: Node)
    count i from 0 to len(params.kids) - 1
        p = params.kids[i]
        count j from 0 to i - 1
            if params.kids[j].name == p.name
                error_at(c, p.line, "это имя уже есть в списке", p.name)
        if p.has_tsyn
            p.ty = resolve_type(c, p.tsyn)

// shared ticks = int 0  снаружи функций
func check_global(c: Comp, g: Node)
    if len(g.kids) != 1
        error_at(c, g.line, "общей переменной сразу дают значение: shared ticks = int 0", g.name)
    v = g.kids[0]
    if v.kind == "unary" and len(v.kids) == 1
        v = v.kids[0]
    if v.kind != "number" and v.kind != "decimal" and v.kind != "bool"
        error_at(c, g.line, "shared снаружи функций начинается с числа или true/false: shared ticks = int 0", g.name)
    t = check_value(c, g.kids[0])
    if g.has_tsyn
        want = resolve_type(c, g.tsyn)
        if not fits(want, t)
            error_at(c, g.line, "значение другого типа", type_name(c, want))
        t = want
    if not is_plain(c, t)
        error_at(c, g.line, "shared снаружи функций пока бывает только int, dec или bool", g.name)
    count i from 0 to len(c.vars) - 1
        if c.vars[i].name == g.name
            error_at(c, g.line, "такая общая переменная уже есть", g.name)
    if find_func(c, g.name) >= 0 or find_obj(c, g.name) >= 0 or is_builtin(g.name)
        error_at(c, g.line, "это имя уже занято", g.name)
    g.ty = t
    c.vars.add(Var(name: g.name, type: t, depth: 0, is_shared: true))
    c.globals.add(g)

modpub func check(c: Comp, program: Node)
    t = simple_type(c, "none")
    t = simple_type(c, "int")
    t = simple_type(c, "dec")
    t = simple_type(c, "bool")
    t = simple_type(c, "text")
    c.temp_types.add(-1)
    c.par_base = -1
    c.temp_base = -1

    // 0) модули и их use
    main_mod = ""
    if len(program.kids) > 0
        main_mod = program.kids[0].mod
    each top in program.kids
        if not is_module(c, top.mod)
            c.all_mods.add(top.mod)
        if top.kind == "use"
            if len(c.uses) == 500
                error_at(c, top.line, "слишком много use", "")
            c.uses.add(Use(mod: top.mod, used: top.name))
    // 1) имена всех obj и функций — чтобы их можно было использовать до объявления
    each top in program.kids
        c.file_name = top.file
        if top.kind == "obj"
            register_obj(c, top)
        else if top.kind == "enum"
            register_enum(c, top)
        else if top.kind == "func"
            register_func(c, top)
            top.can_fail = has_fail(top.kids[1])
            if top.name == "main" and top.mod != main_mod
                error_at(c, top.line, "main бывает только в главном файле, в модуле её быть не должно", "")
    // 2) типы качеств, параметров и выходов
    each top in program.kids
        c.file_name = top.file
        if top.kind == "obj"
            resolve_params(c, top)
        else if top.kind == "func"
            resolve_params(c, top.kids[0])
            resolve_params(c, top.kids[2])
            outputs = top.kids[2]
            if len(outputs.kids) == 1
                top.ty = outputs.kids[0].ty
            else if len(outputs.kids) > 1
                top.ty = multi_type(c, top)
            else if not has_value_return(top.kids[1])
                // так функция без return может вызывать сама себя
                top.ty = 0
    main_func = find_func_in(c, "main", main_mod)
    if len(program.kids) > 0
        c.file_name = program.kids[0].file
    if main_func < 0
        error_at(c, 0, "нет функции main: программа начинается с func main()", "")
    main_node = c.funcs[main_func].node
    if len(main_node.kids[0].kids) != 0 or len(main_node.kids[2].kids) != 0
        error_at(c, main_node.line, "у main не бывает параметров и gives", "")
    // shared снаружи функций: числа и да/нет, видны во всех функциях
    each top in program.kids
        if top.kind == "global"
            c.file_name = top.file
            check_global(c, top)
    c.n_globals = len(c.vars)
    // функции прерываний: только в ядре, без параметров и gives
    each top in program.kids
        if top.kind == "func" and top.irq != 0
            c.file_name = top.file
            if not c.bare
                error_at(c, top.line, "прерывания бывают только в ядре без ОС: собери файл командой tachbit bare", top.name)
            if top.irq < 32 or top.irq > 47
                error_at(c, top.line, "номер прерывания железа: от 32 (таймер) до 47; 33 — клавиатура", "")
            if len(top.kids[0].kids) != 0 or len(top.kids[2].kids) != 0
                error_at(c, top.line, "у функции прерывания не бывает параметров и gives: её зовёт процессор", top.name)
            each other in program.kids
                if other.kind == "func" and other.irq == top.irq and other.name != top.name
                    error_at(c, top.line, "на это прерывание уже есть функция", other.name)
    // 3) сначала main: так ярлыки link узнают свои типы по вызовам
    check_func(c, main_func)
    // 4) остальные функции; та, у которой ярлык ещё без типа, ждёт, пока её вызовет другая
    progress = true
    repeat while progress
        progress = false
        count i from 0 to len(c.funcs) - 1
            if c.funcs[i].state != 0 or not links_known(c.funcs[i].node)
                skip
            cut_vars(c, c.n_globals)
            c.depth = 0
            c.var_base = 0
            check_func(c, i)
            progress = true
    each f in c.funcs
        if f.state == 0
            c.file_name = f.node.file
            error_at(c, f.node.line, "функция с link ни разу не вызвана, поэтому тип ярлыка неизвестен", f.name)
    check_piece_leaks(c)
    check_par_calls(c)
    check_lock_calls(c)
    check_global_writes(c)
    mark_hot_fields(c)
