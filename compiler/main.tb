// Tachbit 1.1 — компилятор Tachbit, написанный на Tachbit.
//   tokens / tree / check / c / build / run  файл.tb
use types
use errors
use lexer
use runtime_text
use parser
use check
use emit
use emit_ll

// "examples/shop.tb" → папка "examples/" (на Windows и "examples\\shop.tb")
func folder_of(path: text)
    win = on_windows()
    cut_at = 0
    count i from 0 to len(path) - 1
        if path[i] == "/" or (win and path[i] == "\\")
            cut_at = i + 1
    if cut_at == 0
        return ""
    return cut(path, 0, cut_at - 1)

func without_tb(path: text)
    if len(path) > 3 and ends_with(path, ".tb")
        return cut(path, 0, len(path) - 4)
    return path

func module_of(path: text)
    folder = folder_of(path)
    return without_tb(cut(path, len(folder), len(path) - 1))

func load_module(c: Comp, program: Node, path: text, line_of_use: int, used_from: text, loaded: list text)
    name = module_of(path)
    each m in loaded
        if m == name
            return
    if len(loaded) == 200
        error_at(c, 0, "слишком много модулей", "")
    loaded.add(name)
    if not file_exists(path)
        c.file_name = used_from
        error_at(c, line_of_use, "нет файла для use", path)
    source = read_file(path) else err
        print("не могу открыть файл: " + path)
        exit(1)
    c.file_name = path
    lex(c, source)
    part = parse(c)
    each k in part.kids
        k.mod = name
        k.file = path
        add_kid(program, k)
    // теперь файлы, которые этот файл подключает через use
    each u in part.kids
        if u.kind == "use"
            next_path = folder_of(path) + u.name + ".tb"
            if not file_exists(next_path)
                next_path = lib_path(u.name, next_path)
            load_module(c, program, next_path, u.line, path, loaded)

// общая библиотека: нет модуля рядом — ищем в $TB_LIB, потом в ~/.tachbit/lib (туда кладёт tools/install.sh)
func lib_path(name: text, near: text)
    dirs = list text
    if env("TB_LIB") != ""
        dirs.add(env("TB_LIB"))
    home = env("HOME")
    if home == ""
        home = env("USERPROFILE")
    if home != ""
        dirs.add(home + "/.tachbit/lib")
    each d in dirs
        p = d + "/" + name + ".tb"
        if file_exists(p)
            return p
    return near

func load_program(c: Comp, path: text)
    program = new_node("program", 1)
    loaded = list text
    load_module(c, program, path, 0, path, loaded)
    c.file_name = path
    return program

// 'текст' для командной строки: кавычка внутри превращается в '\''
// на Windows (cmd.exe) — "текст", и / в пути становится \ (кавычек в именах Windows не бывает)
func quote(s: text)
    if on_windows()
        return "\"" + replace(s, "/", "\\") + "\""
    return "'" + replace(s, "'", "'\\''") + "'"

func is_dir_cmd(path: text)
    return is_folder(path)

func is_file(path: text)
    return file_exists(path) and not is_folder(path)

// папка вместе с недостающими папками над ней (как mkdir -p)
func make_folders(path: text)
    if path == "" or is_folder(path)
        return
    up = folder_of(path)
    if len(up) > 1
        make_folders(cut(up, 0, len(up) - 2))
    make_folder(path) else err
        ignored = err

// на Windows программа — это файл .exe
func exe_file(exe: text)
    if on_windows()
        return exe + ".exe"
    return exe

// компилятор C на Windows: $CC, иначе gcc или clang (MinGW-w64, llvm-mingw, MSYS2)
func windows_cc()
    cc = env("CC")
    if cc != ""
        return cc
    each name in ["gcc", "clang", "cc"]
        if run("where " + name + " >NUL 2>NUL") == 0
            return name
    return ""

func say_error(message: text)
    print(message)
    exit(1)

// что запускать: файл .tb и куда класть готовую программу
//   shop      (папка)  → shop/main.tb,  программа shop/build/shop
//   shop.tb / shop     → shop.tb,       программа shop
//   ничего             → ./main.tb,     программа build/<имя папки>
func project_main(arg: text) gives main_tb: text, exe: text
    name = arg
    if name == ""
        name = "."
    repeat while len(name) > 1 and (ends_with(name, "/") or (on_windows() and ends_with(name, "\\")))
        name = cut(name, 0, len(name) - 2)
    if is_dir_cmd(name)
        main_tb = name + "/main.tb"
        if not is_file(main_tb)
            say_error("в папке " + name + " нет main.tb — с него начинается проект")
        base = cut(name, len(folder_of(name)), len(name) - 1)
        build_dir = name + "/build"
        make_folders(build_dir)
        if name == "."
            if on_windows()
                // cd без слов в cmd.exe печатает текущую папку: C:\\Users\\я\\shop
                code = run("cd > " + quote(build_dir + "/.name"))
                here = trim(read_file(build_dir + "/.name") or "")
                base = cut(here, len(folder_of(here)), len(here) - 1)
            else
                code = run("basename \"$PWD\" > " + quote(build_dir + "/.name"))
                base = trim(read_file(build_dir + "/.name") or "")
        if base == "" or base == "." or base == ".."
            base = "main"
        exe = build_dir + "/" + base
        return
    if is_file(name)
        main_tb = name
        exe = without_tb(name)
        return
    if is_file(name + ".tb")
        main_tb = name + ".tb"
        exe = name
        return
    print("нет проекта или файла: " + name)
    say_error("новый проект делается так:  tb new " + name)

func new_project(name: text)
    if name == ""
        say_error("напиши имя проекта:  tb new имя")
    if file_exists(name) or is_folder(name)
        say_error("уже есть папка или файл с именем " + name + " — возьми другое имя")
    make_folder(name) else err
        say_error("не могу сделать папку: " + name)
    write_file(name + "/main.tb", "func main()\n    print(\"Привет из проекта " + name + "!\")\n") else err
        say_error("не могу записать файл: " + name + "/main.tb")
    write_file(name + "/.gitignore", "build/\n") else err
        ignored = err
    print("готов проект " + name + ":")
    print("  " + name + "/main.tb   — здесь пишешь программу")
    print("  " + name + "/build/    — сюда кладётся готовая программа\n")
    print("запуск:  tb start " + name)

// native: программа только для этого компьютера (tb run) — можно все команды его процессора
// --llvm: спросить clang, под какой процессор он собирает (цель, -march, настройки);
// без этого .ll собирался бы под самый старый x86 (на Intel Mac деление было в 3 раза медленнее)
func ll_probe(exe: text, native: bool) gives target: text, cpu: text
    probe = exe + ".probe"
    write_file(probe + ".c", "long long tb_probe(long long a) { return a; }\n") else err
        return
    base = "${CC:-clang} -O2 -w -S -emit-llvm -o " + quote(probe + ".ll") + " " + quote(probe + ".c") + " 2> /dev/null"
    ok = false
    if native
        ok = run(base + " -march=native") == 0
    if not ok
        ok = run(base) == 0
    if ok
        src = read_file(probe + ".ll") or ""
        target, cpu = ll_probe_parse(src)
    remove(probe + ".c") else err
        ignored = err
    remove(probe + ".ll") else err
        ignored = err

// где лежат opt, llc и llvm-link: TB_LLVM, llvm-config, brew (Mac), PATH; "" — нигде
func llvm_bin(tmp: text) gives d: text
    probe = "d=\"${TB_LLVM:-}\"; ok() { [ -n \"$1\" ] && [ -x \"$1/opt\" ] && [ -x \"$1/llc\" ] && [ -x \"$1/llvm-link\" ]; }; "
    probe += "ok \"$d\" || d=$(llvm-config --bindir 2> /dev/null); "
    probe += "ok \"$d\" || d=/opt/homebrew/opt/llvm/bin; ok \"$d\" || d=/usr/local/opt/llvm/bin; "
    probe += "ok \"$d\" || d=$(dirname \"$(command -v opt 2> /dev/null)\" 2> /dev/null); "
    probe += "ok \"$d\" && echo \"$d\" > " + quote(tmp)
    if run(probe) != 0
        return
    d = trim(read_file(tmp) or "")
    remove(tmp) else err
        ignored = err

// простое число-отпечаток текста (какой версии библиотека лежит в запасе)
func text_hash(s: text) gives h: int
    h = 5381
    each ch in s
        h = (h * 33 + code(ch)) % 2147483647

// библиотека runtime.h, заранее переведённая в LLVM (.bc), и её цель (процессор, система).
// Делается один раз на версию библиотеки (clang переводит C — так же, как готовят libc)
// и лежит в ~/.cache/tachbit; дальше программы собираются без clang
func llvm_lib(bin: text, gfx: bool, native: bool) gives lib: text, target: text, cpu: text
    dir = env("HOME") + "/.cache/tachbit"
    src = runtime_text()
    kind = "o"
    flags = " -DTB_LL"
    if gfx
        kind = "g"
        flags += " -DTB_GFX"
    if native
        kind += "n"
        flags += " -march=native"
    base = dir + "/rt-" + text_hash(src) + "-" + len(src) + "-" + kind
    lib = base + ".bc"
    tpath = base + ".target"
    if not file_exists(lib) or not file_exists(tpath)
        if run("mkdir -p " + quote(dir)) != 0
            lib = ""
            return
        write_file(base + ".c", src) else err
            lib = ""
            return
        cl = "c=" + quote(bin + "/clang") + "; [ -x \"$c\" ] || c=clang; "
        // Mac: clang из brew сам может не знать, где заголовки системы — берём их у xcrun
        cl += "s=; [ \"$(uname)\" = Darwin ] && command -v xcrun > /dev/null && s=\"-isysroot $(xcrun --show-sdk-path)\"; "
        cmd = cl + "\"$c\" $s -O2 -w -c -emit-llvm" + flags + " -x c " + quote(base + ".c") + " -o " + quote(base + ".tmp.bc") + " 2> /dev/null"
        cmd += " && " + quote(bin + "/llvm-dis") + " " + quote(base + ".tmp.bc") + " -o - | grep -E '^target |^attributes #0 ' > " + quote(base + ".tmp.target")
        cmd += " && mv " + quote(base + ".tmp.target") + " " + quote(tpath) + " && mv " + quote(base + ".tmp.bc") + " " + quote(lib)
        ok = run(cmd) == 0
        remove(base + ".c") else err
            ignored = err
        if not ok
            lib = ""
            return
    target, cpu = ll_probe_parse(read_file(tpath) or "")

// вся программа в .ll: llvm-link (+ библиотека .bc) → opt → llc → готовая программа.
// false — что-то не вышло (нет LLVM, старая версия ...): тогда собираем как раньше, через clang
func build_pure(c: Comp, program: Node, exe: text, native: bool) gives ok: bool
    bin = llvm_bin(exe + ".llvmbin")
    if bin == ""
        return false
    lib, target, cpu = llvm_lib(bin, c.gfx, native)
    if lib == ""
        return false
    ll_path = exe + ".ll"
    write_file(ll_path, emit_ll(c, program, target, cpu)) else err
        return false
    bc = exe + ".bc"
    ofile = exe + ".o"
    log = exe + ".llvm.log"
    cmd = quote(bin + "/llvm-link") + " " + quote(ll_path) + " " + quote(lib) + " -o " + quote(bc)
    // internalize: снаружи видна только main — opt встраивает библиотеку и выбрасывает лишнее
    cmd += " && " + quote(bin + "/opt") + " -passes='internalize,default<O2>' -internalize-public-api-list=main " + quote(bc) + " -o " + quote(bc)
    cmd += " && " + quote(bin + "/llc") + " -O2 -filetype=obj -relocation-model=pic " + quote(bc) + " -o " + quote(ofile)
    // склеить с системными библиотеками: обычный линкер системы (через cc)
    cmd += " && ${CC:-cc} -o " + quote(exe) + " " + quote(ofile) + " -lm -lpthread"
    if c.gfx
        cmd += " $( [ \"$(uname)\" = Darwin ] && echo '-framework Cocoa -framework CoreGraphics -framework QuartzCore -lobjc' || echo '-lX11' )"
    ok = run(cmd + " 2> " + quote(log)) == 0
    if not ok and env("TB_PURE_WHY") != ""
        print("без clang не вышло, смотри " + log)
    each f in [bc, ofile]
        remove(f) else err
            ignored = err
    if ok
        remove(log) else err
            ignored = err

// LLVM по умолчанию: не Windows, clang есть, CC пустой или clang
func ll_default() gives r: bool
    if on_windows()
        return false
    return run("command -v clang > /dev/null 2>&1 && case \"${CC:-clang}\" in *clang*) exit 0;; *) exit 1;; esac") == 0

func build(c: Comp, path: text, exe: text, native: bool)
    c_path = exe + ".c"
    if is_dir_cmd(exe)
        print("готовую программу некуда положить: " + exe + " — это папка. Переименуй папку или файл .tb")
        return 1
    program = load_program(c, path)
    check(c, program)
    if c.ll
        ll_pick(c, program)
    emit_c(c, program)
    // вся программа на LLVM: собираем без clang (llvm-link, opt, llc), если есть инструменты LLVM
    if c.ll and not on_windows() and env("TB_CLANG") == "" and ll_pure_ok(c, program)
        c.ll_pure = true
        if build_pure(c, program, exe, native)
            return 0
        c.ll_pure = false
    write_file(c_path, join(c.out, "")) else err
        print("не могу записать файл: " + c_path)
        return 1
    command = "${CC:-cc} -O2 -w -o " + quote(exe) + " " + quote(c_path) + " -lm -lpthread"
    // без -flto: запасной путь, если линкер не умеет LTO
    nolto = ""
    if len(c.ll_names) > 0
        // --llvm: числовые функции лежат в .ll; .c и .ll собирает clang (он понимает оба)
        ll_path = exe + ".ll"
        target, cpu = ll_probe(exe, native)
        write_file(ll_path, emit_ll(c, program, target, cpu)) else err
            print("не могу записать файл: " + ll_path)
            return 1
        // -flto: clang видит .c и .ll вместе и встраивает функции библиотеки прямо в код из .ll
        ll_files = " -o " + quote(exe) + " " + quote(c_path) + " " + quote(ll_path) + " -lm -lpthread"
        command = "${CC:-clang} -O2 -w -flto" + ll_files
        nolto = "${CC:-clang} -O2 -w" + ll_files
    flags_native = ""
    if native
        flags_native = " -march=native"
    // окно: на Mac — Cocoa (есть всегда), на Linux — X11
    if c.gfx
        gfx_libs = " $( [ \"$(uname)\" = Darwin ] && echo '-framework Cocoa -framework CoreGraphics -framework QuartzCore -lobjc' || echo '-lX11' )"
        command += gfx_libs
        if nolto != ""
            nolto += gfx_libs
    if on_windows()
        cc = windows_cc()
        if cc == ""
            print("нет компилятора C (gcc или clang). Поставь его, например:")
            print("  winget install -e --id MartinStorsjo.LLVM-MinGW.UCRT")
            print("и открой терминал заново. Подробнее: tools/install.ps1")
            return 1
        // -static: программе не нужны чужие .dll; стек 8 МБ, как на Linux
        command = cc + " -O2 -w -o " + quote(exe_file(exe)) + " " + quote(c_path) + " -static -Wl,--stack,8388608 -lm -lpthread"
        if c.gfx
            command += " -lgdi32"
    // сообщения cc — в отдельный файл: человеку не нужна простыня на C
    log = exe + ".cc.log"
    plain = command + " 2> " + quote(log)
    command += flags_native + " 2> " + quote(log)
    // если cc не знает -march=native (бывает на Apple M), собираем как обычно
    if nolto != ""
        nolto += " 2> " + quote(log)
    if run(command) != 0 and (flags_native == "" or run(plain) != 0) and (nolto == "" or run(nolto) != 0)
        print("не получилось собрать программу. Это ошибка Tachbit, а не твоя: твой код прошёл все проверки.")
        print("подробности для разработчиков Tachbit: " + log + " (и код на C: " + c_path + ")")
        return 1
    remove(log) else err
        ignored = err
    return 0

// режим «без ОС»: файл.tb → ядро .elf, которое грузит QEMU (или GRUB) без всякой ОС
func build_bare(c: Comp, path: text, exe: text)
    if on_windows()
        print("ядро без ОС пока собирается только на Linux и Mac")
        return 1
    c.bare = true
    c_path = exe + ".c"
    ld_path = exe + ".ld"
    elf = exe + ".elf"
    program = load_program(c, path)
    check(c, program)
    emit_c(c, program)
    write_file(c_path, join(c.out, "")) else err
        print("не могу записать файл: " + c_path)
        return 1
    // код и константы — только для чтения; «переменные потока» подряд; куча — с границы 4 МБ
    script = "ENTRY(_start)\nSECTIONS {\n  . = 1M;\n  tb_code_start = .;\n  .text : { KEEP(*(.multiboot)) *(.text*) }\n"
    script = script + "  .rodata : { *(.rodata*) }\n  . = ALIGN(4096);\n  tb_code_end = .;\n  .data : { *(.data*) }\n"
    script = script + "  .tbtls : { tb_tls_start = .; KEEP(*(.tbtls)) tb_tls_end = .; }\n  .bss : { *(COMMON) *(.bss*) }\n"
    script = script + "  . = ALIGN(0x400000);\n  tb_heap_area = .;\n  .tbheap (NOLOAD) : { *(.tbheap) }\n  . = ALIGN(4096);\n  tb_kernel_end = .;\n}\n"
    write_file(ld_path, script) else err
        print("не могу записать файл: " + ld_path)
        return 1
    flags = " -ffreestanding -nostdlib -fno-pie -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables -O2 -march=i686 -mno-sse -mno-mmx -w -c "
    o_path = quote(exe + ".o")
    // clang умеет собирать для чужого процессора сам; иначе gcc -m32
    cc = "if command -v clang >/dev/null 2>&1; then clang --target=i686-elf" + flags + quote(c_path) + " -o " + o_path
    cc = cc + "; else gcc -m32" + flags + quote(c_path) + " -o " + o_path + "; fi"
    if run(cc) != 0
        print("компилятор C не справился (это ошибка Tachbit, а не твоя): " + c_path)
        return 1
    // свой компоновщик (на Python, он есть почти везде); если Python нет — ld.lld
    py_path = exe + ".link.py"
    write_file(py_path, runtime_text.linker_text()) else err
        print("не могу записать файл: " + py_path)
        return 1
    ld_cmd = "if command -v python3 >/dev/null 2>&1; then python3 " + quote(py_path) + " " + o_path + " -o " + quote(elf)
    ld_cmd = ld_cmd + "; elif command -v ld.lld >/dev/null 2>&1; then ld.lld -m elf_i386 -T " + quote(ld_path) + " -o " + quote(elf) + " " + o_path
    ld_cmd = ld_cmd + "; else echo 'нужен python3 или ld.lld'; false; fi"
    if run(ld_cmd) != 0
        print("не получилось собрать ядро из " + c_path)
        return 1
    removed = run("rm -f " + quote(py_path))
    cleaned = run("rm -f " + o_path + " " + quote(ld_path))
    print("готово ядро: " + elf)
    print("запуск:  qemu-system-i386 -kernel " + quote(elf))
    return 0

func usage()
    print("Tachbit 1.1 (компилятор на Tachbit)\n")
    print("  tb new   имя             новый проект: папка имя/ с main.tb")
    print("  tb start имя [слова]     собрать проект и запустить (без имени — текущая папка)\n")
    print("  tachbit run    файл.tb [слова]   сделать программу и запустить")
    print("  tachbit build  файл.tb   сделать программу рядом с файлом")
    print("  tachbit bare   файл.tb   сделать ядро без ОС (файл.elf для QEMU)")
    print("  tachbit check  файл.tb   только найти ошибки")
    print("  tachbit c      файл.tb   показать, какой C получился")
    print("  tachbit ll     файл.tb   показать LLVM IR числовых функций (опыт)")
    print("  --llvm / --c   к build / run: собрать через LLVM (так и есть, если есть clang) или через C")
    print("  tachbit tree   файл.tb   показать дерево")
    print("  tachbit tokens файл.tb   показать токены")

func main()
    all_args = args()
    // --llvm где угодно в строке: собрать через LLVM IR; --c: старый путь через C
    force_ll = false
    force_c = false
    a = list text
    each x in all_args
        if x == "--llvm"
            force_ll = true
        else if x == "--c"
            force_c = true
        else
            a.add(x)
    if len(a) < 1
        usage()
        exit(1)
    mode = a[0]
    if mode == "new"
        name = ""
        if len(a) > 1
            name = a[1]
        new_project(name)
        return
    if mode == "help" or mode == "-h" or mode == "--help"
        usage()
        return
    if mode == "version" or mode == "--version"
        print("Tachbit 1.1 (компилятор на Tachbit)")
        return
    if mode == "start"
        mode = "run"
    // имя проекта можно не писать: тогда берётся текущая папка
    if len(a) < 2 and not (mode == "run" or mode == "build" or mode == "bare" or mode == "check" or mode == "c" or mode == "ll")
        usage()
        exit(1)
    arg = ""
    if len(a) > 1
        arg = a[1]
    path, exe = project_main(arg)
    // build / run идут через LLVM сами, если есть clang (и CC не другой компилятор)
    use_ll = force_ll
    if not force_ll and not force_c and (mode == "run" or mode == "build")
        use_ll = ll_default()
    c = Comp(file_name: path, ll: use_ll)
    if mode == "tokens"
        src = read_file(path) else err
            say_error("не могу открыть файл: " + path)
        lex(c, src)
        print_tokens(c)
        return
    if mode == "tree"
        out = list text
        tree_lines(load_program(c, path), 0, out)
        print(join(out, "\n"))
        return
    if mode == "check"
        check(c, load_program(c, path))
        print("ошибок нет")
        return
    if mode == "c"
        program = load_program(c, path)
        check(c, program)
        emit_c(c, program)
        print(cut(join(c.out, ""), 0, len(join(c.out, "")) - 2))
        return
    if mode == "ll"
        // показать, какие функции уйдут в LLVM, и сам текст .ll
        program = load_program(c, path)
        check(c, program)
        ll_pick(c, program)
        target, cpu = ll_probe(exe, false)
        print(emit_ll(c, program, target, cpu))
        return
    if mode == "build"
        exit(build(c, path, exe, false))
    if mode == "bare"
        exit(build_bare(c, path, exe))
    if mode == "run"
        // один файл: программа собирается в ~/.tachbit/run, рядом с .tb ничего не остаётся
        home = env("HOME")
        if on_windows()
            home = env("USERPROFILE")
        if find(exe, "/build/") < 0 and home != ""
            run_dir = home + "/.tachbit/run"
            make_folders(run_dir)
            exe = run_dir + "/" + module_of(path)
        if build(c, path, exe, true) != 0
            exit(1)
        // tachbit run файл.tb a b c  →  программа получит a b c в args()
        command = quote(exe_file(exe))
        if find(exe, "/") < 0
            command = quote("./" + exe_file(exe))
        count i from 2 to len(a) - 1
            command = command + " " + quote(a[i])
        exit(run(command))
    usage()
    exit(1)
