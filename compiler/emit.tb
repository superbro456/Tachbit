// Слой 4. ВЫВОД C: проверенное дерево → текст программы на C.
// Дальше обычный компилятор C (clang / gcc) делает из него машинный код.
// Имена программиста получают приставки: v_ у переменных, f_ у функций,
// tb_o_ у obj, q_ у качеств obj, чтобы не столкнуться со словами C (int, main, printf ...).
// Текст собирается кусками в c.out, в конце склеивается одним join.
use check
use runtime_text
use memplan

func put(c: Comp, s: text)
    c.out.add(s)

// имя функции в C: f_<модуль>__<имя>, чтобы две modpri-функции из разных файлов не столкнулись
func fname(f: Node)
    mod = ""
    each ch in f.mod
        k = code(ch)
        if (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57)
            mod = mod + ch
        else
            mod = mod + "_"
    return "f_" + mod + "__" + f.name

func c_type(c: Comp, t: int)
    k = kind_of(c, t)
    if k == "int"
        return "long long"
    if k == "dec"
        return "double"
    if k == "bool"
        return "_Bool"
    if k == "text"
        return "const char *"
    if k == "list"
        if is_cols_list(c, t)
            return "tb_cols_" + c.types[c.types[t].elem].obj_node.name + " *"
        return "tb_list *"
    if k == "dict"
        return "tb_dict *"
    if k == "obj"
        if is_cols_obj(c, t)
            return "tb_row_" + c.types[t].obj_node.name
        return "tb_o_" + c.types[t].obj_node.name + " *"
    if k == "multi"
        return "tb_r_" + fname(c.types[t].func_node)
    if k == "task"
        return "tb_task *"
    if k == "channel"
        return "tb_chan *"
    if k == "enum"
        return "long long"
    return "void"

func indent(c: Comp, depth: int)
    count i from 1 to depth
        put(c, "    ")

// list bool хранится битами: по биту на элемент
func is_bits(c: Comp, t: int)
    return kind_of(c, t) == "list" and c.types[t].elem == 3

func emit_default(c: Comp, t: int)
    k = kind_of(c, t)
    if k == "int"
        put(c, "0LL")
    else if k == "dec"
        put(c, "0.0")
    else if k == "text"
        put(c, "\"\"")
    else if k == "list" and is_cols_list(c, t)
        put(c, "tb_cols_new_" + cols_name(c, t) + "()")
    else if k == "obj" and is_cols_obj(c, t)
        put(c, "(" + c_type(c, t) + "){0, 0}")
    else if k == "list" and is_bits(c, t)
        put(c, "tb_bits_new()")
    else if k == "list" and is_plain_ty(c, c.types[t].elem)
        // числа: внутри нет адресов, уборка памяти туда не смотрит
        put(c, "tb_list_new_np(sizeof(" + c_type(c, c.types[t].elem) + "))")
    else if k == "list"
        put(c, "tb_list_new(sizeof(" + c_type(c, c.types[t].elem) + "))")
    else if k == "channel"
        is_text = "0"
        if c.types[t].elem == 4
            is_text = "1"
        put(c, "tb_chan_new(sizeof(" + c_type(c, c.types[t].elem) + "), " + is_text + ")")
    else if k == "dict"
        is_text = "0"
        if kind_of(c, c.types[t].key) == "text"
            is_text = "1"
        put(c, "tb_dict_new(" + is_text + ", sizeof(" + c_type(c, c.types[t].elem) + "))")
    else
        put(c, "0")

// имя obj by columns: у списка колонок — по типу элементов
func cols_name(c: Comp, t: int)
    if kind_of(c, t) == "list"
        return c.types[c.types[t].elem].obj_node.name
    return c.types[t].obj_node.name

func is_simple(c: Comp, t: int)
    k = kind_of(c, t)
    return k == "int" or k == "dec" or k == "bool" or k == "text"

// &(K){ключ} — ключ dict как адрес
func emit_key(c: Comp, dt: int, key: Node)
    put(c, "&(" + c_type(c, c.types[dt].key) + "){")
    emit_expr(c, key)
    put(c, "}")

// ---------- выражения ----------

// значение там, где нужен тип want (int → dec)
func emit_as(c: Comp, n: Node, want: int)
    if kind_of(c, want) == "dec" and kind_of(c, n.ty) == "int"
        put(c, "(double)(")
        emit_expr(c, n)
        put(c, ")")
        return
    emit_expr(c, n)

// любое простое значение как текст (для  "итог: " + x)
func emit_as_text(c: Comp, n: Node)
    k = kind_of(c, n.ty)
    if k == "text"
        emit_q(c, n)
        return
    if k == "int"
        put(c, "tb_itos(")
    else if k == "dec"
        put(c, "tb_dtos(")
    else
        put(c, "tb_btos(")
    emit_expr(c, n)
    put(c, ")")

func emit_print(c: Comp, n: Node, newline: bool)
    put(c, "(")
    count i from 0 to len(n.kids) - 1
        value = n.kids[i].kids[0]
        if i > 0
            put(c, ", tb_ps(\" \"), ")
        put(c, "tb_show_" + value.ty + "(")
        emit_q(c, value)
        put(c, ")")
    if not newline
        if len(n.kids) == 0
            put(c, "0")
        put(c, ")")
        return
    if len(n.kids) > 0
        put(c, ", ")
    put(c, "tb_ps(\"\\n\"))")

// встроенные функции: имя → функция из runtime.h и её аргументы
func emit_args(c: Comp, n: Node, with_line: bool)
    count i from 0 to len(n.kids) - 1
        if i > 0
            put(c, ", ")
        emit_expr(c, n.kids[i].kids[0])
    if with_line
        if len(n.kids) > 0
            put(c, ", ")
        put(c, "" + n.line)
    put(c, ")")

func emit_builtin(c: Comp, n: Node)
    name = n.name
    if name == "print" or name == "show"
        emit_print(c, n, name == "print")
        return
    if name == "args"
        put(c, "tb_args")
        return
    if name == "input"
        put(c, "tb_input()")
        return
    if name == "asm"
        put(c, "__asm__ volatile(" + n.kids[0].kids[0].value + " ::: \"memory\")")
        return
    k_names = ["page_new", "uptime_ms", "interrupts_on", "interrupts_off", "yield", "read_key", "window_alive", "mouse_x", "mouse_y", "mouse_down", "mouse_wheel", "typed_text", "clipboard_get", "window_sharp", "window_scale", "mouse_back", "mouse_forward", "time_ms", "date_now", "unix_time", "frame_ms", "fps", "window_w", "window_h", "mesh_new"]
    k_c = ["tb_page_new", "tb_uptime_ms", "tb_irq_on", "tb_irq_off", "tb_yield", "tb_read_key", "tb_window_alive", "tb_mouse_x", "tb_mouse_y", "tb_mouse_down", "tb_mouse_wheel", "tb_typed_text", "tb_clipboard_get", "tb_window_sharp", "tb_window_scale", "tb_mouse_back", "tb_mouse_forward", "tb_time_ms", "tb_date_now", "tb_unix_time", "tb_frame_ms", "tb_fps", "tb_window_w", "tb_window_h", "tb_mesh_new"]
    count j from 0 to len(k_names) - 1
        if k_names[j] == name
            put(c, k_c[j] + "()")
            return
    a = n.kids[0].kids[0]
    if name == "len"
        k = kind_of(c, a.ty)
        if k == "text" and is_bld(c, a)
            put(c, "(tb_rl_" + a.name + " >= 0 ? tb_rl_" + a.name + " : tb_tlen(v_" + a.name + "))")
        else if k == "text"
            put(c, "tb_tlen(")
            emit_expr(c, a)
            put(c, ")")
        else if k == "dict"
            put(c, "(")
            emit_expr(c, a)
            put(c, ")->keys->len")
        else
            put(c, "(")
            emit_expr(c, a)
            put(c, ")->len")
        return
    if name == "sort"
        k = kind_of(c, c.types[a.ty].elem)
        put(c, "tb_sort_list(")
        emit_expr(c, a)
        if k == "int"
            put(c, ", tb_cmp_int)")
        else if k == "dec"
            put(c, ", tb_cmp_dec)")
        else
            put(c, ", tb_cmp_text)")
        return
    if name == "abs"
        if kind_of(c, a.ty) == "int"
            put(c, "tb_absi(")
        else
            put(c, "fabs(")
        emit_expr(c, a)
        put(c, ")")
        return
    if name == "sqrt"
        put(c, "tb_sqrt((double)(")
        emit_expr(c, a)
        put(c, "), " + n.line + ")")
        return
    if name == "min" or name == "max"
        ints = kind_of(c, n.ty) == "int"
        if ints
            put(c, "tb_" + name + "i(")
            emit_expr(c, a)
            put(c, ", ")
            emit_expr(c, n.kids[1].kids[0])
        else
            put(c, "tb_" + name + "d(")
            emit_as(c, a, n.ty)
            put(c, ", ")
            emit_as(c, n.kids[1].kids[0], n.ty)
        put(c, ")")
        return
    // остальные: просто имя функции из runtime.h; с номером строки — те, что могут упасть
    c_names = ["round", "tb_round", "0", "char", "tb_chr", "0", "cut", "tb_cut", "1", "code", "tb_code", "1", "to_int", "tb_to_int", "0", "to_dec", "tb_to_dec", "0", "read_file", "tb_read_file", "0", "write_file", "tb_write_file", "0", "split", "tb_split", "1", "join", "tb_join", "0", "find", "tb_find", "0", "replace", "tb_replace", "1", "upper", "tb_upper", "0", "lower", "tb_lower", "0", "trim", "tb_trim", "0", "starts_with", "tb_starts", "0", "ends_with", "tb_ends", "0", "run", "tb_run", "0", "exit", "tb_exit", "0", "file_exists", "tb_file_exists", "0", "list_dir", "tb_list_dir", "0", "is_folder", "tb_is_folder", "0", "make_folder", "tb_make_folder", "0", "move", "tb_move", "0", "remove", "tb_remove", "0", "env", "tb_env", "0", "file_size", "tb_file_size", "0", "window_open", "tb_window_open", "0", "clear_window", "tb_clear_window", "0", "draw_pixel", "tb_draw_pixel", "0", "draw_rect", "tb_draw_rect", "0", "draw_circle", "tb_draw_circle", "0", "draw_triangle", "tb_draw_triangle", "0", "mesh_add", "tb_mesh_add", "0", "draw_mesh", "tb_draw_mesh", "0", "camera", "tb_camera", "0", "draw_line", "tb_draw_line", "0", "draw_text", "tb_draw_text", "0", "key_down", "tb_key_down", "0", "set_fps", "tb_set_fps", "0", "clipboard_set", "tb_clipboard_set", "0", "set_cursor", "tb_set_cursor", "1", "load_image", "tb_load_image", "0", "load_font", "tb_load_font", "0", "draw_font", "tb_draw_font", "0", "text_width", "tb_text_width", "0", "draw_image", "tb_draw_image", "0", "image_w", "tb_image_w", "0", "image_h", "tb_image_h", "0", "rgb", "tb_rgb", "0", "random", "tb_random", "0", "bit_and", "tb_band", "0", "bit_or", "tb_bor", "0", "bit_xor", "tb_bxor", "0", "bit_not", "tb_bnot", "0", "shift_left", "tb_shl", "0", "shift_right", "tb_shr", "0", "read8", "tb_rd8", "1", "read16", "tb_rd16", "1", "read32", "tb_rd32", "1", "read64", "tb_rd64", "1", "write8", "tb_wr8", "1", "write16", "tb_wr16", "1", "write32", "tb_wr32", "1", "write64", "tb_wr64", "1", "address_of", "tb_addr_of", "0", "new_mem", "tb_new_mem", "1", "free_mem", "tb_free_mem", "1", "grow_mem", "tb_grow_mem", "1", "copy_mem", "tb_copy_mem", "1", "fill_mem", "tb_fill_mem", "1", "shape_get", "tb_shape_get", "1", "shape_set", "tb_shape_set", "1", "shape_at", "tb_shape_at", "0", "port_in8", "tb_pin8", "0", "port_in16", "tb_pin16", "0", "port_in32", "tb_pin32", "0", "port_out8", "tb_pout8", "0", "port_out16", "tb_pout16", "0", "port_out32", "tb_pout32", "0", "page_free", "tb_page_free", "0", "wait_ms", "tb_wait_ms", "0", "http_get", "tb_http_get", "0", "json_get", "tb_json_get", "0", "json_text", "tb_json_text", "0", "date_now", "tb_date_now", "0", "unix_time", "tb_unix_time", "0", "load_sound", "tb_load_sound", "0", "play_sound", "tb_play_sound", "0", "loop_sound", "tb_loop_sound", "0", "play_sound_at", "tb_play_sound_at", "0", "loop_sound_at", "tb_loop_sound_at", "0", "play_tone", "tb_play_tone", "0", "stop_sound", "tb_stop_sound", "0", "sound_playing", "tb_sound_playing", "0", "sound_volume", "tb_sound_volume", "0", "sound_pitch", "tb_sound_pitch", "0", "move_sound", "tb_move_sound", "0", "master_volume", "tb_master_volume", "0", "listener", "tb_listener", "0"]
    i = 0
    repeat while i < len(c_names)
        if c_names[i] == name
            put(c, c_names[i + 1] + "(")
            emit_args(c, n, c_names[i + 2] == "1")
            return
        i += 3
    put(c, "/* неизвестная встроенная " + name + " */0")

// in_ll: тело в .ll (f__ll), а C-шная f(...) собирает выходы в структуру;
// иначе тело в C, а f__ll(..., адреса) для .ll раскладывает структуру по адресам
func emit_ll_gives(c: Comp, f: Node, in_ll: bool)
    rt = c_type(c, f.ty)
    nm = fname(f)
    decl = ""
    args = ""
    each p in f.kids[0].kids
        if decl != ""
            decl = decl + ", "
            args = args + ", "
        if p.is_link
            decl = decl + c_type(c, p.ty) + " *v_" + p.name
        else
            decl = decl + c_type(c, p.ty) + " v_" + p.name
        args = args + "v_" + p.name
    outs = ""
    oargs = ""
    count j from 0 to len(f.kids[2].kids) - 1
        outs = outs + ", " + c_type(c, f.kids[2].kids[j].ty) + " *o" + j
        oargs = oargs + ", &r.o" + j
    ll_decl = decl + outs
    ll_args = args + oargs
    if decl == ""
        ll_decl = cut(outs, 2, len(outs) - 1)
        ll_args = cut(oargs, 2, len(oargs) - 1)
    put(c, "void " + nm + "__ll(" + ll_decl + ")")
    if in_ll
        put(c, ";\n" + rt + " " + nm + "(")
        if decl == ""
            put(c, "void")
        put(c, decl + ") { " + rt + " r; " + nm + "__ll(" + ll_args + "); return r; }\n")
        return
    put(c, " { " + rt + " r = " + nm + "(" + args + ");")
    count j from 0 to len(f.kids[2].kids) - 1
        put(c, " *o" + j + " = r.o" + j + ";")
    put(c, " }\n")

// обёртка tb_llb_N для встроенной функции из .ll: параметры a0, a1 ... вместо выражений,
// тело — то же, что вывод C написал бы прямо на месте вызова (с тем же номером строки)
func emit_ll_builtin(c: Comp, n: Node, id: int)
    rt = "void"
    if kind_of(c, n.ty) != "none"
        rt = c_type(c, n.ty)
    put(c, "TB_LLV " + rt + " tb_llb_" + id + "(")
    args = ll_bi_args(n)
    if len(args) == 0
        put(c, "void")
    count i from 0 to len(args) - 1
        if i > 0
            put(c, ", ")
        put(c, c_type(c, args[i].ty) + " v_a" + i)
        ll_bi_set(n, i, Node(kind: "name", line: args[i].line, name: "a" + i, ty: args[i].ty))
    put(c, ") { ")
    if rt != "void"
        put(c, "return ")
    if n.kind == "call"
        emit_builtin(c, n)
    else
        // background f(...) и t.wait: тот же вывод C, что и на месте
        emit_expr(c, n)
    put(c, "; }\n")
    count i from 0 to len(args) - 1
        ll_bi_set(n, i, args[i])

// поставить i-й аргумент обёртки на место (см. ll_bi_args)
func ll_bi_set(n: Node, i: int, v: Node)
    if n.kind == "field"
        n.kids[0] = v
    else if n.kind == "background"
        n.kids[0].kids[i].kids[0] = v
    else
        n.kids[i].kids[0] = v

func emit_call(c: Comp, n: Node)
    if not n.has_ref
        emit_builtin(c, n)
        return
    if n.ref.kind == "obj"
        o = n.ref
        put(c, "tb_new_" + o.name + "(")
        count i from 0 to len(o.kids) - 1
            if i > 0
                put(c, ", ")
            if n.kids[i].kind == "missing"
                emit_default(c, o.kids[i].ty)
            else
                emit_as(c, n.kids[i].kids[0], o.kids[i].ty)
        put(c, ")")
        return
    params = n.ref.kids[0]
    put(c, fname(n.ref) + "(")
    count i from 0 to len(n.kids) - 1
        if i > 0
            put(c, ", ")
        if params.kids[i].is_link
            put(c, "&(")
            emit_expr(c, n.kids[i].kids[0])
            put(c, ")")
        else
            emit_as(c, n.kids[i].kids[0], params.kids[i].ty)
    put(c, ")")

func emit_dict(c: Comp, n: Node)
    t = c.types[n.ty]
    kt = c_type(c, t.key)
    vt = c_type(c, t.elem)
    is_text = "0"
    if kind_of(c, t.key) == "text"
        is_text = "1"
    put(c, "tb_dict_from(" + is_text + ", sizeof(" + vt + "), " + (len(n.kids) / 2) + ", (" + kt + "[]){")
    i = 0
    repeat while i < len(n.kids)
        if i > 0
            put(c, ", ")
        emit_expr(c, n.kids[i])
        i += 2
    put(c, "}, (" + vt + "[]){")
    i = 1
    repeat while i < len(n.kids)
        if i > 1
            put(c, ", ")
        emit_as(c, n.kids[i], t.elem)
        i += 2
    put(c, "})")

// .pop()  и методы dict; .add пишется отдельной строкой (emit_statement)
func emit_method(c: Comp, n: Node)
    base = n.kids[0]
    if kind_of(c, base.ty) == "channel"
        elem = c.types[base.ty].elem
        if n.name == "send"
            put(c, "tb_chan_send(")
            emit_expr(c, base)
            put(c, ", &(" + c_type(c, elem) + "){")
            emit_as(c, n.kids[1].kids[0], elem)
            put(c, "}, " + n.line + ")")
        else if n.name == "receive"
            put(c, "TB_CH_RECV(" + c_type(c, elem) + ", ")
            emit_expr(c, base)
            put(c, ", " + n.line + ")")
        else
            put(c, "tb_chan_close(")
            emit_expr(c, base)
            put(c, ")")
        return
    if n.name == "clear"
        if kind_of(c, base.ty) == "dict"
            put(c, "tb_dclear(")
        else
            put(c, "tb_lclear(")
        emit_expr(c, base)
        put(c, ", " + n.line + ")")
        return
    if kind_of(c, base.ty) == "dict"
        if n.name == "values" and is_cols_list(c, n.ty)
            put(c, "tb_colsfrom_" + cols_name(c, n.ty) + "((")
            emit_expr(c, base)
            put(c, ")->vals->len, (" + c_type(c, c.types[n.ty].elem) + " *)(")
            emit_expr(c, base)
            put(c, ")->vals->data)")
            return
        if n.name == "values" and is_bits(c, n.ty)
            put(c, "tb_bits_of_bytes((")
            emit_expr(c, base)
            put(c, ")->vals)")
            return
        if n.name == "keys" or n.name == "values"
            put(c, "tb_copy((")
            emit_expr(c, base)
            if n.name == "keys"
                put(c, ")->keys)")
            else
                put(c, ")->vals)")
            return
        if n.name == "has"
            put(c, "tb_dhas(")
        else
            put(c, "tb_dremove(")
        emit_expr(c, base)
        put(c, ", ")
        emit_key(c, base.ty, n.kids[1].kids[0])
        put(c, ")")
        return
    if is_bits(c, base.ty)
        put(c, "tb_bpop(")
        emit_expr(c, base)
        put(c, ", " + n.line + ")")
        return
    put(c, "(*(" + c_type(c, n.ty) + " *)tb_pop(")
    emit_expr(c, base)
    put(c, ", " + n.line + "))")

func emit_list(c: Comp, n: Node)
    elem_ty = c.types[n.ty].elem
    elem = c_type(c, elem_ty)
    if is_cols_list(c, n.ty)
        put(c, "tb_colsfrom_" + cols_name(c, n.ty) + "(" + len(n.kids) + ", (" + elem + "[]){")
    else if is_bits(c, n.ty)
        put(c, "tb_bits_from(" + len(n.kids) + ", (unsigned char[]){")
    else if is_plain_ty(c, elem_ty)
        put(c, "tb_list_from_np(" + len(n.kids) + ", sizeof(" + elem + "), (" + elem + "[]){")
    else
        put(c, "tb_list_from(" + len(n.kids) + ", sizeof(" + elem + "), (" + elem + "[]){")
    count i from 0 to len(n.kids) - 1
        if i > 0
            put(c, ", ")
        emit_as(c, n.kids[i], elem_ty)
    put(c, "})")

// все части цепочки a + b + (c + d): по порядку слева направо
func concat_parts(c: Comp, n: Node, parts: list Node)
    if n.kind == "binop" and n.value == "+" and kind_of(c, n.ty) == "text"
        concat_parts(c, n.kids[0], parts)
        concat_parts(c, n.kids[1], parts)
    else
        parts.add(n)

// a + b + c + d: склеить за один раз. Сначала каждая часть и её длина
// (числа — цифрами в маленький буфер на стеке, готовый текст — длина известна заранее),
// потом одна память ровно под результат и копирование всех частей подряд.
func emit_concat(c: Comp, n: Node)
    parts = list Node
    concat_parts(c, n, parts)
    c.label += 1
    id = "" + c.label
    put(c, "({ ")
    total = ""
    count i from 0 to len(parts) - 1
        part = parts[i]
        v = "tb_c" + id + "_" + i
        k = kind_of(c, part.ty)
        if k == "int"
            put(c, "char " + v + "d[24]; long long " + v + "n; const char *" + v + " = tb_digits(")
            emit_expr(c, part)
            put(c, ", " + v + "d, &" + v + "n); ")
        else if part.kind == "string"
            put(c, "const char *" + v + " = " + part.value + "; long long " + v + "n = sizeof(" + part.value + ") - 1; ")
        else
            put(c, "const char *" + v + " = ")
            emit_as_text(c, part)
            put(c, "; long long " + v + "n = (long long)strlen(" + v + "); ")
        if i > 0
            total = total + " + "
        total = total + v + "n"
    r = "tb_c" + id + "r"
    put(c, "char *" + r + " = tb_tmem(" + total + " + 1), *" + r + "w = " + r + "; ")
    count i from 0 to len(parts) - 1
        v = "tb_c" + id + "_" + i
        put(c, "memcpy(" + r + "w, " + v + ", " + v + "n); " + r + "w += " + v + "n; ")
    put(c, "*" + r + "w = 0; (const char *)" + r + "; })")

func emit_binop(c: Comp, n: Node)
    op = n.value
    a = n.kids[0]
    b = n.kids[1]
    if op == "orelse"
        // f() or запасное: (tb_t = f(), tb_err ? (tb_err = 0, запасное) : tb_t)
        put(c, "(tb_t" + n.temp_no + " = ")
        emit_expr(c, a)
        put(c, ", tb_err ? (tb_err = 0, ")
        emit_as(c, b, n.ty)
        put(c, ") : tb_t" + n.temp_no + ")")
        return
    if kind_of(c, n.ty) == "text"
        emit_concat(c, n)
        return
    if kind_of(c, a.ty) == "text" and (op == "==" or op == "!=") and (short_literal(b) or short_literal(a))
        // ch == ","  —  сравнить байты прямо, без strcmp (часто в циклах по тексту)
        lit = b
        other = a
        if not short_literal(b)
            lit = a
            other = b
        body = cut(lit.value, 1, len(lit.value) - 2)
        c.label += 1
        sv = "tb_s" + c.label
        put(c, "({ const char *" + sv + " = ")
        emit_q(c, other)
        put(c, "; ")
        if op == "!="
            put(c, "!")
        put(c, "(")
        i = 0
        each ch in body
            put(c, "(unsigned char)" + sv + "[" + i + "] == " + code(ch) + " && ")
            i += 1
        put(c, sv + "[" + i + "] == 0); })")
        return
    if kind_of(c, a.ty) == "text"
        put(c, "(strcmp(")
        emit_q(c, a)
        put(c, ", ")
        emit_q(c, b)
        put(c, ") " + op + " 0)")
        return
    if kind_of(c, n.ty) == "int" and (op == "/" or op == "%")
        if op == "/"
            put(c, "tb_div(")
        else
            put(c, "tb_mod(")
        emit_expr(c, a)
        put(c, ", ")
        emit_expr(c, b)
        put(c, ", " + n.line + ")")
        return
    c_op = op
    if op == "and"
        c_op = "&&"
    else if op == "or"
        c_op = "||"
    put(c, "(")
    if kind_of(c, n.ty) == "dec" and op == "/"
        emit_as(c, a, n.ty)
    else
        emit_expr(c, a)
    put(c, " " + c_op + " ")
    emit_expr(c, b)
    put(c, ")")

func emit_expr(c: Comp, n: Node)
    k = n.kind
    if k == "number" or k == "enumval"
        put(c, n.value + "LL")
    else if k == "decimal" or k == "string"
        put(c, n.value)
    else if k == "bool"
        if n.value == "true"
            put(c, "1")
        else
            put(c, "0")
    else if k == "name" and len(c.vec_names) > 0 and vec_index(c, n.name) >= 0
        put(c, c.vec_repl[vec_index(c, n.name)])
    else if k == "name"
        if n.is_link
            put(c, "(*v_" + n.name + ")")
        else if is_bld(c, n)
            put(c, "(tb_rl_" + n.name + " = -1, v_" + n.name + ")")
        else
            put(c, "v_" + n.name)
    else if k == "list"
        emit_list(c, n)
    else if k == "dict"
        emit_dict(c, n)
    else if k == "try" or k == "else_err"
        // значение уже посчитано строкой выше (emit_pre)
        put(c, "tb_v" + n.temp_no)
    else if k == "call"
        emit_call(c, n)
    else if k == "method"
        emit_method(c, n)
    else if k == "binop"
        emit_binop(c, n)
    else if k == "unary"
        if n.value == "not"
            put(c, "(!")
        else
            put(c, "(-")
        emit_expr(c, n.kids[0])
        put(c, ")")
    else if k == "index" and kind_of(c, n.kids[0].ty) == "dict"
        put(c, "(*(" + c_type(c, n.ty) + " *)tb_dget(")
        emit_expr(c, n.kids[0])
        put(c, ", ")
        emit_key(c, n.kids[0].ty, n.kids[1])
        put(c, ", " + n.line + "))")
    else if k == "index" and is_cols_list(c, n.kids[0].ty)
        put(c, "tb_colat_" + cols_name(c, n.kids[0].ty) + "(")
        emit_expr(c, n.kids[0])
        put(c, ", ")
        emit_expr(c, n.kids[1])
        put(c, ", " + n.line + ")")
    else if k == "index"
        if kind_of(c, n.kids[0].ty) == "text"
            put(c, "tb_char_at(")
            emit_q(c, n.kids[0])
            put(c, ", ")
            emit_expr(c, n.kids[1])
            if is_bld(c, n.kids[0])
                put(c, ", tb_rl_" + n.kids[0].name)
            else
                put(c, ", -1")
            put(c, ", " + n.line + ")")
        else if is_bits(c, n.kids[0].ty)
            put(c, "tb_bget(")
            emit_expr(c, n.kids[0])
            put(c, ", ")
            emit_expr(c, n.kids[1])
            put(c, ", " + n.line + ")")
        else if fast_index(c, n)
            // граница проверена до цикла: прямо в память, без проверки на каждом шаге
            t = c_type(c, n.ty)
            if is_narrow(c, n.kids[0])
                t = "int"
            put(c, "(((" + t + " *)(")
            emit_expr(c, n.kids[0])
            put(c, ")->data)[")
            emit_expr(c, n.kids[1])
            put(c, "])")
        else
            t = c_type(c, n.ty)
            if is_narrow(c, n.kids[0])
                t = "int"
            put(c, "(*(" + t + " *)tb_at(")
            emit_expr(c, n.kids[0])
            put(c, ", ")
            emit_expr(c, n.kids[1])
            put(c, ", sizeof(" + t + "), " + n.line + "))")
    else if k == "field" and kind_of(c, n.kids[0].ty) == "task"
        rt = c.types[n.kids[0].ty].elem
        if rt == 0
            put(c, "((void)tb_wait(")
            emit_expr(c, n.kids[0])
            put(c, "))")
        else
            put(c, "(*(" + c_type(c, rt) + " *)tb_wait(")
            emit_expr(c, n.kids[0])
            put(c, "))")
    else if k == "background"
        emit_background(c, n)
    else if k == "field" and is_cols_obj(c, n.kids[0].ty)
        // качество obj by columns: адрес ячейки в колонке
        put(c, "(*tb_colf_" + cols_name(c, n.kids[0].ty) + "_" + n.name + "(")
        emit_expr(c, n.kids[0])
        put(c, ", " + n.line + "))")
    else if k == "field"
        put(c, "((" + c_type(c, n.kids[0].ty) + ")tb_nn(")
        emit_expr(c, n.kids[0])
        put(c, ", " + n.line + "))" + field_path(c.types[n.kids[0].ty].obj_node, n.name))

// ---------- команды ----------

// что отдать, если функция ломается: обычный return с пустым значением
func emit_bail(c: Comp)
    f = c.cur_func
    outputs = f.kids[2]
    if f.name == "main"
        put(c, "tb_die(tb_err);")
    else if len(outputs.kids) == 1
        put(c, "return v_" + outputs.kids[0].name + ";")
    else if len(outputs.kids) > 1
        put(c, "return (" + c_type(c, f.ty) + "){")
        count i from 0 to len(outputs.kids) - 1
            if i > 0
                put(c, ", ")
            put(c, "v_" + outputs.kids[i].name)
        put(c, "};")
    else if kind_of(c, f.ty) == "none"
        put(c, "return;")
    else
        put(c, "return ")
        emit_default(c, f.ty)
        put(c, ";")

// try f()  и  f() else err: вызов отдельной строкой, потом проверка tb_err
func emit_pre(c: Comp, v: Node, depth: int)
    if v.kind != "try" and v.kind != "else_err"
        return
    call = v.kids[0]
    c.label += 1
    v.temp_no = c.label
    indent(c, depth)
    if kind_of(c, call.ty) != "none"
        put(c, c_type(c, call.ty) + " tb_v" + c.label + " = ")
    emit_expr(c, call)
    put(c, ";\n")
    indent(c, depth)
    if v.kind == "try"
        put(c, "if (TB_RARE(tb_err != 0)) { ")
        emit_bail(c)
        put(c, " }\n")
        return
    put(c, "if (tb_err != 0) {\n")
    indent(c, depth + 1)
    put(c, "const char * const v_" + v.name + " = tb_err;\n")
    indent(c, depth + 1)
    put(c, "tb_err = 0;\n")
    emit_block(c, v.kids[1], depth + 1)
    indent(c, depth)
    put(c, "}\n")

// цель для  =  и  +=: у dict ключ создаётся, если его нет
func emit_target(c: Comp, t: Node)
    if t.kind == "index" and kind_of(c, t.kids[0].ty) == "dict"
        d = t.kids[0].ty
        elem = c.types[d].elem
        vt = c_type(c, elem)
        put(c, "(*(" + vt + " *)tb_dput(")
        emit_expr(c, t.kids[0])
        put(c, ", ")
        emit_key(c, d, t.kids[1])
        if is_simple(c, elem)
            put(c, ", &(" + vt + "){")
            emit_default(c, elem)
            put(c, "}))")
        else
            put(c, ", 0))")
        return
    emit_expr(c, t)

// список int по 4 байта на число (int в C): все числа в нём доказанно в пределах ±2 147 483 647
func is_narrow(c: Comp, n: Node)
    return n.kind == "name" and has_text(c.narrow, n.name)

// какие списки этой функции можно хранить по 4 байта: создаются пустыми (xs = list int),
// дальше только add, xs[i] = ..., xs[i] и len — и все числа в коробке 32 бит
func find_narrow(c: Comp, f: Node, n: Node)
    if n.kind == "assign" and n.creates and len(n.kids) == 0 and kind_of(c, n.ty) == "list" and c.types[n.ty].elem == 1 and not has_text(c.narrow, n.name)
        hl, lo, hh, hi = seal_range(c, f, n.name)
        if hl and hh and lo >= -2147483647 and hi <= 2147483647
            c.narrow.add(n.name)
    each kid in n.kids
        find_narrow(c, f, kid)

func emit_assign(c: Comp, n: Node, depth: int)
    if len(n.kids) == 1
        emit_pre(c, n.kids[0], depth)
    indent(c, depth)
    bld = not n.is_link and kind_of(c, n.ty) == "text" and bld_has(c.builders, n.name)
    if bld and not n.creates and len(n.kids) == 1 and app_form(c, n.name, n.kids[0])
        // s = s + a + b: дописать a и b в конец s
        each part in app_parts(c, n.kids[0])
            emit_app(c, n.name, part)
            put(c, " ")
        put(c, "\n")
        return
    if n.creates
        put(c, c_type(c, n.ty) + " ")
        if n.is_const
            put(c, "const ")
        put(c, "v_" + n.name + " = ")
    else if n.is_link
        put(c, "(*v_" + n.name + ") = ")
    else
        put(c, "v_" + n.name + " = ")
    if len(n.kids) == 1
        emit_as(c, n.kids[0], n.ty)
    else if has_text(c.narrow, n.name) and kind_of(c, n.ty) == "list" and c.types[n.ty].elem == 1
        put(c, "tb_list_new_np(sizeof(int))")
    else
        emit_default(c, n.ty)
    put(c, ";")
    if bld
        // новый текст: своей памяти у s пока нет
        put(c, " tb_rl_" + n.name + " = -1;")
    put(c, "\n")

// цель = значение: сначала значение, потом адрес цели (значение может менять список)
func emit_set(c: Comp, n: Node, depth: int)
    target = n.kids[0]
    value = n.kids[1]
    op = n.value
    t = c_type(c, n.ty)
    if target.kind == "index" and is_narrow(c, target.kids[0])
        t = "int"
    emit_pre(c, value, depth)
    c.label += 1
    id = "" + c.label
    indent(c, depth)
    put(c, "{ ")
    if target.kind == "index" and is_cols_list(c, target.kids[0].ty)
        // pts[i] = p: качества p копируются в колонки
        put(c, t + " tb_v" + id + " = ")
        emit_expr(c, value)
        put(c, "; tb_colset_" + cols_name(c, target.kids[0].ty) + "(")
        emit_expr(c, target.kids[0])
        put(c, ", ")
        emit_expr(c, target.kids[1])
        put(c, ", tb_v" + id + ", " + n.line + "); }\n")
        return
    if target.kind == "index" and is_bits(c, target.kids[0].ty) and op == "="
        // flags[i] = v: поставить или снять один бит
        put(c, "_Bool tb_v" + id + " = ")
        emit_expr(c, value)
        put(c, "; tb_bset(")
        emit_expr(c, target.kids[0])
        put(c, ", ")
        emit_expr(c, target.kids[1])
        put(c, ", tb_v" + id + ", " + n.line + "); }\n")
        return
    if op == "+=" and is_bld(c, target) and is_text_plus(c, value) and not bld_uses(value, target.name)
        // s += a + b: дописать a, потом b — без промежуточного текста a + b
        put(c, "} ")
        r = value
        repeat while is_text_plus(c, r)
            r = r.kids[0]
        emit_app(c, target.name, r)
        each part in app_parts(c, value)
            put(c, " ")
            emit_app(c, target.name, part)
        put(c, "\n")
        return
    if op == "+=" and is_bld(c, target)
        // s += x: дописать x в конец s
        put(c, "const char *tb_v" + id + " = ")
        emit_as_text(c, value)
        put(c, "; tb_app(&v_" + target.name + ", &tb_rl_" + target.name + ", &tb_rc_" + target.name + ", tb_v" + id + "); }\n")
        return
    if kind_of(c, n.ty) == "text" and op != "="
        put(c, "const char *tb_v" + id + " = ")
        emit_as_text(c, value)
    else
        if op == "="
            put(c, t + " tb_v" + id + " = ")
            emit_as(c, value, n.ty)
        else
            put(c, c_type(c, value.ty) + " tb_v" + id + " = ")
            emit_expr(c, value)
    put(c, "; " + t + " *tb_p" + id + " = &(")
    emit_target(c, target)
    put(c, "); ")
    if op == "="
        put(c, "*tb_p" + id + " = tb_v" + id + ";")
    else if kind_of(c, n.ty) == "text"
        put(c, "*tb_p" + id + " = tb_cat(*tb_p" + id + ", tb_v" + id + ");")
    else if kind_of(c, n.ty) == "int" and op == "/="
        put(c, "*tb_p" + id + " = tb_div(*tb_p" + id + ", tb_v" + id + ", " + n.line + ");")
    else
        put(c, "*tb_p" + id + " " + op + " tb_v" + id + ";")
    put(c, " }\n")

func emit_multi(c: Comp, n: Node, depth: int)
    names = len(n.kids) - 1
    call = n.kids[names]
    emit_pre(c, call, depth)
    c.label += 1
    id = "" + c.label
    count i from 0 to names - 1
        if n.kids[i].creates
            indent(c, depth)
            put(c, c_type(c, n.kids[i].ty) + " v_" + n.kids[i].name + ";\n")
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    put(c, c_type(c, call.ty) + " tb_m" + id + " = ")
    emit_expr(c, call)
    put(c, ";\n")
    count i from 0 to names - 1
        indent(c, depth + 1)
        emit_expr(c, n.kids[i])
        put(c, " = tb_m" + id + ".o" + i + ";\n")
    indent(c, depth)
    put(c, "}\n")

func emit_if(c: Comp, n: Node, depth: int)
    indent(c, depth)
    i = 0
    repeat while i + 1 < len(n.kids)
        if i > 0
            put(c, " else ")
        put(c, "if (")
        emit_expr(c, n.kids[i])
        put(c, ") {\n")
        emit_block(c, n.kids[i + 1], depth + 1)
        indent(c, depth)
        put(c, "}")
        i += 2
    if len(n.kids) % 2 == 1
        put(c, " else {\n")
        emit_block(c, n.kids[len(n.kids) - 1], depth + 1)
        indent(c, depth)
        put(c, "}")
    put(c, "\n")

// each / count ... on all cores:
// тело цикла уходит в отдельную функцию-работника tb_workN, её запускают все ядра.
// Переменные снаружи передаются в tb_jobN; у shared у каждого ядра свой «листок».
func emit_par(c: Comp, n: Node, depth: int)
    c.label += 1
    id = "" + c.label
    is_each = n.kind == "each"
    elem = ""
    if is_each
        elem = c_type(c, c.types[n.kids[0].ty].elem)
    // 1) работник: пишется в отдельный кусок, потом встанет перед функциями
    saved = c.out
    w = list text
    c.out = w
    list_type = "tb_list *"
    if is_each
        list_type = c_type(c, n.kids[0].ty)
    put(c, "\ntypedef struct {\n    long long tb_lo, tb_total, tb_step, tb_next;\n    " + list_type + " tb_l;\n")
    each v in n.caps
        if v.is_shared and kind_of(c, v.type) == "text"
            // общий текст, куда ядра по очереди дописывают свои куски
            put(c, "    const char *m_" + v.name + "; long long m_rl_" + v.name + ", m_rc_" + v.name + ";\n")
        else if v.is_shared
            put(c, "    " + c_type(c, v.type) + " *p_" + v.name + ";\n")
        else if v.is_link
            put(c, "    " + c_type(c, v.type) + " *v_" + v.name + ";\n")
        else
            put(c, "    " + c_type(c, v.type) + " v_" + v.name + ";\n")
    put(c, "} tb_job" + id + ";\n")
    put(c, "TB_API void *tb_work" + id + "(void *tb_arg) {\n")
    put(c, "    tb_job" + id + " *tb_j = tb_arg;\n")
    has_shared = false
    // shared text: у каждого ядра свой текст с запасом, += дописывает в его конец
    saved_builders = c.builders
    par_builders = list text
    each v in n.caps
        if v.is_shared
            has_shared = true
            put(c, "    " + c_type(c, v.type) + " v_" + v.name + " = ")
            emit_default(c, v.type)
            put(c, ";\n")
            if kind_of(c, v.type) == "text"
                par_builders.add(v.name)
                put(c, "    long long tb_rl_" + v.name + " = -1, tb_rc_" + v.name + " = 0;\n")
        else if v.is_link
            put(c, "    " + c_type(c, v.type) + " *v_" + v.name + " = tb_j->v_" + v.name + ";\n")
        else
            put(c, "    " + c_type(c, v.type) + " v_" + v.name + " = tb_j->v_" + v.name + ";\n")
    c.builders = par_builders
    put(c, "    for (;;) {\n")
    put(c, "        long long tb_s = __atomic_fetch_add(&tb_j->tb_next, tb_j->tb_step, __ATOMIC_RELAXED);\n")
    put(c, "        if (tb_s >= tb_j->tb_total) break;\n")
    put(c, "        long long tb_e = tb_s + tb_j->tb_step;\n")
    put(c, "        if (tb_e > tb_j->tb_total) tb_e = tb_j->tb_total;\n")
    put(c, "        for (long long tb_i = tb_s; tb_i < tb_e; tb_i++) {\n")
    if is_each and is_cols_list(c, n.kids[0].ty)
        put(c, "            " + elem + " const v_" + n.name + " = {tb_j->tb_l, tb_i};\n")
        emit_block(c, n.kids[1], 3)
    else if is_each and is_bits(c, n.kids[0].ty)
        put(c, "            _Bool const v_" + n.name + " = TB_BIT(tb_j->tb_l, tb_i);\n")
        emit_block(c, n.kids[1], 3)
    else if is_each
        put(c, "            " + elem + " const v_" + n.name + " = ((" + elem + " *)tb_j->tb_l->data)[tb_i];\n")
        emit_block(c, n.kids[1], 3)
    else
        put(c, "            long long const v_" + n.name + " = tb_j->tb_lo + tb_i;\n")
        emit_block(c, n.kids[2], 3)
    put(c, "        }\n    }\n")
    c.builders = saved_builders
    if has_shared
        // ядра по очереди кладут своё в общее: число прибавляется, текст дописывается
        put(c, "    pthread_mutex_lock(&tb_par_lock);\n")
        each v in n.caps
            if v.is_shared and kind_of(c, v.type) == "text"
                put(c, "    tb_app_take(&tb_j->m_" + v.name + ", &tb_j->m_rl_" + v.name + ", &tb_j->m_rc_" + v.name + ", v_" + v.name + ", tb_rl_" + v.name + ", tb_rc_" + v.name + ");\n")
            else if v.is_shared
                put(c, "    *tb_j->p_" + v.name + " += v_" + v.name + ";\n")
        put(c, "    pthread_mutex_unlock(&tb_par_lock);\n")
    put(c, "    return 0;\n}\n")
    c.workers.add(join(w, ""))
    c.out = saved
    // 2) на месте цикла: заполнить tb_jobN и запустить ядра
    j = "tb_j" + id
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    put(c, "tb_job" + id + " " + j + " = {0};\n")
    indent(c, depth + 1)
    if is_each
        put(c, j + ".tb_l = ")
        emit_expr(c, n.kids[0])
        put(c, ";\n")
        indent(c, depth + 1)
        put(c, j + ".tb_total = " + j + ".tb_l->len;\n")
    else
        put(c, "long long tb_end" + id + " = ")
        emit_expr(c, n.kids[1])
        put(c, ";\n")
        indent(c, depth + 1)
        put(c, j + ".tb_lo = ")
        emit_expr(c, n.kids[0])
        put(c, ";\n")
        indent(c, depth + 1)
        put(c, j + ".tb_total = tb_end" + id + " < " + j + ".tb_lo ? 0 : tb_end" + id + " - " + j + ".tb_lo + 1;\n")
    each v in n.caps
        indent(c, depth + 1)
        if v.is_shared and kind_of(c, v.type) == "text"
            put(c, j + ".m_" + v.name + " = v_" + v.name + "; " + j + ".m_rl_" + v.name + " = -1;\n")
        else if v.is_shared
            put(c, j + ".p_" + v.name + " = &v_" + v.name + ";\n")
        else
            put(c, j + ".v_" + v.name + " = v_" + v.name + ";\n")
    indent(c, depth + 1)
    put(c, j + ".tb_step = tb_par_step(" + j + ".tb_total);\n")
    indent(c, depth + 1)
    put(c, "tb_par_run(tb_work" + id + ", &" + j + ", " + j + ".tb_total);\n")
    each v in n.caps
        if v.is_shared and kind_of(c, v.type) == "text"
            indent(c, depth + 1)
            put(c, "v_" + v.name + " = " + j + ".m_" + v.name + ";\n")
    indent(c, depth)
    put(c, "}\n")

func vec_index(c: Comp, name: text)
    count i from 0 to len(c.vec_names) - 1
        if c.vec_names[i] == name
            return i
    return -1

// each x in nums by vec: 8 независимых копилок вместо одной.
// Так процессор считает 8 чисел сразу (SIMD), а не ждёт каждое сложение.
func emit_vec(c: Comp, n: Node, depth: int)
    c.label += 1
    id = "" + c.label
    elem = c_type(c, c.types[n.kids[0].ty].elem)
    d = depth + 1
    indent(c, depth)
    put(c, "{\n")
    indent(c, d)
    put(c, "tb_list *tb_l" + id + " = ")
    emit_expr(c, n.kids[0])
    put(c, ";\n")
    indent(c, d)
    put(c, elem + " *tb_d" + id + " = (" + elem + " *)tb_l" + id + "->data;\n")
    indent(c, d)
    put(c, "long long tb_n" + id + " = tb_l" + id + "->len, tb_i" + id + " = 0;\n")
    // 8 отдельных копилок-переменных: компилятор C держит их в регистрах,
    // и процессор складывает 8 цепочек одновременно (ILP + SIMD)
    each v in n.caps
        if v.is_shared
            indent(c, d)
            put(c, c_type(c, v.type) + " ")
            count k from 0 to 7
                if k > 0
                    put(c, ", ")
                put(c, "tb_a" + id + "_" + v.name + "_" + k + " = 0")
            put(c, ";\n")
    // 1) по 8 чисел: тело цикла написано 8 раз подряд, без внутреннего цикла
    indent(c, d)
    put(c, "for (; tb_i" + id + " + 8 <= tb_n" + id + "; tb_i" + id + " += 8) {\n")
    // каждая копия в do { } while (0): skip внутри (continue) заканчивает только эту копию
    count k from 0 to 7
        indent(c, d + 1)
        put(c, "do {\n")
        indent(c, d + 2)
        put(c, elem + " const v_" + n.name + " = tb_d" + id + "[tb_i" + id + " + " + k + "];\n")
        each v in n.caps
            if v.is_shared
                c.vec_names.add(v.name)
                c.vec_repl.add("tb_a" + id + "_" + v.name + "_" + k)
        emit_block(c, n.kids[1], d + 2)
        fresh_names = list text
        fresh_repl = list text
        c.vec_names = fresh_names
        c.vec_repl = fresh_repl
        indent(c, d + 1)
        put(c, "} while (0);\n")
    indent(c, d)
    put(c, "}\n")
    // 2) хвост: последние 0–7 чисел по одному
    indent(c, d)
    put(c, "for (; tb_i" + id + " < tb_n" + id + "; tb_i" + id + "++) {\n")
    indent(c, d + 1)
    put(c, elem + " const v_" + n.name + " = tb_d" + id + "[tb_i" + id + "];\n")
    each v in n.caps
        if v.is_shared
            c.vec_names.add(v.name)
            c.vec_repl.add("tb_a" + id + "_" + v.name + "_0")
    emit_block(c, n.kids[1], d + 1)
    fresh_names2 = list text
    fresh_repl2 = list text
    c.vec_names = fresh_names2
    c.vec_repl = fresh_repl2
    indent(c, d)
    put(c, "}\n")
    // 3) сложить копилки парами (как дерево), чтобы и тут не ждать друг друга
    each v in n.caps
        if v.is_shared
            target = "v_" + v.name
            if v.is_link
                target = "(*v_" + v.name + ")"
            a = "tb_a" + id + "_" + v.name + "_"
            indent(c, d)
            put(c, target + " += ((" + a + "0 + " + a + "1) + (" + a + "2 + " + a + "3)) + ((" + a + "4 + " + a + "5) + (" + a + "6 + " + a + "7));\n")
    indent(c, depth)
    put(c, "}\n")

func emit_each(c: Comp, n: Node, depth: int)
    if n.by_vec
        emit_vec(c, n, depth)
        return
    if n.is_par
        emit_par(c, n, depth)
        return
    if n.by_piece
        emit_pieces(c, n, depth)
        return
    c.label += 1
    id = "" + c.label
    t = n.kids[0].ty
    k = kind_of(c, t)
    elem_ty = -1
    if k == "channel"
        // each x in ch: берём, пока канал не закрыт и не пуст
        elem = c_type(c, c.types[t].elem)
        indent(c, depth)
        put(c, "{\n")
        indent(c, depth + 1)
        put(c, "tb_chan * tb_l" + id + " = ")
        emit_expr(c, n.kids[0])
        put(c, ";\n")
        indent(c, depth + 1)
        put(c, "for (;;) {\n")
        indent(c, depth + 2)
        put(c, elem + " v_" + n.name + ";\n")
        indent(c, depth + 2)
        put(c, "if (!tb_chan_take(tb_l" + id + ", &v_" + n.name + ")) break;\n")
        emit_loop_body(c, n.kids[1], depth + 2)
        indent(c, depth + 1)
        put(c, "}\n")
        indent(c, depth)
        put(c, "}\n")
        return
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    if k == "dict"
        put(c, "tb_list * tb_l" + id + " = (")
        emit_expr(c, n.kids[0])
        put(c, ")->keys;\n")
        k = "list"
        elem_ty = c.types[t].key
    else
        put(c, c_type(c, t) + " tb_l" + id + " = ")
        emit_expr(c, n.kids[0])
        put(c, ";\n")
        if k == "list"
            elem_ty = c.types[t].elem
    indent(c, depth + 1)
    if k == "text"
        put(c, "for (long long tb_i" + id + " = 0; tb_l" + id + "[tb_i" + id + "] != 0; tb_i" + id + "++) {\n")
        indent(c, depth + 2)
        put(c, "const char * const v_" + n.name + " = tb_chr((unsigned char)tb_l" + id + "[tb_i" + id + "]);\n")
    else
        elem = c_type(c, elem_ty)
        put(c, "for (long long tb_i" + id + " = 0; tb_i" + id + " < tb_l" + id + "->len; tb_i" + id + "++) {\n")
        indent(c, depth + 2)
        if is_cols_obj(c, elem_ty)
            put(c, elem + " const v_" + n.name + " = {tb_l" + id + ", tb_i" + id + "};\n")
        else if elem_ty == 3
            put(c, "_Bool const v_" + n.name + " = TB_BIT(tb_l" + id + ", tb_i" + id + ");\n")
        else
            put(c, elem + " const v_" + n.name + " = ((" + elem + " *)tb_l" + id + "->data)[tb_i" + id + "];\n")
            emit_prefetch(c, n, depth + 2, "tb_l" + id, "tb_i" + id, elem)
    emit_loop_body(c, n.kids[1], depth + 2)
    indent(c, depth + 1)
    put(c, "}\n")
    indent(c, depth)
    put(c, "}\n")

// each piece in data by 64:
//   piece — окно в data (свои data и len, cap = -1: растить нельзя);
//   пока цикл идёт, у data cap < 0, и data.add() остановит программу,
//   а следующий кусок заранее просим у памяти (__builtin_prefetch)
func emit_pieces(c: Comp, n: Node, depth: int)
    c.label += 1
    id = "" + c.label
    l = "tb_l" + id
    i = "tb_i" + id
    p = "tb_p" + id
    m = "tb_n" + id
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    put(c, "tb_list *" + l + " = ")
    emit_expr(c, n.kids[0])
    put(c, ";\n")
    indent(c, depth + 1)
    put(c, "long long " + m + " = ")
    emit_expr(c, n.piece_size)
    put(c, ";\n")
    indent(c, depth + 1)
    put(c, "if (" + m + " <= 0) tb_crash(" + n.line + ", \"размер куска в by должен быть больше 0\");\n")
    indent(c, depth + 1)
    put(c, "tb_list " + p + " = {0, 0, -1, " + l + "->size};\n")
    indent(c, depth + 1)
    put(c, "long long tb_cap" + id + " = " + l + "->cap;\n")
    indent(c, depth + 1)
    put(c, "if (" + l + "->cap >= 0) " + l + "->cap = -2;\n")
    indent(c, depth + 1)
    put(c, "for (long long " + i + " = 0; " + i + " < " + l + "->len; " + i + " += " + m + ") {\n")
    indent(c, depth + 2)
    put(c, p + ".data = " + l + "->data + " + i + " * " + l + "->size;\n")
    indent(c, depth + 2)
    put(c, p + ".len = " + l + "->len - " + i + " < " + m + " ? " + l + "->len - " + i + " : " + m + ";\n")
    indent(c, depth + 2)
    put(c, "if (" + i + " + " + m + " < " + l + "->len) __builtin_prefetch(" + p + ".data + " + m + " * " + l + "->size);\n")
    indent(c, depth + 2)
    put(c, "tb_list * const v_" + n.name + " = &" + p + ";\n")
    emit_block(c, n.kids[1], depth + 2)
    indent(c, depth + 1)
    put(c, "}\n")
    indent(c, depth + 1)
    put(c, l + "->cap = tb_cap" + id + ";\n")
    indent(c, depth)
    put(c, "}\n")

// a = background f(x, y):
//   tb_bgN(x, y) кладёт значения в свою коробку (память с уборкой) и запускает поток,
//   поток зовёт f и кладёт ответ в ту же коробку; a.wait ждёт поток и берёт ответ
func emit_background(c: Comp, n: Node)
    c.label += 1
    id = "" + c.label
    call = n.kids[0]
    f = call.ref
    params = f.kids[0]
    rt = f.ty
    if rt < 0
        rt = 0
    saved = c.out
    w = list text
    c.out = w
    put(c, "\ntypedef struct {\n    tb_task tb_t;\n")
    if rt != 0
        put(c, "    " + c_type(c, rt) + " tb_r;\n")
    count i from 0 to len(params.kids) - 1
        put(c, "    " + c_type(c, params.kids[i].ty) + " a" + i + ";\n")
    put(c, "} tb_bgjob" + id + ";\n")
    put(c, "TB_API void *tb_bgrun" + id + "(void *tb_arg) {\n    tb_bgjob" + id + " *tb_j = tb_arg;\n    ")
    if rt != 0
        put(c, "tb_j->tb_r = ")
    put(c, fname(f) + "(")
    count i from 0 to len(params.kids) - 1
        if i > 0
            put(c, ", ")
        put(c, "tb_j->a" + i)
    put(c, ");\n    return 0;\n}\n")
    put(c, "TB_API tb_task *tb_bg" + id + "(")
    count i from 0 to len(params.kids) - 1
        if i > 0
            put(c, ", ")
        put(c, c_type(c, params.kids[i].ty) + " a" + i)
    if len(params.kids) == 0
        put(c, "void")
    put(c, ") {\n    tb_bgjob" + id + " *tb_j = tb_gc_alloc(sizeof(tb_bgjob" + id + "));\n")
    put(c, "    if (tb_j == 0) tb_crash(0, \"не хватило памяти\");\n")
    count i from 0 to len(params.kids) - 1
        put(c, "    tb_j->a" + i + " = a" + i + ";\n")
    if rt != 0
        put(c, "    tb_j->tb_t.res = &tb_j->tb_r;\n")
    else
        put(c, "    tb_j->tb_t.res = 0;\n")
    put(c, "    tb_task_start(&tb_j->tb_t, tb_bgrun" + id + ", tb_j);\n    return &tb_j->tb_t;\n}\n")
    c.out = saved
    c.workers.add(join(w, ""))
    put(c, "tb_bg" + id + "(")
    count i from 0 to len(call.kids) - 1
        if i > 0
            put(c, ", ")
        emit_as(c, call.kids[i].kids[0], params.kids[i].ty)
    put(c, ")")

// значение, которое можно посчитать лишний раз раньше времени: ничего не меняет и не падает
func is_pure(n: Node)
    k = n.kind
    if k == "number" or k == "decimal" or k == "string" or k == "bool" or k == "name"
        return true
    if k == "field" or k == "unary"
        return is_pure(n.kids[0])
    if k == "binop"
        if n.value == "/" or n.value == "%"
            return false
        return is_pure(n.kids[0]) and is_pure(n.kids[1])
    return false

// together: три шага вместо очереди.
//   1) для каждого d[key] считаем место в таблице и просим память принести его;
//   2) когда места приехали, просим принести сами ключи и значения;
//   3) обычные строки — к этому времени всё уже в кэше.
// Пока одна строка ждала бы память, запросы остальных уже в пути.
func emit_together(c: Comp, n: Node, depth: int)
    c.label += 1
    id = "" + c.label
    block = n.kids[0]
    count j from 0 to len(block.kids) - 1
        v = block.kids[j].kids[0]
        if v.kind != "index" or not is_pure(v.kids[0]) or not is_pure(v.kids[1])
            skip
        indent(c, depth)
        if kind_of(c, v.kids[0].ty) == "dict"
            put(c, "unsigned long long tb_h" + id + "_" + j + " = tb_dpre1(")
            emit_expr(c, v.kids[0])
            put(c, ", ")
            emit_key(c, v.kids[0].ty, v.kids[1])
            put(c, ");\n")
        else if is_list(c, v.kids[0].ty) and not is_cols_list(c, v.kids[0].ty)
            put(c, "tb_lpre(")
            emit_expr(c, v.kids[0])
            put(c, ", ")
            emit_expr(c, v.kids[1])
            put(c, ");\n")
        else
            put(c, ";\n")
    count j from 0 to len(block.kids) - 1
        v = block.kids[j].kids[0]
        if v.kind != "index" or not is_pure(v.kids[0]) or not is_pure(v.kids[1])
            skip
        if kind_of(c, v.kids[0].ty) == "dict"
            indent(c, depth)
            put(c, "tb_dpre2(")
            emit_expr(c, v.kids[0])
            put(c, ", tb_h" + id + "_" + j + ");\n")
    each s in block.kids
        emit_statement(c, s, depth)

// заказ наперёд на 16 шагов: следующий номер берём из плана (список, по которому идёт цикл,
// или idx в data[idx[i]]) и просим память принести data[номер] заранее.
// Если номер окажется за пределами — не страшно: подсказка памяти ничего не ломает.
func emit_prefetch(c: Comp, n: Node, depth: int, list_c: text, i_c: text, elem: text)
    count j from 0 to len(n.pre_bases) - 1
        c.label += 1
        f = "tb_f" + c.label
        plan = list_c
        indent(c, depth)
        if n.pre_idx[j].kind == "name"
            put(c, "{ tb_list *tb_q" + c.label + " = ")
            emit_expr(c, n.pre_idx[j])
            put(c, "; ")
            plan = "tb_q" + c.label
        else
            put(c, "{ ")
        put(c, "if ((unsigned long long)(" + i_c + " + 16) < (unsigned long long)" + plan + "->len) { ")
        el = elem
        if n.pre_idx[j].kind == "name"
            el = c_type(c, c.types[n.pre_idx[j].ty].elem)
            if is_narrow(c, n.pre_idx[j])
                el = "int"
        put(c, el + " " + f + " = ((" + el + " *)" + plan + "->data)[" + i_c + " + 16]; ")
        base = n.pre_bases[j]
        if kind_of(c, base.ty) == "dict"
            put(c, "(void)tb_dpre1(")
            emit_expr(c, base)
            put(c, ", &" + f + "); } }\n")
        else
            put(c, "tb_lpre(")
            emit_expr(c, base)
            put(c, ", " + f + "); } }\n")

// короткий текст в кавычках (до 8 байт, без \): его можно сравнить побайтно
func short_literal(n: Node)
    if n.kind != "string" or len(n.value) < 2 or len(n.value) > 10
        return false
    each ch in n.value
        if ch == "\\"
            return false
    return true

// ---------- проверка границ один раз до цикла ----------
// count i from A to B, а в теле xs[i], xs[i + 1], xs[i - 1]: если список внутри не может
// стать короче, проверяем A и B один раз. Не прошло — тот же цикл с проверкой на каждом шаге,
// и ошибка будет в той же строке, что и раньше.

// номер в квадратных скобках: i, i + 3 или i - 3. Отдаёт сдвиг; ok = false, если не такой
func index_shift(n: Node, var_name: text) gives ok: bool, shift: int
    if n.kind == "name" and n.name == var_name
        ok = true
        return
    if n.kind == "binop" and (n.value == "+" or n.value == "-") and n.kids[0].kind == "name" and n.kids[0].name == var_name and n.kids[1].kind == "number"
        v = to_int(n.kids[1].value) or 1000000
        if v > 1000
            return
        ok = true
        shift = v
        if n.value == "-"
            shift = 0 - v

// можно ли этот список читать без проверки: обычный список (не текст, не биты, не колонки)
func plain_list_index(c: Comp, n: Node)
    if n.kind != "index" or n.kids[0].kind != "name"
        return false
    t = n.kids[0].ty
    return kind_of(c, t) == "list" and not is_bits(c, t) and not is_cols_list(c, t)

// ---------- «мяч в коробке» и «пломба»: в каких пределах лежит целое число ----------
// Пределы считаются по всей функции сразу: у переменной — все её значения из всех
// присваиваний, у списка («пломба») — все числа, которые в него кладут. Если хоть одно
// значение без пределов (параметр, x += 1, список ушёл в функцию) — пределов нет.
// Всё это только убирает проверку края, когда её можно доказать; иначе проверка остаётся.

func rg_ok(v: int)
    return v > -1000000000000 and v < 1000000000000

func rg_get(c: Comp, key: text) gives found: bool, hl: bool, lo: int, hh: bool, hi: int
    count j from 0 to len(c.rg_keys) - 1
        if c.rg_keys[j] == key
            found = true
            hl = c.rg_vals[j * 4] == 1
            lo = c.rg_vals[j * 4 + 1]
            hh = c.rg_vals[j * 4 + 2] == 1
            hi = c.rg_vals[j * 4 + 3]
            return

func rg_put(c: Comp, key: text, hl: bool, lo: int, hh: bool, hi: int)
    c.rg_keys.add(key)
    if hl
        c.rg_vals.add(1)
    else
        c.rg_vals.add(0)
    c.rg_vals.add(lo)
    if hh
        c.rg_vals.add(1)
    else
        c.rg_vals.add(0)
    c.rg_vals.add(hi)

func rg_busy_has(c: Comp, key: text)
    each x in c.rg_busy
        if x == key
            return true
    return false

func rg_busy_drop(c: Comp)
    keep = list text
    count j from 0 to len(c.rg_busy) - 2
        keep.add(c.rg_busy[j])
    c.rg_busy = keep

func expr_range(c: Comp, f: Node, n: Node) gives hl: bool, lo: int, hh: bool, hi: int
    if n.ty != 1
        return
    k = n.kind
    if k == "number"
        v = to_int(n.value) else err
            return
        hl = true
        lo = v
        hh = true
        hi = v
    else if k == "name"
        hl, lo, hh, hi = var_range(c, f, n.name)
    else if k == "unary" and n.value == "-"
        al, a_lo, ah, a_hi = expr_range(c, f, n.kids[0])
        hl = ah
        lo = 0 - a_hi
        hh = al
        hi = 0 - a_lo
    else if k == "binop"
        al, a_lo, ah, a_hi = expr_range(c, f, n.kids[0])
        bl, b_lo, bh, b_hi = expr_range(c, f, n.kids[1])
        if n.value == "+"
            hl = al and bl
            lo = a_lo + b_lo
            hh = ah and bh
            hi = a_hi + b_hi
        else if n.value == "-"
            hl = al and bh
            lo = a_lo - b_hi
            hh = ah and bl
            hi = a_hi - b_lo
        else if n.value == "*" and al and ah and bl and bh and a_lo >= 0 and b_lo >= 0 and a_hi < 1000000 and b_hi < 1000000
            hl = true
            lo = a_lo * b_lo
            hh = true
            hi = a_hi * b_hi
        else if (n.value == "/" or n.value == "%") and al and a_lo >= 0 and bl and bh and b_lo == b_hi and b_lo > 0
            if n.value == "%"
                hl = true
                lo = 0
                hh = true
                hi = b_lo - 1
            else
                hl = true
                lo = a_lo / b_lo
                hh = ah
                hi = a_hi / b_lo
    else if k == "call" and not n.has_ref and (n.name == "max" or n.name == "min") and len(n.kids) == 2
        al, a_lo, ah, a_hi = expr_range(c, f, n.kids[0].kids[0])
        bl, b_lo, bh, b_hi = expr_range(c, f, n.kids[1].kids[0])
        if n.name == "max"
            // max не меньше каждого: хватит одного известного низа
            if al or bl
                hl = true
                lo = a_lo
                if not al or (bl and b_lo > a_lo)
                    lo = b_lo
            hh = ah and bh
            hi = max(a_hi, b_hi)
        else
            if ah or bh
                hh = true
                hi = a_hi
                if not ah or (bh and b_hi < a_hi)
                    hi = b_hi
            hl = al and bl
            lo = min(a_lo, b_lo)
    else if k == "call" and not n.has_ref and n.name == "len"
        hl = true
        lo = 0
    else if k == "call" and n.has_ref and n.ref.kind == "func"
        hl, lo, hh, hi = func_range(c, n.ref)
    else if k == "index" and n.kids[0].kind == "name" and kind_of(c, n.kids[0].ty) == "list" and not is_bits(c, n.kids[0].ty)
        hl, lo, hh, hi = seal_range(c, f, n.kids[0].name)
    if hl and not rg_ok(lo)
        hl = false
    if hh and not rg_ok(hi)
        hh = false

// объединить пределы: новое значение расширяет коробку
func rg_union(first: bool, hl: bool, lo: int, hh: bool, hi: int, bl: bool, b_lo: int, bh: bool, b_hi: int) gives rl: bool, r_lo: int, rh: bool, r_hi: int
    if first
        rl = bl
        r_lo = b_lo
        rh = bh
        r_hi = b_hi
        return
    rl = hl and bl
    r_lo = min(lo, b_lo)
    rh = hh and bh
    r_hi = max(hi, b_hi)

func is_param(f: Node, name: text)
    each p in f.kids[0].kids
        if p.name == name
            return true
    return false

func is_global(c: Comp, name: text)
    each g in c.globals
        if g.name == name
            return true
    return false

// имя где-то внутри (для ярлыков и link-аргументов)
func mentions(n: Node, name: text)
    if n.kind == "name" and n.name == name
        return true
    each kid in n.kids
        if mentions(kid, name)
            return true
    return false

// пределы переменной: все её значения в функции
func var_range(c: Comp, f: Node, name: text) gives hl: bool, lo: int, hh: bool, hi: int
    key = f.name + ":" + f.line + ":" + name
    found, gl, g_lo, gh, g_hi = rg_get(c, key)
    if found
        hl = gl
        lo = g_lo
        hh = gh
        hi = g_hi
        return
    if rg_busy_has(c, key) or is_param(f, name) or is_global(c, name)
        return
    c.rg_busy.add(key)
    any = false
    bad = false
    hl, lo, hh, hi, any, bad = var_scan(c, f, f.kids[1], name, hl, lo, hh, hi, any, bad)
    rg_busy_drop(c)
    if bad or not any
        hl = false
        hh = false
    rg_put(c, key, hl, lo, hh, hi)

func var_scan(c: Comp, f: Node, n: Node, name: text, hl0: bool, lo0: int, hh0: bool, hi0: int, any0: bool, bad0: bool) gives hl: bool, lo: int, hh: bool, hi: int, any: bool, bad: bool
    hl = hl0
    lo = lo0
    hh = hh0
    hi = hi0
    any = any0
    bad = bad0
    if bad
        return
    k = n.kind
    if k == "assign" and n.name == name
        if len(n.kids) == 0
            hl, lo, hh, hi = rg_union(not any, hl, lo, hh, hi, true, 0, true, 0)
        else
            bl, b_lo, bh, b_hi = expr_range(c, f, n.kids[0])
            hl, lo, hh, hi = rg_union(not any, hl, lo, hh, hi, bl, b_lo, bh, b_hi)
        any = true
    else if k == "count" and n.name == name
        bl, b_lo, x1, x2 = expr_range(c, f, n.kids[0])
        y1, y2, bh, b_hi = expr_range(c, f, n.kids[1])
        hl, lo, hh, hi = rg_union(not any, hl, lo, hh, hi, bl, b_lo, bh, b_hi)
        any = true
    else if (k == "set" and n.kids[0].kind == "name" and n.kids[0].name == name) or ((k == "each" or k == "else_err") and n.name == name)
        bad = true
        return
    else if k == "multi" or k == "linkdecl"
        if mentions(n, name)
            bad = true
            return
    else if k == "call" and n.has_ref and n.ref.kind == "func"
        // func f(link x): функция может поменять переменную
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link and mentions(n.kids[i], name)
                bad = true
                return
    each kid in n.kids
        hl, lo, hh, hi, any, bad = var_scan(c, f, kid, name, hl, lo, hh, hi, any, bad)

// пределы результата своей функции: все return с числом
func func_range(c: Comp, fn: Node) gives hl: bool, lo: int, hh: bool, hi: int
    key = "func:" + fn.name + ":" + fn.line
    found, gl, g_lo, gh, g_hi = rg_get(c, key)
    if found
        hl = gl
        lo = g_lo
        hh = gh
        hi = g_hi
        return
    if rg_busy_has(c, key) or len(fn.kids[2].kids) > 0
        return
    c.rg_busy.add(key)
    any = false
    bad = false
    hl, lo, hh, hi, any, bad = ret_scan(c, fn, fn.kids[1], hl, lo, hh, hi, any, bad)
    rg_busy_drop(c)
    if bad or not any
        hl = false
        hh = false
    rg_put(c, key, hl, lo, hh, hi)

func ret_scan(c: Comp, fn: Node, n: Node, hl0: bool, lo0: int, hh0: bool, hi0: int, any0: bool, bad0: bool) gives hl: bool, lo: int, hh: bool, hi: int, any: bool, bad: bool
    hl = hl0
    lo = lo0
    hh = hh0
    hi = hi0
    any = any0
    bad = bad0
    if bad
        return
    if n.kind == "return"
        if len(n.kids) == 0
            bad = true
            return
        bl, b_lo, bh, b_hi = expr_range(c, fn, n.kids[0])
        hl, lo, hh, hi = rg_union(not any, hl, lo, hh, hi, bl, b_lo, bh, b_hi)
        any = true
        return
    each kid in n.kids
        hl, lo, hh, hi, any, bad = ret_scan(c, fn, kid, hl, lo, hh, hi, any, bad)

// «пломба» на списке: пределы всех чисел, которые в него кладут.
// Список должен быть своим в функции (не параметр) и никуда не уходить.
func seal_range(c: Comp, f: Node, name: text) gives hl: bool, lo: int, hh: bool, hi: int
    key = f.name + ":" + f.line + ":[]" + name
    found, gl, g_lo, gh, g_hi = rg_get(c, key)
    if found
        hl = gl
        lo = g_lo
        hh = gh
        hi = g_hi
        return
    if rg_busy_has(c, key) or is_param(f, name) or is_global(c, name)
        return
    c.rg_busy.add(key)
    any = false
    bad = false
    hl, lo, hh, hi, any, bad = seal_scan(c, f, f.kids[1], name, hl, lo, hh, hi, any, bad)
    rg_busy_drop(c)
    if bad or not any
        hl = false
        hh = false
    rg_put(c, key, hl, lo, hh, hi)

func seal_scan(c: Comp, f: Node, n: Node, name: text, hl0: bool, lo0: int, hh0: bool, hi0: int, any0: bool, bad0: bool) gives hl: bool, lo: int, hh: bool, hi: int, any: bool, bad: bool
    hl = hl0
    lo = lo0
    hh = hh0
    hi = hi0
    any = any0
    bad = bad0
    if bad
        return
    k = n.kind
    is_me = len(n.kids) > 0 and n.kids[0].kind == "name" and n.kids[0].name == name
    if k == "assign" and n.name == name
        // только новый пустой список: xs = list int
        if len(n.kids) > 0
            bad = true
            return
    else if k == "method" and is_me
        if n.name != "add" or len(n.kids) != 2
            bad = true
            return
        bl, b_lo, bh, b_hi = expr_range(c, f, n.kids[1].kids[0])
        hl, lo, hh, hi = rg_union(not any, hl, lo, hh, hi, bl, b_lo, bh, b_hi)
        any = true
        each kid in n.kids[1].kids
            hl, lo, hh, hi, any, bad = seal_scan(c, f, kid, name, hl, lo, hh, hi, any, bad)
        return
    else if k == "set" and n.kids[0].kind == "index" and n.kids[0].kids[0].kind == "name" and n.kids[0].kids[0].name == name
        if n.value != "="
            bad = true
            return
        bl, b_lo, bh, b_hi = expr_range(c, f, n.kids[1])
        hl, lo, hh, hi = rg_union(not any, hl, lo, hh, hi, bl, b_lo, bh, b_hi)
        any = true
        hl, lo, hh, hi, any, bad = seal_scan(c, f, n.kids[0].kids[1], name, hl, lo, hh, hi, any, bad)
        hl, lo, hh, hi, any, bad = seal_scan(c, f, n.kids[1], name, hl, lo, hh, hi, any, bad)
        return
    else if k == "index" and is_me
        // читать можно; номер тоже смотрим
        hl, lo, hh, hi, any, bad = seal_scan(c, f, n.kids[1], name, hl, lo, hh, hi, any, bad)
        return
    else if k == "call" and not n.has_ref and n.name == "len" and len(n.kids) == 1 and n.kids[0].kids[0].kind == "name"
        return
    else if k == "name" and n.name == name
        // список ушёл куда-то целиком: в функцию, в другую переменную, в each ...
        bad = true
        return
    else if k == "linkdecl" and mentions(n, name)
        bad = true
        return
    else if k == "call" and n.has_ref and n.ref.kind == "func"
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link and mentions(n.kids[i], name)
                bad = true
                return
    each kid in n.kids
        hl, lo, hh, hi, any, bad = seal_scan(c, f, kid, name, hl, lo, hh, hi, any, bad)

func fast_index(c: Comp, n: Node)
    if c.fast_depth == 0 or not plain_list_index(c, n)
        return false
    each key in c.fast_lists
        cut_at = find(key, "\t")
        var_name = cut(key, 0, cut_at - 1)
        rest = cut(key, cut_at + 1, len(key) - 1)
        if var_name == "#"
            // номер в коробке: проверено до цикла, что список длиннее верхнего предела
            at2 = find(rest, "\t")
            if cut(rest, 0, at2 - 1) == n.kids[0].name
                top = to_int(cut(rest, at2 + 1, len(rest) - 1)) or -1
                hl, lo, hh, hi = expr_range(c, c.cur_func, n.kids[1])
                if hl and lo >= 0 and hh and hi <= top
                    return true
        else if rest == n.kids[0].name
            ok, shift = index_shift(n.kids[1], var_name)
            if ok
                return true
    return false

func has_index(n: Node)
    if n.kind == "index"
        return true
    each kid in n.kids
        if has_index(kid)
            return true
    return false

func has_text(names: list text, name: text)
    each x in names
        if x == name
            return true
    return false

// тело цикла не может укоротить список и сменить номер: нет вызовов своих функций,
// методов (.add, .remove ...), вложенных циклов, danger, background; список и номер не меняют
func fast_body_ok(c: Comp, n: Node, var_name: text, names: list text)
    k = n.kind
    if k == "method" or k == "danger" or k == "background" or k == "together" or k == "lock" or k == "linkdecl" or k == "multi" or k == "temp"
        return false
    if (k == "each" or k == "count") and (n.is_par or n.by_piece or n.by_vec)
        return false
    if k == "call" and n.name == "sort"
        return false
    // своя функция не дотянется до списка, если ей дают только числа и да/нет
    if k == "call" and n.has_ref
        if n.ref.kind != "func" and n.ref.kind != "obj"
            return false
        each arg in n.kids
            // у obj(...) поля без значения — пустые аргументы
            if len(arg.kids) == 0
                skip
            if not is_plain_ty(c, arg.kids[0].ty)
                return false
    if k == "assign" and (n.name == var_name or has_text(names, n.name))
        return false
    if k == "set" and n.kids[0].kind == "name" and (n.kids[0].name == var_name or has_text(names, n.kids[0].name))
        return false
    each kid in n.kids
        if not fast_body_ok(c, kid, var_name, names)
            return false
    return true

// все xs[i ± число] в теле: имена списков и самый малый и самый большой сдвиг у каждого
func fast_collect(c: Comp, n: Node, var_name: text, names: list text, nodes: list Node, lo: list int, hi: list int)
    if plain_list_index(c, n)
        ok, shift = index_shift(n.kids[1], var_name)
        if ok
            name = n.kids[0].name
            found = false
            count j from 0 to len(names) - 1
                if names[j] == name
                    found = true
                    lo[j] = min(lo[j], shift)
                    hi[j] = max(hi[j], shift)
            if not found
                names.add(name)
                nodes.add(n.kids[0])
                lo.add(shift)
                hi.add(shift)
        else if n.ty == 1 or n.ty == 2 or n.ty == 3
            // номер не от цикла, но в коробке: проверим один раз, что список длиннее верхнего предела
            hl, rlo, hh, rhi = expr_range(c, c.cur_func, n.kids[1])
            if hl and rlo >= 0 and hh
                key = "#" + n.kids[0].name
                found = false
                count j from 0 to len(names) - 1
                    if names[j] == key
                        found = true
                        hi[j] = max(hi[j], rhi)
                if not found
                    names.add(key)
                    nodes.add(n.kids[0])
                    lo.add(0)
                    hi.add(rhi)
    each kid in n.kids
        fast_collect(c, kid, var_name, names, nodes, lo, hi)

func emit_count(c: Comp, n: Node, depth: int)
    if n.is_par
        emit_par(c, n, depth)
        return
    if c.fast_depth < 2 and not c.bare
        names = list text
        nodes = list Node
        lo = list int
        hi = list int
        fast_collect(c, n.kids[2], n.name, names, nodes, lo, hi)
        // границы из списка (count p from starts[k] to ...): шагов обычно мало, проверка до цикла не окупится
        plain = list text
        each x in names
            if starts_with(x, "#")
                plain.add(cut(x, 1, len(x) - 1))
            else
                plain.add(x)
        if len(names) > 0 and not has_index(n.kids[0]) and not has_index(n.kids[1]) and fast_body_ok(c, n.kids[2], n.name, plain)
            emit_count_fast(c, n, depth, names, nodes, lo, hi)
            return
    c.label += 1
    id = "" + c.label
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    put(c, "long long tb_end" + id + " = ")
    emit_expr(c, n.kids[1])
    put(c, ";\n")
    indent(c, depth + 1)
    put(c, "for (long long v_" + n.name + " = ")
    emit_expr(c, n.kids[0])
    put(c, "; v_" + n.name + " <= tb_end" + id + "; v_" + n.name + "++) {\n")
    emit_prefetch(c, n, depth + 2, "", "v_" + n.name, "long long")
    emit_loop_body(c, n.kids[2], depth + 2)
    indent(c, depth + 1)
    put(c, "}\n")
    indent(c, depth)
    put(c, "}\n")

// два цикла: быстрый (границы проверены до него) и обычный, если проверка не прошла
func emit_count_fast(c: Comp, n: Node, depth: int, names: list text, nodes: list Node, lo: list int, hi: list int)
    c.label += 1
    id = "" + c.label
    v = "v_" + n.name
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    put(c, "long long tb_end" + id + " = ")
    emit_expr(c, n.kids[1])
    put(c, ";\n")
    indent(c, depth + 1)
    put(c, "long long tb_lo" + id + " = ")
    emit_expr(c, n.kids[0])
    put(c, ";\n")
    indent(c, depth + 1)
    put(c, "if (tb_end" + id + " < tb_lo" + id)
    put(c, " || (1")
    count j from 0 to len(names) - 1
        if starts_with(names[j], "#")
            put(c, " && (")
            emit_expr(c, nodes[j])
            put(c, ")->len > " + hi[j] + "LL")
        else
            put(c, " && tb_lo" + id + " >= " + (0 - lo[j]) + "LL && tb_end" + id + " < (")
            emit_expr(c, nodes[j])
            put(c, ")->len - " + hi[j] + "LL")
    put(c, ")) {\n")
    keep = list text
    each key in c.fast_lists
        keep.add(key)
    with_mine = list text
    each key in c.fast_lists
        with_mine.add(key)
    count j from 0 to len(names) - 1
        if starts_with(names[j], "#")
            with_mine.add("#\t" + cut(names[j], 1, len(names[j]) - 1) + "\t" + hi[j])
        else
            with_mine.add(n.name + "\t" + names[j])
    c.fast_lists = with_mine
    c.fast_depth += 1
    indent(c, depth + 2)
    put(c, "for (long long " + v + " = tb_lo" + id + "; " + v + " <= tb_end" + id + "; " + v + "++) {\n")
    emit_prefetch(c, n, depth + 3, "", v, "long long")
    emit_loop_body(c, n.kids[2], depth + 3)
    indent(c, depth + 2)
    put(c, "}\n")
    c.fast_depth -= 1
    c.fast_lists = keep
    indent(c, depth + 1)
    put(c, "} else {\n")
    indent(c, depth + 2)
    put(c, "for (long long " + v + " = tb_lo" + id + "; " + v + " <= tb_end" + id + "; " + v + "++) {\n")
    emit_prefetch(c, n, depth + 3, "", v, "long long")
    emit_loop_body(c, n.kids[2], depth + 3)
    indent(c, depth + 2)
    put(c, "}\n")
    indent(c, depth + 1)
    put(c, "}\n")
    indent(c, depth)
    put(c, "}\n")

// return у функции с gives: отдать выходы
func emit_gives_return(c: Comp, depth: int)
    outputs = c.cur_func.kids[2]
    indent(c, depth)
    if len(outputs.kids) == 1
        put(c, "return v_" + outputs.kids[0].name + ";\n")
        return
    put(c, "return (" + c_type(c, c.cur_func.ty) + "){")
    count i from 0 to len(outputs.kids) - 1
        if i > 0
            put(c, ", ")
        put(c, "v_" + outputs.kids[i].name)
    put(c, "};\n")

// repeat N times с одной строкой  имя.add(готовое значение)
func fill_form(c: Comp, n: Node)
    body = n.kids[1]
    if len(body.kids) != 1 or body.kids[0].kind != "expr_stmt"
        return false
    e = body.kids[0].kids[0]
    if e.kind != "method" or e.name != "add" or e.kids[0].kind != "name" or is_cols_list(c, e.kids[0].ty)
        return false
    v = e.kids[1].kids[0]
    k = v.kind
    return k == "number" or k == "decimal" or k == "string" or k == "bool"

// match: одно значение, дальше цепочка if / else if
func emit_match(c: Comp, n: Node, depth: int)
    c.label += 1
    m = "tb_m" + c.label
    subj = n.kids[0]
    is_text = subj.ty == 4
    indent(c, depth)
    put(c, "{\n")
    indent(c, depth + 1)
    put(c, c_type(c, subj.ty) + " " + m + " = ")
    emit_expr(c, subj)
    put(c, ";\n")
    first = true
    count i from 1 to len(n.kids) - 1
        cs = n.kids[i]
        indent(c, depth + 1)
        if not first
            put(c, "else ")
        first = false
        if cs.name == "else"
            put(c, "{\n")
        else
            put(c, "if (")
            vi = 0
            each v in cs.kids[0].kids
                if vi > 0
                    put(c, " || ")
                vi += 1
                if is_text
                    put(c, "strcmp(" + m + ", ")
                    emit_expr(c, v)
                    put(c, ") == 0")
                else
                    put(c, m + " == ")
                    emit_expr(c, v)
            put(c, ") {\n")
        emit_block(c, cs.kids[1], depth + 2)
        indent(c, depth + 1)
        put(c, "}\n")
    indent(c, depth)
    put(c, "}\n")

func emit_statement(c: Comp, n: Node, depth: int)
    k = n.kind
    if k == "match"
        emit_match(c, n, depth)
    else if k == "assign"
        emit_assign(c, n, depth)
    else if k == "set"
        emit_set(c, n, depth)
    else if k == "linkdecl"
        indent(c, depth)
        put(c, c_type(c, n.ty) + " *v_" + n.name + " = &(")
        emit_expr(c, n.kids[0])
        put(c, ");\n")
    else if k == "multi"
        emit_multi(c, n, depth)
    else if k == "if"
        emit_if(c, n, depth)
    else if k == "each"
        emit_each(c, n, depth)
    else if k == "count"
        emit_count(c, n, depth)
    else if k == "repeat_times" and fill_form(c, n)
        // repeat N times: list.add(true) — сразу N одинаковых элементов, без цикла по одному
        e = n.kids[1].kids[0].kids[0]
        lst = e.kids[0]
        value = e.kids[1].kids[0]
        indent(c, depth)
        if is_bits(c, lst.ty)
            put(c, "tb_bfill(")
            emit_expr(c, lst)
            put(c, ", ")
            emit_expr(c, n.kids[0])
            put(c, ", ")
            emit_expr(c, value)
            put(c, ");\n")
        else
            elem = c.types[lst.ty].elem
            et = c_type(c, elem)
            if is_narrow(c, lst)
                et = "int"
            put(c, "tb_fill(")
            emit_expr(c, lst)
            put(c, ", ")
            emit_expr(c, n.kids[0])
            put(c, ", &(" + et + "){")
            emit_as(c, value, elem)
            put(c, "});\n")
    else if k == "repeat_times"
        c.label += 1
        id = "" + c.label
        indent(c, depth)
        put(c, "for (long long tb_r" + id + " = 0, tb_n" + id + " = ")
        emit_expr(c, n.kids[0])
        put(c, "; tb_r" + id + " < tb_n" + id + "; tb_r" + id + "++) {\n")
        emit_loop_body(c, n.kids[1], depth + 1)
        indent(c, depth)
        put(c, "}\n")
    else if k == "repeat_while"
        indent(c, depth)
        put(c, "while (")
        emit_expr(c, n.kids[0])
        put(c, ") {\n")
        emit_loop_body(c, n.kids[1], depth + 1)
        indent(c, depth)
        put(c, "}\n")
    else if k == "together"
        emit_together(c, n, depth)
    else if k == "danger"
        indent(c, depth)
        put(c, "{\n")
        emit_block(c, n.kids[0], depth + 1)
        indent(c, depth)
        put(c, "}\n")
    else if k == "lock"
        // замок: в обычной программе — атомарный обмен; в ядре ещё и без прерываний на это время
        c.label += 1
        id = "" + c.label
        if not bld_has(c.locks, n.name)
            c.locks.add(n.name)
        indent(c, depth)
        put(c, "{\n")
        indent(c, depth + 1)
        put(c, "extern int tb_lk_" + n.name + "; unsigned long tb_lf" + id + " = tb_lock_take(&tb_lk_" + n.name + ");\n")
        c.lock_ids.add(id)
        emit_block(c, n.kids[0], depth + 1)
        gone_id = c.lock_ids.pop()
        freed = false
        each s in n.kids[0].kids
            if s.kind == "unlock"
                freed = true
        if not freed
            indent(c, depth + 1)
            put(c, "tb_lock_give(&tb_lk_" + n.name + ", tb_lf" + id + ");\n")
        indent(c, depth)
        put(c, "}\n")
    else if k == "unlock"
        // unlock имя: отпустить замок здесь, а не в конце блока
        indent(c, depth)
        put(c, "tb_lock_give(&tb_lk_" + n.name + ", tb_lf" + c.lock_ids[len(c.lock_ids) - 1] + ");\n")
    else if k == "temp"
        c.label += 1
        id = "" + c.label
        indent(c, depth)
        put(c, "{\n")
        indent(c, depth + 1)
        put(c, "tb_mark tb_k" + id + " = tb_temp_begin();\n")
        emit_block(c, n.kids[0], depth + 1)
        indent(c, depth + 1)
        put(c, "tb_temp_end(tb_k" + id + ");\n")
        indent(c, depth)
        put(c, "}\n")
    else if k == "skip"
        indent(c, depth)
        put(c, "continue;\n")
    else if k == "stop"
        indent(c, depth)
        put(c, "break;\n")
    else if k == "fail"
        indent(c, depth)
        put(c, "{ tb_err = ")
        emit_expr(c, n.kids[0])
        put(c, "; ")
        emit_bail(c)
        put(c, " }\n")
    else if k == "return" and c.fmark != ""
        // функция с ареной: сначала значение, потом сброс арены, потом return
        if len(n.kids) == 1
            emit_pre(c, n.kids[0], depth)
            indent(c, depth)
            put(c, "{ " + c_type(c, c.cur_func.ty) + " tb_rv = ")
            emit_as(c, n.kids[0], c.cur_func.ty)
            put(c, "; if (tb_fa) tb_temp_end(" + c.fmark + "); return tb_rv; }\n")
        else
            indent(c, depth)
            put(c, "if (tb_fa) tb_temp_end(" + c.fmark + ");\n")
            if len(c.cur_func.kids[2].kids) > 0
                emit_gives_return(c, depth)
            else
                indent(c, depth)
                put(c, "return;\n")
    else if k == "return"
        if len(n.kids) == 1
            emit_pre(c, n.kids[0], depth)
        if len(c.cur_func.kids[2].kids) > 0 and len(n.kids) == 0
            emit_gives_return(c, depth)
        else if len(n.kids) == 1
            indent(c, depth)
            put(c, "return ")
            emit_as(c, n.kids[0], c.cur_func.ty)
            put(c, ";\n")
        else
            indent(c, depth)
            put(c, "return;\n")
    else if k == "expr_stmt"
        e = n.kids[0]
        if e.kind == "try" or e.kind == "else_err"
            emit_pre(c, e, depth)
            return
        indent(c, depth)
        if e.kind == "method" and e.name == "add"
            // list.add(x): сначала значение, потом место под него
            elem = c.types[e.kids[0].ty].elem
            c.label += 1
            id = "" + c.label
            value = e.kids[1].kids[0]
            if is_cols_list(c, e.kids[0].ty) and value.kind == "call" and value.has_ref and value.ref.kind == "obj"
                // pts.add(Point(x: 1, y: 2)): качества сразу в колонки, без временной строки
                o = value.ref
                put(c, "tb_colpush_" + o.name + "(")
                emit_expr(c, e.kids[0])
                count i from 0 to len(o.kids) - 1
                    put(c, ", ")
                    if value.kids[i].kind == "missing"
                        emit_default(c, o.kids[i].ty)
                    else
                        emit_as(c, value.kids[i].kids[0], o.kids[i].ty)
                put(c, ", " + e.line + ");\n")
                return
            if is_cols_list(c, e.kids[0].ty)
                put(c, "{ " + c_type(c, elem) + " tb_v" + id + " = ")
                emit_expr(c, e.kids[1].kids[0])
                put(c, "; tb_coladd_" + cols_name(c, elem) + "(")
                emit_expr(c, e.kids[0])
                put(c, ", tb_v" + id + ", " + e.line + "); }\n")
                return
            if is_bits(c, e.kids[0].ty)
                put(c, "{ _Bool tb_v" + id + " = ")
                emit_expr(c, e.kids[1].kids[0])
                put(c, "; tb_badd(")
                emit_expr(c, e.kids[0])
                put(c, ", tb_v" + id + "); }\n")
                return
            et = c_type(c, elem)
            if is_narrow(c, e.kids[0])
                et = "int"
            put(c, "{ " + et + " tb_v" + id + " = ")
            emit_as(c, e.kids[1].kids[0], elem)
            put(c, "; *(" + et + " *)tb_grow(")
            emit_expr(c, e.kids[0])
            put(c, ") = tb_v" + id + "; }\n")
        else
            emit_expr(c, e)
            put(c, ";\n")

func emit_block(c: Comp, block: Node, depth: int)
    each s in block.kids
        emit_statement(c, s, depth)

// ---------- объявления верхнего уровня ----------

func emit_signature(c: Comp, f: Node)
    params = f.kids[0]
    if has_text(c.ll_names, fname(f)) or has_text(c.ll_ext, fname(f))
        // тело этой функции в файле .ll (--llvm): здесь только имя, без static
        put(c, c_type(c, f.ty) + " " + fname(f) + "(")
    else
        put(c, "TB_API " + c_type(c, f.ty) + " " + fname(f) + "(")
    if len(params.kids) == 0
        put(c, "void")
    count i from 0 to len(params.kids) - 1
        p = params.kids[i]
        if i > 0
            put(c, ", ")
        if p.is_link
            put(c, c_type(c, p.ty) + " *v_" + p.name)
        else
            put(c, c_type(c, p.ty) + " v_" + p.name)
    put(c, ")")

// ---------- дописывание на месте: s += x и s = s + x + y ----------
// Текст s, в который только дописывают, держит свою память с запасом: tb_rl_s — длина,
// tb_rc_s — место. Дописывание кладёт байты в конец, а не собирает третий текст из двух.
// Любое чтение s, после которого s может где-то сохраниться (t = s, list.add(s), f(s)),
// ставит tb_rl_s = -1: следующее дописывание сначала сделает копию, и t не изменится.
// print, len, s[i], сравнения и склеивание ничего не сохраняют — они читают s как есть.

func bld_has(names: list text, name: text)
    each x in names
        if x == name
            return true
    return false

func bld_uses(n: Node, name: text)
    if n.kind == "name" and n.name == name
        return true
    each k in n.kids
        if bld_uses(k, name)
            return true
    return false

// все имена внутри узла — плохие (их нельзя держать в своей памяти)
func bld_bad_all(n: Node, bad: list text)
    if n.kind == "name" or n.kind == "assign"
        bad.add(n.name)
    each k in n.kids
        bld_bad_all(k, bad)

func is_text_plus(c: Comp, n: Node)
    return n.kind == "binop" and n.value == "+" and kind_of(c, n.ty) == "text"

// s = s + a + b: слева самое первое — s, и справа s больше нигде нет
func app_form(c: Comp, name: text, v: Node)
    if not is_text_plus(c, v)
        return false
    r = v
    repeat while is_text_plus(c, r)
        if bld_uses(r.kids[1], name)
            return false
        r = r.kids[0]
    return r.kind == "name" and r.name == name and not r.is_link

// части, которые дописываются по порядку: s + a + b → a, b
func app_parts(c: Comp, v: Node) gives parts: list Node
    back = list Node
    r = v
    repeat while is_text_plus(c, r)
        back.add(r.kids[1])
        r = r.kids[0]
    i = len(back) - 1
    repeat while i >= 0
        parts.add(back[i])
        i -= 1

func bld_scan(c: Comp, n: Node, in_par: bool, cand: list text, bad: list text)
    k = n.kind
    par = in_par or k == "background" or k == "together" or ((k == "each" or k == "count") and (n.is_par or n.by_vec))
    if par
        bld_bad_all(n, bad)
        return
    if k == "linkdecl" or k == "multi"
        bld_bad_all(n, bad)
    if k == "each" or k == "count" or k == "else_err"
        bad.add(n.name)
    if k == "call" and n.has_ref and n.ref.kind == "func"
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link
                bld_bad_all(n.kids[i], bad)
    if k == "assign"
        if n.is_link
            bad.add(n.name)
        else if kind_of(c, n.ty) == "text" and len(n.kids) == 1 and not n.creates and app_form(c, n.name, n.kids[0])
            cand.add(n.name)
    if k == "set" and n.value == "+=" and n.kids[0].kind == "name" and kind_of(c, n.kids[0].ty) == "text"
        if n.kids[0].is_link
            bad.add(n.kids[0].name)
        else
            cand.add(n.kids[0].name)
    each kid in n.kids
        bld_scan(c, kid, false, cand, bad)

func find_builders(c: Comp, f: Node)
    fresh = list text
    c.builders = fresh
    cand = list text
    bad = list text
    each p in f.kids[0].kids
        if p.is_link
            bad.add(p.name)
    bld_scan(c, f.kids[1], false, cand, bad)
    each name in cand
        if not bld_has(bad, name) and not bld_has(c.builders, name)
            c.builders.add(name)

// это имя текста, в который дописывают на месте
func is_bld(c: Comp, n: Node)
    return n.kind == "name" and not n.is_link and len(c.builders) > 0 and kind_of(c, n.ty) == "text" and bld_has(c.builders, n.name)

// прочитать, ничего не сохраняя (print, len, s[i], сравнение, склеивание)
func emit_q(c: Comp, n: Node)
    if is_bld(c, n)
        put(c, "v_" + n.name)
    else
        emit_expr(c, n)

func emit_app(c: Comp, name: text, part: Node)
    vars = "&v_" + name + ", &tb_rl_" + name + ", &tb_rc_" + name + ", "
    if kind_of(c, part.ty) == "int"
        // число: цифры сразу в конец
        put(c, "tb_app_i(" + vars)
        emit_expr(c, part)
        put(c, ");")
    else if part.kind == "string"
        // готовый текст: длину знает компилятор (sizeof без нуля в конце)
        put(c, "tb_app_n(" + vars + part.value + ", sizeof(" + part.value + ") - 1);")
    else
        put(c, "tb_app(" + vars)
        emit_as_text(c, part)
        put(c, ");")

// тело цикла: если можно — с временной памятью на каждый шаг
func emit_loop_body(c: Comp, body: Node, depth: int)
    if not auto_temp_ok(c, body)
        emit_block(c, body, depth)
        return
    c.label += 1
    id = "" + c.label
    indent(c, depth)
    put(c, "tb_mark tb_am" + id + " = tb_temp_begin();\n")
    indent(c, depth)
    // do { } while (0): skip (continue) выходит сюда, и память шага всё равно отдаётся
    put(c, "do {\n")
    emit_block(c, body, depth + 1)
    indent(c, depth)
    put(c, "} while (0);\n")
    indent(c, depth)
    put(c, "tb_temp_end(tb_am" + id + ");\n")

func emit_func(c: Comp, f: Node)
    c.cur_func = f
    no_narrow = list text
    c.narrow = no_narrow
    find_narrow(c, f, f.kids[1])
    outputs = f.kids[2]
    put(c, "\n")
    emit_signature(c, f)
    put(c, " {\n")
    each o in outputs.kids
        if not o.is_const
            put(c, "    " + c_type(c, o.ty) + " v_" + o.name + " = ")
            emit_default(c, o.ty)
            put(c, ";\n")
    find_builders(c, f)
    each b in c.builders
        put(c, "    long long tb_rl_" + b + " = -1, tb_rc_" + b + " = 0; (void)tb_rl_" + b + "; (void)tb_rc_" + b + ";\n")
    c.fmark = ""
    if func_arena_ok(c, f)
        // всё, что функция создаёт, — во временной арене; сброс при каждом return
        // если вызвали изнутри temp или шага цикла, мусор и так отдаст та область: своя не нужна
        c.fmark = "tb_fm"
        put(c, "    int tb_fa = tb_temp_depth == 0; tb_mark tb_fm = {0, 0}; if (tb_fa) tb_fm = tb_temp_begin();\n")
    emit_block(c, f.kids[1], 1)
    no_builders = list text
    c.builders = no_builders
    if c.fmark != ""
        put(c, "    if (tb_fa) tb_temp_end(tb_fm);\n")
    c.fmark = ""
    if len(outputs.kids) > 0
        emit_gives_return(c, 1)
    else if kind_of(c, f.ty) != "none"
        put(c, "    tb_crash(" + f.line + ", \"функция " + f.name + " дошла до конца без return\");\n")
        put(c, "    return ")
        emit_default(c, f.ty)
        put(c, ";\n")
    put(c, "}\n")

// tb_show_N: печать значения типа N (для print)
func emit_show(c: Comp, t: Type)
    k = t.kind
    if k == "none" or k == "multi" or k == "unknown"
        return
    if k == "task"
        put(c, "TB_LLV void tb_show_" + t.id + "(tb_task *x) { (void)x; tb_ps(\"<background>\"); }\n")
        return
    if k == "channel"
        put(c, "TB_LLV void tb_show_" + t.id + "(tb_chan *x) { (void)x; tb_ps(\"<channel>\"); }\n")
        return
    if k == "enum"
        // печать варианта enum — его имя
        put(c, "TB_LLV void tb_show_" + t.id + "(long long x) {\n    static const char *names[] = {")
        each v in t.obj_node.kids
            put(c, "\"" + v.name + "\", ")
        put(c, "0};\n    tb_ps(names[x]);\n}\n")
        return
    put(c, "TB_LLV void tb_show_" + t.id + "(" + c_type(c, t.id) + " x) {\n")
    if k == "int"
        put(c, "    printf(\"%lld\", x);\n")
    else if k == "dec"
        put(c, "    printf(\"%g\", x);\n")
    else if k == "bool"
        put(c, "    tb_ps(x ? \"true\" : \"false\");\n")
    else if k == "text"
        put(c, "    tb_ps(x);\n")
    else if k == "list"
        elem = c_type(c, t.elem)
        put(c, "    tb_ps(\"[\");\n")
        put(c, "    for (long long i = 0; i < x->len; i++) {\n")
        put(c, "        if (i > 0) tb_ps(\", \");\n")
        if is_cols_obj(c, t.elem)
            put(c, "        tb_show_" + t.elem + "((" + elem + "){x, i});\n")
        else if t.elem == 3
            put(c, "        tb_show_3(TB_BIT(x, i));\n")
        else
            put(c, "        tb_show_" + t.elem + "(((" + elem + " *)x->data)[i]);\n")
        put(c, "    }\n")
        put(c, "    tb_ps(\"]\");\n")
    else if k == "dict"
        kt = c_type(c, t.key)
        vt = c_type(c, t.elem)
        put(c, "    tb_ps(\"{\");\n")
        put(c, "    for (long long i = 0; i < x->keys->len; i++) {\n")
        put(c, "        if (i > 0) tb_ps(\", \");\n")
        put(c, "        tb_show_" + t.key + "(((" + kt + " *)x->keys->data)[i]);\n")
        put(c, "        tb_ps(\": \");\n")
        put(c, "        tb_show_" + t.elem + "(((" + vt + " *)x->vals->data)[i]);\n")
        put(c, "    }\n")
        put(c, "    tb_ps(\"}\");\n")
    else if k == "obj"
        o = t.obj_node
        if o.by_cols
            put(c, "    if (x.c == 0) { tb_ps(\"пусто\"); return; }\n")
        else
            put(c, "    if (x == 0) { tb_ps(\"пусто\"); return; }\n")
        put(c, "    tb_ps(\"" + o.name + "(\");\n")
        count i from 0 to len(o.kids) - 1
            sep = ""
            if i > 0
                sep = ", "
            put(c, "    tb_ps(\"" + sep + o.kids[i].name + ": \");\n")
            if o.by_cols
                put(c, "    tb_show_" + o.kids[i].ty + "(x.c->q_" + o.kids[i].name + "[x.i]);\n")
            else
                put(c, "    tb_show_" + o.kids[i].ty + "(x" + field_path(o, o.kids[i].name) + ");\n")
        put(c, "    tb_ps(\")\");\n")
    put(c, "}\n")

// obj by columns: каждая колонка — свой кусок памяти
//   struct tb_cols_Point { len, cap; double *q_x; double *q_y; }
//   tb_row_Point {c, i} — одна «строка»: в каком списке колонок и под каким номером
func emit_cols_obj(c: Comp, o: Node)
    put(c, "struct tb_cols_" + o.name + " {\n    long long len, cap;\n")
    each f in o.kids
        put(c, "    " + c_type(c, f.ty) + " *q_" + f.name + ";\n")
    put(c, "};\n")

func emit_obj(c: Comp, o: Node)
    if o.by_cols
        emit_cols_obj(c, o)
        return
    // холодные качества — в своей структуре и в своей памяти (tb_cold_mem)
    if has_cold(o)
        put(c, "struct tb_c_" + o.name + " {\n")
        each f in o.kids
            if f.is_cold
                put(c, "    " + c_type(c, f.ty) + " q_" + f.name + ";\n")
        put(c, "};\n")
    put(c, "struct tb_o_" + o.name + " {\n")
    each f in o.kids
        if not f.is_cold
            put(c, "    " + c_type(c, f.ty) + " q_" + f.name + ";\n")
    if has_cold(o)
        put(c, "    struct tb_c_" + o.name + " *tb_cold;\n")
    if len(o.kids) == 0
        put(c, "    char empty;\n")
    put(c, "};\n")

func has_cold(o: Node)
    each f in o.kids
        if f.is_cold
            return true
    return false

// как добраться до качества: горячее — прямо в obj, холодное — через tb_cold
func field_path(o: Node, name: text) gives r: text
    each f in o.kids
        if f.name == name and f.is_cold
            return "->tb_cold->q_" + name
    return "->q_" + name

// помощники для obj by columns: новый список, рост, номер, качество, add, копия
func emit_cols_helpers(c: Comp, o: Node)
    nm = o.name
    cols = "tb_cols_" + nm
    row = "tb_row_" + nm
    put(c, "TB_API " + cols + " *tb_cols_new_" + nm + "(void) {\n")
    put(c, "    " + cols + " *l = tb_mem(sizeof(" + cols + "));\n    l->len = 0; l->cap = 4;\n")
    each f in o.kids
        mem = "tb_mem"
        if is_plain_ty(c, f.ty)
            mem = "tb_mem_np"
        put(c, "    l->q_" + f.name + " = " + mem + "(sizeof(" + c_type(c, f.ty) + ") * 4);\n")
    put(c, "    return l;\n}\n")
    put(c, "TB_API void tb_colgrow_" + nm + "(" + cols + " *l) {\n")
    put(c, "    if (l->len < l->cap) return;\n    l->cap *= 2;\n")
    each f in o.kids
        ft = c_type(c, f.ty)
        put(c, "    l->q_" + f.name + " = tb_resize(l->q_" + f.name + ", sizeof(" + ft + ") * (l->cap / 2), sizeof(" + ft + ") * l->cap);\n")
    put(c, "}\n")
    put(c, "TB_API " + row + " tb_colat_" + nm + "(" + cols + " *l, long long i, int line) {\n")
    put(c, "    if (TB_RARE((unsigned long long)i >= (unsigned long long)((" + cols + " *)tb_nn(l, line))->len)) tb_crash(line, \"номер за пределами списка\");\n")
    put(c, "    return (" + row + "){l, i};\n}\n")
    each f in o.kids
        ft = c_type(c, f.ty)
        put(c, "TB_INL " + ft + " *tb_colf_" + nm + "_" + f.name + "(" + row + " r, int line) {\n")
        put(c, "    if (TB_RARE(r.c == 0)) tb_crash(line, \"объект пустой: его ещё не создали\");\n")
        put(c, "    return &r.c->q_" + f.name + "[r.i];\n}\n")
    put(c, "TB_API void tb_coladd_" + nm + "(" + cols + " *l, " + row + " r, int line) {\n")
    put(c, "    if (TB_RARE(r.c == 0)) tb_crash(line, \"объект пустой: его ещё не создали\");\n")
    count i from 0 to len(o.kids) - 1
        put(c, "    " + c_type(c, o.kids[i].ty) + " a" + i + " = r.c->q_" + o.kids[i].name + "[r.i];\n")
    put(c, "    tb_colgrow_" + nm + "(tb_nn(l, line));\n")
    count i from 0 to len(o.kids) - 1
        put(c, "    l->q_" + o.kids[i].name + "[l->len] = a" + i + ";\n")
    put(c, "    l->len += 1;\n}\n")
    put(c, "TB_API void tb_colpush_" + nm + "(" + cols + " *l")
    count i from 0 to len(o.kids) - 1
        put(c, ", " + c_type(c, o.kids[i].ty) + " a" + i)
    put(c, ", int line) {\n    tb_colgrow_" + nm + "(tb_nn(l, line));\n")
    count i from 0 to len(o.kids) - 1
        put(c, "    l->q_" + o.kids[i].name + "[l->len] = a" + i + ";\n")
    put(c, "    l->len += 1;\n}\n")
    put(c, "TB_API void tb_colset_" + nm + "(" + cols + " *l, long long i, " + row + " r, int line) {\n")
    put(c, "    tb_colat_" + nm + "(l, i, line);\n")
    put(c, "    if (TB_RARE(r.c == 0)) tb_crash(line, \"объект пустой: его ещё не создали\");\n")
    each f in o.kids
        put(c, "    l->q_" + f.name + "[i] = r.c->q_" + f.name + "[r.i];\n")
    put(c, "}\n")
    put(c, "TB_API " + cols + " *tb_colsfrom_" + nm + "(long long n, " + row + " *rows) {\n")
    put(c, "    " + cols + " *l = tb_cols_new_" + nm + "();\n")
    put(c, "    for (long long i = 0; i < n; i++) tb_coladd_" + nm + "(l, rows[i], 0);\n")
    put(c, "    return l;\n}\n")
    // одна новая строка: список колонок из одного элемента
    put(c, "TB_API " + row + " tb_new_" + nm + "(")
    if len(o.kids) == 0
        put(c, "void")
    count i from 0 to len(o.kids) - 1
        if i > 0
            put(c, ", ")
        put(c, c_type(c, o.kids[i].ty) + " a" + i)
    put(c, ") {\n    " + cols + " *l = tb_cols_new_" + nm + "();\n")
    count i from 0 to len(o.kids) - 1
        put(c, "    l->q_" + o.kids[i].name + "[0] = a" + i + ";\n")
    put(c, "    l->len = 1;\n    return (" + row + "){l, 0};\n}\n")
    if c.ll
        // --llvm: те же помощники, но строка — двумя частями (список колонок, номер)
        put(c, "TB_LLV " + cols + " *tb_lc_new_" + nm + "(void) { return tb_cols_new_" + nm + "(); }\n")
        put(c, "TB_LLV void tb_lc_add_" + nm + "(" + cols + " *l, " + cols + " *rc, long long ri, int line) { tb_coladd_" + nm + "(l, (" + row + "){rc, ri}, line); }\n")
        put(c, "TB_LLV void tb_lc_set_" + nm + "(" + cols + " *l, long long i, " + cols + " *rc, long long ri, int line) { tb_colset_" + nm + "(l, i, (" + row + "){rc, ri}, line); }\n")
        put(c, "TB_LLV " + cols + " *tb_lc_from_" + nm + "(long long n, " + row + " *rows) { return tb_colsfrom_" + nm + "(n, rows); }\n")
        put(c, "TB_LLV " + cols + " *tb_lc_make_" + nm + "(")
        if len(o.kids) == 0
            put(c, "void")
        count i from 0 to len(o.kids) - 1
            if i > 0
                put(c, ", ")
            put(c, c_type(c, o.kids[i].ty) + " a" + i)
        put(c, ") { return tb_new_" + nm + "(")
        count i from 0 to len(o.kids) - 1
            if i > 0
                put(c, ", ")
            put(c, "a" + i)
        put(c, ").c; }\n")
        put(c, "TB_LLV void tb_lc_push_" + nm + "(" + cols + " *l")
        count i from 0 to len(o.kids) - 1
            put(c, ", " + c_type(c, o.kids[i].ty) + " a" + i)
        put(c, ", int line) { tb_colpush_" + nm + "(l")
        count i from 0 to len(o.kids) - 1
            put(c, ", a" + i)
        put(c, ", line); }\n")

func emit_constructor(c: Comp, o: Node)
    if o.by_cols
        emit_cols_helpers(c, o)
        return
    put(c, "TB_LLV tb_o_" + o.name + " *tb_new_" + o.name + "(")
    if len(o.kids) == 0
        put(c, "void")
    count i from 0 to len(o.kids) - 1
        if i > 0
            put(c, ", ")
        put(c, c_type(c, o.kids[i].ty) + " a" + i)
    put(c, ") {\n")
    // obj только из чисел: внутри нет адресов, уборка памяти туда не смотрит
    plain = not has_cold(o)
    each f in o.kids
        if not is_plain_ty(c, f.ty)
            plain = false
    mem = "tb_obj_mem"
    if plain
        mem = "tb_obj_mem_np"
    put(c, "    tb_o_" + o.name + " *o = " + mem + "(sizeof(tb_o_" + o.name + "));\n")
    if has_cold(o)
        cold_plain = true
        each f in o.kids
            if f.is_cold and not is_plain_ty(c, f.ty)
                cold_plain = false
        cmem = "tb_cold_mem"
        if cold_plain
            cmem = "tb_cold_mem_np"
        put(c, "    o->tb_cold = " + cmem + "(sizeof(struct tb_c_" + o.name + "));\n")
    count i from 0 to len(o.kids) - 1
        put(c, "    o" + field_path(o, o.kids[i].name) + " = a" + i + ";\n")
    put(c, "    return o;\n}\n")

modpub func emit_c(c: Comp, program: Node)
    fresh = list text
    c.out = fresh
    c.label = 0
    put(c, "// Сделано компилятором Tachbit 1.1. Не правь руками: правь файл .tb\n")
    if c.bare
        put(c, "#define TB_BARE 1\n")
    if c.gfx
        put(c, "#define TB_GFX 1\n")
    if c.snd
        put(c, "#define TB_SND 1\n")
    if c.ll
        put(c, "#define TB_LL 1\n")
    // с TB_LL библиотека сама открывает обёртки tb_x_* и tb_ll_crash для файла .ll
    put(c, runtime_text())
    // shared снаружи функций; в ядре volatile: их меняют прерывания и задачи
    each g in c.globals
        if c.bare
            put(c, "TB_LLV volatile " + c_type(c, g.ty) + " v_" + g.name + " = ")
        else
            put(c, "TB_LLV " + c_type(c, g.ty) + " v_" + g.name + " = ")
        emit_as(c, g.kids[0], g.ty)
        put(c, ";\n")

    // obj: сначала имена, потом устройство (obj может хранить другой obj)
    each top in program.kids
        if top.kind == "obj" and top.by_cols
            put(c, "typedef struct tb_cols_" + top.name + " tb_cols_" + top.name + ";\n")
            put(c, "typedef struct { tb_cols_" + top.name + " *c; long long i; } tb_row_" + top.name + ";\n")
        else if top.kind == "obj"
            put(c, "typedef struct tb_o_" + top.name + " tb_o_" + top.name + ";\n")
    each top in program.kids
        if top.kind == "obj"
            emit_obj(c, top)
    // выходы gives: структура на функцию
    each top in program.kids
        if top.kind == "func" and len(top.kids[2].kids) > 1
            put(c, "typedef struct {")
            count j from 0 to len(top.kids[2].kids) - 1
                put(c, " " + c_type(c, top.kids[2].kids[j].ty) + " o" + j + ";")
            put(c, " } tb_r_" + fname(top) + ";\n")
    each t in c.types
        k = t.kind
        if k != "none" and k != "multi" and k != "unknown"
            put(c, "TB_LLV void tb_show_" + t.id + "(" + c_type(c, t.id) + " x);\n")
    count i from 1 to len(c.temp_types) - 1
        put(c, "TB_API _Thread_local " + c_type(c, c.temp_types[i]) + " tb_t" + i + ";   // для  f() or запасное\n")
    each top in program.kids
        if top.kind == "obj"
            emit_constructor(c, top)
    each top in program.kids
        if top.kind == "func"
            emit_signature(c, top)
            put(c, ";\n")
    put(c, "\n")
    each t in c.types
        emit_show(c, t)
        if c.ll and t.kind == "obj" and is_cols_obj(c, t.id)
            // строку из .ll отдают по адресу (две части в регистрах у разных машин передаются по-разному)
            put(c, "TB_LLV void tb_lc_show_" + t.id + "(tb_row_" + t.obj_node.name + " *r) { tb_show_" + t.id + "(*r); }\n")
    // функции пишем в отдельный кусок: работники on all cores должны стоять перед ними
    saved = c.out
    funcs_out = list text
    c.out = funcs_out
    each top in program.kids
        if top.kind == "func" and not has_text(c.ll_names, fname(top))
            emit_func(c, top)
    // --llvm: встроенные функции, background и .wait, которые зовут из .ll — обёртка с видом
    // Tachbit; стоят после работников (background из обёртки тоже пишет своего)
    llb_out = list text
    c.out = llb_out
    count i from 0 to len(c.ll_bi) - 1
        emit_ll_builtin(c, c.ll_bi[i], i)
    c.out = saved
    each w in c.workers
        put(c, w)
    each f in funcs_out
        put(c, f)
    each b in llb_out
        put(c, b)
    // --llvm: gives с несколькими выходами ходит между C и .ll через адреса выходов (имя__ll)
    each top in program.kids
        if top.kind == "func" and len(top.kids[2].kids) > 1
            if has_text(c.ll_names, fname(top))
                emit_ll_gives(c, top, true)
            else if has_text(c.ll_ext, fname(top))
                emit_ll_gives(c, top, false)
    main_func = program.kids[0]
    each top in program.kids
        if top.kind == "func" and top.name == "main" and top.mod == program.kids[0].mod
            main_func = top
    each l in c.locks
        put(c, "int tb_lk_" + l + " = 0;\n")
    if c.bare
        put(c, "\nvoid tb_kmain(void) {\n    tb_args = tb_list_new(sizeof(const char *));\n")
        each top in program.kids
            if top.kind == "func" and top.irq != 0
                put(c, "    tb_irq_set(" + top.irq + ", " + fname(top) + ");\n")
        put(c, "    " + fname(main_func) + "();\n}\n")
        return
    put(c, "\nint main(int argc, char **argv) {\n")
    // tb_top — в кадре main: все кадры программы ниже него, уборка памяти смотрит стек до него
    put(c, "    char tb_top = 0;\n")
    put(c, "    tb_guard_init();\n")
    put(c, "    tb_gc_init((void *)&tb_top);\n")
    each g in c.globals
        put(c, "    tb_gc_root((void *)&v_" + g.name + ", sizeof v_" + g.name + ");\n")
    count i from 1 to len(c.temp_types) - 1
        put(c, "    tb_gc_root((void *)&tb_t" + i + ", sizeof tb_t" + i + ");\n")
    put(c, "    tb_gc_root((void *)&tb_args, sizeof tb_args);\n")
    put(c, "    tb_gc_root((void *)&tb_err, sizeof tb_err);\n")
    put(c, "    tb_args = tb_list_new(sizeof(const char *));\n")
    put(c, "    for (int i = 1; i < argc; i++) *(const char **)tb_grow(tb_args) = argv[i];\n")
    put(c, "    tb_call_main(" + fname(main_func) + ");\n    return 0;\n}\n")
