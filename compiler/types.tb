// Tachbit 0.5 — общие объекты компилятора, написанного на самом Tachbit.
// Это тот же компилятор, что в archive/compiler-c/, строчка в строчку,
// только вместо глобальных переменных — один объект Comp, который
// передаётся во все функции, а вместо чисел-видов — короткие слова.

// токен: kind = name / command / number / decimal / string / sign /
//              newline / indent / dedent / end
obj Token
    kind: text
    word: text
    line: int

// узел дерева: kind = program / func / param / block / obj / type / assign /
// set / linkdecl / multi / if / each / count / repeat_times / repeat_while /
// skip / stop / return / expr_stmt / number / decimal / string / bool / name /
// list / call / arg / binop / unary / index / field / method / dict / use /
// fail / try / else_err
obj Node
    kind: text
    line: int
    name: text
    value: text
    tsyn: Node
    has_tsyn: bool
    ty: int
    is_const: bool
    is_link: bool
    creates: bool
    ref: Node
    has_ref: bool
    mod: text
    file: text
    is_pub: bool
    can_fail: bool
    temp_no: int
    kids: list Node
    // 0.7: each / count ... on all cores; shared x = ...
    is_par: bool
    is_shared: bool
    // obj Point by columns
    by_cols: bool
    // each x in nums by vec
    by_vec: bool
    // each piece in data by 64: размер куска
    by_piece: bool
    piece_size: Node
    // заказ наперёд: в цикле есть data[x] (each x in idx) или data[idx[i]] (count i):
    // pre_bases — data, pre_idx — idx (у each — пустой узел)
    pre_bases: list Node
    pre_idx: list Node
    // качество obj: читают ли его в циклах (горячее) или редко (холодное — лежит отдельно)
    hot: bool
    is_cold: bool
    // переменные снаружи, которые видит цикл on all cores
    caps: list Var
    // func ... on keyboard / on timer / on interrupt N: номер прерывания (0 — обычная функция)
    irq: int
    // background f(move xs): аргумент отдаётся целиком
    moved: bool

// тип языка; хранится один раз, номер типа = место в списке Comp.types
// kind = unknown / none / int / dec / bool / text / list / obj / multi / dict
// key и elem — номера других типов (-1 — нет)
// номера 0..4 всегда: none, int, dec, bool, text
obj Type
    kind: text
    key: int
    elem: int
    obj_node: Node
    obj_name: text
    func_node: Node
    func_key: text
    id: int

obj Func
    name: text
    mod: text
    node: Node
    // 0 — ещё не проверена, 1 — проверяется сейчас, 2 — готова
    state: int

obj Use
    mod: text
    used: text

obj Var
    name: text
    type: int
    is_const: bool
    is_link: bool
    depth: int
    is_shared: bool
    // by vec: как копится (+= или -=)
    op: text
    // «цвет»: номер+1 переменной, из которой взят этот список/obj (ys = xs, u = users[i]); 0 — свой
    src1: int
    // номер+1 параметра функции (0 — не параметр)
    pno: int
    // через эту переменную уже меняли данные (a.add, a[i] = ..., a.n += 1)
    changed: bool
    // список положили куда-то ещё (в другой список, obj, функцию, которая его хранит): move нельзя
    escaped: bool
    // отдан через move: больше им пользоваться нельзя (пока не дадут новое значение)
    moved: bool
    // на какой глубине циклов заведена переменная
    loop_d: int
    // ярлык на элемент списка/dict (e: link xs[0]): номер+1 переменной xs — её нельзя растить, пока ярлык жив
    link_root1: int

// состояние всего компилятора
obj Comp
    file_name: text
    // лексер
    tokens: list Token
    // парсер
    pos: int
    // проверка
    types: list Type
    funcs: list Func
    objs: list Node
    enums: list Node
    uses: list Use
    all_mods: list text
    cur_mod: text
    vars: list Var
    depth: int
    var_base: int
    current: int
    loop_depth: int
    // типы скрытых переменных tb_t1, tb_t2 ... (номер 0 не занят)
    temp_types: list int
    // внутри on all cores: с какого номера начинаются свои переменные цикла (-1 — не внутри)
    par_base: int
    par_node: Node
    // внутри temp: с какого номера свои переменные блока (-1 — не внутри) и глубина циклов
    temp_base: int
    temp_loops: int
    shared_ok: bool
    // цикл by vec (у него те же правила «снаружи», что у on all cores)
    par_vec: bool
    // вывод C
    out: list text
    label: int
    cur_func: Node
    narrow: list text           // списки int этой функции, где все числа влезают в 32 бита: по 4 байта
    // функции-работники для on all cores: пишутся перед остальными функциями
    workers: list text
    // by vec: имена, которые в теле цикла пишутся иначе (y → tb_a7_y[tb_k])
    vec_names: list text
    vec_repl: list text
    // each piece in data by N: сколько таких циклов вокруг (return, fail, try внутри нельзя)
    piece_depth: int
    // все циклы с кусками: после проверки смотрим, что кусок нигде не сохраняется
    pieces: list Node
    // параметр функции, куда передали кусок: "имя@модуль#номер" → 1 можно, 2 сохраняется
    safe_keys: list text
    safe_vals: list int
    safe_busy: int
    // циклы each / count вокруг текущего места (для заказа наперёд)
    loops: list Node
    // горячие и холодные качества: кто где читает качества и кто кого зовёт из цикла
    acc_field: list Node
    acc_func: list int
    acc_loop: list bool
    call_from: list int
    // защита потоков: какие параметры функции меняются ("номер_функции#номер_параметра"),
    // кто кому передаёт свой параметр, и вызовы из on all cores с данными снаружи
    mut_keys: list text
    // параметры, которые функция где-то хранит (кладёт в список, obj, отдаёт хранящей функции)
    keep_keys: list text
    e_from: list text
    e_to: list text
    pc_keys: list text
    pc_lines: list int
    pc_names: list text
    pc_files: list text
    // общие shared: кто их меняет (функция, под замком ли), и какие функции идут параллельно
    call_par: list bool
    last_call: int
    bg_funcs: list int
    // each по dict: эти dict внутри цикла нельзя уменьшать
    each_busy: list int
    // замки: какие замки сейчас взяты; кто какой замок берёт; вызовы под замком
    held: list text
    lk_func: list int
    lk_name: list text
    lc_func: list int
    lc_held: list text
    lc_line: list int
    lc_file: list text
    lc_name: list text
    // порядок замков: «взят a, внутри берут b» → ребро a>b (строка, файл)
    lo_edge: list text
    lo_line: list int
    lo_file: list text
    // unlock: на какой глубине тело текущего lock и отпущен ли он уже
    lk_depths: list int
    lk_freed: list bool
    // при выводе C: номера взятых замков (для unlock)
    lock_ids: list text
    // вызовы, которые отдают список, на элемент которого смотрит живой ярлык
    lr_keys: list text
    lr_lines: list int
    lr_names: list text
    lr_files: list text
    gw_func: list int
    gw_lock: list bool
    gw_line: list int
    gw_name: list text
    gw_file: list text
    call_to: list int
    call_loop: list bool
    // текстовые переменные текущей функции, в которые дописывают на месте (s += x)
    builders: list text
    // функция с временной ареной: имя метки (иначе пусто), и можно ли return при проверке
    fmark: text
    at_ret_ok: bool
    // режим «без ОС»: своё ядро, вывод на экран и в COM1, без malloc/printf
    bare: bool
    // программа рисует в окне: в C идёт TB_GFX, нужен Cocoa (Mac) или X11 (Linux)
    gfx: bool
    // count i from A to B: списки, у которых xs[i] (или xs[i + 1]) проверены один раз до цикла
    // пары «номер<TAB>список»; fast_depth — сколько таких циклов вокруг (не больше 2)
    fast_lists: list text
    fast_depth: int
    // «мяч в коробке»: пределы целых чисел (ключ → 4 числа: есть низ, низ, есть верх, верх)
    rg_keys: list text
    rg_vals: list int
    rg_busy: list text
    // внутри danger (сколько блоков вокруг), внутри lock и сколько циклов было снаружи lock
    danger_depth: int
    lock_depth: int
    lock_loops: int
    // имена замков (lock имя) и прерывания (номер:функция C) для вывода
    locks: list text
    irqs: list text
    // shared снаружи функций: первые n_globals переменных в vars — общие для всей программы
    n_globals: int
    globals: list Node
    // --llvm: собирать числовые функции через LLVM IR; ll_names — какие функции ушли в .ll
    ll: bool
    ll_names: list text
    // функции C, которые зовут из .ll: в C они без static
    ll_ext: list text
    // встроенные функции (split, to_int ...), которые зовут из .ll: для каждой в C — обёртка tb_llb_N
    ll_bi: list Node
