    lines.add("    X(GetPhysicalDeviceMemoryProperties, void, (VkPhysicalDevice, VkPhysicalDeviceMemoryProperties *)) \\\n")
    lines.add("    X(GetPhysicalDeviceFormatProperties, void, (VkPhysicalDevice, uint32_t, VkFormatProperties *)) \\\n")
    lines.add("    X(GetPhysicalDeviceSurfaceSupportKHR, VkResult, (VkPhysicalDevice, uint32_t, VkSurfaceKHR, VkBool32 *)) \\\n")
    lines.add("    X(GetPhysicalDeviceSurfaceCapabilitiesKHR, VkResult, (VkPhysicalDevice, VkSurfaceKHR, VkSurfaceCapabilitiesKHR *)) \\\n")
    lines.add("    X(GetPhysicalDeviceSurfaceFormatsKHR, VkResult, (VkPhysicalDevice, VkSurfaceKHR, uint32_t *, VkSurfaceFormatKHR *)) \\\n")
    lines.add("    X(GetPhysicalDeviceSurfacePresentModesKHR, VkResult, (VkPhysicalDevice, VkSurfaceKHR, uint32_t *, uint32_t *)) \\\n")
    lines.add("    X(CreateDevice, VkResult, (VkPhysicalDevice, const VkDeviceCreateInfo *, const void *, VkDevice *)) \\\n")
    lines.add("    X(GetDeviceQueue, void, (VkDevice, uint32_t, uint32_t, VkQueue *)) \\\n")
    lines.add("    X(CreateSwapchainKHR, VkResult, (VkDevice, const VkSwapchainCreateInfoKHR *, const void *, VkSwapchainKHR *)) \\\n")
    lines.add("    X(DestroySwapchainKHR, void, (VkDevice, VkSwapchainKHR, const void *)) \\\n")
    lines.add("    X(GetSwapchainImagesKHR, VkResult, (VkDevice, VkSwapchainKHR, uint32_t *, VkImage *)) \\\n")
    lines.add("    X(AcquireNextImageKHR, VkResult, (VkDevice, VkSwapchainKHR, uint64_t, VkSemaphore, VkFence, uint32_t *)) \\\n")
    lines.add("    X(QueuePresentKHR, VkResult, (VkQueue, const VkPresentInfoKHR *)) \\\n")
    lines.add("    X(CreateImage, VkResult, (VkDevice, const VkImageCreateInfo *, const void *, VkImage *)) \\\n")
