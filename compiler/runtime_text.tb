    lines.add("{0x00,0x00,0x00,0x00,0x00,0x46,0x4e,0x4e,0x4e,0x5e,0x76,0x76,0x66,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x24,0x38,0x00,0x46,0x4e,0x4e,0x4e,0x5e,0x76,0x76,0x66,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x66,0x6c,0x7c,0x78,0x78,0x6c,0x6c,0x66,0x67,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x7e,0x66,0x66,0x66,0x66,0x66,0x66,0x66,0xc6,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0xe6,0xe6,0xfe,0xfe,0xda,0xda,0xc2,0xc2,0xc2,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x66,0x66,0x66,0x66,0x7e,0x66,0x66,0x66,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x3c,0x66,0x66,0x66,0x66,0x66,0x66,0x66,0x3c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x7e,0x66,0x66,0x66,0x66,0x66,0x66,0x66,0x66,0x00,0x00},\n")
