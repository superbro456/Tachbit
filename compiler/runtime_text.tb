    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7e,0x60,0x60,0x60,0x60,0x60,0x60,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7e,0x66,0x66,0x66,0x66,0x66,0xff,0xc3,0xc3},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x3c,0x66,0x66,0x7e,0x60,0x62,0x3c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xda,0x7e,0x7c,0x7e,0x7e,0x5a,0xdb,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7c,0x0e,0x0e,0x3c,0x06,0x06,0x7c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x66,0x6e,0x6e,0x7e,0x76,0x76,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x24,0x38,0x00,0x66,0x6e,0x6e,0x7e,0x76,0x76,0x66,0x00,0x00},\n")
