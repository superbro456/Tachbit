    return join(lines, "")

modpub func linker_text()
    lines = list text
    lines.add("#!/usr/bin/env python3\n")
    lines.add("# Маленький компоновщик для ядер Tachbit: один файл .o (ELF, 64 бита, x86-64) → ядро .elf.\n")
    lines.add("# Нужен, чтобы tachbit bare работал без ld.lld (на Mac его не всегда можно поставить).\n")
    lines.add("# Ядро грузится по Multiboot, а загрузчики (QEMU -kernel, GRUB) берут только 32-битный ELF:\n")
    lines.add("# поэтому снаружи файл 32-битный, а внутри — 64-битный код (в 64 бита ядро переходит само, в _start).\n")
    lines.add("# Раскладка:\n")
    lines.add("#   1 МБ: .multiboot, код, константы  (только чтение)\n")
    lines.add("#   данные, переменные потока (.tdata, .tbss — образ для блока каждой задачи), .bss\n")
    lines.add("#   с границы 4 МБ: .tbheap (куча, в файл не пишется)\n")
    lines.add("# Запуск:  python3 elf_link.py вход.o -o выход.elf\n")
    lines.add("import struct\n")
    lines.add("import sys\n")
    lines.add("\n")
    lines.add("SHT_PROGBITS, SHT_SYMTAB, SHT_NOBITS, SHT_REL, SHT_RELA = 1, 2, 8, 9, 4\n")
    lines.add("SHF_WRITE, SHF_ALLOC, SHF_EXEC, SHF_TLS = 1, 2, 4, 0x400\n")
    lines.add("SHN_UNDEF, SHN_ABS, SHN_COMMON = 0, 0xFFF1, 0xFFF2\n")
    lines.add("BASE = 0x100000\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def fail(msg):\n")
    lines.add("    sys.stderr.write(\"компоновка ядра: \" + msg + \"\\n\")\n")
    lines.add("    sys.exit(1)\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def align(x, a):\n")
    lines.add("    return x if a <= 1 else (x + a - 1) // a * a\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def main(argv):\n")
    lines.add("    ins, outs = [], []\n")
    lines.add("    i = 1\n")
    lines.add("    while i < len(argv):\n")
    lines.add("        if argv[i] == \"-o\":\n")
    lines.add("            outs.append(argv[i + 1])\n")
    lines.add("            i += 2\n")
    lines.add("            continue\n")
    lines.add("        ins.append(argv[i])\n")
    lines.add("        i += 1\n")
    lines.add("    if len(ins) != 1 or len(outs) != 1:\n")
    lines.add("        fail(\"нужно: elf_link.py вход.o -o выход.elf\")\n")
    lines.add("    src, dst = ins[0], outs[0]\n")
    lines.add("    data = open(src, \"rb\").read()\n")
    lines.add("    if data[:4] != b\"\\x7fELF\" or data[4] != 2 or data[5] != 1:\n")
    lines.add("        fail(\"вход — не 64-битный ELF\")\n")
    lines.add("    e_type, e_machine = struct.unpack_from(\"<HH\", data, 16)\n")
    lines.add("    if e_type != 1 or e_machine != 62:\n")
    lines.add("        fail(\"вход — не объектный файл x86-64\")\n")
    lines.add("    e_shoff, = struct.unpack_from(\"<Q\", data, 40)\n")
    lines.add("    e_shentsize, e_shnum, e_shstrndx = struct.unpack_from(\"<HHH\", data, 58)\n")
    lines.add("    secs = []\n")
    lines.add("    for k in range(e_shnum):\n")
    lines.add("        name, typ, flags, _, off, size, link, info, al, _ = struct.unpack_from(\"<IIQQQQIIQQ\", data, e_shoff + k * e_shentsize)\n")
    lines.add("        secs.append(dict(name=name, type=typ, flags=flags, off=off, size=size, link=link, info=info, align=max(al, 1), addr=None))\n")
    lines.add("    strtab = secs[e_shstrndx]\n")
    lines.add("    for s in secs:\n")
    lines.add("        end = data.index(b\"\\0\", strtab[\"off\"] + s[\"name\"])\n")
    lines.add("        s[\"name\"] = data[strtab[\"off\"] + s[\"name\"]:end].decode()\n")
    lines.add("\n")
    lines.add("    # группы по порядку раскладки\n")
    lines.add("    def group(s):\n")
    lines.add("        n = s[\"name\"]\n")
    lines.add("        if n == \".multiboot\":\n")
    lines.add("            return 0\n")
    lines.add("        if n == \".tbheap\":\n")
    lines.add("            return 6\n")
    lines.add("        if s[\"flags\"] & SHF_TLS:\n")
    lines.add("            return 4\n")
    lines.add("        if s[\"flags\"] & SHF_EXEC:\n")
    lines.add("            return 1\n")
    lines.add("        if not (s[\"flags\"] & SHF_WRITE):\n")
    lines.add("            return 2\n")
    lines.add("        if s[\"type\"] == SHT_NOBITS:\n")
    lines.add("            return 5\n")
    lines.add("        return 3\n")
    lines.add("    alloc = [k for k, s in enumerate(secs) if s[\"flags\"] & SHF_ALLOC and s[\"type\"] in (SHT_PROGBITS, SHT_NOBITS) and s[\"size\"] > 0]\n")
    lines.add("    # переменные потока: сначала с начальными значениями (.tdata), потом нулевые (.tbss)\n")
    lines.add("    for k in alloc:\n")
    lines.add("        if secs[k][\"flags\"] & SHF_TLS and secs[k][\"align\"] > 16:\n")
    lines.add("            fail(\"переменная потока выровнена больше чем на 16 байт\")\n")
    lines.add("    order = sorted(alloc, key=lambda k: (group(secs[k]), secs[k][\"type\"] == SHT_NOBITS, k))\n")
    lines.add("\n")
    lines.add("    # символы, которым нужна ячейка в GOT\n")
    lines.add("    got_syms = []\n")
    lines.add("    for s in secs:\n")
    lines.add("        if s[\"type\"] == SHT_RELA:\n")
    lines.add("            for k in range(s[\"size\"] // 24):\n")
    lines.add("                r_info, = struct.unpack_from(\"<Q\", data, s[\"off\"] + k * 24 + 8)\n")
    lines.add("                if r_info & 0xFFFFFFFF in (9, 41, 42) and r_info >> 32 not in got_syms:\n")
    lines.add("                    got_syms.append(r_info >> 32)\n")
    lines.add("    extra = {\"tb_code_start\": BASE, \"tb_kernel_end\": 0}\n")
    lines.add("    # таблица имён ядра (для загрузчика программ Омниума): все свои глобальные имена → адрес.\n")
    lines.add("    # Размер известен сразу (имена есть), адреса пишутся в конце; лежит в части «только чтение»\n")
    lines.add("    symtab0 = next((s for s in secs if s[\"type\"] == SHT_SYMTAB), None)\n")
    lines.add("    exports = []\n")
    lines.add("    if symtab0 is not None:\n")
    lines.add("        sstr0 = secs[symtab0[\"link\"]]\n")
    lines.add("        for k in range(symtab0[\"size\"] // 24):\n")
    lines.add("            st_name, st_info, _, st_shndx, _, _ = struct.unpack_from(\"<IBBHQQ\", data, symtab0[\"off\"] + k * 24)\n")
    lines.add("            if st_info >> 4 == 0 or st_info & 15 not in (1, 2, 6) or st_shndx == SHN_UNDEF:\n")
    lines.add("                continue\n")
    lines.add("            end = data.index(b\"\\0\", sstr0[\"off\"] + st_name)\n")
    lines.add("            exports.append((data[sstr0[\"off\"] + st_name:end], k))\n")
    lines.add("    exports.sort()\n")
    lines.add("    ext_names = sorted(n.encode() for n in [\"tb_tls_start\", \"tb_tls_end\", \"tb_code_start\", \"tb_code_end\", \"tb_heap_area\"])\n")
    lines.add("    ksym_size = 16 * (len(exports) + len(ext_names)) + sum(len(n) + 1 for n, _ in exports) + sum(len(n) + 1 for n in ext_names)\n")
    lines.add("    addr = BASE\n")
    lines.add("    common_start = 0\n")
    lines.add("    for g in range(7):\n")
    lines.add("        if g == 3:\n")
    lines.add("            addr = align(addr, 4096)\n")
    lines.add("            extra[\"tb_code_end\"] = addr\n")
    lines.add("        if g == 4:\n")
    lines.add("            addr = align(addr, 16)\n")
    lines.add("            extra[\"tb_tls_start\"] = addr\n")
    lines.add("        if g == 5:\n")
    lines.add("            # конец блока переменных потока: на него смотрит FS (выровнен на 16)\n")
    lines.add("            addr = align(addr, 16)\n")
    lines.add("            extra[\"tb_tls_end\"] = addr\n")
    lines.add("        if g == 6:\n")
    lines.add("            common_start = addr        # COMMON — сразу за .bss\n")
    lines.add("            addr = align(addr, 0x400000)\n")
    lines.add("            extra[\"tb_heap_area\"] = addr\n")
    lines.add("        for k in order:\n")
    lines.add("            if group(secs[k]) != g:\n")
    lines.add("                continue\n")
    lines.add("            s = secs[k]\n")
    lines.add("            addr = align(addr, s[\"align\"])\n")
    lines.add("            s[\"addr\"] = addr\n")
    lines.add("            addr += s[\"size\"]\n")
    lines.add("        if g == 2:\n")
    lines.add("            # таблица адресов (GOT): LLVM иногда берёт адрес функции через неё\n")
    lines.add("            addr = align(addr, 8)\n")
    lines.add("            got_at = addr\n")
    lines.add("            addr += 8 * len(got_syms)\n")
    lines.add("            addr = align(addr, 8)\n")
    lines.add("            ksym_at = addr\n")
    lines.add("            addr += ksym_size\n")
    lines.add("    # символы\n")
    lines.add("    symtab = next((s for s in secs if s[\"type\"] == SHT_SYMTAB), None)\n")
    lines.add("    if symtab is None:\n")
    lines.add("        fail(\"в файле нет таблицы символов\")\n")
    lines.add("    sstr = secs[symtab[\"link\"]]\n")
    lines.add("    values = []\n")
    lines.add("    common_at = common_start\n")
    lines.add("    for k in range(symtab[\"size\"] // 24):\n")
    lines.add("        st_name, st_info, st_other, st_shndx, st_value, st_size = struct.unpack_from(\"<IBBHQQ\", data, symtab[\"off\"] + k * 24)\n")
    lines.add("        end = data.index(b\"\\0\", sstr[\"off\"] + st_name)\n")
    lines.add("        name = data[sstr[\"off\"] + st_name:end].decode()\n")
    lines.add("        if st_shndx == SHN_UNDEF:\n")
    lines.add("            if k == 0:\n")
    lines.add("                v = 0\n")
    lines.add("            elif name in extra:\n")
    lines.add("                v = extra[name]\n")
    lines.add("            else:\n")
    lines.add("                fail(\"нет символа: \" + name)\n")
    lines.add("        elif st_shndx == SHN_ABS:\n")
    lines.add("            v = st_value\n")
    lines.add("        elif st_shndx == SHN_COMMON:\n")
    lines.add("            common_at = align(common_at, max(st_value, 1))\n")
    lines.add("            v = common_at\n")
    lines.add("            common_at += st_size\n")
    lines.add("        elif st_shndx >= len(secs) or secs[st_shndx][\"addr\"] is None:\n")
    lines.add("            v = 0\n")
    lines.add("        else:\n")
    lines.add("            v = secs[st_shndx][\"addr\"] + st_value\n")
    lines.add("        values.append((name, v))\n")
    lines.add("    if common_at > extra[\"tb_heap_area\"]:\n")
    lines.add("        fail(\"COMMON налез на кучу\")\n")
    lines.add("    # образ памяти от 1 МБ до конца .bss (куча не пишется в файл)\n")
    lines.add("    end_all = max([secs[k][\"addr\"] + secs[k][\"size\"] for k in order] + [extra[\"tb_heap_area\"]])\n")
    lines.add("    kernel_end = align(end_all, 4096)\n")
    lines.add("    values = [(n, kernel_end if n == \"tb_kernel_end\" else v) for n, v in values]\n")
    lines.add("    file_end = max([secs[k][\"addr\"] + secs[k][\"size\"] for k in order if secs[k][\"type\"] == SHT_PROGBITS] + [BASE, ksym_at + ksym_size])\n")
    lines.add("    image = bytearray(file_end - BASE)\n")
    lines.add("    for j, si in enumerate(got_syms):\n")
    lines.add("        struct.pack_into(\"<Q\", image, got_at - BASE + 8 * j, values[si][1])\n")
    lines.add("    for k in order:\n")
    lines.add("        s = secs[k]\n")
    lines.add("        if s[\"type\"] == SHT_PROGBITS:\n")
    lines.add("            image[s[\"addr\"] - BASE:s[\"addr\"] - BASE + s[\"size\"]] = data[s[\"off\"]:s[\"off\"] + s[\"size\"]]\n")
    lines.add("    # таблица имён: (адрес, где имя, длина) по алфавиту, потом сами имена\n")
    lines.add("    allx = sorted([(n, values[k][1]) for n, k in exports] + [(n, extra[n.decode()]) for n in ext_names])\n")
    lines.add("    strs_at = ksym_at + 16 * len(allx)\n")
    lines.add("    so = 0\n")
    lines.add("    for j, (n, v) in enumerate(allx):\n")
    lines.add("        struct.pack_into(\"<QII\", image, ksym_at - BASE + 16 * j, v, strs_at - ksym_at + so, len(n))\n")
    lines.add("        image[strs_at - BASE + so:strs_at - BASE + so + len(n)] = n\n")
    lines.add("        so += len(n) + 1\n")
    lines.add("    vd = dict(values)\n")
    lines.add("    for nm, val in ((\"tb_ksym_tab\", ksym_at), (\"tb_ksym_n\", len(allx))):\n")
    lines.add("        if nm in vd:\n")
    lines.add("            struct.pack_into(\"<Q\", image, vd[nm] - BASE, val)\n")
    lines.add("    # поправки адресов (x86-64: RELA, прибавка лежит в самой поправке)\n")
    lines.add("    for s in secs:\n")
    lines.add("        if s[\"type\"] == SHT_REL:\n")
    lines.add("            fail(\"REL-поправки не ожидались\")\n")
    lines.add("        if s[\"type\"] != SHT_RELA:\n")
    lines.add("            continue\n")
    lines.add("        target = secs[s[\"info\"]]\n")
    lines.add("        if target[\"addr\"] is None:\n")
    lines.add("            continue\n")
    lines.add("        if target[\"type\"] != SHT_PROGBITS:\n")
    lines.add("            fail(\"поправка в пустом разделе \" + target[\"name\"])\n")
    lines.add("        for k in range(s[\"size\"] // 24):\n")
    lines.add("            r_off, r_info, r_add = struct.unpack_from(\"<QQq\", data, s[\"off\"] + k * 24)\n")
    lines.add("            typ, si = r_info & 0xFFFFFFFF, r_info >> 32\n")
    lines.add("            place = target[\"addr\"] + r_off\n")
    lines.add("            at = place - BASE\n")
    lines.add("            sv = values[si][1]\n")
    lines.add("            if typ == 0:\n")
    lines.add("                continue\n")
    lines.add("            elif typ == 1:                      # R_X86_64_64\n")
    lines.add("                struct.pack_into(\"<Q\", image, at, (sv + r_add) & 0xFFFFFFFFFFFFFFFF)\n")
    lines.add("            elif typ in (2, 4):                 # PC32, PLT32\n")
    lines.add("                v = sv + r_add - place\n")
    lines.add("                if not -0x80000000 <= v < 0x80000000:\n")
    lines.add("                    fail(\"переход слишком далеко: \" + values[si][0])\n")
    lines.add("                struct.pack_into(\"<i\", image, at, v)\n")
    lines.add("            elif typ in (9, 41, 42):            # GOTPCREL: адрес ячейки GOT\n")
    lines.add("                v = got_at + 8 * got_syms.index(si) + r_add - place\n")
    lines.add("                struct.pack_into(\"<i\", image, at, v)\n")
    lines.add("            elif typ == 23:                     # TPOFF32: место переменной потока от конца блока\n")
    lines.add("                struct.pack_into(\"<i\", image, at, sv + r_add - extra[\"tb_tls_end\"])\n")
    lines.add("            elif typ == 18:                     # TPOFF64\n")
    lines.add("                struct.pack_into(\"<q\", image, at, sv + r_add - extra[\"tb_tls_end\"])\n")
    lines.add("            elif typ == 24:                     # PC64\n")
    lines.add("                struct.pack_into(\"<q\", image, at, sv + r_add - place)\n")
    lines.add("            elif typ == 10:                     # R_X86_64_32\n")
    lines.add("                v = sv + r_add\n")
    lines.add("                if not 0 <= v < 0x100000000:\n")
    lines.add("                    fail(\"адрес не влезает в 32 бита: \" + values[si][0])\n")
    lines.add("                struct.pack_into(\"<I\", image, at, v)\n")
    lines.add("            elif typ == 11:                     # R_X86_64_32S\n")
    lines.add("                v = sv + r_add\n")
    lines.add("                if not -0x80000000 <= v < 0x80000000:\n")
    lines.add("                    fail(\"адрес не влезает в 32 бита: \" + values[si][0])\n")
    lines.add("                struct.pack_into(\"<i\", image, at, v)\n")
    lines.add("            elif typ == 12:                     # R_X86_64_16\n")
    lines.add("                struct.pack_into(\"<H\", image, at, (sv + r_add) & 0xFFFF)\n")
    lines.add("            else:\n")
    lines.add("                fail(\"неизвестная поправка %d (символ %s)\" % (typ, values[si][0]))\n")
    lines.add("    entry = dict(values).get(\"_start\")\n")
    lines.add("    if entry is None:\n")
    lines.add("        fail(\"нет _start\")\n")
    lines.add("    code_end = extra[\"tb_code_end\"]\n")
    lines.add("    # снаружи — 32-битный ELF (i386) для Multiboot; два куска: код (чтение+выполнение)\n")
    lines.add("    # и данные (запись), память данных идёт до конца кучи\n")
    lines.add("    file_off = 0x1000\n")
    lines.add("    code_size = min(code_end, file_end) - BASE\n")
    lines.add("    data_file = max(file_end - code_end, 0)\n")
    lines.add("    data_mem = kernel_end - code_end\n")
    lines.add("    out = bytearray()\n")
    lines.add("    out += b\"\\x7fELF\" + bytes([1, 1, 1, 0]) + bytes(8)\n")
    lines.add("    out += struct.pack(\"<HHIIIIIHHHHHH\", 2, 3, 1, entry, 52, 0, 0, 52, 32, 2, 40, 0, 0)\n")
    lines.add("    out += struct.pack(\"<8I\", 1, file_off, BASE, BASE, code_size, code_size, 5, 0x1000)\n")
    lines.add("    out += struct.pack(\"<8I\", 1, file_off + (code_end - BASE), code_end, code_end, data_file, data_mem, 6, 0x1000)\n")
    lines.add("    out += bytes(file_off - len(out))\n")
    lines.add("    out += image\n")
    lines.add("    open(dst, \"wb\").write(out)\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("if __name__ == \"__main__\":\n")
    lines.add("    main(sys.argv)\n")
    return join(lines, "")

modpub func packer_text()
    lines = list text
    lines.add("#!/usr/bin/env python3\n")
    lines.add("# Файлы внутри ядра: tb bare кладёт сюда то, что программа открывает по готовому имени\n")
    lines.add("# (load_font(\"fonts/Inter-Regular.ttf\"), load_image(\"logo.png\")). У ядра нет диска — файлы\n")
    lines.add("# становятся константами в LLVM IR, а библиотека ядра (fopen/fread) находит их по имени.\n")
    lines.add("# Запуск:  python3 pack.py имя1 путь1 имя2 путь2 ... >> программа.ll\n")
    lines.add("import sys\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def esc(b):\n")
    lines.add("    return \"\".join(chr(x) if 32 <= x < 127 and x not in (34, 92) else \"\\\\%02X\" % x for x in b)\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def main(a):\n")
    lines.add("    out, ents = [], []\n")
    lines.add("    for i in range(0, len(a) - 1, 2):\n")
    lines.add("        k = i // 2\n")
    lines.add("        name = a[i].encode(\"utf-8\")\n")
    lines.add("        data = open(a[i + 1], \"rb\").read()\n")
    lines.add("        out.append('@tb_pk%d_n = private constant [%d x i8] c\"%s\\\\00\"' % (k, len(name) + 1, esc(name)))\n")
    lines.add("        if data:\n")
    lines.add("            out.append('@tb_pk%d_d = private constant [%d x i8] c\"%s\", align 16' % (k, len(data), esc(data)))\n")
    lines.add("        else:\n")
    lines.add("            out.append(\"@tb_pk%d_d = private constant [1 x i8] zeroinitializer\" % k)\n")
    lines.add("        ents.append(\"{ ptr, ptr, i64 } { ptr @tb_pk%d_n, ptr @tb_pk%d_d, i64 %d }\" % (k, k, len(data)))\n")
    lines.add("    if ents:\n")
    lines.add("        out.append(\"@tb_packed = global [%d x { ptr, ptr, i64 }] [%s]\" % (len(ents), \", \".join(ents)))\n")
    lines.add("    else:\n")
    lines.add("        out.append(\"@tb_packed = global [1 x { ptr, ptr, i64 }] zeroinitializer\")\n")
    lines.add("    out.append(\"@tb_npacked = global i64 %d\" % len(ents))\n")
    lines.add("    print(\"\\n\".join(out))\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("if __name__ == \"__main__\":\n")
    lines.add("    main(sys.argv[1:])\n")
    return join(lines, "")
