    lines.add("{0x00,0x00,0x00,0x00,0x42,0x66,0x66,0x3e,0x3c,0x1c,0x18,0x18,0x70,0x70,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x18,0x3c,0x5e,0xdb,0xdb,0xdb,0x5e,0x3c,0x18,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0xe6,0x66,0x3c,0x3c,0x18,0x3c,0x3c,0x66,0xc6,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0xc6,0xc6,0xc6,0xc6,0xc6,0xc6,0xc6,0xc6,0xff,0x03,0x03},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x66,0x66,0x66,0x7e,0x06,0x06,0x06,0x06,0x06,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0xda,0xda,0xda,0xda,0xda,0xda,0xda,0xda,0xfe,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0xda,0xda,0xda,0xda,0xda,0xda,0xda,0xda,0xff,0x03,0x03},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x60,0xf0,0x30,0x30,0x3c,0x3e,0x36,0x36,0x3e,0x3c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x02,0xc3,0xc3,0xc3,0xf3,0xfb,0xcb,0xcb,0xfb,0xf3,0x00,0x00},\n")
