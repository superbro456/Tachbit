    lines.add("{0x00,0x00,0x00,0x00,0x00,0x7e,0x60,0x60,0x60,0x7e,0x60,0x60,0x60,0x7e,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0xdb,0x5e,0x7e,0x3c,0x7c,0x7e,0x5e,0xda,0xdb,0x00,0x00},\n")
