    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x3e,0x36,0x36,0x36,0x36,0x66,0xe6,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xe6,0xe6,0xfe,0xfe,0xda,0xda,0xc2,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x66,0x66,0x7e,0x66,0x66,0x66,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x3c,0x66,0x66,0x66,0x66,0x66,0x3c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7e,0x66,0x66,0x66,0x66,0x66,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7c,0x66,0x66,0x66,0x66,0x66,0x7c,0x60,0x60},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x1c,0x32,0x60,0x60,0x60,0x32,0x1c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7e,0x18,0x18,0x18,0x18,0x18,0x18,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x66,0x66,0x66,0x3c,0x3c,0x3c,0x18,0x18,0x38},\n")
    lines.add("{0x00,0x00,0x00,0x18,0x18,0x18,0x18,0x3c,0x7e,0x5a,0xda,0x5a,0x7e,0x3c,0x18,0x18},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x66,0x3c,0x3c,0x18,0x3c,0x6c,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x6c,0x6c,0x6c,0x6c,0x6c,0x6c,0x7e,0x02,0x02},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x66,0x66,0x66,0x3e,0x06,0x06,0x06,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xda,0xda,0xda,0xda,0xda,0xda,0xfe,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xda,0xda,0xda,0xda,0xda,0xda,0xff,0x03,0x03},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xf0,0x30,0x30,0x3e,0x36,0x36,0x3e,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xc3,0xc3,0xc3,0xfb,0xdb,0xfb,0xf3,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x60,0x60,0x60,0x7c,0x66,0x66,0x7c,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7c,0x4c,0x0e,0x3e,0x06,0x5c,0x78,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xcc,0xde,0xd2,0xf2,0xd2,0xde,0xcc,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x3e,0x66,0x66,0x3e,0x36,0x76,0x66,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x34,0x34,0x00,0x7e,0x60,0x60,0x60,0x7e,0x60,0x60,0x60,0x7e,0x00,0x00},\n")
    lines.add("{0x00,0x00,0x00,0x00,0x34,0x34,0x00,0x3c,0x66,0x66,0x7e,0x60,0x62,0x3c,0x00,0x00}\n")
    lines.add("};\n")
    lines.add("TB_API uint32_t *tb_px = 0;\n")
    lines.add("TB_API int tb_gw = 0, tb_gh = 0, tb_gclosed = 0, tb_mx = 0, tb_my = 0, tb_mdown = 0;\n")
    lines.add("TB_API unsigned char tb_keys[256];\n")
    lines.add("TB_API long long tb_last_frame = 0;\n")
    lines.add("// клавиши: буквы и цифры — свой код ASCII (A..Z, 0..9), остальные:\n")
    lines.add("enum { TB_K_ENTER = 10, TB_K_ESC = 27, TB_K_SPACE = 32, TB_K_BACK = 8, TB_K_TAB = 9,\n")
    lines.add("       TB_K_UP = 17, TB_K_DOWN = 18, TB_K_RIGHT = 19, TB_K_LEFT = 20, TB_K_SHIFT = 21 };\n")
    lines.add("#ifdef __APPLE__\n")
    lines.add("#include <objc/message.h>\n")
    lines.add("#include <objc/runtime.h>\n")
    lines.add("#include <CoreGraphics/CoreGraphics.h>\n")
    lines.add("#define TB_MSG(R, o, s) ((R(*)(id, SEL))objc_msgSend)((id)(o), sel_getUid(s))\n")
    lines.add("#define TB_MSG1(R, o, s, A, a) ((R(*)(id, SEL, A))objc_msgSend)((id)(o), sel_getUid(s), a)\n")
    lines.add("#define TB_CLS(n) ((id)objc_getClass(n))\n")
    lines.add("TB_API id tb_nsapp = 0, tb_wnd = 0;\n")
    lines.add("TB_API const unsigned char tb_mac_keys[128] = {\n")
    lines.add("    [0]='A',[1]='S',[2]='D',[3]='F',[4]='H',[5]='G',[6]='Z',[7]='X',[8]='C',[9]='V',[11]='B',[12]='Q',[13]='W',\n")
    lines.add("    [14]='E',[15]='R',[16]='Y',[17]='T',[18]='1',[19]='2',[20]='3',[21]='4',[22]='6',[23]='5',[25]='9',[26]='7',\n")
    lines.add("    [28]='8',[29]='0',[31]='O',[32]='U',[34]='I',[35]='P',[36]=TB_K_ENTER,[37]='L',[38]='J',[40]='K',[45]='N',\n")
    lines.add("    [46]='M',[48]=TB_K_TAB,[49]=TB_K_SPACE,[51]=TB_K_BACK,[53]=TB_K_ESC,[56]=TB_K_SHIFT,[60]=TB_K_SHIFT,\n")
    lines.add("    [76]=TB_K_ENTER,[123]=TB_K_LEFT,[124]=TB_K_RIGHT,[125]=TB_K_DOWN,[126]=TB_K_UP };\n")
    lines.add("// кадр отдаём слою окна готовой картинкой: масштаб под Retina делает видеокарта,\n")
    lines.add("// цвета в пространстве экрана — без пересчёта каждой точки\n")
    lines.add("// CGBitmapContextCreateImage делал копию при записи: каждая новая точка в кадре\n")
    lines.add("// стоила копии страницы памяти. Теперь три своих буфера по кругу: кадр копируется\n")
    lines.add("// одним memcpy, а картинка смотрит прямо в буфер, без копий внутри системы.\n")
    lines.add("TB_API CGColorSpaceRef tb_cgspace = 0;\n")
    lines.add("TB_API uint32_t *tb_pres[3];\n")
    lines.add("TB_API int tb_pres_i = 0;\n")
    lines.add("TB_API id tb_layer = 0;\n")
    lines.add("TB_API BOOL tb_nswnd_close(id v, SEL s, id w) { (void)v; (void)s; (void)w; tb_gclosed = 1; return YES; }\n")
    lines.add("TB_API int tb_gfx_open(const char *title) {\n")
    lines.add("    tb_nsapp = TB_MSG(id, TB_CLS(\"NSApplication\"), \"sharedApplication\");\n")
    lines.add("    TB_MSG1(void, tb_nsapp, \"setActivationPolicy:\", long, 0);\n")
    lines.add("    tb_wnd = ((id(*)(id, SEL, CGRect, unsigned long, unsigned long, BOOL))objc_msgSend)(\n")
    lines.add("        TB_MSG(id, TB_CLS(\"NSWindow\"), \"alloc\"), sel_getUid(\"initWithContentRect:styleMask:backing:defer:\"),\n")
    lines.add("        CGRectMake(0, 0, tb_gw, tb_gh), 1 | 2 | 4, 2, NO);\n")
    lines.add("    if (!tb_wnd) return 0;\n")
    lines.add("    Class dc = objc_allocateClassPair((Class)TB_CLS(\"NSObject\"), \"TachbitWindowDelegate\", 0);\n")
    lines.add("    class_addMethod(dc, sel_getUid(\"windowShouldClose:\"), (IMP)tb_nswnd_close, \"c@:@\");\n")
    lines.add("    objc_registerClassPair(dc);\n")
    lines.add("    TB_MSG1(void, tb_wnd, \"setDelegate:\", id, TB_MSG(id, TB_MSG(id, (id)dc, \"alloc\"), \"init\"));\n")
    lines.add("    id view = TB_MSG(id, TB_MSG(id, TB_CLS(\"NSView\"), \"alloc\"), \"init\");\n")
    lines.add("    TB_MSG1(void, tb_wnd, \"setContentView:\", id, view);\n")
    lines.add("    TB_MSG1(void, view, \"setWantsLayer:\", BOOL, YES);\n")
    lines.add("    tb_layer = TB_MSG(id, view, \"layer\");\n")
    lines.add("    id nearest = TB_MSG1(id, TB_CLS(\"NSString\"), \"stringWithUTF8String:\", const char *, \"nearest\");\n")
    lines.add("    TB_MSG1(void, tb_layer, \"setMagnificationFilter:\", id, nearest);\n")
    lines.add("    CGColorSpaceRef space = CGDisplayCopyColorSpace(CGMainDisplayID());\n")
    lines.add("    if (!space) space = CGColorSpaceCreateDeviceRGB();\n")
    lines.add("    tb_cgspace = space;\n")
    lines.add("    for (int i = 0; i < 3; i++) {\n")
    lines.add("        tb_pres[i] = malloc((size_t)tb_gw * tb_gh * 4);\n")
    lines.add("        if (!tb_pres[i]) return 0;\n")
    lines.add("    }\n")
    lines.add("    TB_MSG1(void, tb_wnd, \"setTitle:\", id, TB_MSG1(id, TB_CLS(\"NSString\"), \"stringWithUTF8String:\", const char *, title));\n")
    lines.add("    TB_MSG1(void, tb_wnd, \"setAcceptsMouseMovedEvents:\", BOOL, YES);\n")
    lines.add("    TB_MSG1(void, tb_wnd, \"makeKeyAndOrderFront:\", id, 0);\n")
    lines.add("    TB_MSG(void, tb_wnd, \"center\");\n")
    lines.add("    TB_MSG(void, tb_nsapp, \"finishLaunching\");\n")
    lines.add("    TB_MSG1(void, tb_nsapp, \"activateIgnoringOtherApps:\", BOOL, YES);\n")
    lines.add("    return 1;\n")
    lines.add("}\n")
    lines.add("TB_API void tb_gfx_events(void) {\n")
    lines.add("    size_t bytes = (size_t)tb_gw * tb_gh * 4;\n")
    lines.add("    uint32_t *buf = tb_pres[tb_pres_i];\n")
    lines.add("    tb_pres_i = (tb_pres_i + 1) % 3;\n")
    lines.add("    memcpy(buf, tb_px, bytes);\n")
    lines.add("    CGDataProviderRef prov = CGDataProviderCreateWithData(0, buf, bytes, 0);\n")
    lines.add("    CGImageRef img = CGImageCreate(tb_gw, tb_gh, 8, 32, tb_gw * 4, tb_cgspace,\n")
    lines.add("        kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Little, prov, 0, false, kCGRenderingIntentDefault);\n")
    lines.add("    TB_MSG1(void, tb_layer, \"setContents:\", id, (id)img);\n")
    lines.add("    CGImageRelease(img);\n")
    lines.add("    CGDataProviderRelease(prov);\n")
    lines.add("    TB_MSG(void, TB_CLS(\"CATransaction\"), \"flush\");\n")
    lines.add("    id mode = TB_MSG1(id, TB_CLS(\"NSString\"), \"stringWithUTF8String:\", const char *, \"kCFRunLoopDefaultMode\");\n")
    lines.add("    while (1) {\n")
    lines.add("        id ev = ((id(*)(id, SEL, unsigned long long, id, id, BOOL))objc_msgSend)(tb_nsapp,\n")
    lines.add("            sel_getUid(\"nextEventMatchingMask:untilDate:inMode:dequeue:\"), ~0ULL, 0, mode, YES);\n")
    lines.add("        if (!ev) break;\n")
    lines.add("        unsigned long t = TB_MSG(unsigned long, ev, \"type\");\n")
    lines.add("        if (t == 1) tb_mdown = 1;\n")
    lines.add("        else if (t == 2) tb_mdown = 0;\n")
    lines.add("        if (t == 1 || t == 2 || t == 5 || t == 6) {\n")
    lines.add("            CGPoint p = TB_MSG(CGPoint, ev, \"locationInWindow\");\n")
    lines.add("            tb_mx = (int)p.x; tb_my = (int)(tb_gh - p.y);\n")
    lines.add("        }\n")
    lines.add("        if (t == 10 || t == 11) {\n")
    lines.add("            unsigned short k = TB_MSG(unsigned short, ev, \"keyCode\");\n")
    lines.add("            if (k < 128 && tb_mac_keys[k]) tb_keys[tb_mac_keys[k]] = t == 10;\n")
    lines.add("            continue;   // клавиши не отдаём окну: иначе Mac пищит\n")
    lines.add("        }\n")
    lines.add("        if (t == 12) {  // Shift\n")
    lines.add("            unsigned long m = TB_MSG(unsigned long, ev, \"modifierFlags\");\n")
    lines.add("            tb_keys[TB_K_SHIFT] = (m & (1UL << 17)) != 0;\n")
    lines.add("        }\n")
    lines.add("        TB_MSG1(void, tb_nsapp, \"sendEvent:\", id, ev);\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("#elif defined(_WIN32)\n")
    lines.add("// окно на Windows: обычное окно Win32, кадр рисует GDI (StretchDIBits), нужна -lgdi32\n")
    lines.add("TB_API HWND tb_hwnd = 0;\n")
    lines.add("TB_API BITMAPINFO tb_bmi;\n")
    lines.add("TB_API int tb_win_key(WPARAM v) {\n")
    lines.add("    if ((v >= 'A' && v <= 'Z') || (v >= '0' && v <= '9')) return (int)v;\n")
    lines.add("    switch (v) {\n")
    lines.add("    case VK_RETURN: return TB_K_ENTER; case VK_ESCAPE: return TB_K_ESC; case VK_SPACE: return TB_K_SPACE;\n")
    lines.add("    case VK_BACK: return TB_K_BACK; case VK_TAB: return TB_K_TAB; case VK_UP: return TB_K_UP;\n")
    lines.add("    case VK_DOWN: return TB_K_DOWN; case VK_LEFT: return TB_K_LEFT; case VK_RIGHT: return TB_K_RIGHT;\n")
    lines.add("    case VK_SHIFT: case VK_LSHIFT: case VK_RSHIFT: return TB_K_SHIFT;\n")
    lines.add("    }\n")
    lines.add("    return 0;\n")
    lines.add("}\n")
    lines.add("TB_API void tb_win_blit(HDC dc) {\n")
    lines.add("    StretchDIBits(dc, 0, 0, tb_gw, tb_gh, 0, 0, tb_gw, tb_gh, tb_px, &tb_bmi, DIB_RGB_COLORS, SRCCOPY);\n")
    lines.add("}\n")
    lines.add("TB_API LRESULT CALLBACK tb_win_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp) {\n")
    lines.add("    switch (msg) {\n")
    lines.add("    case WM_CLOSE: tb_gclosed = 1; return 0;   // окно закроет сама программа: window_alive() вернёт false\n")
    lines.add("    case WM_KEYDOWN: case WM_SYSKEYDOWN: case WM_KEYUP: case WM_SYSKEYUP: {\n")
    lines.add("        int k = tb_win_key(wp);\n")
    lines.add("        if (k) tb_keys[k] = msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN;\n")
    lines.add("        if (wp != VK_F4) return 0;   // Alt+F4 пусть закрывает окно\n")
    lines.add("        break;\n")
    lines.add("    }\n")
    lines.add("    case WM_MOUSEMOVE: tb_mx = (short)LOWORD(lp); tb_my = (short)HIWORD(lp); return 0;\n")
    lines.add("    case WM_LBUTTONDOWN: tb_mdown = 1; tb_mx = (short)LOWORD(lp); tb_my = (short)HIWORD(lp); SetCapture(h); return 0;\n")
    lines.add("    case WM_LBUTTONUP: tb_mdown = 0; tb_mx = (short)LOWORD(lp); tb_my = (short)HIWORD(lp); ReleaseCapture(); return 0;\n")
    lines.add("    case WM_KILLFOCUS: memset(tb_keys, 0, sizeof tb_keys); return 0;\n")
    lines.add("    case WM_PAINT: { PAINTSTRUCT ps; HDC dc = BeginPaint(h, &ps); if (tb_px) tb_win_blit(dc); EndPaint(h, &ps); return 0; }\n")
    lines.add("    }\n")
    lines.add("    return DefWindowProcW(h, msg, wp, lp);\n")
    lines.add("}\n")
    lines.add("TB_API int tb_gfx_open(const char *title) {\n")
    lines.add("    HINSTANCE inst = GetModuleHandleW(0);\n")
    lines.add("    WNDCLASSW wc;\n")
    lines.add("    memset(&wc, 0, sizeof wc);\n")
    lines.add("    wc.lpfnWndProc = tb_win_proc;\n")
    lines.add("    wc.hInstance = inst;\n")
    lines.add("    wc.hCursor = LoadCursor(0, IDC_ARROW);\n")
    lines.add("    wc.lpszClassName = L\"TachbitWindow\";\n")
    lines.add("    RegisterClassW(&wc);\n")
    lines.add("    DWORD style = WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX;\n")
    lines.add("    RECT r = { 0, 0, tb_gw, tb_gh };\n")
    lines.add("    AdjustWindowRect(&r, style, FALSE);\n")
    lines.add("    wchar_t *wt = tb_wide(title);\n")
    lines.add("    tb_hwnd = CreateWindowExW(0, L\"TachbitWindow\", wt ? wt : L\"Tachbit\", style, CW_USEDEFAULT, CW_USEDEFAULT,\n")
    lines.add("        r.right - r.left, r.bottom - r.top, 0, 0, inst, 0);\n")
    lines.add("    free(wt);\n")
    lines.add("    if (!tb_hwnd) return 0;\n")
    lines.add("    memset(&tb_bmi, 0, sizeof tb_bmi);\n")
    lines.add("    tb_bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);\n")
    lines.add("    tb_bmi.bmiHeader.biWidth = tb_gw;\n")
    lines.add("    tb_bmi.bmiHeader.biHeight = -tb_gh;   // строки сверху вниз, как в tb_px\n")
    lines.add("    tb_bmi.bmiHeader.biPlanes = 1;\n")
    lines.add("    tb_bmi.bmiHeader.biBitCount = 32;     // 0x00RRGGBB — ровно формат tb_px\n")
    lines.add("    tb_bmi.bmiHeader.biCompression = BI_RGB;\n")
    lines.add("    ShowWindow(tb_hwnd, SW_SHOW);\n")
    lines.add("    SetForegroundWindow(tb_hwnd);\n")
    lines.add("    return 1;\n")
    lines.add("}\n")
    lines.add("TB_API void tb_gfx_events(void) {\n")
    lines.add("    HDC dc = GetDC(tb_hwnd);\n")
    lines.add("    if (dc) { tb_win_blit(dc); ReleaseDC(tb_hwnd, dc); }\n")
    lines.add("    MSG m;\n")
    lines.add("    while (PeekMessageW(&m, 0, 0, 0, PM_REMOVE)) { TranslateMessage(&m); DispatchMessageW(&m); }\n")
    lines.add("}\n")
    lines.add("#else\n")
    lines.add("#include <X11/Xlib.h>\n")
    lines.add("#include <X11/Xutil.h>\n")
    lines.add("#include <X11/keysym.h>\n")
    lines.add("#include <X11/XKBlib.h>\n")
    lines.add("TB_API Display *tb_dpy = 0;\n")
    lines.add("TB_API Window tb_xw;\n")
    lines.add("TB_API GC tb_xgc;\n")
    lines.add("TB_API XImage *tb_ximg = 0;\n")
    lines.add("TB_API Atom tb_wm_del;\n")
    lines.add("TB_API int tb_gfx_open(const char *title) {\n")
    lines.add("    tb_dpy = XOpenDisplay(0);\n")
    lines.add("    if (!tb_dpy) return 0;\n")
    lines.add("    int scr = DefaultScreen(tb_dpy);\n")
    lines.add("    tb_xw = XCreateSimpleWindow(tb_dpy, RootWindow(tb_dpy, scr), 0, 0, tb_gw, tb_gh, 0, 0, 0);\n")
    lines.add("    tb_xgc = XCreateGC(tb_dpy, tb_xw, 0, 0);\n")
    lines.add("    XSelectInput(tb_dpy, tb_xw, ExposureMask | KeyPressMask | KeyReleaseMask | ButtonPressMask | ButtonReleaseMask | PointerMotionMask);\n")
    lines.add("    Xutf8SetWMProperties(tb_dpy, tb_xw, title, title, 0, 0, 0, 0, 0);\n")
    lines.add("    tb_wm_del = XInternAtom(tb_dpy, \"WM_DELETE_WINDOW\", False);\n")
    lines.add("    XSetWMProtocols(tb_dpy, tb_xw, &tb_wm_del, 1);\n")
    lines.add("    XkbSetDetectableAutoRepeat(tb_dpy, True, 0);\n")
    lines.add("    XMapWindow(tb_dpy, tb_xw);\n")
    lines.add("    tb_ximg = XCreateImage(tb_dpy, DefaultVisual(tb_dpy, scr), 24, ZPixmap, 0, (char *)tb_px, tb_gw, tb_gh, 32, 0);\n")
    lines.add("    return 1;\n")
    lines.add("}\n")
    lines.add("TB_API int tb_x_key(KeySym s) {\n")
    lines.add("    if (s >= XK_a && s <= XK_z) return 'A' + (int)(s - XK_a);\n")
    lines.add("    if (s >= XK_A && s <= XK_Z) return 'A' + (int)(s - XK_A);\n")
    lines.add("    if (s >= XK_0 && s <= XK_9) return '0' + (int)(s - XK_0);\n")
    lines.add("    switch (s) {\n")
    lines.add("    case XK_Return: return TB_K_ENTER; case XK_Escape: return TB_K_ESC; case XK_space: return TB_K_SPACE;\n")
    lines.add("    case XK_BackSpace: return TB_K_BACK; case XK_Tab: return TB_K_TAB; case XK_Up: return TB_K_UP;\n")
    lines.add("    case XK_Down: return TB_K_DOWN; case XK_Left: return TB_K_LEFT; case XK_Right: return TB_K_RIGHT;\n")
    lines.add("    case XK_Shift_L: case XK_Shift_R: return TB_K_SHIFT;\n")
    lines.add("    }\n")
    lines.add("    return 0;\n")
    lines.add("}\n")
    lines.add("TB_API void tb_gfx_events(void) {\n")
    lines.add("    XPutImage(tb_dpy, tb_xw, tb_xgc, tb_ximg, 0, 0, 0, 0, tb_gw, tb_gh);\n")
    lines.add("    while (XPending(tb_dpy)) {\n")
    lines.add("        XEvent e; XNextEvent(tb_dpy, &e);\n")
    lines.add("        if (e.type == ClientMessage && (Atom)e.xclient.data.l[0] == tb_wm_del) tb_gclosed = 1;\n")
    lines.add("        else if (e.type == KeyPress || e.type == KeyRelease) {\n")
    lines.add("            int k = tb_x_key(XLookupKeysym(&e.xkey, 0));\n")
    lines.add("            if (k) tb_keys[k] = e.type == KeyPress;\n")
    lines.add("        } else if (e.type == ButtonPress || e.type == ButtonRelease) {\n")
    lines.add("            if (e.xbutton.button == 1) tb_mdown = e.type == ButtonPress;\n")
    lines.add("            tb_mx = e.xbutton.x; tb_my = e.xbutton.y;\n")
    lines.add("        } else if (e.type == MotionNotify) { tb_mx = e.xmotion.x; tb_my = e.xmotion.y; }\n")
    lines.add("    }\n")
    lines.add("    XFlush(tb_dpy);\n")
    lines.add("}\n")
    lines.add("#endif\n")
    lines.add("TB_API void tb_window_open(long long w, long long h, const char *title) {\n")
    lines.add("    if (tb_px) { tb_err = \"окно уже открыто\"; return; }\n")
    lines.add("    if (w < 1 || h < 1 || w > 8192 || h > 8192) { tb_err = \"размер окна от 1 до 8192\"; return; }\n")
    lines.add("    tb_gw = (int)w; tb_gh = (int)h;\n")
    lines.add("    tb_px = calloc((size_t)tb_gw * tb_gh, 4);\n")
    lines.add("    if (!tb_gfx_open(title)) { free(tb_px); tb_px = 0; tb_err = \"не могу открыть окно: нет экрана\"; return; }\n")
    lines.add("    tb_last_frame = tb_time_ms();\n")
    lines.add("}\n")
    lines.add("// показать кадр, принять клавиши и мышь, держать 60 кадров в секунду; false — окно закрыли\n")
    lines.add("TB_API int tb_window_alive(void) {\n")
    lines.add("    if (!tb_px || tb_gclosed) return 0;\n")
    lines.add("    tb_gfx_events();\n")
    lines.add("    // TB_FPS_FREE=1 — без ограничения 60 кадров (для замеров скорости)\n")
    lines.add("    static int free_fps = -1;\n")
    lines.add("    if (free_fps < 0) free_fps = getenv(\"TB_FPS_FREE\") != 0;\n")
    lines.add("    long long now = tb_time_ms(), wait = 16 - (now - tb_last_frame);\n")
    lines.add("    if (wait > 0 && !free_fps) usleep((useconds_t)wait * 1000);\n")
    lines.add("    tb_last_frame = tb_time_ms();\n")
    lines.add("    return !tb_gclosed;\n")
    lines.add("}\n")
    lines.add("TB_INL void tb_put(long long x, long long y, long long c) {\n")
    lines.add("    if (tb_px && x >= 0 && y >= 0 && x < tb_gw && y < tb_gh) tb_px[y * tb_gw + x] = (uint32_t)c;\n")
    lines.add("}\n")
    lines.add("TB_API void tb_clear_window(long long c) { if (tb_px) for (long long i = 0; i < (long long)tb_gw * tb_gh; i++) tb_px[i] = (uint32_t)c; }\n")
    lines.add("TB_API void tb_draw_pixel(long long x, long long y, long long c) { tb_put(x, y, c); }\n")
    lines.add("TB_API void tb_draw_rect(long long x, long long y, long long w, long long h, long long c) {\n")
    lines.add("    if (!tb_px) return;\n")
    lines.add("    long long x0 = x < 0 ? 0 : x, y0 = y < 0 ? 0 : y, x1 = x + w > tb_gw ? tb_gw : x + w, y1 = y + h > tb_gh ? tb_gh : y + h;\n")
    lines.add("    for (long long j = y0; j < y1; j++) for (long long i = x0; i < x1; i++) tb_px[j * tb_gw + i] = (uint32_t)c;\n")
    lines.add("}\n")
    lines.add("TB_API void tb_draw_circle(long long cx, long long cy, long long r, long long c) {\n")
    lines.add("    for (long long j = -r; j <= r; j++) for (long long i = -r; i <= r; i++)\n")
    lines.add("        if (i * i + j * j <= r * r + r) tb_put(cx + i, cy + j, c);\n")
    lines.add("}\n")
    lines.add("TB_API void tb_draw_line(long long x0, long long y0, long long x1, long long y1, long long c) {\n")
    lines.add("    long long dx = x1 > x0 ? x1 - x0 : x0 - x1, dy = y1 > y0 ? y0 - y1 : y1 - y0;\n")
    lines.add("    long long sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1, e = dx + dy;\n")
    lines.add("    while (1) {\n")
    lines.add("        tb_put(x0, y0, c);\n")
    lines.add("        if (x0 == x1 && y0 == y1) break;\n")
    lines.add("        long long e2 = 2 * e;\n")
    lines.add("        if (e2 >= dy) { e += dy; x0 += sx; }\n")
    lines.add("        if (e2 <= dx) { e += dx; y0 += sy; }\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("// текст: буква 8×16, size — во сколько раз крупнее\n")
    lines.add("TB_API void tb_draw_text(long long x, long long y, const char *s, long long size, long long c) {\n")
    lines.add("    if (size < 1) size = 1;\n")
    lines.add("    const unsigned char *p = (const unsigned char *)s;\n")
    lines.add("    long long cx = x;\n")
    lines.add("    while (*p) {\n")
    lines.add("        unsigned int u = *p++;\n")
    lines.add("        if (u >= 0x80) {   // UTF-8: собрать букву из 2–4 байт\n")
    lines.add("            int more = u >= 0xF0 ? 3 : u >= 0xE0 ? 2 : u >= 0xC0 ? 1 : 0;\n")
    lines.add("            u &= 0x3F >> more;\n")
    lines.add("            while (more-- > 0 && (*p & 0xC0) == 0x80) u = (u << 6) | (*p++ & 0x3F);\n")
    lines.add("        }\n")
    lines.add("        if (u == 0x2013 || u == 0x2014) u = '-';\n")
    lines.add("        if (u == 0xAB || u == 0xBB || u == 0x201C || u == 0x201D) u = '\"';\n")
    lines.add("        if (u == '\\n') { cx = x; y += 16 * size; continue; }\n")
    lines.add("        int g = -1;\n")
    lines.add("        if (u >= 32 && u <= 126) g = (int)u - 32;\n")
    lines.add("        else if (u >= 0x410 && u <= 0x44F) g = 95 + (int)(u - 0x410);\n")
    lines.add("        else if (u == 0x401) g = 159;\n")
    lines.add("        else if (u == 0x451) g = 160;\n")
    lines.add("        if (g < 0) g = '?' - 32;\n")
    lines.add("        for (int row = 0; row < 16; row++) {\n")
    lines.add("            unsigned char bits = tb_font[g][row];\n")
    lines.add("            for (int col = 0; col < 8; col++)\n")
    lines.add("                if (bits & (0x80 >> col)) tb_draw_rect(cx + col * size, y + row * size, size, size, c);\n")
    lines.add("        }\n")
    lines.add("        cx += 8 * size;\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("TB_API int tb_key_down(const char *name) {\n")
    lines.add("    static const struct { const char *n; int k; } names[] = {\n")
    lines.add("        {\"left\", TB_K_LEFT}, {\"right\", TB_K_RIGHT}, {\"up\", TB_K_UP}, {\"down\", TB_K_DOWN}, {\"space\", TB_K_SPACE},\n")
    lines.add("        {\"enter\", TB_K_ENTER}, {\"escape\", TB_K_ESC}, {\"backspace\", TB_K_BACK}, {\"tab\", TB_K_TAB}, {\"shift\", TB_K_SHIFT} };\n")
    lines.add("    for (unsigned i = 0; i < sizeof names / sizeof names[0]; i++) if (strcmp(name, names[i].n) == 0) return tb_keys[names[i].k];\n")
    lines.add("    if (name[0] && !name[1]) {\n")
    lines.add("        int ch = (unsigned char)name[0];\n")
    lines.add("        if (ch >= 'a' && ch <= 'z') ch -= 32;\n")
    lines.add("        return tb_keys[ch];\n")
    lines.add("    }\n")
    lines.add("    return 0;\n")
    lines.add("}\n")
    lines.add("TB_API long long tb_mouse_x(void) { return tb_mx; }\n")
    lines.add("TB_API long long tb_mouse_y(void) { return tb_my; }\n")
    lines.add("TB_API int tb_mouse_down(void) { return tb_mdown; }\n")
    lines.add("#endif\n")
    return join(lines, "")

modpub func linker_text()
    lines = list text
    lines.add("#!/usr/bin/env python3\n")
    lines.add("# Маленький компоновщик для ядер Tachbit: один файл .o (ELF, 32 бита, i386) → ядро .elf.\n")
    lines.add("# Нужен, чтобы tachbit bare работал без ld.lld (на Mac его не всегда можно поставить).\n")
    lines.add("# Раскладка та же, что в файле сборки компилятора:\n")
    lines.add("#   1 МБ: .multiboot, код, константы  (только чтение)\n")
    lines.add("#   данные, .tbtls (переменные потока подряд), .bss\n")
    lines.add("#   с границы 4 МБ: .tbheap (куча, в файл не пишется)\n")
    lines.add("# Запуск:  python3 elf_link.py вход.o выход.elf      (лишние -m/-T для совместимости с ld пропускаются)\n")
    lines.add("import struct\n")
    lines.add("import sys\n")
    lines.add("\n")
    lines.add("R_386_NONE, R_386_32, R_386_PC32 = 0, 1, 2\n")
    lines.add("SHT_PROGBITS, SHT_SYMTAB, SHT_NOBITS, SHT_REL, SHT_RELA = 1, 2, 8, 9, 4\n")
    lines.add("SHF_WRITE, SHF_ALLOC, SHF_EXEC = 1, 2, 4\n")
    lines.add("SHN_UNDEF, SHN_ABS, SHN_COMMON = 0, 0xFFF1, 0xFFF2\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def fail(msg):\n")
    lines.add("    sys.stderr.write(\"компоновка ядра: \" + msg + \"\\n\")\n")
    lines.add("    sys.exit(1)\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def align(x, a):\n")
    lines.add("    return x if a <= 1 else (x + a - 1) // a * a\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("def main(argv):\n")
    lines.add("    files = []\n")
    lines.add("    i = 1\n")
    lines.add("    while i < len(argv):\n")
    lines.add("        a = argv[i]\n")
    lines.add("        if a in (\"-m\", \"-T\"):\n")
    lines.add("            i += 2\n")
    lines.add("            continue\n")
    lines.add("        if a == \"-o\":\n")
    lines.add("            files.append((\"out\", argv[i + 1]))\n")
    lines.add("            i += 2\n")
    lines.add("            continue\n")
    lines.add("        files.append((\"in\", a))\n")
    lines.add("        i += 1\n")
    lines.add("    ins = [f for k, f in files if k == \"in\"]\n")
    lines.add("    outs = [f for k, f in files if k == \"out\"]\n")
    lines.add("    if len(outs) == 1 and len(ins) == 1:\n")
    lines.add("        src, dst = ins[0], outs[0]\n")
    lines.add("    elif not outs and len(ins) == 2:\n")
    lines.add("        src, dst = ins\n")
    lines.add("    else:\n")
    lines.add("        fail(\"нужно: elf_link.py вход.o -o выход.elf\")\n")
    lines.add("    data = open(src, \"rb\").read()\n")
    lines.add("    if data[:4] != b\"\\x7fELF\" or data[4] != 1 or data[5] != 1:\n")
    lines.add("        fail(\"вход — не 32-битный ELF\")\n")
    lines.add("    (e_type, e_machine) = struct.unpack_from(\"<HH\", data, 16)\n")
    lines.add("    if e_type != 1 or e_machine != 3:\n")
    lines.add("        fail(\"вход — не объектный файл i386\")\n")
    lines.add("    e_shoff, = struct.unpack_from(\"<I\", data, 32)\n")
    lines.add("    e_shentsize, e_shnum, e_shstrndx = struct.unpack_from(\"<HHH\", data, 46)\n")
    lines.add("    secs = []\n")
    lines.add("    for k in range(e_shnum):\n")
    lines.add("        name, typ, flags, addr, off, size, link, info, al, entsize = struct.unpack_from(\"<10I\", data, e_shoff + k * e_shentsize)\n")
    lines.add("        secs.append(dict(name=name, type=typ, flags=flags, off=off, size=size, link=link, info=info, align=max(al, 1), addr=None))\n")
    lines.add("    strtab = secs[e_shstrndx]\n")
    lines.add("    for s in secs:\n")
    lines.add("        end = data.index(b\"\\0\", strtab[\"off\"] + s[\"name\"])\n")
    lines.add("        s[\"name\"] = data[strtab[\"off\"] + s[\"name\"]:end].decode()\n")
    lines.add("\n")
    lines.add("    # группы по порядку раскладки\n")
    lines.add("    def group(s):\n")
    lines.add("        n = s[\"name\"]\n")
    lines.add("        if n == \".multiboot\":\n")
    lines.add("            return 0\n")
    lines.add("        if n == \".tbheap\":\n")
    lines.add("            return 6\n")
    lines.add("        if n == \".tbtls\":\n")
    lines.add("            return 4\n")
    lines.add("        if s[\"flags\"] & SHF_EXEC:\n")
    lines.add("            return 1\n")
    lines.add("        if not (s[\"flags\"] & SHF_WRITE):\n")
    lines.add("            return 2\n")
    lines.add("        if s[\"type\"] == SHT_NOBITS:\n")
    lines.add("            return 5\n")
    lines.add("        return 3\n")
    lines.add("    alloc = [k for k, s in enumerate(secs) if s[\"flags\"] & SHF_ALLOC and s[\"type\"] in (SHT_PROGBITS, SHT_NOBITS) and s[\"size\"] > 0]\n")
    lines.add("    order = sorted(alloc, key=lambda k: (group(secs[k]), k))\n")
    lines.add("\n")
    lines.add("    syms_extra = {}\n")
    lines.add("    addr = 0x100000\n")
    lines.add("    syms_extra[\"tb_code_start\"] = addr\n")
    lines.add("    syms_extra[\"tb_kernel_end\"] = 0\n")
    lines.add("    common_size = 0\n")
    lines.add("    placed = {}\n")
    lines.add("    for g in range(7):\n")
    lines.add("        if g == 3:\n")
    lines.add("            addr = align(addr, 4096)\n")
    lines.add("            syms_extra[\"tb_code_end\"] = addr\n")
    lines.add("        if g == 4:\n")
    lines.add("            syms_extra[\"tb_tls_start\"] = addr\n")
    lines.add("        if g == 5:\n")
    lines.add("            syms_extra[\"tb_tls_end\"] = addr\n")
    lines.add("        if g == 6:\n")
    lines.add("            addr = align(addr, 0x400000)\n")
    lines.add("            syms_extra[\"tb_heap_area\"] = addr\n")
    lines.add("        for k in order:\n")
    lines.add("            if group(secs[k]) != g:\n")
    lines.add("                continue\n")
    lines.add("            s = secs[k]\n")
    lines.add("            addr = align(addr, s[\"align\"])\n")
    lines.add("            s[\"addr\"] = addr\n")
    lines.add("            addr += s[\"size\"]\n")
    lines.add("        if g == 5:\n")
    lines.add("            placed[\"common\"] = addr      # COMMON — сразу за .bss\n")
    lines.add("            secs_common_start = addr\n")
    lines.add("    # символы\n")
    lines.add("    symtab = next((s for s in secs if s[\"type\"] == SHT_SYMTAB), None)\n")
    lines.add("    if symtab is None:\n")
    lines.add("        fail(\"в файле нет таблицы символов\")\n")
    lines.add("    sstr = secs[symtab[\"link\"]]\n")
    lines.add("    nsym = symtab[\"size\"] // 16\n")
    lines.add("    values = []\n")
    lines.add("    common_at = secs_common_start\n")
    lines.add("    for k in range(nsym):\n")
    lines.add("        st_name, st_value, st_size, st_info, st_other, st_shndx = struct.unpack_from(\"<IIIBBH\", data, symtab[\"off\"] + k * 16)\n")
    lines.add("        end = data.index(b\"\\0\", sstr[\"off\"] + st_name)\n")
    lines.add("        name = data[sstr[\"off\"] + st_name:end].decode()\n")
    lines.add("        if st_shndx == SHN_UNDEF:\n")
    lines.add("            if k == 0:\n")
    lines.add("                v = 0\n")
    lines.add("            elif name in syms_extra:\n")
    lines.add("                v = syms_extra[name]\n")
    lines.add("            else:\n")
    lines.add("                fail(\"нет символа: \" + name)\n")
    lines.add("        elif st_shndx == SHN_ABS:\n")
    lines.add("            v = st_value\n")
    lines.add("        elif st_shndx == SHN_COMMON:\n")
    lines.add("            common_at = align(common_at, max(st_value, 1))\n")
    lines.add("            v = common_at\n")
    lines.add("            common_at += st_size\n")
    lines.add("        elif secs[st_shndx][\"addr\"] is None:\n")
    lines.add("            v = 0\n")
    lines.add("        else:\n")
    lines.add("            v = secs[st_shndx][\"addr\"] + st_value\n")
    lines.add("        values.append((name, v))\n")
    lines.add("    if common_at > secs_common_start:\n")
    lines.add("        if syms_extra.get(\"tb_heap_area\", 0) < common_at:\n")
    lines.add("            fail(\"COMMON налез на кучу\")\n")
    lines.add("    # образ памяти от 1 МБ до конца .bss (куча не пишется в файл)\n")
    lines.add("    heap = syms_extra[\"tb_heap_area\"]\n")
    lines.add("    end_all = max([secs[k][\"addr\"] + secs[k][\"size\"] for k in order] + [heap])\n")
    lines.add("    kernel_end = align(end_all, 4096)\n")
    lines.add("    for idx, (name, v) in enumerate(values):\n")
    lines.add("        if name == \"tb_kernel_end\":\n")
    lines.add("            values[idx] = (name, kernel_end)\n")
    lines.add("    file_end = max([secs[k][\"addr\"] + secs[k][\"size\"] for k in order if secs[k][\"type\"] == SHT_PROGBITS] + [0x100000])\n")
    lines.add("    image = bytearray(file_end - 0x100000)\n")
    lines.add("    for k in order:\n")
    lines.add("        s = secs[k]\n")
    lines.add("        if s[\"type\"] == SHT_PROGBITS:\n")
    lines.add("            image[s[\"addr\"] - 0x100000:s[\"addr\"] - 0x100000 + s[\"size\"]] = data[s[\"off\"]:s[\"off\"] + s[\"size\"]]\n")
    lines.add("    # поправки адресов\n")
    lines.add("    for s in secs:\n")
    lines.add("        if s[\"type\"] == SHT_RELA:\n")
    lines.add("            fail(\"RELA-поправки не ожидались\")\n")
    lines.add("        if s[\"type\"] != SHT_REL:\n")
    lines.add("            continue\n")
    lines.add("        target = secs[s[\"info\"]]\n")
    lines.add("        if target[\"addr\"] is None:\n")
    lines.add("            continue\n")
    lines.add("        if target[\"type\"] != SHT_PROGBITS:\n")
    lines.add("            fail(\"поправка в пустом разделе \" + target[\"name\"])\n")
    lines.add("        for k in range(s[\"size\"] // 8):\n")
    lines.add("            r_off, r_info = struct.unpack_from(\"<II\", data, s[\"off\"] + k * 8)\n")
    lines.add("            typ, si = r_info & 0xFF, r_info >> 8\n")
    lines.add("            place = target[\"addr\"] + r_off\n")
    lines.add("            at = place - 0x100000\n")
    lines.add("            a, = struct.unpack_from(\"<I\", image, at)\n")
    lines.add("            sv = values[si][1]\n")
    lines.add("            if typ == R_386_NONE:\n")
    lines.add("                continue\n")
    lines.add("            elif typ == R_386_32:\n")
    lines.add("                v = sv + a\n")
    lines.add("            elif typ == R_386_PC32:\n")
    lines.add("                v = sv + a - place\n")
    lines.add("            else:\n")
    lines.add("                fail(\"неизвестная поправка %d (символ %s)\" % (typ, values[si][0]))\n")
    lines.add("            struct.pack_into(\"<I\", image, at, v & 0xFFFFFFFF)\n")
    lines.add("    entry = dict(values).get(\"_start\")\n")
    lines.add("    if entry is None:\n")
    lines.add("        fail(\"нет _start\")\n")
    lines.add("    code_end = syms_extra[\"tb_code_end\"]\n")
    lines.add("    # два куска: код (чтение+выполнение) и данные (запись), память данных идёт до конца кучи\n")
    lines.add("    hdr_size = 52 + 2 * 32\n")
    lines.add("    file_off = 0x1000\n")
    lines.add("    code_size = min(code_end, file_end) - 0x100000\n")
    lines.add("    data_file = max(file_end - code_end, 0)\n")
    lines.add("    data_mem = kernel_end - code_end\n")
    lines.add("    out = bytearray()\n")
    lines.add("    out += b\"\\x7fELF\" + bytes([1, 1, 1, 0]) + bytes(8)\n")
    lines.add("    out += struct.pack(\"<HHIIIIIHHHHHH\", 2, 3, 1, entry, 52, 0, 0, 52, 32, 2, 40, 0, 0)\n")
    lines.add("    out += struct.pack(\"<8I\", 1, file_off, 0x100000, 0x100000, code_size, code_size, 5, 0x1000)\n")
    lines.add("    out += struct.pack(\"<8I\", 1, file_off + (code_end - 0x100000), code_end, code_end, data_file, data_mem, 6, 0x1000)\n")
    lines.add("    out += bytes(file_off - len(out))\n")
    lines.add("    out += image\n")
    lines.add("    open(dst, \"wb\").write(out)\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("if __name__ == \"__main__\":\n")
    lines.add("    main(sys.argv)\n")
    return join(lines, "")
