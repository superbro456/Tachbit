// Сделано tools/embed_runtime.py из compiler/runtime.h. Не правь руками.
modpub func runtime_text()
    lines = list text
    lines.add("// функции библиотеки: внутри файла (static). Для --llvm файл .ll зовёт их через\n")
    lines.add("// маленькие обёртки tb_x_* (их пишет компилятор в конце библиотеки), LTO встраивает всё обратно\n")
    lines.add("#define TB_API static\n")
    lines.add("#define TB_INL static inline\n")
    lines.add("// то, что видно из .ll (shared, tb_show_N, tb_new_X, обёртки): с --llvm без static\n")
    lines.add("#ifdef TB_LL\n")
    lines.add("#define TB_LLV\n")
    lines.add("#else\n")
    lines.add("#define TB_LLV static\n")
    lines.add("#endif\n")
    lines.add("// Библиотека, которую Tachbit кладёт в начало каждой программы на C.\n")
    lines.add("// Это обычный C. Компилятор на Tachbit встраивает этот текст через runtime_text.tb,\n")
    lines.add("// который делает tools/embed_runtime.py. Поменял этот файл — запусти:\n")
    lines.add("//     python3 tools/embed_runtime.py\n")
    lines.add("#ifdef TB_BARE\n")
    lines.add("// Библиотека ядра Омниума (tb bare): то, что у обычной программы даёт ОС и libc.\n")
    lines.add("// Загрузка (multiboot → 64 бита), своя маленькая libc, память и квоты клеток, прерывания,\n")
    lines.add("// задачи и планировщик, страницы памяти, несколько ядер процессора (ACPI, APIC).\n")
    lines.add("// Компилятор вставляет этот файл в compiler/runtime.h на место строки //@include (tools/embed_runtime.py).\n")
    lines.add("\n")
    lines.add("// ---------- режим без ОС (tb bare): своя маленькая библиотека вместо libc ----------\n")
    lines.add("// Программа сама себе ОС: загружается через multiboot (QEMU, GRUB), пишет на экран\n")
    lines.add("// (текстовый режим VGA) и в последовательный порт COM1, память берёт из своего запаса.\n")
    lines.add("// Есть прерывания, таймер, клавиатура, задачи (background) и страницы памяти; файлов нет.\n")
    lines.add("#include <stddef.h>\n")
    lines.add("#include <stdarg.h>\n")
    lines.add("#include <stdint.h>\n")
    lines.add("// «переменные потока» — настоящие: у каждой задачи свой блок, на него смотрит регистр FS\n")
    lines.add("// (так их не надо копировать при смене задачи, и на нескольких ядрах процессора у каждого свои)\n")
    lines.add("#define _Thread_local __thread __attribute__((tls_model(\"local-exec\")))\n")
    lines.add("#define EOF (-1)\n")
    lines.add("typedef struct tb_file FILE;\n")
    lines.add("#define stdout ((FILE *)1)\n")
    lines.add("#define stderr ((FILE *)2)\n")
    lines.add("typedef long pthread_t;   // 8 байт, как адрес: раскладка задачи та же, что в обычной программе\n")
    lines.add("typedef int pthread_mutex_t;\n")
    lines.add("#define PTHREAD_MUTEX_INITIALIZER 0\n")
    lines.add("#define pthread_mutex_lock(m) ((void)(m))\n")
    lines.add("#define pthread_mutex_unlock(m) ((void)(m))\n")
    lines.add("#define _SC_NPROCESSORS_ONLN 0\n")
    lines.add("\n")
    lines.add("TB_INL void tb_outb(unsigned short port, unsigned char v) { __asm__ volatile(\"outb %0, %1\" : : \"a\"(v), \"Nd\"(port)); }\n")
    lines.add("TB_INL unsigned char tb_inb(unsigned short port) { unsigned char v; __asm__ volatile(\"inb %1, %0\" : \"=a\"(v) : \"Nd\"(port)); return v; }\n")
    lines.add("TB_INL void tb_outw(unsigned short port, unsigned short v) { __asm__ volatile(\"outw %0, %1\" : : \"a\"(v), \"Nd\"(port)); }\n")
    lines.add("TB_INL unsigned short tb_inw(unsigned short port) { unsigned short v; __asm__ volatile(\"inw %1, %0\" : \"=a\"(v) : \"Nd\"(port)); return v; }\n")
    lines.add("TB_INL void tb_outl(unsigned short port, unsigned int v) { __asm__ volatile(\"outl %0, %1\" : : \"a\"(v), \"Nd\"(port)); }\n")
    lines.add("TB_INL unsigned int tb_inl(unsigned short port) { unsigned int v; __asm__ volatile(\"inl %1, %0\" : \"=a\"(v) : \"Nd\"(port)); return v; }\n")
    lines.add("// ядро процессора («звезда»): его номер, кого он сейчас ведёт, свой стек для пустого хода.\n")
    lines.add("// Регистр GS у каждого ядра смотрит на его запись (в самом начале — адрес её самой)\n")
    lines.add("#define TB_NCPU 16\n")
    lines.add("typedef struct tb_cpu_s {\n")
    lines.add("    struct tb_cpu_s *self;\n")
    lines.add("    int id, apic, run, slice, depth, prev;   // run: номер задачи (-1 — пустой ход); depth: вложенность «общего замка»; prev: задача, которую отпустить после смены стека\n")
    lines.add("    uint64_t *idle_frame;\n")
    lines.add("    unsigned char irq_tls[512 + 16] __attribute__((aligned(16)));   // переменные потока для функций прерывания\n")
    lines.add("    unsigned char idle_stack[16384] __attribute__((aligned(16)));\n")
    lines.add("    unsigned char df_stack[16384] __attribute__((aligned(16)));\n")
    lines.add("} tb_cpu;\n")
    lines.add("TB_API tb_cpu tb_cpus[TB_NCPU];\n")
    lines.add("TB_API int tb_ncpu = 1;\n")
    lines.add("TB_INL tb_cpu *tb_me(void) { tb_cpu *c; __asm__ volatile(\"movq %%gs:0, %0\" : \"=r\"(c)); return c; }\n")
    lines.add("// короткое дело библиотеки (память, экран, список задач): прерывания выключены и взят общий\n")
    lines.add("// замок — так его не делят ни прерывание, ни другое ядро процессора. Можно вкладывать\n")
    lines.add("TB_API volatile int tb_bkl = 0;\n")
    lines.add("TB_INL uint64_t tb_irq_save(void) {\n")
    lines.add("    uint64_t f;\n")
    lines.add("    __asm__ volatile(\"pushfq\\npopq %0\\ncli\" : \"=r\"(f) : : \"memory\");\n")
    lines.add("    tb_cpu *c = tb_me();\n")
    lines.add("    if (c->depth++ == 0)\n")
    lines.add("        while (__atomic_exchange_n(&tb_bkl, 1, __ATOMIC_ACQUIRE)) __builtin_ia32_pause();\n")
    lines.add("    return f;\n")
    lines.add("}\n")
    lines.add("TB_INL void tb_irq_restore(uint64_t f) {\n")
    lines.add("    tb_cpu *c = tb_me();\n")
    lines.add("    if (--c->depth == 0) __atomic_store_n(&tb_bkl, 0, __ATOMIC_RELEASE);\n")
    lines.add("    __asm__ volatile(\"pushq %0\\npopfq\" : : \"r\"(f) : \"memory\", \"cc\");\n")
    lines.add("}\n")
    lines.add("// отдать общий замок целиком (задача уходит навсегда — падает или кончилась)\n")
    lines.add("TB_INL void tb_bkl_drop(void) {\n")
    lines.add("    tb_cpu *c = tb_me();\n")
    lines.add("    if (c->depth > 0) { c->depth = 0; __atomic_store_n(&tb_bkl, 0, __ATOMIC_RELEASE); }\n")
    lines.add("}\n")
    lines.add("\n")
    lines.add("// экран 80×25: байт буквы и байт цвета; русские буквы рисуем своим шрифтом (см. tb_vga_font)\n")
    lines.add("TB_API volatile unsigned short *const tb_vga = (volatile unsigned short *)0xB8000;\n")
    lines.add("TB_API int tb_vrow = 0, tb_vcol = 0;\n")
    lines.add("TB_API unsigned char tb_vcolor = 0x0A;   // светло-зелёный на чёрном\n")
    lines.add("TB_API void tb_vga_put(unsigned char ch) {\n")
    lines.add("    if (ch == '\\n') { tb_vcol = 0; tb_vrow++; }\n")
    lines.add("    else if (ch == '\\b') { if (tb_vcol > 0) tb_vcol--; tb_vga[tb_vrow * 80 + tb_vcol] = (unsigned short)(tb_vcolor << 8 | ' '); }\n")
    lines.add("    else {\n")
    lines.add("        tb_vga[tb_vrow * 80 + tb_vcol] = (unsigned short)(tb_vcolor << 8 | ch);\n")
    lines.add("        if (++tb_vcol == 80) { tb_vcol = 0; tb_vrow++; }\n")
    lines.add("    }\n")
    lines.add("    if (tb_vrow == 25) {\n")
    lines.add("        for (int i = 0; i < 24 * 80; i++) tb_vga[i] = tb_vga[i + 80];\n")
    lines.add("        for (int i = 24 * 80; i < 25 * 80; i++) tb_vga[i] = (unsigned short)(tb_vcolor << 8 | ' ');\n")
    lines.add("        tb_vrow = 24;\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("// русские буквы: свои картинки 8×16 кладём в шрифт VGA на места 128..193\n")
    lines.add("TB_API const unsigned char tb_cyr_font[66][16] = {\n")
    lines.add("    {0x00, 0x00, 0x1c, 0x1c, 0x3c, 0x34, 0x36, 0x66, 0x7e, 0x63, 0x63, 0xc3, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x7f, 0x60, 0x60, 0x60, 0x7e, 0x67, 0x63, 0x63, 0x67, 0x7e, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x7e, 0x66, 0x67, 0x66, 0x7e, 0x66, 0x63, 0x63, 0x67, 0x7e, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x7f, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x7e, 0x76, 0x76, 0x76, 0x76, 0x76, 0x76, 0x66, 0x66, 0xff, 0xc3, 0xc3, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x7f, 0x60, 0x60, 0x60, 0x7e, 0x60, 0x60, 0x60, 0x60, 0x7f, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0xdb, 0x7b, 0x7e, 0x3e, 0x3e, 0x7e, 0x7e, 0x7b, 0xdb, 0xdb, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x3c, 0x46, 0x06, 0x06, 0x1c, 0x06, 0x06, 0x06, 0x46, 0x3c, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x00, 0x00, 0x67, 0x67, 0x6f, 0x6f, 0x6b, 0x7b, 0x73, 0x73, 0x73, 0x63, 0x00, 0x00, 0x00, 0x00},\n")
    lines.add("    {0x1c, 0x00, 0x67, 0x67, 0x6f, 0x6f, 0x6b, 0x7b, 0x73, 0x73, 0x73, 0x63, 0x00, 0x00, 0x00, 0x00},\n")
