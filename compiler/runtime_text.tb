    lines.add("    X(CreateDescriptorPool, VkResult, (VkDevice, const VkDescriptorPoolCreateInfo *, const void *, VkDescriptorPool *)) \\\n")
    lines.add("    X(AllocateDescriptorSets, VkResult, (VkDevice, const VkDescriptorSetAllocateInfo *, VkDescriptorSet *)) \\\n")
    lines.add("    X(UpdateDescriptorSets, void, (VkDevice, uint32_t, const VkWriteDescriptorSet *, uint32_t, const void *)) \\\n")
    lines.add("    X(CreatePipelineLayout, VkResult, (VkDevice, const VkPipelineLayoutCreateInfo *, const void *, VkPipelineLayout *)) \\\n")
    lines.add("    X(CreateGraphicsPipelines, VkResult, (VkDevice, uint64_t, uint32_t, const VkGraphicsPipelineCreateInfo *, const void *, VkPipeline *)) \\\n")
