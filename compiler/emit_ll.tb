// Слой 4б. ВЫВОД LLVM IR (опыт, включается флагом --llvm).
// Функции, где только числа (int, dec, bool), условия, циклы и вызовы таких же функций,
// пишутся сразу на языке LLVM (файл .ll), мимо C. Остальное по-прежнему идёт через C.
// Имена и способ вызова те же, что у C (f_<модуль>__<имя>), поэтому clang
// собирает .c и .ll в одну программу, и они зовут друг друга как обычно.
// Это первый шаг: дальше в .ll можно класть то, чего C не скажет (move = noalias,
// пределы чисел, вызовы слитых орбит), — свои проходы LLVM поверх готового LLVM.
use check
use memplan

obj LLGen
    out: list text
    allocas: list text
    slots: list text
    tmp: int
    open: bool
    cont: list text
    brk: list text
    fn: Node
    // xs[i + k] внутри count, у которых номер проверен один раз до цикла ("xs#i#k")
    fast: list text
    fast_depth: int
    // тексты, в которые дописывают на месте (как builders в C): у каждого ещё длина и место
    blds: list text
    // строки уровня файла: готовые тексты, объявления tb_show_N (общие для всех функций)
    decls: list text
    // память функции (как tb_fa / tb_fm в C): "" — своей области нет
    fa: text
    // параметры-ярлыки (link): их значение — по адресу из параметра
    links: list text
    ldecls: list text
    // места выходов последнего вызова f() с несколькими выходами
    mtemps: list text
    // выходы gives: имена; при нескольких выходах их места — адреса из параметров (f__ll)
    outs: list text
    multi_out: bool

// имя функции: то же, что у вывода C
func ll_fname(f: Node)
    mod = ""
    each ch in f.mod
        k = code(ch)
        if (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57)
            mod = mod + ch
        else
            mod = mod + "_"
    return "f_" + mod + "__" + f.name

func ll_has(names: list text, name: text)
    each x in names
        if x == name
            return true
    return false

func ll_simple(c: Comp, t: int)
    k = kind_of(c, t)
    return k == "int" or k == "dec" or k == "bool" or k == "enum"

// значение, которое LLVM держит в регистре: число, bool, enum или текст (указатель)
func ll_val(c: Comp, t: int)
    return ll_simple(c, t) or kind_of(c, t) == "text"

func ll_is_text(c: Comp, t: int)
    return kind_of(c, t) == "text"

// список, который LLVM умеет вести: list int / dec / text / enum / Obj (не by columns) / dict / list.
// В LLVM — указатель на tb_list {data, len, cap, size}, элемент — 8 байт
func ll_numlist(c: Comp, t: int)
    if kind_of(c, t) != "list" or is_cols_list(c, t)
        return false
    e = c.types[t].elem
    if e == 1 or e == 2 or e == 4 or kind_of(c, e) == "enum" or ll_plainobj(c, e) or ll_dict(c, e)
        return true
    // список списков: внутренний — тоже такой список
    return kind_of(c, e) == "list" and ll_numlist(c, e)

// obj by columns: «строка» {список колонок, номер} — в LLVM { ptr, i64 }, как tb_row_X в C.
// Качества — числа и тексты (каждое — своя колонка в tb_cols_X {len, cap, q_a, q_b ...})
func ll_row(c: Comp, t: int)
    if kind_of(c, t) != "obj" or not is_cols_obj(c, t)
        return false
    each f in c.types[t].obj_node.kids
        k = kind_of(c, f.ty)
        if not (k == "int" or k == "dec" or k == "bool" or k == "enum" or k == "text")
            return false
    return true

// список obj by columns: указатель на tb_cols_X, len лежит первым
func ll_colist(c: Comp, t: int)
    return kind_of(c, t) == "list" and is_cols_list(c, t) and ll_row(c, c.types[t].elem)

// выражение-строка: имя, Point(...), pts[i]
func ll_row_ok(c: Comp, n: Node, names: list text)
    if not ll_row(c, n.ty)
        return false
    if n.kind == "name"
        return not n.is_link and not ll_is_global(c, n.name)
    if n.kind == "call" and n.has_ref and n.ref.kind == "obj"
        count i from 0 to len(n.ref.kids) - 1
            if n.kids[i].kind != "missing"
                v = n.kids[i].kids[0]
                if not (ll_val(c, v.ty) and ll_expr_ok(c, v, names))
                    return false
        return true
    if n.kind == "index" and ll_dict(c, n.kids[0].ty)
        return ll_box_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
    if n.kind == "call" or n.kind == "try" or n.kind == "else_err" or (n.kind == "binop" and n.value == "orelse")
        return ll_expr_ok(c, n, names)
    if n.kind == "index"
        return ll_colist(c, n.kids[0].ty) and ll_box_ok(c, n.kids[0], names) and kind_of(c, n.kids[1].ty) == "int" and ll_expr_ok(c, n.kids[1], names)
    return false

func ll_cname(c: Comp, t: int)
    if kind_of(c, t) == "list"
        return c.types[c.types[t].elem].obj_node.name
    return c.types[t].obj_node.name

// ---------- obj by columns ----------

func ll_cneed(g: LLGen, c: Comp, t: int)
    nm = ll_cname(c, t)
    ll_need(g, "declare ptr @tb_lc_new_" + nm + "()\ndeclare void @tb_lc_add_" + nm + "(ptr, ptr, i64, i32)\ndeclare void @tb_lc_set_" + nm + "(ptr, i64, ptr, i64, i32)\ndeclare ptr @tb_lc_from_" + nm + "(i64, ptr)\n")
    return nm

// строка из двух частей
func ll_mkrow(g: LLGen, a: text, i: text)
    r1 = ll_new(g, "%t")
    ll_put(g, r1 + " = insertvalue { ptr, i64 } undef, ptr " + a + ", 0")
    r2 = ll_new(g, "%t")
    ll_put(g, r2 + " = insertvalue { ptr, i64 } " + r1 + ", i64 " + i + ", 1")
    return r2

func ll_rpart(g: LLGen, r: text, k: int)
    x = ll_new(g, "%t")
    ll_put(g, x + " = extractvalue { ptr, i64 } " + r + ", " + k)
    return x

// длина списка колонок: первое поле tb_cols_X
func ll_clen(g: LLGen, base: text)
    r = ll_new(g, "%t")
    ll_put(g, r + " = load i64, ptr " + base)
    return r

// pts[i] с проверкой номера → {pts, i}
func ll_col_at(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    idx = ll_expr(g, c, n.kids[1])
    ln = ll_clen(g, base)
    bad = ll_new(g, "%t")
    ll_put(g, bad + " = icmp uge i64 " + idx + ", " + ln)
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 3)
    ll_label(g, ok)
    return ll_mkrow(g, base, idx)

// Point(...): новая строка — свой список колонок из одного элемента (tb_new_X в C)
func ll_new_row(g: LLGen, c: Comp, n: Node)
    o = n.ref
    args = ""
    tys = ""
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        v = ""
        if n.kids[i].kind == "missing"
            v = ll_default(g, c, ft)
        else
            v = ll_as(g, c, n.kids[i].kids[0], ft)
        if i > 0
            args = args + ", "
            tys = tys + ", "
        args = args + ll_ty(c, ft) + " " + ll_ext(c, ft) + v
        tys = tys + ll_ty(c, ft) + " " + ll_ext(c, ft)
    ll_need(g, "declare ptr @tb_lc_make_" + o.name + "(" + tys + ")\n")
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_lc_make_" + o.name + "(" + args + ")")
    return ll_mkrow(g, r, "0")

// адрес качества строки: колонка q_f (после len и cap), в ней элемент номер i
func ll_row_field_ptr(g: LLGen, c: Comp, n: Node)
    r = ll_expr(g, c, n.kids[0])
    a = ll_rpart(g, r, 0)
    i = ll_rpart(g, r, 1)
    z = ll_new(g, "%t")
    ll_put(g, z + " = icmp eq ptr " + a + ", null")
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + z + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 4)
    ll_label(g, ok)
    o = c.types[n.kids[0].ty].obj_node
    at = 0
    count k from 0 to len(o.kids) - 1
        if o.kids[k].name == n.name
            at = k
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds i8, ptr " + a + ", i64 " + (16 + 8 * at))
    col = ll_new(g, "%t")
    ll_put(g, col + " = load ptr, ptr " + cp)
    ep = ll_new(g, "%t")
    ll_put(g, ep + " = getelementptr inbounds " + ll_mem_ty(c, n.ty) + ", ptr " + col + ", i64 " + i)
    return ep

// [Point(...), ...]: строки во временный массив, потом tb_colsfrom_X
func ll_col_lit(g: LLGen, c: Comp, n: Node)
    nm = ll_cneed(g, c, n.ty)
    nk = len(n.kids)
    if nk == 0
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = call ptr @tb_lc_new_" + nm + "()")
        return r0
    arr = "%\"arr" + ll_new(g, "") + "\""
    g.allocas.add("  " + arr + " = alloca [" + nk + " x { ptr, i64 }]\n")
    count i from 0 to nk - 1
        v = ll_expr(g, c, n.kids[i])
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds { ptr, i64 }, ptr " + arr + ", i64 " + i)
        ll_put(g, "store { ptr, i64 } " + v + ", ptr " + ep)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_lc_from_" + nm + "(i64 " + nk + ", ptr " + arr + ")")
    return r

// each a in pts: a = {pts, i}, len читается на каждом шаге
func ll_each_cols(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    ln = ll_clen(g, base)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    rv = ll_mkrow(g, base, iv)
    et = c.types[n.kids[0].ty].elem
    ll_put(g, "store { ptr, i64 } " + rv + ", ptr " + ll_slot(g, c, n.name, et))
    ll_loop_body(g, c, n.kids[1], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

// list bool: по биту на элемент (tb_bget/tb_bset/tb_badd/tb_bpop из C, LTO их встраивает)
func ll_bits(c: Comp, t: int)
    return kind_of(c, t) == "list" and c.types[t].elem == 3

// в списке адреса (тексты, obj): уборка памяти должна смотреть внутрь
func ll_ptr_elems(c: Comp, t: int)
    e = c.types[t].elem
    return not (e == 1 or e == 2 or kind_of(c, e) == "enum")

func ll_elem_ty(c: Comp, t: int)
    if c.types[t].elem == 2
        return "double"
    if ll_ptr_elems(c, t)
        return "ptr"
    return "i64"

// элемент годится для этого списка: число как число, текст/obj — как значение-коробка
func ll_elem_ok(c: Comp, lt: int, v: Node, names: list text)
    if ll_colist(c, lt)
        return ll_row_ok(c, v, names)
    if ll_bits(c, lt)
        return kind_of(c, v.ty) == "bool" and ll_expr_ok(c, v, names)
    if ll_ptr_elems(c, lt)
        if ll_box(c, v.ty)
            return ll_box_ok(c, v, names)
        return ll_is_text(c, v.ty) and ll_expr_ok(c, v, names)
    return ll_simple(c, v.ty) and ll_expr_ok(c, v, names)

// пометки для LLVM (TBAA): числа в списках и устройство списка (data, len) никогда не лежат
// в одной памяти, а int и dec — тоже. C этого сказать не может: у него len и элементы int —
// оба long long, и после каждой записи в список он заново читает len.
func ll_elem_tag(c: Comp, t: int)
    if c.types[t].elem == 2
        return ", !tbaa !12"
    if ll_ptr_elems(c, t)
        return ", !tbaa !13"
    return ", !tbaa !11"

// список, который LLVM умеет вести: своё имя, качество obj (p.tags), ответ функции, d.keys() ...
func ll_list_name_ok(c: Comp, n: Node, names: list text)
    if not (ll_numlist(c, n.ty) or ll_bits(c, n.ty))
        return false
    if n.kind == "name"
        return not n.is_link and not ll_is_global(c, n.name)
    return ll_box_ok(c, n, names)

// obj (не by columns), у которого все качества LLVM может разложить так же, как C
func ll_plainobj(c: Comp, t: int)
    if kind_of(c, t) != "obj" or is_cols_obj(c, t)
        return false
    each f in c.types[t].obj_node.kids
        k = kind_of(c, f.ty)
        if not (k == "int" or k == "dec" or k == "bool" or k == "enum" or k == "text" or k == "list" or k == "dict" or k == "obj" or k == "task" or k == "channel")
            return false
        if k == "obj" and is_cols_obj(c, f.ty)
            return false
    return true

// имя obj или списка чисел, которое можно отдать другой функции
func ll_ref_name_ok(c: Comp, n: Node)
    return n.kind == "name" and not n.is_link and ll_box(c, n.ty) and not ll_is_global(c, n.name)

// список, obj или dict: в LLVM — указатель
func ll_box(c: Comp, t: int)
    return ll_numlist(c, t) or ll_bits(c, t) or ll_colist(c, t) or ll_plainobj(c, t) or ll_dict(c, t)

// dict с ключом int или text и значением, которое LLVM умеет класть и брать (8 байт, bool — 1)
func ll_dict(c: Comp, t: int)
    if kind_of(c, t) != "dict"
        return false
    kk = kind_of(c, c.types[t].key)
    if not (kk == "int" or kk == "text")
        return false
    e = c.types[t].elem
    return ll_val(c, e) or ll_numlist(c, e) or ll_plainobj(c, e) or ll_row(c, e) or (kind_of(c, e) == "dict" and ll_dict(c, e))

// значение подходит туда, где ждут тип t
func ll_value_ok(c: Comp, t: int, v: Node, names: list text)
    if ll_row(c, t)
        return ll_row_ok(c, v, names)
    if ll_box(c, t)
        return ll_box(c, v.ty) and ll_box_ok(c, v, names)
    if ll_is_text(c, t)
        return ll_is_text(c, v.ty) and ll_expr_ok(c, v, names)
    return ll_simple(c, v.ty) and ll_expr_ok(c, v, names)

// выражение-коробка, которое LLVM умеет посчитать: имя, [1, 2, 3], Ball(...), вызов, p.tags
func ll_box_ok(c: Comp, n: Node, names: list text)
    if not ll_box(c, n.ty)
        return false
    k = n.kind
    if k == "name"
        return ll_ref_name_ok(c, n)
    if k == "list"
        each x in n.kids
            if not ll_elem_ok(c, n.ty, x, names)
                return false
        return true
    if k == "dict"
        i = 0
        repeat while i + 1 < len(n.kids)
            if not (ll_expr_ok(c, n.kids[i], names) and ll_value_ok(c, c.types[n.ty].elem, n.kids[i + 1], names))
                return false
            i += 2
        return true
    if k == "call" and n.has_ref and n.ref.kind == "obj"
        return ll_new_ok(c, n, names)
    if k == "call" or k == "field" or k == "index" or k == "method" or k == "try" or k == "else_err" or (k == "binop" and n.value == "orelse")
        return ll_expr_ok(c, n, names)
    return false

// Ball(name: ..., x: ...): каждое качество — значение, которое LLVM умеет посчитать,
// а пропущенное — то, что LLVM умеет поставить по умолчанию
func ll_new_ok(c: Comp, n: Node, names: list text)
    if not ll_plainobj(c, n.ty)
        return false
    o = n.ref
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        if n.kids[i].kind == "missing"
            if not (ll_val(c, ft) or ll_box(c, ft))
                return false
        else
            v = n.kids[i].kids[0]
            if ll_val(c, ft)
                if not (ll_val(c, v.ty) and ll_expr_ok(c, v, names))
                    return false
            else if ll_box(c, ft)
                if not ll_box_ok(c, v, names)
                    return false
            else
                return false
    return true

// качество в памяти: как в C (long long → i64, double, _Bool → i8, остальное — указатель)
func ll_mem_ty(c: Comp, t: int)
    k = kind_of(c, t)
    if k == "obj" and is_cols_obj(c, t)
        return "{ ptr, i64 }"
    if k == "dec"
        return "double"
    if k == "bool"
        return "i8"
    if k == "int" or k == "enum"
        return "i64"
    return "ptr"

func ll_ty(c: Comp, t: int)
    k = kind_of(c, t)
    if k == "obj" and is_cols_obj(c, t)
        return "{ ptr, i64 }"
    if k == "list" or k == "obj" or k == "text" or k == "dict"
        return "ptr"
    if k == "dec"
        return "double"
    if k == "bool"
        return "i1"
    if k == "none"
        return "void"
    return "i64"

// у bool в C (_Bool) при вызове есть пометка zeroext
func ll_ext(c: Comp, t: int)
    if kind_of(c, t) == "bool"
        return "zeroext "
    return ""

// shared снаружи функций: из LLVM — та же переменная C (v_имя); пока только int и dec
func ll_global_ok(c: Comp, name: text, t: int)
    if not ll_is_global(c, name)
        return true
    k = kind_of(c, t)
    return k == "int" or k == "dec"

// ярлык (link) на число или текст: в LLVM — указатель на саму переменную того, кто позвал
func ll_link_ok(c: Comp, t: int)
    k = kind_of(c, t)
    return k == "int" or k == "dec" or k == "enum" or k == "text"

func ll_is_global(c: Comp, name: text)
    each g in c.globals
        if g.name == name
            return true
    return false

// десятичное число, которое LLVM примет как есть: целая часть + дробь из половинок/четвертей/восьмых
func ll_dec_ok(v: text)
    if ll_dec_exact(v)
        return true
    m, k = ll_dec_parts(v)
    return len(m) <= 15 and k <= 22

// дробь, которую LLVM примет как есть (.5, .25, .125 ...)
func ll_dec_exact(v: text)
    dot = find(v, ".")
    if dot < 0 or dot > 15
        return false
    frac = cut(v, dot + 1, len(v) - 1)
    repeat while len(frac) > 0 and ends_with(frac, "0")
        frac = cut(frac, 0, len(frac) - 2)
    return frac == "" or frac == "5" or frac == "25" or frac == "75" or frac == "125" or frac == "375" or frac == "625" or frac == "875"

// 2.60 → m = "26", k = 1 (2.6 = 26 / 10^1); m без нулей впереди и позади
func ll_dec_parts(v: text) gives m: text, k: int
    dot = find(v, ".")
    frac = cut(v, dot + 1, len(v) - 1)
    repeat while len(frac) > 0 and ends_with(frac, "0")
        frac = cut(frac, 0, len(frac) - 2)
    m = cut(v, 0, dot - 1) + frac
    k = len(frac)
    repeat while len(m) > 1 and starts_with(m, "0")
        m = cut(m, 1, len(m) - 1)

// любая дробь: целое m делим на 10^k. Оба числа точные, а деление в IEEE округляет
// верно — получается то же число, что у C из "2.6". LLVM сворачивает его сразу.
func ll_decimal(g: LLGen, v: text)
    if ll_dec_exact(v)
        return v
    m, k = ll_dec_parts(v)
    r = ll_new(g, "%t")
    ll_put(g, r + " = fdiv double " + m + ".0, 1.0e" + k)
    return r

// текст в кавычках, как его понимает C ("a\\n\\x41"): байты без кавычек; ok = false — LLVM не берём
func ll_str_bytes(v: text) gives bytes: list int, ok: bool
    ok = true
    i = 1
    last = len(v) - 2
    repeat while i <= last
        b = code(v[i])
        if b != 92
            bytes.add(b)
            i += 1
            skip
        if i + 1 > last
            ok = false
            return
        e = v[i + 1]
        i += 2
        if e == "n"
            bytes.add(10)
        else if e == "t"
            bytes.add(9)
        else if e == "r"
            bytes.add(13)
        else if e == "\\" or e == "\"" or e == "'" or e == "?"
            bytes.add(code(e))
        else if e == "a"
            bytes.add(7)
        else if e == "b"
            bytes.add(8)
        else if e == "f"
            bytes.add(12)
        else if e == "v"
            bytes.add(11)
        else if e == "e"
            bytes.add(27)
        else if code(e) >= 48 and code(e) <= 55
            // \0, \012: до трёх восьмеричных цифр
            x = code(e) - 48
            got = 1
            repeat while got < 3 and i <= last and code(v[i]) >= 48 and code(v[i]) <= 55
                x = x * 8 + code(v[i]) - 48
                i += 1
                got += 1
            bytes.add(x % 256)
        else if e == "x"
            x = 0
            got = 0
            repeat while i <= last and ll_hexval(v[i]) >= 0
                x = (x * 16 + ll_hexval(v[i])) % 256
                i += 1
                got += 1
            if got == 0
                ok = false
                return
            bytes.add(x)
        else
            ok = false
            return

func ll_hexval(ch: text)
    k = code(ch)
    if k >= 48 and k <= 57
        return k - 48
    if k >= 97 and k <= 102
        return k - 87
    if k >= 65 and k <= 70
        return k - 55
    return -1

func ll_str_ok(v: text)
    bytes, ok = ll_str_bytes(v)
    // \0 внутри текста: C обрежет его на нуле, длина по sizeof будет другой — оставим C
    each b in bytes
        if b == 0
            return false
    return ok

// ---------- какие функции можно писать прямо в LLVM ----------

func ll_expr_ok(c: Comp, n: Node, names: list text)
    k = n.kind
    if k == "number" or k == "enumval" or k == "bool"
        return true
    if k == "decimal"
        return ll_dec_ok(n.value)
    if k == "string"
        return ll_str_ok(n.value)
    if k == "name"
        if n.is_link
            return ll_link_ok(c, n.ty)
        if ll_row(c, n.ty)
            return ll_row_ok(c, n, names)
        return (ll_val(c, n.ty) or ll_box(c, n.ty)) and ll_global_ok(c, n.name, n.ty)
    if k == "list" or k == "dict"
        return ll_box_ok(c, n, names)
    if k == "call" and n.has_ref and n.ref.kind == "obj"
        if ll_row(c, n.ty)
            return ll_row_ok(c, n, names)
        return ll_new_ok(c, n, names)
    if k == "method"
        b = n.kids[0]
        if ll_dict(c, b.ty)
            // d.has(k), d.remove(k), d.keys(), d.values()
            if not ll_box_ok(c, b, names)
                return false
            if n.name == "has" or n.name == "remove"
                return len(n.kids) == 2 and ll_expr_ok(c, n.kids[1].kids[0], names)
            if n.name == "keys" or n.name == "values"
                return ll_numlist(c, n.ty) or ll_colist(c, n.ty)
            return false
        // xs.pop(): последний элемент списка
        return n.name == "pop" and ll_list_name_ok(c, b, names)
    if k == "unary"
        return ll_simple(c, n.ty) and ll_expr_ok(c, n.kids[0], names)
    if k == "try"
        return ll_expr_ok(c, n.kids[0], names)
    if k == "else_err"
        return ll_expr_ok(c, n.kids[0], names) and ll_block_ok(c, n.kids[1], names)
    if k == "binop"
        op = n.value
        if op == "orelse"
            // f() or запасное
            return (ll_val(c, n.ty) or ll_box(c, n.ty)) and ll_expr_ok(c, n.kids[0], names) and ll_value_ok(c, n.ty, n.kids[1], names)
        if ll_is_text(c, n.ty)
            // a + b + 5: склеивание текста с числами и bool
            if op != "+"
                return false
            each part in ll_concat_parts(c, n)
                if not (ll_val(c, part.ty) and kind_of(c, part.ty) != "enum" and ll_expr_ok(c, part, names))
                    return false
            return true
        if ll_is_text(c, n.kids[0].ty) or ll_is_text(c, n.kids[1].ty)
            // сравнение текстов
            if not (ll_is_text(c, n.kids[0].ty) and ll_is_text(c, n.kids[1].ty))
                return false
            if not (op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=")
                return false
            return ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
        if not (ll_simple(c, n.ty) and ll_simple(c, n.kids[0].ty) and ll_simple(c, n.kids[1].ty))
            return false
        if not (op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or")
            return false
        if op == "%" and kind_of(c, n.ty) == "dec"
            return false
        return ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
    if k == "index"
        if ll_colist(c, n.kids[0].ty)
            return ll_row_ok(c, n, names)
        if ll_dict(c, n.kids[0].ty)
            return ll_box_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
        if ll_is_text(c, n.kids[0].ty)
            return kind_of(c, n.kids[1].ty) == "int" and ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
        return ll_list_name_ok(c, n.kids[0], names) and kind_of(c, n.kids[1].ty) == "int" and ll_expr_ok(c, n.kids[1], names)
    if k == "call" and not n.has_ref and n.name == "len"
        if len(n.kids) != 1 or len(n.kids[0].kids) != 1
            return false
        a = n.kids[0].kids[0]
        if ll_is_text(c, a.ty)
            return ll_expr_ok(c, a, names)
        if ll_dict(c, a.ty) or ll_colist(c, a.ty)
            return ll_box_ok(c, a, names)
        return ll_list_name_ok(c, a, names)
    if k == "call" and not n.has_ref and (n.name == "print" or n.name == "show")
        each a in n.kids
            if a.kind == "missing" or len(a.kids) == 0
                return false
            v = a.kids[0]
            if ll_row(c, v.ty)
                if not ll_row_ok(c, v, names)
                    return false
            else if ll_box(c, v.ty)
                if not ll_box_ok(c, v, names)
                    return false
            else if not (ll_val(c, v.ty) and ll_expr_ok(c, v, names))
                return false
        return true
    if k == "field"
        return ll_field_ok(c, n, names)
    if k == "call" and not n.has_ref
        // остальные встроенные (to_int, split, cut, abs ...): через обёртку tb_llb_N из C
        if ll_has(["asm", "len", "print", "show"], n.name)
            return false
        if not (kind_of(c, n.ty) == "none" or ll_val(c, n.ty) or ll_box(c, n.ty))
            return false
        each a in n.kids
            if a.kind == "missing" or len(a.kids) == 0
                return false
            v = a.kids[0]
            if not (ll_val(c, v.ty) or ll_box(c, v.ty))
                return false
            if not ll_value_ok(c, v.ty, v, names)
                return false
        return true
    if k == "call"
        // звать можно любую функцию Tachbit с таким же простым видом: свою из LLVM или из C
        if not n.has_ref or n.ref.kind != "func" or not ll_head_ok(c, n.ref)
            return false
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            a = n.kids[i]
            if a.kind == "missing" or len(a.kids) == 0
                return false
            if i < len(params.kids) and params.kids[i].is_link
                // f(x) с link: отдаём адрес x — имя, качество obj или xs[i]
                v = a.kids[0]
                if v.ty != params.kids[i].ty or not ll_addr_ok(c, v, names)
                    return false
            else if ll_box(c, a.kids[0].ty)
                if not ll_box_ok(c, a.kids[0], names)
                    return false
            else if not ll_expr_ok(c, a.kids[0], names)
                return false
        return true
    return false

// у чего можно взять адрес для link: имя, качество obj или xs[i]
func ll_addr_ok(c: Comp, v: Node, names: list text)
    if v.kind == "name"
        return ll_expr_ok(c, v, names) and ll_global_ok(c, v.name, v.ty)
    if v.kind == "field"
        return ll_field_ok(c, v, names)
    if v.kind == "index"
        return ll_list_name_ok(c, v.kids[0], names) and ll_expr_ok(c, v, names)
    return false

func ll_addr(g: LLGen, c: Comp, v: Node)
    if v.kind == "name"
        return ll_slot(g, c, v.name, v.ty)
    if v.kind == "field"
        return ll_field_ptr(g, c, v)
    return ll_elem_ptr(g, c, v)

// аргумент при вызове: тип, пометка, значение; строка by columns — двумя частями
func ll_arg(g: LLGen, c: Comp, p: Node, v: text)
    if not p.is_link and ll_row(c, p.ty)
        return "ptr " + ll_rpart(g, v, 0) + ", i64 " + ll_rpart(g, v, 1)
    return ll_pty(c, p) + " " + ll_pext(c, p) + v

// тип параметра при вызове: у link — адрес
func ll_pty(c: Comp, p: Node)
    if p.is_link
        return "ptr"
    if ll_row(c, p.ty)
        return "ptr, i64"
    return ll_ty(c, p.ty)

func ll_pext(c: Comp, p: Node)
    if p.is_link
        return ""
    return ll_ext(c, p.ty)

// все части цепочки a + b + (c + d) у текста: по порядку слева направо
func ll_concat_parts(c: Comp, n: Node) gives parts: list Node
    ll_concat_walk(c, n, parts)

func ll_concat_walk(c: Comp, n: Node, parts: list Node)
    if n.kind != "binop" or n.value != "+" or not ll_is_text(c, n.ty)
        parts.add(n)
        return
    ll_concat_walk(c, n.kids[0], parts)
    ll_concat_walk(c, n.kids[1], parts)

// p.x: p — obj (имя, users[i], a.b, f()), x — число, текст или коробка
func ll_field_ok(c: Comp, n: Node, names: list text)
    if n.kind == "field" and len(n.kids) == 1 and ll_row(c, n.kids[0].ty)
        return ll_val(c, n.ty) and ll_row_ok(c, n.kids[0], names)
    if n.kind != "field" or len(n.kids) != 1 or not ll_plainobj(c, n.kids[0].ty) or not (ll_val(c, n.ty) or ll_box(c, n.ty))
        return false
    b = n.kids[0]
    if b.kind == "name"
        return not b.is_link and not ll_is_global(c, b.name)
    // users[2].name, a.b.c, f().x
    return b.kind != "list" and ll_box_ok(c, b, names)

func ll_block_ok(c: Comp, b: Node, names: list text)
    if len(b.kids) == 0
        return true
    each s in b.kids
        if not ll_stmt_ok(c, s, names)
            return false
    return true

func ll_stmt_ok(c: Comp, n: Node, names: list text)
    k = n.kind
    if k == "assign"
        if n.is_link and not ll_link_ok(c, n.ty)
            return false
        if not ll_global_ok(c, n.name, n.ty)
            return false
        if ll_row(c, n.ty)
            // p = Point(...), q = pts[1], e = Point()
            return n.is_link == false and (len(n.kids) == 0 or ll_row_ok(c, n.kids[0], names))
        if ll_box(c, n.ty)
            // xs = list int (пустой), xs = [1, 2], b = Ball(...), ys = xs
            if len(n.kids) == 0
                return ll_numlist(c, n.ty) or ll_bits(c, n.ty) or ll_colist(c, n.ty) or ll_dict(c, n.ty)
            return ll_box_ok(c, n.kids[0], names)
        if len(n.kids) == 0
            // s = text, n = int: значение по умолчанию
            return ll_val(c, n.ty)
        return len(n.kids) == 1 and ll_val(c, n.ty) and ll_expr_ok(c, n.kids[0], names)
    if k == "set"
        t = n.kids[0]
        op = n.value
        if t.kind == "index" and ll_dict(c, t.kids[0].ty)
            // d[k] = v, d[k] += v
            if not (ll_box_ok(c, t.kids[0], names) and ll_expr_ok(c, t.kids[1], names))
                return false
            if op == "="
                return ll_value_ok(c, n.ty, n.kids[1], names)
            if ll_is_text(c, n.ty)
                return op == "+=" and ll_val(c, n.kids[1].ty) and kind_of(c, n.kids[1].ty) != "enum" and ll_expr_ok(c, n.kids[1], names)
            if not (ll_simple(c, n.ty) and ll_simple(c, n.kids[1].ty))
                return false
            if not (op == "+=" or op == "-=" or op == "*=" or op == "/=")
                return false
            return ll_expr_ok(c, n.kids[1], names)
        if ll_row(c, n.ty) and t.kind == "index"
            // pts[i] = Point(...): строку целиком
            return op == "=" and ll_row_ok(c, t, names) and ll_row_ok(c, n.kids[1], names)
        if (ll_box(c, n.ty) or ll_is_text(c, n.ty)) and t.kind == "index"
            // names[i] = "x", pts[i] = p: только  =
            return op == "=" and ll_expr_ok(c, t, names) and ll_elem_ok(c, t.kids[0].ty, n.kids[1], names)
        if ll_box(c, n.ty)
            // p.tags = xs: только  =
            if op != "="
                return false
            if t.kind == "field"
                if not ll_field_ok(c, t, names)
                    return false
            else if t.kind != "name" or t.is_link or ll_is_global(c, t.name)
                return false
            return ll_box_ok(c, n.kids[1], names)
        if not ll_val(c, n.ty)
            return false
        if ll_is_text(c, n.ty)
            // текст: только  s = x  и  s += x  (имя или качество obj)
            if not (op == "=" or op == "+=")
                return false
            if t.kind == "field"
                if not ll_field_ok(c, t, names)
                    return false
            else if t.kind != "name" or (t.is_link and not ll_link_ok(c, t.ty)) or ll_is_global(c, t.name)
                return false
            if op == "+=" and not (ll_val(c, n.kids[1].ty) and kind_of(c, n.kids[1].ty) != "enum")
                return false
            return ll_expr_ok(c, n.kids[1], names)
        if t.kind == "index"
            if not ll_expr_ok(c, t, names)
                return false
        else if t.kind == "field"
            if not ll_field_ok(c, t, names)
                return false
        else if t.kind != "name" or (t.is_link and not ll_link_ok(c, t.ty)) or not ll_global_ok(c, t.name, t.ty)
            return false
        if not (op == "=" or op == "+=" or op == "-=" or op == "*=" or op == "/=")
            return false
        return ll_expr_ok(c, n.kids[1], names)
    if k == "if"
        each x in n.kids
            if x.kind == "block"
                if not ll_block_ok(c, x, names)
                    return false
            else if not ll_expr_ok(c, x, names)
                return false
        return true
    if k == "count"
        return not n.is_par and ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names) and ll_block_ok(c, n.kids[2], names)
    if k == "repeat_times" or k == "repeat_while"
        return ll_expr_ok(c, n.kids[0], names) and ll_block_ok(c, n.kids[1], names)
    if k == "each"
        if n.by_vec or n.is_par or n.by_piece or not ll_block_ok(c, n.kids[1], names)
            return false
        lt = n.kids[0].ty
        if ll_is_text(c, lt)
            return ll_expr_ok(c, n.kids[0], names)
        return (ll_numlist(c, lt) or ll_bits(c, lt) or ll_colist(c, lt) or ll_dict(c, lt)) and ll_box_ok(c, n.kids[0], names)
    if k == "skip" or k == "stop"
        return true
    if k == "temp"
        return ll_block_ok(c, n.kids[0], names)
    if k == "linkdecl"
        // c: link first.notes — ярлык на число или текст
        return ll_link_ok(c, n.ty) and n.kids[0].ty == n.ty and ll_addr_ok(c, n.kids[0], names) and not ll_is_global(c, n.name)
    if k == "fail"
        return ll_is_text(c, n.kids[0].ty) and ll_expr_ok(c, n.kids[0], names)
    if k == "multi"
        // a, b = f(): выходы сразу в переменные
        call = n.kids[len(n.kids) - 1]
        if not ll_expr_ok(c, call, names)
            return false
        if call.kind == "try" or call.kind == "else_err"
            call = call.kids[0]
        if call.kind != "call" or not call.has_ref or call.ref.kind != "func"
            return false
        count i from 0 to len(n.kids) - 2
            t = n.kids[i]
            if t.is_link or ll_is_global(c, t.name) or t.ty != call.ref.kids[2].kids[i].ty
                return false
        return true
    if k == "match"
        subj = n.kids[0]
        if not ((ll_simple(c, subj.ty) and kind_of(c, subj.ty) != "dec") or ll_is_text(c, subj.ty))
            return false
        if not ll_expr_ok(c, subj, names)
            return false
        count i from 1 to len(n.kids) - 1
            cs = n.kids[i]
            each v in cs.kids[0].kids
                if not ll_expr_ok(c, v, names)
                    return false
            if not ll_block_ok(c, cs.kids[1], names)
                return false
        return true
    if k == "return"
        return len(n.kids) == 0 or ll_expr_ok(c, n.kids[0], names)
    if k == "expr_stmt"
        e = n.kids[0]
        if e.kind == "method" and ll_dict(c, e.kids[0].ty)
            if e.name == "clear"
                return ll_box_ok(c, e.kids[0], names)
            return ll_expr_ok(c, e, names)
        if e.kind == "method" and ll_colist(c, e.kids[0].ty)
            return e.name == "add" and len(e.kids) == 2 and ll_box_ok(c, e.kids[0], names) and ll_row_ok(c, e.kids[1].kids[0], names)
        if e.kind == "method" and ll_list_name_ok(c, e.kids[0], names)
            if e.name == "add"
                return len(e.kids) == 2 and ll_elem_ok(c, e.kids[0].ty, e.kids[1].kids[0], names)
            return e.name == "pop" or e.name == "clear"
        return (e.kind == "call" or e.kind == "try" or e.kind == "else_err") and ll_expr_ok(c, e, names)
    return false

func ll_head_ok(c: Comp, f: Node)
    if f.irq != 0
        return false
    outs = f.kids[2].kids
    each o in outs
        // выходы gives: числа, тексты, коробки
        if not (ll_val(c, o.ty) or ll_box(c, o.ty) or ll_row(c, o.ty))
            return false
    if len(outs) <= 1 and not (kind_of(c, f.ty) == "none" or ll_val(c, f.ty) or ll_box(c, f.ty) or ll_row(c, f.ty))
        return false
    // строка by columns идёт в двух регистрах; если регистров не хватит, C кладёт её в стек
    // целиком — так что строки разрешаем, только пока всё влезает в 6 регистров
    regs = 0
    rows = false
    each p in f.kids[0].kids
        if p.is_link or kind_of(c, p.ty) != "dec"
            regs += 1
        if not p.is_link and ll_row(c, p.ty)
            regs += 1
            rows = true
    if len(outs) > 1
        regs += len(outs)
    if rows and regs > 6
        return false
    each p in f.kids[0].kids
        if p.is_link
            if not ll_link_ok(c, p.ty)
                return false
            each o in outs
                if o.name == p.name
                    return false
        else if not (ll_val(c, p.ty) or ll_box(c, p.ty) or ll_row(c, p.ty))
            return false
    return true

// первая строка, из-за которой функция осталась в C (заходит внутрь блоков)
func ll_why(c: Comp, b: Node, names: list text) gives line: int
    each s in b.kids
        if not ll_stmt_ok(c, s, names)
            each x in s.kids
                if x.kind == "block" and not ll_block_ok(c, x, names)
                    return ll_why(c, x, names)
                if x.kind == "case"
                    each y in x.kids
                        if y.kind == "block" and not ll_block_ok(c, y, names)
                            return ll_why(c, y, names)
            return s.line
    return 0

// c.ll_names: функции, которые пойдут в LLVM. Сначала все подходящие по виду,
// потом выкидываем тех, кто зовёт выкинутых, пока список не перестанет меняться.
modpub func ll_pick(c: Comp, program: Node)
    names = list text
    if c.bare
        c.ll_names = names
        return
    each top in program.kids
        if top.kind == "func" and ll_head_ok(c, top)
            names.add(ll_fname(top))
    changed = true
    repeat while changed
        changed = false
        keep = list text
        each top in program.kids
            if top.kind == "func" and ll_has(names, ll_fname(top))
                if ll_block_ok(c, top.kids[1], names)
                    keep.add(ll_fname(top))
                else
                    changed = true
        names = keep
    c.ll_names = names
    // функции из C, которые зовут из LLVM: в C они без static
    ext = list text
    each top in program.kids
        if top.kind == "func" and ll_has(names, ll_fname(top))
            ll_calls(top.kids[1], names, ext)
    c.ll_ext = ext
    bis = list Node
    each top in program.kids
        if top.kind == "func" and ll_has(names, ll_fname(top))
            ll_builtins(top.kids[1], bis)
    c.ll_bi = bis

// встроенные функции внутри функций для LLVM: каждой — свой номер обёртки
func ll_builtins(n: Node, bis: list Node)
    if n.kind == "call" and not n.has_ref and not ll_has(["asm", "len", "print", "show"], n.name)
        n.temp_no = len(bis)
        bis.add(n)
    each kid in n.kids
        ll_builtins(kid, bis)

func ll_calls(n: Node, names: list text, ext: list text)
    if n.kind == "call" and n.has_ref and n.ref.kind == "func"
        nm = ll_fname(n.ref)
        if not ll_has(names, nm) and not ll_has(ext, nm)
            ext.add(nm)
    each kid in n.kids
        ll_calls(kid, names, ext)

// ---------- вывод ----------

func ll_put(g: LLGen, s: text)
    if not g.open
        // код после return / stop: свой блок, до него никто не дойдёт
        g.tmp += 1
        g.out.add("d" + g.tmp + ":\n")
        g.open = true
    g.out.add("  " + s + "\n")

// конец блока: br / ret / unreachable
func ll_term(g: LLGen, s: text)
    ll_put(g, s)
    g.open = false

func ll_label(g: LLGen, name: text)
    if g.open
        g.out.add("  br label %" + name + "\n")
    g.out.add(name + ":\n")
    g.open = true

func ll_new(g: LLGen, prefix: text)
    g.tmp += 1
    return prefix + g.tmp

// место переменной в памяти функции (LLVM сам превратит его в регистр)
func ll_slot(g: LLGen, c: Comp, name: text, t: int)
    if ll_has(g.links, name)
        // link-параметр: его «место» — адрес переменной того, кто позвал
        return "%\"p." + name + "\""
    if ll_has(g.ldecls, name)
        // ярлык внутри функции: адрес лежит в своей ячейке
        r = ll_new(g, "%t")
        ll_put(g, r + " = load ptr, ptr %\"l." + name + "\"")
        return r
    if ll_is_global(c, name)
        gs = "@\"v_" + name + "\""
        ll_need(g, gs + " = external hidden global " + ll_ty(c, t) + "\n")
        return gs
    s = "%\"v." + name + "." + ll_ty(c, t) + "\""
    if not ll_has(g.slots, s)
        g.slots.add(s)
        g.allocas.add("  " + s + " = alloca " + ll_ty(c, t) + "\n")
    return s

func ll_crash(g: LLGen, line: int, what: int)
    ll_put(g, "call void @tb_ll_crash(i32 " + line + ", i32 " + what + ")")
    ll_term(g, "unreachable")

// значение n как тип want (int → dec, если надо)
func ll_as(g: LLGen, c: Comp, n: Node, want: int)
    v = ll_expr(g, c, n)
    if kind_of(c, want) == "dec" and kind_of(c, n.ty) != "dec"
        r = ll_new(g, "%t")
        ll_put(g, r + " = sitofp i64 " + v + " to double")
        return r
    return v

func ll_to_dec(g: LLGen, c: Comp, v: text, t: int)
    if kind_of(c, t) == "dec"
        return v
    r = ll_new(g, "%t")
    ll_put(g, r + " = sitofp i64 " + v + " to double")
    return r

func ll_call(g: LLGen, c: Comp, n: Node)
    f = n.ref
    if len(f.kids[2].kids) > 1
        // f() с несколькими выходами отдельной строкой: выходы — во временные места
        outs = list text
        each o in f.kids[2].kids
            tmp = "%\"mo" + ll_new(g, "") + "\""
            g.allocas.add("  " + tmp + " = alloca " + ll_ty(c, o.ty) + "\n")
            outs.add(tmp)
        ll_call_multi(g, c, n, outs)
        g.mtemps = outs
        return "0"
    params = f.kids[0]
    args = ""
    count i from 0 to len(n.kids) - 1
        p = params.kids[i]
        arg = n.kids[i].kids[0]
        v = ""
        if p.is_link
            v = ll_addr(g, c, arg)
        else
            v = ll_expr(g, c, arg)
            if kind_of(c, p.ty) == "dec"
                v = ll_to_dec(g, c, v, arg.ty)
        if i > 0
            args = args + ", "
        args = args + ll_arg(g, c, p, v)
    callee = ll_ext(c, f.ty) + ll_ty(c, f.ty) + " @\"" + ll_fname(f) + "\"(" + args + ")"
    if kind_of(c, f.ty) == "none"
        ll_put(g, "call " + callee)
        return "0"
    r = ll_new(g, "%t")
    ll_put(g, r + " = call " + callee)
    return r

// and / or: правую часть считаем, только если она нужна
func ll_logic(g: LLGen, c: Comp, n: Node)
    a = ll_expr(g, c, n.kids[0])
    left = ll_new(g, "L")
    ll_label(g, left)
    right = ll_new(g, "L")
    done = ll_new(g, "L")
    if n.value == "and"
        ll_term(g, "br i1 " + a + ", label %" + right + ", label %" + done)
    else
        ll_term(g, "br i1 " + a + ", label %" + done + ", label %" + right)
    ll_label(g, right)
    b = ll_expr(g, c, n.kids[1])
    right_end = ll_new(g, "L")
    ll_label(g, right_end)
    ll_term(g, "br label %" + done)
    ll_label(g, done)
    r = ll_new(g, "%t")
    short = "false"
    if n.value == "or"
        short = "true"
    ll_put(g, r + " = phi i1 [ " + short + ", %" + left + " ], [ " + b + ", %" + right_end + " ]")
    return r

func ll_binop(g: LLGen, c: Comp, n: Node)
    op = n.value
    if op == "and" or op == "or"
        return ll_logic(g, c, n)
    a = ll_expr(g, c, n.kids[0])
    b = ll_expr(g, c, n.kids[1])
    return ll_arith(g, c, op, a, n.kids[0].ty, b, n.kids[1].ty, n.ty, n.line)

// a op b, когда оба значения уже посчитаны (для x += y и xs[i] += y тоже)
func ll_arith(g: LLGen, c: Comp, op: text, a0: text, ta: int, b0: text, tb: int, rt: int, line: int)
    a = a0
    b = b0
    r = ll_new(g, "%t")
    cmp = op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
    if cmp
        if kind_of(c, ta) == "dec" or kind_of(c, tb) == "dec"
            a = ll_to_dec(g, c, a, ta)
            b = ll_to_dec(g, c, b, tb)
            fc = "oeq"
            if op == "!="
                fc = "une"
            else if op == "<"
                fc = "olt"
            else if op == ">"
                fc = "ogt"
            else if op == "<="
                fc = "ole"
            else if op == ">="
                fc = "oge"
            ll_put(g, r + " = fcmp " + fc + " double " + a + ", " + b)
            return r
        ic = "eq"
        if op == "!="
            ic = "ne"
        else if op == "<"
            ic = "slt"
        else if op == ">"
            ic = "sgt"
        else if op == "<="
            ic = "sle"
        else if op == ">="
            ic = "sge"
        ll_put(g, r + " = icmp " + ic + " " + ll_ty(c, ta) + " " + a + ", " + b)
        return r
    if kind_of(c, rt) == "dec"
        a = ll_to_dec(g, c, a, ta)
        b = ll_to_dec(g, c, b, tb)
        fo = "fadd"
        if op == "-"
            fo = "fsub"
        else if op == "*"
            fo = "fmul"
        else if op == "/"
            fo = "fdiv"
        ll_put(g, r + " = " + fo + " double " + a + ", " + b)
        return r
    if op == "/" or op == "%"
        // деление на ноль: как в C — остановка с номером строки
        z = ll_new(g, "%t")
        bad = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_put(g, z + " = icmp eq i64 " + b + ", 0")
        ll_term(g, "br i1 " + z + ", label %" + bad + ", label %" + ok + ", !prof !0")
        ll_label(g, bad)
        what = 0
        if op == "%"
            what = 1
        ll_crash(g, line, what)
        ll_label(g, ok)
        io = "sdiv"
        if op == "%"
            io = "srem"
        ll_put(g, r + " = " + io + " i64 " + a + ", " + b)
        return r
    io = "add nsw"
    if op == "-"
        io = "sub nsw"
    else if op == "*"
        io = "mul nsw"
    ll_put(g, r + " = " + io + " i64 " + a + ", " + b)
    return r

func ll_expr(g: LLGen, c: Comp, n: Node)
    k = n.kind
    if k == "number" or k == "enumval"
        return n.value
    if k == "decimal"
        return ll_decimal(g, n.value)
    if k == "bool"
        return n.value
    if k == "string"
        name, sn = ll_strconst(g, n.value)
        return name
    if k == "name"
        if ll_is_bld(g, c, n)
            // текст могут где-то сохранить: следующее дописывание сначала сделает копию
            ll_put(g, "store i64 -1, ptr " + ll_rl(g, n.name))
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_ty(c, n.ty) + ", ptr " + ll_slot(g, c, n.name, n.ty))
        return r
    if k == "unary"
        v = ll_expr(g, c, n.kids[0])
        r = ll_new(g, "%t")
        if n.value == "not"
            ll_put(g, r + " = xor i1 " + v + ", true")
        else if kind_of(c, n.ty) == "dec"
            ll_put(g, r + " = fneg double " + v)
        else
            ll_put(g, r + " = sub nsw i64 0, " + v)
        return r
    if k == "try"
        // try f(): сломалась — сразу выходим, ошибка остаётся в tb_err для того, кто нас звал
        v = ll_expr(g, c, n.kids[0])
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp ne ptr " + e + ", null")
        no = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
        ll_label(g, no)
        ll_bail(g, c)
        ll_label(g, ok)
        return v
    if k == "else_err"
        // v = f() else err: сломалась — блок с текстом ошибки в err, tb_err снова пустой
        v = ll_expr(g, c, n.kids[0])
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp ne ptr " + e + ", null")
        no = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
        ll_label(g, no)
        ll_put(g, "store ptr " + e + ", ptr " + ll_slot(g, c, n.name, 4))
        ll_put(g, "store ptr null, ptr " + ll_errp(g))
        ll_block(g, c, n.kids[1])
        ll_label(g, ok)
        return v
    if k == "binop" and n.value == "orelse"
        // f() or запасное: сломалась — tb_err снова пустой, берём запасное
        a = ll_as(g, c, n.kids[0], n.ty)
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp ne ptr " + e + ", null")
        here = ll_new(g, "L")
        ll_label(g, here)
        no = ll_new(g, "L")
        done = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + done)
        ll_label(g, no)
        ll_put(g, "store ptr null, ptr " + ll_errp(g))
        b = ll_as(g, c, n.kids[1], n.ty)
        no_end = ll_new(g, "L")
        ll_label(g, no_end)
        ll_term(g, "br label %" + done)
        ll_label(g, done)
        r = ll_new(g, "%t")
        ll_put(g, r + " = phi " + ll_ty(c, n.ty) + " [ " + a + ", %" + here + " ], [ " + b + ", %" + no_end + " ]")
        return r
    if k == "list"
        return ll_list_lit(g, c, n)
    if k == "dict"
        return ll_dict_lit(g, c, n)
    if k == "method" and ll_dict(c, n.kids[0].ty)
        base = ll_expr(g, c, n.kids[0])
        if n.name == "has"
            kp = ll_key_ptr(g, c, n.kids[0].ty, n.kids[1].kids[0])
            h = ll_new(g, "%t")
            ll_put(g, h + " = call i32 @tb_x_dhas(ptr " + base + ", ptr " + kp + ")")
            r = ll_new(g, "%t")
            ll_put(g, r + " = icmp ne i32 " + h + ", 0")
            return r
        if n.name == "remove"
            kp = ll_key_ptr(g, c, n.kids[0].ty, n.kids[1].kids[0])
            ll_put(g, "call void @tb_x_dremove(ptr " + base + ", ptr " + kp + ")")
            return "0"
        if n.name == "clear"
            ll_put(g, "call void @tb_x_dclear(ptr " + base + ", i32 " + n.line + ")")
            return "0"
        r = ll_new(g, "%t")
        fn = "tb_x_dkeys_copy"
        if n.name == "values"
            fn = "tb_x_dvals_copy"
        ll_put(g, r + " = call ptr @" + fn + "(ptr " + base + ")")
        if ll_colist(c, n.ty)
            // значения-строки лежат подряд по 16 байт: из них — список колонок
            cn = ll_cneed(g, c, n.ty)
            vd = ll_new(g, "%t")
            ll_put(g, vd + " = load ptr, ptr " + r)
            vl = ll_len(g, r)
            r2 = ll_new(g, "%t")
            ll_put(g, r2 + " = call ptr @tb_lc_from_" + cn + "(i64 " + vl + ", ptr " + vd + ")")
            return r2
        return r
    if k == "call" and n.has_ref and n.ref.kind == "obj"
        if ll_row(c, n.ty)
            return ll_new_row(g, c, n)
        return ll_new_obj(g, c, n)
    if k == "method" and ll_bits(c, n.kids[0].ty)
        bl = ll_expr(g, c, n.kids[0])
        r = ll_new(g, "%t")
        ll_put(g, r + " = call zeroext i1 @tb_x_bpop(ptr " + bl + ", i32 " + n.line + ")")
        return r
    if k == "method"
        // xs.pop()
        base = ll_expr(g, c, n.kids[0])
        p = ll_new(g, "%t")
        ll_put(g, p + " = call ptr @tb_x_pop(ptr " + base + ", i32 " + n.line + ")")
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + p + ll_elem_tag(c, n.kids[0].ty))
        return r
    if k == "binop"
        if ll_is_text(c, n.ty)
            return ll_concat(g, c, n)
        if ll_is_text(c, n.kids[0].ty)
            return ll_tcmp(g, c, n)
        return ll_binop(g, c, n)
    if k == "field"
        fp = ll_field_ptr(g, c, n)
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_mem_ty(c, n.ty) + ", ptr " + fp)
        if kind_of(c, n.ty) == "bool"
            r2 = ll_new(g, "%t")
            ll_put(g, r2 + " = trunc i8 " + r + " to i1")
            return r2
        return r
    if k == "index" and ll_dict(c, n.kids[0].ty)
        // d[k]: нет ключа — остановка, как в C
        dt = n.kids[0].ty
        base = ll_expr(g, c, n.kids[0])
        kp = ll_key_ptr(g, c, dt, n.kids[1])
        p = ll_new(g, "%t")
        ll_put(g, p + " = call ptr @tb_x_dget(ptr " + base + ", ptr " + kp + ", i32 " + n.line + ")")
        return ll_load_val(g, c, c.types[dt].elem, p)
    if k == "index" and ll_is_text(c, n.kids[0].ty)
        // s[i]: текст из одного байта (как tb_char_at в C)
        sv = ll_q(g, c, n.kids[0])
        iv = ll_expr(g, c, n.kids[1])
        known = "-1"
        if ll_is_bld(g, c, n.kids[0])
            known = ll_new(g, "%t")
            ll_put(g, known + " = load i64, ptr " + ll_rl(g, n.kids[0].name))
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_x_char_at(ptr " + sv + ", i64 " + iv + ", i64 " + known + ", i32 " + n.line + ")")
        return r
    if k == "index" and ll_colist(c, n.kids[0].ty)
        return ll_col_at(g, c, n)
    if k == "index" and ll_bits(c, n.kids[0].ty)
        bl = ll_expr(g, c, n.kids[0])
        bi = ll_expr(g, c, n.kids[1])
        r = ll_new(g, "%t")
        ll_put(g, r + " = call zeroext i1 @tb_x_bget(ptr " + bl + ", i64 " + bi + ", i32 " + n.line + ")")
        return r
    if k == "index"
        ep = ll_elem_ptr(g, c, n)
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + ep + ll_elem_tag(c, n.kids[0].ty))
        return r
    if k == "call" and not n.has_ref and (n.name == "print" or n.name == "show")
        ll_print(g, c, n, n.name == "print")
        return "0"
    if k == "call" and not n.has_ref and n.name != "len"
        return ll_builtin(g, c, n)
    if k == "call" and not n.has_ref
        a = n.kids[0].kids[0]
        if ll_is_text(c, a.ty)
            // len(s): у текста, в который дописывают, длина уже известна
            if ll_is_bld(g, c, a)
                rl = ll_new(g, "%t")
                ll_put(g, rl + " = load i64, ptr " + ll_rl(g, a.name))
                sv = ll_q(g, c, a)
                tl = ll_new(g, "%t")
                ll_put(g, tl + " = call i64 @tb_x_tlen(ptr " + sv + ")")
                neg = ll_new(g, "%t")
                ll_put(g, neg + " = icmp slt i64 " + rl + ", 0")
                r = ll_new(g, "%t")
                ll_put(g, r + " = select i1 " + neg + ", i64 " + tl + ", i64 " + rl)
                return r
            sv = ll_q(g, c, a)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call i64 @tb_x_tlen(ptr " + sv + ")")
            return r
        if ll_dict(c, a.ty)
            db = ll_expr(g, c, a)
            dl = ll_new(g, "%t")
            ll_put(g, dl + " = call i64 @tb_x_dlen(ptr " + db + ")")
            return dl
        // len(xs)
        base = ll_expr(g, c, a)
        if ll_colist(c, a.ty)
            return ll_clen(g, base)
        return ll_len(g, base)
    return ll_call(g, c, n)

// ---------- тексты ----------

// готовый текст из кода: константа уровня файла; вернёт её имя и длину в байтах
func ll_strconst(g: LLGen, v: text) gives name: text, n: int
    bytes, ok = ll_str_bytes(v)
    g.tmp += 1
    name = "@\"tb.s." + ll_fname(g.fn) + "." + g.tmp + "\""
    body = ""
    hex = "0123456789ABCDEF"
    each b in bytes
        if b >= 32 and b < 127 and b != 34 and b != 92
            body = body + char(b)
        else
            body = body + "\\" + hex[b / 16] + hex[b % 16]
    n = len(bytes)
    g.decls.add(name + " = private unnamed_addr constant [" + (n + 1) + " x i8] c\"" + body + "\\00\", align 1\n")

// объявить tb_show_N (печать значения типа N) один раз на весь файл
func ll_need(g: LLGen, line: text)
    if not ll_has(g.decls, line)
        g.decls.add(line)

func ll_is_bld(g: LLGen, c: Comp, n: Node)
    return n.kind == "name" and not n.is_link and ll_is_text(c, n.ty) and ll_has(g.blds, n.name)

func ll_rl(g: LLGen, name: text)
    return "%\"rl." + name + "\""

func ll_rc(g: LLGen, name: text)
    return "%\"rc." + name + "\""

// прочитать, ничего не сохраняя (print, len, s[i], сравнение, склеивание):
// у текста, в который дописывают, своя память остаётся своей
func ll_q(g: LLGen, c: Comp, n: Node)
    if ll_is_bld(g, c, n)
        r = ll_new(g, "%t")
        ll_put(g, r + " = load ptr, ptr " + ll_slot(g, c, n.name, n.ty))
        return r
    return ll_expr(g, c, n)

// значение как текст (для склеивания и s += x)
func ll_as_text(g: LLGen, c: Comp, n: Node)
    k = kind_of(c, n.ty)
    if k == "text"
        return ll_q(g, c, n)
    v = ll_expr(g, c, n)
    r = ll_new(g, "%t")
    if k == "int"
        ll_put(g, r + " = call ptr @tb_x_itos(i64 " + v + ")")
    else if k == "dec"
        ll_put(g, r + " = call ptr @tb_x_dtos(double " + v + ")")
    else
        z = ll_new(g, "%t")
        ll_put(g, z + " = zext i1 " + v + " to i32")
        ll_put(g, r + " = call ptr @tb_x_btos(i32 " + z + ")")
    return r

// a + b + c: сначала каждая часть и её длина (число — цифрами в буфер на стеке),
// потом одна память ровно под результат и все части подряд — как в C
func ll_concat(g: LLGen, c: Comp, n: Node)
    parts = ll_concat_parts(c, n)
    ptrs = list text
    lens = list text
    each part in parts
        k = kind_of(c, part.ty)
        if k == "int"
            v = ll_expr(g, c, part)
            buf = "%\"buf" + ll_new(g, "") + "\""
            g.allocas.add("  " + buf + " = alloca [24 x i8]\n")
            ns = "%\"bn" + ll_new(g, "") + "\""
            g.allocas.add("  " + ns + " = alloca i64\n")
            p = ll_new(g, "%t")
            ll_put(g, p + " = call ptr @tb_x_digits(i64 " + v + ", ptr " + buf + ", ptr " + ns + ")")
            nl = ll_new(g, "%t")
            ll_put(g, nl + " = load i64, ptr " + ns)
            ptrs.add(p)
            lens.add(nl)
        else if part.kind == "string"
            name, sn = ll_strconst(g, part.value)
            ptrs.add(name)
            lens.add("" + sn)
        else
            p = ll_as_text(g, c, part)
            nl = ll_new(g, "%t")
            ll_put(g, nl + " = call i64 @strlen(ptr " + p + ")")
            ptrs.add(p)
            lens.add(nl)
    total = "1"
    each x in lens
        t = ll_new(g, "%t")
        ll_put(g, t + " = add i64 " + total + ", " + x)
        total = t
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_mem_np(i64 " + total + ")")
    at = r
    count i from 0 to len(ptrs) - 1
        ll_put(g, "call void @llvm.memcpy.p0.p0.i64(ptr " + at + ", ptr " + ptrs[i] + ", i64 " + lens[i] + ", i1 false)")
        nx = ll_new(g, "%t")
        ll_put(g, nx + " = getelementptr inbounds i8, ptr " + at + ", i64 " + lens[i])
        at = nx
    ll_put(g, "store i8 0, ptr " + at)
    return r

// короткий готовый текст без \: сравнить байты прямо, без strcmp (ch == "," в циклах по тексту)
func ll_short_lit(n: Node)
    if n.kind != "string" or len(n.value) < 2 or len(n.value) > 10
        return false
    each ch in n.value
        if ch == "\\"
            return false
    return true

func ll_tcmp(g: LLGen, c: Comp, n: Node)
    op = n.value
    a = n.kids[0]
    b = n.kids[1]
    if (op == "==" or op == "!=") and (ll_short_lit(a) or ll_short_lit(b))
        lit = b
        other = a
        if not ll_short_lit(b)
            lit = a
            other = b
        sv = ll_q(g, c, other)
        body = cut(lit.value, 1, len(lit.value) - 2)
        done = ll_new(g, "L")
        froms = list text
        i = 0
        each ch in body
            bp = ll_new(g, "%t")
            ll_put(g, bp + " = getelementptr inbounds i8, ptr " + sv + ", i64 " + i)
            bv = ll_new(g, "%t")
            ll_put(g, bv + " = load i8, ptr " + bp)
            eq = ll_new(g, "%t")
            ll_put(g, eq + " = icmp eq i8 " + bv + ", " + ll_i8(code(ch)))
            here = ll_new(g, "L")
            ll_label(g, here)
            froms.add(here)
            nx = ll_new(g, "L")
            ll_term(g, "br i1 " + eq + ", label %" + nx + ", label %" + done)
            ll_label(g, nx)
            i += 1
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds i8, ptr " + sv + ", i64 " + i)
        ev = ll_new(g, "%t")
        ll_put(g, ev + " = load i8, ptr " + ep)
        last = ll_new(g, "%t")
        ll_put(g, last + " = icmp eq i8 " + ev + ", 0")
        lastb = ll_new(g, "L")
        ll_label(g, lastb)
        ll_term(g, "br label %" + done)
        ll_label(g, done)
        r = ll_new(g, "%t")
        phi = r + " = phi i1 [ " + last + ", %" + lastb + " ]"
        each f in froms
            phi = phi + ", [ false, %" + f + " ]"
        ll_put(g, phi)
        if op == "!="
            r2 = ll_new(g, "%t")
            ll_put(g, r2 + " = xor i1 " + r + ", true")
            return r2
        return r
    av = ll_q(g, c, a)
    bv = ll_q(g, c, b)
    cr = ll_new(g, "%t")
    ll_put(g, cr + " = call i32 @strcmp(ptr " + av + ", ptr " + bv + ")")
    ic = "eq"
    if op == "!="
        ic = "ne"
    else if op == "<"
        ic = "slt"
    else if op == ">"
        ic = "sgt"
    else if op == "<="
        ic = "sle"
    else if op == ">="
        ic = "sge"
    r = ll_new(g, "%t")
    ll_put(g, r + " = icmp " + ic + " i32 " + cr + ", 0")
    return r

// байт как число i8 со знаком (LLVM пишет i8 от -128 до 127)
func ll_i8(b: int)
    if b > 127
        return "" + (b - 256)
    return "" + b

// print a, b / show a: tb_show_N для каждого значения, между ними пробел
func ll_print(g: LLGen, c: Comp, n: Node, newline: bool)
    sp, sn = ll_strconst(g, "\" \"")
    count i from 0 to len(n.kids) - 1
        v = n.kids[i].kids[0]
        if i > 0
            ll_put(g, "call void @tb_x_ps(ptr " + sp + ")")
        x = ll_q(g, c, v)
        if ll_row(c, v.ty)
            // строку C принимает целиком (две части): отдаём адрес копии
            rs = "%\"rs" + ll_new(g, "") + "\""
            g.allocas.add("  " + rs + " = alloca { ptr, i64 }\n")
            ll_put(g, "store { ptr, i64 } " + x + ", ptr " + rs)
            ll_need(g, "declare void @tb_lc_show_" + v.ty + "(ptr)\n")
            ll_put(g, "call void @tb_lc_show_" + v.ty + "(ptr " + rs + ")")
        else
            decl = "declare void @tb_show_" + v.ty + "(" + ll_ty(c, v.ty) + " " + ll_ext(c, v.ty) + ")\n"
            ll_need(g, decl)
            ll_put(g, "call void @tb_show_" + v.ty + "(" + ll_ty(c, v.ty) + " " + ll_ext(c, v.ty) + x + ")")
    if newline
        nlp, nln = ll_strconst(g, "\"\\n\"")
        ll_put(g, "call void @tb_x_ps(ptr " + nlp + ")")

// дописать part в конец текста name (s += part)
func ll_app(g: LLGen, c: Comp, name: text, t: int, part: Node)
    vars = "ptr " + ll_slot(g, c, name, t) + ", ptr " + ll_rl(g, name) + ", ptr " + ll_rc(g, name) + ", "
    k = kind_of(c, part.ty)
    if k == "int"
        v = ll_expr(g, c, part)
        ll_put(g, "call void @tb_x_app_i(" + vars + "i64 " + v + ")")
    else if part.kind == "string"
        sp, sn = ll_strconst(g, part.value)
        ll_put(g, "call void @tb_x_app_n(" + vars + "ptr " + sp + ", i64 " + sn + ")")
    else
        v = ll_as_text(g, c, part)
        ll_put(g, "call void @tb_x_app(" + vars + "ptr " + v + ")")

// ---------- тексты, в которые дописывают на месте (как в C: find_builders) ----------

func ll_bld_uses(n: Node, name: text)
    if n.kind == "name" and n.name == name
        return true
    each k in n.kids
        if ll_bld_uses(k, name)
            return true
    return false

func ll_bld_bad_all(n: Node, bad: list text)
    if n.kind == "name" or n.kind == "assign"
        bad.add(n.name)
    each k in n.kids
        ll_bld_bad_all(k, bad)

func ll_text_plus(c: Comp, n: Node)
    return n.kind == "binop" and n.value == "+" and ll_is_text(c, n.ty)

// s = s + a + b: слева самое первое — s, и справа s больше нигде нет
func ll_app_form(c: Comp, name: text, v: Node)
    if not ll_text_plus(c, v)
        return false
    r = v
    repeat while ll_text_plus(c, r)
        if ll_bld_uses(r.kids[1], name)
            return false
        r = r.kids[0]
    return r.kind == "name" and r.name == name and not r.is_link

// части, которые дописываются по порядку: s + a + b → a, b
func ll_app_parts(c: Comp, v: Node) gives parts: list Node
    back = list Node
    r = v
    repeat while ll_text_plus(c, r)
        back.add(r.kids[1])
        r = r.kids[0]
    i = len(back) - 1
    repeat while i >= 0
        parts.add(back[i])
        i -= 1

func ll_bld_scan(c: Comp, n: Node, cand: list text, bad: list text)
    k = n.kind
    if k == "each" or k == "count"
        bad.add(n.name)
    if k == "multi"
        ll_bld_bad_all(n, bad)
    if k == "call" and n.has_ref and n.ref.kind == "func"
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link
                ll_bld_bad_all(n.kids[i], bad)
    if k == "assign"
        if n.is_link
            bad.add(n.name)
        else if ll_is_text(c, n.ty) and len(n.kids) == 1 and not n.creates and ll_app_form(c, n.name, n.kids[0])
            cand.add(n.name)
    if k == "set" and n.value == "+=" and n.kids[0].kind == "name" and ll_is_text(c, n.kids[0].ty)
        if n.kids[0].is_link
            bad.add(n.kids[0].name)
        else
            cand.add(n.kids[0].name)
    each kid in n.kids
        ll_bld_scan(c, kid, cand, bad)

func ll_find_blds(g: LLGen, c: Comp, f: Node)
    cand = list text
    bad = list text
    each p in f.kids[0].kids
        if p.is_link
            bad.add(p.name)
    ll_bld_scan(c, f.kids[1], cand, bad)
    each name in cand
        if not ll_has(bad, name) and not ll_has(g.blds, name)
            g.blds.add(name)

// ---------- свои списки и obj ----------

// значение по умолчанию (пропущенное качество obj, xs = list int): как emit_default в C
func ll_default(g: LLGen, c: Comp, t: int)
    k = kind_of(c, t)
    if k == "dec"
        return "0.0"
    if k == "bool"
        return "false"
    if k == "text"
        name, sn = ll_strconst(g, "\"\"")
        return name
    if ll_bits(c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_x_bits_new()")
        return r
    if ll_colist(c, t)
        cn = ll_cneed(g, c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_lc_new_" + cn + "()")
        return r
    if ll_row(c, t)
        return "zeroinitializer"
    if ll_numlist(c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @" + ll_list_new_fn(c, t) + "(i64 8)")
        return r
    if ll_dict(c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_x_dict_new(i32 " + ll_dict_text(c, t) + ", i64 " + ll_vsize(c, t) + ")")
        return r
    if k == "obj"
        return "null"
    return "0"

// [1, 2, 3]: числа во временный массив на стеке, потом tb_list_from_np (как в C)
func ll_list_lit(g: LLGen, c: Comp, n: Node)
    if ll_colist(c, n.ty)
        return ll_col_lit(g, c, n)
    nk = len(n.kids)
    if ll_bits(c, n.ty)
        // [true, false]: байты на стеке, потом tb_bits_from (как в C)
        if nk == 0
            return ll_default(g, c, n.ty)
        barr = "%\"arr" + ll_new(g, "") + "\""
        g.allocas.add("  " + barr + " = alloca [" + nk + " x i8]\n")
        count i from 0 to nk - 1
            bv = ll_expr(g, c, n.kids[i])
            bz = ll_new(g, "%t")
            ll_put(g, bz + " = zext i1 " + bv + " to i8")
            bp = ll_new(g, "%t")
            ll_put(g, bp + " = getelementptr inbounds i8, ptr " + barr + ", i64 " + i)
            ll_put(g, "store i8 " + bz + ", ptr " + bp)
        br = ll_new(g, "%t")
        ll_put(g, br + " = call ptr @tb_x_bits_from(i64 " + nk + ", ptr " + barr + ")")
        return br
    et = ll_elem_ty(c, n.ty)
    if nk == 0
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = call ptr @" + ll_list_new_fn(c, n.ty) + "(i64 8)")
        return r0
    arr = "%\"arr" + ll_new(g, "") + "\""
    g.allocas.add("  " + arr + " = alloca [" + nk + " x " + et + "]\n")
    count i from 0 to nk - 1
        v = ll_as(g, c, n.kids[i], c.types[n.ty].elem)
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds " + et + ", ptr " + arr + ", i64 " + i)
        ll_put(g, "store " + et + " " + v + ", ptr " + ep)
    r = ll_new(g, "%t")
    from_fn = "tb_x_list_from_np"
    if ll_ptr_elems(c, n.ty)
        from_fn = "tb_x_list_from"
    ll_put(g, r + " = call ptr @" + from_fn + "(i64 " + nk + ", i64 8, ptr " + arr + ")")
    return r

// пустой список: из чисел — память без адресов (уборка туда не смотрит), иначе обычная
func ll_list_new_fn(c: Comp, t: int)
    if ll_ptr_elems(c, t)
        return "tb_x_list_new"
    return "tb_x_list_new_np"

// Ball(...): tb_new_Ball из C (все качества по порядку, пропущенные — по умолчанию)
func ll_new_obj(g: LLGen, c: Comp, n: Node)
    o = n.ref
    args = ""
    tys = ""
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        v = ""
        if n.kids[i].kind == "missing"
            v = ll_default(g, c, ft)
        else
            v = ll_as(g, c, n.kids[i].kids[0], ft)
        if i > 0
            args = args + ", "
            tys = tys + ", "
        args = args + ll_ty(c, ft) + " " + ll_ext(c, ft) + v
        tys = tys + ll_ty(c, ft) + " " + ll_ext(c, ft)
    ll_need(g, "declare ptr @tb_new_" + o.name + "(" + tys + ")\n")
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_new_" + o.name + "(" + args + ")")
    return r

// ---------- dict ----------

func ll_dict_text(c: Comp, t: int)
    if kind_of(c, c.types[t].key) == "text"
        return "1"
    return "0"

// размер значения в памяти dict (как sizeof в C)
func ll_vsize(c: Comp, t: int)
    if kind_of(c, c.types[t].elem) == "bool"
        return "1"
    if ll_row(c, c.types[t].elem)
        return "16"
    return "8"

// ключ как адрес (&(K){ключ} в C): своё место на стеке функции
func ll_key_ptr(g: LLGen, c: Comp, dt: int, key: Node)
    kt = c.types[dt].key
    // dict хранит сам адрес текста-ключа: читаем «с сохранением»
    v = ll_expr(g, c, key)
    slot = "%\"key" + ll_new(g, "") + "\""
    g.allocas.add("  " + slot + " = alloca " + ll_ty(c, kt) + "\n")
    ll_put(g, "store " + ll_ty(c, kt) + " " + v + ", ptr " + slot)
    return slot

// значение типа t в памяти: bool — байт
func ll_store_val(g: LLGen, c: Comp, t: int, v: text, at: text)
    if kind_of(c, t) == "bool"
        z = ll_new(g, "%t")
        ll_put(g, z + " = zext i1 " + v + " to i8")
        ll_put(g, "store i8 " + z + ", ptr " + at)
        return
    ll_put(g, "store " + ll_mem_ty(c, t) + " " + v + ", ptr " + at)

func ll_load_val(g: LLGen, c: Comp, t: int, at: text)
    r = ll_new(g, "%t")
    ll_put(g, r + " = load " + ll_mem_ty(c, t) + ", ptr " + at)
    if kind_of(c, t) == "bool"
        r2 = ll_new(g, "%t")
        ll_put(g, r2 + " = trunc i8 " + r + " to i1")
        return r2
    return r

// {k: v, ...}: ключи и значения во временные массивы на стеке, потом tb_dict_from
func ll_dict_lit(g: LLGen, c: Comp, n: Node)
    t = n.ty
    vt = c.types[t].elem
    kt = c.types[t].key
    nk = len(n.kids) / 2
    if nk == 0
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = call ptr @tb_x_dict_new(i32 " + ll_dict_text(c, t) + ", i64 " + ll_vsize(c, t) + ")")
        return r0
    ka = "%\"dk" + ll_new(g, "") + "\""
    va = "%\"dv" + ll_new(g, "") + "\""
    g.allocas.add("  " + ka + " = alloca [" + nk + " x " + ll_ty(c, kt) + "]\n")
    g.allocas.add("  " + va + " = alloca [" + nk + " x " + ll_mem_ty(c, vt) + "]\n")
    count i from 0 to nk - 1
        kv = ll_expr(g, c, n.kids[2 * i])
        kp = ll_new(g, "%t")
        ll_put(g, kp + " = getelementptr inbounds " + ll_ty(c, kt) + ", ptr " + ka + ", i64 " + i)
        ll_put(g, "store " + ll_ty(c, kt) + " " + kv + ", ptr " + kp)
        vv = ll_as(g, c, n.kids[2 * i + 1], vt)
        vp = ll_new(g, "%t")
        ll_put(g, vp + " = getelementptr inbounds " + ll_mem_ty(c, vt) + ", ptr " + va + ", i64 " + i)
        ll_store_val(g, c, vt, vv, vp)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_dict_from(i32 " + ll_dict_text(c, t) + ", i64 " + ll_vsize(c, t) + ", i64 " + nk + ", ptr " + ka + ", ptr " + va + ")")
    return r

// адрес d[k] для записи: ключа нет — dict создаёт его со значением по умолчанию
func ll_dput(g: LLGen, c: Comp, t: Node)
    dt = t.kids[0].ty
    vt = c.types[dt].elem
    base = ll_expr(g, c, t.kids[0])
    kp = ll_key_ptr(g, c, dt, t.kids[1])
    def = "null"
    if ll_val(c, vt) and kind_of(c, vt) != "enum"
        def = "%\"def" + ll_new(g, "") + "\""
        g.allocas.add("  " + def + " = alloca " + ll_mem_ty(c, vt) + "\n")
        ll_store_val(g, c, vt, ll_default(g, c, vt), def)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_dput(ptr " + base + ", ptr " + kp + ", ptr " + def + ")")
    return r

// меняется ли в теле длина какого-нибудь списка: add / pop / clear, новое значение
// у имени списка, вызов функции, которой отдали список или obj (она может сделать add)
func ll_may_resize(c: Comp, n: Node)
    k = n.kind
    if k == "method"
        return true
    if (k == "assign" or k == "set") and kind_of(c, n.ty) == "list"
        return true
    if k == "call" and n.has_ref and n.ref.kind == "func"
        each a in n.kids
            if len(a.kids) > 0 and ll_box(c, a.kids[0].ty)
                return true
    each kid in n.kids
        if ll_may_resize(c, kid)
            return true
    return false

// адрес p.x: проверка на пустой obj, потом поле (холодное — через tb_cold), как в C
func ll_field_ptr(g: LLGen, c: Comp, n: Node)
    if ll_row(c, n.kids[0].ty)
        return ll_row_field_ptr(g, c, n)
    base = ll_expr(g, c, n.kids[0])
    z = ll_new(g, "%t")
    ll_put(g, z + " = icmp eq ptr " + base + ", null")
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + z + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 4)
    ll_label(g, ok)
    o = c.types[n.kids[0].ty].obj_node
    hot = 0
    cold = 0
    hot_at = -1
    cold_at = -1
    each f in o.kids
        if f.is_cold
            if f.name == n.name
                cold_at = cold
            cold += 1
        else
            if f.name == n.name
                hot_at = hot
            hot += 1
    fp = ll_new(g, "%t")
    if hot_at >= 0
        ll_put(g, fp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr " + base + ", i32 0, i32 " + hot_at)
        return fp
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr " + base + ", i32 0, i32 " + hot)
    cb = ll_new(g, "%t")
    ll_put(g, cb + " = load ptr, ptr " + cp)
    ll_put(g, fp + " = getelementptr inbounds %\"tb_c_" + o.name + "\", ptr " + cb + ", i32 0, i32 " + cold_at)
    return fp

// устройство obj для LLVM: те же поля в том же порядке, что struct в C
func ll_obj_types(c: Comp, program: Node, all: list text)
    each top in program.kids
        if top.kind == "obj" and not top.by_cols
            t = -1
            each ty in c.types
                if ty.kind == "obj" and ty.obj_name == top.name
                    t = ty.id
            if t >= 0 and ll_plainobj(c, t)
                hot = ""
                cold = ""
                each f in top.kids
                    if f.is_cold
                        if cold != ""
                            cold = cold + ", "
                        cold = cold + ll_mem_ty(c, f.ty)
                    else
                        if hot != ""
                            hot = hot + ", "
                        hot = hot + ll_mem_ty(c, f.ty)
                if cold != ""
                    all.add("%\"tb_c_" + top.name + "\" = type { " + cold + " }\n")
                    if hot != ""
                        hot = hot + ", "
                    hot = hot + "ptr"
                if hot == ""
                    hot = "i8"
                all.add("%\"tb_o_" + top.name + "\" = type { " + hot + " }\n")

func ll_len(g: LLGen, base: text)
    lp = ll_new(g, "%t")
    ll_put(g, lp + " = getelementptr inbounds i8, ptr " + base + ", i64 8")
    r = ll_new(g, "%t")
    ll_put(g, r + " = load i64, ptr " + lp + ", !tbaa !10")
    return r

// адрес xs[i] с проверкой номера (как tb_at в C: одно сравнение без знака)
func ll_elem_ptr(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    idx = ll_expr(g, c, n.kids[1])
    if ll_has(g.fast, ll_index_key(n))
        // номер уже проверен до цикла
        d0 = ll_new(g, "%t")
        ll_put(g, d0 + " = load ptr, ptr " + base + ", !tbaa !10")
        ep0 = ll_new(g, "%t")
        ll_put(g, ep0 + " = getelementptr inbounds " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + d0 + ", i64 " + idx)
        return ep0
    ln = ll_len(g, base)
    bad = ll_new(g, "%t")
    ll_put(g, bad + " = icmp uge i64 " + idx + ", " + ln)
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 3)
    ll_label(g, ok)
    d = ll_new(g, "%t")
    ll_put(g, d + " = load ptr, ptr " + base + ", !tbaa !10")
    ep = ll_new(g, "%t")
    ll_put(g, ep + " = getelementptr inbounds " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + d + ", i64 " + idx)
    return ep

// один проход count: от start до end включительно, в конце — переход на out
func ll_count_loop(g: LLGen, c: Comp, n: Node, start: text, end: text, out: text)
    slot = ll_slot(g, c, n.name, 1)
    ll_put(g, "store i64 " + start + ", ptr " + slot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + slot)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp sle i64 " + iv + ", " + end)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    ll_loop_body(g, c, n.kids[2], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + slot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + slot)
    ll_term(g, "br label %" + head)

// xs[i], xs[i + 3], xs[i - 1] → "xs#i#k"; иначе ""
func ll_index_key(n: Node)
    if n.kind != "index" or n.kids[0].kind != "name"
        return ""
    ix = n.kids[1]
    if ix.kind == "name"
        return n.kids[0].name + "#" + ix.name + "#0"
    if ix.kind == "binop" and (ix.value == "+" or ix.value == "-") and ix.kids[0].kind == "name" and ix.kids[1].kind == "number"
        if ix.value == "-"
            return n.kids[0].name + "#" + ix.kids[0].name + "#-" + ix.kids[1].value
        return n.kids[0].name + "#" + ix.kids[0].name + "#" + ix.kids[1].value
    return ""

func ll_fast_collect(c: Comp, n: Node, var: text, keys: list text, nodes: list Node, offs: list int)
    key = ll_index_key(n)
    if key != "" and not ll_numlist(c, n.kids[0].ty)
        key = ""
    if key != "" and starts_with(key, n.kids[0].name + "#" + var + "#") and not ll_has(keys, key)
        k = to_int(cut(key, len(n.kids[0].name) + len(var) + 2, len(key) - 1)) or 0
        if k > -1000000 and k < 1000000
            keys.add(key)
            nodes.add(n)
            offs.add(k)
    each kid in n.kids
        ll_fast_collect(c, kid, var, keys, nodes, offs)

// меняют ли где-то в теле саму переменную цикла (тогда проверка до цикла не годится)
func ll_assigns(n: Node, name: text)
    if (n.kind == "assign" and n.name == name) or (n.kind == "set" and n.kids[0].kind == "name" and n.kids[0].name == name)
        return true
    if n.kind == "call" and n.has_ref and n.ref.kind == "func"
        // f(i) с link: функция может поменять i
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link and len(n.kids[i].kids) > 0 and n.kids[i].kids[0].kind == "name" and n.kids[i].kids[0].name == name
                return true
    each kid in n.kids
        if ll_assigns(kid, name)
            return true
    return false

// тело цикла: если всё, что создано за шаг, не уходит наружу — своя временная память
// на каждый шаг, отдаётся разом в конце шага (и при skip), как в C
func ll_loop_body(g: LLGen, c: Comp, body: Node, cont: text, out: text)
    if not auto_temp_ok(c, body)
        g.cont.add(cont)
        g.brk.add(out)
        ll_block(g, c, body)
        gone_c = g.cont.pop()
        gone_b = g.brk.pop()
        return
    am = "%\"am" + ll_new(g, "") + "\""
    g.allocas.add("  " + am + " = alloca [2 x i64]\n")
    ll_put(g, "call void @tb_x_temp_begin_p(ptr " + am + ")")
    rel = ll_new(g, "L")
    g.cont.add(rel)
    g.brk.add(out)
    ll_block(g, c, body)
    gone_c = g.cont.pop()
    gone_b = g.brk.pop()
    ll_label(g, rel)
    ll_put(g, "call void @tb_x_temp_end_p(ptr " + am + ")")
    ll_term(g, "br label %" + cont)

// встроенная функция: обёртка tb_llb_N в C (номер записан в n.temp_no при выборе)
func ll_builtin(g: LLGen, c: Comp, n: Node)
    args = ""
    tys = ""
    count i from 0 to len(n.kids) - 1
        a = n.kids[i].kids[0]
        v = ll_expr(g, c, a)
        if i > 0
            args = args + ", "
            tys = tys + ", "
        args = args + ll_ty(c, a.ty) + " " + ll_ext(c, a.ty) + v
        tys = tys + ll_ty(c, a.ty) + " " + ll_ext(c, a.ty)
    fn = "@tb_llb_" + n.temp_no
    rt = ll_ext(c, n.ty) + ll_ty(c, n.ty)
    ll_need(g, "declare " + rt + " " + fn + "(" + tys + ")\n")
    if kind_of(c, n.ty) == "none"
        ll_put(g, "call void " + fn + "(" + args + ")")
        return "0"
    r = ll_new(g, "%t")
    ll_put(g, r + " = call " + rt + " " + fn + "(" + args + ")")
    return r

// адрес tb_err (у каждого потока свой): через маленькую функцию из C, LTO её встраивает
func ll_errp(g: LLGen)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_errp()")
    return r

// функция сломалась: выйти со значением по умолчанию (ошибка уже лежит в tb_err)
func ll_bail(g: LLGen, c: Comp)
    if g.fn.name == "main"
        // в main ошибку некому передать: сообщение и выход, как tb_die в C
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        ll_put(g, "call void @tb_x_die(ptr " + e + ")")
        ll_term(g, "unreachable")
        return
    if len(g.outs) > 0
        // gives: выходим с тем, что уже лежит в выходах (как emit_bail в C)
        ll_gives_ret(g, c)
        return
    ll_fa_end(g)
    if kind_of(c, g.fn.ty) == "none"
        ll_term(g, "ret void")
        return
    d = ll_default(g, c, g.fn.ty)
    ll_term(g, "ret " + ll_ty(c, g.fn.ty) + " " + d)

// return в функции с gives: один выход — его значение, несколько — уже лежат по адресам
func ll_gives_ret(g: LLGen, c: Comp)
    if g.multi_out
        each bo in g.fn.kids[2].kids
            if kind_of(c, bo.ty) == "bool"
                bv = ll_new(g, "%t")
                ll_put(g, bv + " = load i1, ptr " + ll_slot(g, c, bo.name, bo.ty))
                bz = ll_new(g, "%t")
                ll_put(g, bz + " = zext i1 " + bv + " to i8")
                ll_put(g, "store i8 " + bz + ", ptr %\"b." + bo.name + "\"")
        ll_fa_end(g)
        ll_term(g, "ret void")
        return
    o = g.fn.kids[2].kids[0]
    v = ll_new(g, "%t")
    ll_put(g, v + " = load " + ll_ty(c, o.ty) + ", ptr " + ll_slot(g, c, o.name, o.ty))
    ll_fa_end(g)
    ll_term(g, "ret " + ll_ty(c, o.ty) + " " + v)

// вызов функции с несколькими выходами: f__ll(аргументы, адреса выходов)
func ll_call_multi(g: LLGen, c: Comp, n: Node, outs: list text)
    f = n.ref
    params = f.kids[0]
    args = ""
    count i from 0 to len(n.kids) - 1
        p = params.kids[i]
        arg = n.kids[i].kids[0]
        v = ""
        if p.is_link
            v = ll_addr(g, c, arg)
        else
            v = ll_as(g, c, arg, p.ty)
        if i > 0
            args = args + ", "
        args = args + ll_arg(g, c, p, v)
    fouts = f.kids[2].kids
    bytes = list text
    count j from 0 to len(outs) - 1
        if args != ""
            args = args + ", "
        if kind_of(c, fouts[j].ty) == "bool"
            // bool-выход приходит байтом
            bt = "%\"mb" + ll_new(g, "") + "\""
            g.allocas.add("  " + bt + " = alloca i8\n")
            ll_put(g, "store i8 0, ptr " + bt)
            bytes.add(bt)
            args = args + "ptr " + bt
        else
            bytes.add("")
            args = args + "ptr " + outs[j]
    ll_put(g, "call void @\"" + ll_fname(f) + "__ll\"(" + args + ")")
    count j from 0 to len(outs) - 1
        if bytes[j] != ""
            bl = ll_new(g, "%t")
            ll_put(g, bl + " = load i8, ptr " + bytes[j])
            bb = ll_new(g, "%t")
            ll_put(g, bb + " = icmp ne i8 " + bl + ", 0")
            ll_put(g, "store i1 " + bb + ", ptr " + outs[j])

// перед выходом из функции: отдать её временную память
func ll_fa_end(g: LLGen)
    if g.fa != ""
        ll_put(g, "call void @tb_x_fa_end(i32 " + g.fa + ", ptr %\"fm\")")

// each v in flags (list bool): номер внутри списка, бит берём tb_bget
func ll_each_bits(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    ln = ll_len(g, base)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    bv = ll_new(g, "%t")
    ll_put(g, bv + " = call zeroext i1 @tb_x_bget(ptr " + base + ", i64 " + iv + ", i32 " + n.line + ")")
    ll_put(g, "store i1 " + bv + ", ptr " + ll_slot(g, c, n.name, 3))
    ll_loop_body(g, c, n.kids[1], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

// each ch in s: по байтам до нуля, ch — текст из одного знака (tb_chr, как в C)
func ll_each_text(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    ll_need(g, "declare ptr @tb_x_chr(i64)")
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    bp = ll_new(g, "%t")
    ll_put(g, bp + " = getelementptr inbounds i8, ptr " + base + ", i64 " + iv)
    b = ll_new(g, "%t")
    ll_put(g, b + " = load i8, ptr " + bp)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp ne i8 " + b + ", 0")
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    z = ll_new(g, "%t")
    ll_put(g, z + " = zext i8 " + b + " to i64")
    ch = ll_new(g, "%t")
    ll_put(g, ch + " = call ptr @tb_x_chr(i64 " + z + ")")
    ll_put(g, "store ptr " + ch + ", ptr " + ll_slot(g, c, n.name, 4))
    ll_loop_body(g, c, n.kids[1], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

func ll_block(g: LLGen, c: Comp, b: Node)
    each s in b.kids
        ll_stmt(g, c, s)

func ll_stmt(g: LLGen, c: Comp, n: Node)
    k = n.kind
    if k == "assign"
        bld = ll_has(g.blds, n.name) and ll_is_text(c, n.ty)
        if bld and not n.creates and len(n.kids) > 0 and ll_app_form(c, n.name, n.kids[0])
            // s = s + a + b: дописать a и b в конец s
            each part in ll_app_parts(c, n.kids[0])
                ll_app(g, c, n.name, n.ty, part)
            return
        v = ""
        if len(n.kids) == 0
            v = ll_default(g, c, n.ty)
        else
            v = ll_as(g, c, n.kids[0], n.ty)
        ll_put(g, "store " + ll_ty(c, n.ty) + " " + v + ", ptr " + ll_slot(g, c, n.name, n.ty))
        if bld
            // новый текст: своей памяти у s пока нет
            ll_put(g, "store i64 -1, ptr " + ll_rl(g, n.name))
    else if k == "set" and n.kids[0].kind == "index" and ll_dict(c, n.kids[0].kids[0].ty)
        // d[k] = v / d[k] += v: сначала значение, потом место (как в C)
        t = n.kids[0]
        op = n.value
        vt = n.ty
        v = ""
        if op == "="
            v = ll_as(g, c, n.kids[1], vt)
        else if ll_is_text(c, vt)
            v = ll_as_text(g, c, n.kids[1])
        else
            v = ll_expr(g, c, n.kids[1])
        p = ll_dput(g, c, t)
        if op == "="
            ll_store_val(g, c, vt, v, p)
            return
        old = ll_load_val(g, c, vt, p)
        r = ""
        if ll_is_text(c, vt)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call ptr @tb_x_cat(ptr " + old + ", ptr " + v + ")")
        else
            r = ll_arith(g, c, cut(op, 0, 0), old, vt, v, n.kids[1].ty, vt, n.line)
        ll_store_val(g, c, vt, r, p)
    else if k == "set" and n.kids[0].kind == "index" and ll_colist(c, n.kids[0].kids[0].ty)
        // pts[i] = p: сначала значение, потом список и номер; копия качеств (tb_colset_X)
        rv = ll_expr(g, c, n.kids[1])
        cl = ll_expr(g, c, n.kids[0].kids[0])
        ci = ll_expr(g, c, n.kids[0].kids[1])
        cn = ll_cneed(g, c, n.kids[0].kids[0].ty)
        ll_put(g, "call void @tb_lc_set_" + cn + "(ptr " + cl + ", i64 " + ci + ", ptr " + ll_rpart(g, rv, 0) + ", i64 " + ll_rpart(g, rv, 1) + ", i32 " + n.line + ")")
    else if k == "set" and n.kids[0].kind == "index" and ll_bits(c, n.kids[0].kids[0].ty)
        // flags[i] = v: сначала значение, потом список и номер (как в C)
        v = ll_expr(g, c, n.kids[1])
        bl = ll_expr(g, c, n.kids[0].kids[0])
        bi = ll_expr(g, c, n.kids[0].kids[1])
        ll_put(g, "call void @tb_x_bset(ptr " + bl + ", i64 " + bi + ", i1 zeroext " + v + ", i32 " + n.line + ")")
    else if k == "set" and n.kids[0].kind == "index"
        // xs[i] = v / xs[i] += v: как в C, сначала значение, потом адрес
        t = n.kids[0]
        op = n.value
        et = ll_elem_ty(c, t.kids[0].ty)
        tag = ll_elem_tag(c, t.kids[0].ty)
        if op == "="
            v = ll_as(g, c, n.kids[1], n.ty)
            ep = ll_elem_ptr(g, c, t)
            ll_put(g, "store " + et + " " + v + ", ptr " + ep + tag)
            return
        v = ll_expr(g, c, n.kids[1])
        ep = ll_elem_ptr(g, c, t)
        old = ll_new(g, "%t")
        ll_put(g, old + " = load " + et + ", ptr " + ep + tag)
        r = ll_arith(g, c, cut(op, 0, 0), old, n.ty, v, n.kids[1].ty, n.ty, n.line)
        ll_put(g, "store " + et + " " + r + ", ptr " + ep + tag)
    else if k == "set" and n.kids[0].kind == "field"
        // p.x = v / p.x += v: сначала значение, потом адрес (как в C)
        t = n.kids[0]
        op = n.value
        mt = ll_mem_ty(c, n.ty)
        v = ""
        if op == "="
            v = ll_as(g, c, n.kids[1], n.ty)
        else if ll_is_text(c, n.ty)
            v = ll_as_text(g, c, n.kids[1])
        else
            v = ll_expr(g, c, n.kids[1])
        fp = ll_field_ptr(g, c, t)
        r = v
        if op != "=" and ll_is_text(c, n.ty)
            old = ll_new(g, "%t")
            ll_put(g, old + " = load ptr, ptr " + fp)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call ptr @tb_x_cat(ptr " + old + ", ptr " + v + ")")
        else if op != "="
            old = ll_new(g, "%t")
            ll_put(g, old + " = load " + mt + ", ptr " + fp)
            r = ll_arith(g, c, cut(op, 0, 0), old, n.ty, v, n.kids[1].ty, n.ty, n.line)
        if kind_of(c, n.ty) == "bool"
            z = ll_new(g, "%t")
            ll_put(g, z + " = zext i1 " + r + " to i8")
            r = z
        ll_put(g, "store " + mt + " " + r + ", ptr " + fp)
    else if k == "set"
        t = n.kids[0]
        slot = ll_slot(g, c, t.name, n.ty)
        ty = ll_ty(c, n.ty)
        op = n.value
        if op == "="
            v = ll_as(g, c, n.kids[1], n.ty)
            ll_put(g, "store " + ty + " " + v + ", ptr " + slot)
            if ll_has(g.blds, t.name) and ll_is_text(c, n.ty)
                ll_put(g, "store i64 -1, ptr " + ll_rl(g, t.name))
            return
        if ll_is_text(c, n.ty)
            value = n.kids[1]
            if ll_has(g.blds, t.name)
                if ll_text_plus(c, value) and not ll_bld_uses(value, t.name)
                    // s += a + b: дописать a, потом b — без промежуточного текста a + b
                    r0 = value
                    repeat while ll_text_plus(c, r0)
                        r0 = r0.kids[0]
                    ll_app(g, c, t.name, n.ty, r0)
                    each part in ll_app_parts(c, value)
                        ll_app(g, c, t.name, n.ty, part)
                    return
                // s += x: дописать x в конец s (число — цифрами сразу, готовый текст — с известной длиной)
                ll_app(g, c, t.name, n.ty, value)
                return
            xv = ll_as_text(g, c, value)
            old = ll_new(g, "%t")
            ll_put(g, old + " = load ptr, ptr " + slot)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call ptr @tb_x_cat(ptr " + old + ", ptr " + xv + ")")
            ll_put(g, "store ptr " + r + ", ptr " + slot)
            return
        // x += y: как  x = x + y
        v = ll_expr(g, c, n.kids[1])
        old = ll_new(g, "%t")
        ll_put(g, old + " = load " + ty + ", ptr " + slot)
        r = ll_arith(g, c, cut(op, 0, 0), old, n.ty, v, n.kids[1].ty, n.ty, n.line)
        ll_put(g, "store " + ty + " " + r + ", ptr " + slot)
    else if k == "if"
        done = ll_new(g, "L")
        i = 0
        repeat while i + 1 < len(n.kids)
            cv = ll_expr(g, c, n.kids[i])
            yes = ll_new(g, "L")
            no = ll_new(g, "L")
            ll_term(g, "br i1 " + cv + ", label %" + yes + ", label %" + no)
            ll_label(g, yes)
            ll_block(g, c, n.kids[i + 1])
            if g.open
                ll_term(g, "br label %" + done)
            ll_label(g, no)
            i += 2
        if len(n.kids) % 2 == 1
            ll_block(g, c, n.kids[len(n.kids) - 1])
        ll_label(g, done)
    else if k == "count"
        // как в C: сначала конец, потом начало; конец считается один раз
        end = ll_expr(g, c, n.kids[1])
        start = ll_expr(g, c, n.kids[0])
        out = ll_new(g, "L")
        keys = list text
        nodes = list Node
        offs = list int
        ll_fast_collect(c, n.kids[2], n.name, keys, nodes, offs)
        if len(keys) > 0 and g.fast_depth < 2 and not ll_assigns(n.kids[2], n.name) and not ll_may_resize(c, n.kids[2])
            // В теле списки не растут и не укорачиваются (нет add/pop, вызовов со списками):
            // значит, все xs[i + k] можно проверить один раз до цикла. Прошло — цикл без проверок.
            none = ll_new(g, "%t")
            ll_put(g, none + " = icmp sgt i64 " + start + ", " + end)
            all = "true"
            count q from 0 to len(nodes) - 1
                base = ll_expr(g, c, nodes[q].kids[0])
                ln = ll_len(g, base)
                lo = ll_new(g, "%t")
                ll_put(g, lo + " = add i64 " + start + ", " + offs[q])
                hi = ll_new(g, "%t")
                ll_put(g, hi + " = add i64 " + end + ", " + offs[q])
                c1 = ll_new(g, "%t")
                ll_put(g, c1 + " = icmp sge i64 " + lo + ", 0")
                c2 = ll_new(g, "%t")
                ll_put(g, c2 + " = icmp slt i64 " + hi + ", " + ln)
                both = ll_new(g, "%t")
                ll_put(g, both + " = and i1 " + c1 + ", " + c2)
                acc = ll_new(g, "%t")
                ll_put(g, acc + " = and i1 " + all + ", " + both)
                all = acc
            go = ll_new(g, "%t")
            ll_put(g, go + " = or i1 " + none + ", " + all)
            fast = ll_new(g, "L")
            slow = ll_new(g, "L")
            ll_term(g, "br i1 " + go + ", label %" + fast + ", label %" + slow)
            ll_label(g, fast)
            each key in keys
                g.fast.add(key)
            g.fast_depth += 1
            ll_count_loop(g, c, n, start, end, out)
            g.fast_depth -= 1
            each key in keys
                gone_k = g.fast.pop()
            ll_label(g, slow)
        ll_count_loop(g, c, n, start, end, out)
        ll_label(g, out)
    else if k == "repeat_times"
        total = ll_expr(g, c, n.kids[0])
        slot = ll_slot(g, c, ll_new(g, "r"), 1)
        ll_put(g, "store i64 0, ptr " + slot)
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        step = ll_new(g, "L")
        out = ll_new(g, "L")
        ll_label(g, head)
        iv = ll_new(g, "%t")
        ll_put(g, iv + " = load i64, ptr " + slot)
        cv = ll_new(g, "%t")
        ll_put(g, cv + " = icmp slt i64 " + iv + ", " + total)
        ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
        ll_label(g, body)
        ll_loop_body(g, c, n.kids[1], step, out)
        ll_label(g, step)
        iv2 = ll_new(g, "%t")
        ll_put(g, iv2 + " = load i64, ptr " + slot)
        nx = ll_new(g, "%t")
        ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
        ll_put(g, "store i64 " + nx + ", ptr " + slot)
        ll_term(g, "br label %" + head)
        ll_label(g, out)
    else if k == "each"
        // each x in xs: len читается на каждом шаге (как в C), но LLVM знает, что запись чисел его не меняет
        lt = n.kids[0].ty
        if ll_is_text(c, lt)
            ll_each_text(g, c, n)
            return
        if ll_bits(c, lt)
            ll_each_bits(g, c, n)
            return
        if ll_colist(c, lt)
            ll_each_cols(g, c, n)
            return
        base = ll_expr(g, c, n.kids[0])
        vt = c.types[lt].elem
        if ll_dict(c, lt)
            // each k in d: по списку ключей (он первым лежит в tb_dict)
            vt = c.types[lt].key
            kb = ll_new(g, "%t")
            ll_put(g, kb + " = load ptr, ptr " + base)
            base = kb
        et = "i64"
        tag = ", !tbaa !11"
        if vt == 2
            et = "double"
            tag = ", !tbaa !12"
        else if not (vt == 1 or kind_of(c, vt) == "enum")
            et = "ptr"
            tag = ", !tbaa !13"
        islot = ll_slot(g, c, ll_new(g, "e"), 1)
        ll_put(g, "store i64 0, ptr " + islot)
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        step = ll_new(g, "L")
        out = ll_new(g, "L")
        ll_label(g, head)
        iv = ll_new(g, "%t")
        ll_put(g, iv + " = load i64, ptr " + islot)
        ln = ll_len(g, base)
        cv = ll_new(g, "%t")
        ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
        ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
        ll_label(g, body)
        d = ll_new(g, "%t")
        ll_put(g, d + " = load ptr, ptr " + base + ", !tbaa !10")
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds " + et + ", ptr " + d + ", i64 " + iv)
        ev = ll_new(g, "%t")
        ll_put(g, ev + " = load " + et + ", ptr " + ep + tag)
        ll_put(g, "store " + et + " " + ev + ", ptr " + ll_slot(g, c, n.name, vt))
        ll_loop_body(g, c, n.kids[1], step, out)
        ll_label(g, step)
        iv2 = ll_new(g, "%t")
        ll_put(g, iv2 + " = load i64, ptr " + islot)
        nx = ll_new(g, "%t")
        ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
        ll_put(g, "store i64 " + nx + ", ptr " + islot)
        ll_term(g, "br label %" + head)
        ll_label(g, out)
    else if k == "linkdecl"
        a = ll_addr(g, c, n.kids[0])
        if not ll_has(g.ldecls, n.name)
            g.ldecls.add(n.name)
            g.allocas.add("  %\"l." + n.name + "\" = alloca ptr\n")
        ll_put(g, "store ptr " + a + ", ptr %\"l." + n.name + "\"")
    else if k == "temp"
        // temp: всё, что создано внутри, отдаётся разом в конце (как tb_temp_begin/end в C)
        am = "%\"am" + ll_new(g, "") + "\""
        g.allocas.add("  " + am + " = alloca [2 x i64]\n")
        ll_put(g, "call void @tb_x_temp_begin_p(ptr " + am + ")")
        ll_block(g, c, n.kids[0])
        ll_put(g, "call void @tb_x_temp_end_p(ptr " + am + ")")
    else if k == "repeat_while"
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        out = ll_new(g, "L")
        ll_label(g, head)
        cv = ll_expr(g, c, n.kids[0])
        ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
        ll_label(g, body)
        ll_loop_body(g, c, n.kids[1], head, out)
        ll_term(g, "br label %" + head)
        ll_label(g, out)
    else if k == "multi"
        call = n.kids[len(n.kids) - 1]
        if call.kind == "try" or call.kind == "else_err"
            // a, b = f() else err / try f(): выходы во временные места, проверка, потом в переменные (как в C)
            ignored = ll_expr(g, c, call)
            tmps = g.mtemps
            count i from 0 to len(n.kids) - 2
                t = n.kids[i].ty
                lv = ll_new(g, "%t")
                ll_put(g, lv + " = load " + ll_ty(c, t) + ", ptr " + tmps[i])
                ll_put(g, "store " + ll_ty(c, t) + " " + lv + ", ptr " + ll_slot(g, c, n.kids[i].name, t))
        else
            outs = list text
            count i from 0 to len(n.kids) - 2
                outs.add(ll_slot(g, c, n.kids[i].name, n.kids[i].ty))
            ll_call_multi(g, c, call, outs)
    else if k == "fail"
        msg = ll_expr(g, c, n.kids[0])
        ll_put(g, "store ptr " + msg + ", ptr " + ll_errp(g))
        ll_bail(g, c)
    else if k == "match"
        // цепочка сравнений, как if / else if в C (LLVM сам сделает из неё switch)
        subj = n.kids[0]
        sv = ll_expr(g, c, subj)
        done = ll_new(g, "L")
        count i from 1 to len(n.kids) - 1
            cs = n.kids[i]
            if cs.name == "else"
                ll_block(g, c, cs.kids[1])
                if g.open
                    ll_term(g, "br label %" + done)
            else
                yes = ll_new(g, "L")
                no = ll_new(g, "L")
                each v in cs.kids[0].kids
                    vv = ll_expr(g, c, v)
                    eq = ll_new(g, "%t")
                    if ll_is_text(c, subj.ty)
                        cr = ll_new(g, "%t")
                        ll_put(g, cr + " = call i32 @strcmp(ptr " + sv + ", ptr " + vv + ")")
                        ll_put(g, eq + " = icmp eq i32 " + cr + ", 0")
                    else
                        ll_put(g, eq + " = icmp eq " + ll_ty(c, subj.ty) + " " + sv + ", " + vv)
                    nx = ll_new(g, "L")
                    ll_term(g, "br i1 " + eq + ", label %" + yes + ", label %" + nx)
                    ll_label(g, nx)
                ll_term(g, "br label %" + no)
                ll_label(g, yes)
                ll_block(g, c, cs.kids[1])
                if g.open
                    ll_term(g, "br label %" + done)
                ll_label(g, no)
        ll_label(g, done)
    else if k == "skip"
        ll_term(g, "br label %" + g.cont[len(g.cont) - 1])
    else if k == "stop"
        ll_term(g, "br label %" + g.brk[len(g.brk) - 1])
    else if k == "return" and len(g.outs) > 0 and (len(n.kids) == 0 or g.multi_out)
        ll_gives_ret(g, c)
    else if k == "return"
        if len(n.kids) == 1 and kind_of(c, g.fn.ty) != "none"
            v = ll_as(g, c, n.kids[0], g.fn.ty)
            ll_fa_end(g)
            ll_term(g, "ret " + ll_ty(c, g.fn.ty) + " " + v)
        else
            ll_fa_end(g)
            ll_term(g, "ret void")
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "add"
        // xs.add(v): сначала значение, потом место под него (как в C)
        e = n.kids[0]
        lt = e.kids[0].ty
        pv = e.kids[1].kids[0]
        if ll_colist(c, lt) and pv.kind == "call" and pv.has_ref and pv.ref.kind == "obj"
            // pts.add(Point(...)): качества сразу в колонки, без временной строки (как в C)
            pl = ll_expr(g, c, e.kids[0])
            o = pv.ref
            pargs = "ptr " + pl
            ptys = "ptr"
            count i from 0 to len(o.kids) - 1
                ft = o.kids[i].ty
                fv = ""
                if pv.kids[i].kind == "missing"
                    fv = ll_default(g, c, ft)
                else
                    fv = ll_as(g, c, pv.kids[i].kids[0], ft)
                pargs = pargs + ", " + ll_ty(c, ft) + " " + ll_ext(c, ft) + fv
                ptys = ptys + ", " + ll_ty(c, ft) + " " + ll_ext(c, ft)
            ll_need(g, "declare void @tb_lc_push_" + o.name + "(" + ptys + ", i32)\n")
            ll_put(g, "call void @tb_lc_push_" + o.name + "(" + pargs + ", i32 " + e.line + ")")
            return
        v = ll_as(g, c, e.kids[1].kids[0], c.types[lt].elem)
        base = ll_expr(g, c, e.kids[0])
        if ll_bits(c, lt)
            ll_put(g, "call void @tb_x_badd(ptr " + base + ", i1 zeroext " + v + ")")
            return
        if ll_colist(c, lt)
            cn = ll_cneed(g, c, lt)
            ll_put(g, "call void @tb_lc_add_" + cn + "(ptr " + base + ", ptr " + ll_rpart(g, v, 0) + ", i64 " + ll_rpart(g, v, 1) + ", i32 " + e.line + ")")
            return
        p = ll_new(g, "%t")
        ll_put(g, p + " = call ptr @tb_x_grow(ptr " + base + ")")
        ll_put(g, "store " + ll_elem_ty(c, lt) + " " + v + ", ptr " + p + ll_elem_tag(c, lt))
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "clear" and ll_dict(c, n.kids[0].kids[0].ty)
        ignored = ll_expr(g, c, n.kids[0])
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "clear"
        base = ll_expr(g, c, n.kids[0].kids[0])
        ll_put(g, "call void @tb_x_lclear(ptr " + base + ", i32 " + n.kids[0].line + ")")
    else if k == "expr_stmt"
        ignored = ll_expr(g, c, n.kids[0])

// имя параметра в .ll; если с тем же именем есть выход (при нескольких выходах он — адрес %"p.x"),
// значение параметра зовётся %"a.x" и сразу кладётся по этому адресу
func ll_pname(g: LLGen, name: text)
    if g.multi_out and ll_has(g.outs, name)
        return "%\"a." + name + "\""
    return "%\"p." + name + "\""

func ll_func(c: Comp, f: Node, all: list text, decls: list text)
    g = LLGen(tmp: 0, open: true, fn: f, decls: decls, fa: "")
    params = f.kids[0]
    outs = f.kids[2].kids
    each o in outs
        g.outs.add(o.name)
    g.multi_out = len(outs) > 1
    head = "define " + ll_ext(c, f.ty) + ll_ty(c, f.ty) + " @\"" + ll_fname(f) + "\"("
    if g.multi_out
        head = "define void @\"" + ll_fname(f) + "__ll\"("
    count i from 0 to len(params.kids) - 1
        p = params.kids[i]
        if i > 0
            head = head + ", "
        if not p.is_link and ll_row(c, p.ty)
            // строка — двумя параметрами, как её раскладывает clang (ptr, i64)
            head = head + "ptr %\"p." + p.name + ".c\", i64 %\"p." + p.name + ".i\""
        else
            head = head + ll_pty(c, p) + " " + ll_pext(c, p) + ll_pname(g, p.name)
    if g.multi_out
        count i from 0 to len(outs) - 1
            if i > 0 or len(params.kids) > 0
                head = head + ", "
            if kind_of(c, outs[i].ty) == "bool"
                // bool в памяти C — байт: внутри своя ячейка i1, по адресу кладём при выходе
                head = head + "ptr %\"b." + outs[i].name + "\""
            else
                head = head + "ptr %\"p." + outs[i].name + "\""
                g.links.add(outs[i].name)
    head = head + ") #0 {\n"
    each p in params.kids
        if p.is_link
            g.links.add(p.name)
        else
            slot = ll_slot(g, c, p.name, p.ty)
            if ll_row(c, p.ty)
                rp = ll_pname(g, p.name)
                r0 = "%\"p." + p.name + ".r\""
                g.out.add("  " + r0 + " = insertvalue { ptr, i64 } undef, ptr %\"p." + p.name + ".c\", 0\n")
                g.out.add("  " + rp + " = insertvalue { ptr, i64 } " + r0 + ", i64 %\"p." + p.name + ".i\", 1\n")
            g.out.add("  store " + ll_ty(c, p.ty) + " " + ll_pname(g, p.name) + ", ptr " + slot + "\n")
    each o in outs
        // выход с именем параметра — та же переменная: уже лежит значение параметра.
        // Остальные выходы с самого начала — значения по умолчанию (как в C)
        if not o.is_const
            dv = ll_default(g, c, o.ty)
            ll_put(g, "store " + ll_ty(c, o.ty) + " " + dv + ", ptr " + ll_slot(g, c, o.name, o.ty))
    ll_find_blds(g, c, f)
    if func_arena_ok(c, f)
        // всё, что функция создаёт, — во временной области; отдаётся при каждом return
        g.allocas.add("  %\"fm\" = alloca [2 x i64]\n")
        g.fa = "%\"fa\""
        g.out.add("  %\"fa\" = call i32 @tb_x_fa_begin(ptr %\"fm\")\n")
    each b in g.blds
        // длина своей памяти (-1: своей нет) и сколько там места
        g.allocas.add("  " + ll_rl(g, b) + " = alloca i64\n  " + ll_rc(g, b) + " = alloca i64\n")
        g.out.add("  store i64 -1, ptr " + ll_rl(g, b) + "\n  store i64 0, ptr " + ll_rc(g, b) + "\n")
    ll_block(g, c, f.kids[1])
    if g.open
        if len(outs) > 0
            ll_gives_ret(g, c)
        else if kind_of(c, f.ty) == "none"
            ll_fa_end(g)
            ll_term(g, "ret void")
        else
            // как в C: «функция имя дошла до конца без return»
            nm = "@\"tb.nm." + ll_fname(f) + "\""
            all.add(nm + " = private unnamed_addr constant [" + (len(f.name) + 1) + " x i8] c\"" + f.name + "\\00\"\n")
            ll_put(g, "call void @tb_ll_noreturn(i32 " + f.line + ", ptr " + nm + ")")
            ll_term(g, "unreachable")
    all.add(head)
    all.add("entry:\n")
    each a in g.allocas
        all.add(a)
    each s in g.out
        all.add(s)
    all.add("}\n\n")

// весь файл .ll: функции из c.ll_names
// target: строки «target datalayout / triple» от clang этой машины;
// cpu: его настройки процессора ("target-cpu"=... и т.д.), без них LLVM собирает под самый старый x86
modpub func emit_ll(c: Comp, program: Node, target: text, cpu: text)
    all = list text
    all.add("; Сделано компилятором Tachbit (--llvm). Не правь руками: правь файл .tb\n")
    all.add(target)
    // какие функции ушли в LLVM, какие остались в C
    in_ll = list text
    in_c = list text
    each top in program.kids
        if top.kind == "func"
            if ll_has(c.ll_names, ll_fname(top))
                in_ll.add(top.name)
            else if not ll_head_ok(c, top)
                in_c.add(top.name + " (вид)")
            else
                in_c.add(top.name + " (строка " + ll_why(c, top.kids[1], c.ll_names) + ")")
    all.add("; в LLVM (" + len(in_ll) + "): " + join(in_ll, ", ") + "\n")
    all.add("; через C (" + len(in_c) + "): " + join(in_c, ", ") + "\n")
    ll_obj_types(c, program, all)
    all.add("declare void @tb_ll_crash(i32, i32) noreturn cold\n")
    all.add("declare void @tb_ll_noreturn(i32, ptr) noreturn cold\n")
    // функции, которые остались в C, но их зовут отсюда
    each top in program.kids
        if top.kind == "func" and ll_has(c.ll_ext, ll_fname(top))
            ps = ""
            each p in top.kids[0].kids
                if ps != ""
                    ps = ps + ", "
                ps = ps + ll_pty(c, p) + " " + ll_pext(c, p)
            if len(top.kids[2].kids) > 1
                each o in top.kids[2].kids
                    if ps != ""
                        ps = ps + ", "
                    ps = ps + "ptr"
                all.add("declare void @\"" + ll_fname(top) + "__ll\"(" + ps + ")\n")
            else
                all.add("declare " + ll_ext(c, top.ty) + ll_ty(c, top.ty) + " @\"" + ll_fname(top) + "\"(" + ps + ")\n")
    // библиотека Tachbit (runtime.h): с TB_LL её функции видны отсюда
    all.add("declare void @tb_x_ps(ptr)\ndeclare ptr @tb_x_itos(i64)\ndeclare ptr @tb_x_dtos(double)\ndeclare ptr @tb_x_btos(i32)\n")
    all.add("declare ptr @tb_x_digits(i64, ptr, ptr)\ndeclare ptr @tb_x_mem_np(i64)\ndeclare i64 @tb_x_tlen(ptr)\ndeclare ptr @tb_x_char_at(ptr, i64, i64, i32)\n")
    all.add("declare ptr @tb_x_cat(ptr, ptr)\ndeclare void @tb_x_app(ptr, ptr, ptr, ptr)\ndeclare void @tb_x_app_i(ptr, ptr, ptr, i64)\ndeclare void @tb_x_app_n(ptr, ptr, ptr, ptr, i64)\n")
    all.add("declare ptr @tb_x_errp()\ndeclare void @tb_x_die(ptr) noreturn cold\n")
    all.add("declare ptr @tb_x_grow(ptr)\ndeclare zeroext i1 @tb_x_bget(ptr, i64, i32)\ndeclare void @tb_x_bset(ptr, i64, i1 zeroext, i32)\ndeclare void @tb_x_badd(ptr, i1 zeroext)\ndeclare zeroext i1 @tb_x_bpop(ptr, i32)\ndeclare ptr @tb_x_bits_new()\ndeclare ptr @tb_x_bits_from(i64, ptr)\ndeclare ptr @tb_x_pop(ptr, i32)\ndeclare void @tb_x_lclear(ptr, i32)\ndeclare ptr @tb_x_list_new_np(i64)\ndeclare ptr @tb_x_list_from_np(i64, i64, ptr)\ndeclare ptr @tb_x_dict_new(i32, i64)\ndeclare ptr @tb_x_dict_from(i32, i64, i64, ptr, ptr)\ndeclare ptr @tb_x_dget(ptr, ptr, i32)\ndeclare ptr @tb_x_dput(ptr, ptr, ptr)\ndeclare i32 @tb_x_dhas(ptr, ptr)\ndeclare void @tb_x_dremove(ptr, ptr)\ndeclare void @tb_x_dclear(ptr, i32)\ndeclare i64 @tb_x_dlen(ptr)\ndeclare ptr @tb_x_dkeys_copy(ptr)\ndeclare ptr @tb_x_dvals_copy(ptr)\ndeclare ptr @tb_x_list_new(i64)\ndeclare ptr @tb_x_list_from(i64, i64, ptr)\n")
    all.add("declare void @tb_x_temp_begin_p(ptr)\ndeclare void @tb_x_temp_end_p(ptr)\ndeclare i32 @tb_x_fa_begin(ptr)\ndeclare void @tb_x_fa_end(i32, ptr)\n")
    all.add("declare i64 @strlen(ptr)\ndeclare i32 @strcmp(ptr, ptr)\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n")
    all.add("\n")
    decls = list text
    each top in program.kids
        if top.kind == "func" and ll_has(c.ll_names, ll_fname(top))
            ll_func(c, top, all, decls)
    each d in decls
        all.add(d)
    all.add("attributes #0 = { nounwind" + cpu + " }\n")
    all.add("!0 = !{!\"branch_weights\", i32 1, i32 2000}\n")
    all.add("!1 = !{!\"tachbit\"}\n!2 = !{!\"tb.list\", !1, i64 0}\n!3 = !{!\"tb.int\", !1, i64 0}\n!4 = !{!\"tb.dec\", !1, i64 0}\n!5 = !{!\"tb.ptr\", !1, i64 0}\n")
    all.add("!10 = !{!2, !2, i64 0}\n!11 = !{!3, !3, i64 0}\n!12 = !{!4, !4, i64 0}\n!13 = !{!5, !5, i64 0}\n")
    return join(all, "")

// как clang этой машины пишет функцию: берём из его вывода цель и настройки процессора
// (только пары "ключ"="значение" и uwtable/ssp — без пометок про саму пробную функцию)
modpub func ll_probe_parse(src: text) gives target: text, cpu: text
    each line in split(src, "\n")
        if starts_with(line, "target datalayout") or starts_with(line, "target triple")
            target = target + line + "\n"
        else if starts_with(line, "attributes #0 = {") and cpu == ""
            each w in split(line, " ")
                if starts_with(w, "\"") or w == "uwtable" or w == "ssp"
                    cpu = cpu + " " + w
