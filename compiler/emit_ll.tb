// Слой 4б. ВЫВОД LLVM IR (опыт, включается флагом --llvm).
// Функции, где только числа (int, dec, bool), условия, циклы и вызовы таких же функций,
// пишутся сразу на языке LLVM (файл .ll), мимо C. Остальное по-прежнему идёт через C.
// Имена и способ вызова те же, что у C (f_<модуль>__<имя>), поэтому clang
// собирает .c и .ll в одну программу, и они зовут друг друга как обычно.
// Это первый шаг: дальше в .ll можно класть то, чего C не скажет (move = noalias,
// пределы чисел, вызовы слитых орбит), — свои проходы LLVM поверх готового LLVM.
use check
use memplan

obj LLGen
    out: list text
    allocas: list text
    slots: list text
    tmp: int
    open: bool
    cont: list text
    brk: list text
    fn: Node
    // xs[i + k] внутри count, у которых номер проверен один раз до цикла ("xs#i#k")
    fast: list text
    fast_depth: int
    // тексты, в которые дописывают на месте (как builders в C): у каждого ещё длина и место
    blds: list text
    // строки уровня файла: готовые тексты, объявления tb_show_N (общие для всех функций)
    decls: list text
    // память функции (как tb_fa / tb_fm в C): "" — своей области нет
    fa: text
    // параметры-ярлыки (link): их значение — по адресу из параметра
    links: list text
    ldecls: list text
    // места выходов последнего вызова f() с несколькими выходами
    mtemps: list text
    // выходы gives: имена; при нескольких выходах их места — адреса из параметров (f__ll)
    outs: list text
    multi_out: bool
    // ячейки с флагом замка (lock), самый внутренний — последний
    locks: list text
    // by vec: имя общей переменной → ячейка-копилка
    vec_names: list text
    vec_slots: list text

// имя функции: то же, что у вывода C
func ll_fname(f: Node)
    mod = ""
    each ch in f.mod
        k = code(ch)
        if (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57)
            mod = mod + ch
        else
            mod = mod + "_"
    return "f_" + mod + "__" + f.name

func ll_has(names: list text, name: text)
    each x in names
        if x == name
            return true
    return false

func ll_simple(c: Comp, t: int)
    k = kind_of(c, t)
    return k == "int" or k == "dec" or k == "bool" or k == "enum"

// у функции нет ответа (у той, которую зовут только через background, тип ещё не выведен: -1)
func ll_none(c: Comp, t: int)
    return t < 0 or kind_of(c, t) == "none"

// значение, которое LLVM держит в регистре: число, bool, enum, текст, задача, канал (указатели)
func ll_val(c: Comp, t: int) gives r: bool
    k = kind_of(c, t)
    r = ll_simple(c, t) or k == "text" or k == "task" or ll_chan(c, t)

// канал: указатель на tb_chan; значения — числа, тексты, коробки (кладутся по адресу, как в C)
func ll_chan(c: Comp, t: int)
    if kind_of(c, t) != "channel"
        return false
    e = c.types[t].elem
    return ll_simple(c, e) or kind_of(c, e) == "text" or ll_box(c, e) or ll_row(c, e)

// сколько байт значение занимает в памяти C
func ll_size(c: Comp, t: int)
    if kind_of(c, t) == "bool"
        return 1
    if ll_row(c, t)
        return 16
    return 8

func ll_is_text(c: Comp, t: int)
    return kind_of(c, t) == "text"

// список, который LLVM умеет вести: list int / dec / text / enum / Obj (не by columns) / dict / list.
// В LLVM — указатель на tb_list {data, len, cap, size}, элемент — 8 байт
func ll_numlist(c: Comp, t: int)
    if kind_of(c, t) != "list" or is_cols_list(c, t)
        return false
    e = c.types[t].elem
    if e == 1 or e == 2 or e == 4 or kind_of(c, e) == "enum" or ll_plainobj(c, e) or ll_dict(c, e)
        return true
    // список списков: внутренний — тоже такой список
    return kind_of(c, e) == "list" and ll_numlist(c, e)

// obj by columns: «строка» {список колонок, номер} — в LLVM { ptr, i64 }, как tb_row_X в C.
// Качества — числа и тексты (каждое — своя колонка в tb_cols_X {len, cap, q_a, q_b ...})
func ll_row(c: Comp, t: int)
    if kind_of(c, t) != "obj" or not is_cols_obj(c, t)
        return false
    each f in c.types[t].obj_node.kids
        k = kind_of(c, f.ty)
        if not (k == "int" or k == "dec" or k == "bool" or k == "enum" or k == "text")
            return false
    return true

// список obj by columns: указатель на tb_cols_X, len лежит первым
func ll_colist(c: Comp, t: int)
    return kind_of(c, t) == "list" and is_cols_list(c, t) and ll_row(c, c.types[t].elem)

// выражение-строка: имя, Point(...), pts[i]
func ll_row_ok(c: Comp, n: Node, names: list text)
    if not ll_row(c, n.ty)
        return false
    if n.kind == "name"
        return not n.is_link and not ll_is_global(c, n.name)
    if n.kind == "call" and n.has_ref and n.ref.kind == "obj"
        count i from 0 to len(n.ref.kids) - 1
            if n.kids[i].kind != "missing"
                v = n.kids[i].kids[0]
                if not (ll_val(c, v.ty) and ll_expr_ok(c, v, names))
                    return false
        return true
    if n.kind == "index" and ll_dict(c, n.kids[0].ty)
        return ll_box_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
    if n.kind == "call" or n.kind == "try" or n.kind == "else_err" or (n.kind == "binop" and n.value == "orelse")
        return ll_expr_ok(c, n, names)
    if n.kind == "index"
        return ll_colist(c, n.kids[0].ty) and ll_box_ok(c, n.kids[0], names) and kind_of(c, n.kids[1].ty) == "int" and ll_expr_ok(c, n.kids[1], names)
    return false

func ll_cname(c: Comp, t: int)
    if kind_of(c, t) == "list"
        return c.types[c.types[t].elem].obj_node.name
    return c.types[t].obj_node.name

func ll_lock_give(g: LLGen, name: text, fs: text)
    fv = ll_new(g, "%t")
    ll_put(g, fv + " = load i64, ptr " + fs)
    ll_put(g, "call void @tb_x_lock_give(ptr @\"tb_lk_" + name + "\", i64 " + fv + ")")

// ---------- each piece in data by N ----------
// tb_list: data (0), len (8), cap (16), size (24). Кусок: cap = -1 (расти нельзя),
// у самого списка на время цикла cap = -2 (тоже нельзя), потом прежний

func ll_lfield(g: LLGen, base: text, off: int)
    p = ll_new(g, "%t")
    ll_put(g, p + " = getelementptr inbounds i8, ptr " + base + ", i64 " + off)
    return p

func ll_pieces(g: LLGen, c: Comp, n: Node)
    l = ll_expr(g, c, n.kids[0])
    m = ll_expr(g, c, n.piece_size)
    bad = ll_new(g, "%t")
    ll_put(g, bad + " = icmp sle i64 " + m + ", 0")
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 7)
    ll_label(g, ok)
    pv = "%\"pc" + ll_new(g, "") + "\""
    g.allocas.add("  " + pv + " = alloca [4 x i64], align 8\n")
    ll_put(g, "store ptr null, ptr " + pv)
    ll_put(g, "store i64 0, ptr " + ll_lfield(g, pv, 8))
    ll_put(g, "store i64 -1, ptr " + ll_lfield(g, pv, 16))
    sz = ll_new(g, "%t")
    ll_put(g, sz + " = load i64, ptr " + ll_lfield(g, l, 24))
    ll_put(g, "store i64 " + sz + ", ptr " + ll_lfield(g, pv, 24))
    capp = ll_lfield(g, l, 16)
    cap0 = ll_new(g, "%t")
    ll_put(g, cap0 + " = load i64, ptr " + capp)
    nneg = ll_new(g, "%t")
    ll_put(g, nneg + " = icmp sge i64 " + cap0 + ", 0")
    cap1 = ll_new(g, "%t")
    ll_put(g, cap1 + " = select i1 " + nneg + ", i64 -2, i64 " + cap0)
    ll_put(g, "store i64 " + cap1 + ", ptr " + capp)
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_term(g, "br label %" + head)
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    ln = ll_len(g, l)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    d = ll_new(g, "%t")
    ll_put(g, d + " = load ptr, ptr " + l)
    off = ll_new(g, "%t")
    ll_put(g, off + " = mul i64 " + iv + ", " + sz)
    pd = ll_new(g, "%t")
    ll_put(g, pd + " = getelementptr inbounds i8, ptr " + d + ", i64 " + off)
    ll_put(g, "store ptr " + pd + ", ptr " + pv)
    rest = ll_new(g, "%t")
    ll_put(g, rest + " = sub i64 " + ln + ", " + iv)
    small = ll_new(g, "%t")
    ll_put(g, small + " = icmp slt i64 " + rest + ", " + m)
    pl = ll_new(g, "%t")
    ll_put(g, pl + " = select i1 " + small + ", i64 " + rest + ", i64 " + m)
    ll_put(g, "store i64 " + pl + ", ptr " + ll_lfield(g, pv, 8))
    ll_put(g, "store ptr " + pv + ", ptr " + ll_slot(g, c, n.name, n.kids[0].ty))
    g.cont.add(step)
    g.brk.add(out)
    ll_block(g, c, n.kids[1])
    gc1 = g.cont.pop()
    gb1 = g.brk.pop()
    if g.open
        ll_term(g, "br label %" + step)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add i64 " + iv2 + ", " + m)
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)
    ll_put(g, "store i64 " + cap0 + ", ptr " + capp)

// asm: текст как у расширенного asm в C (%% — это %), в LLVM $ пишется как $$
func ll_asm(g: LLGen, v: text)
    bytes, ok = ll_str_bytes(v)
    hex = "0123456789ABCDEF"
    body = ""
    i = 0
    repeat while i < len(bytes)
        b = bytes[i]
        if b == 37 and i + 1 < len(bytes) and bytes[i + 1] == 37
            body = body + "%"
            i += 1
        else if b == 36
            body = body + "$$"
        else if b >= 32 and b < 127 and b != 34 and b != 92
            body = body + char(b)
        else
            body = body + "\\" + hex[b / 16] + hex[b % 16]
        i += 1
    ll_put(g, "call void asm sideeffect \"" + body + "\", \"~{memory},~{dirflag},~{fpsr},~{flags}\"()")

// ---------- together ----------
// подсказки памяти (как в C): сначала для всех d[key] / xs[i] просим принести место,
// потом у dict — сами ключи и значения, потом обычные строки

// можно посчитать лишний раз: ничего не меняет и не падает (как is_pure в C)
func ll_pure(n: Node)
    k = n.kind
    if k == "number" or k == "decimal" or k == "string" or k == "bool" or k == "name"
        return true
    if k == "field" or k == "unary"
        return ll_pure(n.kids[0])
    if k == "binop"
        if n.value == "/" or n.value == "%"
            return false
        return ll_pure(n.kids[0]) and ll_pure(n.kids[1])
    return false

func ll_together(g: LLGen, c: Comp, n: Node)
    block = n.kids[0]
    hs = list text
    each st in block.kids
        h = ""
        if len(st.kids) > 0
            v = st.kids[0]
            if v.kind == "index" and ll_pure(v.kids[0]) and ll_pure(v.kids[1])
                if ll_dict(c, v.kids[0].ty)
                    d = ll_expr(g, c, v.kids[0])
                    kp = ll_key_ptr(g, c, v.kids[0].ty, v.kids[1])
                    h = ll_new(g, "%t")
                    ll_put(g, h + " = call i64 @tb_x_dpre1(ptr " + d + ", ptr " + kp + ")")
                else if ll_numlist(c, v.kids[0].ty)
                    l = ll_expr(g, c, v.kids[0])
                    ix = ll_expr(g, c, v.kids[1])
                    ll_put(g, "call void @tb_x_lpre(ptr " + l + ", i64 " + ix + ")")
        hs.add(h)
    count j from 0 to len(block.kids) - 1
        if hs[j] != ""
            d2 = ll_expr(g, c, block.kids[j].kids[0].kids[0])
            ll_put(g, "call void @tb_x_dpre2(ptr " + d2 + ", i64 " + hs[j] + ")")
    ll_block(g, c, block)

// ---------- by vec ----------

func ll_vec(g: LLGen, c: Comp, n: Node)
    lt = n.kids[0].ty
    et = ll_elem_ty(c, lt)
    base = ll_expr(g, c, n.kids[0])
    data = ll_new(g, "%t")
    ll_put(g, data + " = load ptr, ptr " + base + ", !tbaa !10")
    ln = ll_len(g, base)
    id = ll_new(g, "")
    accs = list text
    shs = list Var
    each v in n.caps
        if v.is_shared
            shs.add(v)
            count k from 0 to 7
                a = "%\"va" + id + "." + v.name + "." + k + "\""
                g.allocas.add("  " + a + " = alloca " + ll_ty(c, v.type) + "\n")
                ll_put(g, "store " + ll_ty(c, v.type) + " " + ll_default(g, c, v.type) + ", ptr " + a)
                accs.add(a)
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    // 1) по 8 чисел: тело 8 раз подряд, у каждой копии свои копилки
    h8 = ll_new(g, "L")
    b8 = ll_new(g, "L")
    tail = ll_new(g, "L")
    ll_term(g, "br label %" + h8)
    ll_label(g, h8)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    i8 = ll_new(g, "%t")
    ll_put(g, i8 + " = add i64 " + iv + ", 8")
    c8 = ll_new(g, "%t")
    ll_put(g, c8 + " = icmp sle i64 " + i8 + ", " + ln)
    ll_term(g, "br i1 " + c8 + ", label %" + b8 + ", label %" + tail)
    ll_label(g, b8)
    count k from 0 to 7
        ix = ll_new(g, "%t")
        ll_put(g, ix + " = add i64 " + iv + ", " + k)
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds " + et + ", ptr " + data + ", i64 " + ix)
        ev = ll_new(g, "%t")
        ll_put(g, ev + " = load " + et + ", ptr " + ep + ll_elem_tag(c, lt))
        ll_put(g, "store " + et + " " + ev + ", ptr " + ll_slot(g, c, n.name, c.types[lt].elem))
        ll_vec_map(g, shs, accs, k)
        after = ll_new(g, "L")
        // skip и stop заканчивают только эту копию (как do { } while (0) в C)
        g.cont.add(after)
        g.brk.add(after)
        ll_block(g, c, n.kids[1])
        gc1 = g.cont.pop()
        gb1 = g.brk.pop()
        ll_vec_unmap(g)
        if g.open
            ll_term(g, "br label %" + after)
        ll_label(g, after)
    ll_put(g, "store i64 " + i8 + ", ptr " + islot)
    ll_term(g, "br label %" + h8)
    // 2) хвост: последние 0–7 чисел по одному, в копилку 0
    ll_label(g, tail)
    th = ll_new(g, "L")
    tb = ll_new(g, "L")
    ts = ll_new(g, "L")
    done = ll_new(g, "L")
    ll_term(g, "br label %" + th)
    ll_label(g, th)
    tv = ll_new(g, "%t")
    ll_put(g, tv + " = load i64, ptr " + islot)
    tc = ll_new(g, "%t")
    ll_put(g, tc + " = icmp slt i64 " + tv + ", " + ln)
    ll_term(g, "br i1 " + tc + ", label %" + tb + ", label %" + done)
    ll_label(g, tb)
    tp = ll_new(g, "%t")
    ll_put(g, tp + " = getelementptr inbounds " + et + ", ptr " + data + ", i64 " + tv)
    tval = ll_new(g, "%t")
    ll_put(g, tval + " = load " + et + ", ptr " + tp + ll_elem_tag(c, lt))
    ll_put(g, "store " + et + " " + tval + ", ptr " + ll_slot(g, c, n.name, c.types[lt].elem))
    ll_vec_map(g, shs, accs, 0)
    g.cont.add(ts)
    g.brk.add(done)
    ll_block(g, c, n.kids[1])
    gc2 = g.cont.pop()
    gb2 = g.brk.pop()
    ll_vec_unmap(g)
    if g.open
        ll_term(g, "br label %" + ts)
    ll_label(g, ts)
    tv2 = ll_new(g, "%t")
    ll_put(g, tv2 + " = load i64, ptr " + islot)
    tn = ll_new(g, "%t")
    ll_put(g, tn + " = add nsw i64 " + tv2 + ", 1")
    ll_put(g, "store i64 " + tn + ", ptr " + islot)
    ll_term(g, "br label %" + th)
    ll_label(g, done)
    // 3) сложить копилки деревом: ((0+1)+(2+3))+((4+5)+(6+7)), потом в общую
    count q from 0 to len(shs) - 1
        v = shs[q]
        ty = ll_ty(c, v.type)
        op = "add"
        if ty == "double"
            op = "fadd"
        vals = list text
        count k from 0 to 7
            lv = ll_new(g, "%t")
            ll_put(g, lv + " = load " + ty + ", ptr " + accs[q * 8 + k])
            vals.add(lv)
        repeat while len(vals) > 1
            nv = list text
            count p from 0 to len(vals) / 2 - 1
                sv = ll_new(g, "%t")
                ll_put(g, sv + " = " + op + " " + ty + " " + vals[2 * p] + ", " + vals[2 * p + 1])
                nv.add(sv)
            vals = nv
        tslot = ll_slot(g, c, v.name, v.type)
        old = ll_new(g, "%t")
        ll_put(g, old + " = load " + ty + ", ptr " + tslot)
        nw = ll_new(g, "%t")
        ll_put(g, nw + " = " + op + " " + ty + " " + old + ", " + vals[0])
        ll_put(g, "store " + ty + " " + nw + ", ptr " + tslot)

func ll_vec_map(g: LLGen, shs: list Var, accs: list text, k: int)
    count q from 0 to len(shs) - 1
        g.vec_names.add(shs[q].name)
        g.vec_slots.add(accs[q * 8 + k])

func ll_vec_unmap(g: LLGen)
    e1 = list text
    e2 = list text
    g.vec_names = e1
    g.vec_slots = e2

// ---------- on all cores ----------

// задание для ядер: { lo, total, step, next, список, захваченные переменные... }
func ll_job_ty(c: Comp, n: Node)
    t = "{ i64, i64, i64, i64, ptr"
    each v in n.caps
        if v.is_shared or v.is_link
            t = t + ", ptr"
        else
            t = t + ", " + ll_ty(c, v.type)
    return t + " }"

func ll_job_at(g: LLGen, jt: text, job: text, k: int)
    p = ll_new(g, "%t")
    ll_put(g, p + " = getelementptr inbounds " + jt + ", ptr " + job + ", i32 0, i32 " + k)
    return p

func ll_par(g: LLGen, c: Comp, n: Node)
    is_each = n.kind == "each"
    jt = ll_job_ty(c, n)
    g.tmp += 1
    wname = "@\"tb.work." + ll_fname(g.fn) + "." + g.tmp + "\""
    // 1) работник: своя функция со своими ячейками
    w = LLGen(tmp: g.tmp, open: true, fn: g.fn, decls: g.decls, fa: "")
    count k from 0 to len(n.caps) - 1
        v = n.caps[k]
        at = "%\"jc" + k + "\""
        w.out.add("  " + at + " = getelementptr inbounds " + jt + ", ptr %\"job\", i32 0, i32 " + (5 + k) + "\n")
        if v.is_shared
            ll_put(w, "store " + ll_ty(c, v.type) + " " + ll_default(w, c, v.type) + ", ptr " + ll_slot(w, c, v.name, v.type))
            if ll_is_text(c, v.type)
                // общий текст: у каждого ядра свой текст с запасом, += дописывает в его конец
                w.blds.add(v.name)
                w.allocas.add("  " + ll_rl(w, v.name) + " = alloca i64\n  " + ll_rc(w, v.name) + " = alloca i64\n")
                ll_put(w, "store i64 -1, ptr " + ll_rl(w, v.name))
                ll_put(w, "store i64 0, ptr " + ll_rc(w, v.name))
        else if v.is_link
            w.links.add(v.name)
            w.out.add("  %\"p." + v.name + "\" = load ptr, ptr " + at + "\n")
        else
            lv = ll_new(w, "%t")
            ll_put(w, lv + " = load " + ll_ty(c, v.type) + ", ptr " + at)
            ll_put(w, "store " + ll_ty(c, v.type) + " " + lv + ", ptr " + ll_slot(w, c, v.name, v.type))
    lo = ll_load_job(w, jt, 0)
    total = ll_load_job(w, jt, 1)
    stp = ll_load_job(w, jt, 2)
    lst = ""
    if is_each
        lst = ll_load_job(w, jt, 4)
    nxp = ll_job_at(w, jt, "%\"job\"", 3)
    chunk = ll_new(w, "L")
    work = ll_new(w, "L")
    done = ll_new(w, "L")
    ll_term(w, "br label %" + chunk)
    ll_label(w, chunk)
    st = ll_new(w, "%t")
    ll_put(w, st + " = atomicrmw add ptr " + nxp + ", i64 " + stp + " monotonic")
    over = ll_new(w, "%t")
    ll_put(w, over + " = icmp sge i64 " + st + ", " + total)
    ll_term(w, "br i1 " + over + ", label %" + done + ", label %" + work)
    ll_label(w, work)
    e0 = ll_new(w, "%t")
    ll_put(w, e0 + " = add i64 " + st + ", " + stp)
    big = ll_new(w, "%t")
    ll_put(w, big + " = icmp sgt i64 " + e0 + ", " + total)
    en = ll_new(w, "%t")
    ll_put(w, en + " = select i1 " + big + ", i64 " + total + ", i64 " + e0)
    islot = ll_slot(w, c, ll_new(w, "e"), 1)
    ll_put(w, "store i64 " + st + ", ptr " + islot)
    head = ll_new(w, "L")
    body = ll_new(w, "L")
    step = ll_new(w, "L")
    ll_term(w, "br label %" + head)
    ll_label(w, head)
    iv = ll_new(w, "%t")
    ll_put(w, iv + " = load i64, ptr " + islot)
    cv = ll_new(w, "%t")
    ll_put(w, cv + " = icmp slt i64 " + iv + ", " + en)
    ll_term(w, "br i1 " + cv + ", label %" + body + ", label %" + chunk)
    ll_label(w, body)
    blk = n.kids[1]
    if is_each
        lt = n.kids[0].ty
        et = c.types[lt].elem
        if ll_colist(c, lt)
            rv = ll_mkrow(w, lst, iv)
            ll_put(w, "store { ptr, i64 } " + rv + ", ptr " + ll_slot(w, c, n.name, et))
        else if ll_bits(c, lt)
            bv = ll_new(w, "%t")
            ll_put(w, bv + " = call zeroext i1 @tb_x_bget(ptr " + lst + ", i64 " + iv + ", i32 " + n.line + ")")
            ll_put(w, "store i1 " + bv + ", ptr " + ll_slot(w, c, n.name, 3))
        else
            d = ll_new(w, "%t")
            ll_put(w, d + " = load ptr, ptr " + lst + ", !tbaa !10")
            ep = ll_new(w, "%t")
            ll_put(w, ep + " = getelementptr inbounds " + ll_elem_ty(c, lt) + ", ptr " + d + ", i64 " + iv)
            ev = ll_new(w, "%t")
            ll_put(w, ev + " = load " + ll_elem_ty(c, lt) + ", ptr " + ep + ll_elem_tag(c, lt))
            ll_put(w, "store " + ll_elem_ty(c, lt) + " " + ev + ", ptr " + ll_slot(w, c, n.name, et))
    else
        cnum = ll_new(w, "%t")
        ll_put(w, cnum + " = add nsw i64 " + lo + ", " + iv)
        ll_put(w, "store i64 " + cnum + ", ptr " + ll_slot(w, c, n.name, 1))
        blk = n.kids[2]
    // skip — к следующему номеру, stop — к следующему куску (как break во внутреннем for в C)
    w.cont.add(step)
    w.brk.add(chunk)
    ll_block(w, c, blk)
    gone_c = w.cont.pop()
    gone_b = w.brk.pop()
    if w.open
        ll_term(w, "br label %" + step)
    ll_label(w, step)
    iv2 = ll_new(w, "%t")
    ll_put(w, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(w, "%t")
    ll_put(w, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(w, "store i64 " + nx + ", ptr " + islot)
    ll_term(w, "br label %" + head)
    ll_label(w, done)
    shared_any = false
    each v in n.caps
        if v.is_shared
            shared_any = true
    if shared_any
        // ядра по очереди кладут своё в общее (как tb_par_lock в C)
        ll_put(w, "call void @tb_x_par_lock()")
        count k from 0 to len(n.caps) - 1
            v = n.caps[k]
            if v.is_shared and ll_is_text(c, v.type)
                // свой кусок — в конец общего (tb_app_take, как в C)
                bp = ll_new(w, "%t")
                ll_put(w, bp + " = load ptr, ptr %\"jc" + k + "\"")
                mv = ll_new(w, "%t")
                ll_put(w, mv + " = load ptr, ptr " + ll_slot(w, c, v.name, v.type))
                rlv = ll_new(w, "%t")
                ll_put(w, rlv + " = load i64, ptr " + ll_rl(w, v.name))
                rcv = ll_new(w, "%t")
                ll_put(w, rcv + " = load i64, ptr " + ll_rc(w, v.name))
                ll_put(w, "call void @tb_x_app_take(ptr " + bp + ", ptr " + ll_lfield(w, bp, 8) + ", ptr " + ll_lfield(w, bp, 16) + ", ptr " + mv + ", i64 " + rlv + ", i64 " + rcv + ")")
            else if v.is_shared
                sp = ll_new(w, "%t")
                ll_put(w, sp + " = load ptr, ptr %\"jc" + k + "\"")
                old = ll_new(w, "%t")
                ty = ll_ty(c, v.type)
                ll_put(w, old + " = load " + ty + ", ptr " + sp)
                mine = ll_new(w, "%t")
                ll_put(w, mine + " = load " + ty + ", ptr " + ll_slot(w, c, v.name, v.type))
                sum = ll_new(w, "%t")
                if ty == "double"
                    ll_put(w, sum + " = fadd double " + old + ", " + mine)
                else
                    ll_put(w, sum + " = add i64 " + old + ", " + mine)
                ll_put(w, "store " + ty + " " + sum + ", ptr " + sp)
        ll_put(w, "call void @tb_x_par_unlock()")
    ll_term(w, "ret ptr null")
    g.tmp = w.tmp
    g.decls.add("define internal ptr " + wname + "(ptr %\"job\") #0 {\nentry:\n")
    each a in w.allocas
        g.decls.add(a)
    each x in w.out
        g.decls.add(x)
    g.decls.add("}\n\n")
    // 2) на месте цикла: заполнить задание и запустить ядра
    job = "%\"job" + ll_new(g, "") + "\""
    g.allocas.add("  " + job + " = alloca " + jt + "\n")
    tot = ""
    if is_each
        lv = ll_expr(g, c, n.kids[0])
        ll_put(g, "store ptr " + lv + ", ptr " + ll_job_at(g, jt, job, 4))
        ln = ""
        if ll_colist(c, n.kids[0].ty)
            ln = ll_clen(g, lv)
        else
            ln = ll_len(g, lv)
        ll_put(g, "store i64 0, ptr " + ll_job_at(g, jt, job, 0))
        tot = ln
    else
        hi = ll_expr(g, c, n.kids[1])
        lo0 = ll_expr(g, c, n.kids[0])
        ll_put(g, "store i64 " + lo0 + ", ptr " + ll_job_at(g, jt, job, 0))
        ll_put(g, "store ptr null, ptr " + ll_job_at(g, jt, job, 4))
        d1 = ll_new(g, "%t")
        ll_put(g, d1 + " = sub i64 " + hi + ", " + lo0)
        d2 = ll_new(g, "%t")
        ll_put(g, d2 + " = add i64 " + d1 + ", 1")
        neg = ll_new(g, "%t")
        ll_put(g, neg + " = icmp slt i64 " + hi + ", " + lo0)
        tot = ll_new(g, "%t")
        ll_put(g, tot + " = select i1 " + neg + ", i64 0, i64 " + d2)
    ll_put(g, "store i64 " + tot + ", ptr " + ll_job_at(g, jt, job, 1))
    ll_put(g, "store i64 0, ptr " + ll_job_at(g, jt, job, 3))
    texts = list text
    tnames = list text
    count k from 0 to len(n.caps) - 1
        v = n.caps[k]
        at = ll_job_at(g, jt, job, 5 + k)
        if v.is_shared and ll_is_text(c, v.type)
            // общий текст: {текст, длина своей памяти, место} — ядра дописывают сюда
            tbk = "%\"tx" + ll_new(g, "") + "\""
            g.allocas.add("  " + tbk + " = alloca [3 x i64], align 8\n")
            texts.add(tbk)
            tnames.add(v.name)
            cur = ll_new(g, "%t")
            ll_put(g, cur + " = load ptr, ptr " + ll_slot(g, c, v.name, v.type))
            ll_put(g, "store ptr " + cur + ", ptr " + tbk)
            ll_put(g, "store i64 -1, ptr " + ll_lfield(g, tbk, 8))
            ll_put(g, "store i64 0, ptr " + ll_lfield(g, tbk, 16))
            ll_put(g, "store ptr " + tbk + ", ptr " + at)
        else if v.is_shared
            ll_put(g, "store ptr " + ll_slot(g, c, v.name, v.type) + ", ptr " + at)
        else if v.is_link
            ll_put(g, "store ptr " + ll_slot(g, c, v.name, v.type) + ", ptr " + at)
        else
            cvv = ll_new(g, "%t")
            ll_put(g, cvv + " = load " + ll_ty(c, v.type) + ", ptr " + ll_slot(g, c, v.name, v.type))
            ll_put(g, "store " + ll_ty(c, v.type) + " " + cvv + ", ptr " + at)
    sv = ll_new(g, "%t")
    ll_put(g, sv + " = call i64 @tb_x_par_step(i64 " + tot + ")")
    ll_put(g, "store i64 " + sv + ", ptr " + ll_job_at(g, jt, job, 2))
    ll_put(g, "call void @tb_x_par_run(ptr " + wname + ", ptr " + job + ", i64 " + tot + ")")
    count q from 0 to len(texts) - 1
        res = ll_new(g, "%t")
        ll_put(g, res + " = load ptr, ptr " + texts[q])
        ll_put(g, "store ptr " + res + ", ptr " + ll_slot(g, c, tnames[q], 4))

func ll_load_job(w: LLGen, jt: text, k: int)
    p = ll_job_at(w, jt, "%\"job\"", k)
    r = ll_new(w, "%t")
    ty = "i64"
    if k == 4
        ty = "ptr"
    ll_put(w, r + " = load " + ty + ", ptr " + p)
    return r

// ---------- obj by columns ----------

func ll_cneed(g: LLGen, c: Comp, t: int)
    nm = ll_cname(c, t)
    ll_need(g, "declare ptr @tb_lc_new_" + nm + "()\ndeclare void @tb_lc_add_" + nm + "(ptr, ptr, i64, i32)\ndeclare void @tb_lc_set_" + nm + "(ptr, i64, ptr, i64, i32)\ndeclare ptr @tb_lc_from_" + nm + "(i64, ptr)\n")
    return nm

// строка из двух частей
func ll_mkrow(g: LLGen, a: text, i: text)
    r1 = ll_new(g, "%t")
    ll_put(g, r1 + " = insertvalue { ptr, i64 } undef, ptr " + a + ", 0")
    r2 = ll_new(g, "%t")
    ll_put(g, r2 + " = insertvalue { ptr, i64 } " + r1 + ", i64 " + i + ", 1")
    return r2

func ll_rpart(g: LLGen, r: text, k: int)
    x = ll_new(g, "%t")
    ll_put(g, x + " = extractvalue { ptr, i64 } " + r + ", " + k)
    return x

// длина списка колонок: первое поле tb_cols_X
func ll_clen(g: LLGen, base: text)
    r = ll_new(g, "%t")
    ll_put(g, r + " = load i64, ptr " + base)
    return r

// pts[i] с проверкой номера → {pts, i}
func ll_col_at(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    idx = ll_expr(g, c, n.kids[1])
    ln = ll_clen(g, base)
    bad = ll_new(g, "%t")
    ll_put(g, bad + " = icmp uge i64 " + idx + ", " + ln)
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 3)
    ll_label(g, ok)
    return ll_mkrow(g, base, idx)

// Point(...): новая строка — свой список колонок из одного элемента (tb_new_X в C)
func ll_new_row(g: LLGen, c: Comp, n: Node)
    o = n.ref
    args = ""
    tys = ""
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        v = ""
        if n.kids[i].kind == "missing"
            v = ll_default(g, c, ft)
        else
            v = ll_as(g, c, n.kids[i].kids[0], ft)
        if i > 0
            args = args + ", "
            tys = tys + ", "
        args = args + ll_ty(c, ft) + " " + ll_ext(c, ft) + v
        tys = tys + ll_ty(c, ft) + " " + ll_ext(c, ft)
    ll_need(g, "declare ptr @tb_lc_make_" + o.name + "(" + tys + ")\n")
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_lc_make_" + o.name + "(" + args + ")")
    return ll_mkrow(g, r, "0")

// адрес качества строки: колонка q_f (после len и cap), в ней элемент номер i
func ll_row_field_ptr(g: LLGen, c: Comp, n: Node)
    r = ll_expr(g, c, n.kids[0])
    a = ll_rpart(g, r, 0)
    i = ll_rpart(g, r, 1)
    z = ll_new(g, "%t")
    ll_put(g, z + " = icmp eq ptr " + a + ", null")
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + z + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 5)
    ll_label(g, ok)
    o = c.types[n.kids[0].ty].obj_node
    at = 0
    count k from 0 to len(o.kids) - 1
        if o.kids[k].name == n.name
            at = k
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds i8, ptr " + a + ", i64 " + (16 + 8 * at))
    col = ll_new(g, "%t")
    ll_put(g, col + " = load ptr, ptr " + cp)
    ep = ll_new(g, "%t")
    ll_put(g, ep + " = getelementptr inbounds " + ll_mem_ty(c, n.ty) + ", ptr " + col + ", i64 " + i)
    return ep

// [Point(...), ...]: строки во временный массив, потом tb_colsfrom_X
func ll_col_lit(g: LLGen, c: Comp, n: Node)
    nm = ll_cneed(g, c, n.ty)
    nk = len(n.kids)
    if nk == 0
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = call ptr @tb_lc_new_" + nm + "()")
        return r0
    arr = "%\"arr" + ll_new(g, "") + "\""
    g.allocas.add("  " + arr + " = alloca [" + nk + " x { ptr, i64 }]\n")
    count i from 0 to nk - 1
        v = ll_expr(g, c, n.kids[i])
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds { ptr, i64 }, ptr " + arr + ", i64 " + i)
        ll_put(g, "store { ptr, i64 } " + v + ", ptr " + ep)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_lc_from_" + nm + "(i64 " + nk + ", ptr " + arr + ")")
    return r

// each a in pts: a = {pts, i}, len читается на каждом шаге
func ll_each_cols(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    ln = ll_clen(g, base)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    rv = ll_mkrow(g, base, iv)
    et = c.types[n.kids[0].ty].elem
    ll_put(g, "store { ptr, i64 } " + rv + ", ptr " + ll_slot(g, c, n.name, et))
    ll_loop_body(g, c, n.kids[1], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

// list bool: по биту на элемент (tb_bget/tb_bset/tb_badd/tb_bpop из C, LTO их встраивает)
func ll_bits(c: Comp, t: int)
    return kind_of(c, t) == "list" and c.types[t].elem == 3

// в списке адреса (тексты, obj): уборка памяти должна смотреть внутрь
func ll_ptr_elems(c: Comp, t: int)
    e = c.types[t].elem
    return not (e == 1 or e == 2 or kind_of(c, e) == "enum")

func ll_elem_ty(c: Comp, t: int)
    if c.types[t].elem == 2
        return "double"
    if ll_ptr_elems(c, t)
        return "ptr"
    return "i64"

// элемент годится для этого списка: число как число, текст/obj — как значение-коробка
func ll_elem_ok(c: Comp, lt: int, v: Node, names: list text)
    if ll_colist(c, lt)
        return ll_row_ok(c, v, names)
    if ll_bits(c, lt)
        return kind_of(c, v.ty) == "bool" and ll_expr_ok(c, v, names)
    if ll_ptr_elems(c, lt)
        if ll_box(c, v.ty)
            return ll_box_ok(c, v, names)
        return ll_is_text(c, v.ty) and ll_expr_ok(c, v, names)
    return ll_simple(c, v.ty) and ll_expr_ok(c, v, names)

// пометки для LLVM (TBAA): числа в списках и устройство списка (data, len) никогда не лежат
// в одной памяти, а int и dec — тоже. C этого сказать не может: у него len и элементы int —
// оба long long, и после каждой записи в список он заново читает len.
func ll_elem_tag(c: Comp, t: int)
    if c.types[t].elem == 2
        return ", !tbaa !12"
    if ll_ptr_elems(c, t)
        return ", !tbaa !13"
    return ", !tbaa !11"

// список, который LLVM умеет вести: своё имя, качество obj (p.tags), ответ функции, d.keys() ...
func ll_list_name_ok(c: Comp, n: Node, names: list text)
    if not (ll_numlist(c, n.ty) or ll_bits(c, n.ty))
        return false
    if n.kind == "name"
        return not n.is_link and not ll_is_global(c, n.name)
    return ll_box_ok(c, n, names)

// obj (не by columns), у которого все качества LLVM может разложить так же, как C
func ll_plainobj(c: Comp, t: int)
    if kind_of(c, t) != "obj" or is_cols_obj(c, t)
        return false
    each f in c.types[t].obj_node.kids
        k = kind_of(c, f.ty)
        if not (k == "int" or k == "dec" or k == "bool" or k == "enum" or k == "text" or k == "list" or k == "dict" or k == "obj" or k == "task" or k == "channel")
            return false
        if k == "obj" and is_cols_obj(c, f.ty)
            return false
    return true

// имя obj или списка чисел, которое можно отдать другой функции
func ll_ref_name_ok(c: Comp, n: Node)
    return n.kind == "name" and not n.is_link and ll_box(c, n.ty) and not ll_is_global(c, n.name)

// список, obj или dict: в LLVM — указатель
func ll_box(c: Comp, t: int)
    return ll_numlist(c, t) or ll_bits(c, t) or ll_colist(c, t) or ll_plainobj(c, t) or ll_dict(c, t)

// dict с ключом int или text и значением, которое LLVM умеет класть и брать (8 байт, bool — 1)
func ll_dict(c: Comp, t: int)
    if kind_of(c, t) != "dict"
        return false
    kk = kind_of(c, c.types[t].key)
    if not (kk == "int" or kk == "text")
        return false
    e = c.types[t].elem
    return ll_val(c, e) or ll_numlist(c, e) or ll_plainobj(c, e) or ll_row(c, e) or (kind_of(c, e) == "dict" and ll_dict(c, e))

// значение подходит туда, где ждут тип t
func ll_value_ok(c: Comp, t: int, v: Node, names: list text)
    if ll_row(c, t)
        return ll_row_ok(c, v, names)
    if ll_box(c, t)
        return ll_box(c, v.ty) and ll_box_ok(c, v, names)
    if ll_is_text(c, t)
        return ll_is_text(c, v.ty) and ll_expr_ok(c, v, names)
    if not ll_simple(c, t)
        // задача, канал: тот же тип
        return v.ty == t and ll_val(c, t) and ll_expr_ok(c, v, names)
    return ll_simple(c, v.ty) and ll_expr_ok(c, v, names)

// выражение-коробка, которое LLVM умеет посчитать: имя, [1, 2, 3], Ball(...), вызов, p.tags
func ll_box_ok(c: Comp, n: Node, names: list text)
    if not ll_box(c, n.ty)
        return false
    k = n.kind
    if k == "name"
        return ll_ref_name_ok(c, n)
    if k == "list"
        each x in n.kids
            if not ll_elem_ok(c, n.ty, x, names)
                return false
        return true
    if k == "dict"
        i = 0
        repeat while i + 1 < len(n.kids)
            if not (ll_expr_ok(c, n.kids[i], names) and ll_value_ok(c, c.types[n.ty].elem, n.kids[i + 1], names))
                return false
            i += 2
        return true
    if k == "call" and n.has_ref and n.ref.kind == "obj"
        return ll_new_ok(c, n, names)
    if k == "call" or k == "field" or k == "index" or k == "method" or k == "try" or k == "else_err" or (k == "binop" and n.value == "orelse")
        return ll_expr_ok(c, n, names)
    return false

// Ball(name: ..., x: ...): каждое качество — значение, которое LLVM умеет посчитать,
// а пропущенное — то, что LLVM умеет поставить по умолчанию
func ll_new_ok(c: Comp, n: Node, names: list text)
    if not ll_plainobj(c, n.ty)
        return false
    o = n.ref
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        if n.kids[i].kind == "missing"
            if not (ll_val(c, ft) or ll_box(c, ft))
                return false
        else
            v = n.kids[i].kids[0]
            if ll_val(c, ft)
                if not (ll_val(c, v.ty) and ll_expr_ok(c, v, names))
                    return false
            else if ll_box(c, ft)
                if not ll_box_ok(c, v, names)
                    return false
            else
                return false
    return true

// качество в памяти: как в C (long long → i64, double, _Bool → i8, остальное — указатель)
func ll_mem_ty(c: Comp, t: int)
    k = kind_of(c, t)
    if k == "obj" and is_cols_obj(c, t)
        return "{ ptr, i64 }"
    if k == "dec"
        return "double"
    if k == "bool"
        return "i8"
    if k == "int" or k == "enum"
        return "i64"
    return "ptr"

func ll_ty(c: Comp, t: int)
    k = kind_of(c, t)
    if k == "obj" and is_cols_obj(c, t)
        return "{ ptr, i64 }"
    if k == "list" or k == "obj" or k == "text" or k == "dict" or k == "task" or k == "channel"
        return "ptr"
    if k == "dec"
        return "double"
    if k == "bool"
        return "i1"
    if k == "none" or k == "unknown"
        return "void"
    return "i64"

// у bool в C (_Bool) при вызове есть пометка zeroext
func ll_ext(c: Comp, t: int)
    if kind_of(c, t) == "bool"
        return "zeroext "
    return ""

// shared снаружи функций: из LLVM — та же переменная C (v_имя); int, dec и bool
func ll_global_ok(c: Comp, name: text, t: int)
    if not ll_is_global(c, name)
        return true
    k = kind_of(c, t)
    // bool в C — байт 0/1; LLVM пишет i1 в байт с нулями сверху, читает так же
    return k == "int" or k == "dec" or k == "bool"

// ярлык (link) на число или текст: в LLVM — указатель на саму переменную того, кто позвал
func ll_link_ok(c: Comp, t: int)
    k = kind_of(c, t)
    return k == "int" or k == "dec" or k == "enum" or k == "text"

func ll_is_global(c: Comp, name: text)
    each g in c.globals
        if g.name == name
            return true
    return false

// десятичное число, которое LLVM примет как есть: целая часть + дробь из половинок/четвертей/восьмых
func ll_dec_ok(v: text)
    if ll_dec_exact(v)
        return true
    m, k = ll_dec_parts(v)
    return len(m) <= 15 and k <= 22

// дробь, которую LLVM примет как есть (.5, .25, .125 ...)
func ll_dec_exact(v: text)
    dot = find(v, ".")
    if dot < 0 or dot > 15
        return false
    frac = cut(v, dot + 1, len(v) - 1)
    repeat while len(frac) > 0 and ends_with(frac, "0")
        frac = cut(frac, 0, len(frac) - 2)
    return frac == "" or frac == "5" or frac == "25" or frac == "75" or frac == "125" or frac == "375" or frac == "625" or frac == "875"

// 2.60 → m = "26", k = 1 (2.6 = 26 / 10^1); m без нулей впереди и позади
func ll_dec_parts(v: text) gives m: text, k: int
    dot = find(v, ".")
    frac = cut(v, dot + 1, len(v) - 1)
    repeat while len(frac) > 0 and ends_with(frac, "0")
        frac = cut(frac, 0, len(frac) - 2)
    m = cut(v, 0, dot - 1) + frac
    k = len(frac)
    repeat while len(m) > 1 and starts_with(m, "0")
        m = cut(m, 1, len(m) - 1)

// любая дробь: целое m делим на 10^k. Оба числа точные, а деление в IEEE округляет
// верно — получается то же число, что у C из "2.6". LLVM сворачивает его сразу.
func ll_decimal(g: LLGen, v: text)
    if ll_dec_exact(v)
        return v
    m, k = ll_dec_parts(v)
    r = ll_new(g, "%t")
    ll_put(g, r + " = fdiv double " + m + ".0, 1.0e" + k)
    return r

// текст в кавычках, как его понимает C ("a\\n\\x41"): байты без кавычек; ok = false — LLVM не берём
func ll_str_bytes(v: text) gives bytes: list int, ok: bool
    ok = true
    i = 1
    last = len(v) - 2
    repeat while i <= last
        b = code(v[i])
        if b != 92
            bytes.add(b)
            i += 1
            skip
        if i + 1 > last
            ok = false
            return
        e = v[i + 1]
        i += 2
        if e == "n"
            bytes.add(10)
        else if e == "t"
            bytes.add(9)
        else if e == "r"
            bytes.add(13)
        else if e == "\\" or e == "\"" or e == "'" or e == "?"
            bytes.add(code(e))
        else if e == "a"
            bytes.add(7)
        else if e == "b"
            bytes.add(8)
        else if e == "f"
            bytes.add(12)
        else if e == "v"
            bytes.add(11)
        else if e == "e"
            bytes.add(27)
        else if code(e) >= 48 and code(e) <= 55
            // \0, \012: до трёх восьмеричных цифр
            x = code(e) - 48
            got = 1
            repeat while got < 3 and i <= last and code(v[i]) >= 48 and code(v[i]) <= 55
                x = x * 8 + code(v[i]) - 48
                i += 1
                got += 1
            bytes.add(x % 256)
        else if e == "x"
            x = 0
            got = 0
            repeat while i <= last and ll_hexval(v[i]) >= 0
                x = (x * 16 + ll_hexval(v[i])) % 256
                i += 1
                got += 1
            if got == 0
                ok = false
                return
            bytes.add(x)
        else
            ok = false
            return

func ll_hexval(ch: text)
    k = code(ch)
    if k >= 48 and k <= 57
        return k - 48
    if k >= 97 and k <= 102
        return k - 87
    if k >= 65 and k <= 70
        return k - 55
    return -1

func ll_str_ok(v: text)
    bytes, ok = ll_str_bytes(v)
    // \0 внутри текста: C обрежет его на нуле, длина по sizeof будет другой — оставим C
    each b in bytes
        if b == 0
            return false
    return ok

// ---------- какие функции можно писать прямо в LLVM ----------

func ll_expr_ok(c: Comp, n: Node, names: list text)
    k = n.kind
    if k == "number" or k == "enumval" or k == "bool"
        return true
    if k == "decimal"
        return ll_dec_ok(n.value)
    if k == "string"
        return ll_str_ok(n.value)
    if k == "name"
        if n.is_link
            return ll_link_ok(c, n.ty)
        if ll_row(c, n.ty)
            return ll_row_ok(c, n, names)
        return (ll_val(c, n.ty) or ll_box(c, n.ty)) and ll_global_ok(c, n.name, n.ty)
    if k == "list" or k == "dict"
        return ll_box_ok(c, n, names)
    if k == "call" and n.has_ref and n.ref.kind == "obj"
        if ll_row(c, n.ty)
            return ll_row_ok(c, n, names)
        return ll_new_ok(c, n, names)
    if k == "method" and kind_of(c, n.kids[0].ty) == "channel"
        b = n.kids[0]
        if not (ll_chan(c, b.ty) and ll_expr_ok(c, b, names))
            return false
        if n.name == "send"
            return len(n.kids) == 2 and ll_value_ok(c, c.types[b.ty].elem, n.kids[1].kids[0], names)
        return n.name == "receive" or n.name == "close"
    if k == "method"
        b = n.kids[0]
        if ll_dict(c, b.ty)
            // d.has(k), d.remove(k), d.keys(), d.values()
            if not ll_box_ok(c, b, names)
                return false
            if n.name == "has" or n.name == "remove"
                return len(n.kids) == 2 and ll_expr_ok(c, n.kids[1].kids[0], names)
            if n.name == "keys" or n.name == "values"
                return ll_numlist(c, n.ty) or ll_colist(c, n.ty) or ll_bits(c, n.ty)
            return false
        // xs.pop(): последний элемент списка
        return n.name == "pop" and ll_list_name_ok(c, b, names)
    if k == "unary"
        return ll_simple(c, n.ty) and ll_expr_ok(c, n.kids[0], names)
    if k == "try"
        return ll_expr_ok(c, n.kids[0], names)
    if k == "else_err"
        return ll_expr_ok(c, n.kids[0], names) and ll_block_ok(c, n.kids[1], names)
    if k == "binop"
        op = n.value
        if op == "orelse"
            // f() or запасное
            return (ll_val(c, n.ty) or ll_box(c, n.ty)) and ll_expr_ok(c, n.kids[0], names) and ll_value_ok(c, n.ty, n.kids[1], names)
        if ll_is_text(c, n.ty)
            // a + b + 5: склеивание текста с числами и bool
            if op != "+"
                return false
            each part in ll_concat_parts(c, n)
                if not (ll_val(c, part.ty) and kind_of(c, part.ty) != "enum" and ll_expr_ok(c, part, names))
                    return false
            return true
        if ll_is_text(c, n.kids[0].ty) or ll_is_text(c, n.kids[1].ty)
            // сравнение текстов
            if not (ll_is_text(c, n.kids[0].ty) and ll_is_text(c, n.kids[1].ty))
                return false
            if not (op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=")
                return false
            return ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
        if not (ll_simple(c, n.ty) and ll_simple(c, n.kids[0].ty) and ll_simple(c, n.kids[1].ty))
            return false
        if not (op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "and" or op == "or")
            return false
        if op == "%" and kind_of(c, n.ty) == "dec"
            return false
        return ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
    if k == "index"
        if ll_colist(c, n.kids[0].ty)
            return ll_row_ok(c, n, names)
        if ll_dict(c, n.kids[0].ty)
            return ll_box_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
        if ll_is_text(c, n.kids[0].ty)
            return kind_of(c, n.kids[1].ty) == "int" and ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names)
        return ll_list_name_ok(c, n.kids[0], names) and kind_of(c, n.kids[1].ty) == "int" and ll_expr_ok(c, n.kids[1], names)
    if k == "call" and not n.has_ref and n.name == "len"
        if len(n.kids) != 1 or len(n.kids[0].kids) != 1
            return false
        a = n.kids[0].kids[0]
        if ll_is_text(c, a.ty)
            return ll_expr_ok(c, a, names)
        if ll_dict(c, a.ty) or ll_colist(c, a.ty)
            return ll_box_ok(c, a, names)
        return ll_list_name_ok(c, a, names)
    if k == "call" and not n.has_ref and (n.name == "print" or n.name == "show")
        each a in n.kids
            if a.kind == "missing" or len(a.kids) == 0
                return false
            v = a.kids[0]
            if ll_row(c, v.ty)
                if not ll_row_ok(c, v, names)
                    return false
            else if ll_box(c, v.ty)
                if not ll_box_ok(c, v, names)
                    return false
            else if not (ll_val(c, v.ty) and ll_expr_ok(c, v, names))
                return false
        return true
    if k == "field" and kind_of(c, n.kids[0].ty) == "task"
        // t.wait: ждать фоновую задачу (через обёртку tb_llb_N из C)
        return (ll_none(c, n.ty) or ll_val(c, n.ty) or ll_box(c, n.ty)) and ll_expr_ok(c, n.kids[0], names)
    if k == "background"
        // background f(...): поток запускает обёртка из C (tb_bgN), аргументы — как у вызова
        call = n.kids[0]
        if not call.has_ref or call.ref.kind != "func"
            return false
        params = call.ref.kids[0]
        count i from 0 to len(call.kids) - 1
            a = call.kids[i]
            if a.kind == "missing" or len(a.kids) == 0
                return false
            if not ll_value_ok(c, params.kids[i].ty, a.kids[0], names)
                return false
        return true
    if k == "field"
        return ll_field_ok(c, n, names)
    if k == "call" and not n.has_ref
        // остальные встроенные (to_int, split, cut, abs ...): через обёртку tb_llb_N из C
        if n.name == "asm"
            // asm("..."): прямо в LLVM, как __asm__ volatile(... ::: "memory") в C
            return len(n.kids) == 1 and n.kids[0].kids[0].kind == "string" and ll_str_ok(n.kids[0].kids[0].value)
        if ll_has(["len", "print", "show"], n.name)
            return false
        if not (kind_of(c, n.ty) == "none" or ll_val(c, n.ty) or ll_box(c, n.ty))
            return false
        each a in n.kids
            if a.kind == "missing" or len(a.kids) == 0
                return false
            v = a.kids[0]
            if not (ll_val(c, v.ty) or ll_box(c, v.ty))
                return false
            if not ll_value_ok(c, v.ty, v, names)
                return false
        return true
    if k == "call"
        // звать можно любую функцию Tachbit с таким же простым видом: свою из LLVM или из C
        if not n.has_ref or n.ref.kind != "func" or not ll_head_ok(c, n.ref)
            return false
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            a = n.kids[i]
            if a.kind == "missing" or len(a.kids) == 0
                return false
            if i < len(params.kids) and params.kids[i].is_link
                // f(x) с link: отдаём адрес x — имя, качество obj или xs[i]
                v = a.kids[0]
                if v.ty != params.kids[i].ty or not ll_addr_ok(c, v, names)
                    return false
            else if ll_box(c, a.kids[0].ty)
                if not ll_box_ok(c, a.kids[0], names)
                    return false
            else if not ll_expr_ok(c, a.kids[0], names)
                return false
        return true
    return false

// у чего можно взять адрес для link: имя, качество obj или xs[i]
func ll_addr_ok(c: Comp, v: Node, names: list text)
    if v.kind == "name"
        return ll_expr_ok(c, v, names) and ll_global_ok(c, v.name, v.ty)
    if v.kind == "field"
        return ll_field_ok(c, v, names)
    if v.kind == "index"
        return ll_list_name_ok(c, v.kids[0], names) and ll_expr_ok(c, v, names)
    return false

func ll_addr(g: LLGen, c: Comp, v: Node)
    if v.kind == "name"
        return ll_slot(g, c, v.name, v.ty)
    if v.kind == "field"
        return ll_field_ptr(g, c, v)
    return ll_elem_ptr(g, c, v)

// аргумент при вызове: тип, пометка, значение; строка by columns — двумя частями
func ll_arg(g: LLGen, c: Comp, p: Node, v: text)
    if not p.is_link and ll_row(c, p.ty)
        return "ptr " + ll_rpart(g, v, 0) + ", i64 " + ll_rpart(g, v, 1)
    return ll_pty(c, p) + " " + ll_pext(c, p) + v

// тип параметра при вызове: у link — адрес
func ll_pty(c: Comp, p: Node)
    if p.is_link
        return "ptr"
    if ll_row(c, p.ty)
        return "ptr, i64"
    return ll_ty(c, p.ty)

func ll_pext(c: Comp, p: Node)
    if p.is_link
        return ""
    return ll_ext(c, p.ty)

// все части цепочки a + b + (c + d) у текста: по порядку слева направо
func ll_concat_parts(c: Comp, n: Node) gives parts: list Node
    ll_concat_walk(c, n, parts)

func ll_concat_walk(c: Comp, n: Node, parts: list Node)
    if n.kind != "binop" or n.value != "+" or not ll_is_text(c, n.ty)
        parts.add(n)
        return
    ll_concat_walk(c, n.kids[0], parts)
    ll_concat_walk(c, n.kids[1], parts)

// p.x: p — obj (имя, users[i], a.b, f()), x — число, текст или коробка
func ll_field_ok(c: Comp, n: Node, names: list text)
    if n.kind == "field" and len(n.kids) == 1 and ll_row(c, n.kids[0].ty)
        return ll_val(c, n.ty) and ll_row_ok(c, n.kids[0], names)
    if n.kind != "field" or len(n.kids) != 1 or not ll_plainobj(c, n.kids[0].ty) or not (ll_val(c, n.ty) or ll_box(c, n.ty))
        return false
    b = n.kids[0]
    if b.kind == "name"
        return not b.is_link and not ll_is_global(c, b.name)
    // users[2].name, a.b.c, f().x
    return b.kind != "list" and ll_box_ok(c, b, names)

func ll_block_ok(c: Comp, b: Node, names: list text)
    if len(b.kids) == 0
        return true
    each s in b.kids
        if not ll_stmt_ok(c, s, names)
            return false
    return true

func ll_stmt_ok(c: Comp, n: Node, names: list text)
    k = n.kind
    if k == "assign"
        if n.is_link and not ll_link_ok(c, n.ty)
            return false
        if not ll_global_ok(c, n.name, n.ty)
            return false
        if ll_row(c, n.ty)
            // p = Point(...), q = pts[1], e = Point()
            return n.is_link == false and (len(n.kids) == 0 or ll_row_ok(c, n.kids[0], names))
        if ll_box(c, n.ty)
            // xs = list int (пустой), xs = [1, 2], b = Ball(...), ys = xs
            if len(n.kids) == 0
                return ll_numlist(c, n.ty) or ll_bits(c, n.ty) or ll_colist(c, n.ty) or ll_dict(c, n.ty)
            return ll_box_ok(c, n.kids[0], names)
        if len(n.kids) == 0
            // s = text, n = int: значение по умолчанию
            return ll_val(c, n.ty)
        return len(n.kids) == 1 and ll_val(c, n.ty) and ll_expr_ok(c, n.kids[0], names)
    if k == "set"
        t = n.kids[0]
        op = n.value
        if t.kind == "index" and ll_dict(c, t.kids[0].ty)
            // d[k] = v, d[k] += v
            if not (ll_box_ok(c, t.kids[0], names) and ll_expr_ok(c, t.kids[1], names))
                return false
            if op == "="
                return ll_value_ok(c, n.ty, n.kids[1], names)
            if ll_is_text(c, n.ty)
                return op == "+=" and ll_val(c, n.kids[1].ty) and kind_of(c, n.kids[1].ty) != "enum" and ll_expr_ok(c, n.kids[1], names)
            if not (ll_simple(c, n.ty) and ll_simple(c, n.kids[1].ty))
                return false
            if not (op == "+=" or op == "-=" or op == "*=" or op == "/=")
                return false
            return ll_expr_ok(c, n.kids[1], names)
        if ll_row(c, n.ty) and t.kind == "index"
            // pts[i] = Point(...): строку целиком
            return op == "=" and ll_row_ok(c, t, names) and ll_row_ok(c, n.kids[1], names)
        if (ll_box(c, n.ty) or ll_is_text(c, n.ty)) and t.kind == "index"
            // names[i] = "x", pts[i] = p: только  =
            return op == "=" and ll_expr_ok(c, t, names) and ll_elem_ok(c, t.kids[0].ty, n.kids[1], names)
        if ll_box(c, n.ty)
            // p.tags = xs: только  =
            if op != "="
                return false
            if t.kind == "field"
                if not ll_field_ok(c, t, names)
                    return false
            else if t.kind != "name" or t.is_link or ll_is_global(c, t.name)
                return false
            return ll_box_ok(c, n.kids[1], names)
        if not ll_val(c, n.ty)
            return false
        if ll_is_text(c, n.ty)
            // текст: только  s = x  и  s += x  (имя или качество obj)
            if not (op == "=" or op == "+=")
                return false
            if t.kind == "field"
                if not ll_field_ok(c, t, names)
                    return false
            else if t.kind != "name" or (t.is_link and not ll_link_ok(c, t.ty)) or ll_is_global(c, t.name)
                return false
            if op == "+=" and not (ll_val(c, n.kids[1].ty) and kind_of(c, n.kids[1].ty) != "enum")
                return false
            return ll_expr_ok(c, n.kids[1], names)
        if t.kind == "index"
            if not ll_expr_ok(c, t, names)
                return false
        else if t.kind == "field"
            if not ll_field_ok(c, t, names)
                return false
        else if t.kind != "name" or (t.is_link and not ll_link_ok(c, t.ty)) or not ll_global_ok(c, t.name, t.ty)
            return false
        if not (op == "=" or op == "+=" or op == "-=" or op == "*=" or op == "/=")
            return false
        return ll_expr_ok(c, n.kids[1], names)
    if k == "if"
        each x in n.kids
            if x.kind == "block"
                if not ll_block_ok(c, x, names)
                    return false
            else if not ll_expr_ok(c, x, names)
                return false
        return true
    if (k == "count" or k == "each") and n.is_par
        return ll_par_ok(c, n, names)
    if k == "count"
        return not n.is_par and ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names) and ll_block_ok(c, n.kids[2], names)
    if k == "repeat_times" or k == "repeat_while"
        return ll_expr_ok(c, n.kids[0], names) and ll_block_ok(c, n.kids[1], names)
    if k == "each" and n.by_piece and not n.is_par and not n.by_vec
        // each piece in data by N: кусок — вид на часть списка (свой tb_list на стеке)
        return ll_numlist(c, n.kids[0].ty) and ll_box_ok(c, n.kids[0], names) and kind_of(c, n.piece_size.ty) == "int" and ll_expr_ok(c, n.piece_size, names) and ll_block_ok(c, n.kids[1], names)
    if k == "each" and n.by_vec and not n.is_par
        // by vec: 8 копилок вместо одной (как в C), список int или dec
        lt = n.kids[0].ty
        if not (ll_numlist(c, lt) and (c.types[lt].elem == 1 or c.types[lt].elem == 2) and ll_box_ok(c, n.kids[0], names))
            return false
        each v in n.caps
            if v.is_shared
                if not (ll_simple(c, v.type) and kind_of(c, v.type) != "bool") or ll_is_global(c, v.name)
                    return false
        if ll_has_kind(n.kids[1], ["return", "try", "fail"])
            return false
        return ll_block_ok(c, n.kids[1], names)
    if k == "each"
        if n.by_vec or n.is_par or n.by_piece or not ll_block_ok(c, n.kids[1], names)
            return false
        lt = n.kids[0].ty
        if ll_is_text(c, lt) or ll_chan(c, lt)
            return ll_expr_ok(c, n.kids[0], names)
        return (ll_numlist(c, lt) or ll_bits(c, lt) or ll_colist(c, lt) or ll_dict(c, lt)) and ll_box_ok(c, n.kids[0], names)
    if k == "skip" or k == "stop" or k == "unlock"
        return true
    if k == "danger" or k == "lock" or k == "together"
        return ll_block_ok(c, n.kids[0], names)
    if k == "temp"
        return ll_block_ok(c, n.kids[0], names)
    if k == "linkdecl"
        // c: link first.notes — ярлык на число или текст
        return ll_link_ok(c, n.ty) and n.kids[0].ty == n.ty and ll_addr_ok(c, n.kids[0], names) and not ll_is_global(c, n.name)
    if k == "fail"
        return ll_is_text(c, n.kids[0].ty) and ll_expr_ok(c, n.kids[0], names)
    if k == "multi"
        // a, b = f(): выходы сразу в переменные
        call = n.kids[len(n.kids) - 1]
        if not ll_expr_ok(c, call, names)
            return false
        if call.kind == "try" or call.kind == "else_err"
            call = call.kids[0]
        if call.kind != "call" or not call.has_ref or call.ref.kind != "func"
            return false
        count i from 0 to len(n.kids) - 2
            t = n.kids[i]
            if t.is_link or ll_is_global(c, t.name) or t.ty != call.ref.kids[2].kids[i].ty
                return false
        return true
    if k == "match"
        subj = n.kids[0]
        if not ((ll_simple(c, subj.ty) and kind_of(c, subj.ty) != "dec") or ll_is_text(c, subj.ty))
            return false
        if not ll_expr_ok(c, subj, names)
            return false
        count i from 1 to len(n.kids) - 1
            cs = n.kids[i]
            each v in cs.kids[0].kids
                if not ll_expr_ok(c, v, names)
                    return false
            if not ll_block_ok(c, cs.kids[1], names)
                return false
        return true
    if k == "return"
        return len(n.kids) == 0 or ll_expr_ok(c, n.kids[0], names)
    if k == "expr_stmt"
        e = n.kids[0]
        if e.kind == "method" and kind_of(c, e.kids[0].ty) == "channel"
            return ll_expr_ok(c, e, names)
        if e.kind == "method" and ll_dict(c, e.kids[0].ty)
            if e.name == "clear"
                return ll_box_ok(c, e.kids[0], names)
            return ll_expr_ok(c, e, names)
        if e.kind == "method" and ll_colist(c, e.kids[0].ty)
            return e.name == "add" and len(e.kids) == 2 and ll_box_ok(c, e.kids[0], names) and ll_row_ok(c, e.kids[1].kids[0], names)
        if e.kind == "method" and ll_list_name_ok(c, e.kids[0], names)
            if e.name == "add"
                return len(e.kids) == 2 and ll_elem_ok(c, e.kids[0].ty, e.kids[1].kids[0], names)
            return e.name == "pop" or e.name == "clear"
        return (e.kind == "call" or e.kind == "try" or e.kind == "else_err" or e.kind == "background" or (e.kind == "field" and kind_of(c, e.kids[0].ty) == "task")) and ll_expr_ok(c, e, names)
    return false

// each / count ... on all cores: тело — отдельная функция-работник в .ll (как tb_workN в C)
func ll_par_ok(c: Comp, n: Node, names: list text)
    if n.by_vec or n.by_piece
        return false
    body = n.kids[1]
    if n.kind == "count"
        if not (ll_expr_ok(c, n.kids[0], names) and ll_expr_ok(c, n.kids[1], names))
            return false
        body = n.kids[2]
    else
        lt = n.kids[0].ty
        if not ((ll_numlist(c, lt) or ll_colist(c, lt) or ll_bits(c, lt)) and ll_box_ok(c, n.kids[0], names))
            return false
    each v in n.caps
        if ll_is_global(c, v.name)
            return false
        if v.is_shared
            // shared: у каждого ядра своё число, в конце складываются (текст — пока через C)
            k = kind_of(c, v.type)
            if not (k == "int" or k == "dec" or k == "text")
                return false
        else if v.is_link
            if not ll_link_ok(c, v.type)
                return false
        else if not (ll_val(c, v.type) or ll_box(c, v.type) or ll_row(c, v.type))
            return false
    // try / fail / return внутри работника вышли бы из него, а не из функции — пока через C
    if ll_has_kind(body, ["try", "fail", "return"])
        return false
    return ll_block_ok(c, body, names)

func ll_has_kind(n: Node, kinds: list text)
    if ll_has(kinds, n.kind)
        return true
    each k in n.kids
        if ll_has_kind(k, kinds)
            return true
    return false

func ll_head_ok(c: Comp, f: Node)
    if f.irq != 0
        return false
    outs = f.kids[2].kids
    each o in outs
        // выходы gives: числа, тексты, коробки
        if not (ll_val(c, o.ty) or ll_box(c, o.ty) or ll_row(c, o.ty))
            return false
    if len(outs) <= 1 and not (ll_none(c, f.ty) or ll_val(c, f.ty) or ll_box(c, f.ty) or ll_row(c, f.ty))
        return false
    // строка by columns идёт в двух регистрах; если регистров не хватит, C кладёт её в стек
    // целиком — так что строки разрешаем, только пока всё влезает в 6 регистров
    regs = 0
    rows = false
    each p in f.kids[0].kids
        if p.is_link or kind_of(c, p.ty) != "dec"
            regs += 1
        if not p.is_link and ll_row(c, p.ty)
            regs += 1
            rows = true
    if len(outs) > 1
        regs += len(outs)
    if rows and regs > 6
        return false
    each p in f.kids[0].kids
        if p.is_link
            if not ll_link_ok(c, p.ty)
                return false
            each o in outs
                if o.name == p.name
                    return false
        else if not (ll_val(c, p.ty) or ll_box(c, p.ty) or ll_row(c, p.ty))
            return false
    return true

// первая строка, из-за которой функция осталась в C (заходит внутрь блоков)
func ll_why(c: Comp, b: Node, names: list text) gives line: int
    each s in b.kids
        if not ll_stmt_ok(c, s, names)
            each x in s.kids
                if x.kind == "block" and not ll_block_ok(c, x, names)
                    return ll_why(c, x, names)
                if x.kind == "case"
                    each y in x.kids
                        if y.kind == "block" and not ll_block_ok(c, y, names)
                            return ll_why(c, y, names)
            return s.line
    return 0

// c.ll_names: функции, которые пойдут в LLVM. Сначала все подходящие по виду,
// потом выкидываем тех, кто зовёт выкинутых, пока список не перестанет меняться.
modpub func ll_pick(c: Comp, program: Node)
    names = list text
    if c.bare
        c.ll_names = names
        return
    each top in program.kids
        if top.kind == "func" and ll_head_ok(c, top)
            names.add(ll_fname(top))
    changed = true
    repeat while changed
        changed = false
        keep = list text
        each top in program.kids
            if top.kind == "func" and ll_has(names, ll_fname(top))
                if ll_block_ok(c, top.kids[1], names)
                    keep.add(ll_fname(top))
                else
                    changed = true
        names = keep
    c.ll_names = names
    // замки из функций в LLVM: переменные tb_lk_имя пишет C (в конце файла)
    each top in program.kids
        if top.kind == "func" and ll_has(names, ll_fname(top))
            ll_lock_names(top.kids[1], c.locks)
    // функции из C, которые зовут из LLVM: в C они без static
    ext = list text
    each top in program.kids
        if top.kind == "func" and ll_has(names, ll_fname(top))
            ll_calls(top.kids[1], names, ext)
    c.ll_ext = ext
    bis = list Node
    each top in program.kids
        if top.kind == "func" and ll_has(names, ll_fname(top))
            ll_builtins(c, top.kids[1], bis)
    c.ll_bi = bis

func ll_lock_names(n: Node, locks: list text)
    if n.kind == "lock" and not ll_has(locks, n.name)
        locks.add(n.name)
    each k in n.kids
        ll_lock_names(k, locks)

// встроенные функции внутри функций для LLVM: каждой — свой номер обёртки
func ll_builtins(c: Comp, n: Node, bis: list Node)
    if (n.kind == "call" and not n.has_ref and not ll_has(["asm", "len", "print", "show"], n.name)) or n.kind == "background" or (n.kind == "field" and kind_of(c, n.kids[0].ty) == "task")
        n.temp_no = len(bis)
        bis.add(n)
    each kid in n.kids
        ll_builtins(c, kid, bis)

func ll_calls(n: Node, names: list text, ext: list text)
    if n.kind == "call" and n.has_ref and n.ref.kind == "func"
        nm = ll_fname(n.ref)
        if not ll_has(names, nm) and not ll_has(ext, nm)
            ext.add(nm)
    each kid in n.kids
        ll_calls(kid, names, ext)

// ---------- вывод ----------

func ll_put(g: LLGen, s: text)
    if not g.open
        // код после return / stop: свой блок, до него никто не дойдёт
        g.tmp += 1
        g.out.add("d" + g.tmp + ":\n")
        g.open = true
    g.out.add("  " + s + "\n")

// конец блока: br / ret / unreachable
func ll_term(g: LLGen, s: text)
    ll_put(g, s)
    g.open = false

func ll_label(g: LLGen, name: text)
    if g.open
        g.out.add("  br label %" + name + "\n")
    g.out.add(name + ":\n")
    g.open = true

func ll_new(g: LLGen, prefix: text)
    g.tmp += 1
    return prefix + g.tmp

// место переменной в памяти функции (LLVM сам превратит его в регистр)
func ll_slot(g: LLGen, c: Comp, name: text, t: int)
    if ll_has(g.links, name)
        // link-параметр: его «место» — адрес переменной того, кто позвал
        return "%\"p." + name + "\""
    count vi from 0 to len(g.vec_names) - 1
        if g.vec_names[vi] == name
            // by vec: вместо общей переменной — своя копилка этой копии тела
            return g.vec_slots[vi]
    if ll_has(g.ldecls, name)
        // ярлык внутри функции: адрес лежит в своей ячейке
        r = ll_new(g, "%t")
        ll_put(g, r + " = load ptr, ptr %\"l." + name + "\"")
        return r
    if ll_is_global(c, name)
        gs = "@\"v_" + name + "\""
        ll_need(g, gs + " = external hidden global " + ll_mem_ty(c, t) + "\n")
        return gs
    s = "%\"v." + name + "." + ll_ty(c, t) + "\""
    if not ll_has(g.slots, s)
        g.slots.add(s)
        g.allocas.add("  " + s + " = alloca " + ll_ty(c, t) + "\n")
    return s

func ll_crash(g: LLGen, line: int, what: int)
    ll_put(g, "call void @tb_ll_crash(i32 " + line + ", i32 " + what + ")")
    ll_term(g, "unreachable")

// значение n как тип want (int → dec, если надо)
func ll_as(g: LLGen, c: Comp, n: Node, want: int)
    v = ll_expr(g, c, n)
    if kind_of(c, want) == "dec" and kind_of(c, n.ty) != "dec"
        r = ll_new(g, "%t")
        ll_put(g, r + " = sitofp i64 " + v + " to double")
        return r
    return v

func ll_to_dec(g: LLGen, c: Comp, v: text, t: int)
    if kind_of(c, t) == "dec"
        return v
    r = ll_new(g, "%t")
    ll_put(g, r + " = sitofp i64 " + v + " to double")
    return r

func ll_call(g: LLGen, c: Comp, n: Node)
    f = n.ref
    if len(f.kids[2].kids) > 1
        // f() с несколькими выходами отдельной строкой: выходы — во временные места
        outs = list text
        each o in f.kids[2].kids
            tmp = "%\"mo" + ll_new(g, "") + "\""
            g.allocas.add("  " + tmp + " = alloca " + ll_ty(c, o.ty) + "\n")
            outs.add(tmp)
        ll_call_multi(g, c, n, outs)
        g.mtemps = outs
        return "0"
    params = f.kids[0]
    args = ""
    count i from 0 to len(n.kids) - 1
        p = params.kids[i]
        arg = n.kids[i].kids[0]
        v = ""
        if p.is_link
            v = ll_addr(g, c, arg)
        else
            v = ll_expr(g, c, arg)
            if kind_of(c, p.ty) == "dec"
                v = ll_to_dec(g, c, v, arg.ty)
        if i > 0
            args = args + ", "
        args = args + ll_arg(g, c, p, v)
    callee = ll_ext(c, f.ty) + ll_ty(c, f.ty) + " @\"" + ll_fname(f) + "\"(" + args + ")"
    if ll_none(c, f.ty)
        ll_put(g, "call " + callee)
        return "0"
    r = ll_new(g, "%t")
    ll_put(g, r + " = call " + callee)
    return r

// and / or: правую часть считаем, только если она нужна
func ll_logic(g: LLGen, c: Comp, n: Node)
    a = ll_expr(g, c, n.kids[0])
    left = ll_new(g, "L")
    ll_label(g, left)
    right = ll_new(g, "L")
    done = ll_new(g, "L")
    if n.value == "and"
        ll_term(g, "br i1 " + a + ", label %" + right + ", label %" + done)
    else
        ll_term(g, "br i1 " + a + ", label %" + done + ", label %" + right)
    ll_label(g, right)
    b = ll_expr(g, c, n.kids[1])
    right_end = ll_new(g, "L")
    ll_label(g, right_end)
    ll_term(g, "br label %" + done)
    ll_label(g, done)
    r = ll_new(g, "%t")
    short = "false"
    if n.value == "or"
        short = "true"
    ll_put(g, r + " = phi i1 [ " + short + ", %" + left + " ], [ " + b + ", %" + right_end + " ]")
    return r

func ll_binop(g: LLGen, c: Comp, n: Node)
    op = n.value
    if op == "and" or op == "or"
        return ll_logic(g, c, n)
    a = ll_expr(g, c, n.kids[0])
    b = ll_expr(g, c, n.kids[1])
    return ll_arith(g, c, op, a, n.kids[0].ty, b, n.kids[1].ty, n.ty, n.line)

// a op b, когда оба значения уже посчитаны (для x += y и xs[i] += y тоже)
func ll_arith(g: LLGen, c: Comp, op: text, a0: text, ta: int, b0: text, tb: int, rt: int, line: int)
    a = a0
    b = b0
    r = ll_new(g, "%t")
    cmp = op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
    if cmp
        if kind_of(c, ta) == "dec" or kind_of(c, tb) == "dec"
            a = ll_to_dec(g, c, a, ta)
            b = ll_to_dec(g, c, b, tb)
            fc = "oeq"
            if op == "!="
                fc = "une"
            else if op == "<"
                fc = "olt"
            else if op == ">"
                fc = "ogt"
            else if op == "<="
                fc = "ole"
            else if op == ">="
                fc = "oge"
            ll_put(g, r + " = fcmp " + fc + " double " + a + ", " + b)
            return r
        ic = "eq"
        if op == "!="
            ic = "ne"
        else if op == "<"
            ic = "slt"
        else if op == ">"
            ic = "sgt"
        else if op == "<="
            ic = "sle"
        else if op == ">="
            ic = "sge"
        ll_put(g, r + " = icmp " + ic + " " + ll_ty(c, ta) + " " + a + ", " + b)
        return r
    if kind_of(c, rt) == "dec"
        a = ll_to_dec(g, c, a, ta)
        b = ll_to_dec(g, c, b, tb)
        fo = "fadd"
        if op == "-"
            fo = "fsub"
        else if op == "*"
            fo = "fmul"
        else if op == "/"
            fo = "fdiv"
        ll_put(g, r + " = " + fo + " double " + a + ", " + b)
        return r
    if op == "/" or op == "%"
        // деление на ноль: как в C — остановка с номером строки
        z = ll_new(g, "%t")
        bad = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_put(g, z + " = icmp eq i64 " + b + ", 0")
        ll_term(g, "br i1 " + z + ", label %" + bad + ", label %" + ok + ", !prof !0")
        ll_label(g, bad)
        what = 0
        if op == "%"
            what = 1
        ll_crash(g, line, what)
        ll_label(g, ok)
        io = "sdiv"
        if op == "%"
            io = "srem"
        ll_put(g, r + " = " + io + " i64 " + a + ", " + b)
        return r
    io = "add nsw"
    if op == "-"
        io = "sub nsw"
    else if op == "*"
        io = "mul nsw"
    ll_put(g, r + " = " + io + " i64 " + a + ", " + b)
    return r

func ll_expr(g: LLGen, c: Comp, n: Node)
    k = n.kind
    if k == "number" or k == "enumval"
        return n.value
    if k == "decimal"
        return ll_decimal(g, n.value)
    if k == "bool"
        return n.value
    if k == "string"
        name, sn = ll_strconst(g, n.value)
        return name
    if k == "name"
        if ll_is_bld(g, c, n)
            // текст могут где-то сохранить: следующее дописывание сначала сделает копию
            ll_put(g, "store i64 -1, ptr " + ll_rl(g, n.name))
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_ty(c, n.ty) + ", ptr " + ll_slot(g, c, n.name, n.ty))
        return r
    if k == "unary"
        v = ll_expr(g, c, n.kids[0])
        r = ll_new(g, "%t")
        if n.value == "not"
            ll_put(g, r + " = xor i1 " + v + ", true")
        else if kind_of(c, n.ty) == "dec"
            ll_put(g, r + " = fneg double " + v)
        else
            ll_put(g, r + " = sub nsw i64 0, " + v)
        return r
    if k == "try"
        // try f(): сломалась — сразу выходим, ошибка остаётся в tb_err для того, кто нас звал
        v = ll_expr(g, c, n.kids[0])
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp ne ptr " + e + ", null")
        no = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
        ll_label(g, no)
        ll_bail(g, c)
        ll_label(g, ok)
        return v
    if k == "else_err"
        // v = f() else err: сломалась — блок с текстом ошибки в err, tb_err снова пустой
        v = ll_expr(g, c, n.kids[0])
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp ne ptr " + e + ", null")
        no = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
        ll_label(g, no)
        ll_put(g, "store ptr " + e + ", ptr " + ll_slot(g, c, n.name, 4))
        ll_put(g, "store ptr null, ptr " + ll_errp(g))
        ll_block(g, c, n.kids[1])
        ll_label(g, ok)
        return v
    if k == "binop" and n.value == "orelse"
        // f() or запасное: сломалась — tb_err снова пустой, берём запасное
        a = ll_as(g, c, n.kids[0], n.ty)
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp ne ptr " + e + ", null")
        here = ll_new(g, "L")
        ll_label(g, here)
        no = ll_new(g, "L")
        done = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + done)
        ll_label(g, no)
        ll_put(g, "store ptr null, ptr " + ll_errp(g))
        b = ll_as(g, c, n.kids[1], n.ty)
        no_end = ll_new(g, "L")
        ll_label(g, no_end)
        ll_term(g, "br label %" + done)
        ll_label(g, done)
        r = ll_new(g, "%t")
        ll_put(g, r + " = phi " + ll_ty(c, n.ty) + " [ " + a + ", %" + here + " ], [ " + b + ", %" + no_end + " ]")
        return r
    if k == "list"
        return ll_list_lit(g, c, n)
    if k == "dict"
        return ll_dict_lit(g, c, n)
    if k == "method" and kind_of(c, n.kids[0].ty) == "channel"
        ch = ll_expr(g, c, n.kids[0])
        et = c.types[n.kids[0].ty].elem
        if n.name == "close"
            ll_put(g, "call void @tb_x_chan_close(ptr " + ch + ")")
            return "0"
        cell = "%\"cv" + ll_new(g, "") + "\""
        g.allocas.add("  " + cell + " = alloca " + ll_mem_ty(c, et) + "\n")
        if n.name == "send"
            sv = ll_as(g, c, n.kids[1].kids[0], et)
            ll_store_val(g, c, et, sv, cell)
            ll_put(g, "call void @tb_x_chan_send(ptr " + ch + ", ptr " + cell + ", i32 " + n.line + ")")
            return "0"
        // receive(): закрыт и пуст — падаем, как TB_CH_RECV в C
        got = ll_new(g, "%t")
        ll_put(g, got + " = call i32 @tb_x_chan_take(ptr " + ch + ", ptr " + cell + ")")
        bad = ll_new(g, "%t")
        ll_put(g, bad + " = icmp eq i32 " + got + ", 0")
        no = ll_new(g, "L")
        ok = ll_new(g, "L")
        ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
        ll_label(g, no)
        ll_crash(g, n.line, 6)
        ll_label(g, ok)
        return ll_load_val(g, c, et, cell)
    if k == "method" and ll_dict(c, n.kids[0].ty)
        base = ll_expr(g, c, n.kids[0])
        if n.name == "has"
            kp = ll_key_ptr(g, c, n.kids[0].ty, n.kids[1].kids[0])
            h = ll_new(g, "%t")
            ll_put(g, h + " = call i32 @tb_x_dhas(ptr " + base + ", ptr " + kp + ")")
            r = ll_new(g, "%t")
            ll_put(g, r + " = icmp ne i32 " + h + ", 0")
            return r
        if n.name == "remove"
            kp = ll_key_ptr(g, c, n.kids[0].ty, n.kids[1].kids[0])
            ll_put(g, "call void @tb_x_dremove(ptr " + base + ", ptr " + kp + ")")
            return "0"
        if n.name == "clear"
            ll_put(g, "call void @tb_x_dclear(ptr " + base + ", i32 " + n.line + ")")
            return "0"
        r = ll_new(g, "%t")
        fn = "tb_x_dkeys_copy"
        if n.name == "values"
            fn = "tb_x_dvals_copy"
        ll_put(g, r + " = call ptr @" + fn + "(ptr " + base + ")")
        if ll_bits(c, n.ty)
            // значения bool лежат байтами — в list bool их надо переложить в биты
            rb = ll_new(g, "%t")
            ll_put(g, rb + " = call ptr @tb_x_bits_of_bytes(ptr " + r + ")")
            return rb
        if ll_colist(c, n.ty)
            // значения-строки лежат подряд по 16 байт: из них — список колонок
            cn = ll_cneed(g, c, n.ty)
            vd = ll_new(g, "%t")
            ll_put(g, vd + " = load ptr, ptr " + r)
            vl = ll_len(g, r)
            r2 = ll_new(g, "%t")
            ll_put(g, r2 + " = call ptr @tb_lc_from_" + cn + "(i64 " + vl + ", ptr " + vd + ")")
            return r2
        return r
    if k == "call" and n.has_ref and n.ref.kind == "obj"
        if ll_row(c, n.ty)
            return ll_new_row(g, c, n)
        return ll_new_obj(g, c, n)
    if k == "method" and ll_bits(c, n.kids[0].ty)
        bl = ll_expr(g, c, n.kids[0])
        r = ll_new(g, "%t")
        ll_put(g, r + " = call zeroext i1 @tb_x_bpop(ptr " + bl + ", i32 " + n.line + ")")
        return r
    if k == "method"
        // xs.pop()
        base = ll_expr(g, c, n.kids[0])
        p = ll_new(g, "%t")
        ll_put(g, p + " = call ptr @tb_x_pop(ptr " + base + ", i32 " + n.line + ")")
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + p + ll_elem_tag(c, n.kids[0].ty))
        return r
    if k == "binop"
        if ll_is_text(c, n.ty)
            return ll_concat(g, c, n)
        if ll_is_text(c, n.kids[0].ty)
            return ll_tcmp(g, c, n)
        return ll_binop(g, c, n)
    if k == "background" or (k == "field" and kind_of(c, n.kids[0].ty) == "task")
        return ll_builtin(g, c, n)
    if k == "field"
        fp = ll_field_ptr(g, c, n)
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_mem_ty(c, n.ty) + ", ptr " + fp)
        if kind_of(c, n.ty) == "bool"
            r2 = ll_new(g, "%t")
            ll_put(g, r2 + " = trunc i8 " + r + " to i1")
            return r2
        return r
    if k == "index" and ll_dict(c, n.kids[0].ty)
        // d[k]: нет ключа — остановка, как в C
        dt = n.kids[0].ty
        base = ll_expr(g, c, n.kids[0])
        kp = ll_key_ptr(g, c, dt, n.kids[1])
        p = ll_new(g, "%t")
        ll_put(g, p + " = call ptr @tb_x_dget(ptr " + base + ", ptr " + kp + ", i32 " + n.line + ")")
        return ll_load_val(g, c, c.types[dt].elem, p)
    if k == "index" and ll_is_text(c, n.kids[0].ty)
        // s[i]: текст из одного байта (как tb_char_at в C)
        sv = ll_q(g, c, n.kids[0])
        iv = ll_expr(g, c, n.kids[1])
        known = "-1"
        if ll_is_bld(g, c, n.kids[0])
            known = ll_new(g, "%t")
            ll_put(g, known + " = load i64, ptr " + ll_rl(g, n.kids[0].name))
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_x_char_at(ptr " + sv + ", i64 " + iv + ", i64 " + known + ", i32 " + n.line + ")")
        return r
    if k == "index" and ll_colist(c, n.kids[0].ty)
        return ll_col_at(g, c, n)
    if k == "index" and ll_bits(c, n.kids[0].ty)
        bl = ll_expr(g, c, n.kids[0])
        bi = ll_expr(g, c, n.kids[1])
        r = ll_new(g, "%t")
        ll_put(g, r + " = call zeroext i1 @tb_x_bget(ptr " + bl + ", i64 " + bi + ", i32 " + n.line + ")")
        return r
    if k == "index"
        ep = ll_elem_ptr(g, c, n)
        r = ll_new(g, "%t")
        ll_put(g, r + " = load " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + ep + ll_elem_tag(c, n.kids[0].ty))
        return r
    if k == "call" and not n.has_ref and (n.name == "print" or n.name == "show")
        ll_print(g, c, n, n.name == "print")
        return "0"
    if k == "call" and not n.has_ref and n.name == "asm"
        ll_asm(g, n.kids[0].kids[0].value)
        return "0"
    if k == "call" and not n.has_ref and n.name != "len"
        return ll_builtin(g, c, n)
    if k == "call" and not n.has_ref
        a = n.kids[0].kids[0]
        if ll_is_text(c, a.ty)
            // len(s): у текста, в который дописывают, длина уже известна
            if ll_is_bld(g, c, a)
                rl = ll_new(g, "%t")
                ll_put(g, rl + " = load i64, ptr " + ll_rl(g, a.name))
                sv = ll_q(g, c, a)
                tl = ll_new(g, "%t")
                ll_put(g, tl + " = call i64 @tb_x_tlen(ptr " + sv + ")")
                neg = ll_new(g, "%t")
                ll_put(g, neg + " = icmp slt i64 " + rl + ", 0")
                r = ll_new(g, "%t")
                ll_put(g, r + " = select i1 " + neg + ", i64 " + tl + ", i64 " + rl)
                return r
            sv = ll_q(g, c, a)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call i64 @tb_x_tlen(ptr " + sv + ")")
            return r
        if ll_dict(c, a.ty)
            db = ll_expr(g, c, a)
            dl = ll_new(g, "%t")
            ll_put(g, dl + " = call i64 @tb_x_dlen(ptr " + db + ")")
            return dl
        // len(xs)
        base = ll_expr(g, c, a)
        if ll_colist(c, a.ty)
            return ll_clen(g, base)
        return ll_len(g, base)
    return ll_call(g, c, n)

// ---------- тексты ----------

// готовый текст из кода: константа уровня файла; вернёт её имя и длину в байтах
func ll_strconst(g: LLGen, v: text) gives name: text, n: int
    bytes, ok = ll_str_bytes(v)
    g.tmp += 1
    name = "@\"tb.s." + ll_fname(g.fn) + "." + g.tmp + "\""
    body = ""
    hex = "0123456789ABCDEF"
    each b in bytes
        if b >= 32 and b < 127 and b != 34 and b != 92
            body = body + char(b)
        else
            body = body + "\\" + hex[b / 16] + hex[b % 16]
    n = len(bytes)
    g.decls.add(name + " = private unnamed_addr constant [" + (n + 1) + " x i8] c\"" + body + "\\00\", align 1\n")

// объявить tb_show_N (печать значения типа N) один раз на весь файл
func ll_need(g: LLGen, line: text)
    if not ll_has(g.decls, line)
        g.decls.add(line)

func ll_is_bld(g: LLGen, c: Comp, n: Node)
    return n.kind == "name" and not n.is_link and ll_is_text(c, n.ty) and ll_has(g.blds, n.name)

func ll_rl(g: LLGen, name: text)
    return "%\"rl." + name + "\""

func ll_rc(g: LLGen, name: text)
    return "%\"rc." + name + "\""

// прочитать, ничего не сохраняя (print, len, s[i], сравнение, склеивание):
// у текста, в который дописывают, своя память остаётся своей
func ll_q(g: LLGen, c: Comp, n: Node)
    if ll_is_bld(g, c, n)
        r = ll_new(g, "%t")
        ll_put(g, r + " = load ptr, ptr " + ll_slot(g, c, n.name, n.ty))
        return r
    return ll_expr(g, c, n)

// значение как текст (для склеивания и s += x)
func ll_as_text(g: LLGen, c: Comp, n: Node)
    k = kind_of(c, n.ty)
    if k == "text"
        return ll_q(g, c, n)
    v = ll_expr(g, c, n)
    r = ll_new(g, "%t")
    if k == "int"
        ll_put(g, r + " = call ptr @tb_x_itos(i64 " + v + ")")
    else if k == "dec"
        ll_put(g, r + " = call ptr @tb_x_dtos(double " + v + ")")
    else
        z = ll_new(g, "%t")
        ll_put(g, z + " = zext i1 " + v + " to i32")
        ll_put(g, r + " = call ptr @tb_x_btos(i32 " + z + ")")
    return r

// a + b + c: сначала каждая часть и её длина (число — цифрами в буфер на стеке),
// потом одна память ровно под результат и все части подряд — как в C
func ll_concat(g: LLGen, c: Comp, n: Node)
    parts = ll_concat_parts(c, n)
    ptrs = list text
    lens = list text
    each part in parts
        k = kind_of(c, part.ty)
        if k == "int"
            v = ll_expr(g, c, part)
            buf = "%\"buf" + ll_new(g, "") + "\""
            g.allocas.add("  " + buf + " = alloca [24 x i8]\n")
            ns = "%\"bn" + ll_new(g, "") + "\""
            g.allocas.add("  " + ns + " = alloca i64\n")
            p = ll_new(g, "%t")
            ll_put(g, p + " = call ptr @tb_x_digits(i64 " + v + ", ptr " + buf + ", ptr " + ns + ")")
            nl = ll_new(g, "%t")
            ll_put(g, nl + " = load i64, ptr " + ns)
            ptrs.add(p)
            lens.add(nl)
        else if part.kind == "string"
            name, sn = ll_strconst(g, part.value)
            ptrs.add(name)
            lens.add("" + sn)
        else
            p = ll_as_text(g, c, part)
            nl = ll_new(g, "%t")
            ll_put(g, nl + " = call i64 @strlen(ptr " + p + ")")
            ptrs.add(p)
            lens.add(nl)
    total = "1"
    each x in lens
        t = ll_new(g, "%t")
        ll_put(g, t + " = add i64 " + total + ", " + x)
        total = t
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_mem_np(i64 " + total + ")")
    at = r
    count i from 0 to len(ptrs) - 1
        ll_put(g, "call void @llvm.memcpy.p0.p0.i64(ptr " + at + ", ptr " + ptrs[i] + ", i64 " + lens[i] + ", i1 false)")
        nx = ll_new(g, "%t")
        ll_put(g, nx + " = getelementptr inbounds i8, ptr " + at + ", i64 " + lens[i])
        at = nx
    ll_put(g, "store i8 0, ptr " + at)
    return r

// короткий готовый текст без \: сравнить байты прямо, без strcmp (ch == "," в циклах по тексту)
func ll_short_lit(n: Node)
    if n.kind != "string" or len(n.value) < 2 or len(n.value) > 10
        return false
    each ch in n.value
        if ch == "\\"
            return false
    return true

func ll_tcmp(g: LLGen, c: Comp, n: Node)
    op = n.value
    a = n.kids[0]
    b = n.kids[1]
    if (op == "==" or op == "!=") and (ll_short_lit(a) or ll_short_lit(b))
        lit = b
        other = a
        if not ll_short_lit(b)
            lit = a
            other = b
        sv = ll_q(g, c, other)
        body = cut(lit.value, 1, len(lit.value) - 2)
        done = ll_new(g, "L")
        froms = list text
        i = 0
        each ch in body
            bp = ll_new(g, "%t")
            ll_put(g, bp + " = getelementptr inbounds i8, ptr " + sv + ", i64 " + i)
            bv = ll_new(g, "%t")
            ll_put(g, bv + " = load i8, ptr " + bp)
            eq = ll_new(g, "%t")
            ll_put(g, eq + " = icmp eq i8 " + bv + ", " + ll_i8(code(ch)))
            here = ll_new(g, "L")
            ll_label(g, here)
            froms.add(here)
            nx = ll_new(g, "L")
            ll_term(g, "br i1 " + eq + ", label %" + nx + ", label %" + done)
            ll_label(g, nx)
            i += 1
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds i8, ptr " + sv + ", i64 " + i)
        ev = ll_new(g, "%t")
        ll_put(g, ev + " = load i8, ptr " + ep)
        last = ll_new(g, "%t")
        ll_put(g, last + " = icmp eq i8 " + ev + ", 0")
        lastb = ll_new(g, "L")
        ll_label(g, lastb)
        ll_term(g, "br label %" + done)
        ll_label(g, done)
        r = ll_new(g, "%t")
        phi = r + " = phi i1 [ " + last + ", %" + lastb + " ]"
        each f in froms
            phi = phi + ", [ false, %" + f + " ]"
        ll_put(g, phi)
        if op == "!="
            r2 = ll_new(g, "%t")
            ll_put(g, r2 + " = xor i1 " + r + ", true")
            return r2
        return r
    av = ll_q(g, c, a)
    bv = ll_q(g, c, b)
    cr = ll_new(g, "%t")
    ll_put(g, cr + " = call i32 @strcmp(ptr " + av + ", ptr " + bv + ")")
    ic = "eq"
    if op == "!="
        ic = "ne"
    else if op == "<"
        ic = "slt"
    else if op == ">"
        ic = "sgt"
    else if op == "<="
        ic = "sle"
    else if op == ">="
        ic = "sge"
    r = ll_new(g, "%t")
    ll_put(g, r + " = icmp " + ic + " i32 " + cr + ", 0")
    return r

// байт как число i8 со знаком (LLVM пишет i8 от -128 до 127)
func ll_i8(b: int)
    if b > 127
        return "" + (b - 256)
    return "" + b

// print a, b / show a: tb_show_N для каждого значения, между ними пробел
func ll_print(g: LLGen, c: Comp, n: Node, newline: bool)
    sp, sn = ll_strconst(g, "\" \"")
    count i from 0 to len(n.kids) - 1
        v = n.kids[i].kids[0]
        if i > 0
            ll_put(g, "call void @tb_x_ps(ptr " + sp + ")")
        x = ll_q(g, c, v)
        if ll_row(c, v.ty)
            // строку C принимает целиком (две части): отдаём адрес копии
            rs = "%\"rs" + ll_new(g, "") + "\""
            g.allocas.add("  " + rs + " = alloca { ptr, i64 }\n")
            ll_put(g, "store { ptr, i64 } " + x + ", ptr " + rs)
            ll_need(g, "declare void @tb_lc_show_" + v.ty + "(ptr)\n")
            ll_put(g, "call void @tb_lc_show_" + v.ty + "(ptr " + rs + ")")
        else
            decl = "declare void @tb_show_" + v.ty + "(" + ll_ty(c, v.ty) + " " + ll_ext(c, v.ty) + ")\n"
            ll_need(g, decl)
            ll_put(g, "call void @tb_show_" + v.ty + "(" + ll_ty(c, v.ty) + " " + ll_ext(c, v.ty) + x + ")")
    if newline
        nlp, nln = ll_strconst(g, "\"\\n\"")
        ll_put(g, "call void @tb_x_ps(ptr " + nlp + ")")

// дописать part в конец текста name (s += part)
func ll_app(g: LLGen, c: Comp, name: text, t: int, part: Node)
    vars = "ptr " + ll_slot(g, c, name, t) + ", ptr " + ll_rl(g, name) + ", ptr " + ll_rc(g, name) + ", "
    k = kind_of(c, part.ty)
    if k == "int"
        v = ll_expr(g, c, part)
        ll_put(g, "call void @tb_x_app_i(" + vars + "i64 " + v + ")")
    else if part.kind == "string"
        sp, sn = ll_strconst(g, part.value)
        ll_put(g, "call void @tb_x_app_n(" + vars + "ptr " + sp + ", i64 " + sn + ")")
    else
        v = ll_as_text(g, c, part)
        ll_put(g, "call void @tb_x_app(" + vars + "ptr " + v + ")")

// ---------- тексты, в которые дописывают на месте (как в C: find_builders) ----------

func ll_bld_uses(n: Node, name: text)
    if n.kind == "name" and n.name == name
        return true
    each k in n.kids
        if ll_bld_uses(k, name)
            return true
    return false

func ll_bld_bad_all(n: Node, bad: list text)
    if n.kind == "name" or n.kind == "assign"
        bad.add(n.name)
    each k in n.kids
        ll_bld_bad_all(k, bad)

func ll_text_plus(c: Comp, n: Node)
    return n.kind == "binop" and n.value == "+" and ll_is_text(c, n.ty)

// s = s + a + b: слева самое первое — s, и справа s больше нигде нет
func ll_app_form(c: Comp, name: text, v: Node)
    if not ll_text_plus(c, v)
        return false
    r = v
    repeat while ll_text_plus(c, r)
        if ll_bld_uses(r.kids[1], name)
            return false
        r = r.kids[0]
    return r.kind == "name" and r.name == name and not r.is_link

// части, которые дописываются по порядку: s + a + b → a, b
func ll_app_parts(c: Comp, v: Node) gives parts: list Node
    back = list Node
    r = v
    repeat while ll_text_plus(c, r)
        back.add(r.kids[1])
        r = r.kids[0]
    i = len(back) - 1
    repeat while i >= 0
        parts.add(back[i])
        i -= 1

func ll_bld_scan(c: Comp, n: Node, cand: list text, bad: list text)
    k = n.kind
    if k == "background" or k == "together" or ((k == "each" or k == "count") and (n.is_par or n.by_vec))
        // как в C: внутри потоков и копий тела текст на месте не дописываем
        ll_bld_bad_all(n, bad)
        return
    if k == "each" or k == "count"
        bad.add(n.name)
    if k == "multi"
        ll_bld_bad_all(n, bad)
    if k == "call" and n.has_ref and n.ref.kind == "func"
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link
                ll_bld_bad_all(n.kids[i], bad)
    if k == "assign"
        if n.is_link
            bad.add(n.name)
        else if ll_is_text(c, n.ty) and len(n.kids) == 1 and not n.creates and ll_app_form(c, n.name, n.kids[0])
            cand.add(n.name)
    if k == "set" and n.value == "+=" and n.kids[0].kind == "name" and ll_is_text(c, n.kids[0].ty)
        if n.kids[0].is_link
            bad.add(n.kids[0].name)
        else
            cand.add(n.kids[0].name)
    each kid in n.kids
        ll_bld_scan(c, kid, cand, bad)

func ll_find_blds(g: LLGen, c: Comp, f: Node)
    cand = list text
    bad = list text
    each p in f.kids[0].kids
        if p.is_link
            bad.add(p.name)
    ll_bld_scan(c, f.kids[1], cand, bad)
    each name in cand
        if not ll_has(bad, name) and not ll_has(g.blds, name)
            g.blds.add(name)

// ---------- свои списки и obj ----------

// значение по умолчанию (пропущенное качество obj, xs = list int): как emit_default в C
func ll_default(g: LLGen, c: Comp, t: int)
    k = kind_of(c, t)
    if k == "dec"
        return "0.0"
    if k == "bool"
        return "false"
    if k == "channel"
        r = ll_new(g, "%t")
        ct = "0"
        if c.types[t].elem == 4
            ct = "1"
        ll_put(g, r + " = call ptr @tb_x_chan_new(i64 " + ll_size(c, c.types[t].elem) + ", i32 " + ct + ")")
        return r
    if k == "task"
        return "null"
    if k == "text"
        name, sn = ll_strconst(g, "\"\"")
        return name
    if ll_bits(c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_x_bits_new()")
        return r
    if ll_colist(c, t)
        cn = ll_cneed(g, c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_lc_new_" + cn + "()")
        return r
    if ll_row(c, t)
        return "zeroinitializer"
    if ll_numlist(c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @" + ll_list_new_fn(c, t) + "(i64 8)")
        return r
    if ll_dict(c, t)
        r = ll_new(g, "%t")
        ll_put(g, r + " = call ptr @tb_x_dict_new(i32 " + ll_dict_text(c, t) + ", i64 " + ll_vsize(c, t) + ")")
        return r
    if k == "obj"
        return "null"
    return "0"

// [1, 2, 3]: числа во временный массив на стеке, потом tb_list_from_np (как в C)
func ll_list_lit(g: LLGen, c: Comp, n: Node)
    if ll_colist(c, n.ty)
        return ll_col_lit(g, c, n)
    nk = len(n.kids)
    if ll_bits(c, n.ty)
        // [true, false]: байты на стеке, потом tb_bits_from (как в C)
        if nk == 0
            return ll_default(g, c, n.ty)
        barr = "%\"arr" + ll_new(g, "") + "\""
        g.allocas.add("  " + barr + " = alloca [" + nk + " x i8]\n")
        count i from 0 to nk - 1
            bv = ll_expr(g, c, n.kids[i])
            bz = ll_new(g, "%t")
            ll_put(g, bz + " = zext i1 " + bv + " to i8")
            bp = ll_new(g, "%t")
            ll_put(g, bp + " = getelementptr inbounds i8, ptr " + barr + ", i64 " + i)
            ll_put(g, "store i8 " + bz + ", ptr " + bp)
        br = ll_new(g, "%t")
        ll_put(g, br + " = call ptr @tb_x_bits_from(i64 " + nk + ", ptr " + barr + ")")
        return br
    et = ll_elem_ty(c, n.ty)
    if nk == 0
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = call ptr @" + ll_list_new_fn(c, n.ty) + "(i64 8)")
        return r0
    arr = "%\"arr" + ll_new(g, "") + "\""
    g.allocas.add("  " + arr + " = alloca [" + nk + " x " + et + "]\n")
    count i from 0 to nk - 1
        v = ll_as(g, c, n.kids[i], c.types[n.ty].elem)
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds " + et + ", ptr " + arr + ", i64 " + i)
        ll_put(g, "store " + et + " " + v + ", ptr " + ep)
    r = ll_new(g, "%t")
    from_fn = "tb_x_list_from_np"
    if ll_ptr_elems(c, n.ty)
        from_fn = "tb_x_list_from"
    ll_put(g, r + " = call ptr @" + from_fn + "(i64 " + nk + ", i64 8, ptr " + arr + ")")
    return r

// пустой список: из чисел — память без адресов (уборка туда не смотрит), иначе обычная
func ll_list_new_fn(c: Comp, t: int)
    if ll_ptr_elems(c, t)
        return "tb_x_list_new"
    return "tb_x_list_new_np"

// Ball(...): tb_new_Ball из C (все качества по порядку, пропущенные — по умолчанию)
func ll_new_obj(g: LLGen, c: Comp, n: Node)
    o = n.ref
    args = ""
    tys = ""
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        v = ""
        if n.kids[i].kind == "missing"
            v = ll_default(g, c, ft)
        else
            v = ll_as(g, c, n.kids[i].kids[0], ft)
        if i > 0
            args = args + ", "
            tys = tys + ", "
        args = args + ll_ty(c, ft) + " " + ll_ext(c, ft) + v
        tys = tys + ll_ty(c, ft) + " " + ll_ext(c, ft)
    ll_need(g, "declare ptr @tb_new_" + o.name + "(" + tys + ")\n")
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_new_" + o.name + "(" + args + ")")
    return r

// ---------- dict ----------

func ll_dict_text(c: Comp, t: int)
    if kind_of(c, c.types[t].key) == "text"
        return "1"
    return "0"

// размер значения в памяти dict (как sizeof в C)
func ll_vsize(c: Comp, t: int)
    if kind_of(c, c.types[t].elem) == "bool"
        return "1"
    if ll_row(c, c.types[t].elem)
        return "16"
    return "8"

// ключ как адрес (&(K){ключ} в C): своё место на стеке функции
func ll_key_ptr(g: LLGen, c: Comp, dt: int, key: Node)
    kt = c.types[dt].key
    // dict хранит сам адрес текста-ключа: читаем «с сохранением»
    v = ll_expr(g, c, key)
    slot = "%\"key" + ll_new(g, "") + "\""
    g.allocas.add("  " + slot + " = alloca " + ll_ty(c, kt) + "\n")
    ll_put(g, "store " + ll_ty(c, kt) + " " + v + ", ptr " + slot)
    return slot

// значение типа t в памяти: bool — байт
func ll_store_val(g: LLGen, c: Comp, t: int, v: text, at: text)
    if kind_of(c, t) == "bool"
        z = ll_new(g, "%t")
        ll_put(g, z + " = zext i1 " + v + " to i8")
        ll_put(g, "store i8 " + z + ", ptr " + at)
        return
    ll_put(g, "store " + ll_mem_ty(c, t) + " " + v + ", ptr " + at)

func ll_load_val(g: LLGen, c: Comp, t: int, at: text)
    r = ll_new(g, "%t")
    ll_put(g, r + " = load " + ll_mem_ty(c, t) + ", ptr " + at)
    if kind_of(c, t) == "bool"
        r2 = ll_new(g, "%t")
        ll_put(g, r2 + " = trunc i8 " + r + " to i1")
        return r2
    return r

// {k: v, ...}: ключи и значения во временные массивы на стеке, потом tb_dict_from
func ll_dict_lit(g: LLGen, c: Comp, n: Node)
    t = n.ty
    vt = c.types[t].elem
    kt = c.types[t].key
    nk = len(n.kids) / 2
    if nk == 0
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = call ptr @tb_x_dict_new(i32 " + ll_dict_text(c, t) + ", i64 " + ll_vsize(c, t) + ")")
        return r0
    ka = "%\"dk" + ll_new(g, "") + "\""
    va = "%\"dv" + ll_new(g, "") + "\""
    g.allocas.add("  " + ka + " = alloca [" + nk + " x " + ll_ty(c, kt) + "]\n")
    g.allocas.add("  " + va + " = alloca [" + nk + " x " + ll_mem_ty(c, vt) + "]\n")
    count i from 0 to nk - 1
        kv = ll_expr(g, c, n.kids[2 * i])
        kp = ll_new(g, "%t")
        ll_put(g, kp + " = getelementptr inbounds " + ll_ty(c, kt) + ", ptr " + ka + ", i64 " + i)
        ll_put(g, "store " + ll_ty(c, kt) + " " + kv + ", ptr " + kp)
        vv = ll_as(g, c, n.kids[2 * i + 1], vt)
        vp = ll_new(g, "%t")
        ll_put(g, vp + " = getelementptr inbounds " + ll_mem_ty(c, vt) + ", ptr " + va + ", i64 " + i)
        ll_store_val(g, c, vt, vv, vp)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_dict_from(i32 " + ll_dict_text(c, t) + ", i64 " + ll_vsize(c, t) + ", i64 " + nk + ", ptr " + ka + ", ptr " + va + ")")
    return r

// адрес d[k] для записи: ключа нет — dict создаёт его со значением по умолчанию
func ll_dput(g: LLGen, c: Comp, t: Node)
    dt = t.kids[0].ty
    vt = c.types[dt].elem
    base = ll_expr(g, c, t.kids[0])
    kp = ll_key_ptr(g, c, dt, t.kids[1])
    def = "null"
    if ll_val(c, vt) and kind_of(c, vt) != "enum"
        def = "%\"def" + ll_new(g, "") + "\""
        g.allocas.add("  " + def + " = alloca " + ll_mem_ty(c, vt) + "\n")
        ll_store_val(g, c, vt, ll_default(g, c, vt), def)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_dput(ptr " + base + ", ptr " + kp + ", ptr " + def + ")")
    return r

// меняется ли в теле длина какого-нибудь списка: add / pop / clear, новое значение
// у имени списка, вызов функции, которой отдали список или obj (она может сделать add)
func ll_may_resize(c: Comp, n: Node)
    k = n.kind
    if k == "method"
        return true
    if (k == "assign" or k == "set") and kind_of(c, n.ty) == "list"
        return true
    if k == "call" and n.has_ref and n.ref.kind == "func"
        each a in n.kids
            if len(a.kids) > 0 and ll_box(c, a.kids[0].ty)
                return true
    each kid in n.kids
        if ll_may_resize(c, kid)
            return true
    return false

// адрес p.x: проверка на пустой obj, потом поле (холодное — через tb_cold), как в C
func ll_field_ptr(g: LLGen, c: Comp, n: Node)
    if ll_row(c, n.kids[0].ty)
        return ll_row_field_ptr(g, c, n)
    base = ll_expr(g, c, n.kids[0])
    z = ll_new(g, "%t")
    ll_put(g, z + " = icmp eq ptr " + base + ", null")
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + z + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 4)
    ll_label(g, ok)
    o = c.types[n.kids[0].ty].obj_node
    hot = 0
    cold = 0
    hot_at = -1
    cold_at = -1
    each f in o.kids
        if f.is_cold
            if f.name == n.name
                cold_at = cold
            cold += 1
        else
            if f.name == n.name
                hot_at = hot
            hot += 1
    fp = ll_new(g, "%t")
    if hot_at >= 0
        ll_put(g, fp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr " + base + ", i32 0, i32 " + hot_at)
        return fp
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr " + base + ", i32 0, i32 " + hot)
    cb = ll_new(g, "%t")
    ll_put(g, cb + " = load ptr, ptr " + cp)
    ll_put(g, fp + " = getelementptr inbounds %\"tb_c_" + o.name + "\", ptr " + cb + ", i32 0, i32 " + cold_at)
    return fp

// устройство obj для LLVM: те же поля в том же порядке, что struct в C
func ll_obj_types(c: Comp, program: Node, all: list text)
    each top in program.kids
        if top.kind == "obj" and not top.by_cols
            t = -1
            each ty in c.types
                if ty.kind == "obj" and ty.obj_name == top.name
                    t = ty.id
            if t >= 0 and ll_plainobj(c, t)
                hot = ""
                cold = ""
                each f in top.kids
                    if f.is_cold
                        if cold != ""
                            cold = cold + ", "
                        cold = cold + ll_mem_ty(c, f.ty)
                    else
                        if hot != ""
                            hot = hot + ", "
                        hot = hot + ll_mem_ty(c, f.ty)
                if cold != ""
                    all.add("%\"tb_c_" + top.name + "\" = type { " + cold + " }\n")
                    if hot != ""
                        hot = hot + ", "
                    hot = hot + "ptr"
                if hot == ""
                    hot = "i8"
                all.add("%\"tb_o_" + top.name + "\" = type { " + hot + " }\n")

func ll_len(g: LLGen, base: text)
    lp = ll_new(g, "%t")
    ll_put(g, lp + " = getelementptr inbounds i8, ptr " + base + ", i64 8")
    r = ll_new(g, "%t")
    ll_put(g, r + " = load i64, ptr " + lp + ", !tbaa !10")
    return r

// адрес xs[i] с проверкой номера (как tb_at в C: одно сравнение без знака)
func ll_elem_ptr(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    idx = ll_expr(g, c, n.kids[1])
    if ll_has(g.fast, ll_index_key(n))
        // номер уже проверен до цикла
        d0 = ll_new(g, "%t")
        ll_put(g, d0 + " = load ptr, ptr " + base + ", !tbaa !10")
        ep0 = ll_new(g, "%t")
        ll_put(g, ep0 + " = getelementptr inbounds " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + d0 + ", i64 " + idx)
        return ep0
    ln = ll_len(g, base)
    bad = ll_new(g, "%t")
    ll_put(g, bad + " = icmp uge i64 " + idx + ", " + ln)
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + bad + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_crash(g, n.line, 3)
    ll_label(g, ok)
    d = ll_new(g, "%t")
    ll_put(g, d + " = load ptr, ptr " + base + ", !tbaa !10")
    ep = ll_new(g, "%t")
    ll_put(g, ep + " = getelementptr inbounds " + ll_elem_ty(c, n.kids[0].ty) + ", ptr " + d + ", i64 " + idx)
    return ep

// один проход count: от start до end включительно, в конце — переход на out
func ll_count_loop(g: LLGen, c: Comp, n: Node, start: text, end: text, out: text)
    slot = ll_slot(g, c, n.name, 1)
    ll_put(g, "store i64 " + start + ", ptr " + slot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + slot)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp sle i64 " + iv + ", " + end)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    ll_loop_body(g, c, n.kids[2], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + slot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + slot)
    ll_term(g, "br label %" + head)

// xs[i], xs[i + 3], xs[i - 1] → "xs#i#k"; иначе ""
func ll_index_key(n: Node)
    if n.kind != "index" or n.kids[0].kind != "name"
        return ""
    ix = n.kids[1]
    if ix.kind == "name"
        return n.kids[0].name + "#" + ix.name + "#0"
    if ix.kind == "binop" and (ix.value == "+" or ix.value == "-") and ix.kids[0].kind == "name" and ix.kids[1].kind == "number"
        if ix.value == "-"
            return n.kids[0].name + "#" + ix.kids[0].name + "#-" + ix.kids[1].value
        return n.kids[0].name + "#" + ix.kids[0].name + "#" + ix.kids[1].value
    return ""

func ll_fast_collect(c: Comp, n: Node, var: text, keys: list text, nodes: list Node, offs: list int)
    key = ll_index_key(n)
    if key != "" and not ll_numlist(c, n.kids[0].ty)
        key = ""
    if key != "" and starts_with(key, n.kids[0].name + "#" + var + "#") and not ll_has(keys, key)
        k = to_int(cut(key, len(n.kids[0].name) + len(var) + 2, len(key) - 1)) or 0
        if k > -1000000 and k < 1000000
            keys.add(key)
            nodes.add(n)
            offs.add(k)
    each kid in n.kids
        ll_fast_collect(c, kid, var, keys, nodes, offs)

// меняют ли где-то в теле саму переменную цикла (тогда проверка до цикла не годится)
func ll_assigns(n: Node, name: text)
    if (n.kind == "assign" and n.name == name) or (n.kind == "set" and n.kids[0].kind == "name" and n.kids[0].name == name)
        return true
    if n.kind == "call" and n.has_ref and n.ref.kind == "func"
        // f(i) с link: функция может поменять i
        params = n.ref.kids[0]
        count i from 0 to len(n.kids) - 1
            if i < len(params.kids) and params.kids[i].is_link and len(n.kids[i].kids) > 0 and n.kids[i].kids[0].kind == "name" and n.kids[i].kids[0].name == name
                return true
    each kid in n.kids
        if ll_assigns(kid, name)
            return true
    return false

// тело цикла: если всё, что создано за шаг, не уходит наружу — своя временная память
// на каждый шаг, отдаётся разом в конце шага (и при skip), как в C
func ll_loop_body(g: LLGen, c: Comp, body: Node, cont: text, out: text)
    if not auto_temp_ok(c, body)
        g.cont.add(cont)
        g.brk.add(out)
        ll_block(g, c, body)
        gone_c = g.cont.pop()
        gone_b = g.brk.pop()
        return
    am = "%\"am" + ll_new(g, "") + "\""
    g.allocas.add("  " + am + " = alloca [2 x i64]\n")
    ll_put(g, "call void @tb_x_temp_begin_p(ptr " + am + ")")
    rel = ll_new(g, "L")
    g.cont.add(rel)
    g.brk.add(out)
    ll_block(g, c, body)
    gone_c = g.cont.pop()
    gone_b = g.brk.pop()
    ll_label(g, rel)
    ll_put(g, "call void @tb_x_temp_end_p(ptr " + am + ")")
    ll_term(g, "br label %" + cont)

// встроенная функция: обёртка tb_llb_N в C (номер записан в n.temp_no при выборе)
func ll_builtin(g: LLGen, c: Comp, n: Node)
    if c.ll_pure
        return ll_builtin_x(g, c, n)
    args = ""
    tys = ""
    bargs = ll_bi_args(n)
    count i from 0 to len(bargs) - 1
        a = bargs[i]
        v = ll_expr(g, c, a)
        if i > 0
            args = args + ", "
            tys = tys + ", "
        args = args + ll_ty(c, a.ty) + " " + ll_ext(c, a.ty) + v
        tys = tys + ll_ty(c, a.ty) + " " + ll_ext(c, a.ty)
    fn = "@tb_llb_" + n.temp_no
    rt = ll_ext(c, n.ty) + ll_ty(c, n.ty)
    ll_need(g, "declare " + rt + " " + fn + "(" + tys + ")\n")
    if ll_none(c, n.ty)
        ll_put(g, "call void " + fn + "(" + args + ")")
        return "0"
    r = ll_new(g, "%t")
    ll_put(g, r + " = call " + rt + " " + fn + "(" + args + ")")
    return r

// без C: встроенная функция — сразу функция библиотеки tb_xb_имя(..., строка)
func ll_builtin_x(g: LLGen, c: Comp, n: Node)
    if n.kind == "background"
        return ll_bg(g, c, n)
    if n.kind == "field"
        return ll_wait(g, c, n)
    xn, xp = ll_xb(c, n)
    fn = "@tb_xb_" + xn
    args = ""
    tys = ""
    bargs = ll_bi_args(n)
    count i from 0 to len(bargs) - 1
        a = bargs[i]
        v = ll_expr(g, c, a)
        pk = xp[i]
        pt = "ptr"
        if pk == "d"
            pt = "double"
            if kind_of(c, a.ty) != "dec"
                v2 = ll_new(g, "%t")
                ll_put(g, v2 + " = sitofp i64 " + v + " to double")
                v = v2
        else if pk == "i"
            pt = "i64"
        args = args + pt + " " + v + ", "
        tys = tys + pt + ", "
    args = args + "i32 " + n.line
    tys = tys + "i32"
    rt = ll_ext(c, n.ty) + ll_ty(c, n.ty)
    ll_need(g, "declare " + rt + " " + fn + "(" + tys + ")\n")
    if ll_none(c, n.ty)
        ll_put(g, "call void " + fn + "(" + args + ")")
        return "0"
    r = ll_new(g, "%t")
    ll_put(g, r + " = call " + rt + " " + fn + "(" + args + ")")
    return r

// имя в библиотеке (tb_xb_имя) и виды параметров: i — int, d — dec, p — адрес (текст, список);
// "" — такой функции там нет (тогда программа идёт старым путём, через clang)
func ll_xb(c: Comp, n: Node) gives name: text, ps: text
    nm = n.name
    if nm == "sort"
        k = kind_of(c, c.types[n.kids[0].kids[0].ty].elem)
        if k == "int"
            name = "sort_int"
            ps = "p"
            return
        if k == "dec"
            name = "sort_dec"
            ps = "p"
            return
        name = "sort_text"
        ps = "p"
        return
    if nm == "abs"
        if kind_of(c, n.kids[0].kids[0].ty) == "int"
            name = "abs_i"
            ps = "i"
            return
        name = "abs_d"
        ps = "d"
        return
    if nm == "min" or nm == "max"
        if kind_of(c, n.ty) == "int"
            name = nm + "_i"
            ps = "ii"
            return
        name = nm + "_d"
        ps = "dd"
        return
    table = ["round:d", "char:i", "cut:pii", "code:p", "to_int:p", "to_dec:p", "read_file:p", "write_file:pp", "split:pp", "join:pp", "find:pp", "replace:ppp", "upper:p", "lower:p", "trim:p", "starts_with:pp", "ends_with:pp", "run:p", "exit:i", "file_exists:p", "list_dir:p", "is_folder:p", "make_folder:p", "move:pp", "remove:p", "env:p", "file_size:p", "rgb:iii", "random:ii", "bit_and:ii", "bit_or:ii", "bit_xor:ii", "bit_not:i", "shift_left:ii", "shift_right:ii", "wait_ms:i", "http_get:p", "json_get:pp", "json_text:p", "date_now:", "unix_time:", "time_ms:", "input:", "args:", "sqrt:d", "window_open:iip", "window_alive:", "clear_window:i", "draw_pixel:iii", "draw_rect:iiiii", "draw_circle:iiii", "draw_triangle:iiiiiii", "mesh_new:", "mesh_add:idddddddddi", "draw_mesh:idddd", "camera:dddddd", "draw_line:iiiii", "draw_text:iipii", "key_down:p", "mouse_x:", "mouse_y:", "mouse_down:", "mouse_wheel:", "typed_text:", "clipboard_get:", "window_sharp:", "window_scale:", "clipboard_set:p", "set_cursor:p", "mouse_back:", "mouse_forward:", "frame_ms:", "fps:", "window_w:", "window_h:", "set_fps:i", "load_image:p", "load_font:p", "draw_font:iiipii", "text_width:ipi", "draw_image:iii", "image_w:i", "image_h:i", "read8:i", "read16:i", "read32:i", "read64:i", "write8:ii", "write16:ii", "write32:ii", "write64:ii", "address_of:p", "new_mem:i", "free_mem:i", "grow_mem:ii", "copy_mem:iii", "fill_mem:iii"]
    each e in table
        at = find(e, ":")
        if cut(e, 0, at - 1) == nm
            name = nm
            ps = ""
            if at < len(e) - 1
                ps = cut(e, at + 1, len(e) - 1)
            return
    name = ""
    ps = ""

// адрес tb_err (у каждого потока свой): через маленькую функцию из C, LTO её встраивает
func ll_errp(g: LLGen)
    r = ll_new(g, "%t")
    ll_put(g, r + " = call ptr @tb_x_errp()")
    return r

// функция сломалась: выйти со значением по умолчанию (ошибка уже лежит в tb_err)
func ll_bail(g: LLGen, c: Comp)
    if g.fn.name == "main"
        // в main ошибку некому передать: сообщение и выход, как tb_die в C
        e = ll_new(g, "%t")
        ll_put(g, e + " = load ptr, ptr " + ll_errp(g))
        ll_put(g, "call void @tb_x_die(ptr " + e + ")")
        ll_term(g, "unreachable")
        return
    if len(g.outs) > 0
        // gives: выходим с тем, что уже лежит в выходах (как emit_bail в C)
        ll_gives_ret(g, c)
        return
    ll_fa_end(g)
    if ll_none(c, g.fn.ty)
        ll_term(g, "ret void")
        return
    d = ll_default(g, c, g.fn.ty)
    ll_term(g, "ret " + ll_ty(c, g.fn.ty) + " " + d)

// return в функции с gives: один выход — его значение, несколько — уже лежат по адресам
func ll_gives_ret(g: LLGen, c: Comp)
    if g.multi_out
        each bo in g.fn.kids[2].kids
            if kind_of(c, bo.ty) == "bool"
                bv = ll_new(g, "%t")
                ll_put(g, bv + " = load i1, ptr " + ll_slot(g, c, bo.name, bo.ty))
                bz = ll_new(g, "%t")
                ll_put(g, bz + " = zext i1 " + bv + " to i8")
                ll_put(g, "store i8 " + bz + ", ptr %\"b." + bo.name + "\"")
        ll_fa_end(g)
        ll_term(g, "ret void")
        return
    o = g.fn.kids[2].kids[0]
    v = ll_new(g, "%t")
    ll_put(g, v + " = load " + ll_ty(c, o.ty) + ", ptr " + ll_slot(g, c, o.name, o.ty))
    ll_fa_end(g)
    ll_term(g, "ret " + ll_ty(c, o.ty) + " " + v)

// вызов функции с несколькими выходами: f__ll(аргументы, адреса выходов)
func ll_call_multi(g: LLGen, c: Comp, n: Node, outs: list text)
    f = n.ref
    params = f.kids[0]
    args = ""
    count i from 0 to len(n.kids) - 1
        p = params.kids[i]
        arg = n.kids[i].kids[0]
        v = ""
        if p.is_link
            v = ll_addr(g, c, arg)
        else
            v = ll_as(g, c, arg, p.ty)
        if i > 0
            args = args + ", "
        args = args + ll_arg(g, c, p, v)
    fouts = f.kids[2].kids
    bytes = list text
    count j from 0 to len(outs) - 1
        if args != ""
            args = args + ", "
        if kind_of(c, fouts[j].ty) == "bool"
            // bool-выход приходит байтом
            bt = "%\"mb" + ll_new(g, "") + "\""
            g.allocas.add("  " + bt + " = alloca i8\n")
            ll_put(g, "store i8 0, ptr " + bt)
            bytes.add(bt)
            args = args + "ptr " + bt
        else
            bytes.add("")
            args = args + "ptr " + outs[j]
    ll_put(g, "call void @\"" + ll_fname(f) + "__ll\"(" + args + ")")
    count j from 0 to len(outs) - 1
        if bytes[j] != ""
            bl = ll_new(g, "%t")
            ll_put(g, bl + " = load i8, ptr " + bytes[j])
            bb = ll_new(g, "%t")
            ll_put(g, bb + " = icmp ne i8 " + bl + ", 0")
            ll_put(g, "store i1 " + bb + ", ptr " + outs[j])

// перед выходом из функции: отдать её временную память
func ll_fa_end(g: LLGen)
    if g.fa != ""
        ll_put(g, "call void @tb_x_fa_end(i32 " + g.fa + ", ptr %\"fm\")")

// each v in flags (list bool): номер внутри списка, бит берём tb_bget
func ll_each_bits(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    ln = ll_len(g, base)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    bv = ll_new(g, "%t")
    ll_put(g, bv + " = call zeroext i1 @tb_x_bget(ptr " + base + ", i64 " + iv + ", i32 " + n.line + ")")
    ll_put(g, "store i1 " + bv + ", ptr " + ll_slot(g, c, n.name, 3))
    ll_loop_body(g, c, n.kids[1], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

// each x in ch: берём, пока канал не закрыт и не пуст
func ll_each_chan(g: LLGen, c: Comp, n: Node)
    ch = ll_expr(g, c, n.kids[0])
    et = c.types[n.kids[0].ty].elem
    cell = "%\"cv" + ll_new(g, "") + "\""
    g.allocas.add("  " + cell + " = alloca " + ll_mem_ty(c, et) + "\n")
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_term(g, "br label %" + head)
    ll_label(g, head)
    got = ll_new(g, "%t")
    ll_put(g, got + " = call i32 @tb_x_chan_take(ptr " + ch + ", ptr " + cell + ")")
    more = ll_new(g, "%t")
    ll_put(g, more + " = icmp ne i32 " + got + ", 0")
    ll_term(g, "br i1 " + more + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    v = ll_load_val(g, c, et, cell)
    ll_put(g, "store " + ll_ty(c, et) + " " + v + ", ptr " + ll_slot(g, c, n.name, et))
    ll_loop_body(g, c, n.kids[1], head, out)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

// each ch in s: по байтам до нуля, ch — текст из одного знака (tb_chr, как в C)
func ll_each_text(g: LLGen, c: Comp, n: Node)
    base = ll_expr(g, c, n.kids[0])
    ll_need(g, "declare ptr @tb_x_chr(i64)")
    islot = ll_slot(g, c, ll_new(g, "e"), 1)
    ll_put(g, "store i64 0, ptr " + islot)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    step = ll_new(g, "L")
    out = ll_new(g, "L")
    ll_label(g, head)
    iv = ll_new(g, "%t")
    ll_put(g, iv + " = load i64, ptr " + islot)
    bp = ll_new(g, "%t")
    ll_put(g, bp + " = getelementptr inbounds i8, ptr " + base + ", i64 " + iv)
    b = ll_new(g, "%t")
    ll_put(g, b + " = load i8, ptr " + bp)
    cv = ll_new(g, "%t")
    ll_put(g, cv + " = icmp ne i8 " + b + ", 0")
    ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
    ll_label(g, body)
    z = ll_new(g, "%t")
    ll_put(g, z + " = zext i8 " + b + " to i64")
    ch = ll_new(g, "%t")
    ll_put(g, ch + " = call ptr @tb_x_chr(i64 " + z + ")")
    ll_put(g, "store ptr " + ch + ", ptr " + ll_slot(g, c, n.name, 4))
    ll_loop_body(g, c, n.kids[1], step, out)
    ll_label(g, step)
    iv2 = ll_new(g, "%t")
    ll_put(g, iv2 + " = load i64, ptr " + islot)
    nx = ll_new(g, "%t")
    ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
    ll_put(g, "store i64 " + nx + ", ptr " + islot)
    ll_term(g, "br label %" + head)
    ll_label(g, out)

func ll_block(g: LLGen, c: Comp, b: Node)
    each s in b.kids
        ll_stmt(g, c, s)

func ll_stmt(g: LLGen, c: Comp, n: Node)
    k = n.kind
    if k == "assign"
        bld = ll_has(g.blds, n.name) and ll_is_text(c, n.ty)
        if bld and not n.creates and len(n.kids) > 0 and ll_app_form(c, n.name, n.kids[0])
            // s = s + a + b: дописать a и b в конец s
            each part in ll_app_parts(c, n.kids[0])
                ll_app(g, c, n.name, n.ty, part)
            return
        v = ""
        if len(n.kids) == 0
            v = ll_default(g, c, n.ty)
        else
            v = ll_as(g, c, n.kids[0], n.ty)
        ll_put(g, "store " + ll_ty(c, n.ty) + " " + v + ", ptr " + ll_slot(g, c, n.name, n.ty))
        if bld
            // новый текст: своей памяти у s пока нет
            ll_put(g, "store i64 -1, ptr " + ll_rl(g, n.name))
    else if k == "set" and n.kids[0].kind == "index" and ll_dict(c, n.kids[0].kids[0].ty)
        // d[k] = v / d[k] += v: сначала значение, потом место (как в C)
        t = n.kids[0]
        op = n.value
        vt = n.ty
        v = ""
        if op == "="
            v = ll_as(g, c, n.kids[1], vt)
        else if ll_is_text(c, vt)
            v = ll_as_text(g, c, n.kids[1])
        else
            v = ll_expr(g, c, n.kids[1])
        p = ll_dput(g, c, t)
        if op == "="
            ll_store_val(g, c, vt, v, p)
            return
        old = ll_load_val(g, c, vt, p)
        r = ""
        if ll_is_text(c, vt)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call ptr @tb_x_cat(ptr " + old + ", ptr " + v + ")")
        else
            r = ll_arith(g, c, cut(op, 0, 0), old, vt, v, n.kids[1].ty, vt, n.line)
        ll_store_val(g, c, vt, r, p)
    else if k == "set" and n.kids[0].kind == "index" and ll_colist(c, n.kids[0].kids[0].ty)
        // pts[i] = p: сначала значение, потом список и номер; копия качеств (tb_colset_X)
        rv = ll_expr(g, c, n.kids[1])
        cl = ll_expr(g, c, n.kids[0].kids[0])
        ci = ll_expr(g, c, n.kids[0].kids[1])
        cn = ll_cneed(g, c, n.kids[0].kids[0].ty)
        ll_put(g, "call void @tb_lc_set_" + cn + "(ptr " + cl + ", i64 " + ci + ", ptr " + ll_rpart(g, rv, 0) + ", i64 " + ll_rpart(g, rv, 1) + ", i32 " + n.line + ")")
    else if k == "set" and n.kids[0].kind == "index" and ll_bits(c, n.kids[0].kids[0].ty)
        // flags[i] = v: сначала значение, потом список и номер (как в C)
        v = ll_expr(g, c, n.kids[1])
        bl = ll_expr(g, c, n.kids[0].kids[0])
        bi = ll_expr(g, c, n.kids[0].kids[1])
        ll_put(g, "call void @tb_x_bset(ptr " + bl + ", i64 " + bi + ", i1 zeroext " + v + ", i32 " + n.line + ")")
    else if k == "set" and n.kids[0].kind == "index"
        // xs[i] = v / xs[i] += v: как в C, сначала значение, потом адрес
        t = n.kids[0]
        op = n.value
        et = ll_elem_ty(c, t.kids[0].ty)
        tag = ll_elem_tag(c, t.kids[0].ty)
        if op == "="
            v = ll_as(g, c, n.kids[1], n.ty)
            ep = ll_elem_ptr(g, c, t)
            ll_put(g, "store " + et + " " + v + ", ptr " + ep + tag)
            return
        v = ll_expr(g, c, n.kids[1])
        ep = ll_elem_ptr(g, c, t)
        old = ll_new(g, "%t")
        ll_put(g, old + " = load " + et + ", ptr " + ep + tag)
        r = ll_arith(g, c, cut(op, 0, 0), old, n.ty, v, n.kids[1].ty, n.ty, n.line)
        ll_put(g, "store " + et + " " + r + ", ptr " + ep + tag)
    else if k == "set" and n.kids[0].kind == "field"
        // p.x = v / p.x += v: сначала значение, потом адрес (как в C)
        t = n.kids[0]
        op = n.value
        mt = ll_mem_ty(c, n.ty)
        v = ""
        if op == "="
            v = ll_as(g, c, n.kids[1], n.ty)
        else if ll_is_text(c, n.ty)
            v = ll_as_text(g, c, n.kids[1])
        else
            v = ll_expr(g, c, n.kids[1])
        fp = ll_field_ptr(g, c, t)
        r = v
        if op != "=" and ll_is_text(c, n.ty)
            old = ll_new(g, "%t")
            ll_put(g, old + " = load ptr, ptr " + fp)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call ptr @tb_x_cat(ptr " + old + ", ptr " + v + ")")
        else if op != "="
            old = ll_new(g, "%t")
            ll_put(g, old + " = load " + mt + ", ptr " + fp)
            r = ll_arith(g, c, cut(op, 0, 0), old, n.ty, v, n.kids[1].ty, n.ty, n.line)
        if kind_of(c, n.ty) == "bool"
            z = ll_new(g, "%t")
            ll_put(g, z + " = zext i1 " + r + " to i8")
            r = z
        ll_put(g, "store " + mt + " " + r + ", ptr " + fp)
    else if k == "set"
        t = n.kids[0]
        slot = ll_slot(g, c, t.name, n.ty)
        ty = ll_ty(c, n.ty)
        op = n.value
        if op == "="
            v = ll_as(g, c, n.kids[1], n.ty)
            ll_put(g, "store " + ty + " " + v + ", ptr " + slot)
            if ll_has(g.blds, t.name) and ll_is_text(c, n.ty)
                ll_put(g, "store i64 -1, ptr " + ll_rl(g, t.name))
            return
        if ll_is_text(c, n.ty)
            value = n.kids[1]
            if ll_has(g.blds, t.name)
                if ll_text_plus(c, value) and not ll_bld_uses(value, t.name)
                    // s += a + b: дописать a, потом b — без промежуточного текста a + b
                    r0 = value
                    repeat while ll_text_plus(c, r0)
                        r0 = r0.kids[0]
                    ll_app(g, c, t.name, n.ty, r0)
                    each part in ll_app_parts(c, value)
                        ll_app(g, c, t.name, n.ty, part)
                    return
                // s += x: дописать x в конец s (число — цифрами сразу, готовый текст — с известной длиной)
                ll_app(g, c, t.name, n.ty, value)
                return
            xv = ll_as_text(g, c, value)
            old = ll_new(g, "%t")
            ll_put(g, old + " = load ptr, ptr " + slot)
            r = ll_new(g, "%t")
            ll_put(g, r + " = call ptr @tb_x_cat(ptr " + old + ", ptr " + xv + ")")
            ll_put(g, "store ptr " + r + ", ptr " + slot)
            return
        // x += y: как  x = x + y
        v = ll_expr(g, c, n.kids[1])
        old = ll_new(g, "%t")
        ll_put(g, old + " = load " + ty + ", ptr " + slot)
        r = ll_arith(g, c, cut(op, 0, 0), old, n.ty, v, n.kids[1].ty, n.ty, n.line)
        ll_put(g, "store " + ty + " " + r + ", ptr " + slot)
    else if k == "if"
        done = ll_new(g, "L")
        i = 0
        repeat while i + 1 < len(n.kids)
            cv = ll_expr(g, c, n.kids[i])
            yes = ll_new(g, "L")
            no = ll_new(g, "L")
            ll_term(g, "br i1 " + cv + ", label %" + yes + ", label %" + no)
            ll_label(g, yes)
            ll_block(g, c, n.kids[i + 1])
            if g.open
                ll_term(g, "br label %" + done)
            ll_label(g, no)
            i += 2
        if len(n.kids) % 2 == 1
            ll_block(g, c, n.kids[len(n.kids) - 1])
        ll_label(g, done)
    else if (k == "count" or k == "each") and n.is_par
        ll_par(g, c, n)
    else if k == "each" and n.by_vec
        ll_vec(g, c, n)
    else if k == "each" and n.by_piece
        ll_pieces(g, c, n)
    else if k == "count"
        // как в C: сначала конец, потом начало; конец считается один раз
        end = ll_expr(g, c, n.kids[1])
        start = ll_expr(g, c, n.kids[0])
        out = ll_new(g, "L")
        keys = list text
        nodes = list Node
        offs = list int
        ll_fast_collect(c, n.kids[2], n.name, keys, nodes, offs)
        if len(keys) > 0 and g.fast_depth < 2 and not ll_assigns(n.kids[2], n.name) and not ll_may_resize(c, n.kids[2])
            // В теле списки не растут и не укорачиваются (нет add/pop, вызовов со списками):
            // значит, все xs[i + k] можно проверить один раз до цикла. Прошло — цикл без проверок.
            none = ll_new(g, "%t")
            ll_put(g, none + " = icmp sgt i64 " + start + ", " + end)
            all = "true"
            count q from 0 to len(nodes) - 1
                base = ll_expr(g, c, nodes[q].kids[0])
                ln = ll_len(g, base)
                lo = ll_new(g, "%t")
                ll_put(g, lo + " = add i64 " + start + ", " + offs[q])
                hi = ll_new(g, "%t")
                ll_put(g, hi + " = add i64 " + end + ", " + offs[q])
                c1 = ll_new(g, "%t")
                ll_put(g, c1 + " = icmp sge i64 " + lo + ", 0")
                c2 = ll_new(g, "%t")
                ll_put(g, c2 + " = icmp slt i64 " + hi + ", " + ln)
                both = ll_new(g, "%t")
                ll_put(g, both + " = and i1 " + c1 + ", " + c2)
                acc = ll_new(g, "%t")
                ll_put(g, acc + " = and i1 " + all + ", " + both)
                all = acc
            go = ll_new(g, "%t")
            ll_put(g, go + " = or i1 " + none + ", " + all)
            fast = ll_new(g, "L")
            slow = ll_new(g, "L")
            ll_term(g, "br i1 " + go + ", label %" + fast + ", label %" + slow)
            ll_label(g, fast)
            each key in keys
                g.fast.add(key)
            g.fast_depth += 1
            ll_count_loop(g, c, n, start, end, out)
            g.fast_depth -= 1
            each key in keys
                gone_k = g.fast.pop()
            ll_label(g, slow)
        ll_count_loop(g, c, n, start, end, out)
        ll_label(g, out)
    else if k == "repeat_times"
        total = ll_expr(g, c, n.kids[0])
        slot = ll_slot(g, c, ll_new(g, "r"), 1)
        ll_put(g, "store i64 0, ptr " + slot)
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        step = ll_new(g, "L")
        out = ll_new(g, "L")
        ll_label(g, head)
        iv = ll_new(g, "%t")
        ll_put(g, iv + " = load i64, ptr " + slot)
        cv = ll_new(g, "%t")
        ll_put(g, cv + " = icmp slt i64 " + iv + ", " + total)
        ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
        ll_label(g, body)
        ll_loop_body(g, c, n.kids[1], step, out)
        ll_label(g, step)
        iv2 = ll_new(g, "%t")
        ll_put(g, iv2 + " = load i64, ptr " + slot)
        nx = ll_new(g, "%t")
        ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
        ll_put(g, "store i64 " + nx + ", ptr " + slot)
        ll_term(g, "br label %" + head)
        ll_label(g, out)
    else if k == "each"
        // each x in xs: len читается на каждом шаге (как в C), но LLVM знает, что запись чисел его не меняет
        lt = n.kids[0].ty
        if ll_is_text(c, lt)
            ll_each_text(g, c, n)
            return
        if ll_chan(c, lt)
            ll_each_chan(g, c, n)
            return
        if ll_bits(c, lt)
            ll_each_bits(g, c, n)
            return
        if ll_colist(c, lt)
            ll_each_cols(g, c, n)
            return
        base = ll_expr(g, c, n.kids[0])
        vt = c.types[lt].elem
        if ll_dict(c, lt)
            // each k in d: по списку ключей (он первым лежит в tb_dict)
            vt = c.types[lt].key
            kb = ll_new(g, "%t")
            ll_put(g, kb + " = load ptr, ptr " + base)
            base = kb
        et = "i64"
        tag = ", !tbaa !11"
        if vt == 2
            et = "double"
            tag = ", !tbaa !12"
        else if not (vt == 1 or kind_of(c, vt) == "enum")
            et = "ptr"
            tag = ", !tbaa !13"
        islot = ll_slot(g, c, ll_new(g, "e"), 1)
        ll_put(g, "store i64 0, ptr " + islot)
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        step = ll_new(g, "L")
        out = ll_new(g, "L")
        ll_label(g, head)
        iv = ll_new(g, "%t")
        ll_put(g, iv + " = load i64, ptr " + islot)
        ln = ll_len(g, base)
        cv = ll_new(g, "%t")
        ll_put(g, cv + " = icmp slt i64 " + iv + ", " + ln)
        ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
        ll_label(g, body)
        d = ll_new(g, "%t")
        ll_put(g, d + " = load ptr, ptr " + base + ", !tbaa !10")
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds " + et + ", ptr " + d + ", i64 " + iv)
        ev = ll_new(g, "%t")
        ll_put(g, ev + " = load " + et + ", ptr " + ep + tag)
        ll_put(g, "store " + et + " " + ev + ", ptr " + ll_slot(g, c, n.name, vt))
        ll_loop_body(g, c, n.kids[1], step, out)
        ll_label(g, step)
        iv2 = ll_new(g, "%t")
        ll_put(g, iv2 + " = load i64, ptr " + islot)
        nx = ll_new(g, "%t")
        ll_put(g, nx + " = add nsw i64 " + iv2 + ", 1")
        ll_put(g, "store i64 " + nx + ", ptr " + islot)
        ll_term(g, "br label %" + head)
        ll_label(g, out)
    else if k == "linkdecl"
        a = ll_addr(g, c, n.kids[0])
        if not ll_has(g.ldecls, n.name)
            g.ldecls.add(n.name)
            g.allocas.add("  %\"l." + n.name + "\" = alloca ptr\n")
        ll_put(g, "store ptr " + a + ", ptr %\"l." + n.name + "\"")
    else if k == "danger"
        ll_block(g, c, n.kids[0])
    else if k == "together"
        ll_together(g, c, n)
    else if k == "lock"
        // замок: атомарный обмен (tb_lock_take/give из C); unlock внутри — отпускает раньше
        lk = "@\"tb_lk_" + n.name + "\""
        ll_need(g, lk + " = external global i32\n")
        fs = "%\"lf" + ll_new(g, "") + "\""
        g.allocas.add("  " + fs + " = alloca i64\n")
        fv = ll_new(g, "%t")
        ll_put(g, fv + " = call i64 @tb_x_lock_take(ptr " + lk + ")")
        ll_put(g, "store i64 " + fv + ", ptr " + fs)
        g.locks.add(fs)
        ll_block(g, c, n.kids[0])
        gone = g.locks.pop()
        freed = false
        each st in n.kids[0].kids
            if st.kind == "unlock"
                freed = true
        if not freed
            ll_lock_give(g, n.name, fs)
    else if k == "unlock"
        ll_lock_give(g, n.name, g.locks[len(g.locks) - 1])
    else if k == "temp"
        // temp: всё, что создано внутри, отдаётся разом в конце (как tb_temp_begin/end в C)
        am = "%\"am" + ll_new(g, "") + "\""
        g.allocas.add("  " + am + " = alloca [2 x i64]\n")
        ll_put(g, "call void @tb_x_temp_begin_p(ptr " + am + ")")
        ll_block(g, c, n.kids[0])
        ll_put(g, "call void @tb_x_temp_end_p(ptr " + am + ")")
    else if k == "repeat_while"
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        out = ll_new(g, "L")
        ll_label(g, head)
        cv = ll_expr(g, c, n.kids[0])
        ll_term(g, "br i1 " + cv + ", label %" + body + ", label %" + out)
        ll_label(g, body)
        ll_loop_body(g, c, n.kids[1], head, out)
        ll_term(g, "br label %" + head)
        ll_label(g, out)
    else if k == "multi"
        call = n.kids[len(n.kids) - 1]
        if call.kind == "try" or call.kind == "else_err"
            // a, b = f() else err / try f(): выходы во временные места, проверка, потом в переменные (как в C)
            ignored = ll_expr(g, c, call)
            tmps = g.mtemps
            count i from 0 to len(n.kids) - 2
                t = n.kids[i].ty
                lv = ll_new(g, "%t")
                ll_put(g, lv + " = load " + ll_ty(c, t) + ", ptr " + tmps[i])
                ll_put(g, "store " + ll_ty(c, t) + " " + lv + ", ptr " + ll_slot(g, c, n.kids[i].name, t))
        else
            outs = list text
            count i from 0 to len(n.kids) - 2
                outs.add(ll_slot(g, c, n.kids[i].name, n.kids[i].ty))
            ll_call_multi(g, c, call, outs)
    else if k == "fail"
        msg = ll_expr(g, c, n.kids[0])
        ll_put(g, "store ptr " + msg + ", ptr " + ll_errp(g))
        ll_bail(g, c)
    else if k == "match"
        // цепочка сравнений, как if / else if в C (LLVM сам сделает из неё switch)
        subj = n.kids[0]
        sv = ll_expr(g, c, subj)
        done = ll_new(g, "L")
        count i from 1 to len(n.kids) - 1
            cs = n.kids[i]
            if cs.name == "else"
                ll_block(g, c, cs.kids[1])
                if g.open
                    ll_term(g, "br label %" + done)
            else
                yes = ll_new(g, "L")
                no = ll_new(g, "L")
                each v in cs.kids[0].kids
                    vv = ll_expr(g, c, v)
                    eq = ll_new(g, "%t")
                    if ll_is_text(c, subj.ty)
                        cr = ll_new(g, "%t")
                        ll_put(g, cr + " = call i32 @strcmp(ptr " + sv + ", ptr " + vv + ")")
                        ll_put(g, eq + " = icmp eq i32 " + cr + ", 0")
                    else
                        ll_put(g, eq + " = icmp eq " + ll_ty(c, subj.ty) + " " + sv + ", " + vv)
                    nx = ll_new(g, "L")
                    ll_term(g, "br i1 " + eq + ", label %" + yes + ", label %" + nx)
                    ll_label(g, nx)
                ll_term(g, "br label %" + no)
                ll_label(g, yes)
                ll_block(g, c, cs.kids[1])
                if g.open
                    ll_term(g, "br label %" + done)
                ll_label(g, no)
        ll_label(g, done)
    else if k == "skip"
        ll_term(g, "br label %" + g.cont[len(g.cont) - 1])
    else if k == "stop"
        ll_term(g, "br label %" + g.brk[len(g.brk) - 1])
    else if k == "return" and len(g.outs) > 0 and (len(n.kids) == 0 or g.multi_out)
        ll_gives_ret(g, c)
    else if k == "return"
        if len(n.kids) == 1 and not ll_none(c, g.fn.ty)
            v = ll_as(g, c, n.kids[0], g.fn.ty)
            ll_fa_end(g)
            ll_term(g, "ret " + ll_ty(c, g.fn.ty) + " " + v)
        else
            ll_fa_end(g)
            ll_term(g, "ret void")
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "add"
        // xs.add(v): сначала значение, потом место под него (как в C)
        e = n.kids[0]
        lt = e.kids[0].ty
        pv = e.kids[1].kids[0]
        if ll_colist(c, lt) and pv.kind == "call" and pv.has_ref and pv.ref.kind == "obj"
            // pts.add(Point(...)): качества сразу в колонки, без временной строки (как в C)
            pl = ll_expr(g, c, e.kids[0])
            o = pv.ref
            pargs = "ptr " + pl
            ptys = "ptr"
            count i from 0 to len(o.kids) - 1
                ft = o.kids[i].ty
                fv = ""
                if pv.kids[i].kind == "missing"
                    fv = ll_default(g, c, ft)
                else
                    fv = ll_as(g, c, pv.kids[i].kids[0], ft)
                pargs = pargs + ", " + ll_ty(c, ft) + " " + ll_ext(c, ft) + fv
                ptys = ptys + ", " + ll_ty(c, ft) + " " + ll_ext(c, ft)
            ll_need(g, "declare void @tb_lc_push_" + o.name + "(" + ptys + ", i32)\n")
            ll_put(g, "call void @tb_lc_push_" + o.name + "(" + pargs + ", i32 " + e.line + ")")
            return
        v = ll_as(g, c, e.kids[1].kids[0], c.types[lt].elem)
        base = ll_expr(g, c, e.kids[0])
        if ll_bits(c, lt)
            ll_put(g, "call void @tb_x_badd(ptr " + base + ", i1 zeroext " + v + ")")
            return
        if ll_colist(c, lt)
            cn = ll_cneed(g, c, lt)
            ll_put(g, "call void @tb_lc_add_" + cn + "(ptr " + base + ", ptr " + ll_rpart(g, v, 0) + ", i64 " + ll_rpart(g, v, 1) + ", i32 " + e.line + ")")
            return
        p = ll_new(g, "%t")
        ll_put(g, p + " = call ptr @tb_x_grow(ptr " + base + ")")
        ll_put(g, "store " + ll_elem_ty(c, lt) + " " + v + ", ptr " + p + ll_elem_tag(c, lt))
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "clear" and ll_dict(c, n.kids[0].kids[0].ty)
        ignored = ll_expr(g, c, n.kids[0])
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "clear"
        base = ll_expr(g, c, n.kids[0].kids[0])
        ll_put(g, "call void @tb_x_lclear(ptr " + base + ", i32 " + n.kids[0].line + ")")
    else if k == "expr_stmt"
        ignored = ll_expr(g, c, n.kids[0])

// имя параметра в .ll; если с тем же именем есть выход (при нескольких выходах он — адрес %"p.x"),
// значение параметра зовётся %"a.x" и сразу кладётся по этому адресу
func ll_pname(g: LLGen, name: text)
    if g.multi_out and ll_has(g.outs, name)
        return "%\"a." + name + "\""
    return "%\"p." + name + "\""

func ll_func(c: Comp, f: Node, all: list text, decls: list text)
    g = LLGen(tmp: 0, open: true, fn: f, decls: decls, fa: "")
    params = f.kids[0]
    outs = f.kids[2].kids
    each o in outs
        g.outs.add(o.name)
    g.multi_out = len(outs) > 1
    head = "define " + ll_ext(c, f.ty) + ll_ty(c, f.ty) + " @\"" + ll_fname(f) + "\"("
    if g.multi_out
        head = "define void @\"" + ll_fname(f) + "__ll\"("
    count i from 0 to len(params.kids) - 1
        p = params.kids[i]
        if i > 0
            head = head + ", "
        if not p.is_link and ll_row(c, p.ty)
            // строка — двумя параметрами, как её раскладывает clang (ptr, i64)
            head = head + "ptr %\"p." + p.name + ".c\", i64 %\"p." + p.name + ".i\""
        else
            head = head + ll_pty(c, p) + " " + ll_pext(c, p) + ll_pname(g, p.name)
    if g.multi_out
        count i from 0 to len(outs) - 1
            if i > 0 or len(params.kids) > 0
                head = head + ", "
            if kind_of(c, outs[i].ty) == "bool"
                // bool в памяти C — байт: внутри своя ячейка i1, по адресу кладём при выходе
                head = head + "ptr %\"b." + outs[i].name + "\""
            else
                head = head + "ptr %\"p." + outs[i].name + "\""
                g.links.add(outs[i].name)
    head = head + ") #0 {\n"
    each p in params.kids
        if p.is_link
            g.links.add(p.name)
        else
            slot = ll_slot(g, c, p.name, p.ty)
            if ll_row(c, p.ty)
                rp = ll_pname(g, p.name)
                r0 = "%\"p." + p.name + ".r\""
                g.out.add("  " + r0 + " = insertvalue { ptr, i64 } undef, ptr %\"p." + p.name + ".c\", 0\n")
                g.out.add("  " + rp + " = insertvalue { ptr, i64 } " + r0 + ", i64 %\"p." + p.name + ".i\", 1\n")
            g.out.add("  store " + ll_ty(c, p.ty) + " " + ll_pname(g, p.name) + ", ptr " + slot + "\n")
    each o in outs
        // выход с именем параметра — та же переменная: уже лежит значение параметра.
        // Остальные выходы с самого начала — значения по умолчанию (как в C)
        if not o.is_const
            dv = ll_default(g, c, o.ty)
            ll_put(g, "store " + ll_ty(c, o.ty) + " " + dv + ", ptr " + ll_slot(g, c, o.name, o.ty))
    ll_find_blds(g, c, f)
    if func_arena_ok(c, f)
        // всё, что функция создаёт, — во временной области; отдаётся при каждом return
        g.allocas.add("  %\"fm\" = alloca [2 x i64]\n")
        g.fa = "%\"fa\""
        g.out.add("  %\"fa\" = call i32 @tb_x_fa_begin(ptr %\"fm\")\n")
    each b in g.blds
        // длина своей памяти (-1: своей нет) и сколько там места
        g.allocas.add("  " + ll_rl(g, b) + " = alloca i64\n  " + ll_rc(g, b) + " = alloca i64\n")
        g.out.add("  store i64 -1, ptr " + ll_rl(g, b) + "\n  store i64 0, ptr " + ll_rc(g, b) + "\n")
    ll_block(g, c, f.kids[1])
    if g.open
        if len(outs) > 0
            ll_gives_ret(g, c)
        else if ll_none(c, f.ty)
            ll_fa_end(g)
            ll_term(g, "ret void")
        else
            // как в C: «функция имя дошла до конца без return»
            nm = "@\"tb.nm." + ll_fname(f) + "\""
            all.add(nm + " = private unnamed_addr constant [" + (len(f.name) + 1) + " x i8] c\"" + f.name + "\\00\"\n")
            ll_put(g, "call void @tb_ll_noreturn(i32 " + f.line + ", ptr " + nm + ")")
            ll_term(g, "unreachable")
    all.add(head)
    all.add("entry:\n")
    each a in g.allocas
        all.add(a)
    each s in g.out
        all.add(s)
    all.add("}\n\n")

// весь файл .ll: функции из c.ll_names
// target: строки «target datalayout / triple» от clang этой машины;
// cpu: его настройки процессора ("target-cpu"=... и т.д.), без них LLVM собирает под самый старый x86
modpub func emit_ll(c: Comp, program: Node, target: text, cpu: text)
    all = list text
    all.add("; Сделано компилятором Tachbit (--llvm). Не правь руками: правь файл .tb\n")
    all.add(target)
    // какие функции ушли в LLVM, какие остались в C
    in_ll = list text
    in_c = list text
    each top in program.kids
        if top.kind == "func"
            if ll_has(c.ll_names, ll_fname(top))
                in_ll.add(top.name)
            else if not ll_head_ok(c, top)
                in_c.add(top.name + " (вид)")
            else
                in_c.add(top.name + " (строка " + ll_why(c, top.kids[1], c.ll_names) + ")")
    all.add("; в LLVM (" + len(in_ll) + "): " + join(in_ll, ", ") + "\n")
    all.add("; через C (" + len(in_c) + "): " + join(in_c, ", ") + "\n")
    ll_obj_types(c, program, all)
    all.add("declare void @tb_ll_crash(i32, i32) noreturn cold\n")
    all.add("declare void @tb_ll_noreturn(i32, ptr) noreturn cold\n")
    // функции, которые остались в C, но их зовут отсюда
    each top in program.kids
        if top.kind == "func" and ll_has(c.ll_ext, ll_fname(top))
            ps = ""
            each p in top.kids[0].kids
                if ps != ""
                    ps = ps + ", "
                ps = ps + ll_pty(c, p) + " " + ll_pext(c, p)
            if len(top.kids[2].kids) > 1
                each o in top.kids[2].kids
                    if ps != ""
                        ps = ps + ", "
                    ps = ps + "ptr"
                all.add("declare void @\"" + ll_fname(top) + "__ll\"(" + ps + ")\n")
            else
                all.add("declare " + ll_ext(c, top.ty) + ll_ty(c, top.ty) + " @\"" + ll_fname(top) + "\"(" + ps + ")\n")
    // библиотека Tachbit (runtime.h): с TB_LL её функции видны отсюда
    all.add("declare void @tb_x_ps(ptr)\ndeclare ptr @tb_x_itos(i64)\ndeclare ptr @tb_x_dtos(double)\ndeclare ptr @tb_x_btos(i32)\n")
    all.add("declare ptr @tb_x_digits(i64, ptr, ptr)\ndeclare ptr @tb_x_mem_np(i64)\ndeclare i64 @tb_x_tlen(ptr)\ndeclare ptr @tb_x_char_at(ptr, i64, i64, i32)\n")
    all.add("declare ptr @tb_x_cat(ptr, ptr)\ndeclare void @tb_x_app(ptr, ptr, ptr, ptr)\ndeclare void @tb_x_app_i(ptr, ptr, ptr, i64)\ndeclare void @tb_x_app_n(ptr, ptr, ptr, ptr, i64)\n")
    all.add("declare ptr @tb_x_errp()\ndeclare void @tb_x_die(ptr) noreturn cold\n")
    all.add("declare ptr @tb_x_grow(ptr)\ndeclare zeroext i1 @tb_x_bget(ptr, i64, i32)\ndeclare void @tb_x_bset(ptr, i64, i1 zeroext, i32)\ndeclare void @tb_x_badd(ptr, i1 zeroext)\ndeclare zeroext i1 @tb_x_bpop(ptr, i32)\ndeclare ptr @tb_x_bits_new()\ndeclare ptr @tb_x_bits_from(i64, ptr)\ndeclare ptr @tb_x_pop(ptr, i32)\ndeclare void @tb_x_lclear(ptr, i32)\ndeclare ptr @tb_x_list_new_np(i64)\ndeclare ptr @tb_x_list_from_np(i64, i64, ptr)\ndeclare ptr @tb_x_dict_new(i32, i64)\ndeclare ptr @tb_x_dict_from(i32, i64, i64, ptr, ptr)\ndeclare ptr @tb_x_dget(ptr, ptr, i32)\ndeclare ptr @tb_x_dput(ptr, ptr, ptr)\ndeclare i32 @tb_x_dhas(ptr, ptr)\ndeclare void @tb_x_dremove(ptr, ptr)\ndeclare void @tb_x_dclear(ptr, i32)\ndeclare i64 @tb_x_dlen(ptr)\ndeclare ptr @tb_x_dkeys_copy(ptr)\ndeclare ptr @tb_x_dvals_copy(ptr)\ndeclare ptr @tb_x_list_new(i64)\ndeclare ptr @tb_x_list_from(i64, i64, ptr)\n")
    all.add("declare void @tb_x_temp_begin_p(ptr)\ndeclare ptr @tb_x_bits_of_bytes(ptr)\ndeclare void @tb_x_app_take(ptr, ptr, ptr, ptr, i64, i64)\ndeclare i64 @tb_x_dpre1(ptr, ptr)\ndeclare void @tb_x_dpre2(ptr, i64)\ndeclare void @tb_x_lpre(ptr, i64)\ndeclare i64 @tb_x_lock_take(ptr)\ndeclare void @tb_x_lock_give(ptr, i64)\ndeclare ptr @tb_x_chan_new(i64, i32)\ndeclare void @tb_x_chan_send(ptr, ptr, i32)\ndeclare i32 @tb_x_chan_take(ptr, ptr)\ndeclare void @tb_x_chan_close(ptr)\ndeclare void @tb_x_par_run(ptr, ptr, i64)\ndeclare i64 @tb_x_par_step(i64)\ndeclare void @tb_x_par_lock()\ndeclare void @tb_x_par_unlock()\ndeclare void @tb_x_temp_end_p(ptr)\ndeclare i32 @tb_x_fa_begin(ptr)\ndeclare void @tb_x_fa_end(i32, ptr)\n")
    all.add("declare i64 @strlen(ptr)\ndeclare i32 @strcmp(ptr, ptr)\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n")
    all.add("\n")
    decls = list text
    each top in program.kids
        if top.kind == "func" and ll_has(c.ll_names, ll_fname(top))
            ll_func(c, top, all, decls)
    // без clang: показ, конструкторы, shared и main — тоже здесь
    own = list text
    if c.ll_pure
        own = ll_glue(c, program, decls, all)
    each d in decls
        if not (c.ll_pure and ll_glue_own(d, own))
            all.add(d)
    all.add("attributes #0 = { nounwind" + cpu + " }\n")
    all.add("!0 = !{!\"branch_weights\", i32 1, i32 2000}\n")
    all.add("!1 = !{!\"tachbit\"}\n!2 = !{!\"tb.list\", !1, i64 0}\n!3 = !{!\"tb.int\", !1, i64 0}\n!4 = !{!\"tb.dec\", !1, i64 0}\n!5 = !{!\"tb.ptr\", !1, i64 0}\n")
    all.add("!10 = !{!2, !2, i64 0}\n!11 = !{!3, !3, i64 0}\n!12 = !{!4, !4, i64 0}\n!13 = !{!5, !5, i64 0}\n")
    return join(all, "")

// как clang этой машины пишет функцию: берём из его вывода цель и настройки процессора
// (только пары "ключ"="значение" и uwtable/ssp — без пометок про саму пробную функцию)
modpub func ll_probe_parse(src: text) gives target: text, cpu: text
    each line in split(src, "\n")
        if starts_with(line, "target datalayout") or starts_with(line, "target triple")
            target = target + line + "\n"
        else if starts_with(line, "attributes #0 = {") and cpu == ""
            each w in split(line, " ")
                if starts_with(w, "\"") or w == "uwtable" or w == "ssp"
                    cpu = cpu + " " + w

// ---------- вся программа в .ll (без clang) ----------
// Обычно .ll — только функции, а показ значений, конструкторы obj, shared и main пишет C.
// Если всё это можно сказать на LLVM, clang не нужен: llvm-link склеивает .ll с готовой
// библиотекой (.bc), opt оптимизирует, llc делает машинный код.

// можно ли собрать программу целиком в .ll
modpub func ll_pure_ok(c: Comp, program: Node) gives ok: bool
    why = ll_pure_why(c, program)
    if why != "" and env("TB_PURE_WHY") != ""
        print("через clang: " + why)
    ok = why == ""

func ll_pure_why(c: Comp, program: Node) gives why: text
    if c.bare
        return "ядро"
    each top in program.kids
        if top.kind == "func" and not ll_has(c.ll_names, ll_fname(top))
            return "функция в C: " + top.name
    each t in c.types
        if t.kind == "obj" and not ll_plainobj(c, t.id) and not ll_row(c, t.id)
            return "obj: " + t.obj_name
    each n in c.ll_bi
        if n.kind == "background"
            each p in n.kids[0].ref.kids[0].kids
                if p.is_link or ll_row(c, p.ty)
                    return "background с link или строкой by columns"
            if len(n.kids[0].ref.kids[2].kids) > 1
                return "background у функции с несколькими выходами"
            skip
        if n.kind != "call"
            skip
        xn, xp = ll_xb(c, n)
        if xn == "" or len(xp) != len(ll_bi_args(n))
            return "встроенная: " + n.name

// своё LLGen для кусков уровня файла (show, конструкторы, main)
func ll_glue_gen(c: Comp, decls: list text, name: text)
    f = Node(kind: "func", name: name, mod: "tb")
    return LLGen(tmp: 0, open: true, fn: f, decls: decls, fa: "")

// текст функции из LLGen: шапка, ячейки, тело
func ll_glue_fn(g: LLGen, head: text, all: list text)
    all.add(head + " {\nentry:\n")
    each a in g.allocas
        all.add(a)
    each l in g.out
        all.add(l)
    all.add("}\n")

// значение из памяти: bool лежит байтом
func ll_glue_load(g: LLGen, c: Comp, t: int, p: text)
    v = ll_new(g, "%t")
    if kind_of(c, t) == "bool"
        ll_put(g, v + " = load i8, ptr " + p)
        b = ll_new(g, "%t")
        ll_put(g, b + " = trunc i8 " + v + " to i1")
        return b
    ll_put(g, v + " = load " + ll_ty(c, t) + ", ptr " + p)
    return v

func ll_glue_ps(g: LLGen, s: text)
    nm, n = ll_strconst(g, "\"" + s + "\"")
    ll_put(g, "call void @tb_x_ps(ptr " + nm + ")")

func ll_glue_show_call(g: LLGen, c: Comp, t: int, v: text)
    ll_put(g, "call void @tb_show_" + t + "(" + ll_ty(c, t) + " " + ll_ext(c, t) + v + ")")

// адрес качества obj по адресу самого obj (горячие — прямо в obj, холодные — через tb_cold)
func ll_glue_fptr(g: LLGen, o: Node, base: text, name: text)
    hot = 0
    cold = 0
    hot_at = -1
    cold_at = -1
    each f in o.kids
        if f.is_cold
            if f.name == name
                cold_at = cold
            cold += 1
        else
            if f.name == name
                hot_at = hot
            hot += 1
    fp = ll_new(g, "%t")
    if hot_at >= 0
        ll_put(g, fp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr " + base + ", i32 0, i32 " + hot_at)
        return fp
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr " + base + ", i32 0, i32 " + hot)
    cb = ll_new(g, "%t")
    ll_put(g, cb + " = load ptr, ptr " + cp)
    ll_put(g, fp + " = getelementptr inbounds %\"tb_c_" + o.name + "\", ptr " + cb + ", i32 0, i32 " + cold_at)
    return fp

// цикл по элементам списка/dict: для i от 0 до len-1 (len читается из list по адресу lp)
// возвращает (номер, метка тела, метка выхода); тело пишет вызывающий и зовёт ll_glue_next
func ll_glue_loop(g: LLGen, lst: text) gives i: text, done: text
    lp = ll_new(g, "%t")
    ll_put(g, lp + " = getelementptr inbounds i8, ptr " + lst + ", i64 8")
    n = ll_new(g, "%t")
    ll_put(g, n + " = load i64, ptr " + lp)
    is = "%\"i" + ll_new(g, "") + "\""
    g.allocas.add("  " + is + " = alloca i64\n")
    ll_put(g, "store i64 0, ptr " + is)
    head = ll_new(g, "L")
    body = ll_new(g, "L")
    done = ll_new(g, "L")
    ll_term(g, "br label %" + head)
    ll_label(g, head)
    i = ll_new(g, "%t")
    ll_put(g, i + " = load i64, ptr " + is)
    lt = ll_new(g, "%t")
    ll_put(g, lt + " = icmp slt i64 " + i + ", " + n)
    ll_term(g, "br i1 " + lt + ", label %" + body + ", label %" + done)
    ll_label(g, body)
    // ", " перед всеми, кроме первого
    z = ll_new(g, "%t")
    ll_put(g, z + " = icmp eq i64 " + i + ", 0")
    sep = ll_new(g, "L")
    go = ll_new(g, "L")
    ll_term(g, "br i1 " + z + ", label %" + go + ", label %" + sep)
    ll_label(g, sep)
    ll_glue_ps(g, ", ")
    ll_term(g, "br label %" + go)
    ll_label(g, go)
    // слот номера: вызывающий в конце тела зовёт ll_glue_next(g, is, i, head)
    g.cont.add(is)
    g.cont.add(head)

func ll_glue_next(g: LLGen, i: text, done: text)
    head = g.cont[len(g.cont) - 1]
    is = g.cont[len(g.cont) - 2]
    p1 = g.cont.pop()
    p2 = g.cont.pop()
    i2 = ll_new(g, "%t")
    ll_put(g, i2 + " = add i64 " + i + ", 1")
    ll_put(g, "store i64 " + i2 + ", ptr " + is)
    ll_term(g, "br label %" + head)
    ll_label(g, done)

// элемент i списка lst с элементами типа t (bool — биты)
func ll_glue_elem(g: LLGen, c: Comp, lst: text, t: int, i: text)
    if kind_of(c, t) == "bool"
        v = ll_new(g, "%t")
        ll_put(g, v + " = call zeroext i1 @tb_x_bget(ptr " + lst + ", i64 " + i + ", i32 0)")
        return v
    d = ll_new(g, "%t")
    ll_put(g, d + " = load ptr, ptr " + lst)
    ep = ll_new(g, "%t")
    ll_put(g, ep + " = getelementptr inbounds " + ll_ty(c, t) + ", ptr " + d + ", i64 " + i)
    return ll_glue_load(g, c, t, ep)

// tb_show_N: печать значения типа N (то же, что emit_show пишет на C)
func ll_glue_show(c: Comp, t: Type, decls: list text, all: list text)
    k = t.kind
    if k == "none" or k == "multi" or k == "unknown"
        return
    g = ll_glue_gen(c, decls, "show" + t.id)
    x = "%x"
    if k == "task"
        ll_glue_ps(g, "<background>")
    else if k == "channel"
        ll_glue_ps(g, "<channel>")
    else if k == "enum"
        names = t.obj_node.kids
        count i from 0 to len(names) - 1
            z = ll_new(g, "%t")
            ll_put(g, z + " = icmp eq i64 %x, " + i)
            yes = ll_new(g, "L")
            no = ll_new(g, "L")
            ll_term(g, "br i1 " + z + ", label %" + yes + ", label %" + no)
            ll_label(g, yes)
            ll_glue_ps(g, names[i].name)
            ll_term(g, "ret void")
            ll_label(g, no)
    else if k == "int"
        ll_put(g, "call void @tb_x_show_i(i64 %x)")
    else if k == "dec"
        ll_put(g, "call void @tb_x_show_d(double %x)")
    else if k == "bool"
        yes = ll_new(g, "L")
        no = ll_new(g, "L")
        ll_term(g, "br i1 %x, label %" + yes + ", label %" + no)
        ll_label(g, yes)
        ll_glue_ps(g, "true")
        ll_term(g, "ret void")
        ll_label(g, no)
        ll_glue_ps(g, "false")
    else if k == "text"
        ll_put(g, "call void @tb_x_ps(ptr %x)")
    else if k == "list" and ll_colist(c, t.id)
        // список obj by columns: длина — первым словом, элемент — строка {список, номер}
        ll_glue_ps(g, "[")
        n0 = ll_new(g, "%t")
        ll_put(g, n0 + " = load i64, ptr %x")
        is = "%\"ci\""
        g.allocas.add("  " + is + " = alloca i64\n")
        ll_put(g, "store i64 0, ptr " + is)
        head = ll_new(g, "L")
        body = ll_new(g, "L")
        done = ll_new(g, "L")
        ll_term(g, "br label %" + head)
        ll_label(g, head)
        i = ll_new(g, "%t")
        ll_put(g, i + " = load i64, ptr " + is)
        lt = ll_new(g, "%t")
        ll_put(g, lt + " = icmp slt i64 " + i + ", " + n0)
        ll_term(g, "br i1 " + lt + ", label %" + body + ", label %" + done)
        ll_label(g, body)
        z = ll_new(g, "%t")
        ll_put(g, z + " = icmp eq i64 " + i + ", 0")
        sep = ll_new(g, "L")
        go = ll_new(g, "L")
        ll_term(g, "br i1 " + z + ", label %" + go + ", label %" + sep)
        ll_label(g, sep)
        ll_glue_ps(g, ", ")
        ll_term(g, "br label %" + go)
        ll_label(g, go)
        r0 = ll_new(g, "%t")
        ll_put(g, r0 + " = insertvalue { ptr, i64 } undef, ptr %x, 0")
        r1 = ll_new(g, "%t")
        ll_put(g, r1 + " = insertvalue { ptr, i64 } " + r0 + ", i64 " + i + ", 1")
        ll_put(g, "call void @tb_show_" + t.elem + "({ ptr, i64 } " + r1 + ")")
        i2 = ll_new(g, "%t")
        ll_put(g, i2 + " = add i64 " + i + ", 1")
        ll_put(g, "store i64 " + i2 + ", ptr " + is)
        ll_term(g, "br label %" + head)
        ll_label(g, done)
        ll_glue_ps(g, "]")
    else if k == "obj" and ll_row(c, t.id)
        o = t.obj_node
        rc = ll_new(g, "%t")
        ll_put(g, rc + " = extractvalue { ptr, i64 } %x, 0")
        ri = ll_new(g, "%t")
        ll_put(g, ri + " = extractvalue { ptr, i64 } %x, 1")
        z = ll_new(g, "%t")
        ll_put(g, z + " = icmp eq ptr " + rc + ", null")
        yes = ll_new(g, "L")
        no = ll_new(g, "L")
        ll_term(g, "br i1 " + z + ", label %" + yes + ", label %" + no)
        ll_label(g, yes)
        ll_glue_ps(g, "пусто")
        ll_term(g, "ret void")
        ll_label(g, no)
        ll_glue_ps(g, o.name + "(")
        count fi from 0 to len(o.kids) - 1
            sep = ""
            if fi > 0
                sep = ", "
            ll_glue_ps(g, sep + o.kids[fi].name + ": ")
            fp = ll_glue_colf(g, c, o, rc, ri, fi)
            fv = ll_glue_load(g, c, o.kids[fi].ty, fp)
            ll_glue_show_call(g, c, o.kids[fi].ty, fv)
        ll_glue_ps(g, ")")
    else if k == "list"
        ll_glue_ps(g, "[")
        i, done = ll_glue_loop(g, x)
        v = ll_glue_elem(g, c, x, t.elem, i)
        ll_glue_show_call(g, c, t.elem, v)
        ll_glue_next(g, i, done)
        ll_glue_ps(g, "]")
    else if k == "dict"
        ll_glue_ps(g, "{")
        kl = ll_new(g, "%t")
        ll_put(g, kl + " = load ptr, ptr %x")
        vp = ll_new(g, "%t")
        ll_put(g, vp + " = getelementptr inbounds i8, ptr %x, i64 8")
        vl = ll_new(g, "%t")
        ll_put(g, vl + " = load ptr, ptr " + vp)
        i, done = ll_glue_loop(g, kl)
        kv = ll_glue_elem(g, c, kl, t.key, i)
        ll_glue_show_call(g, c, t.key, kv)
        ll_glue_ps(g, ": ")
        // значения dict: bool — байтом (не битами, как в list bool)
        d = ll_new(g, "%t")
        ll_put(g, d + " = load ptr, ptr " + vl)
        ep = ll_new(g, "%t")
        ll_put(g, ep + " = getelementptr inbounds " + ll_mem_ty(c, t.elem) + ", ptr " + d + ", i64 " + i)
        vv = ll_glue_load(g, c, t.elem, ep)
        ll_glue_show_call(g, c, t.elem, vv)
        ll_glue_next(g, i, done)
        ll_glue_ps(g, "}")
    else if k == "obj"
        o = t.obj_node
        z = ll_new(g, "%t")
        ll_put(g, z + " = icmp eq ptr %x, null")
        yes = ll_new(g, "L")
        no = ll_new(g, "L")
        ll_term(g, "br i1 " + z + ", label %" + yes + ", label %" + no)
        ll_label(g, yes)
        ll_glue_ps(g, "пусто")
        ll_term(g, "ret void")
        ll_label(g, no)
        ll_glue_ps(g, o.name + "(")
        count i from 0 to len(o.kids) - 1
            sep = ""
            if i > 0
                sep = ", "
            ll_glue_ps(g, sep + o.kids[i].name + ": ")
            fp = ll_glue_fptr(g, o, "%x", o.kids[i].name)
            fv = ll_glue_load(g, c, o.kids[i].ty, fp)
            ll_glue_show_call(g, c, o.kids[i].ty, fv)
        ll_glue_ps(g, ")")
    ll_term(g, "ret void")
    ll_glue_fn(g, "define internal void @tb_show_" + t.id + "(" + ll_ty(c, t.id) + " " + ll_ext(c, t.id) + "%x) #0", all)

// tb_new_X: новый obj, качества по порядку (то же, что emit_constructor пишет на C)
func ll_glue_new(c: Comp, o: Node, decls: list text, all: list text)
    g = ll_glue_gen(c, decls, "new" + o.name)
    head = "define internal ptr @tb_new_" + o.name + "("
    cold = false
    plain = true
    cold_plain = true
    count i from 0 to len(o.kids) - 1
        f = o.kids[i]
        if i > 0
            head = head + ", "
        head = head + ll_ty(c, f.ty) + " " + ll_ext(c, f.ty) + "%a" + i
        if f.is_cold
            cold = true
            if not is_plain_ty(c, f.ty)
                cold_plain = false
        if not is_plain_ty(c, f.ty)
            plain = false
    if cold
        plain = false
    sp = ll_new(g, "%t")
    ll_put(g, sp + " = getelementptr %\"tb_o_" + o.name + "\", ptr null, i32 1")
    sz = ll_new(g, "%t")
    ll_put(g, sz + " = ptrtoint ptr " + sp + " to i64")
    mem = "tb_x_obj_mem"
    if plain
        mem = "tb_x_obj_mem_np"
    ll_put(g, "%o = call ptr @" + mem + "(i64 " + sz + ")")
    if cold
        hot = 0
        each f in o.kids
            if not f.is_cold
                hot += 1
        csp = ll_new(g, "%t")
        ll_put(g, csp + " = getelementptr %\"tb_c_" + o.name + "\", ptr null, i32 1")
        csz = ll_new(g, "%t")
        ll_put(g, csz + " = ptrtoint ptr " + csp + " to i64")
        cmem = "tb_x_cold_mem"
        if cold_plain
            cmem = "tb_x_cold_mem_np"
        cb = ll_new(g, "%t")
        ll_put(g, cb + " = call ptr @" + cmem + "(i64 " + csz + ")")
        cp = ll_new(g, "%t")
        ll_put(g, cp + " = getelementptr inbounds %\"tb_o_" + o.name + "\", ptr %o, i32 0, i32 " + hot)
        ll_put(g, "store ptr " + cb + ", ptr " + cp)
    count i from 0 to len(o.kids) - 1
        f = o.kids[i]
        fp = ll_glue_fptr(g, o, "%o", f.name)
        if kind_of(c, f.ty) == "bool"
            b = ll_new(g, "%t")
            ll_put(g, b + " = zext i1 %a" + i + " to i8")
            ll_put(g, "store i8 " + b + ", ptr " + fp)
        else
            ll_put(g, "store " + ll_ty(c, f.ty) + " %a" + i + ", ptr " + fp)
    ll_term(g, "ret ptr %o")
    ll_glue_fn(g, head + ") #0", all)

// shared, замки и main: начало программы (то же, что main в C)
func ll_glue_main(c: Comp, program: Node, decls: list text, all: list text)
    each gl in c.globals
        all.add("@\"v_" + gl.name + "\" = hidden global " + ll_mem_ty(c, gl.ty) + " zeroinitializer\n")
    each l in c.locks
        all.add("@\"tb_lk_" + l + "\" = hidden global i32 0\n")
    g = ll_glue_gen(c, decls, "main")
    ll_put(g, "%top = alloca i8")
    ll_put(g, "call void @tb_x_start(i32 %argc, ptr %argv, ptr %top)")
    // shared: уборка памяти смотрит в них; значение — как в C до main
    each gl in c.globals
        gs = "@\"v_" + gl.name + "\""
        ll_put(g, "call void @tb_x_gc_root(ptr " + gs + ", i64 " + ll_size(c, gl.ty) + ")")
        v = ll_as(g, c, gl.kids[0], gl.ty)
        ll_put(g, "store " + ll_ty(c, gl.ty) + " " + v + ", ptr " + gs)
    main_func = program.kids[0]
    each top in program.kids
        if top.kind == "func" and top.name == "main" and top.mod == program.kids[0].mod
            main_func = top
    ll_put(g, "call void @tb_x_call_main(ptr @\"" + ll_fname(main_func) + "\")")
    ll_term(g, "ret i32 0")
    ll_glue_fn(g, "define i32 @main(i32 %argc, ptr %argv) #0", all)

// всё вместе: эти имена определены здесь, их объявления (declare) не нужны
func ll_glue(c: Comp, program: Node, decls: list text, all: list text) gives own: list text
    each t in c.types
        if not (t.kind == "none" or t.kind == "multi" or t.kind == "unknown")
            ll_glue_show(c, t, decls, all)
            own.add("tb_show_" + t.id)
    each top in program.kids
        if top.kind == "obj" and top.by_cols
            ll_glue_cols(c, top, decls, all)
            each h in ["new", "add", "set", "from", "make", "push"]
                own.add("tb_lc_" + h + "_" + top.name)
        else if top.kind == "obj"
            ll_glue_new(c, top, decls, all)
            own.add("tb_new_" + top.name)
    each t in c.types
        if t.kind == "obj" and ll_row(c, t.id)
            all.add("define internal void @tb_lc_show_" + t.id + "(ptr %r) #0 {\nentry:\n  %v = load { ptr, i64 }, ptr %r\n  call void @tb_show_" + t.id + "({ ptr, i64 } %v)\n  ret void\n}\n")
            own.add("tb_lc_show_" + t.id)
    ll_glue_main(c, program, decls, all)
    each gl in c.globals
        own.add("\"v_" + gl.name + "\"")
    each l in c.locks
        own.add("\"tb_lk_" + l + "\"")
    all.add("declare void @tb_x_show_i(i64)\ndeclare void @tb_x_show_d(double)\ndeclare ptr @tb_x_obj_mem(i64)\ndeclare ptr @tb_x_obj_mem_np(i64)\ndeclare ptr @tb_x_cold_mem(i64)\ndeclare ptr @tb_x_cold_mem_np(i64)\n")
    all.add("declare void @tb_x_start(i32, ptr, ptr)\ndeclare void @tb_x_gc_root(ptr, i64)\ndeclare void @tb_x_call_main(ptr)\ndeclare ptr @tb_x_mem(i64)\ndeclare ptr @tb_x_resize(ptr, i64, i64)\n")

// объявление (declare @имя / @имя = external) того, что уже определено в этом файле
func ll_glue_own(line: text, own: list text)
    each o in own
        if find(line, "@" + o + "(") >= 0 and starts_with(line, "declare")
            return true
        if starts_with(line, "@" + o + " = external")
            return true
    return false

// a = background f(x, y): коробка задачи { tb_task, ответ, x, y } в памяти с уборкой;
// поток tb.bg.N берёт из неё аргументы, зовёт f и кладёт ответ туда же (как tb_bgN в C)
func ll_bg(g: LLGen, c: Comp, n: Node)
    call = n.kids[0]
    f = call.ref
    params = f.kids[0].kids
    rt = f.ty
    has_r = not ll_none(c, rt)
    ty = "{ { ptr, i32, ptr }"
    if has_r
        ty = ty + ", " + ll_mem_ty(c, rt)
    else
        ty = ty + ", i8"
    each p in params
        ty = ty + ", " + ll_mem_ty(c, p.ty)
    ty = ty + " }"
    g.tmp += 1
    id = ll_fname(g.fn) + "." + g.tmp
    run = "@\"tb.bg." + id + "\""
    // поток: аргументы из коробки → f → ответ в коробку
    w = ll_glue_gen(c, g.decls, "bg")
    args = ""
    count i from 0 to len(params) - 1
        ap = ll_new(w, "%t")
        ll_put(w, ap + " = getelementptr inbounds " + ty + ", ptr %j, i32 0, i32 " + (i + 2))
        av = ll_glue_load(w, c, params[i].ty, ap)
        if i > 0
            args = args + ", "
        args = args + ll_ty(c, params[i].ty) + " " + ll_ext(c, params[i].ty) + av
    callee = "@\"" + ll_fname(f) + "\"(" + args + ")"
    if has_r
        rv = ll_new(w, "%t")
        ll_put(w, rv + " = call " + ll_ext(c, rt) + ll_ty(c, rt) + " " + callee)
        rp = ll_new(w, "%t")
        ll_put(w, rp + " = getelementptr inbounds " + ty + ", ptr %j, i32 0, i32 1")
        if kind_of(c, rt) == "bool"
            rb = ll_new(w, "%t")
            ll_put(w, rb + " = zext i1 " + rv + " to i8")
            ll_put(w, "store i8 " + rb + ", ptr " + rp)
        else
            ll_put(w, "store " + ll_ty(c, rt) + " " + rv + ", ptr " + rp)
    else
        ll_put(w, "call void " + callee)
    ll_term(w, "ret ptr null")
    fn_text = list text
    ll_glue_fn(w, "define internal ptr " + run + "(ptr %j) #0", fn_text)
    g.decls.add(join(fn_text, ""))
    // здесь: коробка, аргументы, запуск потока
    sp = ll_new(g, "%t")
    ll_put(g, sp + " = getelementptr " + ty + ", ptr null, i32 1")
    sz = ll_new(g, "%t")
    ll_put(g, sz + " = ptrtoint ptr " + sp + " to i64")
    j = ll_new(g, "%t")
    ll_put(g, j + " = call ptr @tb_x_gc_alloc(i64 " + sz + ")")
    count i from 0 to len(params) - 1
        v = ll_as(g, c, call.kids[i].kids[0], params[i].ty)
        ap = ll_new(g, "%t")
        ll_put(g, ap + " = getelementptr inbounds " + ty + ", ptr " + j + ", i32 0, i32 " + (i + 2))
        if kind_of(c, params[i].ty) == "bool"
            vb = ll_new(g, "%t")
            ll_put(g, vb + " = zext i1 " + v + " to i8")
            ll_put(g, "store i8 " + vb + ", ptr " + ap)
        else
            ll_put(g, "store " + ll_ty(c, params[i].ty) + " " + v + ", ptr " + ap)
    resp = ll_new(g, "%t")
    ll_put(g, resp + " = getelementptr inbounds { ptr, i32, ptr }, ptr " + j + ", i32 0, i32 2")
    if has_r
        rslot = ll_new(g, "%t")
        ll_put(g, rslot + " = getelementptr inbounds " + ty + ", ptr " + j + ", i32 0, i32 1")
        ll_put(g, "store ptr " + rslot + ", ptr " + resp)
    else
        ll_put(g, "store ptr null, ptr " + resp)
    ll_need(g, "declare ptr @tb_x_gc_alloc(i64)\n")
    ll_need(g, "declare void @tb_x_task_start(ptr, ptr, ptr)\n")
    ll_put(g, "call void @tb_x_task_start(ptr " + j + ", ptr " + run + ", ptr " + j + ")")
    return j

// t.wait: дождаться потока; ответ — по адресу из задачи
func ll_wait(g: LLGen, c: Comp, n: Node)
    t = ll_expr(g, c, n.kids[0])
    ll_need(g, "declare ptr @tb_x_wait(ptr)\n")
    rp = ll_new(g, "%t")
    ll_put(g, rp + " = call ptr @tb_x_wait(ptr " + t + ")")
    rt = c.types[n.kids[0].ty].elem
    if ll_none(c, rt) or ll_none(c, n.ty)
        return "0"
    return ll_glue_load(g, c, rt, rp)

// obj by columns: адрес колонки номер fi, ячейка ri
func ll_glue_colf(g: LLGen, c: Comp, o: Node, rc: text, ri: text, fi: int)
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds i8, ptr " + rc + ", i64 " + (16 + 8 * fi))
    col = ll_new(g, "%t")
    ll_put(g, col + " = load ptr, ptr " + cp)
    ep = ll_new(g, "%t")
    ll_put(g, ep + " = getelementptr inbounds " + ll_mem_ty(c, o.kids[fi].ty) + ", ptr " + col + ", i64 " + ri)
    return ep

// положить значение v (тип t) в память p: bool — байтом
func ll_glue_store(g: LLGen, c: Comp, t: int, v: text, p: text)
    if kind_of(c, t) == "bool"
        b = ll_new(g, "%t")
        ll_put(g, b + " = zext i1 " + v + " to i8")
        ll_put(g, "store i8 " + b + ", ptr " + p)
        return
    ll_put(g, "store " + ll_ty(c, t) + " " + v + ", ptr " + p)

func ll_glue_nn(g: LLGen, p: text, line: text, what: int)
    z = ll_new(g, "%t")
    ll_put(g, z + " = icmp eq ptr " + p + ", null")
    no = ll_new(g, "L")
    ok = ll_new(g, "L")
    ll_term(g, "br i1 " + z + ", label %" + no + ", label %" + ok + ", !prof !0")
    ll_label(g, no)
    ll_put(g, "call void @tb_ll_crash(i32 " + line + ", i32 " + what + ")")
    ll_term(g, "unreachable")
    ll_label(g, ok)

func ll_glue_es(c: Comp, t: int)
    if kind_of(c, t) == "bool"
        return 1
    return 8

// помощники obj by columns (то же, что emit_cols_helpers пишет на C):
// {len, cap, колонки...}; новый список на 4, рост вдвое, add/set/push/из строк/одна строка
func ll_glue_cols(c: Comp, o: Node, decls: list text, all: list text)
    nm = o.name
    nf = len(o.kids)
    // новый пустой список колонок
    g = ll_glue_gen(c, decls, "cn" + nm)
    ll_put(g, "%l = call ptr @tb_x_mem(i64 " + (16 + 8 * nf) + ")")
    ll_put(g, "store i64 0, ptr %l")
    cp = ll_new(g, "%t")
    ll_put(g, cp + " = getelementptr inbounds i8, ptr %l, i64 8")
    ll_put(g, "store i64 4, ptr " + cp)
    count fi from 0 to nf - 1
        ft = o.kids[fi].ty
        mem = "tb_x_mem"
        if is_plain_ty(c, ft)
            mem = "tb_x_mem_np"
        col = ll_new(g, "%t")
        ll_put(g, col + " = call ptr @" + mem + "(i64 " + (4 * ll_glue_es(c, ft)) + ")")
        fp = ll_new(g, "%t")
        ll_put(g, fp + " = getelementptr inbounds i8, ptr %l, i64 " + (16 + 8 * fi))
        ll_put(g, "store ptr " + col + ", ptr " + fp)
    ll_term(g, "ret ptr %l")
    ll_glue_fn(g, "define internal ptr @tb_lc_new_" + nm + "() #0", all)
    // рост: места нет — вдвое больше
    g = ll_glue_gen(c, decls, "cg" + nm)
    ll_put(g, "%n = load i64, ptr %l")
    ll_put(g, "%cp = getelementptr inbounds i8, ptr %l, i64 8")
    ll_put(g, "%cap = load i64, ptr %cp")
    ll_put(g, "%full = icmp slt i64 %n, %cap")
    ll_term(g, "br i1 %full, label %done, label %grow")
    ll_label(g, "grow")
    ll_put(g, "%cap2 = shl i64 %cap, 1")
    ll_put(g, "store i64 %cap2, ptr %cp")
    count fi from 0 to nf - 1
        es = ll_glue_es(c, o.kids[fi].ty)
        fp = ll_new(g, "%t")
        ll_put(g, fp + " = getelementptr inbounds i8, ptr %l, i64 " + (16 + 8 * fi))
        old = ll_new(g, "%t")
        ll_put(g, old + " = load ptr, ptr " + fp)
        a = ll_new(g, "%t")
        ll_put(g, a + " = mul i64 %cap, " + es)
        b = ll_new(g, "%t")
        ll_put(g, b + " = mul i64 %cap2, " + es)
        nw = ll_new(g, "%t")
        ll_put(g, nw + " = call ptr @tb_x_resize(ptr " + old + ", i64 " + a + ", i64 " + b + ")")
        ll_put(g, "store ptr " + nw + ", ptr " + fp)
    ll_term(g, "br label %done")
    ll_label(g, "done")
    ll_term(g, "ret void")
    ll_glue_fn(g, "define internal void @\"tb.colgrow." + nm + "\"(ptr %l) #0", all)
    // push: значения качеств в конец (без временной строки)
    g = ll_glue_gen(c, decls, "cp" + nm)
    head = "define internal void @tb_lc_push_" + nm + "(ptr %l"
    count fi from 0 to nf - 1
        head = head + ", " + ll_ty(c, o.kids[fi].ty) + " " + ll_ext(c, o.kids[fi].ty) + "%a" + fi
    head = head + ", i32 %line) #0"
    ll_glue_nn(g, "%l", "%line", 4)
    ll_glue_put_row(g, c, o, "%l", "%a")
    ll_term(g, "ret void")
    ll_glue_fn(g, head, all)
    // add: строка (rc, ri) копией в конец
    g = ll_glue_gen(c, decls, "ca" + nm)
    ll_glue_nn(g, "%rc", "%line", 5)
    count fi from 0 to nf - 1
        fp = ll_glue_colf(g, c, o, "%rc", "%ri", fi)
        v = ll_glue_load(g, c, o.kids[fi].ty, fp)
        ll_put(g, "%v" + fi + " = " + ll_glue_same(c, o.kids[fi].ty, v))
    ll_glue_nn(g, "%l", "%line", 4)
    ll_glue_put_row(g, c, o, "%l", "%v")
    ll_term(g, "ret void")
    ll_glue_fn(g, "define internal void @tb_lc_add_" + nm + "(ptr %l, ptr %rc, i64 %ri, i32 %line) #0", all)
    // set: l[i] = строка (rc, ri)
    g = ll_glue_gen(c, decls, "cs" + nm)
    ll_glue_nn(g, "%l", "%line", 4)
    ll_put(g, "%n = load i64, ptr %l")
    ll_put(g, "%bad = icmp uge i64 %i, %n")
    ll_term(g, "br i1 %bad, label %out, label %in, !prof !0")
    ll_label(g, "out")
    ll_put(g, "call void @tb_ll_crash(i32 %line, i32 3)")
    ll_term(g, "unreachable")
    ll_label(g, "in")
    ll_glue_nn(g, "%rc", "%line", 5)
    count fi from 0 to nf - 1
        sp = ll_glue_colf(g, c, o, "%rc", "%ri", fi)
        v = ll_glue_load(g, c, o.kids[fi].ty, sp)
        dp = ll_glue_colf(g, c, o, "%l", "%i", fi)
        ll_glue_store(g, c, o.kids[fi].ty, v, dp)
    ll_term(g, "ret void")
    ll_glue_fn(g, "define internal void @tb_lc_set_" + nm + "(ptr %l, i64 %i, ptr %rc, i64 %ri, i32 %line) #0", all)
    // make: одна новая строка — свой список из одного элемента
    g = ll_glue_gen(c, decls, "cm" + nm)
    head = "define internal ptr @tb_lc_make_" + nm + "("
    count fi from 0 to nf - 1
        if fi > 0
            head = head + ", "
        head = head + ll_ty(c, o.kids[fi].ty) + " " + ll_ext(c, o.kids[fi].ty) + "%a" + fi
    head = head + ") #0"
    ll_put(g, "%l = call ptr @tb_lc_new_" + nm + "()")
    count fi from 0 to nf - 1
        dp = ll_glue_colf(g, c, o, "%l", "0", fi)
        ll_glue_store(g, c, o.kids[fi].ty, "%a" + fi, dp)
    ll_put(g, "store i64 1, ptr %l")
    ll_term(g, "ret ptr %l")
    ll_glue_fn(g, head, all)
    // from: n строк из массива {ptr, i64}
    g = ll_glue_gen(c, decls, "cf" + nm)
    ll_put(g, "%l = call ptr @tb_lc_new_" + nm + "()")
    ll_put(g, "%is = alloca i64")
    ll_put(g, "store i64 0, ptr %is")
    ll_term(g, "br label %head")
    ll_label(g, "head")
    ll_put(g, "%i = load i64, ptr %is")
    ll_put(g, "%lt = icmp slt i64 %i, %n")
    ll_term(g, "br i1 %lt, label %body, label %done")
    ll_label(g, "body")
    ll_put(g, "%rp = getelementptr inbounds { ptr, i64 }, ptr %rows, i64 %i")
    ll_put(g, "%r = load { ptr, i64 }, ptr %rp")
    ll_put(g, "%rc = extractvalue { ptr, i64 } %r, 0")
    ll_put(g, "%ri = extractvalue { ptr, i64 } %r, 1")
    ll_put(g, "call void @tb_lc_add_" + nm + "(ptr %l, ptr %rc, i64 %ri, i32 0)")
    ll_put(g, "%i2 = add i64 %i, 1")
    ll_put(g, "store i64 %i2, ptr %is")
    ll_term(g, "br label %head")
    ll_label(g, "done")
    ll_term(g, "ret ptr %l")
    ll_glue_fn(g, "define internal ptr @tb_lc_from_" + nm + "(i64 %n, ptr %rows) #0", all)

// v как есть (для %vN = ...): LLVM не умеет «присвоить», поэтому через select true
func ll_glue_same(c: Comp, t: int, v: text)
    return "select i1 true, " + ll_ty(c, t) + " " + v + ", " + ll_ty(c, t) + " " + v

// вырастить список l и положить значения pfx0, pfx1 ... в конец
func ll_glue_put_row(g: LLGen, c: Comp, o: Node, l: text, pfx: text)
    ll_put(g, "call void @\"tb.colgrow." + o.name + "\"(ptr " + l + ")")
    n = ll_new(g, "%t")
    ll_put(g, n + " = load i64, ptr " + l)
    count fi from 0 to len(o.kids) - 1
        dp = ll_glue_colf(g, c, o, l, n, fi)
        ll_glue_store(g, c, o.kids[fi].ty, pfx + fi, dp)
    n2 = ll_new(g, "%t")
    ll_put(g, n2 + " = add i64 " + n + ", 1")
    ll_put(g, "store i64 " + n2 + ", ptr " + l)
