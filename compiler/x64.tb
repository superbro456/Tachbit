// Слой 4в. СВОЙ МАШИННЫЙ КОД x86-64 — без LLVM и без C.
// tb app --own файл.tb: компилятор сам пишет команды процессора и сам собирает файл .oapp
// (ELF64 «до компоновки», тот же, что грузит omnium/app.tb). Функции ядра (печать, тексты)
// зовутся по именам tb_x_..., их адреса подставляет загрузчик Омниума.
// Пока умеет: int, bool, текст (готовый и склеенный), shared int/bool, функции до 6 параметров
// и с одним выходом (gives), if / else if / else, repeat while, repeat N times, count, skip, stop,
// + - * / % (переполнение и деление на ноль — остановка, как везде), сравнения, and / or / not, print/show.
// Чего не умеет — говорит прямо, и тогда собирай без --own (через LLVM).
// Устройство простое: значение выражения всегда в rax, промежуточные — в стеке (push/pop),
// переменные — в кадре функции [rbp - 8k].
use types
use check
use emit_ll
use memplan

obj X64
    code: list int
    ro: list int
    bss: int
    err: text
    // имена символов: 0 — пусто, 1..3 — части .text/.rodata/.bss; дальше функции и чужие имена
    snames: list text
    sdef: list int
    // поправки: где, какой символ, вид, прибавка
    r_at: list int
    r_sym: list int
    r_type: list int
    r_add: list int
    // переменные функции и shared
    vars: list text
    gnames: list text
    goffs: list int
    // метки: где стоят (-1 — ещё нет), и прыжки, которые надо дописать
    lpos: list int
    fix_at: list int
    fix_l: list int
    cont: list int
    brk: list int
    depth: int
    in_danger: int
    // временная область функции (tb_x_fa_begin): ячейки флага и метки, -1 — нет
    fa_slot: int
    // тексты, к которым дописывают (s += x): своя память на месте, как в обычной сборке
    bld_names: list text
    // несколько выходов: ячейки, куда вызов положил выходы; в самой функции — ячейки с их адресами
    mtemps: list int
    out_ptrs: list int
    out_names: list text
    fm_slot: int
    // запись bool одним байтом (значения dict)
    byte_store: bool
    ret_l: int
    out_name: text
    fn: Node
    // типы, которым нужна своя функция печати tb_xshow_N (списки, obj, enum)
    show_need: list int
    // замки lock имя: по 8 байт в .bss; у открытого замка — ячейка с флагами прерываний
    lnames: list text
    loffs: list int
    lheld: list int

func xb(g: X64, b: int)
    g.code.add(bit_and(b, 255))

func xbs(g: X64, bs: list int)
    each b in bs
        g.code.add(b)

func x32(g: X64, v: int)
    count i from 0 to 3
        g.code.add(bit_and(shift_right(v, i * 8), 255))

func x64v(g: X64, v: int)
    count i from 0 to 7
        g.code.add(bit_and(shift_right(v, i * 8), 255))

func put32(g: X64, at: int, v: int)
    count i from 0 to 3
        g.code[at + i] = bit_and(shift_right(v, i * 8), 255)

func xfail(g: X64, line: int, what: text)
    if g.err == ""
        g.err = "строка " + line + ": свой машинный код пока не умеет " + what + " (собери без --own)"

func xsym(g: X64, name: text) gives k: int
    count i from 0 to len(g.snames) - 1
        if g.snames[i] == name
            return i
    g.snames.add(name)
    g.sdef.add(-1)
    return len(g.snames) - 1

func xreloc(g: X64, sym: int, typ: int, add: int)
    g.r_at.add(len(g.code))
    g.r_sym.add(sym)
    g.r_type.add(typ)
    g.r_add.add(add)
    x32(g, 0)

// call имя (ядро или своя функция): E8 + 4 байта, поправка PLT32
func xcall(g: X64, name: text)
    odd = g.depth % 2 == 1
    if odd
        xbs(g, [0x48, 0x83, 0xEC, 0x08])
    xb(g, 0xE8)
    xreloc(g, xsym(g, name), 4, -4)
    if odd
        xbs(g, [0x48, 0x83, 0xC4, 0x08])

func xpush(g: X64)
    xb(g, 0x50)
    g.depth += 1

// pop в rcx
func xpop_rcx(g: X64)
    xb(g, 0x59)
    g.depth -= 1

func xlabel(g: X64) gives l: int
    g.lpos.add(-1)
    return len(g.lpos) - 1

func xplace(g: X64, l: int)
    g.lpos[l] = len(g.code)

// прыжок: op — байты команды (E9 — jmp, 0F 84 — je, 0F 85 — jne ...), дальше 4 байта до метки
func xjump(g: X64, op: list int, l: int)
    xbs(g, op)
    g.fix_at.add(len(g.code))
    g.fix_l.add(l)
    x32(g, 0)

// rax = число
func xconst(g: X64, v: int)
    if v >= -2147483648 and v <= 2147483647
        xbs(g, [0x48, 0xC7, 0xC0])
        x32(g, v)
    else
        xbs(g, [0x48, 0xB8])
        x64v(g, v)

// остановка программы: tb_ll_crash(строка, что) — 19 байт, стек выравниваем сами
func xcrash(g: X64, line: int, what: int)
    xb(g, 0xBF)
    x32(g, line)
    xb(g, 0xBE)
    x32(g, what)
    xbs(g, [0x48, 0x83, 0xE4, 0xF0])
    xb(g, 0xE8)
    xreloc(g, xsym(g, "tb_ll_crash"), 4, -4)

// переменная функции: номер ячейки (новая — в конец)
func xslot(g: X64, name: text) gives k: int
    count i from 0 to len(g.vars) - 1
        if g.vars[i] == name
            return i
    g.vars.add(name)
    return len(g.vars) - 1

func xglobal(g: X64, name: text) gives k: int
    k = -1
    count i from 0 to len(g.gnames) - 1
        if g.gnames[i] == name
            k = i

// mov rax, [rbp - 8(k+1)] / mov [rbp - 8(k+1)], rax
func xload_var(g: X64, k: int)
    xbs(g, [0x48, 0x8B, 0x85])
    x32(g, -8 * (k + 1))

func xstore_var(g: X64, k: int)
    xbs(g, [0x48, 0x89, 0x85])
    x32(g, -8 * (k + 1))

// shared: mov rax, [rip + место в .bss] и обратно
func xload_global(g: X64, k: int)
    xbs(g, [0x48, 0x8B, 0x05])
    xreloc(g, 3, 2, g.goffs[k] - 4)

func xstore_global(g: X64, k: int)
    xbs(g, [0x48, 0x89, 0x05])
    xreloc(g, 3, 2, g.goffs[k] - 4)

func xload_name(g: X64, n: Node)
    gk = xglobal(g, n.name)
    if gk >= 0 and not has_var(g, n.name)
        xload_global(g, gk)
    else if has_var(g, n.name)
        xload_var(g, xslot(g, n.name))
        xbld_forget(g, n.name)
    else
        xfail(g, n.line, "переменную " + n.name)

func has_var(g: X64, name: text) gives yes: bool
    each v in g.vars
        if v == name
            return true
    return false

func xstore_name(g: X64, name: text)
    gk = xglobal(g, name)
    if gk >= 0 and not has_var(g, name)
        xstore_global(g, gk)
    else
        xstore_var(g, xslot(g, name))
        xbld_forget(g, name)

// текст из программы: байты в .rodata, rax = их адрес (lea rax, [rip + ...])
func xstring(g: X64, v: text)
    bytes, ok = ll_str_bytes(v)
    at = len(g.ro)
    each b in bytes
        g.ro.add(b)
    g.ro.add(0)
    xbs(g, [0x48, 0x8D, 0x05])
    xreloc(g, 2, 2, at - 4)

func xstring_raw(g: X64, s: text)
    xstring(g, "\"" + s + "\"")

// rax = rax op rcx
func xarith(g: X64, op: text, line: int)
    if op == "+"
        xbs(g, [0x48, 0x01, 0xC8])
    else if op == "-"
        xbs(g, [0x48, 0x29, 0xC8])
    else if op == "*"
        xbs(g, [0x48, 0x0F, 0xAF, 0xC1])
    else if op == "/" or op == "%"
        // деление на ноль — остановка; на -1 — это смена знака (MIN / -1 переполняется)
        what = 0
        if op == "%"
            what = 1
        xbs(g, [0x48, 0x85, 0xC9, 0x75, 19])
        xcrash(g, line, what)
        minus = xlabel(g)
        done = xlabel(g)
        xbs(g, [0x48, 0x83, 0xF9, 0xFF])
        xjump(g, [0x0F, 0x84], minus)
        xbs(g, [0x48, 0x99, 0x48, 0xF7, 0xF9])
        if op == "%"
            xbs(g, [0x48, 0x89, 0xD0])
        xjump(g, [0xE9], done)
        xplace(g, minus)
        if op == "%"
            xbs(g, [0x31, 0xC0])
        else
            xbs(g, [0x48, 0xF7, 0xD8, 0x71, 19])
            xcrash(g, line, 8)
        xplace(g, done)
        return
    else
        cc = 0
        if op == "=="
            cc = 0x94
        else if op == "!="
            cc = 0x95
        else if op == "<"
            cc = 0x9C
        else if op == "<="
            cc = 0x9E
        else if op == ">"
            cc = 0x9F
        else if op == ">="
            cc = 0x9D
        else
            xfail(g, line, "знак " + op)
            return
        xbs(g, [0x48, 0x39, 0xC8, 0x0F, cc, 0xC0, 0x48, 0x0F, 0xB6, 0xC0])
        return
    // + - *: переполнение int — остановка (jno мимо); внутри danger — заворачивается, как в железе
    if g.in_danger == 0
        xbs(g, [0x71, 19])
        xcrash(g, line, 8)

// значение как текст: число и да/нет — через ядро
func xas_text(g: X64, c: Comp, n: Node)
    xexpr(g, c, n)
    k = kind_of(c, n.ty)
    if k == "int"
        xmov_rdi(g)
        xcall(g, "tb_x_itos")
    else if k == "bool"
        xmov_rdi(g)
        xcall(g, "tb_x_btos")
    else if k == "dec"
        xmov_xmm0(g)
        xcall(g, "tb_x_dtos")
    else if k != "text"
        xfail(g, n.line, "такой тип в тексте")

// mov rdi, rax
func xmov_rdi(g: X64)
    xbs(g, [0x48, 0x89, 0xC7])

// ---------- дробные (dec): в rax лежат биты double, считает SSE ----------

func xmov_xmm0(g: X64)
    xbs(g, [0x66, 0x48, 0x0F, 0x6E, 0xC0])

func xmov_from_xmm0(g: X64)
    xbs(g, [0x66, 0x48, 0x0F, 0x7E, 0xC0])

// rax: int → dec (cvtsi2sd)
func xint_to_dec(g: X64)
    xbs(g, [0xF2, 0x48, 0x0F, 0x2A, 0xC0])
    xmov_from_xmm0(g)

func xas_dec(g: X64, c: Comp, n: Node)
    xexpr(g, c, n)
    if kind_of(c, n.ty) == "int"
        xint_to_dec(g)

// значение для места типа want: int в dec превращается
func xas(g: X64, c: Comp, n: Node, want: int)
    if kind_of(c, want) == "dec"
        xas_dec(g, c, n)
    else
        xexpr(g, c, n)

// 1.25 → 125 / 10^2: оба числа точные, деление округляет верно — те же биты, что у C
func xdecimal(g: X64, v: text, line: int)
    m, k = ll_dec_parts(v)
    mv = to_int(m) else err
        xfail(g, line, "дробь " + v)
        return
    if k > 18
        xfail(g, line, "дробь " + v)
        return
    p = 1
    repeat k times
        p *= 10
    xconst(g, mv)
    xbs(g, [0xF2, 0x48, 0x0F, 0x2A, 0xC0])
    xconst(g, p)
    xbs(g, [0xF2, 0x48, 0x0F, 0x2A, 0xC8, 0xF2, 0x0F, 0x5E, 0xC1])
    xmov_from_xmm0(g)

// rax = rax op rcx для dec
func xarith_dec(g: X64, op: text, line: int)
    xbs(g, [0x66, 0x48, 0x0F, 0x6E, 0xC0, 0x66, 0x48, 0x0F, 0x6E, 0xC9])
    if op == "+"
        xbs(g, [0xF2, 0x0F, 0x58, 0xC1])
    else if op == "-"
        xbs(g, [0xF2, 0x0F, 0x5C, 0xC1])
    else if op == "*"
        xbs(g, [0xF2, 0x0F, 0x59, 0xC1])
    else if op == "/"
        xbs(g, [0xF2, 0x0F, 0x5E, 0xC1])
    else if op == "==" or op == "!="
        xbs(g, [0x66, 0x0F, 0x2E, 0xC1])
        if op == "=="
            xbs(g, [0x0F, 0x94, 0xC0, 0x0F, 0x9B, 0xC1, 0x20, 0xC8])
        else
            xbs(g, [0x0F, 0x95, 0xC0, 0x0F, 0x9A, 0xC1, 0x08, 0xC8])
        xbs(g, [0x48, 0x0F, 0xB6, 0xC0])
        return
    else if op == "<" or op == "<="
        xbs(g, [0x66, 0x0F, 0x2E, 0xC8])
        if op == "<"
            xbs(g, [0x0F, 0x97, 0xC0])
        else
            xbs(g, [0x0F, 0x93, 0xC0])
        xbs(g, [0x48, 0x0F, 0xB6, 0xC0])
        return
    else if op == ">" or op == ">="
        xbs(g, [0x66, 0x0F, 0x2E, 0xC1])
        if op == ">"
            xbs(g, [0x0F, 0x97, 0xC0])
        else
            xbs(g, [0x0F, 0x93, 0xC0])
        xbs(g, [0x48, 0x0F, 0xB6, 0xC0])
        return
    else
        xfail(g, line, "знак " + op + " у дробных")
        return
    xmov_from_xmm0(g)

// ---------- тексты: сравнение байт за байтом (как strcmp), rax = разница ----------

// a в стеке, b в rax
func xstrcmp(g: X64)
    xbs(g, [0x48, 0x89, 0xC7, 0x5E])
    g.depth -= 1
    xbs(g, [0x0F, 0xB6, 0x06, 0x0F, 0xB6, 0x0F, 0x29, 0xC8, 0x75, 0x0C, 0x85, 0xC9, 0x74, 0x08, 0x48, 0xFF, 0xC6, 0x48, 0xFF, 0xC7, 0xEB, 0xEA])
    xbs(g, [0x48, 0x63, 0xC0])

// ---------- списки: [данные, длина, место, размер элемента] ----------

func xlist_ok(g: X64, c: Comp, t: int, line: int) gives ok: bool
    if kind_of(c, t) != "list" or ll_bits(c, t) or ll_colist(c, t)
        xfail(g, line, "такие списки")
        return false
    return true

// пустое значение типа t
func xdefault(g: X64, c: Comp, t: int, line: int)
    k = kind_of(c, t)
    if k == "text"
        xstring(g, "\"\"")
    else if k == "list"
        if xlist_ok(g, c, t, line)
            xconst(g, 8)
            xmov_rdi(g)
            if ll_ptr_elems(c, t)
                xcall(g, "tb_x_list_new")
            else
                xcall(g, "tb_x_list_new_np")
    else if k == "dict"
        if xdict_ok(g, c, t, line)
            xdict_new(g, c, t)
    else if k == "int" or k == "bool" or k == "dec" or k == "none" or k == "obj" or k == "enum"
        xconst(g, 0)
    else
        xfail(g, line, "пустое значение типа " + k)

// [a, b, c]: значения в ячейки кадра подряд (по возрастанию адреса), потом tb_x_list_from
func xlist_lit(g: X64, c: Comp, n: Node)
    if not xlist_ok(g, c, n.ty, n.line)
        return
    nk = len(n.kids)
    if nk == 0
        xdefault(g, c, n.ty, n.line)
        return
    first = len(g.vars)
    tag = "#arr" + first
    count i from 0 to nk - 1
        g.vars.add(tag + "_" + i)
    count i from 0 to nk - 1
        xas(g, c, n.kids[i], c.types[n.ty].elem)
        // элемент i — в ячейке first + nk - 1 - i (чем больше номер ячейки, тем ниже адрес)
        xstore_var(g, first + nk - 1 - i)
    xb(g, 0xBF)
    x32(g, nk)
    xb(g, 0xBE)
    x32(g, 8)
    xbs(g, [0x48, 0x8D, 0x95])
    x32(g, -8 * (first + nk))
    if ll_ptr_elems(c, n.ty)
        xcall(g, "tb_x_list_from")
    else
        xcall(g, "tb_x_list_from_np")

// rdx = адрес xs[i] (список — в стеке, номер — в rax); номер за пределами — остановка
func xelem_addr(g: X64, line: int)
    xbs(g, [0x48, 0x89, 0xC1, 0x58])
    g.depth -= 1
    xbs(g, [0x48, 0x3B, 0x48, 0x08, 0x72, 19])
    xcrash(g, line, 3)
    xbs(g, [0x48, 0x8B, 0x10, 0x48, 0x8D, 0x14, 0xCA])

// встроенная функция ядра: tb_xb_имя(параметры..., строка). i и p — в rdi, rsi..., d — в xmm0...
func xbuiltin(g: X64, c: Comp, n: Node)
    xn, xp = ll_xb(c, n)
    if xn == ""
        xfail(g, n.line, "слово " + n.name)
        return
    bargs = ll_bi_args(n)
    cls = list int
    ni = 0
    nf = 0
    count i from 0 to len(bargs) - 1
        if cut(xp, i, i) == "d"
            xas_dec(g, c, bargs[i])
            cls.add(100 + nf)
            nf += 1
        else
            xexpr(g, c, bargs[i])
            cls.add(ni)
            ni += 1
        xpush(g)
    if ni > 5 or nf > 8
        xfail(g, n.line, "слово " + n.name + " с таким числом параметров")
        return
    regs = [[0x5F], [0x5E], [0x5A], [0x59], [0x41, 0x58], [0x41, 0x59]]
    i = len(bargs) - 1
    repeat while i >= 0
        if cls[i] >= 100
            xb(g, 0x58)
            xbs(g, [0x66, 0x48, 0x0F, 0x6E, 0xC0 + (cls[i] - 100) * 8])
        else
            xbs(g, regs[cls[i]])
        g.depth -= 1
        i -= 1
    imm = [[0xBF], [0xBE], [0xBA], [0xB9], [0x41, 0xB8], [0x41, 0xB9]]
    xbs(g, imm[ni])
    x32(g, n.line)
    xcall(g, "tb_xb_" + xn)
    rk = kind_of(c, n.ty)
    if rk == "dec"
        xmov_from_xmm0(g)
    else if rk == "bool"
        xbs(g, [0x48, 0x0F, 0xB6, 0xC0])

// ---------- ошибки: tb_err (у каждого потока свой), адрес даёт tb_x_errp ----------

// rcx = ошибка (0 — нет), rax = её адрес; rax в ячейке не портим: значение сохранено раньше
func xerr_load(g: X64)
    xcall(g, "tb_x_errp")
    xbs(g, [0x48, 0x8B, 0x08])

// функция сломалась: в main — сообщение и стоп, иначе выход (ошибка остаётся для того, кто звал)
func xbail(g: X64)
    if g.fn.name == "main"
        xerr_load(g)
        xbs(g, [0x48, 0x89, 0xCF])
        xcall(g, "tb_x_die")
        return
    if g.out_name != ""
        xload_var(g, xslot(g, g.out_name))
    else
        xconst(g, 0)
    xjump(g, [0xE9], g.ret_l)

// ---------- obj: своё устройство — каждое качество по 8 байт подряд (программа Омниума наружу obj не отдаёт) ----------

func xfield_index(c: Comp, t: int, name: text) gives at: int
    at = -1
    o = c.types[t].obj_node
    count i from 0 to len(o.kids) - 1
        if o.kids[i].name == name
            at = i

func xobj_ok(g: X64, c: Comp, t: int, line: int) gives ok: bool
    if kind_of(c, t) != "obj" or c.types[t].obj_node.by_cols
        xfail(g, line, "такие obj")
        return false
    return true

// rax — obj; пустой — остановка
func xnull_check(g: X64, line: int)
    xbs(g, [0x48, 0x85, 0xC0, 0x75, 19])
    xcrash(g, line, 4)

func xnew_obj(g: X64, c: Comp, n: Node)
    o = n.ref
    nf = len(o.kids)
    if nf == 0
        nf = 1
    xconst(g, nf * 8)
    xmov_rdi(g)
    xcall(g, "tb_x_obj_mem")
    hold = xslot(g, "#o" + len(g.vars))
    xstore_var(g, hold)
    count i from 0 to len(o.kids) - 1
        ft = o.kids[i].ty
        if n.kids[i].kind == "missing"
            xdefault(g, c, ft, n.line)
        else
            xas(g, c, n.kids[i].kids[0], ft)
        xbs(g, [0x48, 0x8B, 0x95])
        x32(g, -8 * (hold + 1))
        xbs(g, [0x48, 0x89, 0x82])
        x32(g, i * 8)
    xload_var(g, hold)

// место (адрес в rdx) = значение из ячейки hold, или место op= значение
func xstore_at_rdx(g: X64, c: Comp, op: text, et: int, hold: int, line: int)
    if op == "="
        xload_var(g, hold)
    else
        o2 = cut(op, 0, len(op) - 2)
        ek = kind_of(c, et)
        if o2 != "+" and o2 != "-" and o2 != "*"
            xfail(g, line, "знак " + op + " здесь")
            return
        // rdx жив: + - * его не трогают
        xbs(g, [0x48, 0x8B, 0x02, 0x48, 0x8B, 0x8D])
        x32(g, -8 * (hold + 1))
        if ek == "dec"
            xarith_dec(g, o2, line)
        else if ek == "int"
            xarith(g, o2, line)
        else
            xfail(g, line, "знак " + op + " у такого значения")
    if kind_of(c, et) == "bool" and g.byte_store
        xbs(g, [0x88, 0x02])
    else
        xbs(g, [0x48, 0x89, 0x02])

// ---------- печать списков, obj, enum: свои функции tb_xshow_N (как tb_show_N в обычной сборке) ----------

func xps_lit(g: X64, s: text)
    xstring_raw(g, s)
    xmov_rdi(g)
    xcall(g, "tb_x_ps")

// значение в rax типа t → на экран
func xshow_val(g: X64, c: Comp, t: int, line: int)
    k = kind_of(c, t)
    xmov_rdi(g)
    if k == "int"
        xcall(g, "tb_x_show_i")
    else if k == "bool"
        xcall(g, "tb_x_btos")
        xmov_rdi(g)
        xcall(g, "tb_x_ps")
    else if k == "text"
        xcall(g, "tb_x_ps")
    else if k == "dec"
        xmov_xmm0(g)
        xcall(g, "tb_x_show_d")
    else if (k == "list" and xlist_ok(g, c, t, line)) or (k == "obj" and xobj_ok(g, c, t, line)) or k == "enum" or (k == "dict" and xdict_ok(g, c, t, line))
        has = false
        each d in g.show_need
            if d == t
                has = true
        if not has
            g.show_need.add(t)
        xcall(g, "tb_xshow_" + t)
    else
        xfail(g, line, "печать типа " + k)

func xshow_func(g: X64, c: Comp, t: int)
    g.vars.clear()
    g.lpos.clear()
    g.fix_at.clear()
    g.fix_l.clear()
    g.depth = 0
    g.out_name = ""
    sk = xsym(g, "tb_xshow_" + t)
    g.sdef[sk] = len(g.code)
    xbs(g, [0x55, 0x48, 0x89, 0xE5, 0x48, 0x81, 0xEC])
    frame_at = len(g.code)
    x32(g, 0)
    g.ret_l = xlabel(g)
    v = xslot(g, "#x")
    xbs(g, [0x48, 0x89, 0xBD])
    x32(g, -8 * (v + 1))
    k = kind_of(c, t)
    if k == "list"
        ik = xslot(g, "#i")
        xps_lit(g, "[")
        xconst(g, 0)
        xstore_var(g, ik)
        head = xlabel(g)
        out = xlabel(g)
        first = xlabel(g)
        xplace(g, head)
        xload_var(g, v)
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ik + 1))
        xbs(g, [0x48, 0x3B, 0x48, 0x08])
        xjump(g, [0x0F, 0x8D], out)
        xbs(g, [0x48, 0x85, 0xC9])
        xjump(g, [0x0F, 0x84], first)
        xps_lit(g, ", ")
        xplace(g, first)
        xload_var(g, v)
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ik + 1))
        xbs(g, [0x48, 0x8B, 0x00, 0x48, 0x8B, 0x04, 0xC8])
        xshow_val(g, c, c.types[t].elem, 0)
        xload_var(g, ik)
        xbs(g, [0x48, 0xFF, 0xC0])
        xstore_var(g, ik)
        xjump(g, [0xE9], head)
        xplace(g, out)
        xps_lit(g, "]")
    else if k == "dict"
        // ключи копией, потом для каждого dget
        kl = xslot(g, "#kl")
        ik = xslot(g, "#i")
        kv = xslot(g, "#kv")
        xps_lit(g, "{")
        xload_var(g, v)
        xmov_rdi(g)
        xcall(g, "tb_x_dkeys_copy")
        xstore_var(g, kl)
        xconst(g, 0)
        xstore_var(g, ik)
        head = xlabel(g)
        out = xlabel(g)
        first = xlabel(g)
        xplace(g, head)
        xload_var(g, kl)
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ik + 1))
        xbs(g, [0x48, 0x3B, 0x48, 0x08])
        xjump(g, [0x0F, 0x8D], out)
        xbs(g, [0x48, 0x85, 0xC9])
        xjump(g, [0x0F, 0x84], first)
        xps_lit(g, ", ")
        xplace(g, first)
        xload_var(g, kl)
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ik + 1))
        xbs(g, [0x48, 0x8B, 0x00, 0x48, 0x8B, 0x04, 0xC8])
        xstore_var(g, kv)
        xshow_val(g, c, c.types[t].key, 0)
        xps_lit(g, ": ")
        xload_var(g, v)
        xmov_rdi(g)
        xlea_rsi(g, kv)
        xb(g, 0xBA)
        x32(g, 0)
        xcall(g, "tb_x_dget")
        xload_dval(g, c, c.types[t].elem)
        xshow_val(g, c, c.types[t].elem, 0)
        xload_var(g, ik)
        xbs(g, [0x48, 0xFF, 0xC0])
        xstore_var(g, ik)
        xjump(g, [0xE9], head)
        xplace(g, out)
        xps_lit(g, "}")
    else if k == "obj"
        o = c.types[t].obj_node
        xps_lit(g, o.name + "(")
        count i from 0 to len(o.kids) - 1
            if i > 0
                xps_lit(g, ", ")
            xps_lit(g, o.kids[i].name + ": ")
            xload_var(g, v)
            xbs(g, [0x48, 0x8B, 0x80])
            x32(g, i * 8)
            xshow_val(g, c, o.kids[i].ty, o.line)
        xps_lit(g, ")")
    else
        names = c.types[t].obj_node.kids
        count i from 0 to len(names) - 1
            nx = xlabel(g)
            xload_var(g, v)
            xbs(g, [0x48, 0x3D])
            x32(g, i)
            xjump(g, [0x0F, 0x85], nx)
            xps_lit(g, names[i].name)
            xjump(g, [0xE9], g.ret_l)
            xplace(g, nx)
    xplace(g, g.ret_l)
    xbs(g, [0x48, 0x89, 0xEC, 0x5D, 0xC3])
    put32(g, frame_at, (len(g.vars) * 8 + 15) / 16 * 16)
    count i from 0 to len(g.fix_at) - 1
        at = g.fix_at[i]
        put32(g, at, g.lpos[g.fix_l[i]] - (at + 4))

// ---------- замки: lock имя — 8 байт в .bss, tb_x_lock_take / tb_x_lock_give из ядра ----------

func xlock_index(g: X64, name: text) gives k: int
    count i from 0 to len(g.lnames) - 1
        if g.lnames[i] == name
            return i
    g.lnames.add(name)
    g.loffs.add(g.bss)
    g.bss += 8
    return len(g.lnames) - 1

// rdi = адрес замка
func xlock_addr(g: X64, li: int)
    xbs(g, [0x48, 0x8D, 0x3D])
    xreloc(g, 3, 2, g.loffs[li] - 4)

func xlock_give(g: X64, li: int, fk: int)
    xbs(g, [0x48, 0x8B, 0xB5])
    x32(g, -8 * (fk + 1))
    xlock_addr(g, li)
    xcall(g, "tb_x_lock_give")

// ---------- dict: tb_x_dict_new / dput / dget / dhas ... из ядра; ключ (int или текст) — по адресу ячейки ----------

func xdict_text(c: Comp, t: int) gives r: int
    r = 0
    if kind_of(c, c.types[t].key) == "text"
        r = 1

func xdict_vsize(c: Comp, t: int) gives r: int
    r = 8
    if kind_of(c, c.types[t].elem) == "bool"
        r = 1

func xdict_ok(g: X64, c: Comp, t: int, line: int) gives ok: bool
    ek = kind_of(c, c.types[t].elem)
    kk = kind_of(c, c.types[t].key)
    if (kk != "int" and kk != "text") or ek == "list" and (ll_bits(c, c.types[t].elem) or ll_colist(c, c.types[t].elem))
        xfail(g, line, "такие dict")
        return false
    return true

func xdict_new(g: X64, c: Comp, t: int)
    xb(g, 0xBF)
    x32(g, xdict_text(c, t))
    xb(g, 0xBE)
    x32(g, xdict_vsize(c, t))
    xcall(g, "tb_x_dict_new")

// ключ → ячейка кадра; rsi = её адрес (rdi не трогаем)
func xkey_rsi(g: X64, c: Comp, key: Node) gives slot: int
    slot = xslot(g, "#k" + len(g.vars))
    xexpr(g, c, key)
    xstore_var(g, slot)

func xlea_rsi(g: X64, slot: int)
    xbs(g, [0x48, 0x8D, 0xB5])
    x32(g, -8 * (slot + 1))

// rax = адрес значения d[key] для записи (нет ключа — dict создаёт его с пустым значением)
func xdput(g: X64, c: Comp, dt: int, base: Node, key: Node)
    vt = c.types[dt].elem
    dk = xslot(g, "#dd" + len(g.vars))
    xexpr(g, c, base)
    xstore_var(g, dk)
    ks = xkey_rsi(g, c, key)
    df = xslot(g, "#df" + len(g.vars))
    xdefault(g, c, vt, key.line)
    xstore_var(g, df)
    xload_var(g, dk)
    xmov_rdi(g)
    xlea_rsi(g, ks)
    xbs(g, [0x48, 0x8D, 0x95])
    x32(g, -8 * (df + 1))
    xcall(g, "tb_x_dput")

// значение по адресу rax (bool — байт)
func xload_dval(g: X64, c: Comp, vt: int)
    if kind_of(c, vt) == "bool"
        xbs(g, [0x48, 0x0F, 0xB6, 0x00])
    else
        xbs(g, [0x48, 0x8B, 0x00])

func xdict_lit(g: X64, c: Comp, n: Node)
    t = n.ty
    if not xdict_ok(g, c, t, n.line)
        return
    vt = c.types[t].elem
    hold = xslot(g, "#d" + len(g.vars))
    xdict_new(g, c, t)
    xstore_var(g, hold)
    count i from 0 to len(n.kids) / 2 - 1
        vh = xslot(g, "#dv" + len(g.vars))
        xas(g, c, n.kids[2 * i + 1], vt)
        xstore_var(g, vh)
        xdput_slot(g, c, t, hold, n.kids[2 * i])
        xbs(g, [0x48, 0x89, 0xC2])
        g.byte_store = true
        xstore_at_rdx(g, c, "=", vt, vh, n.line)
        g.byte_store = false
    xload_var(g, hold)

// то же, что xdput, но dict уже в ячейке
func xdput_slot(g: X64, c: Comp, dt: int, dk: int, key: Node)
    vt = c.types[dt].elem
    ks = xkey_rsi(g, c, key)
    df = xslot(g, "#df" + len(g.vars))
    xdefault(g, c, vt, key.line)
    xstore_var(g, df)
    xload_var(g, dk)
    xmov_rdi(g)
    xlea_rsi(g, ks)
    xbs(g, [0x48, 0x8D, 0x95])
    x32(g, -8 * (df + 1))
    xcall(g, "tb_x_dput")

// a + b + 5 + ...: все части разом — одна память нужного размера (как в обычной сборке)
func xconcat_parts(c: Comp, n: Node, parts: list Node)
    if n.kind != "binop" or n.value != "+" or kind_of(c, n.ty) != "text"
        parts.add(n)
        return
    xconcat_parts(c, n.kids[0], parts)
    xconcat_parts(c, n.kids[1], parts)

func xconcat(g: X64, c: Comp, parts: list Node)
    ps = list int
    ls = list int
    lits = list int
    each part in parts
        pk = xslot(g, "#cp" + len(g.vars))
        lk = xslot(g, "#cl" + len(g.vars))
        ps.add(pk)
        ls.add(lk)
        k = kind_of(c, part.ty)
        if k == "int"
            // цифры числа — в 24 байта кадра (tb_x_digits), без своей памяти
            first = len(g.vars)
            count q from 0 to 2
                g.vars.add("#cb" + first + "_" + q)
            xexpr(g, c, part)
            xmov_rdi(g)
            xbs(g, [0x48, 0x8D, 0xB5])
            x32(g, -8 * (first + 3))
            xbs(g, [0x48, 0x8D, 0x95])
            x32(g, -8 * (lk + 1))
            xcall(g, "tb_x_digits")
            xstore_var(g, pk)
        else
            if k == "text"
                xexpr(g, c, part)
            else
                xas_text(g, c, part)
            xstore_var(g, pk)
            // длина: до нулевого байта
            xbs(g, [0x48, 0x89, 0xC7, 0x31, 0xC9, 0x80, 0x3C, 0x0F, 0x00, 0x74, 0x05, 0x48, 0xFF, 0xC1, 0xEB, 0xF5, 0x48, 0x89, 0xC8])
            xstore_var(g, lk)
    xconst(g, 1)
    each lk in ls
        xbs(g, [0x48, 0x03, 0x85])
        x32(g, -8 * (lk + 1))
    xmov_rdi(g)
    xcall(g, "tb_x_mem_np")
    res = xslot(g, "#cr" + len(g.vars))
    xstore_var(g, res)
    xmov_rdi(g)
    count i from 0 to len(ps) - 1
        xbs(g, [0x48, 0x8B, 0xB5])
        x32(g, -8 * (ps[i] + 1))
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ls[i] + 1))
        xbs(g, [0xF3, 0xA4])
    xbs(g, [0xC6, 0x07, 0x00])
    xload_var(g, res)

// ---------- s += x на месте: у текста s ячейки #rl.s (длина своей памяти, -1 — своей нет) и #rc.s ----------

func xfind_blds(g: X64, c: Comp, n: Node)
    if n.kind == "set" and n.value == "+=" and n.kids[0].kind == "name" and kind_of(c, n.ty) == "text"
        if not xbld_has(g, n.kids[0].name)
            g.bld_names.add(n.kids[0].name)
    each k in n.kids
        xfind_blds(g, c, k)

func xbld_has(g: X64, name: text) gives yes: bool
    each b in g.bld_names
        if b == name
            return true
    return false

// своей памяти больше нет: текст могли где-то сохранить, следующее дописывание сделает копию
func xbld_forget(g: X64, name: text)
    if xbld_has(g, name)
        xbs(g, [0x48, 0xC7, 0x85])
        x32(g, -8 * (xslot(g, "#rl." + name) + 1))
        x32(g, -1)

// rdi = &s, rsi = &rl, rdx = &rc
func xbld_args(g: X64, name: text)
    xbs(g, [0x48, 0x8D, 0xBD])
    x32(g, -8 * (xslot(g, name) + 1))
    xbs(g, [0x48, 0x8D, 0xB5])
    x32(g, -8 * (xslot(g, "#rl." + name) + 1))
    xbs(g, [0x48, 0x8D, 0x95])
    x32(g, -8 * (xslot(g, "#rc." + name) + 1))

func xbld_app(g: X64, c: Comp, name: text, part: Node)
    k = kind_of(c, part.ty)
    if k == "int"
        xexpr(g, c, part)
        xbs(g, [0x48, 0x89, 0xC1])
        xbld_args(g, name)
        xcall(g, "tb_x_app_i")
    else if part.kind == "string"
        bytes, ok = ll_str_bytes(part.value)
        xstring(g, part.value)
        xbs(g, [0x48, 0x89, 0xC1, 0x41, 0xB8])
        x32(g, len(bytes))
        xbld_args(g, name)
        xcall(g, "tb_x_app_n")
    else
        xas_text(g, c, part)
        xbs(g, [0x48, 0x89, 0xC1])
        xbld_args(g, name)
        xcall(g, "tb_x_app")

func xexpr(g: X64, c: Comp, n: Node)
    k = n.kind
    if k == "number"
        v = to_int(n.value) else err
            xfail(g, n.line, "число " + n.value)
            return
        xconst(g, v)
    else if k == "bool"
        if n.value == "true"
            xconst(g, 1)
        else
            xconst(g, 0)
    else if k == "string"
        xstring(g, n.value)
    else if k == "name"
        xload_name(g, n)
    else if k == "unary"
        xexpr(g, c, n.kids[0])
        if n.value == "not"
            xbs(g, [0x48, 0x83, 0xF0, 0x01])
        else if kind_of(c, n.ty) == "int"
            xbs(g, [0x48, 0xF7, 0xD8])
            if g.in_danger == 0
                xbs(g, [0x71, 19])
                xcrash(g, n.line, 8)
        else if kind_of(c, n.ty) == "dec"
            xbs(g, [0x48, 0xB9, 0, 0, 0, 0, 0, 0, 0, 0x80, 0x48, 0x31, 0xC8])
        else
            xfail(g, n.line, "минус у такого типа")
    else if k == "binop" and (n.value == "and" or n.value == "or")
        // правую часть — только если нужна
        done = xlabel(g)
        xexpr(g, c, n.kids[0])
        xbs(g, [0x48, 0x85, 0xC0])
        if n.value == "and"
            xjump(g, [0x0F, 0x84], done)
        else
            xjump(g, [0x0F, 0x85], done)
        xexpr(g, c, n.kids[1])
        xplace(g, done)
    else if k == "binop" and n.value != "orelse" and kind_of(c, n.ty) == "text"
        parts = list Node
        xconcat_parts(c, n, parts)
        xconcat(g, c, parts)
    else if k == "binop" and n.value != "orelse" and (kind_of(c, n.kids[0].ty) == "dec" or kind_of(c, n.kids[1].ty) == "dec")
        xas_dec(g, c, n.kids[0])
        xpush(g)
        xas_dec(g, c, n.kids[1])
        xbs(g, [0x48, 0x89, 0xC1])
        xb(g, 0x58)
        g.depth -= 1
        xarith_dec(g, n.value, n.line)
    else if k == "binop" and n.value != "orelse" and kind_of(c, n.ty) != "text" and kind_of(c, n.kids[0].ty) == "text"
        xexpr(g, c, n.kids[0])
        xpush(g)
        xexpr(g, c, n.kids[1])
        xstrcmp(g)
        xbs(g, [0x48, 0x31, 0xC9])
        xarith(g, n.value, n.line)
    else if k == "binop" and n.value != "orelse"
        k0 = kind_of(c, n.kids[0].ty)
        if k0 != "int" and k0 != "bool" and k0 != "enum"
            xfail(g, n.line, "знак " + n.value + " у такого типа")
            return
        xexpr(g, c, n.kids[0])
        xpush(g)
        xexpr(g, c, n.kids[1])
        xbs(g, [0x48, 0x89, 0xC1])
        xb(g, 0x58)
        g.depth -= 1
        xarith(g, n.value, n.line)
    else if k == "call" and n.has_ref and n.ref.kind == "func"
        xcall_user(g, c, n)
    else if k == "call" and not n.has_ref and (n.name == "print" or n.name == "show")
        xprint(g, c, n, n.name == "print")
    else if k == "call" and not n.has_ref and n.name == "len"
        a = n.kids[0].kids[0]
        ak = kind_of(c, a.ty)
        xexpr(g, c, a)
        if ak == "text"
            xmov_rdi(g)
            xcall(g, "tb_x_ulen")
        else if ak == "list" and xlist_ok(g, c, a.ty, n.line)
            xbs(g, [0x48, 0x8B, 0x40, 0x08])
        else if ak == "dict"
            xmov_rdi(g)
            xcall(g, "tb_x_dlen")
        else
            xfail(g, n.line, "len у такого типа")
    else if k == "call" and not n.has_ref
        xbuiltin(g, c, n)
    else if k == "enumval"
        xconst(g, to_int(n.value) or 0)
    else if k == "call" and n.has_ref and n.ref.kind == "obj"
        if xobj_ok(g, c, n.ty, n.line)
            xnew_obj(g, c, n)
    else if k == "field" and kind_of(c, n.kids[0].ty) == "obj"
        if xobj_ok(g, c, n.kids[0].ty, n.line)
            xexpr(g, c, n.kids[0])
            xnull_check(g, n.line)
            xbs(g, [0x48, 0x8B, 0x80])
            x32(g, xfield_index(c, n.kids[0].ty, n.name) * 8)
    else if k == "dict"
        xdict_lit(g, c, n)
    else if k == "index" and kind_of(c, n.kids[0].ty) == "dict"
        // d[k]: нет ключа — остановка
        dt = n.kids[0].ty
        if xdict_ok(g, c, dt, n.line)
            dk = xslot(g, "#dd" + len(g.vars))
            xexpr(g, c, n.kids[0])
            xstore_var(g, dk)
            ks = xkey_rsi(g, c, n.kids[1])
            xload_var(g, dk)
            xmov_rdi(g)
            xlea_rsi(g, ks)
            xb(g, 0xBA)
            x32(g, n.line)
            xcall(g, "tb_x_dget")
            xload_dval(g, c, c.types[dt].elem)
    else if k == "method" and kind_of(c, n.kids[0].ty) == "dict"
        dt = n.kids[0].ty
        if xdict_ok(g, c, dt, n.line)
            dk = xslot(g, "#dd" + len(g.vars))
            xexpr(g, c, n.kids[0])
            xstore_var(g, dk)
            if n.name == "has" or n.name == "remove"
                ks = xkey_rsi(g, c, n.kids[1].kids[0])
                xload_var(g, dk)
                xmov_rdi(g)
                xlea_rsi(g, ks)
                if n.name == "has"
                    xcall(g, "tb_x_dhas")
                    xbs(g, [0x85, 0xC0, 0x0F, 0x95, 0xC0, 0x48, 0x0F, 0xB6, 0xC0])
                else
                    xcall(g, "tb_x_dremove")
            else if n.name == "clear"
                xload_var(g, dk)
                xmov_rdi(g)
                xb(g, 0xBE)
                x32(g, n.line)
                xcall(g, "tb_x_dclear")
            else if n.name == "keys" or n.name == "values"
                if kind_of(c, n.ty) == "list" and (ll_bits(c, n.ty) or ll_colist(c, n.ty))
                    xfail(g, n.line, "такие списки")
                xload_var(g, dk)
                xmov_rdi(g)
                if n.name == "keys"
                    xcall(g, "tb_x_dkeys_copy")
                else
                    xcall(g, "tb_x_dvals_copy")
            else
                xfail(g, n.line, "d." + n.name)
    else if k == "decimal"
        xdecimal(g, n.value, n.line)
    else if k == "type"
        xdefault(g, c, n.ty, n.line)
    else if k == "list"
        xlist_lit(g, c, n)
    else if k == "index" and kind_of(c, n.kids[0].ty) == "text"
        // s[i]: буква (tb_x_char_at: номер за пределами — остановка)
        xexpr(g, c, n.kids[0])
        xpush(g)
        xexpr(g, c, n.kids[1])
        xbs(g, [0x48, 0x89, 0xC6, 0x5F])
        g.depth -= 1
        xbs(g, [0x48, 0xC7, 0xC2, 0xFF, 0xFF, 0xFF, 0xFF, 0xB9])
        x32(g, n.line)
        xcall(g, "tb_x_char_at")
    else if k == "index" and kind_of(c, n.kids[0].ty) == "list"
        if xlist_ok(g, c, n.kids[0].ty, n.line)
            xexpr(g, c, n.kids[0])
            xpush(g)
            xexpr(g, c, n.kids[1])
            xelem_addr(g, n.line)
            xbs(g, [0x48, 0x8B, 0x02])
    else if k == "method" and n.name == "pop" and kind_of(c, n.kids[0].ty) == "list"
        if xlist_ok(g, c, n.kids[0].ty, n.line)
            xexpr(g, c, n.kids[0])
            xmov_rdi(g)
            xb(g, 0xBE)
            x32(g, n.line)
            xcall(g, "tb_x_pop")
            xbs(g, [0x48, 0x8B, 0x00])
    else if k == "else_err"
        // значение — в ячейку; сломалась — текст ошибки в err, tb_err снова пустой, блок
        hold = xslot(g, "#v" + len(g.vars))
        xexpr(g, c, n.kids[0])
        xstore_var(g, hold)
        ok = xlabel(g)
        xerr_load(g)
        xbs(g, [0x48, 0x85, 0xC9])
        xjump(g, [0x0F, 0x84], ok)
        xbs(g, [0x48, 0xC7, 0x00, 0, 0, 0, 0, 0x48, 0x89, 0xC8])
        xstore_name(g, n.name)
        xblock(g, c, n.kids[1])
        xplace(g, ok)
        xload_var(g, hold)
    else if k == "binop" and n.value == "orelse"
        hold = xslot(g, "#v" + len(g.vars))
        xas(g, c, n.kids[0], n.ty)
        xstore_var(g, hold)
        ok = xlabel(g)
        done = xlabel(g)
        xerr_load(g)
        xbs(g, [0x48, 0x85, 0xC9])
        xjump(g, [0x0F, 0x84], ok)
        xbs(g, [0x48, 0xC7, 0x00, 0, 0, 0, 0])
        xas(g, c, n.kids[1], n.ty)
        xjump(g, [0xE9], done)
        xplace(g, ok)
        xload_var(g, hold)
        xplace(g, done)
    else if k == "try"
        hold = xslot(g, "#v" + len(g.vars))
        xexpr(g, c, n.kids[0])
        xstore_var(g, hold)
        ok = xlabel(g)
        xerr_load(g)
        xbs(g, [0x48, 0x85, 0xC9])
        xjump(g, [0x0F, 0x84], ok)
        xbail(g)
        xplace(g, ok)
        xload_var(g, hold)
    else
        xfail(g, n.line, "«" + k + " " + n.name + "»")

func xcall_user(g: X64, c: Comp, n: Node)
    f = n.ref
    nout = len(f.kids[2].kids)
    if nout > 1
        // несколько выходов отдельной строкой: выходы — во временные ячейки (их потом заберёт a, b = ...)
        g.mtemps.clear()
        each o in f.kids[2].kids
            g.mtemps.add(xslot(g, "#mo" + len(g.vars)))
    else
        nout = 0
    if len(n.kids) + nout > 6
        xfail(g, n.line, "больше 6 параметров вместе с выходами")
        return
    each p in f.kids[0].kids
        if p.is_link
            xfail(g, n.line, "параметры link")
            return
    count i from 0 to len(n.kids) - 1
        xas(g, c, n.kids[i].kids[0], f.kids[0].kids[i].ty)
        xpush(g)
    each mt in g.mtemps
        if nout > 0
            xbs(g, [0x48, 0x8D, 0x85])
            x32(g, -8 * (mt + 1))
            xpush(g)
    // pop в rdi, rsi, rdx, rcx, r8, r9 — с конца
    regs = [[0x5F], [0x5E], [0x5A], [0x59], [0x41, 0x58], [0x41, 0x59]]
    i = len(n.kids) + nout - 1
    repeat while i >= 0
        xbs(g, regs[i])
        g.depth -= 1
        i -= 1
    xcall(g, ll_fname(f))

func xprint(g: X64, c: Comp, n: Node, newline: bool)
    count i from 0 to len(n.kids) - 1
        v = n.kids[i].kids[0]
        if i > 0
            xstring_raw(g, " ")
            xmov_rdi(g)
            xcall(g, "tb_x_ps")
        xexpr(g, c, v)
        xmov_rdi(g)
        vk = kind_of(c, v.ty)
        if vk == "int"
            xcall(g, "tb_x_show_i")
        else if vk == "bool"
            xcall(g, "tb_x_btos")
            xmov_rdi(g)
            xcall(g, "tb_x_ps")
        else if vk == "text"
            xcall(g, "tb_x_ps")
        else if vk == "dec"
            xmov_xmm0(g)
            xcall(g, "tb_x_show_d")
        else
            xshow_val(g, c, v.ty, v.line)
    if newline
        xstring_raw(g, "\\n")
        xmov_rdi(g)
        xcall(g, "tb_x_ps")

func xblock(g: X64, c: Comp, b: Node)
    each s in b.kids
        xstmt(g, c, s)

func xloop_body(g: X64, c: Comp, body: Node, cont: int, out: int)
    if not auto_temp_ok(c, body)
        g.cont.add(cont)
        g.brk.add(out)
        xblock(g, c, body)
        gone_c = g.cont.pop()
        gone_b = g.brk.pop()
        return
    // всё, что тело создаёт, отдаётся в конце каждого круга (как в обычной сборке): сборки мусора нет
    first = len(g.vars)
    g.vars.add("#am" + first)
    g.vars.add("#am" + first + "b")
    xbs(g, [0x48, 0x8D, 0xBD])
    x32(g, -8 * (first + 2))
    xcall(g, "tb_x_temp_begin_p")
    rel = xlabel(g)
    g.cont.add(rel)
    g.brk.add(out)
    xblock(g, c, body)
    gone_c = g.cont.pop()
    gone_b = g.brk.pop()
    xplace(g, rel)
    xbs(g, [0x48, 0x8D, 0xBD])
    x32(g, -8 * (first + 2))
    xcall(g, "tb_x_temp_end_p")
    xjump(g, [0xE9], cont)

func xstmt(g: X64, c: Comp, n: Node)
    k = n.kind
    if k == "assign"
        if len(n.kids) == 0
            xdefault(g, c, n.ty, n.line)
        else
            xas(g, c, n.kids[0], n.ty)
        xstore_name(g, n.name)
    else if k == "set" and n.kids[0].kind == "index" and kind_of(c, n.kids[0].kids[0].ty) == "list"
        // xs[i] = v / xs[i] += v: сначала значение, потом место
        t = n.kids[0]
        if not xlist_ok(g, c, t.kids[0].ty, n.line)
            return
        et = c.types[t.kids[0].ty].elem
        hold = xslot(g, "#v" + len(g.vars))
        xas(g, c, n.kids[1], et)
        xstore_var(g, hold)
        xexpr(g, c, t.kids[0])
        xpush(g)
        xexpr(g, c, t.kids[1])
        xelem_addr(g, n.line)
        xstore_at_rdx(g, c, n.value, et, hold, n.line)
    else if k == "set" and n.kids[0].kind == "index" and kind_of(c, n.kids[0].kids[0].ty) == "dict"
        // d[k] = v / d[k] += v: сначала значение, потом место
        t = n.kids[0]
        dt = t.kids[0].ty
        if not xdict_ok(g, c, dt, n.line)
            return
        vt = c.types[dt].elem
        hold = xslot(g, "#v" + len(g.vars))
        if kind_of(c, vt) == "text" and n.value == "+="
            xfail(g, n.line, "d[k] += у текста")
            return
        xas(g, c, n.kids[1], vt)
        xstore_var(g, hold)
        xdput(g, c, dt, t.kids[0], t.kids[1])
        xbs(g, [0x48, 0x89, 0xC2])
        g.byte_store = true
        if kind_of(c, vt) == "bool" and n.value != "="
            xfail(g, n.line, "знак " + n.value + " у bool")
        xstore_at_rdx(g, c, n.value, vt, hold, n.line)
        g.byte_store = false
    else if k == "expr_stmt" and n.kids[0].kind == "method" and kind_of(c, n.kids[0].kids[0].ty) == "dict"
        xexpr(g, c, n.kids[0])
    else if k == "set" and n.kids[0].kind == "field" and kind_of(c, n.kids[0].kids[0].ty) == "obj"
        t = n.kids[0]
        if not xobj_ok(g, c, t.kids[0].ty, n.line)
            return
        fi = xfield_index(c, t.kids[0].ty, t.name)
        et = c.types[t.kids[0].ty].obj_node.kids[fi].ty
        hold = xslot(g, "#v" + len(g.vars))
        xas(g, c, n.kids[1], et)
        xstore_var(g, hold)
        xexpr(g, c, t.kids[0])
        xnull_check(g, n.line)
        xbs(g, [0x48, 0x8D, 0x90])
        x32(g, fi * 8)
        xstore_at_rdx(g, c, n.value, et, hold, n.line)
    else if k == "match"
        subj = n.kids[0]
        textual = kind_of(c, subj.ty) == "text"
        hold = xslot(g, "#m" + len(g.vars))
        xexpr(g, c, subj)
        xstore_var(g, hold)
        done = xlabel(g)
        count i from 1 to len(n.kids) - 1
            cs = n.kids[i]
            if cs.name == "else"
                xblock(g, c, cs.kids[1])
                xjump(g, [0xE9], done)
            else
                yes = xlabel(g)
                no = xlabel(g)
                each v in cs.kids[0].kids
                    xload_var(g, hold)
                    xpush(g)
                    xexpr(g, c, v)
                    if textual
                        xstrcmp(g)
                        xbs(g, [0x48, 0x85, 0xC0])
                    else
                        xbs(g, [0x48, 0x89, 0xC1, 0x58, 0x48, 0x39, 0xC8])
                        g.depth -= 1
                    xjump(g, [0x0F, 0x84], yes)
                xjump(g, [0xE9], no)
                xplace(g, yes)
                xblock(g, c, cs.kids[1])
                xjump(g, [0xE9], done)
                xplace(g, no)
        xplace(g, done)
    else if k == "set" and n.kids[0].kind == "name"
        name = n.kids[0].name
        tk = kind_of(c, n.ty)
        if n.value != "=" and tk == "text"
            if n.value != "+="
                xfail(g, n.line, "знак " + n.value + " у текста")
                return
            // s += x: s = s + x (новый текст)
            parts = list Node
            xconcat_parts(c, n.kids[1], parts)
            if xbld_has(g, name) and has_var(g, name)
                each part in parts
                    xbld_app(g, c, name, part)
            else
                all = [n.kids[0]]
                each part in parts
                    all.add(part)
                xconcat(g, c, all)
                xstore_name(g, name)
            return
        xas(g, c, n.kids[1], n.ty)
        if n.value != "="
            op = cut(n.value, 0, len(n.value) - 2)
            xbs(g, [0x48, 0x89, 0xC1])
            xload_name(g, n.kids[0])
            if tk == "dec"
                xarith_dec(g, op, n.line)
            else
                xarith(g, op, n.line)
        xstore_name(g, name)
    else if k == "if"
        done = xlabel(g)
        i = 0
        repeat while i + 1 < len(n.kids)
            no = xlabel(g)
            xexpr(g, c, n.kids[i])
            xbs(g, [0x48, 0x85, 0xC0])
            xjump(g, [0x0F, 0x84], no)
            xblock(g, c, n.kids[i + 1])
            xjump(g, [0xE9], done)
            xplace(g, no)
            i += 2
        if len(n.kids) % 2 == 1
            xblock(g, c, n.kids[len(n.kids) - 1])
        xplace(g, done)
    else if k == "repeat_while"
        head = xlabel(g)
        out = xlabel(g)
        xplace(g, head)
        xexpr(g, c, n.kids[0])
        xbs(g, [0x48, 0x85, 0xC0])
        xjump(g, [0x0F, 0x84], out)
        xloop_body(g, c, n.kids[1], head, out)
        xjump(g, [0xE9], head)
        xplace(g, out)
    else if k == "repeat_times" or k == "count"
        // count i from a to b: конец считается один раз (как везде); repeat N times — счётчик свой
        cnt = ""
        endk = xslot(g, "#end" + len(g.vars))
        if k == "count"
            cnt = n.name
            xexpr(g, c, n.kids[1])
            xstore_var(g, endk)
            xexpr(g, c, n.kids[0])
        else
            cnt = "#n" + len(g.vars)
            xexpr(g, c, n.kids[0])
            xbs(g, [0x48, 0xFF, 0xC8])
            xstore_var(g, endk)
            xconst(g, 0)
        ck = xslot(g, cnt)
        xstore_var(g, ck)
        head = xlabel(g)
        step = xlabel(g)
        out = xlabel(g)
        xplace(g, head)
        xload_var(g, ck)
        xbs(g, [0x48, 0x3B, 0x85])
        x32(g, -8 * (endk + 1))
        xjump(g, [0x0F, 0x8F], out)
        body = n.kids[len(n.kids) - 1]
        xloop_body(g, c, body, step, out)
        xplace(g, step)
        xload_var(g, ck)
        xbs(g, [0x48, 0xFF, 0xC0])
        xstore_var(g, ck)
        xjump(g, [0xE9], head)
        xplace(g, out)
    else if k == "skip"
        xjump(g, [0xE9], g.cont[len(g.cont) - 1])
    else if k == "stop"
        xjump(g, [0xE9], g.brk[len(g.brk) - 1])
    else if k == "return"
        if len(n.kids) == 1
            xas(g, c, n.kids[0], g.fn.ty)
        else if g.out_name != ""
            xload_var(g, xslot(g, g.out_name))
        xjump(g, [0xE9], g.ret_l)
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "add" and kind_of(c, n.kids[0].kids[0].ty) == "list"
        // xs.add(v): значение, потом место под него (tb_x_grow), потом запись
        e = n.kids[0]
        if not xlist_ok(g, c, e.kids[0].ty, n.line)
            return
        hold = xslot(g, "#v" + len(g.vars))
        xas(g, c, e.kids[1].kids[0], c.types[e.kids[0].ty].elem)
        xstore_var(g, hold)
        xexpr(g, c, e.kids[0])
        xmov_rdi(g)
        xcall(g, "tb_x_grow")
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (hold + 1))
        xbs(g, [0x48, 0x89, 0x08])
    else if k == "each" and not n.by_piece and (kind_of(c, n.kids[0].ty) == "list" or kind_of(c, n.kids[0].ty) == "dict")
        // on all cores и by vec — здесь просто по очереди (в ядре Омниума это и так один проход)
        isdict = kind_of(c, n.kids[0].ty) == "dict"
        if isdict
            if not xdict_ok(g, c, n.kids[0].ty, n.line)
                return
        else if not xlist_ok(g, c, n.kids[0].ty, n.line)
            return
        lk = xslot(g, "#l" + len(g.vars))
        ik = xslot(g, "#i" + len(g.vars))
        xexpr(g, c, n.kids[0])
        if isdict
            // each k in d: по списку ключей (он первым лежит в dict)
            xbs(g, [0x48, 0x8B, 0x00])
        xstore_var(g, lk)
        xconst(g, 0)
        xstore_var(g, ik)
        head = xlabel(g)
        step = xlabel(g)
        out = xlabel(g)
        xplace(g, head)
        // i < len(xs)? x = xs[i]
        xload_var(g, lk)
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ik + 1))
        xbs(g, [0x48, 0x3B, 0x48, 0x08])
        xjump(g, [0x0F, 0x8D], out)
        xbs(g, [0x48, 0x8B, 0x00, 0x48, 0x8B, 0x04, 0xC8])
        xstore_var(g, xslot(g, n.name))
        xloop_body(g, c, n.kids[1], step, out)
        xplace(g, step)
        xload_var(g, ik)
        xbs(g, [0x48, 0xFF, 0xC0])
        xstore_var(g, ik)
        xjump(g, [0xE9], head)
        xplace(g, out)
    else if k == "temp"
        // всё, что создано внутри, отдаётся разом в конце: tb_x_temp_begin_p / end_p (16 байт в кадре)
        first = len(g.vars)
        g.vars.add("#t" + first)
        g.vars.add("#t" + first + "b")
        xbs(g, [0x48, 0x8D, 0xBD])
        x32(g, -8 * (first + 2))
        xcall(g, "tb_x_temp_begin_p")
        xblock(g, c, n.kids[0])
        xbs(g, [0x48, 0x8D, 0xBD])
        x32(g, -8 * (first + 2))
        xcall(g, "tb_x_temp_end_p")
    else if k == "expr_stmt" and n.kids[0].kind == "method" and n.kids[0].name == "clear" and kind_of(c, n.kids[0].kids[0].ty) == "list"
        if xlist_ok(g, c, n.kids[0].kids[0].ty, n.line)
            xexpr(g, c, n.kids[0].kids[0])
            xbs(g, [0x48, 0xC7, 0x40, 0x08, 0, 0, 0, 0])
    else if k == "each" and kind_of(c, n.kids[0].ty) == "text"
        // по буквам: tb_x_u8take берёт букву и двигает номер на её последний байт
        tk = xslot(g, "#s" + len(g.vars))
        ik = xslot(g, "#i" + len(g.vars))
        xexpr(g, c, n.kids[0])
        xstore_var(g, tk)
        xconst(g, 0)
        xstore_var(g, ik)
        head = xlabel(g)
        step = xlabel(g)
        out = xlabel(g)
        xplace(g, head)
        xload_var(g, tk)
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (ik + 1))
        xbs(g, [0x80, 0x3C, 0x08, 0x00])
        xjump(g, [0x0F, 0x84], out)
        xload_var(g, tk)
        xmov_rdi(g)
        xbs(g, [0x48, 0x8D, 0xB5])
        x32(g, -8 * (ik + 1))
        xcall(g, "tb_x_u8take")
        xstore_var(g, xslot(g, n.name))
        xloop_body(g, c, n.kids[1], step, out)
        xplace(g, step)
        xload_var(g, ik)
        xbs(g, [0x48, 0xFF, 0xC0])
        xstore_var(g, ik)
        xjump(g, [0xE9], head)
        xplace(g, out)
    else if k == "lock"
        li = xlock_index(g, n.name)
        fk = xslot(g, "#lf" + len(g.vars))
        xlock_addr(g, li)
        xcall(g, "tb_x_lock_take")
        xstore_var(g, fk)
        g.lheld.add(fk)
        xblock(g, c, n.kids[0])
        gone = g.lheld.pop()
        freed = false
        each st in n.kids[0].kids
            if st.kind == "unlock"
                freed = true
        if not freed
            xlock_give(g, li, fk)
    else if k == "unlock"
        xlock_give(g, xlock_index(g, n.name), g.lheld[len(g.lheld) - 1])
    else if k == "multi"
        // a, b = f() / a, b = f() else err / try f(): выходы во временные ячейки, потом в переменные
        call = n.kids[len(n.kids) - 1]
        xexpr(g, c, call)
        tmps = list int
        each mt in g.mtemps
            tmps.add(mt)
        if len(tmps) != len(n.kids) - 1
            xfail(g, n.line, "a, b = ... здесь")
            return
        count i from 0 to len(n.kids) - 2
            xload_var(g, tmps[i])
            xstore_name(g, n.kids[i].name)
    else if k == "fail"
        xexpr(g, c, n.kids[0])
        xpush(g)
        xcall(g, "tb_x_errp")
        xpop_rcx(g)
        xbs(g, [0x48, 0x89, 0x08])
        xbail(g)
    else if k == "expr_stmt"
        xexpr(g, c, n.kids[0])
    else if k == "danger"
        g.in_danger += 1
        xblock(g, c, n.kids[0])
        g.in_danger -= 1
    else
        xfail(g, n.line, "«" + k + "»")

// одна функция: пролог, тело, эпилог; прыжки дописываются в конце
func xfunc(g: X64, c: Comp, f: Node, name: text)
    g.vars.clear()
    g.lpos.clear()
    g.fix_at.clear()
    g.fix_l.clear()
    g.depth = 0
    g.fn = f
    g.out_name = ""
    g.fa_slot = -1
    g.bld_names.clear()
    g.out_ptrs.clear()
    g.out_names.clear()
    s = xsym(g, name)
    g.sdef[s] = len(g.code)
    // push rbp; mov rbp, rsp; sub rsp, размер кадра (допишем)
    xbs(g, [0x55, 0x48, 0x89, 0xE5, 0x48, 0x81, 0xEC])
    frame_at = len(g.code)
    x32(g, 0)
    g.ret_l = xlabel(g)
    if f.kind == "func"
        params = f.kids[0].kids
        if len(params) > 6
            xfail(g, f.line, "больше 6 параметров")
        stores = [[0x48, 0x89, 0xBD], [0x48, 0x89, 0xB5], [0x48, 0x89, 0x95], [0x48, 0x89, 0x8D], [0x4C, 0x89, 0x85], [0x4C, 0x89, 0x8D]]
        count i from 0 to min(len(params), 6) - 1
            xbs(g, stores[i])
            x32(g, -8 * (xslot(g, params[i].name) + 1))
        g.bld_names.clear()
        xfind_blds(g, c, f.kids[1])
        each b in g.bld_names
            xbs(g, [0x48, 0xC7, 0x85])
            x32(g, -8 * (xslot(g, "#rl." + b) + 1))
            x32(g, -1)
            xbs(g, [0x48, 0xC7, 0x85])
            x32(g, -8 * (xslot(g, "#rc." + b) + 1))
            x32(g, 0)
        outs = f.kids[2].kids
        g.out_ptrs.clear()
        g.out_names.clear()
        if len(outs) > 1
            if len(params) + len(outs) > 6
                xfail(g, f.line, "больше 6 параметров вместе с выходами")
            count i from 0 to len(outs) - 1
                at = len(params) + i
                if at < 6
                    op = xslot(g, "#op" + i)
                    xbs(g, stores[at])
                    x32(g, -8 * (op + 1))
                    g.out_ptrs.add(op)
                    g.out_names.add(outs[i].name)
            // выход с именем параметра — та же переменная; остальные — пустые значения
            each o in outs
                if not has_var(g, o.name)
                    xdefault(g, c, o.ty, f.line)
                    xstore_var(g, xslot(g, o.name))
        if func_arena_ok(c, f)
            // всё, что функция создаёт, — во временной области; отдаётся при выходе
            fm = len(g.vars)
            g.vars.add("#fm")
            g.vars.add("#fm2")
            g.fa_slot = xslot(g, "#fa")
            g.fm_slot = fm
            xbs(g, [0x48, 0x8D, 0xBD])
            x32(g, -8 * (fm + 2))
            xcall(g, "tb_x_fa_begin")
            xbs(g, [0x48, 0x63, 0xC0])
            xstore_var(g, g.fa_slot)
        if len(outs) == 1
            g.out_name = outs[0].name
            if not has_var(g, g.out_name)
                xdefault(g, c, outs[0].ty, f.line)
                xstore_var(g, xslot(g, g.out_name))
        xblock(g, c, f.kids[1])
        if g.out_name != ""
            xload_var(g, xslot(g, g.out_name))
    else
        // tb_appmain: shared получают начальные значения, потом main
        each gl in c.globals
            if len(gl.kids) > 0
                xas(g, c, gl.kids[0], gl.ty)
                xstore_global(g, xglobal(g, gl.name))
        xcall(g, ll_fname(f.ref))
    xplace(g, g.ret_l)
    // несколько выходов: значения — по адресам, которые дал вызов
    count i from 0 to len(g.out_ptrs) - 1
        xload_var(g, xslot(g, g.out_names[i]))
        xbs(g, [0x48, 0x8B, 0x8D])
        x32(g, -8 * (g.out_ptrs[i] + 1))
        xbs(g, [0x48, 0x89, 0x01])
    if g.fa_slot >= 0
        keep = xslot(g, "#ret")
        xstore_var(g, keep)
        xbs(g, [0x8B, 0xBD])
        x32(g, -8 * (g.fa_slot + 1))
        xbs(g, [0x48, 0x8D, 0xB5])
        x32(g, -8 * (g.fm_slot + 2))
        xcall(g, "tb_x_fa_end")
        xload_var(g, keep)
    // mov rsp, rbp; pop rbp; ret
    xbs(g, [0x48, 0x89, 0xEC, 0x5D, 0xC3])
    put32(g, frame_at, (len(g.vars) * 8 + 15) / 16 * 16)
    count i from 0 to len(g.fix_at) - 1
        at = g.fix_at[i]
        put32(g, at, g.lpos[g.fix_l[i]] - (at + 4))

// ---------- файл ELF64 REL ----------

func eb(out: list int, v: int, n: int)
    count i from 0 to n - 1
        out.add(bit_and(shift_right(v, i * 8), 255))

func eal(out: list int, a: int)
    repeat while len(out) % a != 0
        out.add(0)

func estr(tab: list int, s: text) gives at: int
    at = len(tab)
    count i from 0 to byte_len(s) - 1
        tab.add(byte_at(s, i))
    tab.add(0)

func eshdr(out: list int, name: int, typ: int, flags: int, off: int, size: int, lnk: int, info: int, align: int, ent: int)
    eb(out, name, 4)
    eb(out, typ, 4)
    eb(out, flags, 8)
    eb(out, 0, 8)
    eb(out, off, 8)
    eb(out, size, 8)
    eb(out, lnk, 4)
    eb(out, info, 4)
    eb(out, align, 8)
    eb(out, ent, 8)

func xelf(g: X64) gives out: list int
    // символы: сначала местные (пусто, три части), потом общие — номера меняются, поправки следом
    strtab = [0]
    symtab = list int
    eb(symtab, 0, 24)
    count s from 1 to 3
        eb(symtab, 0, 4)
        eb(symtab, 3, 1)
        eb(symtab, 0, 1)
        eb(symtab, s, 2)
        eb(symtab, 0, 16)
    count k from 4 to len(g.snames) - 1
        eb(symtab, estr(strtab, g.snames[k]), 4)
        if g.sdef[k] >= 0
            eb(symtab, 0x12, 1)
            eb(symtab, 0, 1)
            eb(symtab, 1, 2)
            eb(symtab, g.sdef[k], 8)
        else
            eb(symtab, 0x10, 1)
            eb(symtab, 0, 1)
            eb(symtab, 0, 2)
            eb(symtab, 0, 8)
        eb(symtab, 0, 8)
    rela = list int
    count i from 0 to len(g.r_at) - 1
        eb(rela, g.r_at[i], 8)
        eb(rela, g.r_sym[i] * 4294967296 + g.r_type[i], 8)
        eb(rela, g.r_add[i], 8)
    sh = [0]
    n_text = estr(sh, ".text")
    n_ro = estr(sh, ".rodata")
    n_bss = estr(sh, ".bss")
    n_sym = estr(sh, ".symtab")
    n_str = estr(sh, ".strtab")
    n_rela = estr(sh, ".rela.text")
    n_sh = estr(sh, ".shstrtab")
    eb(out, 0x464C457F, 4)
    eb(out, 0x00010102, 4)
    eb(out, 0, 8)
    eb(out, 1, 2)
    eb(out, 62, 2)
    eb(out, 1, 4)
    eb(out, 0, 8)
    eb(out, 0, 8)
    shoff_at = len(out)
    eb(out, 0, 8)
    eb(out, 0, 4)
    eb(out, 64, 2)
    eb(out, 0, 2)
    eb(out, 0, 2)
    eb(out, 64, 2)
    eb(out, 8, 2)
    eb(out, 7, 2)
    eal(out, 16)
    o_text = len(out)
    each b in g.code
        out.add(b)
    o_ro = len(out)
    each b in g.ro
        out.add(b)
    eal(out, 8)
    o_sym = len(out)
    each b in symtab
        out.add(b)
    o_str = len(out)
    each b in strtab
        out.add(b)
    eal(out, 8)
    o_rela = len(out)
    each b in rela
        out.add(b)
    o_sh = len(out)
    each b in sh
        out.add(b)
    eal(out, 8)
    shoff = len(out)
    count i from 0 to 7
        out[shoff_at + i] = bit_and(shift_right(shoff, i * 8), 255)
    eb(out, 0, 64)
    eshdr(out, n_text, 1, 6, o_text, len(g.code), 0, 0, 16, 0)
    eshdr(out, n_ro, 1, 2, o_ro, len(g.ro), 0, 0, 1, 0)
    eshdr(out, n_bss, 8, 3, o_rela, g.bss, 0, 0, 8, 0)
    eshdr(out, n_sym, 2, 0, o_sym, len(symtab), 5, 4, 8, 24)
    eshdr(out, n_str, 3, 0, o_str, len(strtab), 0, 0, 1, 0)
    eshdr(out, n_rela, 4, 0x40, o_rela, len(rela), 4, 1, 8, 24)
    eshdr(out, n_sh, 3, 0, o_sh, len(sh), 0, 0, 1, 0)

// вся программа → байты файла .oapp; err — чего не смогли (тогда байты не нужны)
modpub func x64_app(c: Comp, program: Node) gives bytes: list int, err: text
    g = X64(err: "")
    g.snames = ["", ".text", ".rodata", ".bss"]
    g.sdef = [-1, -1, -1, -1]
    each gl in c.globals
        gk = kind_of(c, gl.ty)
        if gk != "int" and gk != "bool" and gk != "dec" and gk != "enum"
            xfail(g, gl.line, "shared типа " + gk)
        g.gnames.add(gl.name)
        g.goffs.add(g.bss)
        g.bss += 8
    main_func = program.kids[0]
    each top in program.kids
        if top.kind == "func" and top.name == "main" and top.mod == program.kids[0].mod
            main_func = top
    each top in program.kids
        if top.kind == "func"
            each p in top.kids[0].kids
                pk = kind_of(c, p.ty)
                if pk != "int" and pk != "bool" and pk != "text" and pk != "dec" and pk != "list" and pk != "obj" and pk != "enum" and pk != "dict"
                    xfail(g, top.line, "параметры типа " + pk)
            rk = kind_of(c, top.ty)
            if rk != "int" and rk != "bool" and rk != "text" and rk != "none" and rk != "dec" and rk != "list" and rk != "obj" and rk != "enum" and rk != "dict" and rk != "multi"
                xfail(g, top.line, "ответ типа " + rk)
            xfunc(g, c, top, ll_fname(top))
        else if top.kind == "obj" and top.by_cols
            xfail(g, top.line, "obj by columns")
        else if top.kind != "use" and top.kind != "global" and top.kind != "obj" and top.kind != "enum"
            xfail(g, top.line, "«" + top.kind + "» в начале файла")
    start = Node(kind: "appmain", ref: main_func, has_ref: true)
    xfunc(g, c, start, "tb_appmain")
    // функции печати: каждая может попросить ещё (список obj → obj)
    k = 0
    repeat while k < len(g.show_need)
        xshow_func(g, c, g.show_need[k])
        k += 1
    err = g.err
    if err == ""
        bytes = xelf(g)
