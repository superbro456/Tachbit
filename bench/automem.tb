// Память цикла без temp: 3 млн строк собираются, режутся и переводятся в большие буквы.
// Наружу уходит только число, поэтому компилятор сам отдаёт память каждого шага.
func shout(x: text)
    return upper(x) + "!"

func main()
    total = 0
    count i from 0 to 2999999
        line = "user" + i + ",city" + (i % 100) + ",45.10"
        parts = split(line, ",")
        total += len(shout(parts[0])) + len(parts)
    print(total)
