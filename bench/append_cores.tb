// Отчёт из 4 млн строк на всех ядрах: у каждого ядра свой кусок, += дописывает в его конец,
// в конце ядра по очереди кладут свои куски в общий out (порядок строк — какой ядро успело).
func main()
    shared out = ""
    count i from 0 to 3999999 on all cores
        x = i * i % 1000003
        out += "line " + i + ",value" + x + "\n"
    print(len(out))
