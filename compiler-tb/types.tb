// Tachbit 0.5 — общие объекты компилятора, написанного на самом Tachbit.
// Это тот же компилятор, что в compiler-c/, строчка в строчку,
// только вместо глобальных переменных — один объект Comp, который
// передаётся во все функции, а вместо чисел-видов — короткие слова.

// токен: kind = name / command / number / decimal / string / sign /
//              newline / indent / dedent / end
obj Token
    kind: text
    word: text
    line: int

// узел дерева: kind = program / func / param / block / obj / type / assign /
// set / linkdecl / multi / if / each / count / repeat_times / repeat_while /
// skip / stop / return / expr_stmt / number / decimal / string / bool / name /
// list / call / arg / binop / unary / index / field / method / dict / use /
// fail / try / else_err
obj Node
    kind: text
    line: int
    name: text
    value: text
    tsyn: Node
    has_tsyn: bool
    ty: int
    is_const: bool
    is_link: bool
    creates: bool
    ref: Node
    has_ref: bool
    mod: text
    file: text
    is_pub: bool
    can_fail: bool
    temp_no: int
    kids: list Node

// тип языка; хранится один раз, номер типа = место в списке Comp.types
// kind = unknown / none / int / dec / bool / text / list / obj / multi / dict
// key и elem — номера других типов (-1 — нет)
// номера 0..4 всегда: none, int, dec, bool, text
obj Type
    kind: text
    key: int
    elem: int
    obj_node: Node
    obj_name: text
    func_node: Node
    func_key: text
    id: int

obj Func
    name: text
    mod: text
    node: Node
    // 0 — ещё не проверена, 1 — проверяется сейчас, 2 — готова
    state: int

obj Use
    mod: text
    used: text

obj Var
    name: text
    type: int
    is_const: bool
    is_link: bool
    depth: int

// состояние всего компилятора
obj Comp
    file_name: text
    // лексер
    tokens: list Token
    // парсер
    pos: int
    // проверка
    types: list Type
    funcs: list Func
    objs: list Node
    uses: list Use
    all_mods: list text
    cur_mod: text
    vars: list Var
    depth: int
    var_base: int
    current: int
    loop_depth: int
    // типы скрытых переменных tb_t1, tb_t2 ... (номер 0 не занят)
    temp_types: list int
