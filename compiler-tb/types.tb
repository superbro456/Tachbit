// Tachbit 0.5 — общие объекты компилятора, написанного на самом Tachbit.
// Это тот же компилятор, что в compiler-c/, строчка в строчку,
// только вместо глобальных переменных — один объект Comp, который
// передаётся во все функции, а вместо чисел-видов — короткие слова.

// токен: kind = name / command / number / decimal / string / sign /
//              newline / indent / dedent / end
obj Token
    kind: text
    word: text
    line: int

// узел дерева: kind = program / func / param / block / obj / type / assign /
// set / linkdecl / multi / if / each / count / repeat_times / repeat_while /
// skip / stop / return / expr_stmt / number / decimal / string / bool / name /
// list / call / arg / binop / unary / index / field / method / dict / use /
// fail / try / else_err
obj Node
    kind: text
    line: int
    name: text
    value: text
    tsyn: Node
    has_tsyn: bool
    ty: int
    is_const: bool
    is_link: bool
    creates: bool
    ref: Node
    has_ref: bool
    mod: text
    file: text
    is_pub: bool
    can_fail: bool
    temp_no: int
    kids: list Node
    // 0.7: each / count ... on all cores; shared x = ...
    is_par: bool
    is_shared: bool
    // obj Point by columns
    by_cols: bool
    // each x in nums by vec
    by_vec: bool
    // each piece in data by 64: размер куска
    by_piece: bool
    piece_size: Node
    // заказ наперёд: в цикле есть data[x] (each x in idx) или data[idx[i]] (count i):
    // pre_bases — data, pre_idx — idx (у each — пустой узел)
    pre_bases: list Node
    pre_idx: list Node
    // качество obj: читают ли его в циклах (горячее) или редко (холодное — лежит отдельно)
    hot: bool
    is_cold: bool
    // переменные снаружи, которые видит цикл on all cores
    caps: list Var
    // func ... on keyboard / on timer / on interrupt N: номер прерывания (0 — обычная функция)
    irq: int

// тип языка; хранится один раз, номер типа = место в списке Comp.types
// kind = unknown / none / int / dec / bool / text / list / obj / multi / dict
// key и elem — номера других типов (-1 — нет)
// номера 0..4 всегда: none, int, dec, bool, text
obj Type
    kind: text
    key: int
    elem: int
    obj_node: Node
    obj_name: text
    func_node: Node
    func_key: text
    id: int

obj Func
    name: text
    mod: text
    node: Node
    // 0 — ещё не проверена, 1 — проверяется сейчас, 2 — готова
    state: int

obj Use
    mod: text
    used: text

obj Var
    name: text
    type: int
    is_const: bool
    is_link: bool
    depth: int
    is_shared: bool
    // by vec: как копится (+= или -=)
    op: text

// состояние всего компилятора
obj Comp
    file_name: text
    // лексер
    tokens: list Token
    // парсер
    pos: int
    // проверка
    types: list Type
    funcs: list Func
    objs: list Node
    uses: list Use
    all_mods: list text
    cur_mod: text
    vars: list Var
    depth: int
    var_base: int
    current: int
    loop_depth: int
    // типы скрытых переменных tb_t1, tb_t2 ... (номер 0 не занят)
    temp_types: list int
    // внутри on all cores: с какого номера начинаются свои переменные цикла (-1 — не внутри)
    par_base: int
    par_node: Node
    // внутри temp: с какого номера свои переменные блока (-1 — не внутри) и глубина циклов
    temp_base: int
    temp_loops: int
    shared_ok: bool
    // цикл by vec (у него те же правила «снаружи», что у on all cores)
    par_vec: bool
    // вывод C
    out: list text
    label: int
    cur_func: Node
    // функции-работники для on all cores: пишутся перед остальными функциями
    workers: list text
    // by vec: имена, которые в теле цикла пишутся иначе (y → tb_a7_y[tb_k])
    vec_names: list text
    vec_repl: list text
    // each piece in data by N: сколько таких циклов вокруг (return, fail, try внутри нельзя)
    piece_depth: int
    // все циклы с кусками: после проверки смотрим, что кусок нигде не сохраняется
    pieces: list Node
    // параметр функции, куда передали кусок: "имя@модуль#номер" → 1 можно, 2 сохраняется
    safe_keys: list text
    safe_vals: list int
    safe_busy: int
    // циклы each / count вокруг текущего места (для заказа наперёд)
    loops: list Node
    // горячие и холодные качества: кто где читает качества и кто кого зовёт из цикла
    acc_field: list Node
    acc_func: list int
    acc_loop: list bool
    call_from: list int
    call_to: list int
    call_loop: list bool
    // текстовые переменные текущей функции, в которые дописывают на месте (s += x)
    builders: list text
    // функция с временной ареной: имя метки (иначе пусто), и можно ли return при проверке
    fmark: text
    at_ret_ok: bool
    // режим «без ОС»: своё ядро, вывод на экран и в COM1, без malloc/printf
    bare: bool
    // внутри danger (сколько блоков вокруг), внутри lock и сколько циклов было снаружи lock
    danger_depth: int
    lock_depth: int
    lock_loops: int
    // имена замков (lock имя) и прерывания (номер:функция C) для вывода
    locks: list text
    irqs: list text
    // shared снаружи функций: первые n_globals переменных в vars — общие для всей программы
    n_globals: int
    globals: list Node
