// Сделано tools/embed_runtime.py из compiler-tb/runtime.h. Не правь руками.
modpub func runtime_text()
    lines = list text
    lines.add("// Библиотека, которую Tachbit кладёт в начало каждой программы на C.\n")
    lines.add("// Это обычный C. Компилятор на Tachbit встраивает этот текст через runtime_text.tb,\n")
    lines.add("// который делает tools/embed_runtime.py. Поменял этот файл — запусти:\n")
    lines.add("//     python3 tools/embed_runtime.py\n")
    lines.add("#include <stdio.h>\n")
    lines.add("#include <stdlib.h>\n")
    lines.add("#include <string.h>\n")
    lines.add("#include <math.h>\n")
    lines.add("#include <pthread.h>\n")
    lines.add("#include <unistd.h>\n")
    lines.add("\n")
    lines.add("// подсказки для clang / gcc: ошибка бывает редко, а tb_crash не возвращается\n")
    lines.add("#if defined(__GNUC__)\n")
    lines.add("#define TB_RARE(x) __builtin_expect(!!(x), 0)\n")
    lines.add("#define TB_COLD __attribute__((cold, noreturn, noinline))\n")
    lines.add("#else\n")
    lines.add("#define TB_RARE(x) (x)\n")
    lines.add("#define TB_COLD\n")
    lines.add("#endif\n")
    lines.add("\n")
    lines.add("// список: кусок памяти, len элементов по size байт, место на cap\n")
    lines.add("typedef struct { char *data; long long len; long long cap; long long size; } tb_list;\n")
    lines.add("\n")
    lines.add("TB_COLD static void tb_crash(int line, const char *msg) {\n")
    lines.add("    fflush(stdout);\n")
    lines.add("    // в терминале — красным (если не задан NO_COLOR)\n")
    lines.add("    int color = isatty(2) && getenv(\"NO_COLOR\") == 0;\n")
    lines.add("    if (color) fputs(\"\\033[31m\", stderr);\n")
    lines.add("    if (line > 0) fprintf(stderr, \"строка %d: %s\", line, msg);\n")
    lines.add("    else fprintf(stderr, \"%s\", msg);\n")
    lines.add("    fputs(color ? \"\\033[0m\\n\" : \"\\n\", stderr);\n")
    lines.add("    exit(1);\n")
    lines.add("}\n")
    lines.add("// ---------- temp: временная память ----------\n")
    lines.add("// Внутри блока temp память берётся из больших кусков подряд (быстро, без malloc),\n")
    lines.add("// а в конце блока все куски отдаются разом. У каждого ядра свои куски.\n")
    lines.add("typedef struct { char *mem; long long size, used; } tb_chunk;\n")
    lines.add("typedef struct { int n; long long used; } tb_mark;\n")
    lines.add("static _Thread_local tb_chunk *tb_chunks = 0;\n")
    lines.add("static _Thread_local int tb_nchunks = 0, tb_capchunks = 0, tb_temp_depth = 0;\n")
    lines.add("static int tb_in_temp(const void *p) {\n")
    lines.add("    for (int i = tb_nchunks - 1; i >= 0; i--) {\n")
    lines.add("        if ((const char *)p >= tb_chunks[i].mem && (const char *)p < tb_chunks[i].mem + tb_chunks[i].size) return 1;\n")
    lines.add("    }\n")
    lines.add("    return 0;\n")
    lines.add("}\n")
    lines.add("static void *tb_temp_alloc(long long n) {\n")
    lines.add("    n = n > 0 ? (n + 15) & ~15LL : 16;\n")
    lines.add("    tb_chunk *c = tb_nchunks > 0 ? &tb_chunks[tb_nchunks - 1] : 0;\n")
    lines.add("    if (c == 0 || c->used + n > c->size) {\n")
    lines.add("        long long size = c != 0 ? c->size * 2 : (1LL << 20);\n")
    lines.add("        if (size < n) size = n;\n")
    lines.add("        if (tb_nchunks == tb_capchunks) {\n")
    lines.add("            tb_capchunks = tb_capchunks * 2 + 8;\n")
    lines.add("            tb_chunks = realloc(tb_chunks, sizeof(tb_chunk) * tb_capchunks);\n")
    lines.add("            if (tb_chunks == 0) tb_crash(0, \"не хватило памяти\");\n")
    lines.add("        }\n")
    lines.add("        char *mem = malloc(size);\n")
    lines.add("        if (mem == 0) tb_crash(0, \"не хватило памяти\");\n")
    lines.add("        tb_chunks[tb_nchunks] = (tb_chunk){mem, size, 0};\n")
    lines.add("        c = &tb_chunks[tb_nchunks];\n")
    lines.add("        tb_nchunks += 1;\n")
    lines.add("    }\n")
    lines.add("    void *p = c->mem + c->used;\n")
    lines.add("    c->used += n;\n")
    lines.add("    return p;\n")
    lines.add("}\n")
    lines.add("static tb_mark tb_temp_begin(void) {\n")
    lines.add("    tb_temp_depth += 1;\n")
    lines.add("    return (tb_mark){tb_nchunks, tb_nchunks > 0 ? tb_chunks[tb_nchunks - 1].used : 0};\n")
    lines.add("}\n")
    lines.add("static void tb_temp_end(tb_mark m) {\n")
    lines.add("    // первый кусок оставляем пустым: следующий temp возьмёт его без malloc\n")
    lines.add("    while (tb_nchunks > m.n && tb_nchunks > 1) {\n")
    lines.add("        tb_nchunks -= 1;\n")
    lines.add("        free(tb_chunks[tb_nchunks].mem);\n")
    lines.add("    }\n")
    lines.add("    if (tb_nchunks > m.n) tb_chunks[0].used = 0;\n")
    lines.add("    else if (tb_nchunks > 0) tb_chunks[tb_nchunks - 1].used = m.used;\n")
    lines.add("    tb_temp_depth -= 1;\n")
    lines.add("}\n")
    lines.add("static void *tb_mem(long long n) {\n")
    lines.add("    if (tb_temp_depth > 0) return tb_temp_alloc(n);\n")
    lines.add("    void *p = malloc(n > 0 ? n : 1);\n")
    lines.add("    if (p == 0) tb_crash(0, \"не хватило памяти\");\n")
    lines.add("    return p;\n")
    lines.add("}\n")
    lines.add("// вырасти кусок: временный растёт во временной памяти, обычный — через realloc\n")
    lines.add("static void *tb_resize(void *p, long long old_n, long long new_n) {\n")
    lines.add("    if (tb_nchunks > 0 && tb_in_temp(p)) {\n")
    lines.add("        void *q = tb_temp_alloc(new_n);\n")
    lines.add("        memcpy(q, p, old_n);\n")
    lines.add("        return q;\n")
    lines.add("    }\n")
    lines.add("    p = realloc(p, new_n > 0 ? new_n : 1);\n")
    lines.add("    if (p == 0) tb_crash(0, \"не хватило памяти\");\n")
    lines.add("    return p;\n")
    lines.add("}\n")
    lines.add("static tb_list *tb_list_new(long long size) {\n")
    lines.add("    tb_list *l = tb_mem(sizeof(tb_list));\n")
    lines.add("    l->len = 0; l->cap = 4; l->size = size; l->data = tb_mem(size * 4);\n")
    lines.add("    return l;\n")
    lines.add("}\n")
    lines.add("static tb_list *tb_list_from(long long n, long long size, const void *src) {\n")
    lines.add("    tb_list *l = tb_mem(sizeof(tb_list));\n")
    lines.add("    l->len = n; l->cap = n; l->size = size; l->data = tb_mem(size * n);\n")
    lines.add("    memcpy(l->data, src, size * n);\n")
    lines.add("    return l;\n")
    lines.add("}\n")
    lines.add("// size передаётся как sizeof(T): после встраивания C знает его заранее\n")
    lines.add("static inline void *tb_at(tb_list *l, long long i, long long size, int line) {\n")
    lines.add("    // одно сравнение вместо двух: отрицательный номер как unsigned становится огромным\n")
    lines.add("    if (TB_RARE((unsigned long long)i >= (unsigned long long)l->len)) tb_crash(line, \"номер за пределами списка\");\n")
    lines.add("    return l->data + i * size;\n")
    lines.add("}\n")
    lines.add("static inline void *tb_grow(tb_list *l) {\n")
    lines.add("    // cap < 0: это кусок (each piece in data by N) или список, который сейчас режут на куски\n")
    lines.add("    if (TB_RARE(l->len >= l->cap)) {\n")
    lines.add("        if (l->cap < 0) tb_crash(0, \"список нельзя растить, пока по нему идёт each ... by N (и сам кусок растить нельзя)\");\n")
    lines.add("        long long old = l->cap * l->size;\n")
    lines.add("        l->cap = l->cap * 2 + 4;\n")
    lines.add("        // realloc часто растит большой кусок на месте, без копирования\n")
    lines.add("        l->data = tb_resize(l->data, old, l->cap * l->size);\n")
    lines.add("    }\n")
    lines.add("    l->len += 1;\n")
    lines.add("    return l->data + (l->len - 1) * l->size;\n")
    lines.add("}\n")
    lines.add("static void *tb_pop(tb_list *l, int line) {\n")
    lines.add("    if (l->len == 0) tb_crash(line, \".pop() у пустого списка\");\n")
    lines.add("    l->len -= 1;\n")
    lines.add("    return l->data + l->len * l->size;\n")
    lines.add("}\n")
    lines.add("static void *tb_nn(void *p, int line) {\n")
    lines.add("    if (p == 0) tb_crash(line, \"obj пустой: его ещё не создали\");\n")
    lines.add("    return p;\n")
    lines.add("}\n")
    lines.add("static const char *tb_cat(const char *a, const char *b) {\n")
    lines.add("    size_t la = strlen(a), lb = strlen(b);\n")
    lines.add("    char *s = tb_mem(la + lb + 1);\n")
    lines.add("    memcpy(s, a, la);\n")
    lines.add("    memcpy(s + la, b, lb + 1);\n")
    lines.add("    return s;\n")
    lines.add("}\n")
    lines.add("static const char *tb_itos(long long x) { char *s = tb_mem(32); snprintf(s, 32, \"%lld\", x); return s; }\n")
    lines.add("static const char *tb_dtos(double x) { char *s = tb_mem(40); snprintf(s, 40, \"%g\", x); return s; }\n")
    lines.add("static const char *tb_btos(int x) { return x ? \"true\" : \"false\"; }\n")
    lines.add("// текст из одного байта: 256 готовых строк, без выделения памяти на каждую букву\n")
    lines.add("static char tb_chars[512];\n")
    lines.add("__attribute__((constructor)) static void tb_chars_init(void) {\n")
    lines.add("    for (int i = 0; i < 256; i++) { tb_chars[2 * i] = (char)i; tb_chars[2 * i + 1] = 0; }\n")
    lines.add("}\n")
    lines.add("static inline const char *tb_chr(long long c) { return tb_chars + 2 * (unsigned char)c; }\n")
    lines.add("static const char *tb_char_at(const char *s, long long i, int line) {\n")
    lines.add("    if (i < 0 || i >= (long long)strlen(s)) tb_crash(line, \"номер за пределами текста\");\n")
    lines.add("    return tb_chr((unsigned char)s[i]);\n")
    lines.add("}\n")
    lines.add("static const char *tb_cut(const char *s, long long from, long long to, int line) {\n")
    lines.add("    long long n = (long long)strlen(s);\n")
    lines.add("    if (from < 0 || to >= n || from > to + 1) tb_crash(line, \"cut: номера за пределами текста\");\n")
    lines.add("    char *r = tb_mem(to - from + 2);\n")
    lines.add("    memcpy(r, s + from, to - from + 1);\n")
    lines.add("    r[to - from + 1] = 0;\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("static long long tb_code(const char *s, int line) {\n")
    lines.add("    if (s[0] == 0) tb_crash(line, \"code: текст пустой\");\n")
    lines.add("    return (unsigned char)s[0];\n")
    lines.add("}\n")
    lines.add("static long long tb_div(long long a, long long b, int line) { if (b == 0) tb_crash(line, \"деление на ноль\"); return a / b; }\n")
    lines.add("static long long tb_mod(long long a, long long b, int line) { if (b == 0) tb_crash(line, \"остаток от деления на ноль\"); return a % b; }\n")
    lines.add("static long long tb_round(double x) { return (long long)(x < 0 ? x - 0.5 : x + 0.5); }\n")
    lines.add("static void tb_ps(const char *s) { fputs(s, stdout); }\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("\n")
    lines.add("// ---------- ошибки fail / try / or / else err ----------\n")
    lines.add("// Функция, которая сломалась, кладёт текст ошибки в tb_err и сразу выходит.\n")
    lines.add("// Тот, кто её вызвал, смотрит в tb_err.\n")
    lines.add("static _Thread_local const char *tb_err = 0;   // у каждого ядра своя\n")
    lines.add("\n")
    lines.add("TB_COLD static void tb_die(const char *msg) {\n")
    lines.add("    fflush(stdout);\n")
    lines.add("    fprintf(stderr, \"ошибка: %s\\n\", msg);\n")
    lines.add("    exit(1);\n")
    lines.add("}\n")
    lines.add("\n")
    lines.add("// ---------- текст ----------\n")
    lines.add("static const char *tb_upper(const char *s) {\n")
    lines.add("    size_t n = strlen(s); char *r = tb_mem(n + 1);\n")
    lines.add("    for (size_t i = 0; i <= n; i++) r[i] = (s[i] >= 'a' && s[i] <= 'z') ? s[i] - 32 : s[i];\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("static const char *tb_lower(const char *s) {\n")
    lines.add("    size_t n = strlen(s); char *r = tb_mem(n + 1);\n")
    lines.add("    for (size_t i = 0; i <= n; i++) r[i] = (s[i] >= 'A' && s[i] <= 'Z') ? s[i] + 32 : s[i];\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("static int tb_space(char c) { return c == ' ' || c == '\\t' || c == '\\n' || c == '\\r'; }\n")
    lines.add("static const char *tb_trim(const char *s) {\n")
    lines.add("    size_t a = 0, b = strlen(s);\n")
    lines.add("    while (a < b && tb_space(s[a])) a++;\n")
    lines.add("    while (b > a && tb_space(s[b - 1])) b--;\n")
    lines.add("    char *r = tb_mem(b - a + 1); memcpy(r, s + a, b - a); r[b - a] = 0;\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("static long long tb_find(const char *s, const char *part) {\n")
    lines.add("    const char *p = strstr(s, part);\n")
    lines.add("    return p ? (long long)(p - s) : -1;\n")
    lines.add("}\n")
    lines.add("static int tb_starts(const char *s, const char *p) { return strncmp(s, p, strlen(p)) == 0; }\n")
    lines.add("static int tb_ends(const char *s, const char *p) {\n")
    lines.add("    size_t a = strlen(s), b = strlen(p);\n")
    lines.add("    return b <= a && strcmp(s + a - b, p) == 0;\n")
    lines.add("}\n")
    lines.add("static const char *tb_replace(const char *s, const char *from, const char *to, int line) {\n")
    lines.add("    size_t lf = strlen(from), lt = strlen(to), count = 0;\n")
    lines.add("    if (lf == 0) tb_crash(line, \"replace: что заменять — пустой текст\");\n")
    lines.add("    for (const char *p = strstr(s, from); p; p = strstr(p + lf, from)) count++;\n")
    lines.add("    char *r = tb_mem(strlen(s) + count * lt + 1), *w = r;\n")
    lines.add("    const char *p = s, *q;\n")
    lines.add("    while ((q = strstr(p, from)) != 0) {\n")
    lines.add("        memcpy(w, p, q - p); w += q - p;\n")
    lines.add("        memcpy(w, to, lt); w += lt;\n")
    lines.add("        p = q + lf;\n")
    lines.add("    }\n")
    lines.add("    strcpy(w, p);\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("static tb_list *tb_split(const char *s, const char *sep, int line) {\n")
    lines.add("    size_t ls = strlen(sep);\n")
    lines.add("    if (ls == 0) tb_crash(line, \"split: разделитель — пустой текст\");\n")
    lines.add("    tb_list *l = tb_list_new(sizeof(const char *));\n")
    lines.add("    const char *p = s, *q;\n")
    lines.add("    while (1) {\n")
    lines.add("        q = strstr(p, sep);\n")
    lines.add("        size_t n = q ? (size_t)(q - p) : strlen(p);\n")
    lines.add("        char *part = tb_mem(n + 1); memcpy(part, p, n); part[n] = 0;\n")
    lines.add("        *(const char **)tb_grow(l) = part;\n")
    lines.add("        if (!q) break;\n")
    lines.add("        p = q + ls;\n")
    lines.add("    }\n")
    lines.add("    return l;\n")
    lines.add("}\n")
    lines.add("static const char *tb_join(tb_list *l, const char *sep) {\n")
    lines.add("    size_t n = 0, ls = strlen(sep);\n")
    lines.add("    for (long long i = 0; i < l->len; i++) n += strlen(((const char **)l->data)[i]) + ls;\n")
    lines.add("    char *r = tb_mem(n + 1), *w = r;\n")
    lines.add("    for (long long i = 0; i < l->len; i++) {\n")
    lines.add("        const char *part = ((const char **)l->data)[i];\n")
    lines.add("        if (i > 0) { memcpy(w, sep, ls); w += ls; }\n")
    lines.add("        memcpy(w, part, strlen(part)); w += strlen(part);\n")
    lines.add("    }\n")
    lines.add("    *w = 0;\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("static long long tb_to_int(const char *s) {\n")
    lines.add("    long long v = 0; int i = 0, minus = 0;\n")
    lines.add("    if (s[0] == '-') { minus = 1; i = 1; }\n")
    lines.add("    if (s[i] == 0) { tb_err = tb_cat(\"это не число: \", s); return 0; }\n")
    lines.add("    for (; s[i]; i++) {\n")
    lines.add("        if (s[i] < '0' || s[i] > '9') { tb_err = tb_cat(\"это не число: \", s); return 0; }\n")
    lines.add("        v = v * 10 + (s[i] - '0');\n")
    lines.add("    }\n")
    lines.add("    return minus ? -v : v;\n")
    lines.add("}\n")
    lines.add("static double tb_to_dec(const char *s) {\n")
    lines.add("    char *end = 0;\n")
    lines.add("    double v = strtod(s, &end);\n")
    lines.add("    if (s[0] == 0 || *end != 0) { tb_err = tb_cat(\"это не дробное число: \", s); return 0; }\n")
    lines.add("    return v;\n")
    lines.add("}\n")
    lines.add("\n")
    lines.add("// ---------- файлы, ввод, слова запуска ----------\n")
    lines.add("static const char *tb_read_file(const char *path) {\n")
    lines.add("    FILE *f = fopen(path, \"rb\");\n")
    lines.add("    if (f == 0) { tb_err = tb_cat(\"не могу открыть файл: \", path); return \"\"; }\n")
    lines.add("    size_t cap = 4096, n = 0, got;\n")
    lines.add("    char *buf = tb_mem(cap);\n")
    lines.add("    while ((got = fread(buf + n, 1, cap - n - 1, f)) > 0) {\n")
    lines.add("        n += got;\n")
    lines.add("        if (n + 1 == cap) { buf = tb_resize(buf, cap, cap * 2); cap *= 2; }\n")
    lines.add("    }\n")
    lines.add("    fclose(f);\n")
    lines.add("    buf[n] = 0;\n")
    lines.add("    return buf;\n")
    lines.add("}\n")
    lines.add("static void tb_write_file(const char *path, const char *s) {\n")
    lines.add("    FILE *f = fopen(path, \"wb\");\n")
    lines.add("    if (f == 0) { tb_err = tb_cat(\"не могу записать файл: \", path); return; }\n")
    lines.add("    fputs(s, f);\n")
    lines.add("    fclose(f);\n")
    lines.add("}\n")
    lines.add("static const char *tb_input(void) {\n")
    lines.add("    fflush(stdout);\n")
    lines.add("    size_t cap = 256, n = 0;\n")
    lines.add("    char *buf = tb_mem(cap);\n")
    lines.add("    int c;\n")
    lines.add("    while ((c = getchar()) != EOF && c != '\\n') {\n")
    lines.add("        if (n + 1 == cap) { buf = tb_resize(buf, cap, cap * 2); cap *= 2; }\n")
    lines.add("        buf[n++] = (char)c;\n")
    lines.add("    }\n")
    lines.add("    if (c == EOF && n == 0) { tb_err = \"ввод кончился\"; return \"\"; }\n")
    lines.add("    if (n > 0 && buf[n - 1] == '\\r') n--;\n")
    lines.add("    buf[n] = 0;\n")
    lines.add("    return buf;\n")
    lines.add("}\n")
    lines.add("static tb_list *tb_args;\n")
    lines.add("static long long tb_run(const char *command) {\n")
    lines.add("    fflush(stdout);\n")
    lines.add("    int code = system(command);\n")
    lines.add("    if (code == -1) return -1;\n")
    lines.add("    return code == 0 ? 0 : (code > 255 ? code / 256 : code);\n")
    lines.add("}\n")
    lines.add("static void tb_exit(long long code) { fflush(stdout); exit((int)code); }\n")
    lines.add("static int tb_file_exists(const char *path) {\n")
    lines.add("    FILE *f = fopen(path, \"rb\");\n")
    lines.add("    if (f == 0) return 0;\n")
    lines.add("    fclose(f);\n")
    lines.add("    return 1;\n")
    lines.add("}\n")
    lines.add("\n")
    lines.add("// ---------- числа ----------\n")
    lines.add("static long long tb_absi(long long x) { return x < 0 ? -x : x; }\n")
    lines.add("static long long tb_mini(long long a, long long b) { return a < b ? a : b; }\n")
    lines.add("static long long tb_maxi(long long a, long long b) { return a > b ? a : b; }\n")
    lines.add("static double tb_mind(double a, double b) { return a < b ? a : b; }\n")
    lines.add("static double tb_maxd(double a, double b) { return a > b ? a : b; }\n")
    lines.add("static double tb_sqrt(double x, int line) { if (x < 0) tb_crash(line, \"sqrt: корень из отрицательного числа\"); return sqrt(x); }\n")
    lines.add("\n")
    lines.add("// ---------- sort ----------\n")
    lines.add("static int tb_cmp_int(const void *a, const void *b) { long long x = *(const long long *)a, y = *(const long long *)b; return (x > y) - (x < y); }\n")
    lines.add("static int tb_cmp_dec(const void *a, const void *b) { double x = *(const double *)a, y = *(const double *)b; return (x > y) - (x < y); }\n")
    lines.add("static int tb_cmp_text(const void *a, const void *b) { return strcmp(*(const char * const *)a, *(const char * const *)b); }\n")
    lines.add("static tb_list *tb_copy(tb_list *l) { return tb_list_from(l->len, l->size, l->data); }\n")
    lines.add("static void tb_sort_list(tb_list *l, int (*cmp)(const void *, const void *)) { qsort(l->data, l->len, l->size, cmp); }\n")
    lines.add("\n")
    lines.add("// ---------- dict: ключи и значения лежат в двух списках по порядку добавления,\n")
    lines.add("// а найти номер по ключу можно тремя способами (mode):\n")
    lines.add("//   1 — «номер = адрес»: ключи int шли подряд base, base+1, base+2 ... — номер = ключ - base, без поиска;\n")
    lines.add("//   2 — «адресное хранение»: ключи int лежат плотно — pos[ключ - base] = номер + 1, один взгляд;\n")
    lines.add("//   0 — таблица slots с хешем (текст или разбросанные числа) ----------\n")
    lines.add("typedef struct {\n")
    lines.add("    tb_list *keys; tb_list *vals; long long *slots; long long nslots; int text;\n")
    lines.add("    int mode; long long base; long long *pos; long long npos;\n")
    lines.add("} tb_dict;\n")
    lines.add("\n")
    lines.add("static unsigned long long tb_hash(tb_dict *d, const void *k) {\n")
    lines.add("    unsigned long long h = 1469598103934665603ULL;\n")
    lines.add("    if (d->text) {\n")
    lines.add("        for (const unsigned char *p = *(const unsigned char * const *)k; *p; p++) { h ^= *p; h *= 1099511628211ULL; }\n")
    lines.add("    } else {\n")
    lines.add("        h ^= (unsigned long long)*(const long long *)k;\n")
    lines.add("        h *= 0x9E3779B97F4A7C15ULL;\n")
    lines.add("        h ^= h >> 32;\n")
    lines.add("    }\n")
    lines.add("    return h;\n")
    lines.add("}\n")
    lines.add("static int tb_keq(tb_dict *d, const void *a, const void *b) {\n")
    lines.add("    if (d->text) return strcmp(*(const char * const *)a, *(const char * const *)b) == 0;\n")
    lines.add("    return *(const long long *)a == *(const long long *)b;\n")
    lines.add("}\n")
    lines.add("static inline long long tb_dfind(tb_dict *d, const void *k) {\n")
    lines.add("    if (d->mode == 1) {\n")
    lines.add("        unsigned long long at = (unsigned long long)(*(const long long *)k - d->base);\n")
    lines.add("        return at < (unsigned long long)d->keys->len ? (long long)at : -1;\n")
    lines.add("    }\n")
    lines.add("    if (d->mode == 2) {\n")
    lines.add("        unsigned long long o = (unsigned long long)(*(const long long *)k - d->base);\n")
    lines.add("        return o < (unsigned long long)d->npos ? d->pos[o] - 1 : -1;\n")
    lines.add("    }\n")
    lines.add("    unsigned long long mask = d->nslots - 1, i = tb_hash(d, k) & mask;\n")
    lines.add("    while (d->slots[i] != 0) {\n")
    lines.add("        long long at = d->slots[i] - 1;\n")
    lines.add("        if (tb_keq(d, d->keys->data + at * d->keys->size, k)) return at;\n")
    lines.add("        i = (i + 1) & mask;\n")
    lines.add("    }\n")
    lines.add("    return -1;\n")
    lines.add("}\n")
    lines.add("// память для таблиц dict — там же, где лежат его ключи (временная или обычная)\n")
    lines.add("static void *tb_dalloc(tb_dict *d, void *old, long long bytes) {\n")
    lines.add("    int in_temp = tb_nchunks > 0 && tb_in_temp(d->keys->data);\n")
    lines.add("    if (old && !in_temp) free(old);\n")
    lines.add("    void *p = in_temp ? tb_temp_alloc(bytes) : malloc(bytes);\n")
    lines.add("    if (!p) tb_crash(0, \"не хватило памяти\");\n")
    lines.add("    return p;\n")
    lines.add("}\n")
    lines.add("static void tb_dreindex(tb_dict *d, long long nslots) {\n")
    lines.add("    d->mode = 0;\n")
    lines.add("    if (d->pos) {\n")
    lines.add("        if (!(tb_nchunks > 0 && tb_in_temp(d->pos))) free(d->pos);\n")
    lines.add("        d->pos = 0; d->npos = 0;\n")
    lines.add("    }\n")
    lines.add("    d->nslots = nslots;\n")
    lines.add("    d->slots = tb_dalloc(d, d->slots, nslots * sizeof(long long));\n")
    lines.add("    memset(d->slots, 0, nslots * sizeof(long long));\n")
    lines.add("    unsigned long long mask = nslots - 1;\n")
    lines.add("    for (long long at = 0; at < d->keys->len; at++) {\n")
    lines.add("        unsigned long long i = tb_hash(d, d->keys->data + at * d->keys->size) & mask;\n")
    lines.add("        while (d->slots[i] != 0) i = (i + 1) & mask;\n")
    lines.add("        d->slots[i] = at + 1;\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("// перейти на таблицу с хешем (ключ ушёл далеко от остальных или его удалили)\n")
    lines.add("static void tb_dto_hash(tb_dict *d) {\n")
    lines.add("    long long n = 8;\n")
    lines.add("    while (n < d->keys->len * 2 + 2) n *= 2;\n")
    lines.add("    tb_dreindex(d, n);\n")
    lines.add("}\n")
    lines.add("// mode 2: таблица pos на ключи base .. base+npos-1\n")
    lines.add("static void tb_dto_pos(tb_dict *d, long long npos) {\n")
    lines.add("    long long *p = tb_dalloc(d, 0, npos * sizeof(long long));\n")
    lines.add("    memset(p, 0, npos * sizeof(long long));\n")
    lines.add("    const long long *ks = (const long long *)d->keys->data;\n")
    lines.add("    for (long long at = 0; at < d->keys->len; at++) p[ks[at] - d->base] = at + 1;\n")
    lines.add("    if (d->pos && !(tb_nchunks > 0 && tb_in_temp(d->pos))) free(d->pos);\n")
    lines.add("    d->pos = p;\n")
    lines.add("    d->npos = npos;\n")
    lines.add("    d->mode = 2;\n")
    lines.add("}\n")
    lines.add("static tb_dict *tb_dict_new(int text, long long vsize) {\n")
    lines.add("    tb_dict *d = tb_mem(sizeof(tb_dict));\n")
    lines.add("    d->text = text;\n")
    lines.add("    d->keys = tb_list_new(text ? sizeof(const char *) : sizeof(long long));\n")
    lines.add("    d->vals = tb_list_new(vsize);\n")
    lines.add("    d->slots = 0; d->pos = 0; d->npos = 0; d->base = 0;\n")
    lines.add("    if (text) tb_dreindex(d, 8);\n")
    lines.add("    else { d->mode = 1; d->nslots = 0; }\n")
    lines.add("    return d;\n")
    lines.add("}\n")
    lines.add("// новый ключ int k: можно ли остаться без поиска (mode 1 или 2)\n")
    lines.add("static void tb_dplace_int(tb_dict *d, long long k) {\n")
    lines.add("    long long n = d->keys->len;          // уже вместе с новым ключом\n")
    lines.add("    if (d->mode == 1) {\n")
    lines.add("        if (n == 1) { d->base = k; return; }\n")
    lines.add("        if (k == d->base + n - 1) return;  // подряд — остаёмся в mode 1\n")
    lines.add("    }\n")
    lines.add("    if (d->mode == 1 || d->mode == 2) {\n")
    lines.add("        // плотно ли: ключи не дальше 4 ячеек на один ключ\n")
    lines.add("        long long o = k - d->base;\n")
    lines.add("        if (o >= 0 && o < 4 * n + 64) {\n")
    lines.add("            if (d->mode == 2 && o < d->npos) { d->pos[o] = n; return; }\n")
    lines.add("            long long want = d->npos * 2 > o + 1 ? d->npos * 2 : o + 1 + n;\n")
    lines.add("            if (want < 16) want = 16;\n")
    lines.add("            tb_dto_pos(d, want);\n")
    lines.add("            return;\n")
    lines.add("        }\n")
    lines.add("        tb_dto_hash(d);\n")
    lines.add("        return;\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("// место под значение ключа k; если ключа нет — добавить со значением *def\n")
    lines.add("static void *tb_dput(tb_dict *d, const void *k, const void *def) {\n")
    lines.add("    long long at = tb_dfind(d, k);\n")
    lines.add("    if (at >= 0) return d->vals->data + at * d->vals->size;\n")
    lines.add("    memcpy(tb_grow(d->keys), k, d->keys->size);\n")
    lines.add("    void *v = tb_grow(d->vals);\n")
    lines.add("    if (def) memcpy(v, def, d->vals->size); else memset(v, 0, d->vals->size);\n")
    lines.add("    if (d->mode != 0) {\n")
    lines.add("        // без поиска; если ключ лёг далеко, tb_dplace_int сам перейдёт на хеш и впишет все ключи\n")
    lines.add("        tb_dplace_int(d, *(const long long *)k);\n")
    lines.add("        return v;\n")
    lines.add("    }\n")
    lines.add("    if (d->keys->len * 2 > d->nslots) tb_dreindex(d, d->nslots * 2);\n")
    lines.add("    else {\n")
    lines.add("        unsigned long long mask = d->nslots - 1, i = tb_hash(d, k) & mask;\n")
    lines.add("        while (d->slots[i] != 0) i = (i + 1) & mask;\n")
    lines.add("        d->slots[i] = d->keys->len;\n")
    lines.add("    }\n")
    lines.add("    return v;\n")
    lines.add("}\n")
    lines.add("static void *tb_dget(tb_dict *d, const void *k, int line) {\n")
    lines.add("    long long at = tb_dfind(d, k);\n")
    lines.add("    if (TB_RARE(at < 0)) {\n")
    lines.add("        if (d->text) tb_crash(line, tb_cat(\"в dict нет ключа: \", *(const char * const *)k));\n")
    lines.add("        tb_crash(line, tb_cat(\"в dict нет ключа: \", tb_itos(*(const long long *)k)));\n")
    lines.add("    }\n")
    lines.add("    return d->vals->data + at * d->vals->size;\n")
    lines.add("}\n")
    lines.add("// together: шаг 1 — просим память принести место ключа заранее\n")
    lines.add("static inline unsigned long long tb_dpre1(tb_dict *d, const void *k) {\n")
    lines.add("    if (d->mode == 1) {\n")
    lines.add("        unsigned long long at = (unsigned long long)(*(const long long *)k - d->base);\n")
    lines.add("        if (at < (unsigned long long)d->vals->len) __builtin_prefetch(d->vals->data + at * d->vals->size);\n")
    lines.add("        return ~0ULL;\n")
    lines.add("    }\n")
    lines.add("    if (d->mode == 2) {\n")
    lines.add("        unsigned long long o = (unsigned long long)(*(const long long *)k - d->base);\n")
    lines.add("        if (o < (unsigned long long)d->npos) { __builtin_prefetch(&d->pos[o]); return o; }\n")
    lines.add("        return ~0ULL;\n")
    lines.add("    }\n")
    lines.add("    unsigned long long i = tb_hash(d, k) & (d->nslots - 1);\n")
    lines.add("    __builtin_prefetch(&d->slots[i]);\n")
    lines.add("    return i;\n")
    lines.add("}\n")
    lines.add("// шаг 2 — место приехало: просим принести ключ и значение\n")
    lines.add("static inline void tb_dpre2(tb_dict *d, unsigned long long i) {\n")
    lines.add("    if (i == ~0ULL || d->mode == 1) return;\n")
    lines.add("    long long s = d->mode == 2 ? d->pos[i] : d->slots[i];\n")
    lines.add("    if (s != 0) {\n")
    lines.add("        if (d->mode == 0) __builtin_prefetch(d->keys->data + (s - 1) * d->keys->size);\n")
    lines.add("        __builtin_prefetch(d->vals->data + (s - 1) * d->vals->size);\n")
    lines.add("    }\n")
    lines.add("}\n")
    lines.add("// элемент списка заранее (prefetch за пределами списка ничего не ломает)\n")
    lines.add("static inline void tb_lpre(tb_list *l, long long i) {\n")
    lines.add("    __builtin_prefetch(l->data + i * l->size);\n")
    lines.add("}\n")
    lines.add("// ---------- холодные качества obj: своя память, подряд, отдельно от горячих ----------\n")
    lines.add("static void *tb_cold_mem(long long n) {\n")
    lines.add("    if (tb_temp_depth > 0) return tb_mem(n);\n")
    lines.add("    static _Thread_local char *p = 0;\n")
    lines.add("    static _Thread_local long long left = 0;\n")
    lines.add("    n = (n + 15) & ~15LL;\n")
    lines.add("    if (left < n) {\n")
    lines.add("        long long size = n > 65536 ? n : 65536;\n")
    lines.add("        p = malloc(size);\n")
    lines.add("        if (!p) tb_crash(0, \"не хватило памяти\");\n")
    lines.add("        left = size;\n")
    lines.add("    }\n")
    lines.add("    void *r = p;\n")
    lines.add("    p += n;\n")
    lines.add("    left -= n;\n")
    lines.add("    memset(r, 0, n);\n")
    lines.add("    return r;\n")
    lines.add("}\n")
    lines.add("// ---------- background: работа в своём потоке ----------\n")
    lines.add("typedef struct { pthread_t th; int done; void *res; } tb_task;\n")
    lines.add("static void tb_task_start(tb_task *t, void *(*run)(void *), void *arg) {\n")
    lines.add("    t->done = 0;\n")
    lines.add("    if (pthread_create(&t->th, 0, run, arg) != 0) tb_crash(0, \"не получилось запустить background\");\n")
    lines.add("}\n")
    lines.add("// a.wait: дождаться потока (один раз) и отдать адрес ответа\n")
    lines.add("static void *tb_wait(tb_task *t) {\n")
    lines.add("    if (!t->done) { pthread_join(t->th, 0); t->done = 1; }\n")
    lines.add("    return t->res;\n")
    lines.add("}\n")
    lines.add("static int tb_dhas(tb_dict *d, const void *k) { return tb_dfind(d, k) >= 0; }\n")
    lines.add("static void tb_dremove(tb_dict *d, const void *k) {\n")
    lines.add("    long long at = tb_dfind(d, k);\n")
    lines.add("    if (at < 0) return;\n")
    lines.add("    if (d->mode != 0) tb_dto_hash(d);\n")
    lines.add("    long long last = d->keys->len - 1;\n")
    lines.add("    // на место удалённого ставим последний: порядок меняется только у него\n")
    lines.add("    memcpy(d->keys->data + at * d->keys->size, d->keys->data + last * d->keys->size, d->keys->size);\n")
    lines.add("    memcpy(d->vals->data + at * d->vals->size, d->vals->data + last * d->vals->size, d->vals->size);\n")
    lines.add("    d->keys->len -= 1;\n")
    lines.add("    d->vals->len -= 1;\n")
    lines.add("    tb_dreindex(d, d->nslots);\n")
    lines.add("}\n")
    lines.add("static tb_dict *tb_dict_from(int text, long long vsize, long long n, const void *keys, const void *vals) {\n")
    lines.add("    tb_dict *d = tb_dict_new(text, vsize);\n")
    lines.add("    long long ksize = d->keys->size;\n")
    lines.add("    for (long long i = 0; i < n; i++) {\n")
    lines.add("        memcpy(tb_dput(d, (const char *)keys + i * ksize, 0), (const char *)vals + i * vsize, vsize);\n")
    lines.add("    }\n")
    lines.add("    return d;\n")
    lines.add("}\n")
    lines.add("\n")
    lines.add("// ---------- on all cores: цикл на всех ядрах ----------\n")
    lines.add("// Работа делится на куски; каждое ядро берёт следующий свободный кусок,\n")
    lines.add("// пока они не кончатся (так ядра не простаивают, если куски разные по тяжести).\n")
    lines.add("// shared: каждое ядро копит своё на «листке», потом один раз добавляет под замком.\n")
    lines.add("static pthread_mutex_t tb_par_lock = PTHREAD_MUTEX_INITIALIZER;\n")
    lines.add("static int tb_cores(void) {\n")
    lines.add("    const char *want = getenv(\"TB_CORES\");   // TB_CORES=1 — проверить на одном ядре\n")
    lines.add("    long n = want != 0 ? atol(want) : sysconf(_SC_NPROCESSORS_ONLN);\n")
    lines.add("    return n < 1 ? 1 : (n > 256 ? 256 : (int)n);\n")
    lines.add("}\n")
    lines.add("static void tb_par_run(void *(*work)(void *), void *job, long long total) {\n")
    lines.add("    int n = tb_cores();\n")
    lines.add("    if (n > total) n = (int)total;\n")
    lines.add("    if (n < 1) n = 1;\n")
    lines.add("    pthread_t t[256];\n")
    lines.add("    for (int i = 1; i < n; i++) {\n")
    lines.add("        if (pthread_create(&t[i], 0, work, job) != 0) tb_crash(0, \"не получилось запустить ядро\");\n")
    lines.add("    }\n")
    lines.add("    work(job);\n")
    lines.add("    for (int i = 1; i < n; i++) pthread_join(t[i], 0);\n")
    lines.add("}\n")
    lines.add("static long long tb_par_step(long long total) {\n")
    lines.add("    long long s = total / ((long long)tb_cores() * 16);\n")
    lines.add("    return s < 1 ? 1 : s;\n")
    lines.add("}\n")
    return join(lines, "")
