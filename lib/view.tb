// view — окна из файла .tbs: разметка и стили отдельно, логика в .tb.
// Окно делится на сетку, как лист Excel: столбцы A, B, C ..., строки 1, 2, 3 ...
// Вещь пишется как obj: вид, имя и клетки в скобках, а ниже с отступом — свойства «ключ: значение».
//
//   // app.tbs
//   screen main 4x4
//       title (A1:D1)
//           text: Настройки
//       field name (A2:C2)
//           hint: Как вас зовут
//       btn save (D2)
//           text: Сохранить
//           look: main
//           backcolor: #3ad6c1
//           corner.radius: 12
//
//   // app.tb
//   use ui
//   use view
//   func main()
//       window_sharp()
//       try window_open(800, 500, "Моё приложение")
//       u = ui.start()
//       v = view.file("app.tbs")
//       repeat while window_alive()
//           ui.frame(u)
//           clear_window(u.bg)
//           view.screen(u, v, "main")
//           if view.pressed(v, "save")
//               print(view.text_of(v, "name"))
//           ui.end_frame(u)
//
// Поменяли и сохранили .tbs — окно перерисуется само, программу перезапускать не надо.
// Все вещи и свойства — в docs/tbs.md.

use ui

obj TbsItem
    kind: text
    id: text
    props: dict text text    // свойства: text, color, backcolor, corner.radius ...
    c0: int
    r0: int
    c1: int
    r1: int
    ind: int                 // отступ строки (свойства пишутся глубже)
    mode: text               // "cell" — клетки (A1:B2), "xy" — точки (40, 120), "auto" — сама в следующую свободную клетку
    // точки: число — от левого (верхнего) края, −число — от правого (нижнего), 50% — доля окна.
    // Так вещь остаётся на месте, когда окно растягивают
    px: text
    py: text
    pw: text                 // "" — по содержимому
    ph: text
    line: int

obj TbsScreen
    name: text
    cols: int
    rows: int
    colw: list text          // ширина столбцов: число точек или * (делят остаток)
    rowh: list text
    gap: int
    pad: int
    items: list TbsItem
    narrow: text             // узкое окно (как телефон): "" — 560 точек, "off" — выключено, число — своя граница

obj TbsStyle
    name: text
    props: dict text text

obj TbsView
    path: text
    src: text
    screens: list TbsScreen
    styles: list TbsStyle
    errors: list text
    vals: dict text text     // тексты полей
    ons: dict text bool      // переключатели и галочки
    nums: dict text int      // ползунки, выбор из списка, вкладки
    hits: dict text bool     // какие кнопки нажали в этом кадре
    tick: int
    said: bool               // ошибки уже напечатаны
    hov: bool                // мышь над вещью, которую сейчас рисуем: тогда берутся свойства hover.*
    imgs: dict text int      // картинки: путь и размер → номер картинки
    scroll: dict text int    // прокрутка экрана (узкий режим, fill), в настоящих точках

// цвета и размеры ui, которые вещь меняет на время своего рисования
obj TbsKeep
    ink: int
    dim: int
    accent: int
    on_accent: int
    raised: int
    fieldbg: int
    line: int
    red: int
    radius: int
    fs: int
    bold: int
    k: dec
    line_h: int

// прочитать файл .tbs. Нет файла — окно покажет ошибку красным, программа не падает
modpub func file(path: text) gives v: TbsView
    v = TbsView(path: path)
    src = read_file(path) else err
        v.errors.add(path + ": не могу прочитать файл")
        return
    parse(v, src)

// то же из готового текста (без файла)
modpub func from_text(src: text) gives v: TbsView
    v = TbsView(path: "")
    parse(v, src)

// ---------- что нажали и что ввели ----------

// кнопку id нажали в этом кадре
modpub func pressed(v: TbsView, id: text)
    return v.hits.has(id) and v.hits[id]

// текст поля id
modpub func text_of(v: TbsView, id: text)
    if v.vals.has(id)
        return v.vals[id]
    return ""

modpub func put_text(v: TbsView, id: text, s: text)
    v.vals[id] = s

// переключатель или галочка id включены
modpub func is_on(v: TbsView, id: text)
    return v.ons.has(id) and v.ons[id]

modpub func put_on(v: TbsView, id: text, on: bool)
    v.ons[id] = on

// число ползунка, номер выбранного в списке или открытой вкладки
modpub func number_of(v: TbsView, id: text)
    if v.nums.has(id)
        return v.nums[id]
    return 0

modpub func put_number(v: TbsView, id: text, n: int)
    v.nums[id] = n

// ---------- чтение .tbs ----------

func parse(v: TbsView, src: text)
    v.src = src
    v.screens.clear()
    v.styles.clear()
    v.errors.clear()
    v.said = false
    lines = split(src, "\n")
    sc = -1
    st = -1
    cur = -1                 // последняя вещь экрана (к ней идут свойства)
    count n from 0 to len(lines) - 1
        raw = no_comment(lines[n])
        if trim(raw) == ""
            skip
        ind = indent(raw)
        body = trim(raw)
        if ind == 0
            sc = -1
            st = -1
            cur = -1
            words = split_words(body)
            if words[0] == "style" and len(words) >= 2
                v.styles.add(TbsStyle(name: words[1]))
                st = len(v.styles) - 1
            else if words[0] == "screen" and len(words) >= 3
                s = TbsScreen(name: words[1], gap: -1, pad: -1)
                g = replace(replace(lower(words[2]), "(", ""), ")", "")
                parts = split(g, "x")
                if len(parts) == 2
                    s.cols = to_int(trim(parts[0])) or 0
                    s.rows = to_int(trim(parts[1])) or 0
                if s.cols < 1 or s.rows < 1 or s.cols > 26
                    oops(v, n, "после имени экрана нужна сетка: столбцы x строки, например 4x5 (столбцов не больше 26)")
                    s.cols = max(1, min(26, s.cols))
                    s.rows = max(1, s.rows)
                v.screens.add(s)
                sc = len(v.screens) - 1
            else
                oops(v, n, "строка без отступа начинается со style имя или screen имя 4x5")
            skip
        key = ""
        val = ""
        isprop = false
        colon = find(body, ":")
        paren = find(body, "(")
        if colon > 0 and (paren < 0 or colon < paren)
            key = lower(trim(cut(body, 0, colon - 1)))
            if colon + 1 <= len(body) - 1
                val = unquote(trim(cut(body, colon + 1, len(body) - 1)))
            isprop = find(key, " ") < 0
        if st >= 0
            if not isprop
                oops(v, n, "в стиле пишутся свойства: ключ: значение")
                skip
            key, val = canon(key, val)
            v.styles[st].props[key] = val
            skip
        if sc < 0
            oops(v, n, "строка с отступом стоит не внутри style или screen")
            skip
        s = v.screens[sc]
        if isprop
            if cur >= 0 and ind > s.items[cur].ind
                key, val = canon(key, val)
                if not known_prop(key)
                    oops(v, n, "такого свойства нет: " + key + " — все свойства в docs/tbs.md")
                s.items[cur].props[key] = val
            else
                screen_prop(v, s, key, val, n)
            skip
        cur = item(v, s, body, ind, n)
    each s in v.screens
        place_auto(s)

// вещи без клеток встают по порядку в свободные клетки: слева направо, сверху вниз (как текст)
func place_auto(s: TbsScreen)
    busy = list bool
    count i from 0 to s.cols * s.rows - 1
        busy.add(false)
    each it in s.items
        if it.mode == "cell" and it.kind != "card"
            count r from it.r0 to it.r1
                count c from it.c0 to it.c1
                    busy[r * s.cols + c] = true
    at = 0
    each it in s.items
        if it.mode == "cell" and it.kind != "card"
            at = max(at, it.r0 * s.cols + it.c0)
        if it.mode == "auto"
            repeat while at < len(busy) and busy[at]
                at += 1
            if at >= len(busy)
                at = len(busy) - 1
            it.c0 = at % s.cols
            it.c1 = it.c0
            it.r0 = at / s.cols
            it.r1 = it.r0
            busy[at] = true

func screen_prop(v: TbsView, s: TbsScreen, key: text, val: text, n: int)
    if key == "cols" or key == "rows"
        sizes = list text
        each w in split_words(val)
            sizes.add(w)
        if key == "cols"
            s.colw = sizes
        else
            s.rowh = sizes
    else if key == "narrow"
        s.narrow = val
    else if key == "gap"
        s.gap = to_int(val) or 12
    else if key == "pad"
        s.pad = to_int(val) or 20
    else if key == "space"
        if val == "tight"
            s.gap = 6
            s.pad = 10
        else if val == "roomy"
            s.gap = 18
            s.pad = 28
        else
            s.gap = 12
            s.pad = 20
    else
        oops(v, n, "у экрана есть только cols, rows, gap, pad, space, narrow; свойство вещи пиши под ней с отступом")

// строка вещи: вид [имя] (клетки). Отдаёт номер вещи или −1
func item(v: TbsView, s: TbsScreen, body: text, ind: int, n: int)
    a = find(body, "(")
    b = find(body, ")")
    head = list text
    where = ""
    if a < 0
        head = split_words(body)
    else
        if b < a
            oops(v, n, "нет закрывающей скобки )")
            return -1
        if a > 0
            head = split_words(trim(cut(body, 0, a - 1)))
        if b - 1 >= a + 1
            where = upper(replace(trim(cut(body, a + 1, b - 1)), " ", ""))
    if len(head) == 0
        oops(v, n, "перед скобкой нужен вид вещи: btn, text, field ...")
        return -1
    kind = head[0]
    if not known(kind)
        oops(v, n, "такой вещи нет: " + kind + " (есть title, heading, subtitle, text, note, caps, code, chip, btn, link, icon, field, area, switch, check, slider, pick, tabs, card, line, image)")
        return -1
    it = TbsItem(kind: kind, ind: ind, line: n + 1, mode: "cell")
    if len(head) >= 2
        it.id = head[1]
    if where == ""
        it.mode = "auto"
    else if find(where, ",") >= 0
        it.mode = "xy"
        nums = split(where, ",")
        ok = len(nums) == 2 or len(nums) == 4
        each q in nums
            if not is_place(q)
                ok = false
        if not ok
            oops(v, n, "в скобках точки пишутся так: (x, y) или (x, y, ширина, высота); −20 — от правого края, 50% — половина окна")
            return -1
        it.px = nums[0]
        it.py = nums[1]
        if len(nums) == 4
            it.pw = nums[2]
            it.ph = nums[3]
    else if is_cell(where)
        cells(it, where)
        if it.c1 >= s.cols or it.r1 >= s.rows
            oops(v, n, "клетка за краем сетки " + s.cols + "x" + s.rows)
            return -1
    else
        oops(v, n, "в скобках: клетки (A1) или (A1:C2), точки (40, 120), или пусто () — вещь сама встанет в свободную клетку")
        return -1
    if needs_id(kind) and it.id == ""
        oops(v, n, kind + " без имени: напиши имя перед скобкой, например " + kind + " save (A1)")
        return -1
    s.items.add(it)
    return len(s.items) - 1

func known(k: text)
    each w in ["title", "heading", "subtitle", "text", "note", "caps", "code", "chip", "btn", "link", "icon", "field", "area", "switch", "check", "slider", "pick", "tabs", "card", "line", "image"]
        if w == k
            return true
    return false

func needs_id(k: text)
    each w in ["btn", "link", "icon", "field", "area", "switch", "check", "slider", "pick", "tabs"]
        if w == k
            return true
    return false

func known_prop(k0: text)
    k = k0
    if starts_with(k, "hover.")
        k = cut(k, 6, len(k) - 1)
    each w in ["text", "color", "backcolor", "corner.radius", "corner.color", "corner.width", "size", "font", "align", "look", "hint", "value", "on", "min", "max", "items", "style", "accent", "width", "height", "scale", "padding", "margin", "opacity", "shadow", "visible", "cursor", "tip", "disabled", "spacing", "transform", "decoration", "wrap", "line.height", "min.width", "max.width", "min.height", "max.height", "layer", "src", "fit", "narrow", "order", "span"]
        if w == k
            return true
    return false

// имена из CSS и HTML → наши: background-color → backcolor, border-radius → corner.radius ...
func canon(key: text, val: text) gives k: text, v: text
    k = replace(key, "_", "-")
    v = val
    hov = ""
    if starts_with(k, "hover.") or starts_with(k, ":hover.")
        hov = "hover."
        k = cut(k, find(k, ".") + 1, len(k) - 1)
    if k == "background" or k == "background-color" or k == "back.color" or k == "bg"
        k = "backcolor"
    else if k == "border-radius" or k == "radius" or k == "corner"
        k = "corner.radius"
    else if k == "border-color"
        k = "corner.color"
    else if k == "border-width" or k == "border.width"
        k = "corner.width"
    else if k == "font-size"
        k = "size"
    else if k == "font-weight"
        k = "font"
        if v == "bold" or v == "600" or v == "700" or v == "800" or v == "900" or v == "bolder"
            v = "bold"
        else
            v = "regular"
    else if k == "font-family"
        k = "font"
        if find(lower(v), "mono") >= 0 or find(lower(v), "courier") >= 0
            v = "mono"
        else
            v = "regular"
    else if k == "text-align"
        k = "align"
    else if k == "letter-spacing"
        k = "spacing"
    else if k == "text-transform"
        k = "transform"
    else if k == "text-decoration"
        k = "decoration"
    else if k == "line-height"
        k = "line.height"
    else if k == "min-width" or k == "max-width" or k == "min-height" or k == "max-height"
        k = replace(k, "-", ".")
    else if k == "box-shadow"
        k = "shadow"
    else if k == "z-index"
        k = "layer"
    else if k == "title" or k == "tooltip"
        k = "tip"
    else if k == "placeholder"
        k = "hint"
    else if k == "white-space"
        k = "wrap"
        if v == "nowrap"
            v = "no"
        else
            v = "yes"
    else if k == "display" or k == "visibility"
        k = "visible"
        if v == "none" or v == "hidden"
            v = "no"
        else
            v = "yes"
    k = hov + k

func is_number(w: text)
    if len(w) == 0
        return false
    each ch in w
        if code(ch) < 48 or code(ch) > 57
            return false
    return true

// 40, -20, 50%
func is_place(q: text)
    t = no_px(q)
    if starts_with(t, "-")
        t = cut(t, 1, len(t) - 1)
    if ends_with(t, "%") and len(t) > 1
        t = cut(t, 0, len(t) - 2)
    return is_number(t)

// место по точкам: число от начала, −число от конца, n% доля длины
func at_px(u: Ui, q: text, start: int, total: int)
    if ends_with(q, "%")
        p = to_int(cut(q, 0, len(q) - 2)) or 0
        return start + total * p / 100
    n = to_int(q) or 0
    if n < 0
        return start + total + ui.px(u, n)
    return start + ui.px(u, n)

func len_px(u: Ui, q0: text, total: int)
    q = no_px(q0)
    if ends_with(q, "%")
        return total * (to_int(cut(q, 0, len(q) - 2)) or 0) / 100
    return ui.px(u, to_int(q) or 0)

// своя ширина вещи по точкам, если ширину не написали
func natural_w(u: Ui, v: TbsView, it: TbsItem)
    k = it.kind
    s = prop(v, it, "text")
    if k == "btn"
        return ui.style_w(u, s, "button") + ui.px(u, 36)
    if k == "switch" or k == "check"
        return ui.text_w(u, s) + ui.px(u, 56)
    if k == "icon"
        return ui.px(u, 36)
    if k == "title" or k == "heading" or k == "subtitle" or k == "text" or k == "note" or k == "caps" or k == "link" or k == "chip"
        return ui.text_w(u, s) * 2 + ui.px(u, 24)
    return ui.px(u, 240)

func natural_h(u: Ui, it: TbsItem)
    if it.kind == "area" or it.kind == "card"
        return ui.px(u, 120)
    if it.kind == "title"
        return ui.px(u, 44)
    return ui.px(u, 36)

// A1, C12, A1:D3
func is_cell(w: text)
    parts = split(w, ":")
    if len(parts) > 2
        return false
    each p in parts
        if len(p) < 2
            return false
        c = code(p[0])
        if c < 65 or c > 90
            return false
        if not is_number(cut(p, 1, len(p) - 1))
            return false
    return true

func cells(it: TbsItem, w: text)
    parts = split(w, ":")
    a = parts[0]
    b = parts[len(parts) - 1]
    ca = code(a[0]) - 65
    cb = code(b[0]) - 65
    ra = (to_int(cut(a, 1, len(a) - 1)) or 1) - 1
    rb = (to_int(cut(b, 1, len(b) - 1)) or 1) - 1
    it.c0 = min(ca, cb)
    it.c1 = max(ca, cb)
    it.r0 = max(0, min(ra, rb))
    it.r1 = max(0, max(ra, rb))

func oops(v: TbsView, n: int, msg: text)
    where = v.path
    if where == ""
        where = "tbs"
    v.errors.add(where + ", строка " + (n + 1) + ": " + msg)

// сколько пробелов в начале строки (табуляция — 4)
func indent(s: text)
    n = 0
    each ch in s
        if ch == " "
            n += 1
        else if ch == "\t"
            n += 4
        else
            stop
    return n

// убрать // и всё после (но не внутри кавычек)
func no_comment(s: text)
    inq = false
    prev = ""
    i = 0
    each ch in s
        if ch == "\""
            inq = not inq
        else if ch == "/" and prev == "/" and not inq
            if i <= 1
                return ""
            return cut(s, 0, i - 2)
        prev = ch
        i += 1
    return replace(s, "\r", "")

// "текст" → текст
func unquote(s: text)
    if len(s) >= 2 and starts_with(s, "\"") and ends_with(s, "\"")
        return cut(s, 1, len(s) - 2)
    return s

func split_words(s: text) gives words: list text
    each w in split(replace(s, "\t", " "), " ")
        if w != ""
            words.add(w)

// ---------- рисование ----------

// нарисовать экран name на всё свободное место (или в текущем месте раскладки ui)
modpub func screen(u: Ui, v: TbsView, name: text)
    v.hits.clear()
    v.tick += 1
    if v.path != "" and v.tick % 30 == 0
        again(v)
    bx, by, bw, bh = ui.take(u, 0)
    if len(v.errors) > 0
        show_errors(u, v, bx, by, bw)
        return
    si = -1
    count i from 0 to len(v.screens) - 1
        if v.screens[i].name == name
            si = i
    if si < 0
        ui.txt(u, bx + ui.px(u, 12), by + ui.px(u, 12), "в .tbs нет экрана " + name, u.red)
        return
    s = v.screens[si]
    gap = ui.px(u, 12)
    pad = ui.px(u, 20)
    if s.gap >= 0
        gap = ui.px(u, s.gap)
    if s.pad >= 0
        pad = ui.px(u, s.pad)
    // узкое окно (как телефон): всё встаёт в один столбец по порядку, длинное листается колёсиком
    edge = 560
    if s.narrow == "off"
        edge = 0
    else if s.narrow != ""
        edge = to_int(no_px(s.narrow)) or 560
    if bw < ui.px(u, edge)
        flow(u, v, s, 1, bx, by, bw, bh, ui.px(u, 14), ui.px(u, 16), true)
        return
    // cols: fill 150 — столько столбцов по 150 точек, сколько влезает; вещи текут по порядку
    if len(s.colw) >= 2 and s.colw[0] == "fill"
        cw = ui.px(u, to_int(no_px(s.colw[1])) or 150)
        n = max(1, (bw - 2 * pad + gap) / (cw + gap))
        flow(u, v, s, n, bx, by, bw, bh, gap, pad, false)
        return
    xs = split_line(u, bx + pad, bw - 2 * pad, s.cols, s.colw, gap)
    ys = split_line(u, by + pad, bh - 2 * pad, s.rows, auto_rows(u, v, s), gap)
    // слои (layer, как z-index): меньше — ниже. В слое сначала карточки (они фон), потом остальное
    lo = 0
    hi = 0
    each it in s.items
        L = num(v, it, "layer", 0)
        lo = min(lo, L)
        hi = max(hi, L)
    count L from lo to hi
        each it in s.items
            if it.kind == "card" and num(v, it, "layer", 0) == L and not hidden_here(v, it, false)
                x, y, w, h = place(u, v, xs, ys, it, bx, by, bw, bh)
                draw_any(u, v, it, x, y, w, h)
        // вещи внутри карточки отходят от её краёв
        inset = ui.px(u, 16)
        each it in s.items
            if it.kind != "card" and num(v, it, "layer", 0) == L and not hidden_here(v, it, false)
                x, y, w, h = place(u, v, xs, ys, it, bx, by, bw, bh)
                each c in s.items
                    if c.kind == "card" and it.mode != "xy" and c.mode != "xy" and it.c0 >= c.c0 and it.c1 <= c.c1 and it.r0 >= c.r0 and it.r1 <= c.r1
                        cin = num(v, c, "padding", 16)
                        inset = ui.px(u, cin)
                        if it.c0 == c.c0
                            x += inset
                            w -= inset
                        if it.c1 == c.c1
                            w -= inset
                        if it.r0 == c.r0
                            y += inset
                            h -= inset
                        if it.r1 == c.r1
                            h -= inset
                draw_any(u, v, it, x, y, w, h)

// общее для всех вещей: видна ли, margin, min/max размеры, наведение (hover.*), тень, курсор, подсказка
func draw_any(u: Ui, v: TbsView, it: TbsItem, x0: int, y0: int, w0: int, h0: int)
    v.hov = false
    if prop(v, it, "visible") == "no"
        return
    x = x0
    y = y0
    w = w0
    h = h0
    m = prop(v, it, "margin")
    if m != ""
        parts = split_words(m)
        my = len_px(u, parts[0], h)
        mx = my
        if len(parts) >= 2
            mx = len_px(u, parts[1], w)
        x += mx
        y += my
        w -= 2 * mx
        h -= 2 * my
    if prop(v, it, "min.width") != ""
        w = max(w, len_px(u, prop(v, it, "min.width"), w0))
    if prop(v, it, "max.width") != ""
        w = min(w, len_px(u, prop(v, it, "max.width"), w0))
    if prop(v, it, "min.height") != ""
        h = max(h, len_px(u, prop(v, it, "min.height"), h0))
    if prop(v, it, "max.height") != ""
        nh = min(h, len_px(u, prop(v, it, "max.height"), h0))
        y += (h - nh) / 2
        h = nh
    if w <= 0 or h <= 0
        return
    v.hov = ui.free(u) and ui.inside(u, x, y, w, h)
    if v.hov and prop(v, it, "cursor") != ""
        ui.cursor(u, prop(v, it, "cursor"))
    if prop(v, it, "tip") != ""
        ui.tip_at(u, x, y, w, h, prop(v, it, "tip"))
    sh = prop(v, it, "shadow")
    if sh == "" and it.kind == "card"
        sh = "small"
    if sh != "" and sh != "none" and sh != "no"
        depth = 1
        if sh == "medium"
            depth = 2
        else if sh == "big" or sh == "large"
            depth = 4
        else if is_number(sh)
            depth = to_int(sh) or 1
        r = ui.px(u, num(v, it, "corner.radius", 10))
        if it.kind == "card"
            r = ui.px(u, num(v, it, "corner.radius", 14))
        ui.shadow_under(u, x, y, w, h, r, depth)
    if it.kind == "card"
        r = ui.px(u, num(v, it, "corner.radius", 14))
        fill = fade(u, v, it, color(u, prop(v, it, "backcolor"), u.panel))
        border = fade(u, v, it, color(u, prop(v, it, "corner.color"), u.line))
        frame(u, x, y, w, h, r, ui.px(u, num(v, it, "corner.width", 1)), fill, border)
    else
        draw_item(u, v, it, x, y, w, h)
    v.hov = false

// рамка толщиной bw (0 — без рамки) и заливка
func frame(u: Ui, x: int, y: int, w: int, h: int, r: int, bw: int, fill: int, border: int)
    if bw <= 0
        ui.rbox(u, x, y, w, h, r, fill)
        return
    ui.rbox(u, x, y, w, h, r, border)
    ui.rbox(u, x + bw, y + bw, w - 2 * bw, h - 2 * bw, max(0, r - bw), fill)

// opacity: цвет ближе к фону окна (на сплошном фоне — то же, что прозрачность)
func fade(u: Ui, v: TbsView, it: TbsItem, c: int)
    op = pct(prop(v, it, "opacity"), 100)
    if op >= 100
        return c
    return ui.mix(c, u.bg, 100 - op)

// rows: auto — высота строки по самой высокой вещи в ней (как auto в CSS grid)
func auto_rows(u: Ui, v: TbsView, s: TbsScreen) gives sizes: list text
    count r from 0 to s.rows - 1
        sz = "*"
        if r < len(s.rowh)
            sz = s.rowh[r]
        if sz == "auto"
            hmax = 0
            each it in s.items
                if it.mode != "xy" and it.r0 == r and it.r1 == r and it.kind != "card" and prop(v, it, "visible") != "no"
                    hmax = max(hmax, flow_h(u, v, it, 0))
            sz = "" + max(8, round(hmax / u.k))
        sizes.add(sz)

// высота вещи «по содержимому» (настоящие точки); w — ширина для переноса строк (0 — не знаем)
func flow_h(u: Ui, v: TbsView, it: TbsItem, w: int)
    if prop(v, it, "height") != "" and not ends_with(prop(v, it, "height"), "%")
        return len_px(u, prop(v, it, "height"), 0)
    k = it.kind
    sc = scale_pct(v, it)
    h = 40
    if k == "title"
        h = 44
    else if k == "heading"
        h = 34
    else if k == "subtitle" or k == "chip" or k == "note"
        h = 26
    else if k == "caps"
        h = 18
    else if k == "line"
        h = 12
    else if k == "area"
        h = 120
    else if k == "image"
        h = 160
    else if k == "text"
        h = 26
    hp = ui.px(u, h) * sc / 100
    if yes(prop(v, it, "wrap")) and w > 0
        // примерно: сколько строк выйдет по ширине
        size = u.fs
        if prop(v, it, "size") != ""
            size = ui.px(u, num(v, it, "size", 14))
        tw = ui.text_w(u, prop(v, it, "text")) * size / max(1, u.fs)
        lines = max(1, tw / max(1, w - ui.px(u, 8)) + 1)
        lh = size * 5 / 4
        if prop(v, it, "line.height") != ""
            lh = size * pct_or_mul(prop(v, it, "line.height")) / 100
        hp = max(hp, lines * lh + ui.px(u, 8))
    return hp

// поток: вещи по порядку (order меняет порядок), n в ряд; карточка собирает вещи из своих клеток.
// Если не влезает по высоте — колёсико листает
func flow(u: Ui, v: TbsView, s: TbsScreen, n: int, bx: int, by: int, bw: int, bh: int, gap: int, pad: int, narrow: bool)
    key = s.name
    off = 0
    if v.scroll.has(key)
        off = v.scroll[key]
    // порядок: по order, при равных — как в файле
    idx = list int
    count i from 0 to len(s.items) - 1
        idx.add(i)
    count a from 1 to len(idx) - 1
        b = a
        repeat while b > 0 and num(v, s.items[idx[b - 1]], "order", 0) > num(v, s.items[idx[b]], "order", 0)
            t = idx[b]
            idx[b] = idx[b - 1]
            idx[b - 1] = t
            b -= 1
    done = list bool
    each it in s.items
        done.add(false)
    // вещи внутри карточек: они пойдут вместе с карточкой
    inside = list int
    each it in s.items
        inside.add(-1)
    count ci from 0 to len(s.items) - 1
        c = s.items[ci]
        if c.kind == "card" and c.mode == "cell"
            count i from 0 to len(s.items) - 1
                it = s.items[i]
                if i != ci and it.kind != "card" and it.mode == "cell" and it.c0 >= c.c0 and it.c1 <= c.c1 and it.r0 >= c.r0 and it.r1 <= c.r1
                    inside[i] = ci
    W = bw - 2 * pad
    colw = (W - gap * (n - 1)) / n
    y = by + pad - off
    col = 0
    rowh = 0
    each i in idx
        it = s.items[i]
        if done[i] or inside[i] >= 0
            skip
        done[i] = true
        if hidden_here(v, it, narrow)
            skip
        if it.kind == "card"
            // карточка — на всю ширину, внутри её вещи столбцом
            if col > 0
                y += rowh + gap
                col = 0
                rowh = 0
            cp = ui.px(u, num(v, it, "padding", 16))
            kids = list int
            each j in idx
                if inside[j] == i and not hidden_here(v, s.items[j], narrow)
                    kids.add(j)
            hh = 2 * cp
            each j in kids
                hh += flow_h(u, v, s.items[j], W - 2 * cp) + ui.px(u, 8)
            if len(kids) > 0
                hh -= ui.px(u, 8)
            draw_any(u, v, it, bx + pad, y, W, hh)
            yy = y + cp
            each j in kids
                kh = flow_h(u, v, s.items[j], W - 2 * cp)
                draw_any(u, v, s.items[j], bx + pad + cp, yy, W - 2 * cp, kh)
                done[j] = true
                yy += kh + ui.px(u, 8)
            y += hh + gap
            skip
        full = n == 1 or it.kind == "title" or it.kind == "heading" or it.kind == "area" or it.kind == "line" or prop(v, it, "span") == "all"
        if full and col > 0
            y += rowh + gap
            col = 0
            rowh = 0
        w = colw
        if full
            w = W
        h = flow_h(u, v, it, w)
        x = bx + pad + col * (colw + gap)
        if y + h > by and y < by + bh
            draw_any(u, v, it, x, y, w, h)
        rowh = max(rowh, h)
        if full
            y += rowh + gap
            rowh = 0
        else
            col += 1
            if col >= n
                col = 0
                y += rowh + gap
                rowh = 0
    if col > 0
        y += rowh + gap
    // прокрутка колёсиком, если всё не влезло
    total = y + off - by + pad - gap
    most = max(0, total - bh)
    if u.wheel != 0 and ui.free(u) and ui.inside(u, bx, by, bw, bh)
        off = off - u.wheel * ui.px(u, 40)
    off = max(0, min(most, off))
    v.scroll[key] = off
    if most > 0
        // тонкая полоска справа: где мы сейчас
        th = max(ui.px(u, 30), bh * bh / max(1, total))
        ty = by + (bh - th) * off / max(1, most)
        ui.rbox(u, bx + bw - ui.px(u, 6), ty, ui.px(u, 4), th, ui.px(u, 2), u.line)

// narrow: hide — в узком окне вещь прячется; narrow: only — видна только в узком
func hidden_here(v: TbsView, it: TbsItem, narrow: bool)
    if prop(v, it, "visible") == "no"
        return true
    nw = prop(v, it, "narrow")
    if narrow and nw == "hide"
        return true
    if not narrow and nw == "only"
        return true
    return false

// места столбцов (или строк): для каждого начало и конец, через одно
func split_line(u: Ui, start: int, total: int, n: int, sizes: list text, gap: int) gives at: list int
    fixed = 0
    stars = 0
    count i from 0 to n - 1
        sz = "*"
        if i < len(sizes)
            sz = sizes[i]
        if sz == "*" or ends_with(sz, "+")
            stars += 1
        else
            fixed += ui.px(u, to_int(no_px(sz)) or 0)
    left = max(0, total - fixed - gap * (n - 1))
    each_star = 0
    if stars > 0
        each_star = left / stars
    // окно меньше, чем сумма точных размеров: все точные сжимаются в одну долю, ничего не уходит за край
    shrink = 100
    if fixed > 0 and fixed + gap * (n - 1) > total
        shrink = max(0, (total - gap * (n - 1)) * 100 / fixed)
    p = start
    count i from 0 to n - 1
        sz = "*"
        if i < len(sizes)
            sz = sizes[i]
        w = each_star
        if ends_with(sz, "+")
            // 200+ — делит остаток, но не меньше 200 (как minmax(200px, 1fr))
            w = max(each_star, ui.px(u, to_int(cut(sz, 0, len(sz) - 2)) or 0))
        else if sz != "*"
            w = ui.px(u, to_int(no_px(sz)) or 0) * shrink / 100
        at.add(p)
        at.add(p + w)
        p += w + gap

// где вещь: по клеткам или по точкам (точки считаются от окна при каждом кадре — окно тянут, вещь едет)
func place(u: Ui, v: TbsView, xs: list int, ys: list int, it: TbsItem, bx: int, by: int, bw: int, bh: int) gives x: int, y: int, w: int, h: int
    pw = prop(v, it, "width")
    ph = prop(v, it, "height")
    if it.mode != "xy"
        x, y, w, h = rect(xs, ys, it)
        // width / height: своя ширина и высота внутри клеток (точки или % клеток); по высоте — по середине,
        // по ширине — слева (align: center или right двигают)
        if pw != "" and is_place(pw)
            nw = min(w, len_px(u, pw, w))
            al = prop(v, it, "align")
            if al == "center"
                x += (w - nw) / 2
            else if al == "right"
                x += w - nw
            w = nw
        if ph != "" and is_place(ph)
            nh = min(h, len_px(u, ph, h))
            y += (h - nh) / 2
            h = nh
        return
    sc = scale_pct(v, it)
    w = natural_w(u, v, it) * sc / 100
    h = natural_h(u, it) * sc / 100
    if it.pw != ""
        w = len_px(u, it.pw, bw)
    if it.ph != ""
        h = len_px(u, it.ph, bh)
    if pw != "" and is_place(pw)
        w = len_px(u, pw, bw)
    if ph != "" and is_place(ph)
        h = len_px(u, ph, bh)
    x = at_px(u, it.px, bx, bw)
    y = at_px(u, it.py, by, bh)
    // −число: правый (нижний) край вещи стоит в этой точке
    if starts_with(it.px, "-")
        x -= w
    if starts_with(it.py, "-")
        y -= h

// scale: 1.5, 2, 150% → проценты (100 — как есть)
func scale_pct(v: TbsView, it: TbsItem)
    s = prop(v, it, "scale")
    if s == ""
        return 100
    if ends_with(s, "%")
        return max(10, min(1000, to_int(cut(s, 0, len(s) - 2)) or 100))
    d = to_dec(s) or 1.0
    return max(10, min(1000, round(d * 100)))

func rect(xs: list int, ys: list int, it: TbsItem) gives x: int, y: int, w: int, h: int
    x = xs[it.c0 * 2]
    w = xs[it.c1 * 2 + 1] - x
    y = ys[it.r0 * 2]
    h = ys[it.r1 * 2 + 1] - y

// свойство вещи: своё, иначе из её стиля (style: имя), иначе ""
func prop(v: TbsView, it: TbsItem, key: text)
    if v.hov
        h = prop_raw(v, it, "hover." + key)
        if h != ""
            return h
    return prop_raw(v, it, key)

func prop_raw(v: TbsView, it: TbsItem, key: text)
    if it.props.has(key)
        return it.props[key]
    if it.props.has("style")
        name = it.props["style"]
        each st in v.styles
            if st.name == name and st.props.has(key)
                return st.props[key]
    return ""

func num(v: TbsView, it: TbsItem, key: text, dflt: int)
    p = no_px(prop(v, it, key))
    if p == ""
        return dflt
    return to_int(p) or dflt

// 12px → 12
func no_px(s: text)
    t = trim(s)
    if ends_with(t, "px") and len(t) > 2
        return cut(t, 0, len(t) - 3)
    return t

// 0.5, 50%, 50 → проценты 0..100
func pct(s: text, dflt: int)
    t = trim(s)
    if t == ""
        return dflt
    if ends_with(t, "%")
        return max(0, min(100, to_int(cut(t, 0, len(t) - 2)) or dflt))
    if find(t, ".") >= 0
        d = to_dec(t) or 1.0
        return max(0, min(100, round(d * 100)))
    n = to_int(t) or dflt
    if n <= 1
        return n * 100
    return max(0, min(100, n))

func yes(s: text)
    return s == "yes" or s == "true" or s == "да" or s == "1"


// на время рисования вещи её свойства становятся цветами и размерами ui, потом всё возвращается
func keep(u: Ui) gives k: TbsKeep
    k = TbsKeep(ink: u.ink, dim: u.dim, accent: u.accent, on_accent: u.on_accent, raised: u.raised, fieldbg: u.fieldbg, line: u.line, red: u.red, radius: u.radius, fs: u.fs, bold: u.bold, k: u.k, line_h: u.line_h)

func restore(u: Ui, k: TbsKeep)
    u.ink = k.ink
    u.dim = k.dim
    u.accent = k.accent
    u.on_accent = k.on_accent
    u.raised = k.raised
    u.fieldbg = k.fieldbg
    u.line = k.line
    u.red = k.red
    u.radius = k.radius
    u.fs = k.fs
    u.bold = k.bold
    u.k = k.k
    u.line_h = k.line_h

func apply(u: Ui, v: TbsView, it: TbsItem, look: text)
    // scale: вся вещь крупнее или мельче — буквы, высота, скругления (1.5 или 150%)
    sc = scale_pct(v, it)
    if sc != 100
        u.k = u.k * sc / 100.0
        u.fs = ui.px(u, 14)
        u.line_h = ui.px(u, 16)
        u.radius = ui.px(u, 10)
    c = prop(v, it, "color")
    bg = prop(v, it, "backcolor")
    if prop(v, it, "accent") != ""
        u.accent = color(u, prop(v, it, "accent"), u.accent)
    if look == "main"
        u.accent = color(u, bg, u.accent)
        u.on_accent = color(u, c, u.on_accent)
    else if look == "soft"
        u.accent = color(u, bg, u.accent)
        if c != ""
            u.accent = color(u, c, u.accent)
    else if look == "danger"
        u.red = color(u, bg, u.red)
    else
        u.ink = color(u, c, u.ink)
        u.dim = color(u, c, u.dim)
        u.raised = color(u, bg, u.raised)
        u.fieldbg = color(u, bg, u.fieldbg)
    u.line = color(u, prop(v, it, "corner.color"), u.line)
    if prop(v, it, "corner.radius") != ""
        u.radius = ui.px(u, num(v, it, "corner.radius", 10))
    if prop(v, it, "size") != ""
        u.fs = ui.px(u, num(v, it, "size", 14))
    if prop(v, it, "font") == "regular"
        u.bold = u.font
    op = pct(prop(v, it, "opacity"), 100)
    if op < 100
        f = 100 - op
        u.ink = ui.mix(u.ink, u.bg, f)
        u.dim = ui.mix(u.dim, u.bg, f)
        u.accent = ui.mix(u.accent, u.bg, f)
        u.on_accent = ui.mix(u.on_accent, u.bg, f)
        u.raised = ui.mix(u.raised, u.bg, f)
        u.fieldbg = ui.mix(u.fieldbg, u.bg, f)
        u.line = ui.mix(u.line, u.bg, f)
        u.red = ui.mix(u.red, u.bg, f)

func draw_item(u: Ui, v: TbsView, it: TbsItem, x: int, y: int, w: int, h: int)
    if w < ui.px(u, 8) or h < ui.px(u, 8)
        return               // окно сжали так, что вещи негде встать: не рисуем, а не ломаемся
    k = it.kind
    id = it.id
    look = prop(v, it, "look")
    if look == ""
        look = "second"
    kept = keep(u)
    apply(u, v, it, look)
    if k == "title" or k == "heading" or k == "subtitle" or k == "text" or k == "note" or k == "caps" or k == "code" or k == "chip"
        draw_text_item(u, v, it, x, y, w, h)
        restore(u, kept)
        return
    ch = min(h, ui.px(u, 36))
    cy = y + (h - ch) / 2
    label = prop(v, it, "text")
    if k == "image"
        draw_image_item(u, v, it, x, y, w, h)
    else if k == "btn" and yes(prop(v, it, "disabled"))
        ui.button_off(u, x, cy, w, ch, label)
    else if k == "btn"
        hit = false
        if look == "main"
            hit = ui.button_main(u, x, cy, w, ch, label)
        else if look == "soft"
            hit = ui.button_soft(u, x, cy, w, ch, label)
        else if look == "ghost"
            hit = ui.button_ghost(u, x, cy, w, ch, label)
        else if look == "danger"
            hit = ui.button_danger(u, x, cy, w, ch, label)
        else
            hit = ui.button(u, x, cy, w, ch, label)
        tap(v, id, hit)
    else if k == "icon"
        tap(v, id, ui.button_icon(u, x + (w - ch) / 2, cy, ch, label))
    else if k == "link"
        over = ui.free(u) and ui.inside(u, x, y, ui.text_w(u, label), h)
        if over
            ui.cursor(u, "hand")
        ty = y + (h - u.line_h) / 2
        lc = color(u, prop(v, it, "color"), u.accent)
        ui.txt(u, x, ty, ui.fit(u, label, w), lc)
        if over
            draw_rect(x, ty + u.line_h, min(w, ui.text_w(u, label)), max(1, round(u.k)), lc)
        tap(v, id, over and u.press)
    else if k == "field"
        if not v.vals.has(id)
            v.vals[id] = prop(v, it, "value")
        v.vals[id] = ui.field(u, "tbs:" + id, x, cy, w, ch, v.vals[id], prop(v, it, "hint"))
    else if k == "area"
        if not v.vals.has(id)
            v.vals[id] = prop(v, it, "value")
        v.vals[id] = ui.text_box(u, "tbs:" + id, x, y, w, h, v.vals[id])
    else if k == "switch" or k == "check"
        if not v.ons.has(id)
            o = prop(v, it, "on")
            v.ons[id] = o == "yes" or o == "true" or o == "да"
        if k == "switch"
            v.ons[id] = ui.switch_at(u, x, y + (h - ui.px(u, 22)) / 2, label, v.ons[id])
        else
            v.ons[id] = ui.check(u, x, y + (h - ui.px(u, 20)) / 2, label, v.ons[id])
    else if k == "slider"
        lo = num(v, it, "min", 0)
        hi = num(v, it, "max", 100)
        if not v.nums.has(id)
            v.nums[id] = num(v, it, "value", lo)
        v.nums[id] = ui.slider(u, "tbs:" + id, x + ui.px(u, 10), y, w - ui.px(u, 20), h, v.nums[id], lo, hi)
    else if k == "pick" or k == "tabs"
        names = list text
        each p in split(prop(v, it, "items"), "|")
            names.add(trim(p))
        if not v.nums.has(id)
            v.nums[id] = num(v, it, "value", 0)
        if k == "pick"
            v.nums[id] = ui.choose(u, "tbs:" + id, x, cy, w, ch, names, v.nums[id])
        else
            v.nums[id] = ui.tabs_at(u, x, cy, w, ch, names, v.nums[id])
    else if k == "line"
        draw_rect(x, y + h / 2, w, max(1, round(u.k)), u.line)
    restore(u, kept)

// картинка src: вписывается в место целиком, без искажения (fit: fill — растянуть на всё место)
func draw_image_item(u: Ui, v: TbsView, it: TbsItem, x: int, y: int, w: int, h: int)
    path = prop(v, it, "src")
    if path == ""
        return
    if not v.imgs.has(path)
        v.imgs[path] = -1
        if file_exists(path)
            im = load_image(path) else err
                im = -1
            v.imgs[path] = im
        else if v.path != ""
            // путь от папки файла .tbs
            dir = ""
            parts = split(v.path, "/")
            count i from 0 to len(parts) - 2
                dir += parts[i] + "/"
            if file_exists(dir + path)
                im2 = load_image(dir + path) else err
                    im2 = -1
                v.imgs[path] = im2
    img = v.imgs[path]
    if img < 0
        ui.txt(u, x, y, "нет картинки " + path, u.red)
        return
    iw = image_w(img)
    ih = image_h(img)
    if iw <= 0 or ih <= 0
        return
    tw = w
    th = h
    if prop(v, it, "fit") != "fill"
        if iw * h > ih * w
            th = ih * w / iw
        else
            tw = iw * h / ih
    tw = max(1, tw)
    th = max(1, th)
    key = path + "@" + tw + "x" + th
    if not v.imgs.has(key)
        sc = image_scaled(img, tw, th) else err
            sc = img
        v.imgs[key] = sc
    draw_image_alpha(v.imgs[key], x + (w - tw) / 2, y + (h - th) / 2)

func tap(v: TbsView, id: text, on: bool)
    if on
        v.hits[id] = true

// надпись: вид задаёт шрифт и размер (title, heading ...), свойства меняют цвет, размер, фон, края
func draw_text_item(u: Ui, v: TbsView, it: TbsItem, x: int, y: int, w: int, h: int)
    k = it.kind
    s = prop(v, it, "text")
    if k == "chip"
        bh = ui.px(u, 20)
        bw = ui.style_w(u, s, "caption") + ui.px(u, 16)
        by = y + (h - bh) / 2
        cc = color(u, prop(v, it, "color"), u.accent)
        ui.rbox(u, x, by, bw, bh, bh / 2, color(u, prop(v, it, "backcolor"), ui.alpha_of(cc, 45)))
        ui.styled_in(u, x + ui.px(u, 8), by, bh, s, "caption", cc)
        return
    st = "body"
    f = u.font
    size = u.fs
    c = u.ink
    if k == "title"
        st = "title"
        f = u.bold
        size = ui.px(u, 26)
    else if k == "heading"
        st = "heading"
        f = u.bold
        size = ui.px(u, 20)
    else if k == "subtitle"
        st = "sub"
        f = u.bold
        size = ui.px(u, 15)
    else if k == "note"
        st = "note"
        size = ui.px(u, 13)
        c = u.dim
    else if k == "caps"
        st = "caption"
        c = u.dim
    else if k == "code"
        st = "code"
        f = u.mono
        size = ui.px(u, 13)
    c = fade(u, v, it, color(u, prop(v, it, "color"), c))
    bg = prop(v, it, "backcolor")
    if k == "code" and bg == ""
        bg = "field"
    pad = 0
    if bg != "" or prop(v, it, "corner.color") != ""
        r = ui.px(u, num(v, it, "corner.radius", 8))
        fill = color(u, bg, u.fieldbg)
        if bg == ""
            fill = u.bg
        fill = fade(u, v, it, fill)
        frame(u, x, y, w, h, r, ui.px(u, num(v, it, "corner.width", 1)), fill, fade(u, v, it, color(u, prop(v, it, "corner.color"), fill)))
        pad = ui.px(u, 10)
    if prop(v, it, "padding") != ""
        pad = len_px(u, split_words(prop(v, it, "padding"))[0], w)
    fn = prop(v, it, "font")
    if fn == "bold"
        f = u.bold
    else if fn == "mono"
        f = u.mono
    else if fn == "regular"
        f = u.font
    if prop(v, it, "size") != ""
        size = ui.px(u, num(v, it, "size", 14))
    tr = prop(v, it, "transform")
    if k == "caps" and prop(v, it, "size") == "" and fn == "" and tr == "" and prop(v, it, "spacing") == "" and prop(v, it, "align") == ""
        ui.styled_in(u, x + pad, y, h, s, "caption", c)
        return
    if f < 0
        ui.txt(u, x + pad, y + (h - u.line_h) / 2, s, c)
        return
    if k == "caps" or tr == "upper" or tr == "uppercase"
        s = upper(s)
    else if tr == "lower" or tr == "lowercase"
        s = lower(s)
    else if (tr == "capitalize" or tr == "first") and len(s) > 0
        s = upper(cut(s, 0, 0)) + cut(s, 1, len(s) - 1)
    sp = 0
    if prop(v, it, "spacing") != ""
        sp = ui.px(u, num(v, it, "spacing", 0))
    else if k == "caps"
        sp = ui.px(u, 1)
    room = w - 2 * pad
    lh = size * 5 / 4
    if prop(v, it, "line.height") != ""
        lh = size * pct_or_mul(prop(v, it, "line.height")) / 100
    // wrap: yes — длинный текст переносится по словам на новые строки (как абзац <p>)
    lines = list text
    if yes(prop(v, it, "wrap"))
        each para in split(s, "\n")
            line = ""
            each word in split(para, " ")
                tryl = word
                if line != ""
                    tryl = line + " " + word
                if line != "" and wide(f, tryl, size, sp) > room
                    lines.add(line)
                    line = word
                else
                    line = tryl
            lines.add(line)
    else
        // окно сузили — длинный текст кончается на «..», а не вылезает из клетки
        if wide(f, s, size, sp) > room
            n = len(s)
            repeat while n > 1 and wide(f, cut(s, 0, n - 1) + "..", size, sp) > room
                n -= 1
            s = cut(s, 0, n - 1) + ".."
        lines.add(s)
    al = prop(v, it, "align")
    total = lh * len(lines)
    ty = y + (h - total) / 2
    if yes(prop(v, it, "wrap"))
        ty = y + pad
    deco = prop(v, it, "decoration")
    each ln in lines
        tw = wide(f, ln, size, sp)
        tx = x + pad
        if al == "center"
            tx = x + (w - tw) / 2
        else if al == "right"
            tx = x + w - tw - pad
        gy = ty + (lh - size * 5 / 4) / 2
        if sp == 0
            draw_font(f, tx, gy, ln, size, c)
        else
            cx = tx
            each ch in ln
                draw_font(f, cx, gy, ch, size, c)
                cx += text_width(f, ch, size) + sp
        t = max(1, size / 14)
        if deco == "underline"
            draw_rect(tx, gy + size * 9 / 8, tw, t, c)
        else if deco == "line-through" or deco == "strike"
            draw_rect(tx, gy + size * 5 / 8, tw, t, c)
        ty += lh

// ширина текста с разрядкой sp между буквами
func wide(f: int, s: text, size: int, sp: int)
    if sp == 0
        return text_width(f, s, size)
    return text_width(f, s, size) + sp * len(s)

// line.height: 1.5 или 150% → 150
func pct_or_mul(s: text)
    t = trim(s)
    if ends_with(t, "%")
        return to_int(cut(t, 0, len(t) - 2)) or 125
    d = to_dec(t) or 1.25
    return round(d * 100)

// цвет по имени темы (accent, ink, dim, red, panel, bg, raised, field, line, faint, white, black) или #rrggbb
func color(u: Ui, name: text, fallback: int)
    n = lower(trim(name))
    if n == "accent"
        return u.accent
    if n == "ink"
        return u.ink
    if n == "dim"
        return u.dim
    if n == "red"
        return u.red
    if n == "panel"
        return u.panel
    if n == "bg"
        return u.bg
    if n == "raised"
        return u.raised
    if n == "field"
        return u.fieldbg
    if n == "line"
        return u.line
    if n == "faint"
        return u.faint
    if n == "white"
        return rgb(255, 255, 255)
    if n == "black"
        return rgb(0, 0, 0)
    if starts_with(n, "#") and len(n) == 7
        return rgb(hex2(cut(n, 1, 2)), hex2(cut(n, 3, 4)), hex2(cut(n, 5, 6)))
    if starts_with(n, "#") and len(n) == 4
        return rgb(hex2(cut(n, 1, 1)) * 17, hex2(cut(n, 2, 2)) * 17, hex2(cut(n, 3, 3)) * 17)
    // rgb(10, 20, 30) как в CSS
    if starts_with(n, "rgb(") and ends_with(n, ")")
        parts = split(cut(n, 4, len(n) - 2), ",")
        if len(parts) >= 3
            return rgb(to_int(trim(parts[0])) or 0, to_int(trim(parts[1])) or 0, to_int(trim(parts[2])) or 0)
    if n == "transparent" or n == "none"
        return u.bg
    // имена цветов из CSS
    if n == "red"
        return u.red
    if n == "green"
        return rgb(60, 190, 110)
    if n == "blue"
        return rgb(70, 130, 240)
    if n == "yellow"
        return rgb(240, 200, 60)
    if n == "orange"
        return rgb(245, 150, 50)
    if n == "purple"
        return rgb(150, 100, 230)
    if n == "pink"
        return rgb(240, 110, 170)
    if n == "gray" or n == "grey"
        return rgb(140, 145, 160)
    return fallback

func hex2(s: text)
    n = 0
    each ch in s
        d = find("0123456789abcdef", ch)
        n = n * 16 + max(0, d)
    return n

// файл поменяли — читаем заново (что ввели в поля, остаётся)
func again(v: TbsView)
    src = read_file(v.path) else err
        return
    if src != v.src
        parse(v, src)

func show_errors(u: Ui, v: TbsView, x: int, y: int, w: int)
    if not v.said
        each e in v.errors
            print(e)
        v.said = true
    ty = y + ui.px(u, 16)
    each e in v.errors
        ui.txt(u, x + ui.px(u, 16), ty, ui.fit(u, e, w - ui.px(u, 32)), u.red)
        ty += ui.px(u, 22)
