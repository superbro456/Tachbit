// lib/shaders.tb — готовые шейдеры (gpu func) для игр: бери как есть или скопируй и поменяй под себя.
//   use shaders
//   mesh_shader(sea, "sea_waves")      // углы: волны
//   mesh_shader(sea, "sea_water")      // точки: цвет воды, блики, пена
//   shader_set(sea, "height", 0.2)     // настройки — числа после p или v
// Точка p: x, y (экран), z (глубина), wx wy wz (место в мире), nx ny nz (нормаль), u v, r g b a (цвет сетки),
// time (секунды), sx sy sz (куда светит солнце), amb (фон), cx cy cz (камера), tx ty tz (касательная: куда растёт u).
// В любой gpu func: lamp_k(i, x, y, z) — сколько света лампы i (0…7) доходит до точки, lamp_x/y/z(i), lamp_r/g/b(i);
// tex_r/g/b/a(слот, u, v) — цвет картинки слота 0…3 (shader_image), tex_on(слот) — есть ли там картинка.
// Угол v: x y z (в сетке), nx ny nz, u v, r g b a, time, i (номер угла).

// ---------- общие помощники ----------

// свет солнца: рассеянный + фон
gpu func sun_light(nx: dec, ny: dec, nz: dec, sx: dec, sy: dec, sz: dec, amb: dec) gives k: dec
    l = nx * sx + ny * sy + nz * sz
    if l < 0
        l = 0
    return amb + (1 - amb) * l

// блик (Блинн — Фонг): степень power, глаз в (ex, ey, ez), точка в (wx, wy, wz)
gpu func spec_light(nx: dec, ny: dec, nz: dec, sx: dec, sy: dec, sz: dec, wx: dec, wy: dec, wz: dec, ex: dec, ey: dec, ez: dec, power: dec) gives k: dec
    vx = ex - wx
    vy = ey - wy
    vz = ez - wz
    vl = sqrt(vx * vx + vy * vy + vz * vz) + 0.0001
    hx = sx + vx / vl
    hy = sy + vy / vl
    hz = sz + vz / vl
    hl = sqrt(hx * hx + hy * hy + hz * hz) + 0.0001
    d = (nx * hx + ny * hy + nz * hz) / hl
    if d < 0
        return 0
    return pow(d, power)

// рябь: сумма шума на трёх масштабах (0…1)
gpu func ripple(x: dec, y: dec, z: dec) gives r: dec
    return noise(x, y, z) * 0.5 + noise(x * 2.1, y * 2.1, z * 1.3) * 0.3 + noise(x * 4.3, y * 4.3, z * 1.7) * 0.2

// ---------- обычный материал: свет, блик, кайма, туман ----------
// shine — сила блика, power — острота, rim — светлая кайма по краю, fog_near / fog_far — туман (0 — без), fog_r g b — его цвет
gpu func standard(p: pixel, shine: dec, power: dec, rim: dec, fog_near: dec, fog_far: dec, fog_r: dec, fog_g: dec, fog_b: dec)
    k = sun_light(p.nx, p.ny, p.nz, p.sx, p.sy, p.sz, p.amb)
    pw = power
    if pw <= 0
        pw = 32
    s = shine * spec_light(p.nx, p.ny, p.nz, p.sx, p.sy, p.sz, p.wx, p.wy, p.wz, p.cx, p.cy, p.cz, pw)
    vx = p.cx - p.wx
    vy = p.cy - p.wy
    vz = p.cz - p.wz
    vl = sqrt(vx * vx + vy * vy + vz * vz) + 0.0001
    edge = 1 - abs(p.nx * vx + p.ny * vy + p.nz * vz) / vl
    e = rim * edge * edge * edge
    p.r = p.r * (k + lamps_light(0, p.nx, p.ny, p.nz, p.wx, p.wy, p.wz)) + s + e
    p.g = p.g * (k + lamps_light(1, p.nx, p.ny, p.nz, p.wx, p.wy, p.wz)) + s + e
    p.b = p.b * (k + lamps_light(2, p.nx, p.ny, p.nz, p.wx, p.wy, p.wz)) + s + e
    if fog_far > fog_near
        f = clamp((vl - fog_near) / (fog_far - fog_near), 0, 1)
        p.r = mix(p.r, fog_r, f)
        p.g = mix(p.g, fog_g, f)
        p.b = mix(p.b, fog_b, f)

// ---------- лампы в шейдере ----------
// свет всех ламп (point_light, spot_light) по каналу ch (0 — красный, 1 — зелёный, 2 — синий) в точке (wx, wy, wz)
// с нормалью (nx, ny, nz): рассеянный, без бликов. Добавь к цвету: p.r = p.r * (k + lamps_light(0, ...))
gpu func lamps_light(ch: int, nx: dec, ny: dec, nz: dec, wx: dec, wy: dec, wz: dec) gives s: dec
    s = 0.0
    count i from 0 to 7
        k = lamp_k(i, wx, wy, wz)
        if k > 0
            lx = lamp_x(i) - wx
            ly = lamp_y(i) - wy
            lz = lamp_z(i) - wz
            ll = sqrt(lx * lx + ly * ly + lz * lz) + 0.000001
            nl = (nx * lx + ny * ly + nz * lz) / ll
            if nl > 0
                c = lamp_r(i)
                if ch == 1
                    c = lamp_g(i)
                else if ch == 2
                    c = lamp_b(i)
                s = s + c * k * nl
    return s

// ---------- PBR: металл и шероховатость, рельеф, все лампы, отражение неба ----------
// Цвет — цвет сетки × картинка слота 0 (mesh_image или shader_image(m, 0, картинка)).
// Рельеф — карта нормалей в слоте 1: shader_image(m, 1, картинка) (синеватая картинка: x — красный, y — зелёный).
// metal — металл 0…1, rough — шероховатость 0…1 (0 — как 0.5; 0.05 — зеркало, 1 — мел),
// bump — сила рельефа (0 — как 1), tile — сколько раз картинки повторяются (0 — как 1),
// reflect — отражение неба (0 — как 1; совсем без — 0.001), fog_far — туман цвета неба (0 — без).
// Яркие места не «выгорают» в белое, а мягко подходят к нему (тон-маппинг ACES).
gpu func ggx(nh: dec, a: dec) gives d: dec
    a2 = a * a
    t = nh * nh * (a2 - 1) + 1
    return a2 / (3.14159265 * t * t + 0.000001)

gpu func smith(nv: dec, nl: dec, k: dec) gives g: dec
    return nv / (nv * (1 - k) + k) * nl / (nl * (1 - k) + k)

gpu func fresnel(f0: dec, c: dec) gives f: dec
    return f0 + (1 - f0) * pow(clamp(1 - c, 0, 1), 5)

// блик (Кук — Торранс без Френеля): нормаль n, к глазу v, к свету l (все длиной 1), уже умножен на n·l
gpu func pbr_spec(nx: dec, ny: dec, nz: dec, vx: dec, vy: dec, vz: dec, lx: dec, ly: dec, lz: dec, rough: dec) gives s: dec
    hx = lx + vx
    hy = ly + vy
    hz = lz + vz
    hl = sqrt(hx * hx + hy * hy + hz * hz)
    if hl < 0.00001
        return 0.0
    nh = max((nx * hx + ny * hy + nz * hz) / hl, 0.0)
    nv = max(nx * vx + ny * vy + nz * vz, 0.001)
    nl = max(nx * lx + ny * ly + nz * lz, 0.0)
    k = (rough + 1) * (rough + 1) / 8
    return ggx(nh, rough * rough) * smith(nv, nl, k) / (4 * nv)

// косинус между глазом и серединой (для Френеля)
gpu func pbr_vh(vx: dec, vy: dec, vz: dec, lx: dec, ly: dec, lz: dec) gives c: dec
    hx = lx + vx
    hy = ly + vy
    hz = lz + vz
    hl = sqrt(hx * hx + hy * hy + hz * hz) + 0.00001
    return clamp((vx * hx + vy * hy + vz * hz) / hl, 0, 1)

gpu func aces(x: dec) gives y: dec
    x = max(x, 0.0)
    return clamp(x * (2.51 * x + 0.03) / (x * (2.43 * x + 0.59) + 0.14), 0, 1)

gpu func pbr(p: pixel, metal: dec, rough: dec, bump: dec, tile: dec, reflect: dec, fog_far: dec)
    if rough <= 0
        rough = 0.5
    rough = clamp(rough, 0.05, 1)
    if bump <= 0
        bump = 1.0
    if tile <= 0
        tile = 1.0
    if reflect <= 0
        reflect = 1.0
    metal = clamp(metal, 0, 1)
    u = p.u * tile
    v = p.v * tile
    ar = p.r
    ag = p.g
    ab = p.b
    if tex_on(0)
        ar = ar * tex_r(0, u, v)
        ag = ag * tex_g(0, u, v)
        ab = ab * tex_b(0, u, v)
    // свет считается в «линейных» цветах (как в настоящих движках), в конце — обратно для экрана
    ar = ar * ar
    ag = ag * ag
    ab = ab * ab
    nx = p.nx
    ny = p.ny
    nz = p.nz
    if tex_on(1)
        mx = (tex_r(1, u, v) * 2 - 1) * bump
        my = (tex_g(1, u, v) * 2 - 1) * bump
        mz = tex_b(1, u, v) * 2 - 1
        // касательная поперёк нормали, третья ось — нормаль × касательная
        d = p.tx * nx + p.ty * ny + p.tz * nz
        tx = p.tx - nx * d
        ty = p.ty - ny * d
        tz = p.tz - nz * d
        tl = sqrt(tx * tx + ty * ty + tz * tz)
        if tl > 0.0001
            tx = tx / tl
            ty = ty / tl
            tz = tz / tl
            kx = ny * tz - nz * ty
            ky = nz * tx - nx * tz
            kz = nx * ty - ny * tx
            qx = tx * mx + kx * my + nx * mz
            qy = ty * mx + ky * my + ny * mz
            qz = tz * mx + kz * my + nz * mz
            ql = sqrt(qx * qx + qy * qy + qz * qz)
            if ql > 0.0001
                nx = qx / ql
                ny = qy / ql
                nz = qz / ql
    vx = p.cx - p.wx
    vy = p.cy - p.wy
    vz = p.cz - p.wz
    dist = sqrt(vx * vx + vy * vy + vz * vz) + 0.00001
    vx = vx / dist
    vy = vy / dist
    vz = vz / dist
    fr = mix(0.04, ar, metal)
    fg = mix(0.04, ag, metal)
    fb = mix(0.04, ab, metal)
    kd = 1 - metal
    cr = 0.0
    cg = 0.0
    cb = 0.0
    // солнце
    sl = sqrt(p.sx * p.sx + p.sy * p.sy + p.sz * p.sz)
    if sl > 0.001
        lx = p.sx / sl
        ly = p.sy / sl
        lz = p.sz / sl
        nl = nx * lx + ny * ly + nz * lz
        if nl > 0
            s = pbr_spec(nx, ny, nz, vx, vy, vz, lx, ly, lz, rough)
            c = pbr_vh(vx, vy, vz, lx, ly, lz)
            sun = (1 - p.amb) * 1.6
            f = fresnel(fr, c)
            cr = cr + ((1 - f) * kd * ar * nl + f * s) * sun
            f = fresnel(fg, c)
            cg = cg + ((1 - f) * kd * ag * nl + f * s) * sun
            f = fresnel(fb, c)
            cb = cb + ((1 - f) * kd * ab * nl + f * s) * sun
    // лампы
    count i from 0 to 7
        k = lamp_k(i, p.wx, p.wy, p.wz)
        if k > 0
            lx = lamp_x(i) - p.wx
            ly = lamp_y(i) - p.wy
            lz = lamp_z(i) - p.wz
            ll = sqrt(lx * lx + ly * ly + lz * lz) + 0.000001
            lx = lx / ll
            ly = ly / ll
            lz = lz / ll
            nl = nx * lx + ny * ly + nz * lz
            if nl > 0
                s = pbr_spec(nx, ny, nz, vx, vy, vz, lx, ly, lz, rough)
                c = pbr_vh(vx, vy, vz, lx, ly, lz)
                k = k * 1.6
                f = fresnel(fr, c)
                cr = cr + ((1 - f) * kd * ar * nl + f * s) * k * lamp_r(i)
                f = fresnel(fg, c)
                cg = cg + ((1 - f) * kd * ag * nl + f * s) * k * lamp_g(i)
                f = fresnel(fb, c)
                cb = cb + ((1 - f) * kd * ab * nl + f * s) * k * lamp_b(i)
    // фон и отражение неба: луч от глаза отражается от точки и смотрит в небо
    nv = max(nx * vx + ny * vy + nz * vz, 0.0)
    ry = 2 * nv * ny - vy
    t = clamp(ry, 0, 1)
    skr = mix(0.62, 0.16, t)
    skg = mix(0.68, 0.3, t)
    skb = mix(0.75, 0.62, t)
    // вниз — земля: тёмная, чуть тёплая
    if ry < 0
        g = clamp(-ry * 4, 0, 1)
        skr = mix(skr, 0.1, g)
        skg = mix(skg, 0.09, g)
        skb = mix(skb, 0.08, g)
    // шершавое отражает «среднее небо», гладкое — само небо в отражённой стороне
    skr = mix(skr, 0.3, rough)
    skg = mix(skg, 0.34, rough)
    skb = mix(skb, 0.42, rough)
    env = clamp(p.amb * 3, 0, 1) * reflect
    edge = pow(1 - nv, 5) * (1 - rough) * (1 - rough)
    cr = cr + p.amb * ar * kd + skr * (fr + (1 - fr) * edge) * env
    cg = cg + p.amb * ag * kd + skg * (fg + (1 - fg) * edge) * env
    cb = cb + p.amb * ab * kd + skb * (fb + (1 - fb) * edge) * env
    p.r = sqrt(aces(cr))
    p.g = sqrt(aces(cg))
    p.b = sqrt(aces(cb))
    if fog_far > 0
        q = clamp(dist / fog_far, 0, 1)
        q = q * q
        p.r = mix(p.r, 0.78, q)
        p.g = mix(p.g, 0.82, q)
        p.b = mix(p.b, 0.86, q)

// ---------- мультяшный: свет ступеньками и тёмный контур ----------
gpu func toon(p: pixel, steps: dec, outline: dec)
    n = steps
    if n < 1
        n = 3
    l = p.nx * p.sx + p.ny * p.sy + p.nz * p.sz
    if l < 0
        l = 0
    l = floor(l * n + 0.5) / n
    k = p.amb + (1 - p.amb) * l
    vx = p.cx - p.wx
    vy = p.cy - p.wy
    vz = p.cz - p.wz
    vl = sqrt(vx * vx + vy * vy + vz * vz) + 0.0001
    if abs(p.nx * vx + p.ny * vy + p.nz * vz) / vl < outline
        k = 0.1
    p.r = p.r * k
    p.g = p.g * k
    p.b = p.b * k

// ---------- вода ----------
// углы: волны высотой height, скорость speed, длина length (нормаль тоже наклоняется)
gpu func sea_waves(v: corner, height: dec, speed: dec, length: dec)
    ln = length
    if ln <= 0
        ln = 2
    k = 6.2831853 / ln
    t = v.time * speed
    a = sin(v.x * k + t)
    b = cos(v.z * k * 0.8 + t * 1.3)
    v.y += (a + b * 0.6) * height
    // наклон волны: производные по x и z
    dx = cos(v.x * k + t) * k * height
    dz = -sin(v.z * k * 0.8 + t * 1.3) * k * 0.8 * height * 0.6
    nl = sqrt(dx * dx + 1 + dz * dz)
    v.nx = -dx / nl
    v.ny = 1 / nl
    v.nz = -dz / nl

// точки: глубокий и мелкий цвет, блики солнца, пена на гребнях, прозрачность clear (0 — непрозрачная)
gpu func sea_water(p: pixel, foam: dec, clear: dec)
    rp = ripple(p.wx * 1.5, p.wz * 1.5, p.time * 0.6)
    nx = p.nx + (rp - 0.5) * 0.3
    nz = p.nz + (noise(p.wz * 1.7, p.wx * 1.7, p.time * 0.5) - 0.5) * 0.3
    nl = sqrt(nx * nx + p.ny * p.ny + nz * nz)
    nx = nx / nl
    ny = p.ny / nl
    nz = nz / nl
    k = sun_light(nx, ny, nz, p.sx, p.sy, p.sz, p.amb)
    s = spec_light(nx, ny, nz, p.sx, p.sy, p.sz, p.wx, p.wy, p.wz, p.cx, p.cy, p.cz, 64) * 1.5
    vx = p.cx - p.wx
    vy = p.cy - p.wy
    vz = p.cz - p.wz
    vl = sqrt(vx * vx + vy * vy + vz * vz) + 0.0001
    fres = pow(1 - clamp((nx * vx + ny * vy + nz * vz) / vl, 0, 1), 3)
    deep_r = p.r * 0.4
    deep_g = p.g * 0.6
    deep_b = p.b * 0.8
    p.r = mix(deep_r, 0.6, fres * 0.5) * k + s
    p.g = mix(deep_g, 0.75, fres * 0.5) * k + s
    p.b = mix(deep_b, 0.9, fres * 0.5) * k + s
    f = smoothstep(0.62, 0.8, rp) * foam
    p.r = mix(p.r, 1, f)
    p.g = mix(p.g, 1, f)
    p.b = mix(p.b, 1, f)
    p.a = 1 - clear * (1 - fres) * (1 - f)

// ---------- огонь ----------
// углы: язык пламени качается и тянется вверх (сетка от y = 0 до y = 1)
gpu func flame_shape(v: corner, sway: dec, speed: dec)
    t = v.time * speed
    h = clamp(v.y, 0, 1)
    v.x += sin(t * 3 + v.y * 4) * sway * h
    v.z += cos(t * 2.3 + v.y * 3) * sway * h
    v.y += (noise(v.x * 2, v.z * 2, t) - 0.5) * 0.2 * h

// точки: горячий низ, жёлтое ядро, красные края, мерцание; светится сам (свет не нужен)
gpu func fire(p: pixel, speed: dec, power: dec)
    t = p.time * speed
    pw = power
    if pw <= 0
        pw = 1
    n = ripple(p.wx * 3, p.wy * 3 - t * 2, t * 0.5)
    h = clamp(p.v, 0, 1)
    if h == 0
        h = clamp(p.wy * 0.5, 0, 1)
    heat = clamp((1 - h) * 1.2 * pw + n * 0.6 - 0.3, 0, 1)
    p.r = clamp(heat * 1.8, 0, 1)
    p.g = clamp(heat * heat * 1.4, 0, 1)
    p.b = clamp(heat * heat * heat * 0.8, 0, 1)
    p.a = clamp(heat * 1.5, 0, 1)

// ---------- небо (на большой шар вокруг камеры) ----------
// zenith_r g b — цвет вверху, горизонт светлее; солнце — яркий круг size
gpu func sky(p: pixel, zenith_r: dec, zenith_g: dec, zenith_b: dec, sun_size: dec)
    vx = p.wx - p.cx
    vy = p.wy - p.cy
    vz = p.wz - p.cz
    vl = sqrt(vx * vx + vy * vy + vz * vz) + 0.0001
    up = clamp(vy / vl, 0, 1)
    zr = zenith_r
    zg = zenith_g
    zb = zenith_b
    if zr + zg + zb == 0
        zr = 0.25
        zg = 0.45
        zb = 0.85
    h = pow(1 - up, 3)
    p.r = mix(zr, 0.85, h)
    p.g = mix(zg, 0.9, h)
    p.b = mix(zb, 0.95, h)
    d = (vx * p.sx + vy * p.sy + vz * p.sz) / vl
    ss = sun_size
    if ss <= 0
        ss = 0.02
    if d > 1 - ss
        p.r = 1
        p.g = 0.97
        p.b = 0.85
    else
        glow = pow(clamp(d, 0, 1), 64) * 0.5
        p.r += glow
        p.g += glow * 0.9
        p.b += glow * 0.6
    // облака: шум по направлению взгляда
    if up > 0.02
        cx = vx / vy * 2 + p.time * 0.02
        cz = vz / vy * 2
        c = smoothstep(0.55, 0.8, ripple(cx, cz, 0)) * clamp(up * 4, 0, 1)
        p.r = mix(p.r, 1, c * 0.8)
        p.g = mix(p.g, 1, c * 0.8)
        p.b = mix(p.b, 1, c * 0.8)

// ---------- трава и листья на ветру (углы) ----------
// чем выше угол над землёй (y), тем сильнее качается
gpu func wind(v: corner, strength: dec, speed: dec)
    h = max(v.y, 0)
    t = v.time * speed
    s = (sin(t + v.x * 0.7 + v.z * 0.4) + noise(v.x, v.z, t * 0.5) - 0.5) * strength * h * h
    v.x += s
    v.z += s * 0.5

// ---------- голограмма: полосы, мерцание, полупрозрачная ----------
gpu func hologram(p: pixel, lines: dec, speed: dec)
    n = lines
    if n <= 0
        n = 40
    s = fract(p.wy * n - p.time * speed)
    band = smoothstep(0, 0.5, s) * (1 - smoothstep(0.5, 1, s))
    flick = 0.8 + 0.2 * sin(p.time * 30)
    p.r = p.r * (0.5 + band) * flick
    p.g = p.g * (0.5 + band) * flick
    p.b = p.b * (0.5 + band) * flick
    p.a = 0.3 + 0.5 * band

// ---------- растворение: точки исчезают по шуму (amount 0 — целый, 1 — нет) ----------
gpu func dissolve(p: pixel, amount: dec, edge_glow: dec)
    n = noise(p.wx * 4, p.wy * 4, p.wz * 4)
    k = sun_light(p.nx, p.ny, p.nz, p.sx, p.sy, p.sz, p.amb)
    p.r = p.r * k
    p.g = p.g * k
    p.b = p.b * k
    if n < amount
        p.a = 0
    else if n < amount + 0.05
        p.r += edge_glow
        p.g += edge_glow * 0.5

// ========== эффекты на весь экран (s: screen) ==========
// Ставятся словом screen_shader("glow") после 3D и до подсказок: всё, что нарисовано раньше, проходит через эффект.
//   screen_set("glow", "power", 0.8)   // настройки — как у сеток
// Точка экрана s: x, y (место), w, h (размер окна), r g b a (её цвет; a < 1 — эффект смешивается с кадром),
// time; screen_r(x, y), screen_g, screen_b — цвет любой точки кадра; screen_soft_r/g/b — между точками
// мягкая смесь четырёх соседей (вчетверо дороже — для сглаживания и плавных сдвигов),
// screen_depth(x, y) — даль от камеры в единицах мира (нет 3D — 1000000).

// яркость точки (как видит глаз)
gpu func luma(r: dec, g: dec, b: dec) gives l: dec
    return r * 0.299 + g * 0.587 + b * 0.114

// свечение (bloom): яркие места расплываются светом вокруг. power — сила, threshold — с какой яркости (0…1), size — ширина в точках
gpu func glow(s: screen, power: dec, threshold: dec, size: dec)
    th = threshold
    if th <= 0
        th = 0.7
    sz = size
    if sz <= 0
        sz = 12
    ar = 0.0
    ag = 0.0
    ab = 0.0
    count ring from 1 to 2
        rad = sz * ring / 2
        count k from 0 to 7
            an = k * 0.7853982 + ring * 0.4
            x = s.x + cos(an) * rad
            y = s.y + sin(an) * rad
            r = screen_r(x, y)
            g = screen_g(x, y)
            b = screen_b(x, y)
            e = max(luma(r, g, b) - th, 0) / (1 - th + 0.001)
            wgt = e / ring
            ar += r * wgt
            ag += g * wgt
            ab += b * wgt
    p = power
    if p <= 0
        p = 0.8
    s.r += ar * p / 8
    s.g += ag * p / 8
    s.b += ab * p / 8

// размытие: radius — на сколько точек (для меню паузы, расфокуса)
gpu func blur(s: screen, radius: dec)
    rd = radius
    if rd <= 0
        rd = 4
    ar = 0.0
    ag = 0.0
    ab = 0.0
    count i from -2 to 2
        count j from -2 to 2
            x = s.x + i * rd / 2
            y = s.y + j * rd / 2
            ar += screen_r(x, y)
            ag += screen_g(x, y)
            ab += screen_b(x, y)
    s.r = ar / 25
    s.g = ag / 25
    s.b = ab / 25

// сглаживание (FXAA): убирает «лесенку» на краях. strength 0…1 (0 — 1)
gpu func fxaa(s: screen, strength: dec)
    lm = luma(s.r, s.g, s.b)
    lnw = luma(screen_r(s.x - 1, s.y - 1), screen_g(s.x - 1, s.y - 1), screen_b(s.x - 1, s.y - 1))
    lne = luma(screen_r(s.x + 1, s.y - 1), screen_g(s.x + 1, s.y - 1), screen_b(s.x + 1, s.y - 1))
    lsw = luma(screen_r(s.x - 1, s.y + 1), screen_g(s.x - 1, s.y + 1), screen_b(s.x - 1, s.y + 1))
    lse = luma(screen_r(s.x + 1, s.y + 1), screen_g(s.x + 1, s.y + 1), screen_b(s.x + 1, s.y + 1))
    lo = min(lm, min(min(lnw, lne), min(lsw, lse)))
    hi = max(lm, max(max(lnw, lne), max(lsw, lse)))
    if hi - lo < max(0.04, hi * 0.15)
        return
    dx = -((lnw + lne) - (lsw + lse))
    dy = (lnw + lsw) - (lne + lse)
    k = 1 / (min(abs(dx), abs(dy)) + max((lnw + lne + lsw + lse) * 0.03125, 0.0078))
    dx = clamp(dx * k, -8, 8)
    dy = clamp(dy * k, -8, 8)
    r = (screen_soft_r(s.x - dx / 6, s.y - dy / 6) + screen_soft_r(s.x + dx / 6, s.y + dy / 6)) * 0.5
    g = (screen_soft_g(s.x - dx / 6, s.y - dy / 6) + screen_soft_g(s.x + dx / 6, s.y + dy / 6)) * 0.5
    b = (screen_soft_b(s.x - dx / 6, s.y - dy / 6) + screen_soft_b(s.x + dx / 6, s.y + dy / 6)) * 0.5
    r2 = r * 0.5 + (screen_soft_r(s.x - dx / 2, s.y - dy / 2) + screen_soft_r(s.x + dx / 2, s.y + dy / 2)) * 0.25
    g2 = g * 0.5 + (screen_soft_g(s.x - dx / 2, s.y - dy / 2) + screen_soft_g(s.x + dx / 2, s.y + dy / 2)) * 0.25
    b2 = b * 0.5 + (screen_soft_b(s.x - dx / 2, s.y - dy / 2) + screen_soft_b(s.x + dx / 2, s.y + dy / 2)) * 0.25
    l2 = luma(r2, g2, b2)
    if l2 >= lo and l2 <= hi
        r = r2
        g = g2
        b = b2
    st = strength
    if st <= 0
        st = 1
    s.r = mix(s.r, r, st)
    s.g = mix(s.g, g, st)
    s.b = mix(s.b, b, st)

// туман по глубине: чем дальше от камеры, тем больше цвета fog_r g b. near, far — где начинается и где густой
gpu func depth_fog(s: screen, near: dec, far: dec, fog_r: dec, fog_g: dec, fog_b: dec)
    d = screen_depth(s.x, s.y)
    if d > 100000
        return
    fr = far
    if fr <= near
        fr = near + 30
    f = clamp((d - near) / (fr - near), 0, 1)
    f = f * f * (3 - 2 * f)
    cr = fog_r
    cg = fog_g
    cb = fog_b
    if cr + cg + cb == 0
        cr = 0.75
        cg = 0.82
        cb = 0.9
    s.r = mix(s.r, cr, f)
    s.g = mix(s.g, cg, f)
    s.b = mix(s.b, cb, f)

// цвет кадра: contrast (1 — как есть), saturation (1 — как есть, 0 — чёрно-белый),
// warmth (−1 холоднее … 1 теплее), bright (0 — как есть)
gpu func color(s: screen, contrast: dec, saturation: dec, warmth: dec, bright: dec)
    c = contrast
    if c <= 0
        c = 1
    sa = saturation
    if sa < 0
        sa = 0
    l = luma(s.r, s.g, s.b)
    r = mix(l, s.r, sa)
    g = mix(l, s.g, sa)
    b = mix(l, s.b, sa)
    r = (r - 0.5) * c + 0.5 + bright + warmth * 0.06
    g = (g - 0.5) * c + 0.5 + bright + warmth * 0.01
    b = (b - 0.5) * c + 0.5 + bright - warmth * 0.06
    s.r = r
    s.g = g
    s.b = b

// виньетка: края кадра темнее, взгляд в центр. power 0…1, size — где начинается (0.5 — середина пути до края)
gpu func vignette(s: screen, power: dec, size: dec)
    sz = size
    if sz <= 0
        sz = 0.5
    dx = (s.x / s.w - 0.5) * 2
    dy = (s.y / s.h - 0.5) * 2
    d = sqrt(dx * dx + dy * dy) / 1.4142
    k = 1 - power * smoothstep(sz, 1, d)
    s.r = s.r * k
    s.g = s.g * k
    s.b = s.b * k

// контур по глубине: тёмные линии там, где резко меняется даль (мультяшный вид). thick — толщина, dark — насколько тёмные (0…1)
gpu func outline(s: screen, thick: dec, dark: dec)
    t = thick
    if t <= 0
        t = 1
    d = screen_depth(s.x, s.y)
    e = 0.0
    e = max(e, abs(screen_depth(s.x + t, s.y) - d))
    e = max(e, abs(screen_depth(s.x - t, s.y) - d))
    e = max(e, abs(screen_depth(s.x, s.y + t) - d))
    e = max(e, abs(screen_depth(s.x, s.y - t) - d))
    dk = dark
    if dk <= 0
        dk = 0.85
    if e > 0.08 * min(d, 1000)
        k = 1 - dk
        s.r = s.r * k
        s.g = s.g * k
        s.b = s.b * k

// крупные квадраты, как в старых играх: size — размер квадрата в точках
gpu func pixelate(s: screen, size: dec)
    sz = max(size, 1)
    x = floor(s.x / sz) * sz + sz * 0.5
    y = floor(s.y / sz) * sz + sz * 0.5
    s.r = screen_r(x, y)
    s.g = screen_g(x, y)
    s.b = screen_b(x, y)

// под водой: кадр колышется и уходит в синеву. wave — сила волн в точках
gpu func underwater(s: screen, wave: dec, tint: dec)
    wv = wave
    if wv <= 0
        wv = 3
    x = s.x + sin(s.y * 0.05 + s.time * 2) * wv
    y = s.y + cos(s.x * 0.04 + s.time * 1.6) * wv * 0.6
    s.r = screen_soft_r(x, y) * (1 - tint * 0.6)
    s.g = screen_soft_g(x, y) * (1 - tint * 0.2)
    s.b = mix(screen_soft_b(x, y), 0.8, tint * 0.4)
