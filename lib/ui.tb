// ui — кнопки, списки, поля, меню, вкладки, окна внутри окна и раскладка для своих приложений.
// Это обычная библиотека на самом Tachbit: она только рисует прямоугольники, круги и буквы
// и смотрит на мышь и клавиши. В компилятор ничего не встроено.
//
//   use ui
//   func main()
//       window_sharp()                              // резко на Retina (можно без этого)
//       try window_open(800, 500, "Моё приложение")
//       u = ui.start()
//       repeat while window_alive()
//           ui.frame(u)                             // в начале каждого кадра
//           clear_window(u.bg)
//           ui.pad(u, 12)
//           if ui.btn(u, "Нажми")
//               print("нажали")
//           ui.end_frame(u)                         // в конце: меню, подсказки, вопрос — поверх всего
//
// «Немедленное» рисование: каждый кадр программа заново зовёт ui.btn и т.п., а функция сразу
// и рисует, и отвечает, нажали ли. Хранить кнопки где-то не нужно.
//
// Раскладка без координат: ui.vbox / ui.hbox делят место окна, а ui.btn, ui.lbl, ui.edit, ui.toggle,
// ui.slide, ui.pick, ui.tabs, ui.area, ui.picture встают в следующее свободное место. Функции
// с x, y, w, h (button, field, check, row ...) остаются для своих хитрых мест.
//
// Все размеры пишутся в обычных точках, а на Retina (window_sharp) ui сам умножает их на window_scale().
// Библиотека лежит в lib/ui.tb; tools/install.sh кладёт её в ~/.tachbit/lib, и `use ui` находит её из любой папки.

obj Ui
    mx: int
    my: int
    down: bool
    press: bool          // кнопку мыши нажали в этом кадре
    release: bool        // и отпустили
    press_x: int         // где нажали (перетаскивание)
    press_y: int
    active: text         // что держат мышью (полоса прокрутки, ползунок, окно)
    grab: int            // где схватили
    grab_y: int
    last_click: int      // время прошлого щелчка: два быстрых — двойной щелчок
    last_id: text
    tick: int            // номер кадра
    keys: dict text bool // клавиша нажата в этом кадре
    was: dict text bool  // и в прошлом
    seen: dict text int  // в каком кадре её смотрели последний раз
    held: dict text int  // сколько кадров клавишу держат (повтор стрелок)
    wheel: int           // колёсико в этом кадре: + вперёд, − назад
    side_back: bool      // боковая кнопка мыши «назад» нажата сейчас
    side_fwd: bool       // и «вперёд»
    back_press: bool     // «назад» нажали в этом кадре
    fwd_press: bool      // «вперёд» нажали в этом кадре
    typed: text          // буквы, набранные в этом кадре
    focus: text          // в каком поле ввода сейчас печатают ("" — ни в каком)
    focus_tick: int      // когда поле получило фокус (мигание чёрточки)
    entered: bool        // в поле нажали Enter в этом кадре
    caret: int           // где чёрточка в поле с фокусом (номер буквы)
    anchor: int          // начало выделения (= caret — ничего не выделено)
    scroll: dict text int    // первая видимая строка многострочного поля
    // окно-вопрос
    ask_open: bool
    in_ask: bool
    ask_title: text
    ask_text: text
    ask_yes: text
    ask_no: text
    ask_answer: int      // 0 — ещё думают, 1 — да, 2 — нет
    ask_tick: int        // кадр, в котором вопрос открыли: тот же щелчок его не закроет
    // всплывающий список (меню, выбор): рисуется в end_frame поверх всего
    pop: text            // чей список открыт ("" — никакой)
    pop_items: list text
    pop_x: int
    pop_y: int
    pop_w: int
    pop_pick: int        // что выбрали (−1 — ничего); забирает тот, чей список
    pop_tick: int
    in_pop: bool
    // подсказка у последнего места
    tip: text
    tip_id: text
    hover_id: text
    hover_since: int
    // перетаскивание
    drag_data: text
    dragging: bool
    drop_tick: int
    // окна внутри окна
    win_x: dict text int
    win_y: dict text int
    win_open: dict text bool
    win_rects: list int      // x, y, w, h окон прошлого кадра (по порядку рисования)
    win_now: list int        // и этого
    win_i: int               // в каком окне рисуем сейчас (−1 — в самом окне программы)
    // последнее место, которое отдала раскладка (для tip, drag, drop)
    lx: int
    ly: int
    lw: int
    lh: int
    // курсор мыши, который просили в этом кадре
    want_cursor: text
    cursor_now: text
    // шрифт: настоящий TTF (ui.start находит системный), -1 — встроенный пиксельный 8×16
    font: int
    bold: int            // полужирный шрифт: заголовки, кнопки (нет своего — тот же font)
    mono: int            // моноширинный шрифт для кода
    fs: int              // размер букв (уже с учётом масштаба)
    line_h: int          // высота строки текста
    k: dec               // масштаб: 1.0, а на Retina 2.0
    radius: int          // скругление кнопок и полей (0 — острые)
    cr: int              // скругление карточек, окон, всплывающих списков
    // плавность и спокойный режим
    anim: dict text int  // наведение у каждой кнопки: 0..100, меняется плавно
    busy_ms: int         // когда что-то происходило последний раз (мышь, клавиши, анимация)
    calm_fps: int        // спокойный режим: столько кадров в секунду, пока ничего не происходит (0 — выключен)
    fps_now: int
    old_mx: int
    old_my: int
    // цвета (можно поменять: u.accent = rgb(...), или ui.light(u) / ui.dark(u))
    bg: int
    panel: int
    line: int
    ink: int             // обычный текст
    dim: int             // бледный текст
    accent: int
    on_accent: int       // текст на цветной кнопке
    hover: int
    sel: int
    red: int
    shadow: int          // тень (полупрозрачный rgba)
    raised: int          // приподнятое: обычная кнопка, выбранная вкладка, всплывающий список
    fieldbg: int         // фон поля ввода
    faint: int           // совсем бледное: выключенная кнопка
    boxes: list Box      // раскладка: вложенные ряды и столбцы, последний — текущий

// место раскладки: прямоугольник, который отдаёт себя по кускам
obj Box
    x: int
    y: int
    w: int
    h: int
    across: bool         // true — куски слева направо, false — сверху вниз
    gap: int             // промежуток между кусками
    used: int            // сколько занято с начала
    used_end: int        // и с конца
    rev: bool            // после ui.at_end: куски идут с конца (справа налево, снизу вверх)

modpub func start() gives u: Ui
    u = Ui(active: "", font: -1, bold: -1, mono: -1, k: 1.0, pop_pick: -1, win_i: -1, cursor_now: "arrow", calm_fps: 10)
    if window_scale() > 1.0
        u.k = window_scale()
    u.fs = px(u, 14)
    u.line_h = px(u, 16)
    u.radius = px(u, 10)
    u.cr = px(u, 14)
    // свои шрифты ui лежат рядом с библиотекой: lib/fonts (Inter и JetBrains Mono)
    home = env("HOME")
    if home == ""
        home = env("USERPROFILE")
    dirs = [env("TB_LIB"), home + "/.tachbit/lib", "lib"]
    each d in dirs
        if d != "" and u.font < 0 and file_exists(d + "/fonts/Inter-Regular.ttf")
            u.font = font_or(d + "/fonts/Inter-Regular.ttf")
            u.bold = font_or(d + "/fonts/Inter-SemiBold.ttf")
            u.mono = font_or(d + "/fonts/JetBrainsMono-Regular.ttf")
    // свой шрифт можно дать в TB_UI_FONT или потом ui.use_font(u, "шрифт.ttf")
    if env("TB_UI_FONT") != "" and file_exists(env("TB_UI_FONT"))
        u.font = font_or(env("TB_UI_FONT"))
        u.bold = u.font
    if u.font < 0
        paths = ["/System/Library/Fonts/SFNS.ttf", "/System/Library/Fonts/Helvetica.ttc", "/System/Library/Fonts/Supplemental/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf", "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf", "C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/arial.ttf"]
        each p in paths
            if p != "" and file_exists(p)
                u.font = font_or(p)
                if u.font >= 0
                    stop
    if u.bold < 0
        u.bold = u.font
    if u.mono < 0
        monos = ["/System/Library/Fonts/Menlo.ttc", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", "C:/Windows/Fonts/consola.ttf"]
        each p in monos
            if file_exists(p)
                u.mono = font_or(p)
                if u.mono >= 0
                    stop
    if u.mono < 0
        u.mono = u.font
    u.busy_ms = time_ms()
    dark(u)

// шрифт из файла или −1, если не вышло
func font_or(path: text)
    f = load_font(path) else err
        return -1
    return f
// тёмная тема (она по умолчанию)
modpub func dark(u: Ui)
    u.bg = rgb(22, 24, 31)
    u.panel = rgb(30, 33, 43)
    u.raised = rgb(40, 44, 57)
    u.fieldbg = rgb(18, 20, 26)
    u.line = rgb(44, 48, 61)
    u.ink = rgb(238, 240, 246)
    u.dim = rgb(139, 145, 163)
    u.faint = rgb(84, 89, 104)
    u.accent = rgb(58, 214, 193)
    u.on_accent = rgb(10, 40, 36)
    u.hover = rgb(46, 50, 64)
    u.sel = rgb(26, 74, 72)
    u.red = rgb(240, 96, 106)
    u.shadow = rgba(0, 0, 0, 110)
// светлая тема
modpub func light(u: Ui)
    u.bg = rgb(243, 244, 247)
    u.panel = rgb(255, 255, 255)
    u.raised = rgb(255, 255, 255)
    u.fieldbg = rgb(250, 251, 252)
    u.line = rgb(222, 225, 232)
    u.ink = rgb(24, 27, 36)
    u.dim = rgb(104, 110, 126)
    u.faint = rgb(178, 182, 194)
    u.accent = rgb(16, 158, 143)
    u.on_accent = rgb(255, 255, 255)
    u.hover = rgb(236, 238, 243)
    u.sel = rgb(208, 240, 235)
    u.red = rgb(214, 60, 72)
    u.shadow = rgba(30, 36, 60, 40)
// n обычных точек → настоящие (на Retina вдвое больше)
modpub func px(u: Ui, n: int)
    return round(n * u.k)

// в начале кадра: мышь, клавиши, раскладка
modpub func frame(u: Ui)
    u.tick += 1
    was = u.down
    u.mx = mouse_x()
    u.my = mouse_y()
    u.down = mouse_down()
    u.press = u.down and not was
    u.release = was and not u.down
    if u.press
        u.press_x = u.mx
        u.press_y = u.my
    u.wheel = mouse_wheel()
    b = mouse_back()
    fw = mouse_forward()
    u.back_press = b and not u.side_back and free(u)
    u.fwd_press = fw and not u.side_fwd and free(u)
    u.side_back = b
    u.side_fwd = fw
    u.typed = typed_text()
    if u.mx != u.old_mx or u.my != u.old_my or u.down or u.release or u.wheel != 0 or u.typed != "" or b or fw
        u.busy_ms = time_ms()
    u.old_mx = u.mx
    u.old_my = u.my
    calm(u)
    u.entered = false
    u.want_cursor = "arrow"
    u.tip = ""
    u.win_rects.clear()
    each r in u.win_now
        u.win_rects.add(r)
    u.win_now.clear()
    u.win_i = -1
    u.boxes.clear()
    u.boxes.add(Box(x: 0, y: 0, w: window_w(), h: window_h(), gap: px(u, 8)))

// в конце кадра: всплывающий список, подсказка, перетаскиваемое и окно-вопрос — поверх всего
modpub func end_frame(u: Ui)
    if u.pop != ""
        draw_pop(u)
    if u.tip != "" and not u.down
        draw_tip(u)
    if u.dragging
        w = text_w(u, u.drag_data) + px(u, 20)
        shadow_under(u, u.mx + px(u, 12), u.my + px(u, 8), w, px(u, 26), px(u, 13), 2)
        rbox(u, u.mx + px(u, 12), u.my + px(u, 8), w, px(u, 26), px(u, 13), u.accent)
        txt(u, u.mx + px(u, 22), u.my + px(u, 8) + (px(u, 26) - u.line_h) / 2, u.drag_data, u.on_accent)
    if u.ask_open
        draw_ask(u)
    if u.release
        u.active = ""
        if u.dragging
            u.dragging = false
            u.drop_tick = u.tick
    if u.want_cursor != u.cursor_now
        set_cursor(u.want_cursor)
        u.cursor_now = u.want_cursor

// спокойный режим: пока мышь, клавиши и анимации стоят дольше 1,5 секунды, окно рисуется
// u.calm_fps раз в секунду (10) — процессор и видеокарта почти не работают, ноутбук не греется.
// Сдвинули мышь — сразу снова 60. u.calm_fps = 0 выключает (игры и живые картинки),
// ui.stay_awake(u) — «сейчас что-то движется само, не засыпай»
func calm(u: Ui)
    if u.calm_fps <= 0
        return
    want = 60
    if time_ms() - u.busy_ms > 1500
        want = u.calm_fps
    if want != u.fps_now
        set_fps(want)
        u.fps_now = want

modpub func stay_awake(u: Ui)
    u.busy_ms = time_ms()

// плавное наведение: у места id число 0..100 растёт к 100, пока on, и падает к 0 — примерно за 0,12 с
modpub func ease_to(u: Ui, id: text, on: bool) gives p: int
    p = 0
    if u.anim.has(id)
        p = u.anim[id]
    step = max(8, min(100, round(frame_ms() * 100.0 / 120.0)))
    if on and p < 100
        p = min(100, p + step)
        u.busy_ms = time_ms()
    else if not on and p > 0
        p = max(0, p - step)
        u.busy_ms = time_ms()
    u.anim[id] = p

func spot(x: int, y: int)
    return "" + x + "," + y

// взять свой шрифт .ttf (false — не получилось, остаётся прежний)
modpub func use_font(u: Ui, path: text)
    got = load_font(path) else err
        return false
    u.font = got
    return true

// ---------- мелочи ----------

// мышь внутри прямоугольника
modpub func inside(u: Ui, x: int, y: int, w: int, h: int)
    return u.mx >= x and u.mx < x + w and u.my >= y and u.my < y + h

// можно ли сейчас нажимать здесь: не открыт вопрос или список, и мышь не над окном, которое выше
modpub func free(u: Ui)
    if u.ask_open and not u.in_ask
        return false
    if u.pop != "" and not u.in_pop
        return false
    if u.in_ask or u.in_pop
        return true
    n = len(u.win_rects) / 4
    count i from u.win_i + 1 to n - 1
        if inside(u, u.win_rects[i * 4], u.win_rects[i * 4 + 1], u.win_rects[i * 4 + 2], u.win_rects[i * 4 + 3])
            return false
    return true

// нажали мышью на прямоугольник в этом кадре
modpub func clicked(u: Ui, x: int, y: int, w: int, h: int)
    return free(u) and u.press and inside(u, x, y, w, h)

// курсор над этим местом: "hand", "text", "move", "resize_x" ...
modpub func cursor(u: Ui, name: text)
    u.want_cursor = name

// клавиша в этом кадре: смотрим один раз за кадр, сколько бы раз ни спросили
func look(u: Ui, name: text)
    if u.seen.has(name) and u.seen[name] == u.tick
        return
    before = false
    if u.keys.has(name)
        before = u.keys[name]
    u.was[name] = before
    now = key_down(name)
    u.keys[name] = now
    if now
        u.busy_ms = time_ms()
    n = 0
    if u.held.has(name)
        n = u.held[name]
    if now
        u.held[name] = n + 1
    else
        u.held[name] = 0
    // пропустили кадр — значит, в прошлом кадре клавишу никто не видел
    if u.seen.has(name) and u.seen[name] != u.tick - 1
        u.was[name] = false
    u.seen[name] = u.tick

// клавишу только что нажали (а не держат)
modpub func key_pressed(u: Ui, name: text)
    look(u, name)
    return free(u) and u.keys[name] and not u.was[name]

// сочетание клавиш: ui.shortcut(u, "cmd+shift+n"). cmd — Command на Mac, Ctrl на Linux и Windows.
// Срабатывает, когда нажали последнюю клавишу, а cmd, shift и alt держат ровно те, что написаны
modpub func shortcut(u: Ui, combo: text)
    parts = split(lower(combo), "+")
    key = parts[len(parts) - 1]
    want_cmd = false
    want_shift = false
    want_alt = false
    want_ctrl = false
    count i from 0 to len(parts) - 2
        m = parts[i]
        if m == "cmd"
            want_cmd = true
        else if m == "shift"
            want_shift = true
        else if m == "alt"
            want_alt = true
        else if m == "ctrl"
            want_ctrl = true
    if key_down("cmd") != want_cmd or key_down("shift") != want_shift or key_down("alt") != want_alt
        return false
    if want_ctrl and not key_down("ctrl")
        return false
    return key_pressed(u, key)

// без cmd и alt: стрелки, Enter и Backspace сами по себе (а не cmd+стрелка)
modpub func plain(u: Ui)
    return not key_down("cmd") and not key_down("alt") and not key_down("ctrl")

// как key_pressed, но если держать — повторяется (стрелки по списку)
modpub func key_repeat(u: Ui, name: text)
    look(u, name)
    n = u.held[name]
    return free(u) and (n == 1 or (n > 19 and n % 3 == 0))

// сколько букв (len уже считает буквы; имя оставлено для старого кода)
modpub func chars(s: text)
    return len(s)

// первые n букв
modpub func first_chars(s: text, n: int)
    if n <= 0
        return ""
    if n >= len(s)
        return s
    return cut(s, 0, n - 1)

// последние n букв
modpub func last_chars(s: text, n: int)
    if n <= 0
        return ""
    if n >= len(s)
        return s
    return cut(s, len(s) - n, len(s) - 1)

// буквы с a-й до b-й (b не входит)
modpub func mid_chars(s: text, a: int, b: int)
    return last_chars(first_chars(s, b), b - a)

// ширина текста в точках: у шрифта TTF своя у каждой буквы, у встроенного — 8
modpub func text_w(u: Ui, s: text)
    if u.font >= 0
        return text_width(u.font, s, u.fs)
    return chars(s) * 8 * max(1, round(u.k))

// текст: верх строки в y, строка высотой u.line_h
modpub func txt(u: Ui, x: int, y: int, s: text, color: int)
    if u.font >= 0
        draw_font(u.font, x, y + (u.line_h - u.fs * 5 / 4) / 2, s, u.fs, color)
    else
        draw_text(x, y, s, max(1, round(u.k)), color)

// крупный текст (заголовок): size — размер букв в обычных точках
modpub func big_text(u: Ui, x: int, y: int, s: text, size: int, color: int)
    if u.bold >= 0
        draw_font(u.bold, x, y, s, px(u, size), color)
    else
        draw_text(x, y, s, max(1, px(u, size) / 12), color)

// ---------- стили текста ----------
// У каждой надписи свой стиль, как классы в CSS:
//   "title"    — крупный заголовок окна (полужирный 26)
//   "heading"  — заголовок раздела (полужирный 20)
//   "sub"      — подзаголовок (полужирный 15)
//   "body"     — обычный текст (14)
//   "strong"   — обычный, но полужирный (14)
//   "note"     — бледная пометка (13)
//   "caption"  — маленькая подпись над полем: ЗАГЛАВНЫЕ, бледные, с разрядкой (11)
//   "code"     — код, моноширинный (13)
//   "accent"   — цветной текст (14)
//   "danger"   — красный текст (14)
// ui.styled(u, x, y, s, "heading") рисует по координатам, а ui.h1, ui.heading, ui.h3, ui.lbl, ui.note,
// ui.caps, ui.code_line встают в раскладку.

func st_font(u: Ui, st: text)
    if st == "title" or st == "heading" or st == "sub" or st == "strong" or st == "caption" or st == "button"
        return u.bold
    if st == "code"
        return u.mono
    return u.font

func st_size(u: Ui, st: text)
    if st == "title"
        return px(u, 26)
    if st == "heading"
        return px(u, 20)
    if st == "sub"
        return px(u, 15)
    if st == "note" or st == "code"
        return px(u, 13)
    if st == "caption"
        return px(u, 11)
    return u.fs

func st_color(u: Ui, st: text)
    if st == "note" or st == "caption"
        return u.dim
    if st == "accent"
        return u.accent
    if st == "danger"
        return u.red
    return u.ink

// высота строки текста этого стиля
modpub func style_h(u: Ui, st: text)
    return st_size(u, st) * 5 / 4 + px(u, 2)

// ширина текста в этом стиле
modpub func style_w(u: Ui, s: text, st: text)
    f = st_font(u, st)
    size = st_size(u, st)
    if st == "caption"
        t = upper(s)
        if f < 0
            return chars(t) * 8 * max(1, round(u.k))
        return text_width(f, t, size) + chars(t) * px(u, 1)
    if f < 0
        return chars(s) * 8 * max(1, round(u.k))
    return text_width(f, s, size)

// надпись стилем st: верх строки в y
modpub func styled(u: Ui, x: int, y: int, s: text, st: text)
    styled_color(u, x, y, s, st, st_color(u, st))

modpub func styled_color(u: Ui, x: int, y: int, s: text, st: text, color: int)
    f = st_font(u, st)
    size = st_size(u, st)
    if f < 0
        draw_text(x, y, s, max(1, round(u.k)), color)
        return
    if st == "caption"
        t = upper(s)
        cx = x
        n = chars(t)
        count i from 0 to n - 1
            ch = mid_chars(t, i, i + 1)
            draw_font(f, cx, y, ch, size, color)
            cx += text_width(f, ch, size) + px(u, 1)
        return
    draw_font(f, x, y, s, size, color)

// надпись стилем st по середине высоты h
modpub func styled_in(u: Ui, x: int, y: int, h: int, s: text, st: text, color: int)
    styled_color(u, x, y + (h - st_size(u, st) * 5 / 4) / 2, s, st, color)

// цвет c с непрозрачностью a (0..255)
modpub func alpha_of(c: int, a: int)
    return rgba(bit_and(shift_right(c, 16), 255), bit_and(shift_right(c, 8), 255), bit_and(c, 255), max(0, min(255, a)))
// текст в ширину w точек: длинный обрезается и кончается на ..
modpub func fit(u: Ui, s: text, w: int)
    if text_w(u, s) <= w
        return s
    n = chars(s) * w / max(1, text_w(u, s))
    repeat while n > 0 and text_w(u, first_chars(s, n) + "..") > w
        n -= 1
    return first_chars(s, n) + ".."

modpub func label(u: Ui, x: int, y: int, s: text, color: int)
    txt(u, x, y, s, color)

// текст по середине прямоугольника
modpub func label_center(u: Ui, x: int, y: int, w: int, h: int, s: text, color: int)
    t = fit(u, s, w - px(u, 8))
    txt(u, x + (w - text_w(u, t)) / 2, y + (h - u.line_h) / 2, t, color)

// рамка из четырёх линий
modpub func frame_rect(x: int, y: int, w: int, h: int, color: int)
    draw_rect(x, y, w, 1, color)
    draw_rect(x, y + h - 1, w, 1, color)
    draw_rect(x, y, 1, h, color)
    draw_rect(x + w - 1, y, 1, h, color)

// прямоугольник со скруглёнными углами (r — радиус)
modpub func rbox(u: Ui, x: int, y: int, w: int, h: int, r0: int, color: int)
    draw_round(x, y, w, h, max(0, r0), "all", color)
// скруглённая плашка с рамкой
modpub func rframe(u: Ui, x: int, y: int, w: int, h: int, fill: int, border: int)
    rframe_r(u, x, y, w, h, u.radius, fill, border)

// то же со своим скруглением r
modpub func rframe_r(u: Ui, x: int, y: int, w: int, h: int, r: int, fill: int, border: int)
    t = max(1, round(u.k))
    rbox(u, x, y, w, h, r, border)
    rbox(u, x + t, y + t, w - 2 * t, h - 2 * t, r - t, fill)
// панель: заливка и рамка
modpub func panel(u: Ui, x: int, y: int, w: int, h: int)
    rframe_r(u, x, y, w, h, u.cr, u.panel, u.line)

// мягкая тень под прямоугольником: depth — насколько «приподнят» (1 — карточка, 3 — окно, список)
modpub func shadow_under(u: Ui, x: int, y: int, w: int, h: int, r: int, depth: int)
    draw_shadow(x, y + px(u, 2 * depth), w, h, r, px(u, 6 + 8 * depth), u.shadow)
// ---------- кнопки ----------

// кнопка: true в кадре, когда на неё нажали
modpub func button(u: Ui, x: int, y: int, w: int, h: int, s: text) gives hit: bool
    hit = draw_btn(u, x, y, w, h, s, "second")

// общий рисунок кнопок. kind: "main" — главная цветная со свечением, "second" — обычная приподнятая,
// "ghost" — без фона (фон только при наведении), "soft" — мягкая цветная, "danger" — опасное действие
func draw_btn(u: Ui, x: int, y: int, w: int, h: int, s: text, kind: text) gives hit: bool
    over = free(u) and inside(u, x, y, w, h)
    if over
        u.want_cursor = "hand"
    t = ease_to(u, kind + spot(x, y), over)
    hit = over and u.press
    dy = 0
    if over and u.down
        dy = max(1, round(u.k))
    r = u.radius
    st = "button"
    color = u.ink
    if kind == "main"
        draw_shadow(x, y + px(u, 3) + dy, w, h, r, px(u, 8 + 6 * t / 100), alpha_of(u.accent, 50 + 60 * t / 100))
        c = mix(u.accent, rgb(255, 255, 255), 14 * t / 100)
        if dy > 0
            c = mix(u.accent, rgb(0, 0, 0), 10)
        rbox(u, x, y + dy, w, h, r, c)
        color = u.on_accent
    else if kind == "second"
        rframe(u, x, y + dy, w, h, mix(u.raised, u.ink, 7 * t / 100), mix(u.line, u.dim, 35 * t / 100))
    else if kind == "ghost"
        if t > 0
            rbox(u, x, y + dy, w, h, r, alpha_of(u.ink, 22 * t / 100))
        color = mix(u.dim, u.ink, t)
        st = "body"
    else if kind == "soft"
        rbox(u, x, y + dy, w, h, r, alpha_of(u.accent, 36 + 30 * t / 100))
        color = u.accent
    else if kind == "danger"
        rbox(u, x, y + dy, w, h, r, alpha_of(u.red, 40 + 215 * t / 100))
        color = mix(u.red, rgb(255, 255, 255), t)
    tx = fit_style(u, s, w - px(u, 12), st)
    lx = x + (w - style_w(u, tx, st)) / 2
    // широкая кнопка без фона или мягкая (меню сбоку) — текст слева, как пункты меню
    if (kind == "ghost" or kind == "soft") and w > style_w(u, tx, st) + px(u, 90)
        lx = x + px(u, 14)
    styled_in(u, lx, y + dy, h, tx, st, color)

// текст в ширину w стилем st: длинный кончается на ..
func fit_style(u: Ui, s: text, w: int, st: text)
    if style_w(u, s, st) <= w
        return s
    n = chars(s)
    repeat while n > 0 and style_w(u, first_chars(s, n) + "..", st) > w
        n -= 1
    return first_chars(s, n) + ".."

modpub func button_ghost(u: Ui, x: int, y: int, w: int, h: int, s: text) gives hit: bool
    hit = draw_btn(u, x, y, w, h, s, "ghost")

modpub func button_soft(u: Ui, x: int, y: int, w: int, h: int, s: text) gives hit: bool
    hit = draw_btn(u, x, y, w, h, s, "soft")

modpub func button_danger(u: Ui, x: int, y: int, w: int, h: int, s: text) gives hit: bool
    hit = draw_btn(u, x, y, w, h, s, "danger")

// круглая кнопка-значок (×, +, ⋯, ←): s — один-два знака
modpub func button_icon(u: Ui, x: int, y: int, size: int, s: text) gives hit: bool
    over = free(u) and inside(u, x, y, size, size)
    if over
        u.want_cursor = "hand"
    t = ease_to(u, "icon" + spot(x, y), over)
    hit = over and u.press
    if t > 0
        rbox(u, x, y, size, size, size / 2, alpha_of(u.ink, 24 * t / 100))
    styled_in(u, x + (size - style_w(u, s, "sub")) / 2, y, size, s, "sub", mix(u.dim, u.ink, t))
// кнопка, которую не нажать (серая)
modpub func button_off(u: Ui, x: int, y: int, w: int, h: int, s: text)
    rbox(u, x, y, w, h, u.radius, mix(u.panel, u.raised, 50))
    tx = fit_style(u, s, w - px(u, 12), "button")
    styled_in(u, x + (w - style_w(u, tx, "button")) / 2, y, h, tx, "button", u.faint)
// главная кнопка: цветная
modpub func button_main(u: Ui, x: int, y: int, w: int, h: int, s: text) gives hit: bool
    hit = draw_btn(u, x, y, w, h, s, "main")
// смесь двух цветов: p процентов второго
// (прозрачность тоже смешивается: полупрозрачные цвета остаются полупрозрачными)
modpub func mix(a: int, b: int, p: int)
    r = (bit_and(shift_right(a, 16), 255) * (100 - p) + bit_and(shift_right(b, 16), 255) * p) / 100
    g = (bit_and(shift_right(a, 8), 255) * (100 - p) + bit_and(shift_right(b, 8), 255) * p) / 100
    bl = (bit_and(a, 255) * (100 - p) + bit_and(b, 255) * p) / 100
    ta = (bit_and(shift_right(a, 24), 255) * (100 - p) + bit_and(shift_right(b, 24), 255) * p) / 100
    if ta == 0
        return rgb(r, g, bl)
    return rgba(r, g, bl, 255 - ta)

// переключатель: [x] текст; отдаёт новое значение
modpub func check(u: Ui, x: int, y: int, s: text, on: bool) gives now: bool
    now = on
    b = px(u, 18)
    w = px(u, 28) + text_w(u, s)
    over = free(u) and inside(u, x, y, w, px(u, 20))
    t = ease_to(u, "chk" + spot(x, y), on)
    if t > 0
        rbox(u, x, y + 1, b, b, px(u, 5), mix(u.fieldbg, u.accent, t))
        if t > 50
            tick_mark(u, x + b / 2, y + 1 + b / 2, b, u.on_accent)
    else
        border = u.dim
        if over
            border = u.accent
        rframe_r(u, x, y + 1, b, b, px(u, 5), u.fieldbg, border)
    if over
        u.want_cursor = "hand"
    txt(u, x + px(u, 28), y + 2, s, u.ink)
    if over and u.press
        now = not on

// переключатель-«пилюля»: дорожка с белым кружком, текст справа; отдаёт новое значение
modpub func switch_at(u: Ui, x: int, y: int, s: text, on: bool) gives now: bool
    now = on
    tw = px(u, 38)
    th = px(u, 22)
    w = tw + px(u, 12) + text_w(u, s)
    over = free(u) and inside(u, x, y, w, th)
    if over
        u.want_cursor = "hand"
    t = ease_to(u, "sw" + spot(x, y), on)
    if t == 0
        rframe_r(u, x, y, tw, th, th / 2, u.raised, mix(u.line, u.dim, 40))
    else
        rbox(u, x, y, tw, th, th / 2, mix(u.raised, u.accent, t))
    g = px(u, 3)
    kd = th - 2 * g
    kx = x + g + (tw - 2 * g - kd) * t / 100
    draw_shadow(kx, y + g + px(u, 1), kd, kd, kd / 2, px(u, 3), rgba(0, 0, 0, 90))
    rbox(u, kx, y + g, kd, kd, kd / 2, rgb(255, 255, 255))
    txt(u, x + tw + px(u, 12), y + (th - u.line_h) / 2, s, u.ink)
    if over and u.press
        now = not on
// галочка ✓ толщиной в 2 точки (на Retina толще)
func tick_mark(u: Ui, cx: int, cy: int, b: int, color: int)
    t = max(2, px(u, 2))
    count k from 0 to t - 1
        draw_line(cx - b * 5 / 16, cy + k - t / 2, cx - b / 16, cy + b / 4 + k - t / 2, color)
        draw_line(cx - b / 16, cy + b / 4 + k - t / 2, cx + b * 5 / 16, cy - b / 4 + k - t / 2, color)

// ---------- списки ----------

// строка списка: 0 — ничего, 1 — щёлкнули, 2 — двойной щелчок. id — своё имя строки
modpub func row(u: Ui, id: text, x: int, y: int, w: int, h: int, s: text, selected: bool) gives res: int
    res = 0
    over = free(u) and inside(u, x, y, w, h)
    if selected
        rbox(u, x, y, w, h, px(u, 8), u.sel)
    else if over
        rbox(u, x, y, w, h, px(u, 8), u.hover)
    if s != ""
        txt(u, x + px(u, 8), y + (h - u.line_h) / 2, fit(u, s, w - px(u, 16)), u.ink)
    if over and u.press
        now = time_ms()
        res = 1
        if u.last_id == id and now - u.last_click < 400
            res = 2
            u.last_click = 0
        else
            u.last_click = now
        u.last_id = id

// полоса прокрутки: total — сколько всего строк, shown — сколько видно, pos — первая видимая.
// Отдаёт новую первую строку: полосу можно тянуть мышью или щёлкнуть выше/ниже ползунка
modpub func scrollbar(u: Ui, id: text, x: int, y: int, w: int, h: int, total: int, shown: int, pos: int) gives p: int
    p = pos
    if total <= shown
        return
    thumb = max(px(u, 24), h * shown / total)
    room = h - thumb
    most = total - shown
    ty = y + room * p / most
    over = free(u) and inside(u, x, ty, w, thumb)
    c = u.line
    if over or u.active == id
        c = u.dim
    rbox(u, x + px(u, 2), ty, w - px(u, 4), thumb, (w - px(u, 4)) / 2, c)
    if free(u) and u.press and inside(u, x, y, w, h)
        if over
            u.active = id
            u.grab = u.my - ty
        else if u.my < ty
            p = max(0, p - shown)
        else
            p = min(most, p + shown)
    if u.active == id and room > 0
        p = (u.my - u.grab - y) * most / room
        p = max(0, min(most, p))

// прокрутка колёсиком над прямоугольником: отдаёт новую первую строку (3 строки на шаг)
modpub func wheel_scroll(u: Ui, x: int, y: int, w: int, h: int, total: int, shown: int, pos: int) gives p: int
    p = pos
    if u.wheel != 0 and free(u) and inside(u, x, y, w, h)
        p = max(0, min(total - shown, pos - u.wheel * 3))
        p = max(0, p)

// ---------- поле ввода ----------

// печатают ли сейчас в каком-нибудь поле (тогда стрелки и Backspace — для поля)
modpub func typing(u: Ui)
    return u.focus != ""

// отдать полю фокус, как будто по нему щёлкнули
modpub func focus_on(u: Ui, id: text)
    u.focus = id
    u.focus_tick = time_ms()
    u.caret = 1000000000
    u.anchor = u.caret

// правка текста с фокусом: буквы, Backspace, Delete, стрелки, Home/End, выделение с Shift,
// cmd+A/C/X/V через буфер обмена. many — можно ли Enter (новая строка)
func edit_keys(u: Ui, value: text, many: bool) gives now: text
    now = value
    n = chars(now)
    u.caret = max(0, min(u.caret, n))
    u.anchor = max(0, min(u.anchor, n))
    shift = key_down("shift")
    a = min(u.caret, u.anchor)
    b = max(u.caret, u.anchor)
    if shortcut(u, "cmd+a")
        u.anchor = 0
        u.caret = n
        return
    if (shortcut(u, "cmd+c") or shortcut(u, "cmd+x")) and a < b
        clipboard_set(mid_chars(now, a, b))
        if key_down("x")
            now = first_chars(now, a) + last_chars(now, n - b)
            u.caret = a
            u.anchor = a
        return
    put = u.typed
    if shortcut(u, "cmd+v")
        put = clipboard_get()
        if not many
            put = replace(put, "\n", " ")
    if many and key_repeat(u, "enter") and plain(u)
        put += "\n"
    if put != ""
        now = first_chars(now, a) + put + last_chars(now, n - b)
        u.caret = a + chars(put)
        u.anchor = u.caret
        u.focus_tick = time_ms()
        return
    if key_repeat(u, "backspace")
        if a < b
            now = first_chars(now, a) + last_chars(now, n - b)
            u.caret = a
        else if u.caret > 0
            now = first_chars(now, u.caret - 1) + last_chars(now, n - u.caret)
            u.caret -= 1
        u.anchor = u.caret
        u.focus_tick = time_ms()
        return
    if key_repeat(u, "delete")
        if a < b
            now = first_chars(now, a) + last_chars(now, n - b)
            u.caret = a
        else if u.caret < n
            now = first_chars(now, u.caret) + last_chars(now, n - u.caret - 1)
        u.anchor = u.caret
        return
    moved = false
    if key_repeat(u, "left")
        u.caret = max(0, u.caret - 1)
        moved = true
    if key_repeat(u, "right")
        u.caret = min(n, u.caret + 1)
        moved = true
    if key_pressed(u, "home")
        u.caret = line_start(now, u.caret)
        moved = true
    if key_pressed(u, "end")
        u.caret = line_end(now, u.caret)
        moved = true
    if many and (key_repeat(u, "up") or key_repeat(u, "down"))
        col = u.caret - line_start(now, u.caret)
        if key_down("up")
            s0 = line_start(now, u.caret)
            if s0 > 0
                p0 = line_start(now, s0 - 1)
                u.caret = min(p0 + col, s0 - 1)
        else
            e0 = line_end(now, u.caret)
            if e0 < n
                u.caret = min(e0 + 1 + col, line_end(now, e0 + 1))
        moved = true
    if moved
        if not shift
            u.anchor = u.caret
        u.focus_tick = time_ms()

// где начинается и кончается строка, в которой буква номер i
func line_start(s: text, i: int)
    head = first_chars(s, i)
    k = find(head, "\n")
    if k < 0
        return 0
    last = 0
    parts = split(head, "\n")
    count j from 0 to len(parts) - 2
        last += chars(parts[j]) + 1
    return last

func line_end(s: text, i: int)
    rest = last_chars(s, chars(s) - i)
    k = find(rest, "\n")
    if k < 0
        return chars(s)
    return i + chars(cut(rest, 0, k - 1)) * min(1, k)

// поле ввода: отдаёт новый текст. Щелчок — печатать сюда, Enter — u.entered, Esc или щелчок мимо — хватит.
// hint — бледная подсказка, пока поле пустое
modpub func field(u: Ui, id: text, x: int, y: int, w: int, h: int, value: text, hint: text) gives now: text
    now = value
    over = free(u) and inside(u, x, y, w, h)
    if over
        u.want_cursor = "text"
    if u.press and free(u)
        if over
            if u.focus != id
                focus_on(u, id)
            u.caret = caret_at(u, value, u.mx - x - px(u, 8))
            u.anchor = u.caret
        else if u.focus == id
            u.focus = ""
    mine = u.focus == id and free(u)
    if mine
        now = edit_keys(u, now, false)
        if key_pressed(u, "enter")
            u.entered = true
        if key_pressed(u, "escape")
            u.focus = ""
    field_frame(u, x, y, w, h, mine, over)
    room = w - px(u, 20)
    ty = y + (h - u.line_h) / 2
    if now == "" and not mine
        txt(u, x + px(u, 8), ty, fit(u, hint, w - px(u, 16)), u.dim)
    // не влезает — сдвигаем так, чтобы чёрточку было видно
    from_c = 0
    if mine
        repeat while from_c < u.caret and text_w(u, mid_chars(now, from_c, u.caret)) > room
            from_c += 1
    shown = last_chars(now, chars(now) - from_c)
    if not mine
        shown = fit(u, now, room)
    if mine and u.caret != u.anchor
        a = max(min(u.caret, u.anchor), from_c)
        b = max(u.caret, u.anchor)
        sx = x + px(u, 8) + text_w(u, mid_chars(now, from_c, a))
        sw = min(text_w(u, mid_chars(now, a, b)), x + w - px(u, 8) - sx)
        draw_rect(sx, ty, max(0, sw), u.line_h, u.sel)
    txt(u, x + px(u, 8), ty, fit(u, shown, room + px(u, 10)), u.ink)
    // чёрточка мигает: полсекунды есть, полсекунды нет
    if mine and (time_ms() - u.focus_tick) % 1000 < 550
        cx = x + px(u, 8) + text_w(u, mid_chars(now, from_c, u.caret))
        draw_rect(cx, ty, max(1, px(u, 2)), u.line_h, u.accent)

// рамка поля: тёмный фон; при наведении рамка светлее, с фокусом — цветная и мягкое свечение вокруг
func field_frame(u: Ui, x: int, y: int, w: int, h: int, mine: bool, over: bool)
    border = u.line
    if mine
        draw_shadow(x, y, w, h, u.radius, px(u, 5), alpha_of(u.accent, 70))
        border = u.accent
    else if over
        border = mix(u.line, u.dim, 50)
    rframe(u, x, y, w, h, u.fieldbg, border)

// какая буква под мышью: dx — сколько точек от начала текста
func caret_at(u: Ui, s: text, dx: int)
    n = chars(s)
    count i from 1 to n
        if text_w(u, first_chars(s, i)) - text_w(u, last_chars(first_chars(s, i), 1)) / 2 > dx
            return i - 1
    return n

// многострочное поле: Enter — новая строка, колёсико листает. Отдаёт новый текст
modpub func text_box(u: Ui, id: text, x: int, y: int, w: int, h: int, value: text) gives now: text
    now = value
    over = free(u) and inside(u, x, y, w, h)
    if over
        u.want_cursor = "text"
    lines = split(now, "\n")
    top = 0
    if u.scroll.has(id)
        top = u.scroll[id]
    lh = u.line_h + px(u, 4)
    shown = max(1, (h - px(u, 12)) / lh)
    if u.press and free(u)
        if over
            if u.focus != id
                focus_on(u, id)
            ln = min(len(lines) - 1, top + max(0, (u.my - y - px(u, 6)) / lh))
            st = 0
            count j from 0 to ln - 1
                st += chars(lines[j]) + 1
            u.caret = st + caret_at(u, lines[ln], u.mx - x - px(u, 8))
            u.anchor = u.caret
        else if u.focus == id
            u.focus = ""
    mine = u.focus == id and free(u)
    if mine
        now = edit_keys(u, now, true)
        if key_pressed(u, "escape")
            u.focus = ""
        lines = split(now, "\n")
    top = wheel_scroll(u, x, y, w, h, len(lines), shown, top)
    // строка с чёрточкой
    cl = 0
    cc = u.caret
    if mine
        rest = u.caret
        count j from 0 to len(lines) - 1
            if rest <= chars(lines[j])
                cl = j
                cc = rest
                stop
            rest -= chars(lines[j]) + 1
        if u.held.has("up") or u.held.has("down") or u.typed != ""
            if cl < top
                top = cl
            if cl >= top + shown
                top = cl - shown + 1
    u.scroll[id] = top
    field_frame(u, x, y, w, h, mine, over)
    a = min(u.caret, u.anchor)
    b = max(u.caret, u.anchor)
    st = 0
    count j from 0 to len(lines) - 1
        ly = y + px(u, 6) + (j - top) * lh
        if j >= top and j < top + shown
            if mine and a < b
                la = max(a - st, 0)
                lb = min(b - st, chars(lines[j]))
                if la < lb or (la == lb and b > st + chars(lines[j]) and a <= st + chars(lines[j]))
                    sx = x + px(u, 8) + text_w(u, first_chars(lines[j], la))
                    sw = text_w(u, mid_chars(lines[j], la, lb)) + px(u, 4)
                    draw_rect(sx, ly, sw, u.line_h, u.sel)
            txt(u, x + px(u, 8), ly, fit(u, lines[j], w - px(u, 24)), u.ink)
            if mine and j == cl and (time_ms() - u.focus_tick) % 1000 < 550
                draw_rect(x + px(u, 8) + text_w(u, first_chars(lines[j], cc)), ly, max(1, px(u, 2)), u.line_h, u.accent)
        st += chars(lines[j]) + 1
    top2 = scrollbar(u, id + "#bar", x + w - px(u, 10), y + px(u, 2), px(u, 8), h - px(u, 4), len(lines), shown, top)
    u.scroll[id] = top2

// ---------- ползунок, выбор, вкладки, меню ----------

// ползунок: число от lo до hi
modpub func slider(u: Ui, id: text, x: int, y: int, w: int, h: int, value: int, lo: int, hi: int) gives v: int
    v = max(lo, min(hi, value))
    span = max(1, hi - lo)
    over = free(u) and inside(u, x, y, w, h)
    if over
        u.want_cursor = "hand"
    if over and u.press
        u.active = id
    if u.active == id
        v = lo + ((u.mx - x) * span + w / 2) / max(1, w)
        v = max(lo, min(hi, v))
    if over and u.wheel != 0
        v = max(lo, min(hi, v + u.wheel))
    t = px(u, 4)
    cy = y + h / 2
    rbox(u, x, cy - t / 2, w, t, t / 2, u.raised)
    kx = x + (v - lo) * w / span
    rbox(u, x, cy - t / 2, kx - x, t, t / 2, u.accent)
    r = px(u, 9)
    e = ease_to(u, "sl" + id, over or u.active == id)
    if e > 0
        rbox(u, kx - r - px(u, 5), cy - r - px(u, 5), 2 * r + px(u, 10), 2 * r + px(u, 10), r + px(u, 5), alpha_of(u.accent, 60 * e / 100))
    draw_shadow(kx - r, cy - r + px(u, 1), 2 * r, 2 * r, r, px(u, 4), rgba(0, 0, 0, 100))
    rbox(u, kx - r, cy - r, 2 * r, 2 * r, r, rgb(255, 255, 255))

// выбор одного из списка: кнопка со стрелкой, по щелчку — список поверх всего. Отдаёт номер
modpub func choose(u: Ui, id: text, x: int, y: int, w: int, h: int, items: list text, current: int) gives sel: int
    sel = current
    if u.pop == id and u.pop_pick >= 0
        sel = u.pop_pick
        u.pop_pick = -1
        u.pop = ""
    shown = ""
    if sel >= 0 and sel < len(items)
        shown = items[sel]
    over = free(u) and inside(u, x, y, w, h)
    if over
        u.want_cursor = "hand"
    t = ease_to(u, "pick" + spot(x, y), over or u.pop == id)
    border = mix(u.line, u.dim, 35 * t / 100)
    if u.pop == id
        border = u.accent
    rframe(u, x, y, w, h, mix(u.fieldbg, u.raised, t), border)
    txt(u, x + px(u, 12), y + (h - u.line_h) / 2, fit(u, shown, w - px(u, 36)), u.ink)
    chevron(u, x + w - px(u, 18), y + h / 2, u.dim)
    if over and u.press
        open_pop(u, id, items, x, y + h + px(u, 4), w)

// ▾ из двух линий
func chevron(u: Ui, cx: int, cy: int, color: int)
    s = px(u, 4)
    draw_line(cx - s, cy - s / 2, cx, cy + s / 2, color)
    draw_line(cx, cy + s / 2, cx + s, cy - s / 2, color)

func open_pop(u: Ui, id: text, items: list text, x: int, y: int, w: int)
    u.pop = id
    u.pop_items = items
    u.pop_x = x
    u.pop_y = y
    u.pop_w = w
    u.pop_pick = -1
    u.pop_tick = u.tick

// меню: кнопка с названием, по щелчку — список. Отдаёт номер выбранного пункта один раз, иначе −1
modpub func menu_at(u: Ui, id: text, x: int, y: int, w: int, h: int, title: text, items: list text) gives sel: int
    sel = -1
    if u.pop == id and u.pop_pick >= 0
        sel = u.pop_pick
        u.pop_pick = -1
        u.pop = ""
    over = free(u) and inside(u, x, y, w, h)
    t = ease_to(u, "menu" + spot(x, y), over or u.pop == id)
    if t > 0
        rbox(u, x, y, w, h, u.radius, alpha_of(u.ink, 22 * t / 100))
    if over
        u.want_cursor = "hand"
    label_center(u, x, y, w, h, title, mix(u.dim, u.ink, max(t, 60)))
    if over and u.press
        wmax = w
        each it in items
            wmax = max(wmax, text_w(u, it) + px(u, 40))
        open_pop(u, id, items, x, y + h + px(u, 2), wmax)

func draw_pop(u: Ui)
    ih = px(u, 28)
    h = len(u.pop_items) * ih + px(u, 8)
    x = u.pop_x
    y = min(u.pop_y, window_h() - h - px(u, 4))
    w = u.pop_w
    u.in_pop = true
    shadow_under(u, x, y, w, h, u.cr, 3)
    rframe_r(u, x, y, w, h, u.cr, u.raised, u.line)
    count i from 0 to len(u.pop_items) - 1
        iy = y + px(u, 4) + i * ih
        s = u.pop_items[i]
        if s == "-"
            draw_rect(x + px(u, 8), iy + ih / 2, w - px(u, 16), 1, u.line)
            skip
        over = inside(u, x + px(u, 4), iy, w - px(u, 8), ih)
        if over
            rbox(u, x + px(u, 4), iy, w - px(u, 8), ih, u.radius - px(u, 2), alpha_of(u.accent, 40))
            u.want_cursor = "hand"
        txt(u, x + px(u, 14), iy + (ih - u.line_h) / 2, fit(u, s, w - px(u, 28)), u.ink)
        if over and u.release and u.tick != u.pop_tick
            u.pop_pick = i
    if u.pop_pick < 0 and u.press and u.tick != u.pop_tick and not inside(u, x, y, w, h)
        u.pop = ""
    if key_pressed(u, "escape")
        u.pop = ""
    u.in_pop = false

// вкладки в ряд: отдаёт номер открытой
modpub func tabs_at(u: Ui, x: int, y: int, w: int, h: int, names: list text, current: int) gives sel: int
    sel = current
    g = px(u, 3)
    total = 2 * g
    each nm in names
        total += style_w(u, nm, "strong") + px(u, 28)
    total = min(total, w)
    rbox(u, x, y, total, h, u.radius, u.fieldbg)
    tx = x + g
    count i from 0 to len(names) - 1
        tw = style_w(u, names[i], "strong") + px(u, 28)
        over = free(u) and inside(u, tx, y, tw, h)
        t = ease_to(u, "tab" + spot(tx, y), over)
        color = mix(u.dim, u.ink, t)
        if i == current
            draw_shadow(tx, y + g + px(u, 1), tw, h - 2 * g, u.radius - g, px(u, 4), rgba(0, 0, 0, 80))
            rbox(u, tx, y + g, tw, h - 2 * g, u.radius - g, u.raised)
            color = u.ink
        if over
            u.want_cursor = "hand"
        styled_in(u, tx + px(u, 14), y, h, names[i], "strong", color)
        if over and u.press
            sel = i
        tx += tw
// подсказка: показать текст, если мышь задержалась над последним местом раскладки
modpub func tip(u: Ui, s: text)
    tip_at(u, u.lx, u.ly, u.lw, u.lh, s)

modpub func tip_at(u: Ui, x: int, y: int, w: int, h: int, s: text)
    id = s + "@" + to_text(x) + "," + to_text(y)
    if not inside(u, x, y, w, h) or not free(u)
        if u.hover_id == id
            u.hover_id = ""
        return
    if u.hover_id != id
        u.hover_id = id
        u.hover_since = time_ms()
    if time_ms() - u.hover_since > 600
        u.tip = s
        u.tip_id = id

func to_text(n: int)
    return "" + n

func draw_tip(u: Ui)
    w = text_w(u, u.tip) + px(u, 20)
    h = u.line_h + px(u, 12)
    x = min(u.mx + px(u, 12), window_w() - w - px(u, 4))
    y = u.my + px(u, 20)
    if y + h > window_h()
        y = u.my - h - px(u, 8)
    shadow_under(u, x, y, w, h, u.radius, 2)
    rframe(u, x, y, w, h, u.raised, u.line)
    txt(u, x + px(u, 10), y + px(u, 6), u.tip, u.ink)

// ---------- перетаскивание ----------

// тащить последнее место: если его схватили и повели — тащим текст data. Отдаёт true, пока тащат его
modpub func drag(u: Ui, data: text) gives on: bool
    on = false
    if u.down and not u.dragging and u.active == "" and inside(u, u.lx, u.ly, u.lw, u.lh) and free(u)
        if u.press_x >= u.lx and u.press_x < u.lx + u.lw and u.press_y >= u.ly and u.press_y < u.ly + u.lh
            if abs(u.mx - u.press_x) + abs(u.my - u.press_y) > px(u, 6)
                u.dragging = true
                u.drag_data = data
    if u.dragging and u.drag_data == data
        on = true
        u.want_cursor = "move"

// бросили на последнее место: отдаёт то, что тащили ("" — ничего)
modpub func drop(u: Ui) gives data: text
    data = ""
    if u.dragging and inside(u, u.lx, u.ly, u.lw, u.lh)
        frame_rect(u.lx, u.ly, u.lw, u.lh, u.accent)
        if u.release
            data = u.drag_data

// ---------- окна внутри окна ----------

// окно поверх содержимого: тянется за заголовок, крестик закрывает. Пока окно открыто, отдаёт true —
// тогда внутри рисуем что угодно (раскладка внутри окна своя), и в конце ui.window_end(u).
// ui.window_show(u, id) открывает его снова
modpub func window(u: Ui, id: text, title: text, w0: int, h0: int) gives open: bool
    if not u.win_open.has(id)
        u.win_open[id] = true
    if not u.win_x.has(id)
        u.win_x[id] = (window_w() - px(u, w0)) / 2 + len(u.win_now) * px(u, 6)
        u.win_y[id] = (window_h() - px(u, h0)) / 3 + len(u.win_now) * px(u, 6)
    open = u.win_open[id]
    if not open
        return
    w = px(u, w0)
    h = px(u, h0)
    x = max(0, min(window_w() - w, u.win_x[id]))
    y = max(0, min(window_h() - px(u, 30), u.win_y[id]))
    u.win_i = len(u.win_now) / 4
    u.win_now.add(x)
    u.win_now.add(y)
    u.win_now.add(w)
    u.win_now.add(h)
    bar = px(u, 32)
    over_bar = free(u) and inside(u, x, y, w - bar, bar)
    if over_bar and u.press
        u.active = "win:" + id
        u.grab = u.mx - x
        u.grab_y = u.my - y
    if u.active == "win:" + id
        x = u.mx - u.grab
        y = u.my - u.grab_y
        u.want_cursor = "move"
    u.win_x[id] = x
    u.win_y[id] = y
    shadow_under(u, x, y, w, h, u.cr, 4)
    rframe_r(u, x, y, w, h, u.cr, u.panel, u.line)
    styled_in(u, x + px(u, 14), y, bar, fit_style(u, title, w - bar - px(u, 20), "strong"), "strong", u.ink)
    draw_rect(x + 1, y + bar, w - 2, 1, u.line)
    // крестик
    cx = x + w - bar / 2
    cy = y + bar / 2
    over_x = free(u) and inside(u, x + w - bar, y, bar, bar)
    if over_x
        rbox(u, cx - px(u, 10), cy - px(u, 10), px(u, 20), px(u, 20), px(u, 10), u.red)
        u.want_cursor = "hand"
    s = px(u, 4)
    draw_line(cx - s, cy - s, cx + s, cy + s, u.ink)
    draw_line(cx - s, cy + s, cx + s, cy - s, u.ink)
    if over_x and u.press
        u.win_open[id] = false
    u.boxes.add(Box(x: x + px(u, 10), y: y + bar + px(u, 10), w: w - px(u, 20), h: h - bar - px(u, 20), gap: px(u, 8)))

// конец окна: раскладка возвращается к окну программы
modpub func window_end(u: Ui)
    done(u)
    u.win_i = -1

modpub func window_show(u: Ui, id: text)
    u.win_open[id] = true

// ---------- раскладка ----------
// Окно — это столбец: куски идут сверху вниз. Пример:
//   ui.pad(u, 12)
//   ui.hbox(u, 32, 8)               // полоса 32 точки высотой, в ней всё в ряд
//   if ui.btn(u, "Назад")
//       ...
//   name = ui.edit(u, "имя", name, "Имя")   // поле в ряду берёт весь остаток
//   ui.done(u)
//   ui.hbox_end(u, 32, 8)           // полоса внизу окна
//   ...
//   ui.done(u)
//   x, y, w, h = ui.take(u, 0)      // 0 — всё, что осталось посередине
// Размеры — в обычных точках (на Retina ui сам умножит); 0 — всё, что осталось.

func cur(u: Ui) gives b: Box
    b = u.boxes[len(u.boxes) - 1]

// прямоугольник текущего места целиком (ничего не занимает): фон полосы, рамка панели
modpub func box_rect(u: Ui) gives x: int, y: int, w: int, h: int
    b = cur(u)
    x = b.x
    y = b.y
    w = b.w
    h = b.h

// сколько ещё свободно вдоль текущего места (в настоящих точках)
modpub func space_left(u: Ui)
    b = cur(u)
    total = b.h
    if b.across
        total = b.w
    return max(total - b.used - b.used_end, 0)

// следующий кусок размером size обычных точек (0 — весь остаток) с начала текущего места
modpub func take(u: Ui, size: int) gives x: int, y: int, w: int, h: int
    x, y, w, h = take_px(u, px(u, size))

func take_px(u: Ui, size: int) gives x: int, y: int, w: int, h: int
    b = cur(u)
    if b.rev
        x, y, w, h = take_end_px(u, size)
        return
    left = space_left(u)
    n = size
    if n <= 0 or n > left
        n = left
    if b.across
        x = b.x + b.used
        y = b.y
        w = n
        h = b.h
    else
        x = b.x
        y = b.y + b.used
        w = b.w
        h = n
    b.used += n + b.gap
    u.lx = x
    u.ly = y
    u.lw = w
    u.lh = h

// кусок с конца текущего места (кнопки справа, полоса внизу)
modpub func take_end(u: Ui, size: int) gives x: int, y: int, w: int, h: int
    x, y, w, h = take_end_px(u, px(u, size))

// дальше в этом ряду куски встают с конца: первый — у правого края, следующий — левее
//   ui.hbox_end(u, 32, 8)
//   ui.toggle(...)          // слева
//   ui.at_end(u)
//   ui.btn_main(u, "OK")    // у правого края
//   ui.btn(u, "Отмена")     // левее
modpub func at_end(u: Ui)
    b = cur(u)
    b.rev = true

func take_end_px(u: Ui, size: int) gives x: int, y: int, w: int, h: int
    b = cur(u)
    n = size
    if n <= 0 or n > space_left(u)
        n = space_left(u)
    if b.across
        x = b.x + b.w - b.used_end - n
        y = b.y
        w = n
        h = b.h
    else
        x = b.x
        y = b.y + b.h - b.used_end - n
        w = b.w
        h = n
    b.used_end += n + b.gap
    u.lx = x
    u.ly = y
    u.lw = w
    u.lh = h

// пропустить место
modpub func space(u: Ui, size: int)
    x, y, w, h = take(u, size)

// отступ внутри текущего места со всех сторон
modpub func pad(u: Ui, n0: int)
    n = px(u, n0)
    b = cur(u)
    b.x += n
    b.y += n
    b.w = max(b.w - 2 * n, 0)
    b.h = max(b.h - 2 * n, 0)

func open_box(u: Ui, size: int, gap: int, across: bool, tail: bool)
    x = 0
    y = 0
    w = 0
    h = 0
    if tail
        x, y, w, h = take_end(u, size)
    else
        x, y, w, h = take(u, size)
    u.boxes.add(Box(x: x, y: y, w: w, h: h, across: across, gap: px(u, gap)))

// новый ряд (куски слева направо) размером size в текущем месте
modpub func hbox(u: Ui, size: int, gap: int)
    open_box(u, size, gap, true, false)

// новый столбец (куски сверху вниз)
modpub func vbox(u: Ui, size: int, gap: int)
    open_box(u, size, gap, false, false)

// то же, но с конца текущего места
modpub func hbox_end(u: Ui, size: int, gap: int)
    open_box(u, size, gap, true, true)

modpub func vbox_end(u: Ui, size: int, gap: int)
    open_box(u, size, gap, false, true)

// закрыть ряд или столбец
modpub func done(u: Ui)
    if len(u.boxes) > 1
        last = u.boxes.pop()

// своя длина вдоль места (настоящие точки): в ряду — ширина по тексту, в столбце — высота строки
func auto(u: Ui, s: text, extra: int)
    if cur(u).across
        return text_w(u, s) + px(u, extra)
    return px(u, 34)

// то же для кнопки: ширина по полужирному тексту
func auto_btn(u: Ui, s: text)
    if cur(u).across
        return style_w(u, s, "button") + px(u, 32)
    return px(u, 34)
// кнопка на своём месте
modpub func btn(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, auto_btn(u, s))
    hit = button(u, x, y, w, h, s)

// кнопка без фона: фон появляется при наведении (панели, меню, второстепенное)
modpub func btn_ghost(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, auto_btn(u, s))
    hit = button_ghost(u, x, y, w, h, s)

// мягкая цветная кнопка: заметная, но не главная («Добавить», «Ещё»)
modpub func btn_soft(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, auto_btn(u, s))
    hit = button_soft(u, x, y, w, h, s)

// красная кнопка: удалить, выйти
modpub func btn_danger(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, auto_btn(u, s))
    hit = button_danger(u, x, y, w, h, s)

// круглая кнопка-значок: ui.btn_icon(u, "×")
modpub func btn_icon(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, px(u, 34))
    size = min(w, h)
    hit = button_icon(u, x + (w - size) / 2, y + (h - size) / 2, size, s)

// текст-ссылка: цветной, при наведении подчёркнут
modpub func btn_link(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, auto(u, s, 4))
    over = free(u) and inside(u, x, y, text_w(u, s), h)
    if over
        u.want_cursor = "hand"
    ty = y + (h - u.line_h) / 2
    txt(u, x, ty, fit(u, s, w), u.accent)
    if over
        draw_rect(x, ty + u.line_h, min(w, text_w(u, s)), max(1, round(u.k)), u.accent)
    hit = over and u.press
// кнопка, которую можно нажать только когда ok (иначе серая)
modpub func btn_if(u: Ui, s: text, ok: bool) gives hit: bool
    x, y, w, h = take_px(u, auto_btn(u, s))
    hit = false
    if ok
        hit = button(u, x, y, w, h, s)
    else
        button_off(u, x, y, w, h, s)
// главная (цветная) кнопка на своём месте
modpub func btn_main(u: Ui, s: text) gives hit: bool
    x, y, w, h = take_px(u, auto_btn(u, s))
    hit = button_main(u, x, y, w, h, s)
// надпись на своём месте (по высоте — по середине)
modpub func lbl(u: Ui, s: text)
    x, y, w, h = take_px(u, auto(u, s, 4))
    txt(u, x, y + (h - u.line_h) / 2, fit(u, s, w), u.ink)

// бледная надпись
modpub func note(u: Ui, s: text)
    x, y, w, h = take_px(u, auto(u, s, 4))
    txt(u, x, y + (h - u.line_h) / 2, fit(u, s, w), u.dim)

// заголовок
modpub func heading(u: Ui, s: text)
    text_line(u, s, "heading", 34)

// крупный заголовок окна
modpub func h1(u: Ui, s: text)
    text_line(u, s, "title", 42)

// подзаголовок
modpub func h3(u: Ui, s: text)
    text_line(u, s, "sub", 26)

// маленькая подпись ЗАГЛАВНЫМИ над полем: ui.caps(u, "Имя")
modpub func caps(u: Ui, s: text)
    text_line(u, s, "caption", 16)

// полужирная надпись
modpub func bold_lbl(u: Ui, s: text)
    text_line(u, s, "strong", 24)

// строка кода моноширинным шрифтом на тёмной плашке
modpub func code_line(u: Ui, s: text)
    size = px(u, 30)
    if cur(u).across
        size = style_w(u, s, "code") + px(u, 20)
    x, y, w, h = take_px(u, size)
    rbox(u, x, y, w, h, px(u, 8), u.fieldbg)
    styled_in(u, x + px(u, 10), y, h, fit_style(u, s, w - px(u, 20), "code"), "code", u.ink)

// цветная плашка-метка: «новое», «3», «готово»
modpub func chip(u: Ui, s: text)
    w0 = style_w(u, s, "caption") + px(u, 16)
    size = px(u, 22)
    if cur(u).across
        size = w0
    x, y, w, h = take_px(u, size)
    bh = px(u, 20)
    by = y + (h - bh) / 2
    rbox(u, x, by, w0, bh, bh / 2, alpha_of(u.accent, 45))
    styled_in(u, x + px(u, 8), by, bh, s, "caption", u.accent)

// надпись своим стилем на своём месте: size — высота строки в обычных точках
modpub func text_line(u: Ui, s: text, st: text, size: int)
    n = px(u, size)
    if cur(u).across
        n = style_w(u, s, st) + px(u, 6)
    x, y, w, h = take_px(u, n)
    styled_in(u, x, y, h, fit_style(u, s, w, st), st, st_color(u, st))
// переключатель на своём месте
modpub func toggle(u: Ui, s: text, on: bool) gives now: bool
    x, y, w, h = take_px(u, auto(u, s, 54))
    now = switch_at(u, x, y + (h - px(u, 22)) / 2, s, on)

// галочка [✓] на своём месте
modpub func checkbox(u: Ui, s: text, on: bool) gives now: bool
    x, y, w, h = take_px(u, auto(u, s, 32))
    now = check(u, x, y + (h - px(u, 20)) / 2, s, on)
// поле ввода: в ряду занимает весь остаток, в столбце — строку
modpub func edit(u: Ui, id: text, value: text, hint: text) gives now: text
    size = px(u, 36)
    if cur(u).across
        size = 0
    x, y, w, h = take_px(u, size)
    now = field(u, id, x, y, w, h, value, hint)
// многострочное поле на своём месте: size — высота (0 — весь остаток)
modpub func area(u: Ui, id: text, value: text, size: int) gives now: text
    x, y, w, h = take(u, size)
    now = text_box(u, id, x, y, w, h, value)

// ползунок на своём месте
modpub func slide(u: Ui, id: text, value: int, lo: int, hi: int) gives v: int
    size = px(u, 32)
    if cur(u).across
        size = px(u, 160)
    x, y, w, h = take_px(u, size)
    v = slider(u, id, x + px(u, 8), y, w - px(u, 16), h, value, lo, hi)

// выбор из списка на своём месте
modpub func pick(u: Ui, id: text, items: list text, current: int) gives p: int
    size = px(u, 32)
    if cur(u).across
        wmax = px(u, 60)
        each it in items
            wmax = max(wmax, text_w(u, it) + px(u, 44))
        size = wmax
    x, y, w, h = take_px(u, size)
    p = choose(u, id, x, y, w, h, items, current)

// меню на своём месте (в ряду — по ширине названия)
modpub func menu(u: Ui, id: text, title: text, items: list text) gives p: int
    x, y, w, h = take_px(u, auto(u, title, 24))
    p = menu_at(u, id, x, y, w, h, title, items)

// вкладки на своём месте
modpub func tabs(u: Ui, names: list text, current: int) gives p: int
    x, y, w, h = take(u, 36)
    p = tabs_at(u, x, y, w, h, names, current)

// картинка на своём месте (по середине; в столбце — своей высоты)
modpub func picture(u: Ui, img: int)
    size = image_h(img)
    if cur(u).across
        size = image_w(img)
    x, y, w, h = take_px(u, size)
    draw_image(img, x + (w - image_w(img)) / 2, y + (h - image_h(img)) / 2)

// черта-разделитель
modpub func divider(u: Ui)
    x, y, w, h = take_px(u, 1)
    draw_rect(x, y, w, max(1, round(u.k)), u.line)
// панель на всё следующее место: дальше раскладка внутри неё (закрыть — ui.done)
modpub func card(u: Ui, size: int)
    x, y, w, h = take(u, size)
    shadow_under(u, x, y, w, h, u.cr, 1)
    panel(u, x, y, w, h)
    u.boxes.add(Box(x: x + px(u, 16), y: y + px(u, 16), w: w - px(u, 32), h: h - px(u, 32), gap: px(u, 10)))
// ---------- окно-вопрос ----------

// открыть вопрос «да / нет»; ответ потом даёт answer(u)
modpub func ask(u: Ui, title: text, message: text, yes: text, no: text)
    u.ask_open = true
    u.ask_title = title
    u.ask_text = message
    u.ask_yes = yes
    u.ask_no = no
    u.ask_answer = 0
    u.ask_tick = u.tick

// 1 — нажали «да», 2 — «нет» или Esc, 0 — ещё не ответили (или вопроса нет). Ответ отдаётся один раз
modpub func answer(u: Ui) gives a: int
    a = u.ask_answer
    if a != 0
        u.ask_answer = 0

func draw_ask(u: Ui)
    W = window_w()
    H = window_h()
    draw_rect(0, 0, W, H, rgba(0, 0, 0, 110))
    w = min(W - px(u, 40), max(px(u, 380), text_w(u, u.ask_text) + px(u, 56)))
    h = px(u, 164)
    x = (W - w) / 2
    y = (H - h) / 2
    shadow_under(u, x, y, w, h, u.cr, 5)
    rframe_r(u, x, y, w, h, u.cr, u.panel, u.line)
    styled(u, x + px(u, 24), y + px(u, 22), fit_style(u, u.ask_title, w - px(u, 48), "heading"), "heading")
    txt(u, x + px(u, 24), y + px(u, 64), fit(u, u.ask_text, w - px(u, 48)), u.dim)
    u.in_ask = u.tick != u.ask_tick
    bw = px(u, 120)
    bh = px(u, 36)
    by = y + h - bh - px(u, 20)
    if button_main(u, x + w - bw - px(u, 24), by, bw, bh, u.ask_yes) or key_pressed(u, "enter")
        u.ask_answer = 1
        u.ask_open = false
    else if button_ghost(u, x + w - 2 * bw - px(u, 32), by, bw, bh, u.ask_no) or key_pressed(u, "escape")
        u.ask_answer = 2
        u.ask_open = false
    u.in_ask = false
