// Файлы — файловый менеджер в окне, написан на Tachbit.
// Все кнопки, списки и окна-вопросы берёт из библиотеки lib/ui.tb (тоже на Tachbit).
//   tb start examples/apps/files              собрать и запустить
//   examples/apps/files/build/files ~/Desktop открыть нужную папку
//
// Мышь: щелчок — выбрать, двойной щелчок — открыть, колёсико — листать. Клавиши: ↑ ↓ — по списку,
// Enter — открыть, Backspace — папка выше, ← → и боковые кнопки мыши — назад и вперёд. Начни печатать — это поиск.

use ui

obj Item
    name: text
    folder: bool
    size: int
    kind: text

obj Fm
    dir: text
    home: text
    items: list Item
    folders: int
    files: int
    sel: int
    top: int
    back: list text
    ahead: list text
    hidden: bool
    by_size: bool
    note: text
    note_at: int
    // просмотр выбранного
    pv_name: text
    pv_lines: list text
    pv_info: text
    pv_img: int
    imgs: dict text int
    // что удаляем, пока висит вопрос
    doomed: text
    // поиск и новое имя
    find: text
    renaming: bool
    new_name: text
    follow: bool         // прокрутить список к выбранному (после стрелок), колёсико это не трогает
    page: int            // сколько строк видно (для Page Up / Page Down)
    // Cmd+C / Cmd+X: что скопировали или вырезали
    clip: text
    clip_cut: bool

// ---------- пути ----------

func join_path(dir: text, name: text)
    if dir == "/"
        return "/" + name
    return dir + "/" + name

func parent(dir: text)
    last = -1
    count i from 0 to len(dir) - 1
        if dir[i] == "/"
            last = i
    if last <= 0
        return "/"
    return cut(dir, 0, last - 1)

func base_name(path: text)
    if path == "/"
        return "/"
    up = parent(path)
    if up == "/"
        return cut(path, 1, len(path) - 1)
    return cut(path, len(up) + 1, len(path) - 1)

func quote(s: text)
    return "'" + replace(s, "'", "'\\''") + "'"

func human(size: int)
    if size < 1024
        return "" + size + " Б"
    if size < 1024 * 1024
        return "" + (size / 1024) + " КБ"
    if size < 1024 * 1024 * 1024
        tenths = size * 10 / (1024 * 1024)
        return "" + (tenths / 10) + "," + (tenths % 10) + " МБ"
    tenths = size * 10 / (1024 * 1024 * 1024)
    return "" + (tenths / 10) + "," + (tenths % 10) + " ГБ"

// расширение без точки, маленькими буквами: "Фото.PNG" → "png"
func ext_of(name: text)
    at = -1
    count i from 0 to len(name) - 1
        if name[i] == "."
            at = i
    if at <= 0 or at == len(name) - 1
        return ""
    return lower(cut(name, at + 1, len(name) - 1))

func kind_of(ext: text)
    if ext == "tb"
        return "Tachbit"
    if ext == "png" or ext == "jpg" or ext == "jpeg" or ext == "gif" or ext == "webp" or ext == "heic"
        return "картинка"
    if ext == "mp4" or ext == "mov" or ext == "mkv" or ext == "avi"
        return "видео"
    if ext == "mp3" or ext == "wav" or ext == "m4a" or ext == "flac" or ext == "ogg"
        return "звук"
    if ext == "pdf"
        return "PDF"
    if ext == "zip" or ext == "gz" or ext == "tar" or ext == "7z" or ext == "dmg"
        return "архив"
    if is_text(ext)
        return "текст"
    if ext == ""
        return "файл"
    return upper(ext)

func is_text(ext: text)
    each e in ["tb", "txt", "md", "c", "h", "py", "js", "ts", "json", "html", "css", "sh", "ps1", "yml", "yaml", "toml", "csv", "log", "ini", "cfg", "xml", "go", "rs", "swift", "java", "sql", "metal", "vert", "frag"]
        if ext == e
            return true
    return false

func kind_color(u: Ui, kind: text)
    if kind == "Tachbit"
        return u.accent
    if kind == "картинка"
        return rgb(120, 170, 255)
    if kind == "видео" or kind == "звук"
        return rgb(200, 130, 240)
    if kind == "PDF"
        return u.red
    if kind == "архив"
        return rgb(230, 170, 90)
    if kind == "текст"
        return rgb(190, 195, 210)
    return u.dim

// ---------- папка ----------

func load(f: Fm)
    names = list_dir(f.dir) else err
        say(f, err)
        return
    f.items.clear()
    f.folders = 0
    f.files = 0
    want = lower(f.find)
    each n in names
        if not f.hidden and starts_with(n, ".")
            skip
        if want != "" and find(lower(n), want) < 0
            skip
        it = Item()
        if ends_with(n, "/")
            it.name = cut(n, 0, len(n) - 2)
            it.folder = true
            it.kind = "папка"
            f.folders += 1
        else
            it.name = n
            it.size = file_size(join_path(f.dir, n))
            it.kind = kind_of(ext_of(n))
            f.files += 1
        f.items.add(it)
    if f.by_size
        sort_by_size(f.items)
    f.sel = -1
    f.top = 0
    f.pv_name = "?"
    f.renaming = false

// папки сначала, потом файлы от больших к маленьким (вставками: файлов в папке немного)
func sort_by_size(items: list Item)
    count i from 1 to len(items) - 1
        it = items[i]
        j = i - 1
        repeat while j >= 0 and bigger(it, items[j])
            items[j + 1] = items[j]
            j -= 1
        items[j + 1] = it

func bigger(a: Item, b: Item)
    if a.folder != b.folder
        return a.folder
    return not a.folder and a.size > b.size

func go(f: Fm, dir: text)
    if not is_folder(dir)
        say(f, "нет такой папки: " + dir)
        return
    if dir == f.dir
        return
    f.back.add(f.dir)
    f.ahead.clear()
    f.find = ""
    came_from(f, dir)

func go_back(f: Fm)
    if len(f.back) == 0
        return
    f.ahead.add(f.dir)
    came_from(f, f.back.pop())

func go_ahead(f: Fm)
    if len(f.ahead) == 0
        return
    f.back.add(f.dir)
    came_from(f, f.ahead.pop())

// перейти в dir; если поднялись выше — выбрать папку, из которой пришли
func came_from(f: Fm, dir: text)
    old = f.dir
    f.dir = dir
    load(f)
    if old != "/" and parent(old) == dir
        name = base_name(old)
        count i from 0 to len(f.items) - 1
            if f.items[i].name == name
                f.sel = i
                f.follow = true

func say(f: Fm, s: text)
    f.note = s
    f.note_at = time_ms()

// открыть выбранное: папку — здесь, файл — программой, которая для него в системе
func open_item(f: Fm, it: Item)
    path = join_path(f.dir, it.name)
    if it.folder
        go(f, path)
        return
    code = 0
    if env("OS") == "Windows_NT"
        code = run("start \"\" \"" + path + "\"")
    else if file_exists("/usr/bin/open")
        code = run("open " + quote(path))
    else
        code = run("xdg-open " + quote(path) + " >/dev/null 2>&1 &")
    if code != 0
        say(f, "не нашлось программы для " + it.name)
    else
        say(f, "открываю " + it.name)

func new_folder(u: Ui, f: Fm)
    name = "Новая папка"
    k = 2
    repeat while is_folder(join_path(f.dir, name)) or file_exists(join_path(f.dir, name))
        name = "Новая папка " + k
        k += 1
    make_folder(join_path(f.dir, name)) else err
        say(f, err)
        return
    f.find = ""
    load(f)
    count i from 0 to len(f.items) - 1
        if f.items[i].name == name
            f.sel = i
            f.follow = true
    say(f, "создана: " + name + ". Напиши имя и нажми Enter")

func start_rename(u: Ui, f: Fm)
    if f.sel < 0
        return
    f.renaming = true
    f.new_name = f.items[f.sel].name
    ui.focus_on(u, "rename")

func finish_rename(f: Fm)
    f.renaming = false
    if f.sel < 0
        return
    old = f.items[f.sel].name
    name = trim(f.new_name)
    if name == "" or name == old
        return
    if find(name, "/") >= 0 or name == "." or name == ".."
        say(f, "в имени не может быть /")
        return
    dest = join_path(f.dir, name)
    if file_exists(dest) or is_folder(dest)
        say(f, "уже есть: " + name)
        return
    move(join_path(f.dir, old), dest) else err
        say(f, err)
        return
    load(f)
    count i from 0 to len(f.items) - 1
        if f.items[i].name == name
            f.sel = i
            f.follow = true
    say(f, "теперь " + name)

// куда класть удалённое: Корзина на Mac, ~/.local/share/Trash на Linux; на Windows — пусто
func trash_dir(f: Fm)
    if f.home == "" or env("OS") == "Windows_NT"
        return ""
    if is_folder(f.home + "/.Trash")
        return f.home + "/.Trash"
    t = f.home + "/.local/share/Trash"
    each p in [f.home + "/.local", f.home + "/.local/share", t, t + "/files", t + "/info"]
        if not is_folder(p)
            make_folder(p) else err
                return ""
    return t + "/files"

func to_trash(f: Fm, name: text)
    src = join_path(f.dir, name)
    trash = trash_dir(f)
    if trash == ""
        remove(src) else err
            say(f, err)
            return
        load(f)
        say(f, "удалено: " + name)
        return
    target = join_path(trash, name)
    pick = name
    k = 2
    repeat while file_exists(target) or is_folder(target)
        pick = name + " " + k
        target = join_path(trash, pick)
        k += 1
    move(src, target) else err
        say(f, err)
        return
    // Linux хочет записку, откуда файл: тогда «Восстановить» в Корзине вернёт его на место
    if ends_with(trash, "/Trash/files")
        when = replace(date_now(), " ", "T")
        note = "[Trash Info]\nPath=" + src + "\nDeletionDate=" + when + "\n"
        write_file(parent(trash) + "/info/" + pick + ".trashinfo", note) else err
            say(f, "в Корзине, но без записки: " + err)
    load(f)
    say(f, "в Корзине: " + name)

// ---------- просмотр выбранного ----------

func preview(f: Fm)
    name = ""
    if f.sel >= 0
        name = f.items[f.sel].name
    if name == f.pv_name
        return
    f.pv_name = name
    f.pv_lines.clear()
    f.pv_info = ""
    f.pv_img = -1
    if name == ""
        return
    it = f.items[f.sel]
    path = join_path(f.dir, name)
    if it.folder
        content = list_dir(path) else err
            f.pv_info = "нет доступа"
            return
        f.pv_info = "внутри: " + len(content)
        n = 0
        each x in content
            if n >= 30
                stop
            if f.hidden or not starts_with(x, ".")
                f.pv_lines.add(x)
                n += 1
        return
    f.pv_info = human(it.size)
    ext = ext_of(name)
    if ext == "png" and it.size < 8 * 1024 * 1024
        if not f.imgs.has(path)
            img = load_image(path) else err
                f.pv_info = human(it.size) + ", не читается"
                return
            f.imgs[path] = img
        f.pv_img = f.imgs[path]
        f.pv_info = human(it.size) + ", " + image_w(f.pv_img) + "×" + image_h(f.pv_img)
        return
    if is_text(ext) and it.size < 200 * 1024
        s = read_file(path) else err
            return
        n = 0
        each line in split(s, "\n")
            if n >= 60
                stop
            f.pv_lines.add(replace(line, "\t", "    "))
            n += 1

func draw_preview(u: Ui, f: Fm)
    x, y, w, h = ui.take(u, 0)
    ui.panel(u, x, y, w, h)
    m = ui.px(u, 14)
    lh = u.line_h + ui.px(u, 4)
    if f.sel < 0
        ui.label(u, x + m, y + m, "Ничего не выбрано", u.dim)
        ui.label(u, x + m, y + m + 2 * lh, ui.fit(u, base_name(f.dir), w - 2 * m), u.ink)
        ui.label(u, x + m, y + m + 3 * lh, "папок " + f.folders + ", файлов " + f.files, u.dim)
        return
    it = f.items[f.sel]
    icon(u, it, x + m, y + m, 2)
    ty = y + m + ui.px(u, 40)
    ui.txt(u, x + m, ty, ui.fit(u, it.name, w - 2 * m), u.ink)
    ui.label(u, x + m, ty + lh, ui.fit(u, it.kind + ", " + f.pv_info, w - 2 * m), u.dim)
    top = ty + 2 * lh + ui.px(u, 10)
    draw_rect(x + 1, top - ui.px(u, 8), w - 2, 1, u.line)
    if f.pv_img >= 0
        iw = image_w(f.pv_img)
        ih = image_h(f.pv_img)
        if iw <= w - 2 * m and ih <= y + h - top - ui.px(u, 10)
            draw_image(f.pv_img, x + (w - iw) / 2, top)
        else
            ui.label(u, x + m, top, "картинка больше окна просмотра", u.dim)
        return
    lines = (y + h - top - ui.px(u, 8)) / lh
    count i from 0 to min(lines, len(f.pv_lines)) - 1
        line = f.pv_lines[i]
        c = u.ink
        if starts_with(trim(line), "//") or starts_with(trim(line), "#")
            c = u.dim
        ui.txt(u, x + m, top + i * lh, ui.fit(u, line, w - 2 * m), c)

// ---------- рисование ----------

// значок: папка — жёлтая с ушком, файл — листок с загнутым углом цвета своего вида
func icon(u: Ui, it: Item, x: int, y: int, s0: int)
    s = s0 * max(1, ui.px(u, 1))
    if it.folder
        c = rgb(240, 196, 90)
        draw_rect(x, y + 2 * s, 7 * s, 3 * s, c)
        draw_rect(x, y + 4 * s, 16 * s, 10 * s, c)
        draw_rect(x, y + 6 * s, 16 * s, 1 * s, rgb(214, 168, 66))
        return
    c = kind_color(u, it.kind)
    draw_rect(x + 2 * s, y, 9 * s, 16 * s, c)
    draw_rect(x + 11 * s, y + 4 * s, 3 * s, 12 * s, c)
    draw_rect(x + 11 * s, y, 3 * s, 4 * s, u.bg)
    draw_rect(x + 11 * s, y + 3 * s, 3 * s, 1 * s, u.line)
    draw_rect(x + 4 * s, y + 7 * s, 8 * s, 1 * s, u.bg)
    draw_rect(x + 4 * s, y + 10 * s, 8 * s, 1 * s, u.bg)

// маленькая стрелка › между папками пути (такой буквы в шрифте нет — рисуем линиями)
func chevron(u: Ui, x: int, y: int, c: int)
    s = ui.px(u, 4)
    draw_line(x, y, x + s, y + s, c)
    draw_line(x + s, y + s, x, y + 2 * s, c)

// путь сверху: каждая папка — кнопка; не влезает — показываем хвост. Занимает остаток ряда
func crumbs(u: Ui, f: Fm)
    x, y, w, h = ui.take(u, 0)
    parts = list text
    paths = list text
    p = f.dir
    repeat while true
        parts.add(base_name(p))
        paths.add(p)
        if p == "/"
            stop
        p = parent(p)
    gap = ui.px(u, 12)
    most = ui.px(u, 200)
    // считаем с конца (последняя папка справа), пока влезает
    used = 0
    first = 0
    count i from 0 to len(parts) - 1
        bw = min(most, ui.text_w(u, parts[i]) + ui.px(u, 20))
        if used + bw + gap > w - ui.px(u, 30)
            first = i
            stop
        used += bw + gap
        first = i + 1
    cx = x
    if first < len(parts)
        ui.label(u, cx, y + (h - u.line_h) / 2, "..", u.dim)
        cx += ui.px(u, 20)
    i = first - 1
    repeat while i >= 0
        bw = min(most, ui.text_w(u, parts[i]) + ui.px(u, 20))
        if i == 0
            ui.rbox(u, cx, y, bw, h, u.radius, u.sel)
            ui.label_center(u, cx, y, bw, h, parts[i], u.ink)
        else if ui.button(u, cx, y, bw, h, parts[i])
            go(f, paths[i])
            return
        cx += bw
        if i > 0
            chevron(u, cx + ui.px(u, 3), y + h / 2 - ui.px(u, 4), u.dim)
        cx += gap
        i -= 1

// слева: места (столбец)
func places(u: Ui, f: Fm)
    x, y, w, h = ui.box_rect(u)
    draw_rect(x, y, w, h, u.panel)
    draw_rect(x + w - 1, y, 1, h, u.line)
    ui.pad(u, 6)
    ui.vbox(u, 0, 2)
    ui.note(u, "  Места")
    names = ["Дом", "Рабочий стол", "Документы", "Загрузки", "Картинки", "Корень диска"]
    dirs = [f.home, f.home + "/Desktop", f.home + "/Documents", f.home + "/Downloads", f.home + "/Pictures", "/"]
    count i from 0 to len(names) - 1
        d = dirs[i]
        if d == "" or not is_folder(d)
            skip
        rx, ry, rw, rh = ui.take(u, 30)
        it = Item(folder: true)
        r = ui.row(u, "place" + i, rx, ry, rw, rh, "", f.dir == d)
        icon(u, it, rx + ui.px(u, 8), ry + (rh - ui.px(u, 16)) / 2, 1)
        ui.txt(u, rx + ui.px(u, 34), ry + (rh - u.line_h) / 2, ui.fit(u, names[i], rw - ui.px(u, 42)), u.ink)
        if r > 0
            go(f, d)
            ui.done(u)
            return
    ui.done(u)

// нижняя полоса: слева «Скрытые» и что в папке, справа кнопки
func status(u: Ui, f: Fm)
    now = ui.toggle(u, "Скрытые", f.hidden)
    if now != f.hidden
        f.hidden = now
        load(f)
        return
    ui.at_end(u)
    can = f.sel >= 0
    hit = false
    if can
        hit = ui.btn_main(u, "Открыть")
    else
        hit = ui.btn_if(u, "Открыть", false)
    if hit
        open_item(f, f.items[f.sel])
        return
    if ui.btn_if(u, "В корзину", can)
        ask_delete(u, f)
    if ui.btn(u, "Новая папка")
        new_folder(u, f)
        if f.sel >= 0
            start_rename(u, f)
        return
    if ui.btn_if(u, "Переименовать", can)
        start_rename(u, f)
    // что осталось посередине — надпись
    x, y, w, h = ui.take(u, 0)
    s = "папок " + f.folders + ", файлов " + f.files
    c = u.dim
    if f.note != "" and time_ms() - f.note_at < 4000
        s = f.note
        c = u.accent
    ui.txt(u, x + ui.px(u, 8), y + (h - u.line_h) / 2, ui.fit(u, s, w - ui.px(u, 8)), c)

func ask_delete(u: Ui, f: Fm)
    it = f.items[f.sel]
    f.doomed = it.name
    if trash_dir(f) == ""
        ui.ask(u, "Удалить насовсем?", it.name + " — вернуть будет нельзя", "Удалить", "Отмена")
    else
        ui.ask(u, "В корзину?", it.name, "В корзину", "Отмена")

// список файлов с шапкой и полосой прокрутки: занимает остаток места
func list_view(u: Ui, f: Fm)
    x, y, w, h = ui.take(u, 0)
    k = ui.px(u, 1)
    rh = ui.px(u, 28)
    head = ui.px(u, 28)
    size_w = ui.px(u, 100)
    kind_w = ui.px(u, 110)
    bar = ui.px(u, 12)
    lw = w - bar - ui.px(u, 2)
    ty = (rh - u.line_h) / 2
    // шапка: щёлкни «Имя» или «Размер» — так и отсортируется
    draw_rect(x, y + head - 1, w, 1, u.line)
    name_c = u.dim
    size_c = u.dim
    if f.by_size
        size_c = u.accent
    else
        name_c = u.accent
    ui.label(u, x + ui.px(u, 44), y + ty, "Имя", name_c)
    ui.label(u, x + lw - size_w - kind_w, y + ty, "Размер", size_c)
    ui.label(u, x + lw - kind_w + ui.px(u, 10), y + ty, "Вид", u.dim)
    if ui.clicked(u, x, y, lw - size_w - kind_w - ui.px(u, 10), head) and f.by_size
        f.by_size = false
        load(f)
        return
    if ui.clicked(u, x + lw - size_w - kind_w - ui.px(u, 10), y, size_w, head) and not f.by_size
        f.by_size = true
        load(f)
        return
    top_y = y + head
    room = h - head
    shown = max(1, room / rh)
    f.page = shown
    n = len(f.items)
    // после стрелок выбранная строка должна быть видна; колёсико листает свободно
    if f.sel >= 0 and f.follow
        if f.sel < f.top
            f.top = f.sel
        if f.sel >= f.top + shown
            f.top = f.sel - shown + 1
    f.follow = false
    f.top = ui.wheel_scroll(u, x, top_y, w, room, n, shown, f.top)
    f.top = max(0, min(f.top, n - shown))
    if n == 0
        if f.find != ""
            ui.label(u, x + ui.px(u, 44), top_y + ui.px(u, 20), "ничего не нашлось", u.dim)
        else
            ui.label(u, x + ui.px(u, 44), top_y + ui.px(u, 20), "пусто", u.dim)
    count j from 0 to shown - 1
        i = f.top + j
        if i >= n
            stop
        it = f.items[i]
        ry = top_y + j * rh
        r = ui.row(u, f.dir + "/" + it.name, x + ui.px(u, 4), ry, lw - ui.px(u, 4), rh, "", i == f.sel)
        icon(u, it, x + ui.px(u, 14), ry + (rh - ui.px(u, 16)) / 2, 1)
        name_room = lw - size_w - kind_w - ui.px(u, 54)
        if f.renaming and i == f.sel
            f.new_name = ui.field(u, "rename", x + ui.px(u, 38), ry + k, name_room + ui.px(u, 10), rh - 2 * k, f.new_name, "")
            if u.entered
                finish_rename(f)
                u.focus = ""
                return
            if u.focus != "rename"
                f.renaming = false
        else
            ui.txt(u, x + ui.px(u, 44), ry + ty, ui.fit(u, it.name, name_room), u.ink)
        if not it.folder
            ui.txt(u, x + lw - size_w - kind_w, ry + ty, human(it.size), u.dim)
        ui.txt(u, x + lw - kind_w + ui.px(u, 10), ry + ty, ui.fit(u, it.kind, kind_w - ui.px(u, 14)), kind_color(u, it.kind))
        if r == 1 and not (f.renaming and i == f.sel)
            f.sel = i
        else if r == 2 and not f.renaming
            f.sel = i
            open_item(f, it)
            return
    f.top = ui.scrollbar(u, "list", x + w - bar, top_y, bar, room, n, shown, f.top)

func keys(u: Ui, f: Fm)
    // боковые кнопки мыши — как в браузере
    if u.back_press
        go_back(f)
    if u.fwd_press
        go_ahead(f)
    // Cmd+F — в поиск, даже если печатали в другом месте
    if ui.shortcut(u, "cmd+f") and window_w() >= 700
        ui.focus_on(u, "find")
        return
    if ui.typing(u)
        return
    // начали печатать мимо полей — это поиск
    if u.typed != "" and not u.ask_open and window_w() >= 700
        f.find += u.typed
        ui.focus_on(u, "find")
        u.typed = ""
        load(f)
        return
    n = len(f.items)
    if ui.shortcut(u, "cmd+up")
        go(f, parent(f.dir))
        return
    if ui.shortcut(u, "cmd+down") and f.sel >= 0
        open_item(f, f.items[f.sel])
        return
    if ui.shortcut(u, "cmd+[")
        go_back(f)
        return
    if ui.shortcut(u, "cmd+]")
        go_ahead(f)
        return
    if ui.shortcut(u, "cmd+shift+n")
        new_folder(u, f)
        if f.sel >= 0
            start_rename(u, f)
        return
    if ui.shortcut(u, "cmd+shift+.")
        f.hidden = not f.hidden
        load(f)
        return
    if ui.shortcut(u, "cmd+c") and f.sel >= 0
        f.clip = join_path(f.dir, f.items[f.sel].name)
        f.clip_cut = false
        say(f, "скопировано: " + f.items[f.sel].name + ". Cmd+V — вставить")
        return
    if ui.shortcut(u, "cmd+x") and f.sel >= 0
        f.clip = join_path(f.dir, f.items[f.sel].name)
        f.clip_cut = true
        say(f, "вырезано: " + f.items[f.sel].name + ". Cmd+V — перенести сюда")
        return
    if ui.shortcut(u, "cmd+v")
        paste(f)
        return
    if f.sel >= 0 and (ui.shortcut(u, "cmd+backspace") or ui.shortcut(u, "delete"))
        ask_delete(u, f)
        return
    if ui.shortcut(u, "f2") and f.sel >= 0
        start_rename(u, f)
        return
    if ui.shortcut(u, "escape") and f.find != ""
        f.find = ""
        load(f)
        return
    if not ui.plain(u)
        return
    if ui.key_repeat(u, "down") and n > 0
        f.sel = min(n - 1, f.sel + 1)
        f.follow = true
    if ui.key_repeat(u, "up") and n > 0
        f.sel = max(0, f.sel - 1)
        f.follow = true
    if ui.key_repeat(u, "pagedown") and n > 0
        f.sel = min(n - 1, max(0, f.sel) + max(1, f.page - 1))
        f.follow = true
    if ui.key_repeat(u, "pageup") and n > 0
        f.sel = max(0, f.sel - max(1, f.page - 1))
        f.follow = true
    if ui.key_pressed(u, "home") and n > 0
        f.sel = 0
        f.follow = true
    if ui.key_pressed(u, "end") and n > 0
        f.sel = n - 1
        f.follow = true
    if ui.key_pressed(u, "enter") and f.sel >= 0
        open_item(f, f.items[f.sel])
    if ui.key_pressed(u, "backspace")
        go(f, parent(f.dir))
    if ui.key_pressed(u, "left")
        go_back(f)
    if ui.key_pressed(u, "right")
        go_ahead(f)

// «фото.png» → «фото копия.png», потом «фото копия 2.png» ...
func free_name(dir: text, name: text, folder: bool)
    if not file_exists(join_path(dir, name)) and not is_folder(join_path(dir, name))
        return name
    stem = name
    ext = ext_of(name)
    tail = ""
    if ext != "" and not folder
        stem = cut(name, 0, len(name) - len(ext) - 2)
        tail = "." + cut(name, len(name) - len(ext), len(name) - 1)
    pick = stem + " копия" + tail
    k = 2
    repeat while file_exists(join_path(dir, pick)) or is_folder(join_path(dir, pick))
        pick = stem + " копия " + k + tail
        k += 1
    return pick

// Cmd+V: вставить скопированное (копия) или вырезанное (перенос) в эту папку
func paste(f: Fm)
    if f.clip == ""
        say(f, "сначала Cmd+C или Cmd+X на файле")
        return
    src = f.clip
    if not file_exists(src) and not is_folder(src)
        say(f, "его уже нет: " + base_name(src))
        f.clip = ""
        return
    folder = is_folder(src)
    if folder and (f.dir == src or starts_with(f.dir, src + "/"))
        say(f, "нельзя положить папку саму в себя")
        return
    if f.clip_cut and parent(src) == f.dir
        say(f, "он и так в этой папке")
        return
    name = free_name(f.dir, base_name(src), folder)
    dest = join_path(f.dir, name)
    if f.clip_cut
        move(src, dest) else err
            say(f, err)
            return
        f.clip = ""
    else
        code = 0
        if env("OS") == "Windows_NT"
            code = run("powershell -NoProfile -Command Copy-Item -Recurse -LiteralPath " + quote(src) + " -Destination " + quote(dest))
        else
            code = run("cp -R " + quote(src) + " " + quote(dest))
        if code != 0
            say(f, "не получилось скопировать " + base_name(src))
            return
    load(f)
    count i from 0 to len(f.items) - 1
        if f.items[i].name == name
            f.sel = i
            f.follow = true
    if f.clip_cut
        say(f, "перенесено: " + name)
    else
        say(f, "вставлено: " + name)

func main()
    f = Fm(sel: -1, pv_img: -1)
    f.home = env("HOME")
    if f.home == ""
        // Windows: C:\Users\имя → C:/Users/имя (косая черта вперёд там тоже работает)
        f.home = replace(env("USERPROFILE"), "\\", "/")
    f.dir = f.home
    a = args()
    if len(a) > 0
        f.dir = a[0]
        if starts_with(f.dir, "~")
            f.dir = f.home + cut(f.dir, 1, len(f.dir) - 1)
        if not starts_with(f.dir, "/")
            f.dir = join_path(env("PWD"), f.dir)
    if f.dir == ""
        f.dir = "/"
    repeat while len(f.dir) > 1 and ends_with(f.dir, "/")
        f.dir = cut(f.dir, 0, len(f.dir) - 2)
    load(f)
    window_sharp()
    try window_open(1000, 620, "Файлы")
    u = ui.start()
    repeat while window_alive()
        ui.frame(u)
        W = window_w()
        clear_window(u.bg)
        // ответ на вопрос «удалить?»
        if ui.answer(u) == 1 and f.doomed != ""
            to_trash(f, f.doomed)
        if not u.ask_open
            f.doomed = ""
        keys(u, f)
        // верхняя полоса: назад, вперёд, выше, путь, поиск
        ui.hbox(u, 48, 4)
        x, y, w, h = ui.box_rect(u)
        draw_rect(x, y, w, h, u.panel)
        draw_rect(x, y + h - 1, w, 1, u.line)
        ui.pad(u, 9)
        if ui.btn_if(u, "<", len(f.back) > 0)
            go_back(f)
        if ui.btn_if(u, ">", len(f.ahead) > 0)
            go_ahead(f)
        if ui.btn_if(u, "^", f.dir != "/")
            go(f, parent(f.dir))
        ui.space(u, 6)
        if W >= ui.px(u, 700)
            ui.at_end(u)
            ui.hbox(u, 220, 0)
            was = f.find
            f.find = ui.edit(u, "find", f.find, "Поиск в этой папке")
            if f.find != was
                load(f)
            if u.entered
                u.focus = ""
                if len(f.items) > 0
                    f.sel = 0
                    f.follow = true
            ui.done(u)
            ui.space(u, 10)
        crumbs(u, f)
        ui.done(u)
        // нижняя полоса
        ui.hbox_end(u, 38, 8)
        x, y, w, h = ui.box_rect(u)
        draw_rect(x, y, w, h, u.panel)
        draw_rect(x, y, w, 1, u.line)
        ui.pad(u, 5)
        ui.space(u, 4)
        status(u, f)
        ui.done(u)
        // слева места, справа просмотр (если окно широкое), в середине список
        ui.hbox(u, 0, 0)
        ui.vbox(u, 180, 0)
        places(u, f)
        ui.done(u)
        preview(f)
        if W >= ui.px(u, 860)
            ui.at_end(u)
            ui.vbox(u, 280, 0)
            draw_preview(u, f)
            ui.done(u)
        ui.vbox(u, 0, 0)
        list_view(u, f)
        ui.done(u)
        ui.done(u)
        ui.end_frame(u)
