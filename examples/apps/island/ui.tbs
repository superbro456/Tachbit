// ИНТЕРФЕЙС игры «Остров-защита». Только вид: тексты, кнопки, цвета.
// Что нажали — читает main.tb (view.pressed), числа подставляет он же (view.put_prop).
// Остров рисуется под интерфейсом, поэтому у экранов прозрачный фон.

style tower
    backcolor: rgba(255, 255, 255, 0.10)
    corner.radius: 14
    align: left

style picked from tower
    backcolor: gradient(to right, #3ad6c1, #6b5bff)
    color: white
    glow: #6b5bff

style stat
    size: 17
    color: white
    text.shadow: yes

// ---------- игра: верхняя полоса и панель справа ----------
screen hud 6x10
    backcolor: transparent
    backdim: 0
    cols: * * * * * 250
    rows: 56 46 46 46 46 * 44 44 46 52
    pad: 10
    gap: 8

    card bar (A1:E1)
        corner.radius: 18
    text level (A1)
        text: Тихая лагуна
        style: stat
        size: 18
    text money (B1)
        text: Монеты 0
        style: stat
        color: #ffd65a
    text lives (C1)
        text: Жизни 20
        style: stat
        color: #ff8f8f
    text wave (D1)
        text: Волна 0 / 8
        style: stat
    text score (E1)
        text: Счёт 0
        style: stat

    card side (F1:F10)
        corner.radius: 20
    btn pause (F1)
        text: Пауза  Esc
        look: soft
    btn t0 (F2)
        text: 1  Лучник · 50
        style: tower
    btn t1 (F3)
        text: 2  Пушка · 90
        style: tower
    btn t2 (F4)
        text: 3  Мороз · 70
        style: tower
    btn t3 (F5)
        text: 4  Молния · 140
        style: tower
    text info (F6)
        text: Выбери башню и нажми на песок или траву.
        wrap: yes
        size: 14
        color: rgba(255, 255, 255, 0.85)
        padding: 6
    btn up (F7)
        text: Улучшить · 40
        backcolor: rgba(90, 230, 150, 0.25)
        corner.color: #5ae69a
        corner.radius: 14
    btn sell (F8)
        text: Продать · 35
        color: #ff9a9a
        backcolor: rgba(255, 90, 90, 0.18)
        corner.radius: 14
    btn speed (F9)
        text: Скорость ×1
        look: soft
    btn go (F10)
        text: Волна 1  ▶
        look: main
        height: 46
        corner.radius: 18

// ---------- главное меню ----------
screen menu 4x7
    backcolor: transparent
    backblur: 8
    backdim: 40%
    cols: * 166 166 *
    rows: * 90 40 58 58 58 50
    title name (B2:C2)
        text: Остров-защита
        size: 40
        align: center
        text.shadow: yes
    note sub (B3:C3)
        text: Пираты плывут к крепости. Построй башни вдоль тропы.
        align: center
        wrap: yes
    btn lv0 (B4:C4)
        text: Тихая лагуна
        look: main
        corner.radius: 18
    btn lv1 (B5:C5)
        text: Две бухты
        corner.radius: 18
    btn lv2 (B6:C6)
        text: Вулкан
        corner.radius: 18
    btn help (B7)
        text: Как играть
        look: ghost
    btn quit (C7)
        text: Выход
        look: ghost

// ---------- как играть ----------
screen help 3x3
    backcolor: transparent
    backblur: 8
    backdim: 45%
    cols: * 520 *
    rows: * 360 60
    card (B2)
        corner.radius: 22
    text howto (B2)
        text: Враги идут по тропе от причала к крепости. Выбери башню справа (или клавиши 1–4) и нажми на песок или траву. Лучник быстрый и бьёт чаек. Пушка бьёт ядром по площади, но не достаёт птиц. Мороз замедляет. Молния цепляет сразу нескольких, броня черепах её не держит. Нажми на башню — можно улучшить или продать. Пробел — следующая волна, Esc — пауза, F — быстрее.
        wrap: yes
        line.height: 1.5
        padding: 12
    btn back (B3)
        text: Понятно
        look: main

// ---------- пауза ----------
screen pause 3x5
    backcolor: transparent
    backblur: 10
    backdim: 40%
    cols: * 300 *
    rows: * 70 52 52 52 *
    title ptitle (B2)
        text: Пауза
        align: center
    btn resume (B3)
        text: Продолжить
        look: main
    btn restart (B4)
        text: Заново
    btn tomenu (B5)
        text: В меню
        look: ghost

// ---------- конец уровня ----------
screen end 3x7
    backcolor: transparent
    backblur: 10
    backdim: 45%
    cols: * 340 *
    rows: * 70 36 36 52 52 52 *
    title etitle (B2)
        text: Победа!
        align: center
        size: 36
        text.shadow: yes
    text escore (B3)
        text: Счёт 0
        align: center
        size: 20
        color: #ffd65a
    text ebest (B4)
        text: Рекорд 0
        align: center
        color: rgba(255, 255, 255, 0.75)
    btn next (B5)
        text: Следующий остров
        look: main
    btn again (B6)
        text: Ещё раз
    btn tomenu2 (B7)
        text: В меню
        look: ghost
