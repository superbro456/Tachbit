// ИНТЕРФЕЙС игры «Остров-защита». Только вид: тексты, кнопки, цвета.
// Что нажали — читает main.tb (view.pressed), числа подставляет он же (view.put_prop).
// Остров рисуется под интерфейсом, поэтому у экранов прозрачный фон.

style tower
    backcolor: rgba(255, 255, 255, 0.10)
    corner.radius: 14
    align: left

style picked from tower
    backcolor: gradient(to right, #3ad6c1, #6b5bff)
    color: white
    glow: #6b5bff

style stat
    size: 17
    color: white
    text.shadow: yes

// ---------- игра: верхняя полоса и панель справа ----------
screen hud 7x10
    backcolor: transparent
    backdim: 0
    cols: * * * * * 150 150
    rows: 56 30 46 46 46 46 * 44 44 52
    pad: 10
    gap: 8

    card bar (A1:E1)
        corner.radius: 18
    text level (A1)
        text: Тихая лагуна
        style: stat
        size: 18
    text money (B1)
        text: Монеты 0
        style: stat
        color: #ffd65a
    text lives (C1)
        text: Жизни 20
        style: stat
        color: #ff8f8f
    text wave (D1)
        text: Волна 0 / 8
        style: stat
    text score (E1)
        text: Счёт 0
        style: stat

    card side (F1:G10)
        corner.radius: 20
    btn pause (F1)
        text: Пауза
        look: soft
    btn speed (G1)
        text: Скорость ×1
        look: soft
    text cap1 (F2)
        text: Строить
        size: 14
        color: rgba(255, 255, 255, 0.7)
        align: center
    text cap2 (G2)
        text: Войска
        size: 14
        color: rgba(255, 255, 255, 0.7)
        align: center
    btn b0 (F3)
        text: 1  Башня · 50
        style: tower
    btn b1 (F4)
        text: 2  Пушка · 90
        style: tower
    btn b2 (F5)
        text: 3  Стена · 40
        style: tower
    btn flag (F6)
        text: Флаг войскам
        style: tower
    btn u0 (G3)
        text: Мечник · 30
        style: tower
    btn u1 (G4)
        text: Лучник · 40
        style: tower
    btn u2 (G5)
        text: Конница · 75
        style: tower
    btn fort (G6)
        text: Крепость 1
        style: tower
    text info (F7:G7)
        text: Выбери, что строить, и нажми на остров.
        wrap: yes
        size: 14
        color: rgba(255, 255, 255, 0.85)
        padding: 6
    btn up (F8:G8)
        text: Улучшить · 40
        backcolor: rgba(90, 230, 150, 0.25)
        corner.color: #5ae69a
        corner.radius: 14
    btn sell (F9:G9)
        text: Продать · 35
        color: #ff9a9a
        backcolor: rgba(255, 90, 90, 0.18)
        corner.radius: 14
    btn go (F10:G10)
        text: Волна 1  ▶
        look: main
        height: 46
        corner.radius: 18

// ---------- главное меню ----------
screen menu 4x7
    backcolor: transparent
    backblur: 8
    backdim: 40%
    cols: * 166 166 *
    rows: * 90 40 58 58 58 50
    title name (B2:C2)
        text: Остров-защита
        size: 40
        align: center
        text.shadow: yes
    note sub (B3:C3)
        text: Пираты плывут к крепости. Построй башни вдоль тропы.
        align: center
        wrap: yes
    btn lv0 (B4:C4)
        text: Тихая лагуна
        look: main
        corner.radius: 18
    btn lv1 (B5:C5)
        text: Две бухты
        corner.radius: 18
    btn lv2 (B6:C6)
        text: Вулкан
        corner.radius: 18
    btn help (B7)
        text: Как играть
        look: ghost
    btn quit (C7)
        text: Выход
        look: ghost

// ---------- как играть ----------
screen help 3x3
    backcolor: transparent
    backblur: 8
    backdim: 45%
    cols: * 520 *
    rows: * 400 60
    card (B2)
        corner.radius: 22
    text howto (B2)
        text: Враги (крабы, гоблины, тролли, колдуны) идут по тропе от причала к крепости. Строй башни и пушки на песке, траве и холмах (с холма бьют дальше), стены — прямо на тропу. Нанимай мечников, лучников и конницу: они идут к флагу и держат врагов. Улучшай крепость — она даёт жизни, золото за волну, с 3-го уровня стреляет сама, и до её уровня можно улучшать всё остальное. Заброшенную башню можно починить. Клавиши: 1–3 строить, Q W E войска, Пробел — волна, U улучшить, X продать, F быстрее, Esc пауза.
        wrap: yes
        line.height: 1.5
        padding: 12
    btn back (B3)
        text: Понятно
        look: main

// ---------- пауза ----------
screen pause 3x5
    backcolor: transparent
    backblur: 10
    backdim: 40%
    cols: * 300 *
    rows: * 70 52 52 52 *
    title ptitle (B2)
        text: Пауза
        align: center
    btn resume (B3)
        text: Продолжить
        look: main
    btn restart (B4)
        text: Заново
    btn tomenu (B5)
        text: В меню
        look: ghost

// ---------- конец уровня ----------
screen end 3x7
    backcolor: transparent
    backblur: 10
    backdim: 45%
    cols: * 340 *
    rows: * 70 36 36 52 52 52 *
    title etitle (B2)
        text: Победа!
        align: center
        size: 36
        text.shadow: yes
    text escore (B3)
        text: Счёт 0
        align: center
        size: 20
        color: #ffd65a
    text ebest (B4)
        text: Рекорд 0
        align: center
        color: rgba(255, 255, 255, 0.75)
    btn next (B5)
        text: Следующий остров
        look: main
    btn again (B6)
        text: Ещё раз
    btn tomenu2 (B7)
        text: В меню
        look: ghost
