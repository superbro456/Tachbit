// ВЫВОД 3D — это твой файл: здесь рисуется остров. Данные только читаем, ничего не меняем
// (кроме камеры g.cam: по ней логика узнаёт, на какую клетку смотрит мышь).
//
// Пока ready() отвечает false, игра рисует простой вид сверху (view2d.tb).
// Сделаешь 3D — поставь в ready() true, и игра пойдёт в 3D.
//
// Что есть в данных (подробно — в data.tb):
//   g.w, g.h                — размер острова в клетках
//   cell(g, c, r)           — что в клетке: 0 вода, 1 песок, 2 трава, 3 тропа, 4 камень, 5 крепость,
//                             6 причал, 7 дерево, 8 холм, 9 заброшенная башня
//   cell_x(g, c), cell_z(g, r) — центр клетки в 3D (y = 0 — земля, клетка = 1.0)
//   g.builds                — строения: kind (0 башня 1–5, 1 пушка 1–5, 2 стена 1–3), lvl, col, row,
//                             aim (куда повёрнута, градусы), flash (вспышка выстрела 1 → 0),
//                             hp / max_hp (у стены), hill (стоит на холме)
//                             на клетке 9 может стоять башня (починили) — тогда build_at(g, c, r) >= 0
//   g.fort                  — уровень крепости 1–10, g.fort_aim — куда она стреляет (с 3-го уровня)
//   g.troops                — войска: kind (0 мечник, 1 лучник, 2 конница), x, y, z, yaw,
//                             hp / max_hp, hit (мигание), swing (взмах 1 → 0), alive
//                             уровень вида: g.troop_lvl[kind] (мечник до 5, лучник до 6, конница до 3)
//   g.enemies               — враги: kind (0 краб, 1 гоблин, 2 тролль, 3 колдун), x, y, z, yaw,
//                             hp / max_hp, hit, swing (замах), stuck (стоит у стены), alive
//   g.shots                 — снаряды: kind (0 стрела, 1 ядро, 2 магия), x, y, z, откуда x0 y0 z0, куда tx ty tz
//   g.fx                    — вспышки: kind (0 взрыв, 1 удар, 2 магия, 3 монетка, 4 новый уровень,
//                             5 пыль стройки, 6 взмах мечей), x, y, z, age / life (0 → 1 — сколько прожила)
//   g.flag                  — флаг войскам: point_on_path(g, g.flag) даёт x, z, yaw
//   g.hov_c, g.hov_r        — клетка под мышью (−1 — нет)
//   g.tool                  — "" выбор, "b0" "b1" "b2" — строим башню / пушку / стену, "flag" — ставим флаг
//   g.sel                   — что выбрано: "b" + номер строения, "t" + вид войск, "fort", "ruin" + клетка
//   t                       — секунды с начала игры (для воды, мигания и всего, что двигается само)
//
// Слова для 3D: mesh_new(), mesh_add(m, ...), draw_mesh(m, x, y, z, поворот),
// draw_mesh_rot(...), camera(...), sunlight(...), fog(...), shadows(...), point_light(...),
// и готовые модели: use model → model.load("башня1.vox" / ".glb"). Примеры: examples/apps/playground, football.
use data
use logic

// 3D готово?
modpub func ready()
    return false

// один раз после window_open: сделать сетки, загрузить модели, поставить свет
modpub func setup(g: Game)
    place_camera(g)

// камера: сверху наискосок на весь остров. Можно двигать — мышь всё равно попадёт в нужную клетку
modpub func place_camera(g: Game)
    g.cam.x = 0.0
    g.cam.y = g.h * 1.05
    g.cam.z = g.h * 0.95
    g.cam.lx = 0.0
    g.cam.ly = 0.0
    g.cam.lz = 0.4

// каждый кадр: весь мир
modpub func draw_world(g: Game, t: dec)
    c = g.cam
    camera(c.x, c.y, c.z, c.lx, c.ly, c.lz)
    draw_island(g, t)
    draw_terrain(g, t)
    draw_fort(g, t)
    draw_flag(g, t)
    each b in g.builds
        draw_build(g, b, t)
    each tr in g.troops
        if tr.alive
            draw_troop(g, tr, t)
    each e in g.enemies
        if e.alive
            draw_enemy(g, e, t)
    each s in g.shots
        draw_shot(g, s, t)
    each f in g.fx
        draw_fx(g, f, t)
    draw_hover(g, t)

// море, песок, трава, тропа, причал
func draw_island(g: Game, t: dec)
    return

// рельеф: деревья (7), камни (4), холмы (8), заброшенные башни (9, если на клетке нет строения)
func draw_terrain(g: Game, t: dec)
    return

// крепость: уровень g.fort 1–10 (чем выше, тем больше башенок и стен)
func draw_fort(g: Game, t: dec)
    return

// флаг войскам на тропе
func draw_flag(g: Game, t: dec)
    return

// строение: башня или пушка (уровень lvl, поворот aim), стена поперёк тропы (lvl 1–3, трещины по hp)
func draw_build(g: Game, b: Building, t: dec)
    return

// воин: мечник, лучник, конница; уровень — g.troop_lvl[tr.kind]
func draw_troop(g: Game, tr: Troop, t: dec)
    return

// враг: краб, гоблин, тролль, колдун; место x y z, поворот yaw, полоска жизни hp / max_hp
func draw_enemy(g: Game, e: Enemy, t: dec)
    return

// стрела, ядро, магия
func draw_shot(g: Game, s: Shot, t: dec)
    return

// взрывы, удары, монетки, взмах мечей
func draw_fx(g: Game, f: Fx, t: dec)
    return

// подсветка клетки под мышью: зелёная — можно строить, красная — нельзя; круг дальности
func draw_hover(g: Game, t: dec)
    return
