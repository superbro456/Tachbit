// ВЫВОД 3D — это твой файл: здесь рисуется остров. Данные только читаем, ничего не меняем
// (кроме камеры g.cam: по ней логика узнаёт, на какую клетку смотрит мышь).
//
// Пока ready() отвечает false, игра рисует простой вид сверху (view2d.tb).
// Сделаешь 3D — поставь в ready() true, и игра пойдёт в 3D.
//
// Что есть в данных (подробно — в data.tb):
//   g.w, g.h                — размер острова в клетках
//   cell(g, c, r)           — что в клетке: 0 вода, 1 песок, 2 трава, 3 тропа, 4 скала, 5 крепость, 6 причал
//   cell_x(g, c), cell_z(g, r) — центр клетки в 3D (y = 0 — земля, клетка = 1.0)
//   g.towers                — башни: kind (0 лучник, 1 пушка, 2 мороз, 3 молния), lvl 1–3, col, row,
//                             aim (куда повёрнута, градусы), flash (вспышка выстрела 1 → 0)
//   g.enemies               — враги: kind (0 краб, 1 пират, 2 черепаха, 3 чайка, 4 капитан),
//                             x, y, z, yaw (куда смотрит), hp / max_hp, hit (мигание 1 → 0), slow (> 0 — замёрз)
//   g.shots                 — снаряды: kind, x, y, z
//   g.fx                    — вспышки: kind (0 взрыв, 1 удар, 2 молния от x,y,z до x2,y2,z2, 3 монетка,
//                             4 лёд, 5 дым стройки), x, y, z, age / life (0 → 1 — сколько прожила)
//   g.hov_c, g.hov_r        — клетка под мышью (−1 — нет), g.pick — какую башню строим (−1 — никакую)
//   g.sel                   — выбранная башня (номер в g.towers), stats(t).range — её дальность
//   t                       — секунды с начала игры (для воды, мигания и всего, что двигается само)
//
// Слова для 3D: mesh_new(), mesh_add(m, ...), draw_mesh(m, x, y, z, поворот),
// draw_mesh_rot(...), camera(...), sunlight(...), fog(...), shadows(...), point_light(...),
// и готовые модели: use model → model.load("башня.glb"). Примеры: examples/apps/playground, football.
use data
use logic

// 3D готово?
modpub func ready()
    return false

// один раз после window_open: сделать сетки, загрузить модели, поставить свет
modpub func setup(g: Game)
    place_camera(g)

// камера: сверху наискосок на весь остров. Можно двигать — мышь всё равно попадёт в нужную клетку
modpub func place_camera(g: Game)
    g.cam.x = 0.0
    g.cam.y = g.h * 1.05
    g.cam.z = g.h * 0.95
    g.cam.lx = 0.0
    g.cam.ly = 0.0
    g.cam.lz = 0.4

// каждый кадр: весь мир
modpub func draw_world(g: Game, t: dec)
    c = g.cam
    camera(c.x, c.y, c.z, c.lx, c.ly, c.lz)
    draw_island(g, t)
    each tw in g.towers
        draw_tower(g, tw, t)
    each e in g.enemies
        draw_enemy(g, e, t)
    each s in g.shots
        draw_shot(g, s, t)
    each f in g.fx
        draw_fx(g, f, t)
    draw_hover(g, t)

// море, песок, трава, тропа, скалы, крепость, причал
func draw_island(g: Game, t: dec)
    return

// башня: g.towers[i] — вид kind, уровень lvl, поворот aim
func draw_tower(g: Game, tw: Tower, t: dec)
    return

// враг: вид kind, место x y z, поворот yaw, полоска жизни hp / max_hp
func draw_enemy(g: Game, e: Enemy, t: dec)
    return

// стрела, ядро, ледышка
func draw_shot(g: Game, s: Shot, t: dec)
    return

// взрывы, искры, монетки
func draw_fx(g: Game, f: Fx, t: dec)
    return

// подсветка клетки под мышью: зелёная — можно строить, красная — нельзя; круг дальности
func draw_hover(g: Game, t: dec)
    return
