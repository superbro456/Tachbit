// «Остров-защита» — 3D защита острова от пиратов.
//   data.tb    — данные (что хранится)
//   logic.tb   — правила (что происходит)
//   view3d.tb  — вывод в 3D (рисует остров)      view2d.tb — временный вид сверху
//   ui.tbs     — интерфейс (меню, счёт, кнопки)
//   main.tb    — этот файл: соединяет всё в цикл «ввод → правила → вывод»
//
// Запуск: tb run examples/apps/island/main.tb
use ui
use view
use data
use logic
use view3d
use view2d

func main()
    window_sharp()
    try window_open(1180, 720, "Остров-защита")
    u = ui.start()
    v = view.file(here() + "ui.tbs")
    g = new_game(to_int(env("ISLAND_LEVEL")) or 0)
    view3d.setup(g)
    page = "menu"
    if env("ISLAND_PAGE") != ""
        page = env("ISLAND_PAGE")
    t = 0.0
    was_down = false
    keys = dict text bool
    demo = env("ISLAND_DEMO") == "1"
    frames = 0
    ended = 0
    repeat while window_alive()
        dt = frame_ms() / 1000.0
        t += dt
        frames += 1
        ui.frame(u)
        clear_window(rgb(20, 70, 110))
        sw = window_w()
        sh = window_h()
        // место острова на экране (без панели справа и полосы сверху)
        right = ui.px(u, 272)
        top = ui.px(u, 70)
        ax = 0
        ay = top
        aw = sw - right
        ah = sh - top
        if page != "hud"
            ax = 0
            ay = 0
            aw = sw
            ah = sh
        // ---- ввод: клетка под мышью ----
        mx = mouse_x()
        my = mouse_y()
        g.hov_c = -1
        g.hov_r = -1
        on_map = page == "hud" and mx < aw and my > top
        if on_map
            if view3d.ready()
                g.hov_c, g.hov_r = mouse_cell(g, mx, my, sw, sh)
            else
                g.hov_c, g.hov_r = view2d.cell_under(g, mx, my, ax, ay, aw, ah)
        down = mouse_down()
        if down and not was_down and on_map and g.hov_c >= 0
            click_cell(g, g.hov_c, g.hov_r)
        was_down = down
        if page == "hud"
            keys_in(g, keys)
            if pressed_key(keys, "escape")
                g.paused = true
                page = "pause"
        else if page == "pause" and pressed_key(keys, "escape")
            g.paused = false
            page = "hud"
        if demo and page == "hud"
            autoplay(g, frames)
            g.speed = 2
        // ---- правила ----
        if page == "hud"
            update(g, dt)
            sounds(g)
            if g.state == "won" or g.state == "lost"
                page = "end"
        // ---- вывод ----
        if view3d.ready()
            view3d.draw_world(g, t)
        else
            view2d.draw_world(u, g, t, ax, ay, aw, ah)
        fill_hud(v, g)
        fill_end(v, g)
        view.screen(u, v, page)
        // ---- кнопки интерфейса ----
        if page == "menu"
            count n from 0 to 2
                if view.pressed(v, "lv" + n)
                    g = new_game(n)
                    view3d.setup(g)
                    page = "hud"
            if view.pressed(v, "help")
                page = "help"
            if view.pressed(v, "quit")
                exit(0)
        else if page == "help"
            if view.pressed(v, "back")
                page = "menu"
        else if page == "hud"
            count k from 0 to tower_count() - 1
                if view.pressed(v, "t" + k)
                    choose(g, k)
            if view.pressed(v, "go")
                start_wave(g)
            if view.pressed(v, "up")
                ok = upgrade(g, g.sel)
            if view.pressed(v, "sell")
                sell(g, g.sel)
            if view.pressed(v, "speed")
                g.speed = 3 - g.speed
            if view.pressed(v, "pause")
                g.paused = true
                page = "pause"
        else if page == "pause"
            if view.pressed(v, "resume")
                g.paused = false
                page = "hud"
            if view.pressed(v, "restart")
                g = new_game(g.level)
                view3d.setup(g)
                page = "hud"
            if view.pressed(v, "tomenu")
                page = "menu"
        else if page == "end"
            if view.pressed(v, "again")
                g = new_game(g.level)
                view3d.setup(g)
                page = "hud"
            if view.pressed(v, "next") and g.level + 1 < level_count()
                g = new_game(g.level + 1)
                view3d.setup(g)
                page = "hud"
            if view.pressed(v, "tomenu2")
                page = "menu"
        ui.end_frame(u)
        if page == "end"
            ended += 1
        if demo and (frames >= 20000 or ended > 180)
            print(g.name + ": " + g.state + ", волна " + (g.wave + 1) + " / " + len(g.waves) + ", жизни " + g.lives + ", счёт " + g.score + ", башен " + len(g.towers) + ", кадров " + frames)
            exit(0)

// папка этой игры (чтобы ui.tbs нашёлся, откуда ни запускай)
func here()
    a = args()
    if len(a) > 0
        p = a[0]
        k = len(p) - 1
        repeat while k >= 0
            if p[k] == "/"
                return cut(p, 0, k)
            k -= 1
    if file_exists("ui.tbs")
        return ""
    return "examples/apps/island/"

func choose(g: Game, k: int)
    if g.pick == k
        g.pick = -1
    else
        g.pick = k
        g.sel = -1

// клавиши: 1–4 башня, пробел волна, F скорость, U улучшить, Delete продать, Esc пауза
func keys_in(g: Game, keys: dict text bool)
    count k from 0 to tower_count() - 1
        if pressed_key(keys, "" + (k + 1))
            choose(g, k)
    if pressed_key(keys, "space")
        start_wave(g)
    if pressed_key(keys, "f")
        g.speed = 3 - g.speed
    if pressed_key(keys, "u")
        ok = upgrade(g, g.sel)
    if pressed_key(keys, "x")
        sell(g, g.sel)

// клавишу нажали только что (а не держат)
func pressed_key(keys: dict text bool, name: text)
    now = key_down(name)
    before = keys.has(name) and keys[name]
    keys[name] = now
    return now and not before

// числа и кнопки на экране игры
func fill_hud(v: TbsView, g: Game)
    view.put_prop(v, "level", "text", g.name)
    view.put_prop(v, "money", "text", "Монеты " + g.money)
    view.put_prop(v, "lives", "text", "Жизни " + g.lives + " / " + g.max_lives)
    view.put_prop(v, "wave", "text", "Волна " + (g.wave + 1) + " / " + len(g.waves))
    view.put_prop(v, "score", "text", "Счёт " + g.score)
    count k from 0 to tower_count() - 1
        info = tower_info(k)
        id = "t" + k
        view.put_prop(v, id, "text", "" + (k + 1) + "  " + info.name + " · " + info.price)
        if g.pick == k
            view.put_prop(v, id, "style", "picked")
        else
            view.put_prop(v, id, "style", "")
        if g.money < info.price
            view.put_prop(v, id, "opacity", "45%")
        else
            view.put_prop(v, id, "opacity", "")
    has_sel = g.sel >= 0 and g.sel < len(g.towers)
    view.show_item(v, "up", has_sel)
    view.show_item(v, "sell", has_sel)
    if has_sel
        tw = g.towers[g.sel]
        st = stats(tw)
        view.put_prop(v, "info", "text", st.name + ", уровень " + tw.lvl + ". Урон " + round(st.dmg) + ", дальность " + round(st.range * 10.0) / 10.0 + ", выстрелов в секунду " + round(st.rate * 10.0) / 10.0 + ".")
        if tw.lvl < 3
            view.put_prop(v, "up", "text", "Улучшить · " + upgrade_price(tw.kind, tw.lvl + 1))
            view.put_prop(v, "up", "disabled", "")
        else
            view.put_prop(v, "up", "text", "Уровень 3 — максимум")
            view.put_prop(v, "up", "disabled", "yes")
        view.put_prop(v, "sell", "text", "Продать · " + tw.spent * 7 / 10)
    else if g.pick >= 0
        info = tower_info(g.pick)
        view.put_prop(v, "info", "text", info.name + ": " + info.about + ". Нажми на песок или траву.")
    else
        view.put_prop(v, "info", "text", "Выбери башню и нажми на песок или траву. Нажми на башню, чтобы улучшить.")
    if g.state == "wave"
        view.put_prop(v, "go", "text", "Идёт волна…")
        view.put_prop(v, "go", "disabled", "yes")
    else
        view.put_prop(v, "go", "text", "Волна " + (g.wave + 2) + "  ▶")
        view.put_prop(v, "go", "disabled", "")
    view.put_prop(v, "speed", "text", "Скорость ×" + g.speed)

func fill_end(v: TbsView, g: Game)
    if g.state == "won"
        view.put_prop(v, "etitle", "text", "Остров спасён!")
    else
        view.put_prop(v, "etitle", "text", "Крепость пала")
    view.put_prop(v, "escore", "text", "Счёт " + g.score + "   врагов " + g.kills)
    view.put_prop(v, "ebest", "text", "Рекорд острова " + max(g.best, g.score))
    view.show_item(v, "next", g.state == "won" and g.level + 1 < level_count())

// звуки по событиям кадра (простые тоны, без файлов)
func sounds(g: Game)
    shot = false
    each e in g.events
        hz = 0
        ms = 0
        if starts_with(e, "shot")
            if shot
                skip
            shot = true
            hz = 900
            ms = 25
            if e == "shot1"
                hz = 150
                ms = 90
            else if e == "shot2"
                hz = 1300
                ms = 35
            else if e == "shot3"
                hz = 1700
                ms = 45
        else if e == "boom"
            hz = 90
            ms = 160
        else if e == "kill"
            hz = 660
            ms = 50
        else if e == "base"
            hz = 220
            ms = 220
        else if e == "build" or e == "upgrade"
            hz = 520
            ms = 90
        else if e == "sell"
            hz = 400
            ms = 80
        else if e == "no"
            hz = 140
            ms = 90
        else if e == "wave"
            hz = 440
            ms = 160
        else if e == "wave_done"
            hz = 700
            ms = 200
        else if e == "won"
            hz = 990
            ms = 400
        else if e == "lost"
            hz = 110
            ms = 500
        if hz > 0
            voice = play_tone(hz + 0.0, ms)

// ISLAND_DEMO=1: игра играет сама (для проверки и скриншотов)
func autoplay(g: Game, frame: int)
    if g.state == "build" and frame % 30 == 0
        // ставим башни у тропы, пока есть деньги
        k = (len(g.towers) + g.wave) % tower_count()
        if g.money >= tower_info(k).price
            each i in [3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43]
                if i < len(g.path_c)
                    c = g.path_c[i]
                    r = g.path_r[i]
                    count d from 0 to 3
                        nc = c + 1
                        nr = r
                        if d == 1
                            nc = c - 1
                        else if d == 2
                            nc = c
                            nr = r + 1
                        else if d == 3
                            nc = c
                            nr = r - 1
                        if can_build(g, nc, nr) and g.money >= tower_info(k).price
                            ok = build(g, k, nc, nr)
                            return
        else
            start_wave(g)
