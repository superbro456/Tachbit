// игра от первого лица (1.3): мышь поворачивает взгляд, WASD — ходить, F — полный экран, Esc — отпустить мышь.
// Щелчок по окну снова захватывает мышь.
//   tb run examples/basics/look_around.tb
use anim

func main()
    try window_open(900, 600, "Смотреть вокруг")
    box = mesh_new()
    add_box(box)
    floor = mesh_new()
    mesh_add(floor, -40, 0, -40, -40, 0, 40, 40, 0, 40, rgb(70, 110, 70))
    mesh_add(floor, -40, 0, -40, 40, 0, 40, 40, 0, -40, rgb(70, 110, 70))
    sunlight(0.4, 1, -0.5, 0.35)
    x = 0.0
    z = -8.0
    yaw = 0.0
    pitch = 0.0
    full = false
    mouse_lock(true)
    locked = true
    repeat while window_alive()
        dt = frame_ms() / 1000
        if key_down("escape") and locked
            mouse_lock(false)
            locked = false
        if mouse_down() and not locked
            mouse_lock(true)
            locked = true
        if key_down("f")
            full = not full
            window_fullscreen(full)
            wait_ms(200)
        // поворот головы: мышь вправо — смотрим правее, мышь вниз — ниже
        yaw += mouse_dx() * 0.15
        pitch = max(-80.0, min(80.0, pitch - mouse_dy() * 0.15))
        fx = anim.sin_deg(yaw)
        fz = anim.cos_deg(yaw)
        speed = 6 * dt
        if key_down("w")
            x += fx * speed
            z += fz * speed
        if key_down("s")
            x -= fx * speed
            z -= fz * speed
        if key_down("d")
            x += fz * speed
            z -= fx * speed
        if key_down("a")
            x -= fz * speed
            z += fx * speed
        up = anim.sin_deg(pitch)
        flat = anim.cos_deg(pitch)
        camera(x, 1.7, z, x + fx * flat, 1.7 + up, z + fz * flat)
        clear_window(rgb(150, 190, 230))
        draw_mesh(floor, 0, 0, 0, 0)
        count i from 0 to 24
            draw_mesh(box, (i % 5) * 6 - 12, 1, (i / 5) * 6, i * 15)
        // прицел
        draw_rect(window_w() / 2 - 1, window_h() / 2 - 8, 2, 16, rgb(255, 255, 255))
        draw_rect(window_w() / 2 - 8, window_h() / 2 - 1, 16, 2, rgb(255, 255, 255))

func add_box(m: int)
    c = rgb(200, 150, 90)
    quad(m, -1, 0, -1, -1, 2, -1, 1, 2, -1, 1, 0, -1, c)
    quad(m, -1, 0, 1, 1, 0, 1, 1, 2, 1, -1, 2, 1, c)
    quad(m, -1, 0, -1, -1, 0, 1, -1, 2, 1, -1, 2, -1, c)
    quad(m, 1, 0, -1, 1, 2, -1, 1, 2, 1, 1, 0, 1, c)
    quad(m, -1, 2, -1, -1, 2, 1, 1, 2, 1, 1, 2, -1, c)

func quad(m: int, x1: dec, y1: dec, z1: dec, x2: dec, y2: dec, z2: dec, x3: dec, y3: dec, z3: dec, x4: dec, y4: dec, z4: dec, c: int)
    mesh_add(m, x1, y1, z1, x2, y2, z2, x3, y3, z3, c)
    mesh_add(m, x1, y1, z1, x3, y3, z3, x4, y4, z4, c)
