// два настоящих окна (1.3): главное — список друзей, щелчок по другу открывает отдельное окно чата.
// Окно чата можно отодвинуть в сторону и закрыть крестиком; главное окно живёт дальше.
//   tb run examples/basics/two_windows.tb
func main()
    try window_open(320, 360, "Друзья")
    friends = ["Азиз", "Мадина", "Тимур", "Айгерим"]
    chat = -1
    who = ""
    lines = [""]
    lines.clear()
    typing = ""
    repeat while window_alive()
        // главное окно: список
        clear_window(rgb(24, 28, 40))
        draw_text(16, 14, "Друзья", 2, rgb(235, 235, 245))
        count i from 0 to len(friends) - 1
            y = 60 + i * 44
            over = mouse_x() < 300 and mouse_y() >= y and mouse_y() < y + 36
            back = rgb(36, 42, 60)
            if over
                back = rgb(60, 70, 100)
            draw_rect(10, y, 300, 36, back)
            draw_text(24, y + 10, friends[i], 1, rgb(230, 230, 240))
            if over and mouse_down() and (chat < 0 or not window_shown(chat) or who != friends[i])
                if chat >= 0
                    window_close(chat)
                chat = try window_new(360, 260, "Чат: " + friends[i])
                who = friends[i]
                lines.clear()
                typing = ""
        if chat >= 0 and window_shown(chat)
            // окно чата: свои мышь и клавиши
            window_use(chat)
            clear_window(rgb(250, 250, 252))
            draw_text(12, 10, who, 2, rgb(30, 30, 40))
            typing += typed_text()
            if key_down("backspace") and len(typing) > 0
                typing = cut(typing, 0, len(typing) - 1)
            if key_down("enter") and typing != ""
                lines.add(typing)
                typing = ""
            y = 50
            each line in lines
                draw_text(12, y, "я: " + line, 1, rgb(40, 40, 60))
                y += 20
            draw_rect(10, window_h() - 40, window_w() - 20, 30, rgb(230, 232, 240))
            draw_text(18, window_h() - 32, typing + "_", 1, rgb(20, 20, 30))
