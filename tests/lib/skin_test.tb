// lib/model: кости и анимации glTF (skin): имена, длина, суставы в позе
use model

func r2(v: dec) gives s: text
    s = "" + round(v * 100) / 100.0

func show_joint(md: Model, name: text)
    x, y, z = model.joint(md, name)
    print(name + ":", r2(x), r2(y), r2(z))

func main()
    md = try model.load("tests/lib/models/walker.glb")
    print("треугольников:", model.triangles(md), "костей:", md.bones, "кусков:", len(md.parts))
    print("кости:", join(model.joints(md), " "))
    print("анимации:", join(model.animations(md), " "))
    each a in model.animations(md)
        print(a, "секунд:", r2(model.anim_length(md, a)))
    model.fit(md, 1.8)
    w, h, d = model.size(md)
    print("размер:", r2(w), r2(h), r2(d))
    model.build(md)
    model.play(md, "walk", 0.0)
    show_joint(md, "shin_l")
    show_joint(md, "fore_r")
    model.play(md, "walk", 0.25)
    show_joint(md, "shin_l")
    show_joint(md, "shin_r")
    model.play(md, "walk", 1.25)
    show_joint(md, "shin_l")
    model.play(md, "wave", 0.5)
    show_joint(md, "fore_r")
    show_joint(md, "head")
    model.play(md, "нет такой", 0.5)
    show_joint(md, "fore_r")
