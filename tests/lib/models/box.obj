# куб 2x2x2 из Blender, грани четырёхугольниками
mtllib box.mtl
o Cube
v 1.0 1.0 -1.0
v 1.0 -1.0 -1.0
v 1.0 1.0 1.0
v 1.0 -1.0 1.0
v -1.0 1.0 -1.0
v -1.0 -1.0 -1.0
v -1.0 1.0 1.0
v -1.0 -1.0 1.0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 1 0
usemtl Red
f 1/1/1 5/2/1 7/3/1 3/4/1
f 4/1 3/2 7/3 8/4
f 8//1 7//1 5//1 6//1
usemtl Blue
f 6 2 4 8
f 2 1 3 4
f -3 -7 -8 -4
