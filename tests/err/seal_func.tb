// 0.7: список номеров ушёл в функцию — «пломба» сорвана, проверка остаётся
func spoil(a: list int)
    a.add(50)

func main()
    xs = list int
    repeat 10 times
        xs.add(0)
    idx = list int
    count i from 0 to 9
        idx.add(i)
    spoil(idx)
    s = 0
    count i from 0 to 10
        s += xs[idx[i]]
    print(s)
