// треугольники: по и против часовой, тонкие, плоские, огромные, за краями, веер с общими сторонами.
// TB_GPU_CHECK=1 (tests/run_gpu.sh) сверяет каждый кадр видеокарты с процессором точка в точку
func main()
    try window_open(320, 200, "GPU треугольники")
    frame = 0
    seed = 7
    repeat while window_alive()
        frame += 1
        if frame > 40
            stop
        clear_window(rgb(10, 12, 20))
        // веер вокруг центра: соседние треугольники делят сторону
        n = 24
        count k from 0 to n - 1
            a = (k + frame * 0.1) * 6.2831853 / n
            b = (k + 1 + frame * 0.1) * 6.2831853 / n
            x1 = 160 + round(90 * cos_t(a))
            y1 = 100 + round(90 * sin_t(a))
            x2 = 160 + round(90 * cos_t(b))
            y2 = 100 + round(90 * sin_t(b))
            draw_triangle(160, 100, x1, y1, x2, y2, rgb(k * 10, 255 - k * 10, 120 + k % 2 * 100))
        // по часовой и против — одинаково
        draw_triangle(10, 10, 60, 15, 20, 70, rgb(250, 80, 80))
        draw_triangle(70, 10, 80, 70, 120, 15, rgb(80, 250, 80))
        // тонкие и плоские
        draw_triangle(0, 180, 319, 181, 0, 182, rgb(255, 255, 0))
        draw_triangle(5, 5, 5, 50, 5, 90, rgb(255, 0, 255))
        draw_triangle(30, 30, 30, 30, 30, 30, rgb(255, 0, 255))
        // за краями и огромные (углы дальше 8192 обрезаются)
        draw_triangle(-100, -100, 400, -50, 300 - frame * 5, 60, rgb(60, 60, 200))
        draw_triangle(-20000, 199, 20000, 199, 0, -30000, rgb(40, 40, 40))
        draw_triangle(400, 10, 500, 10, 450, 100, rgb(255, 255, 255))
        // случайные
        count k from 0 to 30
            seed = (seed * 1103515245 + 12345) % 2147483648
            x = seed % 360 - 20
            seed = (seed * 1103515245 + 12345) % 2147483648
            y = seed % 240 - 20
            seed = (seed * 1103515245 + 12345) % 2147483648
            draw_triangle(x, y, x + seed % 50 - 25, y + seed % 37, x + seed % 23, y - seed % 29, rgb(seed % 256, 128, 255 - seed % 256))
    print("кадров:", frame)

// синус и косинус без новых слов: ряд Тейлора (точности для картинки хватает)
func sin_t(x: dec)
    repeat while x > 3.14159265
        x -= 6.2831853
    repeat while x < -3.14159265
        x += 6.2831853
    x2 = x * x
    return x * (1 - x2 / 6 * (1 - x2 / 20 * (1 - x2 / 42 * (1 - x2 / 72 * (1 - x2 / 110)))))

func cos_t(x: dec)
    return sin_t(x + 1.57079633)
