// проверка рисования на видеокарте: все фигуры, края окна, большие и маленькие размеры.
// Запуск: tests/run_gpu.sh (TB_GPU_CHECK=1 сверяет каждый кадр с процессором точка в точку)
func main()
    try window_open(320, 200, "GPU проверка")
    frame = 0
    repeat while window_alive()
        frame += 1
        if frame > 40
            stop
        if frame % 7 != 3
            clear_window(rgb(10, 12, 20 + frame))
        // прямоугольники: внутри, за краями, нулевые и отрицательные
        draw_rect(-20, -10, 60, 40, rgb(200, 40, 40))
        draw_rect(300, 180, 100, 100, rgb(40, 200, 40))
        draw_rect(50, 50, 0, 10, rgb(255, 255, 255))
        draw_rect(60, 60, -5, 10, rgb(255, 255, 255))
        draw_rect(frame * 3, 20, 17, 9, rgb(90, 140, 250))
        // круги: точка, маленькие, у края, огромный
        draw_circle(100, 100, 0, rgb(255, 255, 0))
        draw_circle(120, 100, 1, rgb(255, 200, 0))
        draw_circle(140, 100, 2, rgb(255, 150, 0))
        draw_circle(170, 100, 9, rgb(255, 100, 0))
        draw_circle(0, 199, 25, rgb(0, 200, 200))
        draw_circle(160 + frame, 90, 33, rgb(120, 60, 200))
        draw_circle(-30000, 100, 30100, rgb(30, 30, 60))
        draw_circle(160, 100, -3, rgb(255, 0, 0))
        // линии во все стороны и точки
        count k from 0 to 15
            draw_line(160, 100, 160 + (k - 8) * 25, 100 + (k % 5 - 2) * 60, rgb(k * 16, 255 - k * 16, 128))
        draw_line(-50, -50, 400, 300, rgb(250, 250, 250))
        draw_line(5, 190, 5, 190, rgb(1, 2, 3))
        count x from 0 to 99
            draw_pixel(x * 3 + frame % 3, 150 + x % 4, rgb(x * 2, 100, 200))
        draw_pixel(-1, 5, rgb(255, 0, 0))
        draw_pixel(320, 5, rgb(255, 0, 0))
        // текст: разные размеры, русские буквы, перевод строки, за краем
        draw_text(4, 4, "Привет, Tachbit! 0123", 1, rgb(244, 243, 239))
        draw_text(10, 120, "GPU\nЁжик", 2, rgb(79, 179, 172))
        draw_text(250 - frame * 4, 170, "бегущая строка", 1, rgb(255, 210, 90))
        draw_text(-40, 60, "ABC", 5, rgb(200, 90, 160))
        draw_text(200, 30, "x", 0, rgb(255, 255, 255))
        // цвет с лишними битами: видны только младшие 24
        draw_rect(290, 0, 30, 10, 16777216 * 3 + rgb(10, 20, 30))
