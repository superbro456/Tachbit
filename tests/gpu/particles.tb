// Частицы на видеокарте (1.3): shaders.particles — шейдер углов spray и точек spray_color, прозрачная
// сетка не пишет глубину. Кадры со своими шейдерами TB_GPU_CHECK не сверяет — тест ловит падения и ошибки видеокарты
use shaders

func main()
    a = args()
    hold = len(a) > 0 and a[len(a) - 1] == "hold"
    try window_open(320, 200, "частицы")
    kinds = ["fire", "smoke", "sparks", "fountain", "snow", ""]
    ms = list int
    each k in kinds
        ms.add(shaders.particles(300, k))
    shader_set(ms[5], "life", 2)
    shader_set(ms[5], "speed", 1)
    shader_set(ms[5], "r0", 1)
    floor = mesh_new()
    mesh_add(floor, -4, 0, -2, -4, 0, 4, 4, 0, 4, rgb(60, 70, 80))
    mesh_add(floor, -4, 0, -2, 4, 0, 4, 4, 0, -2, rgb(60, 70, 80))
    frames = 0
    repeat while window_alive() and (hold or frames < 20)
        frames += 1
        if frames % 2 == 0
            shadows(10)
        else
            shadows(0)
        sunlight(0.4, 0.8, -0.3, 0.3)
        clear_window(rgb(20, 24, 34))
        camera(0, 2, -6, 0, 1, 0)
        draw_mesh(floor, 0, 0, 0, 0)
        count i from 0 to 5
            draw_mesh_rot(ms[i], -2.5 + i, 0, 1, i * 10, 0, i * 5)
        if frames % 5 == 0
            screen_shader("glow")
    print("кадров: " + frames)
