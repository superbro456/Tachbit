// шрифты TTF: load_font, draw_font, text_width; сглаженные буквы видеокарта и процессор рисуют одинаково
func main()
    try window_open(640, 360, "GPU: шрифты")
    paths = ["/System/Library/Fonts/SFNS.ttf", "/System/Library/Fonts/Helvetica.ttc", "/System/Library/Fonts/Supplemental/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc", "C:/Windows/Fonts/segoeui.ttf"]
    fonts = list int
    each p in paths
        if file_exists(p)
            got = load_font(p) else err
                print("не прочитался " + p + ": " + err)
                skip
            fonts.add(got)
    if len(fonts) == 0
        print("нет ни одного шрифта из списка")
        exit(1)
    frames = 0
    repeat while window_alive() and frames < 6
        clear_window(rgb(22, 23, 29))
        draw_rect(0, 240, 640, 120, rgb(240, 240, 235))
        y = 10
        each f in fonts
            draw_font(f, 10, y, "Привет, мир! Ёжик ёлка · Tachbit 0123", 15, rgb(232, 232, 238))
            y += 24
        f0 = fonts[0]
        draw_font(f0, 10, y + 10, "Крупно", 56, rgb(47, 209, 191))
        w = text_width(f0, "Крупно", 56)
        draw_rect(10, y + 84, w, 2, rgb(255, 100, 100))
        draw_font(f0, 10 + w + 20, y + 30, "две\nстроки", 18, rgb(255, 255, 255))
        draw_font(f0, 10, 250, "Тёмный текст на светлом фоне", 16, rgb(30, 30, 40))
        draw_font(f0, -20, 300, "край окна слева и справа  край окна слева и справа  край окна", 20, rgb(200, 60, 60))
        frames += 1
