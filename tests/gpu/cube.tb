// 3D: кубы и пол, камера ходит по кругу, близко и даже сквозь куб (обрезка ближе 0.05).
// TB_GPU_CHECK=1 (tests/run_gpu.sh) сверяет кадр видеокарты с процессором точка в точку
func main()
    try window_open(320, 200, "GPU куб")
    cube = mesh_new()
    add_cube(cube, 1.0)
    floor = mesh_new()
    count i from -5 to 4
        count j from -5 to 4
            c = rgb(60, 60, 70)
            if (i + j) % 2 == 0
                c = rgb(90, 90, 100)
            mesh_add(floor, i, -1, j, i + 1, -1, j, i + 1, -1, j + 1, c)
            mesh_add(floor, i, -1, j, i + 1, -1, j + 1, i, -1, j + 1, c)
    // большая волнистая сетка: 80 000 треугольников — больше одной пачки (65 536), проверка перехода
    hills = mesh_new()
    count i from 0 to 199
        count j from 0 to 199
            x = i * 0.1 - 10
            z = j * 0.1 - 10
            c = rgb(40 + i, 100 + j % 100, 60)
            mesh_add(hills, x, wave(i, j), z, x + 0.1, wave(i + 1, j), z, x + 0.1, wave(i + 1, j + 1), z + 0.1, c)
            mesh_add(hills, x, wave(i, j), z, x + 0.1, wave(i + 1, j + 1), z + 0.1, x, wave(i, j + 1), z + 0.1, rgb(60, 100 + i % 100, 40 + j))
    frame = 0
    repeat while window_alive()
        frame += 1
        if frame > 60
            stop
        clear_window(rgb(16, 18, 28))
        a = frame * 0.11
        r = 6.0 - frame * 0.09
        camera(r * cos_t(a), 1.5, r * sin_t(a), 0, 0, 0)
        draw_mesh(floor, 0, 0, 0, 0)
        if frame % 3 == 0
            draw_mesh(hills, 0, -1.5, 0, frame)
        draw_mesh(cube, 0, 0, 0, frame * 6)
        draw_mesh(cube, 2.5, 0, 1, -frame * 3)
        draw_mesh(cube, -2, 0.5, -2, 45)
        draw_text(4, 4, "кадр " + frame, 1, rgb(255, 255, 255))
        // ещё 3D после 2D — снова рисуется поверх
        draw_mesh(cube, 0, 2.2, 0, frame)
    print("кадров:", frame)

// куб со стороной 2*h: 6 граней по 2 треугольника, у каждой грани свой цвет
func add_cube(m: int, h: dec)
    face(m, -h, -h, -h, h, -h, -h, h, h, -h, -h, h, -h, rgb(230, 80, 80))
    face(m, -h, -h, h, h, -h, h, h, h, h, -h, h, h, rgb(80, 200, 120))
    face(m, -h, -h, -h, -h, h, -h, -h, h, h, -h, -h, h, rgb(80, 130, 230))
    face(m, h, -h, -h, h, h, -h, h, h, h, h, -h, h, rgb(240, 200, 70))
    face(m, -h, h, -h, h, h, -h, h, h, h, -h, h, h, rgb(200, 90, 200))
    face(m, -h, -h, -h, h, -h, -h, h, -h, h, -h, -h, h, rgb(70, 200, 210))

func face(m: int, x1: dec, y1: dec, z1: dec, x2: dec, y2: dec, z2: dec, x3: dec, y3: dec, z3: dec, x4: dec, y4: dec, z4: dec, c: int)
    mesh_add(m, x1, y1, z1, x2, y2, z2, x3, y3, z3, c)
    mesh_add(m, x1, y1, z1, x3, y3, z3, x4, y4, z4, c)

func wave(i: int, j: int)
    return sin_t(i * 0.2) * 0.3 + sin_t(j * 0.15) * 0.3

func sin_t(x: dec)
    repeat while x > 3.14159265
        x -= 6.2831853
    repeat while x < -3.14159265
        x += 6.2831853
    x2 = x * x
    return x * (1 - x2 / 6 * (1 - x2 / 20 * (1 - x2 / 42 * (1 - x2 / 72 * (1 - x2 / 110)))))

func cos_t(x: dec)
    return sin_t(x + 1.57079633)
