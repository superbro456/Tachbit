// Материалы из .glb (1.3): model.build сам ставит pbr с картами (цвет, нормали, металл+шероховатость),
// свечение и прозрачность; model.shader(md, "plain") / "" — туда и обратно. Ловит падения и ошибки видеокарты
use model

func main()
    a = args()
    hold = len(a) > 0 and a[len(a) - 1] == "hold"
    try window_open(320, 200, "материалы")
    md = try model.load("tests/lib/models/shelf.glb")
    model.build(md)
    frames = 0
    repeat while window_alive() and (hold or frames < 12)
        frames += 1
        if frames == 5
            model.shader(md, "plain")
        if frames == 8
            model.shader(md, "")
        sunlight(0.5, 0.8, -0.4, 0.3)
        point_light(0, 1, 1.5, -1, rgb(255, 220, 180), 5)
        clear_window(rgb(30, 34, 44))
        camera(0, 3, -6, 0, 0.5, 0)
        model.draw(md, 0, 0, 0, 0, 0, 0)
    print("кадров: " + frames)
