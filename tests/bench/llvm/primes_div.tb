// простые числа делением (без списков): остатки и ранний выход
func is_prime(n: int)
    if n < 2
        return false
    d = 2
    repeat while d * d <= n
        if n % d == 0
            return false
        d += 1
    return true

func count_primes(limit: int)
    total = 0
    count n from 2 to limit
        if is_prime(n: n)
            total += 1
    return total

func main()
    print(count_primes(limit: 3000000))
