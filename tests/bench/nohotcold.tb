// То же, но все качества горячие: один раз читаем их в цикле,
// поэтому компилятор оставляет объект целым (как раньше).
obj User
    id: int
    balance: dec
    name: text
    city: text
    phone: text
    notes: text
    created: int
    vip: bool

func main()
    users = list User
    count i from 0 to 4999999
        users.add(User(id: i, balance: (i % 1000) / 10.0, name: "u", city: "Бишкек", phone: "+996", notes: "", created: 2026, vip: i % 50 == 0))
    total = 0.0
    repeat 20 times
        each u in users
            total += u.balance
    first = list User
    first.add(users[0])
    each u in first
        print(u.id, u.name, u.city, u.phone, u.notes, u.created, u.vip)
    print(total)
