// Сколько запятых в тексте на 35 МБ (1 млн строк вида 123,client5,45.10,7,Бишкек), 10 раз.
// Буква — это готовая строка из таблицы (без выделения памяти),
// а ch == "," сравнивает байты прямо, без strcmp.
func main()
    parts = list text
    count i from 0 to 999999
        parts.add("" + i + ",client" + (i % 99999) + ",45.10," + (i % 30) + ",Бишкек")
    s = join(parts, "\n")
    n = 0
    repeat 10 times
        each ch in s
            if ch == ","
                n += 1
    print(n)
