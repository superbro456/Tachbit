// Логика игры: 10 000 шариков, 200 кадров.
// Каждый кадр: движение, тяжесть, отскок от стен, сетка 125×125 и столкновения с соседями.
func cell_of(v: dec)
    c = round(v / 8.0 - 0.5)
    return max(0, min(c, 124))

func main()
    n = 10000
    g = 125
    xs = list dec
    ys = list dec
    vxs = list dec
    vys = list dec
    seed = 42
    repeat n times
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.add(0.0 + seed % 1000)
        seed = (seed * 1103515245 + 12345) % 2147483648
        ys.add(0.0 + seed % 1000)
        seed = (seed * 1103515245 + 12345) % 2147483648
        vxs.add((seed % 200 - 100) / 50.0)
        seed = (seed * 1103515245 + 12345) % 2147483648
        vys.add((seed % 200 - 100) / 50.0)

    counts = list int
    starts = list int
    repeat g * g times
        counts.add(0)
    repeat g * g + 1 times
        starts.add(0)
    order = list int
    cells = list int
    repeat n times
        order.add(0)
        cells.add(0)

    hits = 0
    repeat 200 times
        // движение
        count i from 0 to n - 1
            vys[i] += 0.05
            xs[i] += vxs[i]
            ys[i] += vys[i]
            if xs[i] < 0.0
                xs[i] = -xs[i]
                vxs[i] = -vxs[i]
            if xs[i] > 999.0
                xs[i] = 1998.0 - xs[i]
                vxs[i] = -vxs[i]
            if ys[i] < 0.0
                ys[i] = -ys[i]
                vys[i] = -vys[i]
            if ys[i] > 999.0
                ys[i] = 1998.0 - ys[i]
                vys[i] = -vys[i] * 0.9
        // сетка: сколько шариков в клетке, потом раскладка по клеткам
        count k from 0 to g * g - 1
            counts[k] = 0
        count i from 0 to n - 1
            c = cell_of(xs[i]) * g + cell_of(ys[i])
            cells[i] = c
            counts[c] += 1
        starts[0] = 0
        count k from 0 to g * g - 1
            starts[k + 1] = starts[k] + counts[k]
            counts[k] = starts[k]
        count i from 0 to n - 1
            order[counts[cells[i]]] = i
            counts[cells[i]] += 1
        // столкновения: только с соседями по сетке
        count i from 0 to n - 1
            cx = cells[i] / g
            cy = cells[i] % g
            count ax from max(cx - 1, 0) to min(cx + 1, g - 1)
                count ay from max(cy - 1, 0) to min(cy + 1, g - 1)
                    k = ax * g + ay
                    count p from starts[k] to starts[k + 1] - 1
                        j = order[p]
                        if j > i
                            dx = xs[i] - xs[j]
                            dy = ys[i] - ys[j]
                            if dx * dx + dy * dy < 16.0
                                hits += 1
                                // обменяться скоростями, как упругий удар
                                t = vxs[i]
                                vxs[i] = vxs[j]
                                vxs[j] = t
                                t = vys[i]
                                vys[i] = vys[j]
                                vys[j] = t
    sum = dec 0.0
    count i from 0 to n - 1
        sum += xs[i] + ys[i]
    print("столкновений:", hits, " сумма:", round(sum))
