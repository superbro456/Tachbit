// 0.7: папки — создать, посмотреть, переместить, удалить
func main()
    try make_folder("box")
    try make_folder("box/inner")
    try write_file("box/b.txt", "привет")
    try write_file("box/A.txt", "hi")
    names = try list_dir("box")
    print(join(names, " "))
    print(is_folder("box/inner"))
    print(is_folder("box/b.txt"))
    print(file_size("box/b.txt"))
    print(file_size("box/нет"))
    try move("box/b.txt", "box/inner/c.txt")
    names2 = try list_dir("box/inner")
    print(join(names2, " "))
    make_folder("box") else err
        print("ошибка: " + err)
    remove("box/inner") else err
        print("ошибка: " + err)
    try remove("box/inner/c.txt")
    try remove("box/inner")
    try remove("box/A.txt")
    try remove("box")
    print(file_exists("box"))
    print(len(env("HOME")) > 0)
    print(env("TB_NO_SUCH_VAR") == "")
