// 0.7: list bool хранится битами
obj Box
    flags: list bool

func flip(f: list bool)
    count i from 0 to len(f) - 1
        f[i] = not f[i]

func main()
    a = [true, false, true]
    print(a, len(a))
    count i from 1 to 70
        a.add(i % 3 == 0)
    print(len(a), a[3], a[5], a[72])
    x = a.pop()
    print(x, len(a))
    flip(a)
    n = 0
    each v in a
        if v
            n += 1
    print(n)
    b = Box()
    b.flags.add(true)
    b.flags.add(false)
    b.flags[1] = true
    print(b.flags)
    d = {1: true, 2: false}
    print(d.values())
    e = list bool
    print(e, len(e))
    count i from 0 to 199
        e.add(false)
    e[199] = true
    e[0] = true
    e[0] = false
    print(e[199], e[0], e[198])
    shared total = 0
    each v in e on all cores
        if v
            total += 1
    print(total)
    temp
        t = list bool
        repeat 1000 times
            t.add(true)
        print(len(t))

