// --llvm: obj by columns (без on all cores)
obj Point by columns
    x: dec
    y: dec
    name: text

func main()
    pts = list Point
    pts.add(Point(x: 1.5, y: 2.0, name: "a"))
    pts.add(Point(x: 3.0, y: 4.0, name: "b"))
    p = Point(x: 10.0, name: "c")
    pts.add(p)
    p.x = 99.0
    print(pts, len(pts))
    print(p)
    pts[0].y += 100.0
    q = pts[1]
    q.name = "B"
    pts[2] = Point(x: 7.0, y: 7.0, name: "z")
    total = 0.0
    each a in pts
        total += a.x
    print(total, pts)
    more = [Point(x: 1.0), Point(y: 2.0)]
    print(more)
    d = {"k": Point(x: 5.0)}
    print(d, d.values())
    empty = Point()
    print(empty)
    print(len(more), more[1].y, pts[2].name)
    flags = Flag(on: true, n: 3)
    flags.on = not flags.on
    print(flags)
    more_dicts()
    use_rows()
    call_c()

obj Flag by columns
    on: bool
    n: int

func more_dicts()
    d = {1: Flag(n: 5)}
    d[2] = Flag(on: true)
    d[1].n += 1
    print(d, d[1].n, d.values())

func dist2(p: Point, k: dec)
    return p.x * p.x * k + p.y * p.y

func far(pts: list Point) gives best: Point
    best = pts[0]
    each p in pts
        if dist2(p, 1.0) > dist2(best, 1.0)
            best = p

func pick(pts: list Point, i: int) gives p: Point, ok: bool
    if i < len(pts)
        p = pts[i]
        ok = true

func use_rows()
    pts = [Point(x: 1.0, y: 1.0), Point(x: 3.0, y: 4.0), Point(x: 2.0)]
    b = far(pts)
    print(b, dist2(b, 2.0))
    q, ok = pick(pts, 1)
    print(q.name, q.x, ok)
    q.name = "picked"
    print(pts[1])

// остаётся в C (on all cores), а зовут её из LLVM со строкой
func busy(p: Point) gives n: int
    shared s = int 0
    count i from 1 to 10 on all cores
        s += 1
    n = s
    if p.x > 2.0
        n += 100

func call_c()
    print(busy(Point(x: 3.0)), busy(Point(x: 1.0)))
