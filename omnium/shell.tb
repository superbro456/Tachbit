// Оболочка «Капля»: светлое небо с яркими облаками по краям, окна из матового стекла с «ушком»
// вместо заголовка, круглая капсула справа (часы, дата, сеть, питание, уведомления, тема), внизу —
// панель со значком, поиском и приложениями. Печатаешь — над панелью открывается меню.
// Шрифт Inter (лежит в ядре), сглаженные углы, мягкие тени, значки линиями.
// Оболочка — обычная клетка: danger ей не нужен. Время она спрашивает у службы часов,
// строки для «Терминала» получает из канала журнала.

use ofs
use exfat
use picture

obj Win
    app: text
    title: text
    x: int
    y: int
    w: int
    h: int
    hidden: bool
    born: int          // когда открыли (капля падает снизу)
    pic: int           // «Просмотр»: номер картинки + 1 (0 — нет)

obj Shell
    w: int
    h: int
    wins: list Win
    drag: int          // окно, которое тащат за ушко (-1 — никакое)
    dx: int
    dy: int
    query: text        // что напечатали в капле
    menu: bool         // меню капли раскрыто
    note: text         // текст «Заметок»
    note_on: bool      // печатают в «Заметки»
    log: list text     // строки «Терминала»
    down: bool
    dirty: bool
    clock: text
    date: text
    asked: int
    was_enter: bool
    was_esc: bool
    was_back: bool
    frames: int
    sky: int           // снимок фона (рисуется один раз)
    f: int             // шрифт Inter (-1 — нет, тогда свой 8×16)
    fb: int            // Inter SemiBold
    fs: Key            // ключ к файлам (OFS3)
    has_fs: bool
    note_save: int     // когда сохранить «Заметки» (0 — сохранено)
    fs_note: text      // что за файловая система (для «О системе»)
    fs_used: int
    fs_total: int
    usb: Key           // ключ к флешке (exFAT)
    has_usb: bool
    usb_note: text
    fs_files: list text    // для окна «Файлы»
    usb_files: list text
    place: text        // что открыто в «Файлах»: "ofs" или "usb"
    icon_names: list text  // значки-картинки (omnium/icons, гладкие края)
    icon_ids: list int

// ---------- стиль «Капли» ----------
func ink() gives c: int
    return rgb(30, 36, 50)
func dim() gives c: int
    return rgb(110, 118, 136)
func line_c() gives c: int
    return rgb(70, 78, 96)
func accent() gives c: int
    return rgb(56, 118, 250)
func glass() gives c: int
    return rgba(250, 251, 255, 196)
func dark_glass() gives c: int
    return rgba(34, 44, 60, 236)

modpub func apps() gives names: list text
    names = ["Терминал", "Заметки", "Файлы", "О системе", "Часы"]

// ---------- фигуры ----------
// стекло: то, что под ним, размывается, сверху — полупрозрачный цвет; углы сглажены
func frost(x: int, y: int, w: int, h: int, r: int, corners: text, c: int)
    // размываем «крестом»: углы за скруглением не трогаем, иначе вокруг стекла видно квадрат
    // середина целиком, у краёв — полосками по 6 строк, каждая уже по дуге
    blur_rect(x, y + r, w, h - 2 * r, 14)
    j = 0
    repeat while j < r
        dy = r - j * 1.0
        ins = r - round(sqrt(r * r * 1.0 - dy * dy)) + 1
        bh = min(6, r - j)
        blur_rect(x + ins, y + j, w - 2 * ins, bh, 14)
        blur_rect(x + ins, y + h - j - bh, w - 2 * ins, bh, 14)
        j += 6
    draw_round(x, y, w, h, r, corners, c)

// мягкая тень: слои всё шире и прозрачнее
func shadow(x: int, y: int, w: int, h: int, r: int, corners: text)
    draw_shadow(x, y + 10, w, h, r, 24, rgba(40, 50, 90, 40))

func rbox(x: int, y: int, w: int, h: int, r: int, c: int)
    draw_round(x, y, w, h, r, "all", c)

// линия толщиной 2 (иконки «линиями», как в макете)
func ln2(x1: int, y1: int, x2: int, y2: int, c: int)
    draw_line(x1, y1, x2, y2, c)
    dx = x2 - x1
    dy = y2 - y1
    if dx * dx > dy * dy
        draw_line(x1, y1 + 1, x2, y2 + 1, c)
    else
        draw_line(x1 + 1, y1, x2 + 1, y2, c)

// дуга: центр, радиус, углы в градусах (0 — вправо, 90 — вниз)
func arc(cx: int, cy: int, r: int, a0: int, a1: int, c: int)
    steps = (a1 - a0) / 8 + 2
    px = cx + round(r * cos_(a0 * 0.0174533))
    py = cy + round(r * sin_(a0 * 0.0174533))
    count i from 1 to steps
        a = (a0 + (a1 - a0) * i / steps) * 0.0174533
        x = cx + round(r * cos_(a))
        y = cy + round(r * sin_(a))
        ln2(px, py, x, y, c)
        px = x
        py = y

// буквы, а не байты: в UTF-8 у русской буквы два байта, второй — «продолжение» (128..191)
func letters(s: text) gives n: int
    each ch in s
        if not more(ch)
            n += 1

func more(ch: text) gives yes: bool
    b = code(ch)
    if b < 0
        b += 256
    return b >= 128 and b < 192

// ширина надписи: size — размер шрифта в точках
func text_w(s: Shell, t: text, size: int) gives w: int
    if s.f < 0
        return letters(t) * 8 * (size / 14 + 1)
    return text_width(s.f, t, size)

func bold_w(s: Shell, t: text, size: int) gives w: int
    if s.fb < 0
        return text_w(s, t, size)
    return text_width(s.fb, t, size)

// не длиннее n букв
func fit(s: text, n: int) gives r: text
    if letters(s) <= n
        return s
    k = 0
    each ch in s
        if not more(ch)
            k += 1
            if k > n - 2
                stop
        r += ch
    r += ".."

func label(s: Shell, x: int, y: int, t: text, size: int, c: int)
    if s.f < 0
        draw_text(x, y, t, size / 14 + 1, c)
    else
        draw_font(s.f, x, y, t, size, c)

func bold(s: Shell, x: int, y: int, t: text, size: int, c: int)
    if s.fb < 0
        label(s, x, y, t, size, c)
    else
        draw_font(s.fb, x, y, t, size, c)

// ---------- фон: светлое небо, яркие облака по краям, «водяные» круги в середине ----------
func sky(s: Shell)
    if s.sky >= 0
        draw_image(s.sky, 0, 0)
        return
    w = s.w
    h = s.h
    clear_window(rgb(244, 246, 252))
    draw_circle(w * 2 / 100, h * 78 / 100, w * 26 / 100, rgb(255, 176, 112))
    draw_circle(w * 20 / 100, h * 102 / 100, w * 20 / 100, rgb(255, 128, 162))
    draw_circle(w * 36 / 100, h * 104 / 100, w * 12 / 100, rgb(255, 196, 210))
    draw_circle(w * 90 / 100, h * 86 / 100, w * 24 / 100, rgb(196, 160, 255))
    draw_circle(w * 70 / 100, h * 104 / 100, w * 14 / 100, rgb(214, 196, 255))
    draw_circle(w * 102 / 100, h * 30 / 100, w * 22 / 100, rgb(130, 196, 255))
    draw_circle(w * 46 / 100, h * -6 / 100, w * 24 / 100, rgb(150, 232, 196))
    draw_circle(w * 28 / 100, h * -4 / 100, w * 14 / 100, rgb(236, 240, 170))
    draw_circle(w * 72 / 100, h * -2 / 100, w * 14 / 100, rgb(170, 226, 250))
    // середина светлая
    draw_circle(w * 48 / 100, h * 48 / 100, w * 24 / 100, rgb(248, 249, 255))
    blur_rect(0, 0, w, h, 70)
    blur_rect(0, 0, w, h, 40)
    // круги на воде: светлые кольца вокруг середины
    cx = w * 48 / 100
    cy = h * 50 / 100
    count k from 1 to 5
        r = 40.0 + k * 38.0
        n = 90 + k * 40
        count i from 0 to n - 1
            a = i * 6.2831853 / n
            x = cx + round(r * cos_(a))
            y = cy + round(r * 0.45 * sin_(a))
            draw_rect(x, y, 3, 2, rgba(255, 255, 255, 120))
            draw_rect(x, y + 3, 3, 1, rgba(150, 160, 200, 40))
    blur_rect(cx - 260, cy - 130, 520, 260, 2)
    s.sky = screen_image()

// синус и косинус рядом: в языке их нет — считаем рядом Тейлора
func sin_(a: dec) gives r: dec
    pi = 3.14159265358979
    repeat while a > pi
        a -= 2.0 * pi
    repeat while a < 0.0 - pi
        a += 2.0 * pi
    t = a
    r = a
    count k from 1 to 9
        t = 0.0 - t * a * a / ((2 * k) * (2 * k + 1) * 1.0)
        r += t
func cos_(a: dec) gives r: dec
    return sin_(a + 1.5707963267949)

// ---------- значок Омниума: спираль из цветных точек ----------
func logo(cx: int, cy: int, r: int)
    cols = [rgb(255, 170, 60), rgb(255, 90, 120), rgb(170, 110, 255), rgb(70, 150, 255), rgb(60, 200, 170), rgb(150, 220, 80)]
    count arm from 0 to 5
        count i from 0 to 7
            a = arm * 1.0472 + i * 0.17
            d = r * (0.35 + i * 0.085)
            draw_circle(cx + round(d * cos_(a)), cy + round(d * sin_(a)), r * (3 + i) / 40 + 1, cols[arm])
    draw_circle(cx, cy, r * 30 / 100, rgb(255, 255, 255))

// ---------- капсула справа: часы, дата, сеть, питание, уведомления, тема ----------
func capsule_box(s: Shell) gives x: int, y: int, w: int, h: int
    w = 84
    h = 470
    x = s.w - w - 18
    y = (s.h - h) / 2 - 30

func month_name(m: int) gives t: text
    names = ["янв", "фев", "мар", "апр", "мая", "июн", "июл", "авг", "сен", "окт", "ноя", "дек"]
    if m < 1 or m > 12
        return ""
    return names[m - 1]

func capsule(s: Shell)
    x, y, w, h = capsule_box(s)
    cx = x + w / 2
    shadow(x, y, w, h, 42, "all")
    frost(x, y, w, h, 42, "all", rgba(252, 253, 255, 214))
    parts = split(s.clock, ":")
    if len(parts) == 2
        bold(s, cx - bold_w(s, parts[0], 38) / 2, y + 32, parts[0], 38, ink())
        bold(s, cx - bold_w(s, parts[1], 38) / 2, y + 76, parts[1], 38, ink())
    d = split(s.date, ".")
    if len(d) == 3
        dd = (to_int(d[0]) or 0) + " " + month_name(to_int(d[1]) or 0)
        bold(s, cx - bold_w(s, dd, 12) / 2, y + 128, dd, 12, ink())
    draw_rect(x + 20, y + 158, w - 40, 1, rgba(40, 50, 80, 30))
    // сеть: точка и три дуги
    wy = y + 204
    if pic(s, "wifi", cx, wy - 6) and pic(s, "battery", cx, y + 251) and pic(s, "bell", cx, y + 324) and pic(s, "sun", cx, y + 378) and pic(s, "moon", cx, y + 428)
        bell_badge(s, cx, y + 324)
        return
    draw_circle(cx, wy, 2, ink())
    arc(cx, wy, 7, 225, 315, ink())
    arc(cx, wy, 12, 225, 315, ink())
    arc(cx, wy, 17, 225, 315, ink())
    // питание: батарея стоя
    bt_y = y + 236
    rbox(cx - 8, bt_y + 3, 16, 26, 4, ink())
    rbox(cx - 6, bt_y + 5, 12, 22, 3, rgb(255, 255, 255))
    rbox(cx - 4, bt_y + 9, 8, 16, 2, ink())
    rbox(cx - 4, bt_y, 8, 4, 1, ink())
    draw_rect(x + 20, y + 286, w - 40, 1, rgba(40, 50, 80, 30))
    // уведомления: колокольчик; кружок с числом — сколько клеток упало
    ny = y + 324
    arc(cx, ny - 2, 8, 180, 360, ink())
    ln2(cx - 8, ny - 2, cx - 9, ny + 7, ink())
    ln2(cx + 8, ny - 2, cx + 9, ny + 7, ink())
    ln2(cx - 11, ny + 8, cx + 11, ny + 8, ink())
    draw_circle(cx, ny + 12, 2, ink())
    bell_badge(s, cx, ny)
    // светлая тема (солнце) и тёмная (месяц)
    sy = y + 378
    draw_circle(cx, sy, 6, ink())
    draw_circle(cx, sy, 4, rgb(252, 253, 255))
    count i from 0 to 7
        a = i * 0.785398
        ln2(cx + round(9.0 * cos_(a)), sy + round(9.0 * sin_(a)), cx + round(12.0 * cos_(a)), sy + round(12.0 * sin_(a)), ink())
    my = y + 428
    draw_circle(cx, my, 11, ink())
    draw_circle(cx + 6, my - 5, 10, rgb(252, 253, 255))

// кружок с числом над колокольчиком — сколько клеток упало
func bell_badge(s: Shell, cx: int, ny: int)
    falls = 0
    each l in s.log
        if find(l, "упала") >= 0
            falls += 1
    if falls > 0
        draw_circle(cx + 12, ny - 12, 8, rgb(255, 120, 60))
        t = "" + falls
        bold(s, cx + 12 - bold_w(s, t, 10) / 2, ny - 19, t, 10, rgb(255, 255, 255))

// ---------- панель внизу: значок, поиск, приложения ----------
func dock_box(s: Shell) gives x: int, y: int, w: int, h: int
    w = 680
    h = 66
    x = (s.w - w) / 2
    y = s.h - h - 14

func dock_apps() gives names: list text
    names = ["Заметки", "Терминал", "Файлы", "О системе"]

// изгиб «плеча»: от стенки панели к полосе внизу, ряд за рядом (вогнутый угол)
func shoulder(x: int, y: int, r: int, right: bool, c: int)
    count j from 0 to r - 1
        dy = j * 1.0 + 0.5
        dx = sqrt(r * r * 1.0 - dy * dy)
        wd = r - round(dx)
        if right
            draw_rect(x, y + j, wd, 1, c)
        else
            draw_rect(x + r - wd, y + j, wd, 1, c)

func dock(s: Shell)
    x, y, w, h = dock_box(s)
    c = rgba(252, 253, 255, 200)
    base = s.h - 14
    // полоса внизу во всю ширину и панель, вырастающая из неё плечами
    blur_rect(0, y - 10, s.w, s.h - y + 10, 14)
    // тень только над полосой: снизу её не должно быть видно, иначе у панели «обрыв»
    draw_shadow(x, y - 4, w, h - 14, 32, 14, rgba(40, 50, 90, 36))
    draw_rect(0, base, s.w, 14, c)
    draw_round(x, y, w, h, 32, "top", c)
    shoulder(x - 28, base - 28, 28, false, c)
    shoulder(x + w, base - 28, 28, true, c)
    cy = y + h / 2
    if not pic(s, "logo", x + 42, cy)
        logo(x + 42, cy, 20)
    // поиск
    sx = x + 80
    rbox(sx, cy - 22, 290, 44, 22, rgba(255, 255, 255, 235))
    draw_circle(sx + 26, cy - 2, 7, line_c())
    draw_circle(sx + 26, cy - 2, 5, rgb(255, 255, 255))
    ln2(sx + 31, cy + 3, sx + 36, cy + 8, line_c())
    if s.query == ""
        label(s, sx + 46, cy - 9, "Начни печатать — откроется меню", 13, dim())
    else
        label(s, sx + 46, cy - 9, fit(s.query, 24), 13, ink())
    draw_rect(sx + 308, cy - 18, 1, 36, rgba(40, 50, 80, 40))
    // приложения
    i = 0
    each a in dock_apps()
        ax = sx + 326 + i * 66
        if not pic(s, app_pic(a), ax + 22, cy - 3)
            icon(ax + 22, cy - 3, a)
        if shown_any(s, a)
            draw_circle(ax + 22, cy + 25, 2, rgb(150, 156, 170))
        i += 1

func shown_any(s: Shell, app: text) gives yes: bool
    each win in s.wins
        if win.app == app
            return true
    return false

// ---------- меню: открывается над панелью, когда печатаешь ----------
func found(s: Shell) gives r: list text
    q = lower(s.query)
    latin = ["terminal", "notes", "files", "about", "clock"]
    i = 0
    each a in apps()
        if q == "" or find(lower(a), q) >= 0 or find(latin[i], q) >= 0
            r.add(a)
        i += 1

func drop_box(s: Shell) gives x: int, y: int, w: int, h: int
    w = 560
    h = 380
    x = (s.w - w) / 2
    dx, dy, dw, dh = dock_box(s)
    y = dy - h - 14

func drop(s: Shell)
    if not s.menu
        return
    x, y, w, h = drop_box(s)
    shadow(x, y, w, h, 24, "all")
    frost(x, y, w, h, 24, "all", rgba(252, 253, 255, 214))
    // слева — что нашлось (Enter открывает первое), справа — все приложения
    bold(s, x + 24, y + 22, "Нашлось", 12, dim())
    yy = y + 50
    first = true
    each a in found(s)
        if first
            rbox(x + 14, yy - 8, 262, 34, 12, rgba(56, 118, 250, 34))
            first = false
        label(s, x + 30, yy, a, 14, ink())
        yy += 38
    bold(s, x + 304, y + 22, "Приложения", 12, dim())
    i = 0
    each a in apps()
        bx = x + 298 + (i % 2) * 124
        cy = y + 46 + (i / 2) * 108
        rbox(bx, cy, 112, 96, 18, rgba(255, 255, 255, 180))
        if not pic(s, app_pic(a), bx + 56, cy + 36)
            icon(bx + 56, cy + 36, a)
        label(s, bx + (112 - text_w(s, a, 12)) / 2, cy + 68, a, 12, ink())
        i += 1

// значки приложений 44×44 (центр cx, cy)
// значок-картинка по имени: рисуется по центру (cx, cy); false — такой картинки нет
func pic(s: Shell, name: text, cx: int, cy: int) gives ok: bool
    count i from 0 to len(s.icon_names) - 1
        if s.icon_names[i] == name
            p = s.icon_ids[i]
            draw_image_alpha(p, cx - image_w(p) / 2, cy - image_h(p) / 2)
            return true
    return false

func load_icons(s: Shell)
    each name in ["terminal", "notes", "files", "about", "clock", "folder", "doc", "photo", "logo", "logo_small", "home", "snap", "disk", "usb", "wifi", "battery", "bell", "sun", "moon", "page", "search", "play", "grid"]
        p = -1
        match name
            "terminal"
                p = load_image("icons/terminal.png") or -1
            "notes"
                p = load_image("icons/notes.png") or -1
            "files"
                p = load_image("icons/files.png") or -1
            "about"
                p = load_image("icons/about.png") or -1
            "clock"
                p = load_image("icons/clock.png") or -1
            "folder"
                p = load_image("icons/folder.png") or -1
            "doc"
                p = load_image("icons/doc.png") or -1
            "photo"
                p = load_image("icons/photo.png") or -1
            "logo"
                p = load_image("icons/logo.png") or -1
            "home"
                p = load_image("icons/home.png") or -1
            "snap"
                p = load_image("icons/snap.png") or -1
            "disk"
                p = load_image("icons/disk.png") or -1
            "usb"
                p = load_image("icons/usb.png") or -1
            "wifi"
                p = load_image("icons/wifi.png") or -1
            "battery"
                p = load_image("icons/battery.png") or -1
            "bell"
                p = load_image("icons/bell.png") or -1
            "sun"
                p = load_image("icons/sun.png") or -1
            "moon"
                p = load_image("icons/moon.png") or -1
            "page"
                p = load_image("icons/page.png") or -1
            "search"
                p = load_image("icons/search.png") or -1
            "play"
                p = load_image("icons/play.png") or -1
            "grid"
                p = load_image("icons/grid.png") or -1
            else
                p = load_image("icons/logo_small.png") or -1
        if p >= 0
            s.icon_names.add(name)
            s.icon_ids.add(p)

func app_pic(app: text) gives name: text
    match app
        "Терминал"
            name = "terminal"
        "Заметки"
            name = "notes"
        "Файлы"
            name = "files"
        "О системе"
            name = "about"
        else
            name = "clock"

func icon(cx: int, cy: int, app: text)
    match app
        "Терминал"
            rbox(cx - 20, cy - 18, 40, 36, 9, rgb(40, 50, 66))
            ln2(cx - 10, cy - 7, cx - 4, cy - 1, rgb(230, 236, 245))
            ln2(cx - 4, cy - 1, cx - 10, cy + 5, rgb(230, 236, 245))
            rbox(cx, cy + 4, 10, 2, 1, rgb(230, 236, 245))
        "Заметки"
            // как редактор кода: синий «лист» с ломаной
            rbox(cx - 18, cy - 20, 36, 40, 9, rgb(60, 130, 250))
            rbox(cx - 18, cy - 20, 36, 20, 9, rgb(90, 160, 255))
            draw_rect(cx - 18, cy - 4, 36, 4, rgb(75, 145, 252))
            ln2(cx - 9, cy - 8, cx - 1, cy, rgb(255, 255, 255))
            ln2(cx - 1, cy, cx - 9, cy + 8, rgb(255, 255, 255))
            ln2(cx + 3, cy + 8, cx + 10, cy + 8, rgb(255, 255, 255))
        "Файлы"
            folder(cx, cy, 22, rgb(255, 190, 40), rgb(255, 214, 90))
        "О системе"
            draw_circle(cx, cy, 19, rgb(176, 140, 255))
            draw_circle(cx, cy - 8, 2, rgb(255, 255, 255))
            rbox(cx - 2, cy - 3, 4, 12, 2, rgb(255, 255, 255))
        else
            draw_circle(cx, cy, 19, rgb(255, 110, 150))
            draw_circle(cx, cy, 15, rgb(255, 255, 255))
            ln2(cx, cy, cx, cy - 9, ink())
            ln2(cx, cy, cx + 6, cy + 2, ink())

// папка: язычок сзади и передняя часть посветлее; size — половина ширины
func folder(cx: int, cy: int, size: int, c_back: int, c_front: int)
    w = size * 2
    h = size * 16 / 10
    x = cx - size
    y = cy - h / 2
    rbox(x, y, w * 45 / 100, h / 3, 5, c_back)
    rbox(x, y + h / 7, w, h - h / 7, 7, c_back)
    rbox(x, y + h * 3 / 10, w, h * 7 / 10, 7, c_front)

// документ: белый лист с загнутым углом и строками
// значок картинки: рамка, солнце и горы
func photo_icon(cx: int, cy: int)
    draw_round(cx - 24, cy - 20, 48, 40, 8, "all", rgb(120, 170, 250))
    draw_round(cx - 20, cy - 16, 40, 32, 5, "all", rgb(214, 232, 255))
    draw_circle(cx + 9, cy - 7, 5, rgb(255, 196, 70))
    draw_triangle(cx - 18, cy + 14, cx - 5, cy - 4, cx + 8, cy + 14, rgb(70, 160, 110))
    draw_triangle(cx - 2, cy + 14, cx + 8, cy + 1, cx + 18, cy + 14, rgb(50, 130, 90))

func doc_icon(cx: int, cy: int, c: int)
    rbox(cx - 18, cy - 23, 36, 46, 6, rgba(255, 255, 255, 240))
    draw_round(cx + 6, cy - 23, 12, 12, 4, "bl", rgba(210, 216, 228, 255))
    count i from 0 to 3
        rbox(cx - 11, cy - 6 + i * 7, 22 - (i % 2) * 6, 3, 1, c)

// ---------- окна ----------
func ear_h() gives h: int
    return 44

func ear_w(s: Shell, win: Win) gives w: int
    return bold_w(s, win.title, 15) + 78

// кнопки окна справа сверху: свернуть, развернуть, закрыть (линиями)
func win_buttons(win: Win, c: int)
    y = win.y + 22
    x = win.x + win.w - 38
    ln2(x - 5, y, x + 5, y, c)
    ln2(x - 4, y - 5, x - 4, y + 5, c)
    x2 = x
    xm = x - 84
    xr = x - 42
    ln2(xm - 6, y, xm + 6, y, c)
    ln2(xr - 5, y - 5, xr + 5, y - 5, c)
    ln2(xr - 5, y + 5, xr + 5, y + 5, c)
    ln2(xr - 5, y - 5, xr - 5, y + 5, c)
    ln2(xr + 5, y - 5, xr + 5, y + 5, c)
    // закрыть: крест (поверх первой линии рисуем заново — это «×»)
    draw_rect(x2 - 6, y - 6, 14, 14, rgba(0, 0, 0, 0))

func cross(x: int, y: int, c: int)
    ln2(x - 6, y - 6, x + 6, y + 6, c)
    ln2(x + 6, y - 6, x - 6, y + 6, c)

func window(s: Shell, win: Win, top: bool)
    eh = ear_h()
    ew = ear_w(s, win)
    body = glass()
    // тень, ушко и тело: ушко — выступ над левым краем
    shadow(win.x, win.y, win.w, win.h, 24, "tr bl br")
    frost(win.x, win.y - eh, ew, eh + 12, 20, "top", body)
    frost(win.x, win.y, win.w, win.h, 24, "tr bl br", body)
    // переход ушка в тело — плечом
    shoulder(win.x + ew, win.y - 20, 20, true, body)
    if not pic(s, "logo_small", win.x + 28, win.y - eh / 2 + 2)
        logo(win.x + 28, win.y - eh / 2 + 2, 11)
    bold(s, win.x + 48, win.y - eh / 2 - 8, win.title, 15, ink())
    // кнопки справа: свернуть, развернуть, закрыть
    bt_y = win.y + 24
    bx = win.x + win.w - 34
    c = line_c()
    cross(bx, bt_y, c)
    ln2(bx - 48, bt_y - 5, bx - 38, bt_y - 5, c)
    ln2(bx - 48, bt_y + 5, bx - 38, bt_y + 5, c)
    ln2(bx - 48, bt_y - 5, bx - 48, bt_y + 5, c)
    ln2(bx - 38, bt_y - 5, bx - 38, bt_y + 5, c)
    ln2(bx - 92, bt_y, bx - 80, bt_y, c)
    if top
        rbox(win.x + 20, win.y - 5, ew - 40, 3, 1, accent())
    content(s, win)

// строка папки сбоку в «Файлах»: значок, имя, выбрана ли
func tools_old(ix: int, ry: int, c: int)
    rbox(ix - 8, ry + 2, 16, 20, 3, c)
    rbox(ix - 6, ry + 4, 12, 16, 2, rgb(246, 248, 252))
    // лупа
    draw_circle(ix - 1, ry + 51, 7, c)
    draw_circle(ix - 1, ry + 51, 5, rgb(246, 248, 252))
    ln2(ix + 4, ry + 56, ix + 8, ry + 60, c)
    // запуск
    ln2(ix - 5, ry + 90, ix - 5, ry + 106, c)
    ln2(ix - 5, ry + 90, ix + 8, ry + 98, c)
    ln2(ix - 5, ry + 106, ix + 8, ry + 98, c)
    // квадраты
    count q from 0 to 3
        rbox(ix - 8 + (q % 2) * 10, ry + 132 + (q / 2) * 10, 7, 7, 2, c)

func side_item(s: Shell, x: int, y: int, w: int, name: text, kind: text, on: bool)
    if on
        rbox(x, y - 7, w, 34, 12, rgba(190, 214, 255, 200))
    c = line_c()
    ix = x + 22
    iy = y + 10
    if pic(s, kind, ix, iy)
        label(s, x + 42, y, name, 14, ink())
        return
    match kind
        "home"
            ln2(ix - 8, iy - 1, ix, iy - 8, c)
            ln2(ix, iy - 8, ix + 8, iy - 1, c)
            ln2(ix - 6, iy - 2, ix - 6, iy + 7, c)
            ln2(ix + 6, iy - 2, ix + 6, iy + 7, c)
            ln2(ix - 6, iy + 7, ix + 6, iy + 7, c)
        "snap"
            arc(ix, iy, 8, 0, 300, c)
            ln2(ix, iy - 4, ix, iy + 1, c)
            ln2(ix, iy + 1, ix + 4, iy + 3, c)
        else
            rbox(ix - 9, iy - 6, 18, 13, 3, c)
            rbox(ix - 7, iy - 4, 14, 9, 2, rgb(240, 243, 250))
            draw_circle(ix + 5, iy + 3, 1, c)
    label(s, x + 42, y, name, 14, ink())

func content(s: Shell, win: Win)
    x = win.x + 24
    y = win.y + 20
    match win.app
        "Терминал"
            // тёмное окно в окне: светлая полоса с кнопками сверху, ниже — тёмный экран
            tx = win.x + 6
            ty = win.y + 48
            tw = win.w - 12
            th = win.h - 54
            draw_round(tx, ty, tw, th, 20, "all", dark_glass())
            n = len(s.log)
            rows = (th - 52) / 20
            first = n - rows
            if first < 0
                first = 0
            count i from first to n - 1
                label(s, tx + 18, ty + 16 + (i - first) * 20, fit(s.log[i], (tw - 36) / 7), 13, rgb(226, 232, 242))
            py = ty + 16 + (n - first) * 20 + 8
            pr = "naz@omnium:~$ "
            label(s, tx + 18, py, pr, 13, rgb(140, 236, 150))
            draw_rect(tx + 20 + text_w(s, pr, 13), py, 8, 17, rgb(226, 232, 242))
        "Заметки"
            // как редактор: полоса значков слева, номера строк, текст
            rx = win.x + 10
            ry = win.y + 50
            draw_rect(rx + 52, ry, 1, win.h - 84, rgba(40, 50, 80, 26))
            c = line_c()
            // лист
            ix = rx + 26
            ok = pic(s, "page", ix, ry + 12) and pic(s, "search", ix, ry + 53) and pic(s, "play", ix, ry + 98) and pic(s, "grid", ix, ry + 141)
            if not ok
                tools_old(ix, ry, c)
            lines = split(s.note, "\n")
            tx = rx + 104
            yy = ry
            k = 1
            each l in lines
                if yy > win.y + win.h - 56
                    stop
                t = "" + k
                label(s, tx - 24 - text_w(s, t, 14), yy, t, 14, rgb(160, 168, 184))
                label(s, tx, yy, l, 14, ink())
                yy += 24
                k += 1
            if s.note_on
                last = lines[len(lines) - 1]
                draw_rect(tx + 1 + text_w(s, last, 14), yy - 24, 2, 18, accent())
            // строка состояния
            sy = win.y + win.h - 28
            st = "OFS3 · сохранено"
            if s.note_save > 0
                st = "OFS3 · сохраняю…"
            label(s, rx + 70, sy, "строк " + len(lines), 12, dim())
            label(s, win.x + win.w - 24 - text_w(s, st, 12) - 60, sy, st, 12, dim())
            label(s, win.x + win.w - 64, sy, "UTF-8", 12, dim())
        "Файлы"
            // слева — места, справа — что в них
            sx = win.x + 14
            sy = win.y + 56
            side_item(s, sx, sy, 168, "Омниум", "home", s.place == "ofs")
            side_item(s, sx, sy + 38, 168, "Снимки", "snap", false)
            label(s, sx + 16, sy + 96, "Устройства", 12, dim())
            side_item(s, sx, sy + 124, 168, "Диск Омниума", "disk", false)
            used = 0
            if s.fs_total > 0
                used = s.fs_used * 100 / s.fs_total
            label(s, sx + 42, sy + 146, (s.fs_total - s.fs_used) / 2048 + " МБ свободно", 11, dim())
            rbox(sx + 42, sy + 166, 110, 5, 2, rgba(40, 50, 80, 30))
            rbox(sx + 42, sy + 166, 8 + used * 102 / 100, 5, 2, rgb(80, 200, 140))
            side_item(s, sx, sy + 190, 168, "Флешка", "usb", s.place == "usb")
            label(s, sx + 42, sy + 212, fit(s.usb_note, 18), 11, dim())
            // строка пути: назад, вперёд, домой, где мы
            nx = win.x + 210
            ny = win.y + 24
            c = line_c()
            ln2(nx, ny, nx + 12, ny, c)
            ln2(nx, ny, nx + 5, ny - 5, c)
            ln2(nx, ny, nx + 5, ny + 5, c)
            ln2(nx + 30, ny, nx + 42, ny, c)
            ln2(nx + 42, ny, nx + 37, ny - 5, c)
            ln2(nx + 42, ny, nx + 37, ny + 5, c)
            place = "Омниум"
            items = s.fs_files
            if s.place == "usb"
                place = "Флешка"
                items = s.usb_files
            label(s, nx + 62, ny - 9, place, 14, ink())
            // сетка
            gx = win.x + 210
            gy = win.y + 64
            cols = (win.w - 220) / 130
            if cols < 1
                cols = 1
            i = 0
            each f in items
                cx = gx + (i % cols) * 130 + 60
                cy = gy + (i / cols) * 120 + 34
                if cy + 60 > win.y + win.h
                    stop
                nm = f
                if ends_with(f, "/")
                    if not pic(s, "folder", cx, cy)
                        folder(cx, cy, 30, rgb(80, 150, 250), rgb(120, 180, 255))
                    nm = cut(f, 0, len(f) - 2)
                else if picture.is_picture(f)
                    if not pic(s, "photo", cx, cy)
                        photo_icon(cx, cy)
                else
                    if not pic(s, "doc", cx, cy)
                        doc_icon(cx, cy, rgb(190, 198, 214))
                nm = fit(nm, 15)
                label(s, cx - text_w(s, nm, 13) / 2, cy + 36, nm, 13, ink())
                i += 1
            if len(items) == 0
                label(s, gx + 10, gy + 10, "пусто", 14, dim())
        "Просмотр"
            if win.pic > 0
                p = win.pic - 1
                draw_image(p, win.x + (win.w - image_w(p)) / 2, win.y + 48 + (win.h - 60 - image_h(p)) / 2)
        "О системе"
            y = win.y + 60
            bold(s, x, y, "Омниум", 34, ink())
            label(s, x, y + 56, "ядро на Tachbit, x86-64", 14, ink())
            label(s, x, y + 80, "клетки на каналах, без системных вызовов", 14, dim())
            label(s, x, y + 104, "окон открыто: " + len(s.wins) + ", работает: " + uptime_ms() / 1000 + " с", 14, dim())
            if s.has_fs
                label(s, x, y + 128, "файлы: " + s.fs_note + ", занято " + s.fs_used / 2 + " КБ", 14, dim())
        else
            y = win.y + 56
            bold(s, x + 6, y, s.clock, 56, ink())
            label(s, x + 10, y + 80, s.date, 14, dim())

// свёрнутые окна — ушки у левого края
func tabs(s: Shell)
    y = 40
    each win in s.wins
        if win.hidden
            shadow(0, y, ear_w(s, win) - 30, 38, 18, "right")
            frost(0, y, ear_w(s, win) - 30, 38, 18, "right", glass())
            if not pic(s, "logo_small", 22, y + 19)
                logo(22, y + 19, 9)
            bold(s, 40, y + 10, win.title, 14, ink())
            y += 48

// ---------- что делает мышь и клавиши ----------
modpub func open_app(s: Shell, app: text)
    each win in s.wins
        if win.app == app
            win.hidden = false
            front(s, win)
            return
    n = len(s.wins)
    w = 480
    h = 300
    x = 120 + n * 40
    y = 100 + n * 34
    if app == "Терминал"
        x = 660
        y = 70
        w = 450
        h = 200
    if app == "Файлы"
        x = 56
        y = 70
        w = 520
        h = 360
        files_refresh(s)
    if app == "Заметки"
        x = 500
        y = 330
        w = 560
        h = 300
    if app == "О системе"
        x = 380
        y = 160
        w = 470
        h = 240
    if app == "Часы"
        x = 120
        y = 470
        w = 300
        h = 180
    // места рассчитаны на экран 1280×720: на большом экране окна шире и дальше друг от друга
    x = x * s.w / 1280
    y = y * s.h / 720
    w = w * s.w / 1280
    h = h * s.h / 720
    win = Win(app: app, title: app, x: x, y: y, w: w, h: h, born: uptime_ms())
    s.wins.add(win)
    s.note_on = app == "Заметки"

func front(s: Shell, win: Win)
    rest = list Win
    each o in s.wins
        if o.title != win.title
            rest.add(o)
    rest.add(win)
    s.wins = rest
    s.note_on = win.app == "Заметки"

func close(s: Shell, win: Win)
    rest = list Win
    each o in s.wins
        if o.title != win.title
            rest.add(o)
    s.wins = rest
    s.note_on = false

func inside(mx: int, my: int, x: int, y: int, w: int, h: int) gives yes: bool
    return mx >= x and my >= y and mx < x + w and my < y + h

func press(s: Shell, mx: int, my: int)
    s.dirty = true
    // свёрнутые ушки слева
    ty = 40
    each win in s.wins
        if win.hidden
            if inside(mx, my, 0, ty, ear_w(s, win) - 30, 38)
                win.hidden = false
                front(s, win)
                return
            ty += 48
    // меню над панелью
    x, y, w, h = drop_box(s)
    if s.menu and inside(mx, my, x, y, w, h)
        if mx < x + 290
            k = (my - (y + 42)) / 38
            got = found(s)
            if k >= 0 and k < len(got)
                open_app(s, got[k])
                s.menu = false
                s.query = ""
            return
        i = (mx - (x + 298)) / 124 + ((my - (y + 46)) / 108) * 2
        all = apps()
        if mx >= x + 298 and my >= y + 46 and i >= 0 and i < len(all)
            open_app(s, all[i])
            s.menu = false
            s.query = ""
        return
    // панель: значок и поиск открывают меню, значки — приложения
    dx, dy, dw, dh = dock_box(s)
    if inside(mx, my, dx, dy, dw, dh)
        if mx < dx + 390
            s.menu = not s.menu
            s.query = ""
            s.note_on = false
            return
        i = (mx - (dx + 406)) / 66
        da = dock_apps()
        if i >= 0 and i < len(da)
            open_app(s, da[i])
        s.menu = false
        return
    s.menu = false
    // окна сверху вниз
    n = len(s.wins)
    count k from 1 to n
        win = s.wins[n - k]
        if win.hidden
            skip
        ew = ear_w(s, win)
        bx = win.x + win.w - 34
        bt_y = win.y + 24
        if inside(mx, my, bx - 14, bt_y - 14, 28, 28)
            close(s, win)
            return
        if inside(mx, my, bx - 100, bt_y - 14, 28, 28)
            win.hidden = true
            s.note_on = false
            return
        if inside(mx, my, win.x, win.y - ear_h(), ew, ear_h())
            front(s, win)
            s.drag = len(s.wins) - 1
            s.dx = mx - win.x
            s.dy = my - win.y
            return
        if inside(mx, my, win.x, win.y, win.w, win.h)
            front(s, win)
            if win.app == "Файлы"
                if inside(mx, my, win.x + 14, win.y + 49, 168, 34)
                    s.place = "ofs"
                if inside(mx, my, win.x + 14, win.y + 239, 168, 34)
                    s.place = "usb"
                files_refresh(s)
                file_click(s, win, mx, my)
            return
    s.note_on = false

// щелчок по сетке «Файлов»: картинка открывается в «Просмотре»
func file_click(s: Shell, win: Win, mx: int, my: int)
    gx = win.x + 210
    gy = win.y + 64
    cols = (win.w - 220) / 130
    if cols < 1
        cols = 1
    if mx < gx or my < gy
        return
    col = (mx - gx) / 130
    if col >= cols
        return
    i = ((my - gy) / 120) * cols + col
    items = s.fs_files
    if s.place == "usb"
        items = s.usb_files
    if i >= len(items) or not picture.is_picture(items[i])
        return
    name = items[i]
    p = -1
    if s.place == "usb"
        p = picture.from_usb(s.usb, "/" + name) else err
            s.log.add("[просмотр] " + name + ": " + err)
            return
    else
        p = picture.from_ofs(s.fs, name) else err
            s.log.add("[просмотр] " + name + ": " + err)
            return
    show_picture(s, name, p)

// окно «Просмотр»: картинка вписана в 60% экрана
modpub func show_picture(s: Shell, name: text, p: int)
    q = picture.fit_into(p, s.w * 6 / 10, s.h * 6 / 10)
    w = max(image_w(q) + 48, 320)
    h = image_h(q) + 72
    win = Win(app: "Просмотр", title: name, x: (s.w - w) / 2, y: (s.h - h) / 2 - 20, w: w, h: h, born: uptime_ms(), pic: q + 1)
    s.wins.add(win)
    s.dirty = true

// убрать последнюю букву (целиком, со всеми её байтами)
func drop_last(s: text) gives r: text
    n = letters(s)
    k = 0
    each ch in s
        if not more(ch)
            k += 1
        if k < n
            r += ch

func keys(s: Shell)
    t = typed_text()
    enter = key_down("enter")
    esc = key_down("escape")
    back = key_down("backspace")
    e = enter and not s.was_enter
    x = esc and not s.was_esc
    b = back and not s.was_back
    s.was_enter = enter
    s.was_esc = esc
    s.was_back = back
    if t == "" and not e and not x and not b
        return
    s.dirty = true
    if s.note_on and not s.menu
        if b and s.note != ""
            s.note = drop_last(s.note)
        if e
            s.note += "\n"
        s.note += t
        // сохраним, когда перестанут печатать (через секунду)
        s.note_save = uptime_ms() + 1000
        return
    if x
        s.query = ""
        s.menu = false
        return
    if b and s.query != ""
        s.query = drop_last(s.query)
    s.query += t
    if s.query != ""
        s.menu = true
    if e
        got = found(s)
        if len(got) > 0
            open_app(s, got[0])
        s.query = ""
        s.menu = false

// ---------- сама клетка оболочки ----------
// log — строки для «Терминала»; ask/answer — ключ к службе часов; frames — сколько кадров жить (0 — всегда)
// fs — ключ к файловой системе OFS3 (has_fs false — файлов нет)
// usb — ключ к службе exFAT (флешка; has_usb false — флешки нет)
modpub func shell(w: int, h: int, log: channel text, ask: channel int, answer: channel text, frames: int, start: list text, fs: Key, has_fs: bool, usb: Key, has_usb: bool)
    window_open(w, h, "Омниум") else err
        log.send("[оболочка] нет экрана: " + err)
        return
    s = Shell(w: w, h: h, drag: -1, dirty: true, asked: -100000, sky: -1, place: "ofs")
    s.fs = fs
    s.has_fs = has_fs
    s.usb = usb
    s.has_usb = has_usb
    s.usb_note = "флешки нет"
    if has_fs
        s.note = ofs.get(fs, "заметки") or ""
        fs_info(s)
    s.f = load_font("fonts/Inter-Regular.ttf") or -1
    s.fb = load_font("fonts/Inter-SemiBold.ttf") or -1
    load_icons(s)
    each a in start
        open_app(s, a)
    repeat while window_alive()
        s.frames += 1
        // время — раз в секунду
        if uptime_ms() - s.asked > 1000
            s.asked = uptime_ms()
            ask.send(1)
        if answer.ready()
            parts = split(answer.receive(), " ")
            if len(parts) == 2 and (parts[0] != s.clock or parts[1] != s.date)
                s.clock = parts[0]
                s.date = parts[1]
                s.dirty = true
        repeat while log.ready()
            s.log.add(log.receive())
            s.dirty = true
        mx = mouse_x()
        my = mouse_y()
        down = mouse_down()
        if down and not s.down
            press(s, mx, my)
        if not down
            s.drag = -1
        if down and s.drag >= 0 and s.drag < len(s.wins)
            win = s.wins[s.drag]
            win.x = mx - s.dx
            win.y = my - s.dy
            if win.y < 36
                win.y = 36
            s.dirty = true
        s.down = down
        keys(s)
        // курсор не мигает: мигание перерисовывало бы весь экран дважды в секунду
        if s.frames % 60 == 0 and shown(s, "О системе")
            s.dirty = true
        if s.note_save > 0 and uptime_ms() > s.note_save
            s.note_save = 0
            if s.has_fs
                v = ofs.put(s.fs, "заметки", s.note) else err
                    s.log.add("[файлы] не сохранила заметки: " + err)
                fs_info(s)
                s.dirty = true
        if s.dirty
            draw(s)
            s.dirty = false
        if frames > 0 and s.frames >= frames
            stop

func shown(s: Shell, app: text) gives yes: bool
    each win in s.wins
        if win.app == app and not win.hidden
            return true
    return false

func draw(s: Shell)
    sky(s)
    tabs(s)
    n = len(s.wins)
    i = 0
    each win in s.wins
        if not win.hidden
            window(s, win, i == n - 1)
        i += 1
    capsule(s)
    dock(s)
    drop(s)

func fs_info(s: Shell)
    note, n, used, total = ofs.info(s.fs) else err
        s.fs_note = err
        return
    s.fs_note = note
    s.fs_used = used
    s.fs_total = total

// что показать в окне «Файлы»: файлы OFS3 (с числом версий) и корень флешки
func files_refresh(s: Shell)
    s.fs_files.clear()
    s.usb_files.clear()
    if s.has_fs
        names = ofs.file_names(s.fs) else err
            return
        each n in names
            s.fs_files.add(n)
    if s.has_usb
        note, fkb, tkb = exfat.info(s.usb) else err
            s.usb_note = err
            return
        s.usb_note = note
        root = exfat.ls(s.usb, "/") else err
            s.usb_note = err
            return
        each n in root
            s.usb_files.add(n)
