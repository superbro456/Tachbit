// Оболочка «Капля»: светлое небо, окна из матового стекла с «ушком» вместо заголовка, круглая
// капсула справа (часы, дата, поиск). Поиск — стеклянная панель по центру: открывается, когда
// печатаешь или жмёшь лупу в капсуле. Шрифт Inter (лежит в ядре), сглаженные углы, мягкие тени.
// Оболочка — обычная клетка: danger ей не нужен. Время она спрашивает у службы часов,
// строки для «Терминала» получает из канала журнала.

use ofs
use exfat

obj Win
    app: text
    title: text
    x: int
    y: int
    w: int
    h: int
    hidden: bool
    born: int          // когда открыли (капля падает снизу)

obj Shell
    w: int
    h: int
    wins: list Win
    drag: int          // окно, которое тащат за ушко (-1 — никакое)
    dx: int
    dy: int
    query: text        // что напечатали в капле
    menu: bool         // меню капли раскрыто
    note: text         // текст «Заметок»
    note_on: bool      // печатают в «Заметки»
    log: list text     // строки «Терминала»
    down: bool
    dirty: bool
    clock: text
    date: text
    asked: int
    was_enter: bool
    was_esc: bool
    was_back: bool
    frames: int
    sky: int           // снимок фона (рисуется один раз)
    f: int             // шрифт Inter (-1 — нет, тогда свой 8×16)
    fb: int            // Inter SemiBold
    fs: Key            // ключ к файлам (OFS3)
    has_fs: bool
    note_save: int     // когда сохранить «Заметки» (0 — сохранено)
    fs_note: text      // что за файловая система (для «О системе»)
    fs_used: int
    fs_total: int
    usb: Key           // ключ к флешке (exFAT)
    has_usb: bool
    usb_note: text
    fs_files: list text    // для окна «Файлы»
    usb_files: list text

// ---------- стиль «Капли» ----------
func ink() gives c: int
    return rgb(34, 40, 52)
func dim() gives c: int
    return rgb(120, 128, 144)
func accent() gives c: int
    return rgb(64, 120, 255)
func glass() gives c: int
    return rgba(255, 255, 255, 190)
func dark_glass() gives c: int
    return rgba(18, 22, 34, 215)

modpub func apps() gives names: list text
    names = ["Терминал", "Заметки", "Файлы", "О системе", "Часы"]

// ---------- фигуры ----------
// стекло: то, что под ним, размывается, сверху — полупрозрачный цвет; углы сглажены
func frost(x: int, y: int, w: int, h: int, r: int, corners: text, c: int)
    // размываем «крестом»: углы за скруглением не трогаем, иначе вокруг стекла видно квадрат
    k = r / 2
    blur_rect(x, y + k, w, h - 2 * k, 12)
    blur_rect(x + k, y, w - 2 * k, k, 12)
    blur_rect(x + k, y + h - k, w - 2 * k, k, 12)
    draw_round(x, y, w, h, r, corners, c)

// мягкая тень: слои всё шире и прозрачнее
func shadow(x: int, y: int, w: int, h: int, r: int, corners: text)
    count k from 0 to 9
        draw_round(x - k, y + 8 - k, w + 2 * k, h + 2 * k, r + k, corners, rgba(30, 40, 80, 5))

func rbox(x: int, y: int, w: int, h: int, r: int, c: int)
    draw_round(x, y, w, h, r, "all", c)

// буквы, а не байты: в UTF-8 у русской буквы два байта, второй — «продолжение» (128..191)
func letters(s: text) gives n: int
    each ch in s
        if not more(ch)
            n += 1

func more(ch: text) gives yes: bool
    b = code(ch)
    if b < 0
        b += 256
    return b >= 128 and b < 192

// ширина надписи: size — размер шрифта в точках
func text_w(s: Shell, t: text, size: int) gives w: int
    if s.f < 0
        return letters(t) * 8 * (size / 14 + 1)
    return text_width(s.f, t, size)

func bold_w(s: Shell, t: text, size: int) gives w: int
    if s.fb < 0
        return text_w(s, t, size)
    return text_width(s.fb, t, size)

// не длиннее n букв
func fit(s: text, n: int) gives r: text
    if letters(s) <= n
        return s
    k = 0
    each ch in s
        if not more(ch)
            k += 1
            if k > n - 2
                stop
        r += ch
    r += ".."

func label(s: Shell, x: int, y: int, t: text, size: int, c: int)
    if s.f < 0
        draw_text(x, y, t, size / 14 + 1, c)
    else
        draw_font(s.f, x, y, t, size, c)

func bold(s: Shell, x: int, y: int, t: text, size: int, c: int)
    if s.fb < 0
        label(s, x, y, t, size, c)
    else
        draw_font(s.fb, x, y, t, size, c)

// ---------- фон: белое небо и четыре мягких облака цвета ----------
func sky(s: Shell)
    if s.sky >= 0
        draw_image(s.sky, 0, 0)
        return
    clear_window(rgb(246, 247, 252))
    draw_circle(s.w * 18 / 100, s.h * 25 / 100, 230, rgb(214, 226, 255))
    draw_circle(s.w * 80 / 100, s.h * 18 / 100, 200, rgb(255, 228, 208))
    draw_circle(s.w * 30 / 100, s.h * 88 / 100, 220, rgb(212, 240, 224))
    draw_circle(s.w * 72 / 100, s.h * 76 / 100, 190, rgb(252, 216, 234))
    draw_circle(s.w * 52 / 100, s.h * 45 / 100, 120, rgb(232, 226, 255))
    // облака без краёв: всё небо размываем один раз (потом берём снимок)
    blur_rect(0, 0, s.w, s.h, 60)
    // слабая спираль: точки по кругу, который растёт
    cx = s.w / 2
    cy = s.h / 2
    count i from 0 to 140
        a = i * 0.21
        r = 18.0 + i * 2.6
        x = cx + round(r * cos_(a))
        y = cy + round(r * 0.6 * sin_(a))
        draw_circle(x, y, 1, rgba(120, 110, 200, 50))
    s.sky = screen_image()

// синус и косинус рядом: в языке их нет — считаем рядом Тейлора
func sin_(a: dec) gives r: dec
    pi = 3.14159265358979
    repeat while a > pi
        a -= 2.0 * pi
    repeat while a < 0.0 - pi
        a += 2.0 * pi
    t = a
    r = a
    count k from 1 to 9
        t = 0.0 - t * a * a / ((2 * k) * (2 * k + 1) * 1.0)
        r += t
func cos_(a: dec) gives r: dec
    return sin_(a + 1.5707963267949)

// ---------- капсула справа: часы, дата, сеть, батарея ----------
func capsule_box(s: Shell) gives x: int, y: int, w: int, h: int
    w = 68
    h = 318
    x = s.w - w - 16
    y = (s.h - h) / 2

func capsule(s: Shell)
    x, y, w, h = capsule_box(s)
    shadow(x, y, w, h, 34, "all")
    frost(x, y, w, h, 34, "all", glass())
    parts = split(s.clock, ":")
    if len(parts) == 2
        bold(s, x + (w - bold_w(s, parts[0], 26)) / 2, y + 26, parts[0], 26, ink())
        bold(s, x + (w - bold_w(s, parts[1], 26)) / 2, y + 60, parts[1], 26, ink())
    d = split(s.date, ".")
    if len(d) == 3
        dd = d[0] + "." + d[1]
        label(s, x + (w - text_w(s, dd, 12)) / 2, y + 100, dd, 12, dim())
    // сеть: три точки разного размера
    draw_circle(x + 23, y + 150, 3, ink())
    draw_circle(x + 33, y + 146, 4, ink())
    draw_circle(x + 44, y + 141, 5, ink())
    // батарея
    rbox(x + 19, y + 180, 28, 14, 4, ink())
    rbox(x + 21, y + 182, 24, 10, 3, rgb(120, 210, 150))
    rbox(x + 47, y + 184, 3, 6, 1, ink())
    // лупа: открыть поиск
    bx, sy = search_btn(s)
    sc = rgba(255, 255, 255, 220)
    if s.menu
        sc = accent()
    draw_circle(bx, sy, 22, sc)
    fg = ink()
    if s.menu
        fg = rgb(255, 255, 255)
    draw_circle(bx - 3, sy - 3, 8, fg)
    draw_circle(bx - 3, sy - 3, 6, sc)
    draw_line(bx + 2, sy + 2, bx + 8, sy + 8, fg)
    draw_line(bx + 3, sy + 2, bx + 9, sy + 8, fg)

func search_btn(s: Shell) gives cx: int, cy: int
    x, y, w, h = capsule_box(s)
    cx = x + w / 2
    cy = y + h - 50

// ---------- поиск: стеклянная панель по центру ----------
func found(s: Shell) gives r: list text
    q = lower(s.query)
    latin = ["terminal", "notes", "files", "about", "clock"]
    i = 0
    each a in apps()
        if q == "" or find(lower(a), q) >= 0 or find(latin[i], q) >= 0
            r.add(a)
        i += 1

func drop_box(s: Shell) gives x: int, y: int, w: int, h: int
    w = 560
    h = 446
    x = (s.w - w) / 2
    y = s.h / 5

func drop(s: Shell)
    if not s.menu
        return
    x, y, w, h = drop_box(s)
    shadow(x, y, w, h, 24, "all")
    frost(x, y, w, h, 24, "all", rgba(255, 255, 255, 205))
    // строка поиска
    rbox(x + 16, y + 16, w - 32, 44, 14, rgba(255, 255, 255, 230))
    draw_circle(x + 40, y + 36, 8, dim())
    draw_circle(x + 40, y + 36, 6, rgb(255, 255, 255))
    draw_line(x + 45, y + 41, x + 50, y + 46, dim())
    q = s.query
    if q == ""
        label(s, x + 62, y + 27, "Поиск приложений", 15, dim())
    else
        label(s, x + 62, y + 27, q, 15, ink())
        if (s.frames / 30) % 2 == 0
            draw_rect(x + 63 + text_w(s, q, 15), y + 27, 2, 20, accent())
    // слева — что нашлось (Enter открывает первое), справа — все приложения
    bold(s, x + 24, y + 78, "Нашлось", 12, dim())
    yy = y + 102
    first = true
    each a in found(s)
        if first
            rbox(x + 16, yy - 7, 260, 32, 10, rgba(64, 120, 255, 36))
            first = false
        label(s, x + 30, yy, a, 14, ink())
        yy += 36
    bold(s, x + 310, y + 78, "Приложения", 12, dim())
    i = 0
    each a in apps()
        bx = x + 300 + (i % 2) * 124
        cy = y + 102 + (i / 2) * 106
        rbox(bx, cy, 112, 94, 18, rgba(255, 255, 255, 170))
        icon(bx + 56, cy + 34, a)
        label(s, bx + (112 - text_w(s, a, 12)) / 2, cy + 64, a, 12, ink())
        i += 1

func icon(cx: int, cy: int, app: text)
    match app
        "Терминал"
            rbox(cx - 18, cy - 16, 36, 32, 9, rgb(30, 34, 48))
            draw_line(cx - 9, cy - 6, cx - 3, cy, rgb(120, 230, 170))
            draw_line(cx - 3, cy, cx - 9, cy + 6, rgb(120, 230, 170))
            draw_rect(cx, cy + 5, 9, 2, rgb(120, 230, 170))
        "Заметки"
            rbox(cx - 15, cy - 18, 30, 36, 7, rgb(255, 214, 120))
            draw_rect(cx - 8, cy - 6, 16, 2, rgb(150, 110, 40))
            draw_rect(cx - 8, cy, 16, 2, rgb(150, 110, 40))
            draw_rect(cx - 8, cy + 6, 10, 2, rgb(150, 110, 40))
        "Файлы"
            rbox(cx - 18, cy - 13, 16, 8, 3, rgb(90, 160, 255))
            rbox(cx - 18, cy - 9, 36, 26, 6, rgb(110, 180, 255))
            rbox(cx - 18, cy - 4, 36, 21, 6, rgb(140, 200, 255))
        "О системе"
            draw_circle(cx, cy, 18, rgb(170, 140, 255))
            draw_circle(cx, cy - 7, 2, rgb(255, 255, 255))
            rbox(cx - 2, cy - 2, 4, 11, 2, rgb(255, 255, 255))
        else
            draw_circle(cx, cy, 18, rgb(120, 200, 255))
            draw_circle(cx, cy, 15, rgb(255, 255, 255))
            draw_line(cx, cy, cx, cy - 9, ink())
            draw_line(cx, cy, cx + 6, cy + 2, ink())

// ---------- окна ----------
func ear_w(s: Shell, win: Win) gives w: int
    return bold_w(s, win.title, 13) + 100

func window(s: Shell, win: Win, top: bool)
    dark = win.app == "Терминал"
    body = glass()
    fg = ink()
    if dark
        body = dark_glass()
        fg = rgb(225, 230, 240)
    ew = ear_w(s, win)
    // тень, ушко и тело: ушко — выступ над левым краем
    shadow(win.x, win.y - 34, ew, 34, 16, "top")
    shadow(win.x, win.y, win.w, win.h, 18, "tr bl br")
    frost(win.x, win.y - 34, ew, 34, 16, "top", body)
    frost(win.x, win.y, win.w, win.h, 18, "tr bl br", body)
    bold(s, win.x + 18, win.y - 25, win.title, 13, fg)
    // кнопки на ушке: свернуть и закрыть
    bx = win.x + ew - 58
    draw_circle(bx + 10, win.y - 17, 9, rgba(128, 128, 140, 50))
    rbox(bx + 5, win.y - 18, 10, 2, 1, fg)
    draw_circle(bx + 34, win.y - 17, 9, rgb(240, 96, 112))
    draw_line(bx + 31, win.y - 20, bx + 37, win.y - 14, rgb(255, 255, 255))
    draw_line(bx + 37, win.y - 20, bx + 31, win.y - 14, rgb(255, 255, 255))
    if top
        rbox(win.x + 18, win.y - 6, ew - 36, 3, 1, accent())
    content(s, win, fg)

func content(s: Shell, win: Win, fg: int)
    x = win.x + 20
    y = win.y + 18
    match win.app
        "Терминал"
            n = len(s.log)
            rows = (win.h - 36) / 18
            first = n - rows
            if first < 0
                first = 0
            count i from first to n - 1
                label(s, x, y + (i - first) * 18, fit(s.log[i], (win.w - 40) / 7), 13, rgb(150, 235, 180))
        "Заметки"
            lines = split(s.note, "\n")
            yy = y
            each ln in lines
                label(s, x, yy, ln, 15, fg)
                yy += 22
            if s.note_on and (s.frames / 30) % 2 == 0
                last = lines[len(lines) - 1]
                draw_rect(x + 1 + text_w(s, last, 15), yy - 22, 2, 19, accent())
        "Файлы"
            bold(s, x, y, "Омниум (OFS3)", 14, fg)
            yy = y + 26
            each f in s.fs_files
                if yy > win.y + win.h - 24
                    stop
                label(s, x + 8, yy, fit(f, 26), 13, fg)
                yy += 20
            if len(s.fs_files) == 0
                label(s, x + 8, yy, "пусто", 13, dim())
            cx = x + win.w / 2
            bold(s, cx, y, "Флешка (exFAT)", 14, fg)
            yy = y + 26
            if not s.has_usb or len(s.usb_files) == 0
                label(s, cx + 8, yy, fit(s.usb_note, 26), 13, dim())
            each f in s.usb_files
                if yy > win.y + win.h - 24
                    stop
                label(s, cx + 8, yy, fit(f, 26), 13, fg)
                yy += 20
        "О системе"
            bold(s, x, y, "Омниум", 34, fg)
            label(s, x, y + 56, "ядро на Tachbit, x86-64", 14, fg)
            label(s, x, y + 80, "клетки на каналах, без системных вызовов", 14, dim())
            label(s, x, y + 104, "окон открыто: " + len(s.wins), 14, dim())
            label(s, x, y + 128, "работает: " + uptime_ms() / 1000 + " с", 14, dim())
            if s.has_fs
                label(s, x, y + 152, "файлы: " + s.fs_note + ", занято " + s.fs_used / 2 + " КБ из " + s.fs_total / 2048 + " МБ", 14, dim())
        else
            bold(s, x + 6, y + 6, s.clock, 56, fg)
            label(s, x + 10, y + 86, s.date, 14, dim())

// свёрнутые окна — ушки у левого края
func tabs(s: Shell)
    y = 40
    each win in s.wins
        if win.hidden
            shadow(0, y, ear_w(s, win) - 40, 32, 16, "right")
            frost(0, y, ear_w(s, win) - 40, 32, 16, "right", glass())
            bold(s, 14, y + 8, win.title, 13, ink())
            y += 40

// ---------- что делает мышь и клавиши ----------
modpub func open_app(s: Shell, app: text)
    each win in s.wins
        if win.app == app
            win.hidden = false
            front(s, win)
            return
    n = len(s.wins)
    w = 460
    h = 300
    if app == "Часы"
        w = 300
        h = 160
    if app == "О системе"
        w = 440
        h = 206
    x = 90 + n * 40
    y = 80 + n * 34
    if app == "О системе"
        x = 500
        y = 130
    if app == "Часы"
        x = 600
        y = 420
    if app == "Заметки"
        x = 160
        y = 380
    if app == "Файлы"
        w = 560
        h = 320
        x = 260
        y = 300
        files_refresh(s)
    win = Win(app: app, title: app, x: x, y: y, w: w, h: h, born: uptime_ms())
    s.wins.add(win)
    s.note_on = app == "Заметки"

func front(s: Shell, win: Win)
    rest = list Win
    each o in s.wins
        if o.title != win.title
            rest.add(o)
    rest.add(win)
    s.wins = rest
    s.note_on = win.app == "Заметки"

func close(s: Shell, win: Win)
    rest = list Win
    each o in s.wins
        if o.title != win.title
            rest.add(o)
    s.wins = rest
    s.note_on = false

func inside(mx: int, my: int, x: int, y: int, w: int, h: int) gives yes: bool
    return mx >= x and my >= y and mx < x + w and my < y + h

func press(s: Shell, mx: int, my: int)
    s.dirty = true
    // свёрнутые ушки слева
    ty = 40
    each win in s.wins
        if win.hidden
            if inside(mx, my, 0, ty, ear_w(s, win) - 40, 32)
                win.hidden = false
                front(s, win)
                return
            ty += 40
    // лупа в капсуле
    bx, sy = search_btn(s)
    if inside(mx, my, bx - 22, sy - 22, 44, 44)
        s.menu = not s.menu
        s.query = ""
        s.note_on = false
        return
    // панель поиска
    x, y, w, h = drop_box(s)
    if s.menu and inside(mx, my, x, y, w, h)
        if mx < x + 290
            k = (my - (y + 95)) / 36
            got = found(s)
            if k >= 0 and k < len(got)
                open_app(s, got[k])
                s.menu = false
                s.query = ""
            return
        i = (mx - (x + 300)) / 124 + ((my - (y + 102)) / 106) * 2
        all = apps()
        if mx >= x + 300 and my >= y + 102 and i >= 0 and i < len(all)
            open_app(s, all[i])
            s.menu = false
            s.query = ""
        return
    s.menu = false
    // окна сверху вниз
    n = len(s.wins)
    count k from 1 to n
        win = s.wins[n - k]
        if win.hidden
            skip
        ew = ear_w(s, win)
        bx = win.x + ew - 58
        if inside(mx, my, bx + 24, win.y - 27, 20, 20)
            close(s, win)
            return
        if inside(mx, my, bx, win.y - 27, 20, 20)
            win.hidden = true
            s.note_on = false
            return
        if inside(mx, my, win.x, win.y - 34, ew, 34)
            front(s, win)
            s.drag = len(s.wins) - 1
            s.dx = mx - win.x
            s.dy = my - win.y
            return
        if inside(mx, my, win.x, win.y, win.w, win.h)
            front(s, win)
            return
    s.note_on = false

// убрать последнюю букву (целиком, со всеми её байтами)
func drop_last(s: text) gives r: text
    n = letters(s)
    k = 0
    each ch in s
        if not more(ch)
            k += 1
        if k < n
            r += ch

func keys(s: Shell)
    t = typed_text()
    enter = key_down("enter")
    esc = key_down("escape")
    back = key_down("backspace")
    e = enter and not s.was_enter
    x = esc and not s.was_esc
    b = back and not s.was_back
    s.was_enter = enter
    s.was_esc = esc
    s.was_back = back
    if t == "" and not e and not x and not b
        return
    s.dirty = true
    if s.note_on and not s.menu
        if b and s.note != ""
            s.note = drop_last(s.note)
        if e
            s.note += "\n"
        s.note += t
        // сохраним, когда перестанут печатать (через секунду)
        s.note_save = uptime_ms() + 1000
        return
    if x
        s.query = ""
        s.menu = false
        return
    if b and s.query != ""
        s.query = drop_last(s.query)
    s.query += t
    if s.query != ""
        s.menu = true
    if e
        got = found(s)
        if len(got) > 0
            open_app(s, got[0])
        s.query = ""
        s.menu = false

// ---------- сама клетка оболочки ----------
// log — строки для «Терминала»; ask/answer — ключ к службе часов; frames — сколько кадров жить (0 — всегда)
// fs — ключ к файловой системе OFS3 (has_fs false — файлов нет)
// usb — ключ к службе exFAT (флешка; has_usb false — флешки нет)
modpub func shell(w: int, h: int, log: channel text, ask: channel int, answer: channel text, frames: int, start: list text, fs: Key, has_fs: bool, usb: Key, has_usb: bool)
    window_open(w, h, "Омниум") else err
        log.send("[оболочка] нет экрана: " + err)
        return
    s = Shell(w: w, h: h, drag: -1, dirty: true, asked: -100000, sky: -1)
    s.fs = fs
    s.has_fs = has_fs
    s.usb = usb
    s.has_usb = has_usb
    s.usb_note = "флешки нет"
    if has_fs
        s.note = ofs.get(fs, "заметки") or ""
        fs_info(s)
    s.f = load_font("fonts/Inter-Regular.ttf") or -1
    s.fb = load_font("fonts/Inter-SemiBold.ttf") or -1
    each a in start
        open_app(s, a)
    repeat while window_alive()
        s.frames += 1
        // время — раз в секунду
        if uptime_ms() - s.asked > 1000
            s.asked = uptime_ms()
            ask.send(1)
        if answer.ready()
            parts = split(answer.receive(), " ")
            if len(parts) == 2 and (parts[0] != s.clock or parts[1] != s.date)
                s.clock = parts[0]
                s.date = parts[1]
                s.dirty = true
        repeat while log.ready()
            s.log.add(log.receive())
            s.dirty = true
        mx = mouse_x()
        my = mouse_y()
        down = mouse_down()
        if down and not s.down
            press(s, mx, my)
        if not down
            s.drag = -1
        if down and s.drag >= 0 and s.drag < len(s.wins)
            win = s.wins[s.drag]
            win.x = mx - s.dx
            win.y = my - s.dy
            if win.y < 36
                win.y = 36
            s.dirty = true
        s.down = down
        keys(s)
        if (s.note_on or s.menu) and s.frames % 30 == 0
            s.dirty = true
        if s.frames % 60 == 0 and shown(s, "О системе")
            s.dirty = true
        if s.note_save > 0 and uptime_ms() > s.note_save
            s.note_save = 0
            if s.has_fs
                v = ofs.put(s.fs, "заметки", s.note) else err
                    s.log.add("[файлы] не сохранила заметки: " + err)
                fs_info(s)
        if s.dirty
            draw(s)
            s.dirty = false
        if frames > 0 and s.frames >= frames
            stop

func shown(s: Shell, app: text) gives yes: bool
    each win in s.wins
        if win.app == app and not win.hidden
            return true
    return false

func draw(s: Shell)
    sky(s)
    tabs(s)
    n = len(s.wins)
    i = 0
    each win in s.wins
        if not win.hidden
            window(s, win, i == n - 1)
        i += 1
    capsule(s)
    drop(s)

func fs_info(s: Shell)
    note, n, used, total = ofs.info(s.fs) else err
        s.fs_note = err
        return
    s.fs_note = note
    s.fs_used = used
    s.fs_total = total

// что показать в окне «Файлы»: файлы OFS3 (с числом версий) и корень флешки
func files_refresh(s: Shell)
    s.fs_files.clear()
    s.usb_files.clear()
    if s.has_fs
        names = ofs.file_names(s.fs) else err
            return
        each n in names
            s.fs_files.add(n + "  · версий " + (ofs.versions(s.fs, n) or 0))
    if s.has_usb
        note, fkb, tkb = exfat.info(s.usb) else err
            s.usb_note = err
            return
        s.usb_note = note
        root = exfat.ls(s.usb, "/") else err
            s.usb_note = err
            return
        each n in root
            s.usb_files.add(n)
