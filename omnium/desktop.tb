// Омниум с оболочкой «Капля»: ядро запускает службы и клетки, оболочка рисует экран.
// Клетки пишут в журнал (канал), оболочка показывает его в «Терминале».
// Сборка и запуск:  ./omnium/run.sh
use rtc
use shell
use ofs
use exfat

// клетка «счётчик»: считает и пишет в журнал
func counter(no: int, log: channel text) gives r: int
    total = 0
    count i from 1 to 300000
        total += i % 7
    log.send("[счётчик " + no + "] сумма " + total)
    return total

// клетка с ошибкой: падает только она
func broken(log: channel text, n: int) gives r: int
    log.send("[сломанная] сейчас поделю на ноль")
    return 100 / n

func main()
    log = channel text
    log.send("Омниум: ядро запущено (x86-64, Tachbit)")
    ask = channel int
    answer = channel text
    time = service rtc(ask, answer)
    log.send("[ядро] службы: часы, экран, мышь, клавиатура")
    c0 = background counter(0, log)
    c1 = background counter(1, log)
    bad = background broken(log, 0)
    if bad.crashed
        log.send("[ядро] клетка «сломанная» упала, остальные работают")
    log.send("[ядро] печатай — откроется поиск; Enter открывает первое")
    // главная файловая система: OFS3 на диске 0 (нет диска — в памяти)
    fbell = channel int
    fasks = list channel text
    fanswers = list channel text
    fwrites = list bool
    fk = ofs.key(fbell, fasks, fanswers, fwrites, true)
    files = service ofs.ofs(0, fbell, move fasks, move fanswers, move fwrites)
    note, n, used, total = ofs.info(fk) else err
        note = err
    log.send("[ядро] файлы: " + note + ", файлов " + n)
    // флешка exFAT на диске 1 (./omnium/run.sh --usb файл.img)
    ubell = channel int
    uasks = list channel text
    uanswers = list channel text
    uwrites = list bool
    uk = ofs.key(ubell, uasks, uanswers, uwrites, true)
    usb = service exfat.exfat(1, ubell, move uasks, move uanswers, move uwrites)
    unote, ufree, utotal = exfat.info(uk) else err
        unote = err
    log.send("[ядро] флешка: " + unote)
    shell.shell(1280, 720, log, ask, answer, 0, ["Файлы", "Терминал", "Заметки"], fk, true, uk, true)
    fbell.close()
    files.wait
    ubell.close()
    usb.wait
    ask.close()
    time.wait
    sum = c0.wait + c1.wait
    print("[ядро] выключаюсь, сумма " + sum)
