// Диски Омниума: IDE (старые машины и QEMU по умолчанию), SATA через AHCI, NVMe (SSD M.2).
// Сектора по 512 байт. Номер диска — по порядку, как их нашли: сначала IDE (0 и 1), потом AHCI, потом NVMe.
// Доверенный модуль (danger: порты и окна устройств). Кто зовёт эти функции, тот должен быть драйвером
// файловой системы (OFS, exFAT); программы ходят к ним по каналам.
// На каждом контроллере свой замок (ata, ahci, nvme): две службы не перемешают команды.
// В QEMU:  -drive file=disk.img,format=raw,if=ide,index=0                      IDE
//          -device ahci,id=a -drive id=s,file=x.img,format=raw,if=none -device ide-hd,drive=s,bus=a.0   SATA
//          -drive id=n,file=y.img,format=raw,if=none -device nvme,serial=om1,drive=n                  NVMe
use ahci
use nvme

// список дисков: страница, по 32 байта на диск — вид (1 IDE, 2 AHCI, 3 NVMe), чей, секторов
shared dk_tab = int 0
shared dk_n = int 0

func disks_scan()
    lock disks
        if dk_tab == 0
            t = 0
            danger
                t = page_new()
                fill_mem(t, 0, 4096)
            n = 0
            count d from 0 to 1
                z = ide_size(d)
                if z > 0
                    dk_put(t, n, 1, d, z)
                    n += 1
            each st in ahci_disks()
                if n < 128
                    dk_put(t, n, 2, st, ahci_sectors(st))
                    n += 1
            each st in nvme_disks()
                if n < 128
                    dk_put(t, n, 3, st, nvme_sectors(st))
                    n += 1
            dk_n = n
            dk_tab = t

func dk_put(t: int, i: int, kind: int, unit: int, size: int)
    danger
        write64(t + i * 32, kind)
        write64(t + i * 32 + 8, unit)
        write64(t + i * 32 + 16, size)

func dk_get(drive: int) gives kind: int, unit: int
    if dk_tab == 0
        disks_scan()
    if drive < 0 or drive >= dk_n
        return
    danger
        kind = read64(dk_tab + drive * 32)
        unit = read64(dk_tab + drive * 32 + 8)

// сколько дисков нашлось и какой это: "IDE", "SATA", "NVMe"
modpub func disk_count() gives n: int
    if dk_tab == 0
        disks_scan()
    n = dk_n

modpub func disk_kind(drive: int) gives s: text
    kind, unit = dk_get(drive)
    if kind == 1
        return "IDE"
    if kind == 2
        return "SATA"
    if kind == 3
        return "NVMe"
    return ""

// сколько секторов на диске (0 — диска нет)
modpub func disk_size(drive: int) gives n: int
    kind, unit = dk_get(drive)
    if kind == 0
        return 0
    danger
        n = read64(dk_tab + drive * 32 + 16)

// прочитать сектор lba в память buf (512 байт)
modpub func disk_read(drive: int, lba: int, buf: int) gives ok: bool
    kind, unit = dk_get(drive)
    if kind == 1
        ok = ide_read(unit, lba, buf)
    else if kind == 2
        lock ahci
            ok = ahci_read(unit, lba, buf)
    else if kind == 3
        lock nvme
            ok = nvme_read(unit, lba, buf)

// записать сектор из buf
modpub func disk_write(drive: int, lba: int, buf: int) gives ok: bool
    kind, unit = dk_get(drive)
    if kind == 1
        ok = ide_write(unit, lba, buf)
    else if kind == 2
        lock ahci
            ok = ahci_write(unit, lba, buf)
    else if kind == 3
        lock nvme
            ok = nvme_write(unit, lba, buf)

// всё записанное — на диск (кэш диска сбрасывается)
modpub func disk_flush(drive: int) gives ok: bool
    kind, unit = dk_get(drive)
    if kind == 1
        ok = ide_flush(unit)
    else if kind == 2
        lock ahci
            ok = ahci_flush(unit)
    else if kind == 3
        lock nvme
            ok = nvme_flush(unit)

// ---------- IDE/ATA через порты (PIO), LBA28 ----------
func ata_status() gives s: int
    danger
        s = port_in8(0x1F7)

// ждать, пока диск занят (BSY); ответ — false, если диск сказал «ошибка» или так и не ответил
func ata_ready(need_drq: bool) gives ok: bool
    repeat 2000000 times
        s = ata_status()
        if s == 0 or s == 0xFF
            return false
        if bit_and(s, 0x80) == 0
            if bit_and(s, 0x01) != 0 or bit_and(s, 0x20) != 0
                return false
            if not need_drq or bit_and(s, 0x08) != 0
                return true
    return false

func ata_select(drive: int, lba: int, cmd: int)
    danger
        port_out8(0x1F6, bit_or(0xE0, bit_or(shift_left(drive, 4), bit_and(shift_right(lba, 24), 0x0F))))
        port_out8(0x1F2, 1)
        port_out8(0x1F3, bit_and(lba, 0xFF))
        port_out8(0x1F4, bit_and(shift_right(lba, 8), 0xFF))
        port_out8(0x1F5, bit_and(shift_right(lba, 16), 0xFF))
        port_out8(0x1F7, cmd)

func ide_size(drive: int) gives n: int
    lock ata
        danger
            port_out8(0x1F6, bit_or(0xA0, shift_left(drive, 4)))
            port_out8(0x1F2, 0)
            port_out8(0x1F3, 0)
            port_out8(0x1F4, 0)
            port_out8(0x1F5, 0)
            port_out8(0x1F7, 0xEC)
        if ata_status() != 0 and ata_ready(true)
            danger
                count i from 0 to 255
                    w = port_in16(0x1F0)
                    if i == 60
                        n = w
                    if i == 61
                        n = n + shift_left(w, 16)

func ide_read(drive: int, lba: int, buf: int) gives ok: bool
    lock ata
        ata_select(drive, lba, 0x20)
        ok = ata_ready(true)
        if ok
            danger
                count i from 0 to 255
                    write16(buf + i * 2, port_in16(0x1F0))

func ide_write(drive: int, lba: int, buf: int) gives ok: bool
    lock ata
        ata_select(drive, lba, 0x30)
        ok = ata_ready(true)
        if ok
            danger
                count i from 0 to 255
                    port_out16(0x1F0, read16(buf + i * 2))
            ok = ata_ready(false)

func ide_flush(drive: int) gives ok: bool
    lock ata
        danger
            port_out8(0x1F6, bit_or(0xE0, shift_left(drive, 4)))
            port_out8(0x1F7, 0xE7)
        ok = ata_ready(false)

// ---------- байты в памяти: числа little-endian, текст ----------
// текст → память с адреса a (без нуля в конце); ответ — сколько байт
modpub func put_text(a: int, s: text) gives n: int
    danger
        each ch in s
            write8(a + n, bit_and(code(ch), 255))
            n += 1

// n байт из памяти → текст (байт 0 текст закончил бы — его пропускаем)
modpub func get_text(a: int, n: int) gives s: text
    danger
        count i from 0 to n - 1
            b = read8(a + i)
            if b != 0
                s += char(b)

// ---------- байты любые (картинки, программы) ↔ текст без нулей ----------
// Текст Tachbit кончается на байте 0, поэтому по каналам байты идут «с заменой»:
// 0 → 01 01, 1 → 01 02, остальные как есть. Обычный текст (без байтов 0 и 1) не меняется,
// а на диск всегда ложатся настоящие байты.
modpub func bin_text(a: int, n: int) gives s: text
    danger
        count i from 0 to n - 1
            b = read8(a + i)
            if b == 0
                s += char(1) + char(1)
            else if b == 1
                s += char(1) + char(2)
            else
                s += char(b)

// обратно: текст → настоящие байты с адреса a; ответ — сколько байт
modpub func text_bin(a: int, s: text) gives n: int
    esc = false
    danger
        each ch in s
            c = bit_and(code(ch), 255)
            if esc
                write8(a + n, c - 1)
                n += 1
                esc = false
            else if c == 1
                esc = true
            else
                write8(a + n, c)
                n += 1

// сколько настоящих байт в тексте с заменой
modpub func bin_size(s: text) gives n: int
    esc = false
    each ch in s
        if esc
            esc = false
        else if bit_and(code(ch), 255) == 1
            esc = true
            n += 1
        else
            n += 1

modpub func mem_new(n: int) gives a: int
    danger
        a = new_mem(n) else err
            return 0

modpub func mem_free(a: int)
    danger
        free_mem(a)

modpub func get8(a: int) gives v: int
    danger
        v = read8(a)
modpub func get16(a: int) gives v: int
    danger
        v = read16(a)
modpub func get32(a: int) gives v: int
    danger
        v = read32(a)
modpub func get64(a: int) gives v: int
    danger
        v = read64(a)
modpub func set8(a: int, v: int)
    danger
        write8(a, v)
modpub func set16(a: int, v: int)
    danger
        write16(a, v)
modpub func set32(a: int, v: int)
    danger
        write32(a, v)
modpub func set64(a: int, v: int)
    danger
        write64(a, v)
modpub func zero(a: int, n: int)
    danger
        fill_mem(a, 0, n)
modpub func copy(dst: int, src: int, n: int)
    danger
        copy_mem(dst, src, n)

// несколько секторов подряд
modpub func disk_read_n(drive: int, lba: int, count_s: int, buf: int) gives ok: bool
    ok = true
    count i from 0 to count_s - 1
        if not disk_read(drive, lba + i, buf + i * 512)
            return false

modpub func disk_write_n(drive: int, lba: int, count_s: int, buf: int) gives ok: bool
    ok = true
    count i from 0 to count_s - 1
        if not disk_write(drive, lba + i, buf + i * 512)
            return false
