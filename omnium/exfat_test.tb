// exFAT на флешке (единственный диск, номер 0): читать файлы и папки, писать новые, удалять
use ofs
use exfat
use disk

func names(k: Key, path: text) gives s: text
    ns = exfat.ls(k, path) else err
        return err
    return join(ns, ", ")

func main()
    bell = channel int
    asks = list channel text
    answers = list channel text
    writes = list bool
    k = ofs.key(bell, asks, answers, writes, true)
    usb = service exfat.exfat(0, bell, move asks, move answers, move writes)
    note, free_kb, total_kb = exfat.info(k) else err
        print(err)
        return
    print(note + ", всего " + total_kb + " КБ")
    root = exfat.ls(k, "/") else err
        print("корень: " + err)
        return
    print("корень: " + join(root, ", "))
    print("hello.txt: " + (exfat.get(k, "/hello.txt") or "?"))
    print("документы: " + names(k, "/документы"))
    plan = exfat.get(k, "/Документы/план.txt") or "?"
    print("план: " + replace(plan, "\n", " | "))
    big = exfat.get(k, "/Документы/длинное имя файла для проверки.txt") or ""
    print("длинный файл: " + len(big) + " байт, конец цел: " + ends_with(big, "строка 2000\n"))
    exfat.mkdir(k, "/Омниум") else err
        print(err)
    exfat.put(k, "/Омниум/привет.txt", "записано из Омниума\n") else err
        print(err)
    exfat.put(k, "/hello.txt", "привет, переписан\n") else err
        print(err)
    exfat.delete(k, "/Документы/план.txt") else err
        print(err)
    print("после записи: " + names(k, "/Омниум") + " / " + (exfat.get(k, "/Омниум/привет.txt") or "?"))
    print("документы: " + names(k, "/Документы"))
    // байты с нулями внутри (как у картинки): записать и прочитать как было
    a = mem_new(300)
    count i from 0 to 299
        set8(a + i, i % 7)
    exfat.put_mem(k, "/Омниум/картинка.bin", a, 300) else err
        print(err)
    b, n = exfat.get_mem(k, "/Омниум/картинка.bin") else err
        print(err)
        b = 0
        n = 0
    same = n == 300
    if same
        count i from 0 to 299
            if get8(b + i) != i % 7
                same = false
    print("байты с нулями: " + n + " байт, совпали: " + same)
    // много файлов в одной папке: места под имена не хватит, папка должна вырасти
    exfat.mkdir(k, "/много") else err
        print(err)
    count i from 1 to 150
        exfat.put(k, "/много/файл " + i + ".txt", "номер " + i) else err
            print("файл " + i + ": " + err)
            stop
    many = exfat.ls(k, "/много") else err
        print(err)
        return
    print("в папке «много»: " + len(many) + ", последний: " + (exfat.get(k, "/много/файл 150.txt") or "?"))
    bell.close()
    usb.wait
