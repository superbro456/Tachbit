# собранный компилятор и всё, что делают скрипты: build/tb, build/tachbit.vsix
build/
# старые имена собранного компилятора в корне (до чистки 2026-11)
/tachbit
/tachbit-tb
/tb
*.o
.DS_Store
.claude/

# tachbit build кладёт рядом с .tb файл .c и программу: в git только сами .tb
examples/**
!examples/**/
!examples/**/*.tb
tests/bench/**
!tests/bench/**/
!tests/bench/**/*.tb
!tests/bench/**/*.py
!tests/bench/**/*.sh
!tests/bench/*_pure.c
!tests/bench/*_smart.c

# в compiler/ только исходники компилятора, его runtime и семя
compiler/*
!compiler/*.tb
!compiler/README.md
!compiler/runtime.h
!compiler/gpu/
!compiler/seed/
compiler/seed/*
!compiler/seed/tb.c
