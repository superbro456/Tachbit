# собранный компилятор и всё, что делают скрипты: build/tb, build/tachbit.vsix
build/
# старые имена собранного компилятора в корне (до чистки 2026-11)
/tachbit
/tachbit-tb
/tb
*.o
.DS_Store
.claude/

# tachbit build кладёт рядом с .tb файл .c и программу: в git только сами .tb
examples/**
!examples/**/
!examples/**/*.tb
!examples/**/*.png
!examples/**/*.jpg
!examples/**/*.glb
!examples/**/*.gltf
!examples/**/*.bin
!examples/**/*.obj
!examples/**/*.mtl
!examples/**/*.wav
!examples/**/*.py
tests/bench/**
!tests/bench/**/
!tests/bench/**/*.tb
!tests/bench/**/*.py
!tests/bench/**/*.sh
!tests/bench/vs/*.c

# в compiler/ только исходники компилятора, его runtime и семя
compiler/*
!compiler/*.tb
!compiler/README.md
!compiler/runtime.h
!compiler/gpu/
!compiler/seed/
compiler/seed/*
!compiler/seed/tb.c
omnium/*.elf
bench/*
!bench/*.tb
!bench/*.c
!bench/*.sh
!bench/*.py
!bench/*.md
# диски Омниума (создаёт omnium/run.sh)
omnium/*.img
# ядра, которые tests/run_bare.sh собирает на время проверки
tests/bare/*.elf
tests/bare/*.bc
tests/bare/*.ll
tests/bare/*.log
tests/bare/*.c
omnium/*.elf
omnium/*.bc
omnium/*.ll
omnium/*.log
!examples/**/models/*
examples/apps/big_world/world/
